`ifndef {{ class_interface | upper }}
`define {{ class_interface | upper }}

interface {{ class_interface }}(
    input wire clk,
    input wire valid,
    input wire[31:0] bits, // 通常为 $bits(PATH_TO_DATA)，不到则自动识别
    input wire[UVM_HDL_MAX_WIDTH*16-1:0] data
);

parameter int DELAY=0; // 数据滞后几拍

typedef struct {
    bit[UVM_HDL_MAX_WIDTH*16-1:0] data;
    bit[31:0] bits;
} rx_s;

// output
rx_s rx_data; // 当前接收数据
int rx_count; // 当前接收计数

// property
int delay;
bit s_cs[16];
int auto_bits;

// alias
wire[31:0] data_width;

// assign
assign data_width = !$isunknown(bits) ? bits : auto_bits;

/*
    得到数据位宽

    需要在initial块使用，并在#0之后
    不能使用 init_reg 期待参数，会导致失效
*/
function int get_bits(reg[UVM_HDL_MAX_WIDTH-1:0] d);
    for(int J=0;J<$bits(d);J++)
        if(!$isunknown(d[J])) begin
            return J;
        end
endfunction

// 读取参数
initial begin
    delay = DELAY;
end

// 自动识别数据位宽
initial begin
    #0;
    auto_bits = get_bits(data);
end

// 数据采样
initial forever begin
    @(posedge clk);

    // 延迟一拍
    for(int i=$bits(s_cs)-1;i>0;i=i-1)
        s_cs[i] = s_cs[i-1];

    // valid
    s_cs[0] = valid;

    // 比较（阻塞）
    if(!s_cs[delay])
        continue;

    if(!data_width)
        `uvm_fatal("",$psprintf("Invalid data_width"))

    rx_data = '{
        data : data,
        bits : data_width
    };
    rx_count++;
end

endinterface
`endif
