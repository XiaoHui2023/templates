`ifndef {{ (class_prefix ~ 'interface') | upper }}
`define {{ (class_prefix ~ 'interface') | upper }}

interface {{ class_prefix }}interface(
    input wire {{ if_clk }},
    input wire {{ if_valid }},
    input wire[31:0] {{ if_width }}, // 静态位宽；未驱动时用 auto_width
    input wire[{{ data_width_expr }}-1:0] {{ if_data }}
);

parameter int DELAY=0; // valid 对齐后额外等待的时钟周期数

typedef struct {
    bit[{{ data_width_expr }}-1:0] data;
    bit[31:0] width;
} rx_s;

rx_s rx_data; // 当前周期锁存的 data 与 width
int rx_count; // 每次锁存完成后递增

int delay;
bit s_cs[16];
int auto_width;

wire[31:0] data_width;

assign data_width = !$isunknown({{ if_width }}) ? {{ if_width }} : auto_width;

// get_width — 返回 d 中从低位起首个非 X 位的索引（应在 #0 后调用；勿依赖参数端口寄存器初值）
function int get_width(reg[{{ data_width_expr }}-1:0] d);
    for(int J=0;J<$bits(d);J++)
        if(!$isunknown(d[J])) begin
            return J;
        end
endfunction

initial begin
    delay = DELAY;
end

initial begin
    #0;
    auto_width = get_width({{ if_data }});
end

initial forever begin
    @(posedge {{ if_clk }});

    for(int i=$bits(s_cs)-1;i>0;i=i-1)
        s_cs[i] = s_cs[i-1];

    s_cs[0] = {{ if_valid }};

    if(!s_cs[delay])
        continue;

    if(!data_width)
        `uvm_fatal("",$psprintf("Invalid data_width"))

    rx_data = '{
        data : {{ if_data }},
        width : data_width
    };
    rx_count++;
end

endinterface
`endif
