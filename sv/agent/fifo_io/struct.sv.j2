`ifndef {{ class_struct | upper }}
`define {{ class_struct | upper }}

class {{ class_struct }};
    bit[31:0] addr;
    bit[31:0] len;
    bit[7:0] data[$];
    bit[{{ time_width }}-1:0] delay;

    function new(bit[31:0] addr, bit[31:0] len, bit[7:0] data[$], bit[{{ time_width }}-1:0] delay);
        this.addr = addr;
        this.len = len;
        this.data = data;
        this.delay = delay;
    endfunction

    // 解码
    extern static function {{ class_struct }} decode(ref bit[7:0] in[$]);

    // 编码
    extern function void encode(ref bit[7:0] out[$]);

    // 转换为结构字节（大端）
    extern function int value_to_byte(input bit[UVM_HDL_MAX_WIDTH-1:0] v, output int len, output bit[7:0] data[$]);
endclass

function {{ class_struct }} {{ class_struct }}::decode(ref bit[7:0] in[$]);
    bit[7:0] len_delay;
    bit[{{ time_width }}-1:0] delay;
    bit[7:0] q_len[4];
    bit[7:0] q_addr[4];
    bit[31:0] addr;
    bit[31:0] len;
    bit[7:0] data[$];

    // len_delay
    if(!in.size) begin
        `uvm_fatal("", "invalid len delay")
    end
    len_delay = in.pop_front();

    // delay
    if(in.size < len_delay)
        `uvm_fatal("", "invalid delay")
    repeat(len_delay) begin
        bit[7:0] d;
        d = in.pop_front();
        delay = {delay[{{ time_width }}-9:0], d};
    end

    // addr
    if(in.size < $size(q_addr))
        `uvm_fatal("", "invalid addr")
    foreach(q_addr[i])
        q_addr[i] = in.pop_front();
    addr = {<<32{q_addr}};

    // len
    if(in.size < $size(q_len))
        `uvm_fatal("", "invalid len")
    foreach(q_len[i])
        q_len[i] = in.pop_front();
    len = {<<32{q_len}};

    // data
    if(in.size < len)
        `uvm_fatal("", "invalid data")
    repeat(len)
        data.push_back(in.pop_front());

    decode = new(
        .delay(delay),
        .addr(addr),
        .len(len),
        .data(data)
    );
endfunction

function void {{ class_struct }}::encode(ref bit[7:0] out[$]);
    bit[7:0] len_delay;
    bit[7:0] q_delay[$];
    bit[7:0] q_addr[4];
    bit[7:0] q_len[4];

    // delay
    value_to_byte(delay, len_delay, q_delay);

    // addr
    q_addr = {<<8{addr}};
    q_len = {<<8{len}};

    out.push_back(len_delay);
    foreach(q_delay[i])
        out.push_back(q_delay[i]);
    foreach(q_addr[i])
        out.push_back(q_addr[i]);
    foreach(q_len[i])
        out.push_back(q_len[i]);
    foreach(data[i])
        out.push_back(data[i]);
endfunction

function int {{ class_struct }}::value_to_byte(input bit[UVM_HDL_MAX_WIDTH-1:0] v, output int len, output bit[7:0] data[$]);
    while(v > 0) begin
        data.push_front(v[7:0]);
        v >>= 8;
        len++;
    end
endfunction

`endif
