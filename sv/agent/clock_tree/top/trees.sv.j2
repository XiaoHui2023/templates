`ifndef {{ (class_prefix ~ "trees") | upper }}
`define {{ (class_prefix ~ "trees") | upper }}

{%- for tree in trees %}
`ifndef {{ (class_prefix ~ tree.name ~ "_tree") | upper }}
`define {{ (class_prefix ~ tree.name ~ "_tree") | upper }}

class {{ class_prefix }}{{ tree.name }}_tree extends {{ class_prefix }}base_tree;
    `uvm_object_utils_begin({{ class_prefix }}{{ tree.name }}_tree)
{%- for node in tree.nodes_ordered %}
        `uvm_field_object({{ node.name }}, UVM_ALL_ON)
{%- endfor %}
    `uvm_object_utils_end

{%- for node in tree.nodes_ordered %}
    rand {{ class_prefix }}{{ node.kind }} {{ node.name }};
{%- endfor %}

    constraint cst_base;
    constraint cst_user;
    constraint cst_case;

    function new(string name="{{ class_prefix }}{{ tree.name }}_tree");
        super.new(name);
{%- if setting_defs %}
        settings = {{ class_prefix }}settings::type_id::create("settings");
{%- for def in setting_defs %}
        settings.{{ def.name }} = {{ tree.settings[def.name] }};
{%- endfor %}
{%- endif %}
{%- for node in tree.nodes_ordered %}
        {{ node.name }} = {{ class_prefix }}{{ node.kind }}::type_id::create("{{ node.name }}");
{%- if node.kind == "pll" %}
        {{ node.name }}.pll_kind = {{ node.pll_kind }};
{%- endif %}
{%- endfor %}
{%- for node in tree.nodes_ordered %}
{%- for src in node.sources %}
{%- if node.kind == "mux" %}
        {{ node.name }}.to_source[{{ src.key }}] = {{ src.name }};
{%- else %}
        {{ node.name }}.source = {{ src.name }};
{%- endif %}
{%- endfor %}
{%- endfor %}
        nodes.delete();
{%- for node in tree.nodes_ordered %}
        nodes.push_back({{ node.name }});
{%- endfor %}
    endfunction
endclass

`endif
{%- endfor %}

`endif
