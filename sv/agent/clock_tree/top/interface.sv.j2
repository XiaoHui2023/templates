`ifndef {{ (class_prefix ~ "interface") | upper }}
`define {{ (class_prefix ~ "interface") | upper }}

interface {{ class_prefix }}interface #(
    parameter int MIN_FREQ_HZ = {{ min_freq_hz }},
    parameter int STABLE_CYCLES = {{ stable_cycles }},
    parameter real PERIOD_TOL = {{ period_tolerance }},
    parameter real DUTY_MIN = {{ duty_min }},
    parameter real DUTY_MAX = {{ duty_max }}
) (
    input wire in,
    output wire out
);
    timeunit 1ns;
    timeprecision 1fs;

    {{ class_prefix }}generate_interface gen(.out(out));
    {{ class_prefix }}measure_interface #(
        .MIN_FREQ_HZ(MIN_FREQ_HZ),
        .STABLE_CYCLES(STABLE_CYCLES),
        .PERIOD_TOL(PERIOD_TOL),
        .DUTY_MIN(DUTY_MIN),
        .DUTY_MAX(DUTY_MAX)
    ) meas(.in(in));

    function automatic void set_clock_gen(bit en, real hz);
        gen.set_clock_gen(en, hz);
    endfunction

    function automatic void set_measure_en(bit en);
        meas.set_measure_en(en);
    endfunction
endinterface

`endif
