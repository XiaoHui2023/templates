{% if setting_defs %}
function void {{ class_prefix }}kit_sequencer::configure_tree({{ class_prefix }}base_tree tree);
    if (tree == null)
        `uvm_fatal("CLK_TREE", "configure_tree: tree is null")
    configure_settings(tree.settings);
endfunction

function void {{ class_prefix }}kit_sequencer::configure_all_trees();
    foreach (trees[i])
        configure_tree(trees[i]);
endfunction
{% endif %}

function {{ class_prefix }}set_clock_gen_rsp {{ class_prefix }}kit_sequencer::run_set_clock_gen(
        {{ class_prefix }}node_base node, bit gen_en);
    {{ class_prefix }}set_clock_gen_req req;
    {{ class_prefix }}set_clock_gen_rsp rsp;
    {{ class_prefix }}set_clock_gen_seq seq;

    if (node == null)
        `uvm_fatal("CLK_TREE", "run_set_clock_gen: node is null")

    req = {{ class_prefix }}set_clock_gen_req::type_id::create("req");
    req.node = node;
    req.gen_en = gen_en;

    seq = {{ class_prefix }}set_clock_gen_seq::type_id::create("set_clock_gen");
    seq.req = req;
    seq.start(this);
    void'(seq.get_response(rsp));
    return rsp;
endfunction

function void {{ class_prefix }}kit_sequencer::run_set_clock_gen_nodes(
        {{ class_prefix }}node_base nodes[$], bit gen_en);
    foreach (nodes[i])
        void'(run_set_clock_gen(nodes[i], gen_en));
endfunction

function void {{ class_prefix }}kit_sequencer::run_set_clock_gen_tree(
        {{ class_prefix }}base_tree tree, bit gen_en);
    if (tree == null)
        `uvm_fatal("CLK_TREE", "run_set_clock_gen_tree: tree is null")

    foreach (tree.nodes[i]) begin
        if (tree.nodes[i].vif != null)
            void'(run_set_clock_gen(tree.nodes[i], gen_en));
    end
endfunction

function void {{ class_prefix }}kit_sequencer::run_set_clock_gen_trees(
        {{ class_prefix }}base_tree trees[$], bit gen_en);
    foreach (trees[i])
        run_set_clock_gen_tree(trees[i], gen_en);
endfunction

function void {{ class_prefix }}kit_sequencer::gen_source_clock();
    {{ class_prefix }}source src;

    foreach (trees[i]) begin
        foreach (trees[i].nodes[j]) begin
            if ($cast(src, trees[i].nodes[j]))
                void'(run_set_clock_gen(src, 1'b1));
        end
    end
endfunction

