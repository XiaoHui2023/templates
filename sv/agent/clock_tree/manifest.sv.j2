`ifndef {{ (class_prefix ~ "manifest") | upper }}
`define {{ (class_prefix ~ "manifest") | upper }}

class {{ class_prefix }}manifest;
    {{ class_prefix }}node_base by_name[string];

    function new();
    endfunction

    extern function void build(ref {{ class_prefix }}node_base nodes[$]);
endclass

function void {{ class_prefix }}manifest::build(ref {{ class_prefix }}node_base nodes[$]);
{% for node in nodes %}
    by_name["{{ node.name }}"] = {{ class_prefix }}{{ node.kind }}::type_id::create("{{ node.name }}");
    by_name["{{ node.name }}"].label = "{{ node.name }}";
    by_name["{{ node.name }}"].path = "{{ node.path }}";
    by_name["{{ node.name }}"].allow_bad_duty = {{ 1 if node.allow_bad_duty else 0 }};
{% if node.kind == "clk" and node.frequencies %}
    begin
        {{ class_prefix }}clk clk_n;
        if ($cast(clk_n, by_name["{{ node.name }}"])) begin
            clk_n.typical_freq.delete();
{% for hz in node.frequencies %}
            clk_n.typical_freq.push_back({{ hz }}'l);
{% endfor %}
        end
    end
{% elif node.frequencies %}
    by_name["{{ node.name }}"].frequencies.delete();
{% for hz in node.frequencies %}
    by_name["{{ node.name }}"].frequencies.push_back({{ hz }});
{% endfor %}
{% endif %}
{% endfor %}
{% for node in nodes %}
{% for src in node.sources %}
    by_name["{{ node.name }}"].sources["{{ src.key }}"] = by_name["{{ src.name }}"];
{% endfor %}
{% endfor %}
    nodes.delete();
{% for node in nodes %}
    nodes.push_back(by_name["{{ node.name }}"]);
{% endfor %}
endfunction

`endif
