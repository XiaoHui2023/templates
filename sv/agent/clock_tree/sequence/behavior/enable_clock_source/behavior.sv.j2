`ifndef {{ (class_prefix ~ "enable_clock_source_seq") | upper }}
`define {{ (class_prefix ~ "enable_clock_source_seq") | upper }}

class {{ class_prefix }}enable_clock_source_seq extends uvm_sequence #(
    {{ class_prefix }}enable_clock_source_req,
    {{ class_prefix }}enable_clock_source_rsp
);
    `uvm_object_utils({{ class_prefix }}enable_clock_source_seq)
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    function new(string name = "{{ class_prefix }}enable_clock_source_seq");
        super.new(name);
    endfunction

    extern virtual task body();
endclass

task {{ class_prefix }}enable_clock_source_seq::body();
    {{ class_prefix }}enable_clock_source_req rq;
    {{ class_prefix }}enable_clock_source_rsp rs;

    if (req == null)
        `uvm_fatal("CLK_TREE", "enable_clock_source: req is null")

    rq = req;
    if (rq.node == null)
        `uvm_fatal("CLK_TREE", "enable_clock_source: req.node is null")
    if (rq.node.vif == null)
        `uvm_fatal("CLK_TREE", $sformatf("enable_clock_source: node %s vif is null", rq.node.get_name()))

    if (rq.node.frequence <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "enable_clock_source: node %s frequence must be positive, got %0d",
            rq.node.get_name(), rq.node.frequence))

    rq.node.vif.set_clock_gen(1'b1, real'(rq.node.frequence));

    rs = {{ class_prefix }}enable_clock_source_rsp::type_id::create("rsp");
    rs.ok = 1'b1;
    rsp = rs;
endtask

`endif
