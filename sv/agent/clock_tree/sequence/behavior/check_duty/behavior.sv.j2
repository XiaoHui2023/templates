`ifndef {{ (class_prefix ~ "check_duty_seq") | upper }}
`define {{ (class_prefix ~ "check_duty_seq") | upper }}

class {{ class_prefix }}check_duty_seq extends uvm_sequence #(
    {{ class_prefix }}check_duty_req,
    {{ class_prefix }}check_duty_rsp
);
    `uvm_object_utils({{ class_prefix }}check_duty_seq)
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    function new(string name = "{{ class_prefix }}check_duty_seq");
        super.new(name);
    endfunction

    extern virtual task body();
endclass

task {{ class_prefix }}check_duty_seq::body();
    {{ class_prefix }}check_duty_req rq;
    {{ class_prefix }}check_duty_rsp rs;
    {{ class_prefix }}node_base nd;
    int meas_timeout_ns;
    int elapsed_ns;

    meas_timeout_ns = (1_000_000_000 + {{ min_freq_hz }} - 1) / {{ min_freq_hz }};

    if (req == null)
        `uvm_fatal("CLK_TREE", "check_duty: req is null")

    rq = req;
    if (rq.tree == null)
        `uvm_fatal("CLK_TREE", "check_duty: req.tree is null")

    rs = {{ class_prefix }}check_duty_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    foreach (rq.tree.nodes[i]) begin
        nd = rq.tree.nodes[i];
        if (nd.vif == null)
            continue;

        nd.vif.set_measure_en(1'b1);
        elapsed_ns = 0;
        while (!nd.vif.meas.stable && elapsed_ns < meas_timeout_ns) begin
            #1ns;
            elapsed_ns++;
        end

        if (!nd.vif.meas.stable) begin
            nd.vif.set_measure_en(1'b0);
            `uvm_error("CLK_TREE", $sformatf(
                "check_duty: node %s did not stabilize", nd.get_name()))
            rs.ok = 1'b0;
            continue;
        end

        if (!nd.vif.meas.duty_ok) begin
            `uvm_error("CLK_TREE", $sformatf(
                "check_duty: node %s duty %0.4f out of range [%0.2f,%0.2f]",
                nd.get_name(), nd.vif.meas.duty, {{ duty_min }}, {{ duty_max }}))
            rs.ok = 1'b0;
        end

        nd.vif.set_measure_en(1'b0);

        if (rq.gen_after_check && nd.frequence > 0)
            nd.vif.set_clock_gen(1'b1, real'(nd.frequence));
    end

    rsp = rs;
endtask

`endif
