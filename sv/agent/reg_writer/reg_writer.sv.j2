`ifndef {{ (class_prefix ~ "reg_writer") | upper }}
`define {{ (class_prefix ~ "reg_writer") | upper }}

class {{ class_prefix }}reg_writer extends uvm_component;
    `uvm_component_utils({{ class_prefix }}reg_writer)

    uvm_analysis_port #(uvm_tlm_generic_payload) {{ input_port_name }};
    uvm_analysis_imp #(uvm_tlm_generic_payload, {{ class_prefix }}reg_writer) imp;

    protected uvm_reg_block m_root;
    protected uvm_reg_map m_map;
    protected string reg_map_name;
    protected {{ class_prefix }}addr_hit_t m_addr_lut[string];

    function new(string name="{{ class_prefix }}reg_writer", uvm_component parent=null);
        super.new(name, parent);
    endfunction

    extern function void build_phase(uvm_phase phase);
    extern function void connect_phase(uvm_phase phase);
    extern function void write(uvm_tlm_generic_payload payload);
endclass

function void {{ class_prefix }}reg_writer::build_phase(uvm_phase phase);
    super.build_phase(phase);

    {{ input_port_name }} = new("{{ input_port_name }}", this);
    imp = new("imp", this);

    if (!uvm_config_db #(uvm_reg_block)::get(this, "", "reg_block", m_root) || m_root == null)
        `uvm_fatal("REG_WRITER", "uvm_config_db #(uvm_reg_block) reg_block is required for reg_writer")

    void'(uvm_config_db #(string)::get(this, "", "reg_map", reg_map_name));
    if (reg_map_name.len()) begin
        m_map = m_root.get_map(reg_map_name);
        if (m_map == null)
            `uvm_fatal("REG_WRITER", $sformatf("unknown reg_map name '%s'", reg_map_name))
    end else begin
        m_map = m_root.get_default_map();
        if (m_map == null)
            `uvm_fatal("REG_WRITER", "no default uvm_reg_map on reg_block; set reg_map or add a default map")
    end

    if (!{{ class_prefix }}build_reg_addr_lut(m_root, m_map, m_addr_lut))
        `uvm_fatal("REG_WRITER", "failed to build register address lookup table")
endfunction

function void {{ class_prefix }}reg_writer::connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    {{ input_port_name }}.connect(imp);
endfunction

function void {{ class_prefix }}reg_writer::write(uvm_tlm_generic_payload payload);
    uvm_reg_addr_t ra;
    int len;
    string key;
    {{ class_prefix }}addr_hit_t hit;
    uvm_reg rg;
    bit [7:0] le[$];
    uvm_reg_data_t v;

    if (payload == null) begin
        `uvm_error("REG_WRITER", "write: null uvm_tlm_generic_payload")
        return;
    end

    if (payload.get_command() != UVM_TLM_WRITE_COMMAND) begin
        `uvm_warning("REG_WRITER", "only UVM_TLM_WRITE_COMMAND is configured; other commands ignored")
        return;
    end

    ra = payload.get_address();
    len = payload.get_data_length();
    key = $sformatf("%016h_%0d", ra, len);

    if (!m_addr_lut.exists(key)) begin
        `uvm_error("REG_WRITER", $sformatf("no register for addr=0x%0h data_length=%0d (check map and payload width)", ra, len))
        return;
    end

    hit = m_addr_lut[key];
    rg = {{ class_prefix }}resolve_reg_by_path(m_root, hit.path);
    if (rg == null) begin
        `uvm_error("REG_WRITER", $sformatf("resolve failed for lut path: %s", hit.path))
        return;
    end

    if (!{{ class_prefix }}payload_to_le_bytes(payload, le))
        return;
    if (!{{ class_prefix }}le_bytes_to_uvm_reg_data(le, rg.get_n_bits(), v))
        return;

    // uvm_reg::write is a task; analysis imp write() is a function — run frontdoor in a process.
    fork
        begin
            automatic uvm_reg rg_x = rg;
            automatic uvm_reg_data_t v_x = v;
            automatic string path_x = hit.path;
            automatic uvm_reg_addr_t ra_x = ra;
            automatic bit [7:0] le_x[$] = le;
            automatic int nbits_x = rg.get_n_bits();
            uvm_status_e st_x;
            string val_x;
            rg_x.write(st_x, v_x, UVM_FRONTDOOR, m_map, null);
            if (st_x != UVM_IS_OK) begin
                `uvm_error("REG_WRITER", $sformatf("reg frontdoor write failed path=%s", path_x))
            end else begin
                val_x = {{ class_prefix }}format_le_bytes_as_hex(le_x, nbits_x);
                `uvm_info("REG_WRITER", $sformatf("configure reg=%s addr=0x%0h value=%s width=%0d", path_x, ra_x, val_x, nbits_x), UVM_LOW)
            end
        end
    join_none
endfunction

`endif
