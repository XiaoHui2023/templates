`ifndef {{ (class_prefix ~ "sequencer") | upper }}
`define {{ (class_prefix ~ "sequencer") | upper }}

// memh_io sequencer：字节寻址稀疏 memory；memh 读写、与文件或其它 memory 比对；TLM 写与 load 均走 GP。
class {{ class_prefix }}sequencer extends uvm_sequencer;
    `uvm_component_utils({{ class_prefix }}sequencer)

    bit [7:0] memory[bit [63:0]]; // 索引为字节地址，元素为 8 位数据
    uvm_analysis_imp #(uvm_tlm_generic_payload, {{ class_prefix }}sequencer) imp; // TLM 写入口（analysis imp）
    uvm_analysis_port #(uvm_tlm_generic_payload) o_ap; // write_payload 完成后广播同一 GP
    uvm_analysis_port #(uvm_tlm_generic_payload) o_load_ap; // load_file 按连续地址段发出的写 GP

    protected string init_file; // SOS 阶段可选 memh 初值（config_db）
    protected string dump_file; // final 阶段可选 memh 落盘路径（config_db）

    function new(string name="{{ class_prefix }}sequencer", uvm_component parent=null);
        super.new(name, parent);
    endfunction

    extern function void build_phase(uvm_phase phase);
    extern function void start_of_simulation_phase(uvm_phase phase);
    extern function void final_phase(uvm_phase phase);

    // write — analysis imp；按 GP 地址与数据写入 memory，并经 o_ap 再广播
    extern function void write(uvm_tlm_generic_payload payload);

    extern function void clear();

    extern function void write_byte(bit [63:0] addr, bit [7:0] data);
    extern function bit [7:0] read_byte(bit [63:0] addr, bit [7:0] default_value='0);

    extern function void write_data(bit [63:0] addr, const ref bit [7:0] data[$]);
    // read_data — 自 addr 起顺序读取 len 字节；缺址取 default_value
    extern function void read_data(input bit [63:0] addr, input int len, output bit [7:0] data_q[$], input bit [7:0] default_value='0);

    extern function void write_payload(uvm_tlm_generic_payload payload);
    extern function uvm_tlm_generic_payload read_payload(bit [63:0] addr, int len, string name="memh_payload");

    // load_file — memh：@ 地址行与十六进制字节 token；clear_first 时先清空 memory
    extern function bit load_file(string filename, bit clear_first=0);
    extern function bit save_file(string filename);
    extern protected function void emit_load_payloads(ref bit [7:0] load_memory[bit [63:0]]);
    extern protected function void emit_load_payload(bit [63:0] addr, ref bit [7:0] data_q[$]);

    extern function bit compare_file(string filename);
    // compare_memory — 与 expected 地址集合须一致、同址字节须相等
    extern function bit compare_memory(ref bit [7:0] expected[bit [63:0]], input string expected_name="expected");
endclass

function void {{ class_prefix }}sequencer::build_phase(uvm_phase phase);
    super.build_phase(phase);

    imp = new("imp", this);
    o_ap = new("o_ap", this);
    o_load_ap = new("o_load_ap", this);

    void'(uvm_config_db #(string)::get(this, "", "dump_file", dump_file));
endfunction

function void {{ class_prefix }}sequencer::start_of_simulation_phase(uvm_phase phase);
    super.start_of_simulation_phase(phase);

    if (uvm_config_db #(string)::get(this, "", "init_file", init_file) && init_file.len()) begin
        `uvm_info("", $sformatf("load memh init file: %s", init_file), UVM_LOW)
        void'(load_file(init_file, 1));
    end
endfunction

function void {{ class_prefix }}sequencer::final_phase(uvm_phase phase);
    super.final_phase(phase);

    if (dump_file.len()) begin
        `uvm_info("MEMH_DUMP", $sformatf("Writing memh to %s", dump_file), UVM_LOW)
        void'(save_file(dump_file));
    end
endfunction

function void {{ class_prefix }}sequencer::write(uvm_tlm_generic_payload payload);
    uvm_tlm_generic_payload p;

    if (payload == null) begin
        `uvm_error("", "write got null payload")
        return;
    end
    if (!$cast(p, payload.clone())) begin
        `uvm_error("", "clone uvm_tlm_generic_payload failed")
        return;
    end
    write_payload(p);
endfunction

function void {{ class_prefix }}sequencer::clear();
    memory.delete();
endfunction

function void {{ class_prefix }}sequencer::write_byte(bit [63:0] addr, bit [7:0] data);
    memory[addr] = data;
endfunction

function bit [7:0] {{ class_prefix }}sequencer::read_byte(bit [63:0] addr, bit [7:0] default_value='0);
    if (memory.exists(addr))
        return memory[addr];
    return default_value;
endfunction

function void {{ class_prefix }}sequencer::write_data(bit [63:0] addr, const ref bit [7:0] data[$]);
    foreach (data[i])
        write_byte(addr + i, data[i]);
endfunction

function void {{ class_prefix }}sequencer::read_data(input bit [63:0] addr, input int len, output bit [7:0] data_q[$], input bit [7:0] default_value='0);
    data_q.delete();
    for (int i = 0; i < len; i++)
        data_q.push_back(read_byte(addr + i, default_value));
endfunction

function void {{ class_prefix }}sequencer::write_payload(uvm_tlm_generic_payload payload);
    byte unsigned data_dyn[];
    bit [63:0] addr;
    int len;

    if (payload == null) begin
        `uvm_error("", "write_payload got null payload")
        return;
    end

    `uvm_info("", $sformatf("write payload input:\n%s", payload.sprint()), UVM_DEBUG)

    addr = payload.get_address();
    payload.get_data(data_dyn);
    len = payload.get_data_length();
    if (len == 0 || len > data_dyn.size())
        len = data_dyn.size();

    for (int i = 0; i < len; i++)
        write_byte(addr + i, data_dyn[i]);

    `uvm_info("", $sformatf("write payload output:\n%s", payload.sprint()), UVM_DEBUG)
    o_ap.write(payload);
endfunction

function uvm_tlm_generic_payload {{ class_prefix }}sequencer::read_payload(bit [63:0] addr, int len, string name="memh_payload");
    uvm_tlm_generic_payload payload;
    bit [7:0] data_q[$];
    byte unsigned data_dyn[];

    payload = uvm_tlm_generic_payload::type_id::create(name);
    read_data(addr, len, data_q);
    data_dyn = new[data_q.size()];
    foreach (data_q[i])
        data_dyn[i] = data_q[i];

    payload.set_command(UVM_TLM_READ_COMMAND);
    payload.set_address(addr);
    payload.set_data(data_dyn);
    payload.set_data_length(len);
    payload.set_streaming_width(len);
    payload.set_response_status(UVM_TLM_OK_RESPONSE);
    `uvm_info("", $sformatf("read payload output:\n%s", payload.sprint()), UVM_DEBUG)
    return payload;
endfunction

function bit {{ class_prefix }}sequencer::load_file(string filename, bit clear_first=0);
    bit [7:0] load_memory[bit [63:0]];

    if (!{{ class_prefix }}read_memh_file(filename, load_memory, 1))
        return 0;

    if (clear_first)
        memory.delete();

    foreach (load_memory[addr])
        memory[addr] = load_memory[addr];

    `uvm_info("", $sformatf("load memh file to memory: %s", filename), UVM_LOW)
    emit_load_payloads(load_memory);
    return 1;
endfunction

function void {{ class_prefix }}sequencer::emit_load_payloads(ref bit [7:0] load_memory[bit [63:0]]);
    bit has_run;
    bit [63:0] run_addr;
    bit [63:0] last_addr;
    bit [7:0] data_q[$];

    foreach (load_memory[addr]) begin
        if (!has_run) begin
            has_run = 1;
            run_addr = addr;
            last_addr = addr;
            data_q.delete();
            data_q.push_back(load_memory[addr]);
        end else if (addr == last_addr + 1) begin
            last_addr = addr;
            data_q.push_back(load_memory[addr]);
        end else begin
            emit_load_payload(run_addr, data_q);
            run_addr = addr;
            last_addr = addr;
            data_q.delete();
            data_q.push_back(load_memory[addr]);
        end
    end

    if (has_run)
        emit_load_payload(run_addr, data_q);
endfunction

function void {{ class_prefix }}sequencer::emit_load_payload(bit [63:0] addr, ref bit [7:0] data_q[$]);
    uvm_tlm_generic_payload payload;
    byte unsigned data_dyn[];

    data_dyn = new[data_q.size()];
    foreach (data_q[i])
        data_dyn[i] = data_q[i];

    payload = uvm_tlm_generic_payload::type_id::create($sformatf("%s.load_payload_%0h", get_full_name(), addr));
    payload.set_command(UVM_TLM_WRITE_COMMAND);
    payload.set_address(addr);
    payload.set_data(data_dyn);
    payload.set_data_length(data_dyn.size());
    payload.set_streaming_width(data_dyn.size());
    payload.set_response_status(UVM_TLM_OK_RESPONSE);
    `uvm_info("", $sformatf("load payload output:\n%s", payload.sprint()), UVM_DEBUG)
    o_load_ap.write(payload);
endfunction

function bit {{ class_prefix }}sequencer::save_file(string filename);
    return {{ class_prefix }}write_memh_file(filename, memory);
endfunction

function bit {{ class_prefix }}sequencer::compare_file(string filename);
    return {{ class_prefix }}compare_memh_file(memory, filename);
endfunction

function bit {{ class_prefix }}sequencer::compare_memory(ref bit [7:0] expected[bit [63:0]], input string expected_name="expected");
    return {{ class_prefix }}compare_memory(memory, expected, expected_name);
endfunction

`endif
