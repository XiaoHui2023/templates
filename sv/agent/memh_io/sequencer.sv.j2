`ifndef {{ (class_prefix ~ "sequencer") | upper }}
`define {{ (class_prefix ~ "sequencer") | upper }}

class {{ class_prefix }}sequencer extends uvm_sequencer;
    `uvm_component_utils({{ class_prefix }}sequencer)
    `uvm_register_cb({{ class_prefix }}sequencer, {{ class_prefix }}callback)

    bit [7:0] memory[bit [63:0]]; // 下标是字节地址，存 8 位数据
    protected {{ class_prefix }}engine memh_eng; // 读 memh、写 memh、比较文件时共用的逻辑
    uvm_analysis_imp #(uvm_tlm_generic_payload, {{ class_prefix }}sequencer) imp; // imp：TLM generic payload 写入
    uvm_analysis_port #(uvm_tlm_generic_payload) o_ap; // write_payload 之后把同一份 payload 再发出去
    uvm_analysis_port #(uvm_tlm_generic_payload) o_load_ap; // load_file 时按连续地址段发写事务

    protected string init_file; // 可选：仿真开始阶段用 config_db 里的路径自动加载 memh
    protected string dump_file; // 可选：结束时用 config_db 里的路径把当前数据写成 memh
    protected string compare_path; // 可选：检查阶段用 config_db 里的 memh 路径和当前数据比较

    function new(string name="{{ class_prefix }}sequencer", uvm_component parent=null);
        super.new(name, parent);
    endfunction

    extern function void build_phase(uvm_phase phase);
    extern function void start_of_simulation_phase(uvm_phase phase);
    extern function void check_phase(uvm_phase phase);
    extern function void final_phase(uvm_phase phase);

    // 按 payload 里的地址和数据写入 memory，并再从 o_ap 发出去
    extern function void write(uvm_tlm_generic_payload payload);

    extern function void clear();

    extern function void write_byte(bit [63:0] addr, bit [7:0] data);
    extern function bit [7:0] read_byte(bit [63:0] addr, bit [7:0] default_value='0);

    extern function void write_data(bit [63:0] addr, bit [7:0] data[$]);
    // 从 addr 起读 len 个字节；某个地址没写过则用 default_value 填
    extern function void read_data(input bit [63:0] addr, input int len, output bit [7:0] data_q[$], input bit [7:0] default_value='0);

    extern function void write_payload(uvm_tlm_generic_payload payload);
    extern function uvm_tlm_generic_payload read_payload(bit [63:0] addr, int len, string name="memh_payload");

    // 读 memh 文件；行里以 @ 换地址，后面是十六进制字节；clear_first 为真则先清空 memory
    extern function bit load_file(string filename, bit clear_first=0);
    extern function bit save_file(string filename);

    extern function bit compare_file(string filename);
    // 和 expected 比较：两边出现过的地址必须一致，同一地址上的字节也必须一致
    extern function bit compare_memory(ref bit [7:0] expected[bit [63:0]], input string expected_name="expected");

    extern protected function void mh_mem_store_byte(bit [63:0] addr, bit [7:0] data);
    extern protected function void mh_notify_on_write(bit [63:0] addr, bit [7:0] data[$]);
    extern local function void mh_notify_after_read_data(input bit [63:0] addr, input int len, ref bit [7:0] data[$]);
    extern protected function void mh_notify_on_clear();
    extern local function void mh_fill_shim_from_memory_with_read_cb(output bit [7:0] shim[bit [63:0]]);
    extern protected function void mh_merge_loaded_map(ref bit [7:0] load_memory[bit [63:0]]);
    extern protected function void mh_clear_mem();
    extern protected function void mh_write_byte_impl(bit [63:0] addr, bit [7:0] data);
    extern protected function bit [7:0] mh_read_byte_impl(bit [63:0] addr, bit [7:0] default_value);
    extern protected function void mh_read_data_impl(input bit [63:0] addr, input int len, output bit [7:0] data_q[$], input bit [7:0] default_value);
    extern protected function void mh_write_data_impl(bit [63:0] addr, bit [7:0] data[$]);
    extern protected function void mh_write_payload_impl(uvm_tlm_generic_payload payload);
    extern protected function uvm_tlm_generic_payload mh_read_payload_impl(bit [63:0] addr, int len, string name);
    extern protected function bit mh_load_file_impl(string filename, bit clear_first);
    extern protected function void mh_emit_load_payloads(ref bit [7:0] load_memory[bit [63:0]]);
    extern protected function void mh_emit_load_payload(input bit [63:0] addr, ref bit [7:0] data_q[$]);
    extern protected function bit mh_save_file_impl(string filename);
    extern protected function bit mh_compare_file_impl(string filename);
    extern protected function bit mh_compare_memory_impl(ref bit [7:0] expected[bit [63:0]], input string expected_name);
endclass


function void {{ class_prefix }}sequencer::mh_mem_store_byte(bit [63:0] addr, bit [7:0] data);
    memory[addr] = data;
endfunction

function void {{ class_prefix }}sequencer::mh_notify_on_write(bit [63:0] addr, bit [7:0] data[$]);
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, this, on_write_data(addr, data))
endfunction

function void {{ class_prefix }}sequencer::mh_notify_on_clear();
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, this, on_clear())
endfunction

function void {{ class_prefix }}sequencer::mh_notify_after_read_data(input bit [63:0] addr, input int len, ref bit [7:0] data[$]);
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, this, after_read_data(addr, len, data))
    if (data.size() != len)
        `uvm_fatal("MEMH_RD_CB", $sformatf("after_read_data must keep data.size()==len: addr=0x%016h len=%0d data.size=%0d", addr, len, data.size()))
endfunction

function void {{ class_prefix }}sequencer::mh_fill_shim_from_memory_with_read_cb(output bit [7:0] shim[bit [63:0]]);
    bit [63:0] addrs[$];
    bit [63:0] run_base;
    int run_len;
    int i;
    int j;
    bit [7:0] q[$];

    shim.delete();
    addrs.delete();
    foreach (memory[a])
        addrs.push_back(a);
    if (addrs.size() == 0)
        return;
    addrs.sort();
    run_base = addrs[0];
    run_len = 1;
    for (i = 1; i < addrs.size(); i++) begin
        if (addrs[i] == addrs[i - 1] + 1) begin
            run_len++;
        end else begin
            mh_read_data_impl(run_base, run_len, q, '0);
            for (j = 0; j < run_len; j++)
                shim[run_base + j] = q[j];
            run_base = addrs[i];
            run_len = 1;
        end
    end
    mh_read_data_impl(run_base, run_len, q, '0);
    for (j = 0; j < run_len; j++)
        shim[run_base + j] = q[j];
endfunction

function void {{ class_prefix }}sequencer::mh_merge_loaded_map(ref bit [7:0] load_memory[bit [63:0]]);
    bit has_run;
    bit [63:0] run_addr;
    bit [63:0] last_addr;
    bit [7:0] data_q[$];

    foreach (load_memory[addr]) begin
        if (!has_run) begin
            has_run = 1;
            run_addr = addr;
            last_addr = addr;
            data_q.delete();
            data_q.push_back(load_memory[addr]);
            mh_mem_store_byte(addr, load_memory[addr]);
        end else if (addr == last_addr + 1) begin
            last_addr = addr;
            data_q.push_back(load_memory[addr]);
            mh_mem_store_byte(addr, load_memory[addr]);
        end else begin
            mh_notify_on_write(run_addr, data_q);
            run_addr = addr;
            last_addr = addr;
            data_q.delete();
            data_q.push_back(load_memory[addr]);
            mh_mem_store_byte(addr, load_memory[addr]);
        end
    end

    if (has_run)
        mh_notify_on_write(run_addr, data_q);
endfunction

function void {{ class_prefix }}sequencer::mh_clear_mem();
    memory.delete();
    mh_notify_on_clear();
endfunction

function void {{ class_prefix }}sequencer::mh_write_byte_impl(bit [63:0] addr, bit [7:0] data);
    bit [7:0] one[$];

    mh_mem_store_byte(addr, data);
    one.delete();
    one.push_back(data);
    mh_notify_on_write(addr, one);
endfunction

function bit [7:0] {{ class_prefix }}sequencer::mh_read_byte_impl(bit [63:0] addr, bit [7:0] default_value);
    bit [7:0] dq[$];

    dq.delete();
    if (memory.exists(addr))
        dq.push_back(memory[addr]);
    else
        dq.push_back(default_value);
    mh_notify_after_read_data(addr, 1, dq);
    return dq[0];
endfunction

function void {{ class_prefix }}sequencer::mh_read_data_impl(input bit [63:0] addr, input int len, output bit [7:0] data_q[$], input bit [7:0] default_value);
    bit [63:0] a;

    data_q.delete();
    for (int i = 0; i < len; i++) begin
        a = addr + i;
        if (memory.exists(a))
            data_q.push_back(memory[a]);
        else
            data_q.push_back(default_value);
    end
    if (len > 0)
        mh_notify_after_read_data(addr, len, data_q);
endfunction

function void {{ class_prefix }}sequencer::mh_write_data_impl(bit [63:0] addr, bit [7:0] data[$]);
    foreach (data[i])
        mh_mem_store_byte(addr + i, data[i]);
    if (data.size() > 0)
        mh_notify_on_write(addr, data);
endfunction

function void {{ class_prefix }}sequencer::mh_write_payload_impl(uvm_tlm_generic_payload payload);
    byte unsigned data_dyn[];
    bit [63:0] addr;
    int len;
    bit [7:0] wr_q[$];

    if (payload == null) begin
        `uvm_error("", "write_payload got null payload")
        return;
    end

    `uvm_info("", $sformatf("write payload input:\n%s", payload.sprint()), UVM_DEBUG)

    addr = payload.get_address();
    payload.get_data(data_dyn);
    len = payload.get_data_length();
    if (len == 0 || len > data_dyn.size())
        len = data_dyn.size();

    wr_q.delete();
    for (int i = 0; i < len; i++) begin
        mh_mem_store_byte(addr + i, data_dyn[i]);
        wr_q.push_back(data_dyn[i]);
    end
    if (len > 0)
        mh_notify_on_write(addr, wr_q);

    `uvm_info("", $sformatf("write payload output:\n%s", payload.sprint()), UVM_DEBUG)
    o_ap.write(payload);
endfunction

function uvm_tlm_generic_payload {{ class_prefix }}sequencer::mh_read_payload_impl(bit [63:0] addr, int len, string name);
    uvm_tlm_generic_payload payload;
    bit [7:0] data_q[$];
    byte unsigned data_dyn[];

    payload = uvm_tlm_generic_payload::type_id::create(name);
    mh_read_data_impl(addr, len, data_q, '0);
    data_dyn = new[data_q.size()];
    foreach (data_q[i])
        data_dyn[i] = data_q[i];

    payload.set_command(UVM_TLM_READ_COMMAND);
    payload.set_address(addr);
    payload.set_data(data_dyn);
    payload.set_data_length(len);
    payload.set_streaming_width(len);
    payload.set_response_status(UVM_TLM_OK_RESPONSE);
    `uvm_info("", $sformatf("read payload output:\n%s", payload.sprint()), UVM_DEBUG)
    return payload;
endfunction

function bit {{ class_prefix }}sequencer::mh_load_file_impl(string filename, bit clear_first);
    bit [7:0] load_memory[bit [63:0]];

    if (!memh_eng.read_into_map(filename, load_memory, 1))
        return 0;

    if (clear_first)
        memory.delete();

    mh_merge_loaded_map(load_memory);

    `uvm_info("", $sformatf("load memh file to memory: %s", filename), UVM_LOW)
    mh_emit_load_payloads(load_memory);
    return 1;
endfunction

function void {{ class_prefix }}sequencer::mh_emit_load_payloads(ref bit [7:0] load_memory[bit [63:0]]);
    bit has_run;
    bit [63:0] run_addr;
    bit [63:0] last_addr;
    bit [7:0] data_q[$];

    foreach (load_memory[addr]) begin
        if (!has_run) begin
            has_run = 1;
            run_addr = addr;
            last_addr = addr;
            data_q.delete();
            data_q.push_back(load_memory[addr]);
        end else if (addr == last_addr + 1) begin
            last_addr = addr;
            data_q.push_back(load_memory[addr]);
        end else begin
            mh_emit_load_payload(run_addr, data_q);
            run_addr = addr;
            last_addr = addr;
            data_q.delete();
            data_q.push_back(load_memory[addr]);
        end
    end

    if (has_run)
        mh_emit_load_payload(run_addr, data_q);
endfunction

function void {{ class_prefix }}sequencer::mh_emit_load_payload(input bit [63:0] addr, ref bit [7:0] data_q[$]);
    uvm_tlm_generic_payload payload;
    byte unsigned data_dyn[];

    data_dyn = new[data_q.size()];
    foreach (data_q[i])
        data_dyn[i] = data_q[i];

    payload = uvm_tlm_generic_payload::type_id::create($sformatf("%s.load_payload_%0h", get_full_name(), addr));
    payload.set_command(UVM_TLM_WRITE_COMMAND);
    payload.set_address(addr);
    payload.set_data(data_dyn);
    payload.set_data_length(data_dyn.size());
    payload.set_streaming_width(data_dyn.size());
    payload.set_response_status(UVM_TLM_OK_RESPONSE);
    `uvm_info("", $sformatf("load payload output:\n%s", payload.sprint()), UVM_DEBUG)
    o_load_ap.write(payload);
endfunction

function bit {{ class_prefix }}sequencer::mh_save_file_impl(string filename);
    return memh_eng.write_from_map(filename, memory);
endfunction

function bit {{ class_prefix }}sequencer::mh_compare_file_impl(string filename);
    bit [7:0] expected[bit [63:0]];

    if (!memh_eng.read_into_map(filename, expected, 1))
        return 0;
    return mh_compare_memory_impl(expected, filename);
endfunction

function bit {{ class_prefix }}sequencer::mh_compare_memory_impl(ref bit [7:0] expected[bit [63:0]], input string expected_name);
    bit [7:0] shim[bit [63:0]];

    mh_fill_shim_from_memory_with_read_cb(shim);
    return memh_eng.compare_maps(shim, expected, expected_name);
endfunction



function void {{ class_prefix }}sequencer::build_phase(uvm_phase phase);
    super.build_phase(phase);

    memh_eng = new();

    imp = new("imp", this);
    o_ap = new("o_ap", this);
    o_load_ap = new("o_load_ap", this);

    void'(uvm_config_db #(string)::get(this, "", "dump_file", dump_file));
    void'(uvm_config_db #(string)::get(this, "", "compare_file", compare_path));
endfunction

function void {{ class_prefix }}sequencer::start_of_simulation_phase(uvm_phase phase);
    super.start_of_simulation_phase(phase);

    if (uvm_config_db #(string)::get(this, "", "init_file", init_file) && init_file.len()) begin
        `uvm_info("", $sformatf("load memh init file: %s", init_file), UVM_LOW)
        void'(load_file(init_file, 1));
    end
endfunction

function void {{ class_prefix }}sequencer::check_phase(uvm_phase phase);
    super.check_phase(phase);

    if (compare_path.len()) begin
        `uvm_info("", $sformatf("compare memory to memh: %s", compare_path), UVM_LOW)
        void'(compare_file(compare_path));
    end
endfunction

function void {{ class_prefix }}sequencer::final_phase(uvm_phase phase);
    super.final_phase(phase);

    if (dump_file.len()) begin
        `uvm_info("MEMH_DUMP", $sformatf("Writing memh to %s", dump_file), UVM_LOW)
        void'(save_file(dump_file));
    end
endfunction

function void {{ class_prefix }}sequencer::write(uvm_tlm_generic_payload payload);
    uvm_tlm_generic_payload p;

    if (payload == null) begin
        `uvm_error("", "write got null payload")
        return;
    end
    if (!$cast(p, payload.clone())) begin
        `uvm_error("", "clone uvm_tlm_generic_payload failed")
        return;
    end
    write_payload(p);
endfunction

function void {{ class_prefix }}sequencer::clear();
    mh_clear_mem();
endfunction

function void {{ class_prefix }}sequencer::write_byte(bit [63:0] addr, bit [7:0] data);
    mh_write_byte_impl(addr, data);
endfunction

function bit [7:0] {{ class_prefix }}sequencer::read_byte(bit [63:0] addr, bit [7:0] default_value='0);
    return mh_read_byte_impl(addr, default_value);
endfunction

function void {{ class_prefix }}sequencer::write_data(bit [63:0] addr, bit [7:0] data[$]);
    mh_write_data_impl(addr, data);
endfunction

function void {{ class_prefix }}sequencer::read_data(input bit [63:0] addr, input int len, output bit [7:0] data_q[$], input bit [7:0] default_value='0);
    mh_read_data_impl(addr, len, data_q, default_value);
endfunction

function void {{ class_prefix }}sequencer::write_payload(uvm_tlm_generic_payload payload);
    mh_write_payload_impl(payload);
endfunction

function uvm_tlm_generic_payload {{ class_prefix }}sequencer::read_payload(bit [63:0] addr, int len, string name="memh_payload");
    return mh_read_payload_impl(addr, len, name);
endfunction

function bit {{ class_prefix }}sequencer::load_file(string filename, bit clear_first=0);
    return mh_load_file_impl(filename, clear_first);
endfunction

function bit {{ class_prefix }}sequencer::save_file(string filename);
    return mh_save_file_impl(filename);
endfunction

function bit {{ class_prefix }}sequencer::compare_file(string filename);
    return mh_compare_file_impl(filename);
endfunction

function bit {{ class_prefix }}sequencer::compare_memory(ref bit [7:0] expected[bit [63:0]], input string expected_name="expected");
    return mh_compare_memory_impl(expected, expected_name);
endfunction


`endif
