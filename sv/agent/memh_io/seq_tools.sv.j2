`ifndef {{ (class_prefix ~ "seq_tools") | upper }}
`define {{ (class_prefix ~ "seq_tools") | upper }}

typedef class {{ class_prefix }}sequencer;

class {{ class_prefix }}seq_tools;
    protected {{ class_prefix }}sequencer m_sqr; // 经此访问宿主字节图与对外分析口
    protected {{ class_prefix }}engine m_eng; // memh 读写与双图比较共用的引擎

    // 缓存宿主与引擎句柄，供直连 memory 与文件侧子程序使用
    function new({{ class_prefix }}sequencer sqr, {{ class_prefix }}engine eng);
        m_sqr = sqr;
        m_eng = eng;
    endfunction

    // 只更新宿主字节图单元，不触发写区间回调
    extern function void mem_store_byte(bit [63:0] addr, bit [7:0] data);
    // 把一段顺序字节交给写区间回调（起始地址与队列一一对应）
    extern function void notify_on_write(bit [63:0] addr, const ref bit [7:0] data[$]);
    // 在整图清空后触发清空回调
    extern function void notify_on_clear();
    // 把加载图写入宿主 memory，并按连续地址段触发写区间回调
    extern function void merge_loaded_map(ref bit [7:0] load_memory[bit [63:0]]);
    // 清空宿主 memory 并触发清空回调
    extern function void clear_mem();
    // 单字节写入并触发该地址上的写区间回调
    extern function void write_byte(bit [63:0] addr, bit [7:0] data);
    // 读单字节；该地址从未写入时返回 default_value
    extern function bit [7:0] read_byte(bit [63:0] addr, bit [7:0] default_value);
    // 自起始地址顺序读 len 个字节填入 data_q
    // addr — 起始字节地址
    // len — 字节个数
    // data_q — 输出队列，低索引对应低地址
    // default_value — 未写过位置填充值
    extern function void read_data(input bit [63:0] addr, input int len, output bit [7:0] data_q[$], input bit [7:0] default_value);
    // 自 addr 起按队列顺序写字节，并对整段触发一次写区间回调
    extern function void write_data(bit [63:0] addr, const ref bit [7:0] data[$]);
    // 按 payload 写 memory，触发写区间回调后经 o_ap 再发同一条 payload
    extern function void write_payload(uvm_tlm_generic_payload payload);
    // 构造带读数据与 OK 状态的 TLM generic payload
    // addr — 起始字节地址
    // len — 字节个数
    // name — UVM 对象实例名
    extern function uvm_tlm_generic_payload read_payload(bit [63:0] addr, int len, string name);
    // 读入 memh；可选先清空 memory，合并进图后再按连续段发 load 写事务
    // filename — memh 文件路径
    // clear_first — 为真则先清空宿主 memory 再合并
    extern function bit load_file(string filename, bit clear_first);
    // 遍历加载图，按连续地址段逐段经 o_load_ap 发出写事务
    extern function void emit_load_payloads(ref bit [7:0] load_memory[bit [63:0]]);
    // 把一段连续字节打成一条写事务发到 o_load_ap
    // addr — 段首字节地址
    // data_q — 段内字节自低到高
    extern function void emit_load_payload(bit [63:0] addr, ref bit [7:0] data_q[$]);
    // 把宿主 memory 写成 memh；成功返回真
    extern function bit save_file(string filename);
    // 用 memh 文件与宿主 memory 对照；一致返回真
    extern function bit compare_file(string filename);
    // 宿主 memory 与 expected 逐地址对照；一致返回真
    // expected — 对照用字节图，键为字节地址
    // expected_name — 日志与报错里用的名字标签
    extern function bit compare_memory(ref bit [7:0] expected[bit [63:0]], input string expected_name);
endclass

function void {{ class_prefix }}seq_tools::mem_store_byte(bit [63:0] addr, bit [7:0] data);
    m_sqr.memory[addr] = data;
endfunction

function void {{ class_prefix }}seq_tools::notify_on_write(bit [63:0] addr, const ref bit [7:0] data[$]);
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, m_sqr, on_write_data(addr, data))
endfunction

function void {{ class_prefix }}seq_tools::notify_on_clear();
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, m_sqr, on_clear())
endfunction

function void {{ class_prefix }}seq_tools::merge_loaded_map(ref bit [7:0] load_memory[bit [63:0]]);
    bit has_run;
    bit [63:0] run_addr;
    bit [63:0] last_addr;
    bit [7:0] data_q[$];

    foreach (load_memory[addr]) begin
        if (!has_run) begin
            has_run = 1;
            run_addr = addr;
            last_addr = addr;
            data_q.delete();
            data_q.push_back(load_memory[addr]);
            mem_store_byte(addr, load_memory[addr]);
        end else if (addr == last_addr + 1) begin
            last_addr = addr;
            data_q.push_back(load_memory[addr]);
            mem_store_byte(addr, load_memory[addr]);
        end else begin
            notify_on_write(run_addr, data_q);
            run_addr = addr;
            last_addr = addr;
            data_q.delete();
            data_q.push_back(load_memory[addr]);
            mem_store_byte(addr, load_memory[addr]);
        end
    end

    if (has_run)
        notify_on_write(run_addr, data_q);
endfunction

function void {{ class_prefix }}seq_tools::clear_mem();
    m_sqr.memory.delete();
    notify_on_clear();
endfunction

function void {{ class_prefix }}seq_tools::write_byte(bit [63:0] addr, bit [7:0] data);
    bit [7:0] one[$];

    mem_store_byte(addr, data);
    one.delete();
    one.push_back(data);
    notify_on_write(addr, one);
endfunction

function bit [7:0] {{ class_prefix }}seq_tools::read_byte(bit [63:0] addr, bit [7:0] default_value);
    if (m_sqr.memory.exists(addr))
        return m_sqr.memory[addr];
    return default_value;
endfunction

function void {{ class_prefix }}seq_tools::read_data(input bit [63:0] addr, input int len, output bit [7:0] data_q[$], input bit [7:0] default_value);
    data_q.delete();
    for (int i = 0; i < len; i++)
        data_q.push_back(read_byte(addr + i, default_value));
endfunction

function void {{ class_prefix }}seq_tools::write_data(bit [63:0] addr, const ref bit [7:0] data[$]);
    foreach (data[i])
        mem_store_byte(addr + i, data[i]);
    if (data.size() > 0)
        notify_on_write(addr, data);
endfunction

function void {{ class_prefix }}seq_tools::write_payload(uvm_tlm_generic_payload payload);
    byte unsigned data_dyn[];
    bit [63:0] addr;
    int len;
    bit [7:0] wr_q[$];

    if (payload == null) begin
        `uvm_error("", "write_payload got null payload")
        return;
    end

    `uvm_info("", $sformatf("write payload input:\n%s", payload.sprint()), UVM_DEBUG)

    addr = payload.get_address();
    payload.get_data(data_dyn);
    len = payload.get_data_length();
    if (len == 0 || len > data_dyn.size())
        len = data_dyn.size();

    wr_q.delete();
    for (int i = 0; i < len; i++) begin
        mem_store_byte(addr + i, data_dyn[i]);
        wr_q.push_back(data_dyn[i]);
    end
    if (len > 0)
        notify_on_write(addr, wr_q);

    `uvm_info("", $sformatf("write payload output:\n%s", payload.sprint()), UVM_DEBUG)
    m_sqr.o_ap.write(payload);
endfunction

function uvm_tlm_generic_payload {{ class_prefix }}seq_tools::read_payload(bit [63:0] addr, int len, string name);
    uvm_tlm_generic_payload payload;
    bit [7:0] data_q[$];
    byte unsigned data_dyn[];

    payload = uvm_tlm_generic_payload::type_id::create(name);
    read_data(addr, len, data_q, '0);
    data_dyn = new[data_q.size()];
    foreach (data_q[i])
        data_dyn[i] = data_q[i];

    payload.set_command(UVM_TLM_READ_COMMAND);
    payload.set_address(addr);
    payload.set_data(data_dyn);
    payload.set_data_length(len);
    payload.set_streaming_width(len);
    payload.set_response_status(UVM_TLM_OK_RESPONSE);
    `uvm_info("", $sformatf("read payload output:\n%s", payload.sprint()), UVM_DEBUG)
    return payload;
endfunction

function bit {{ class_prefix }}seq_tools::load_file(string filename, bit clear_first);
    bit [7:0] load_memory[bit [63:0]];

    if (!m_eng.read_into_map(filename, load_memory, 1))
        return 0;

    if (clear_first)
        m_sqr.memory.delete();

    merge_loaded_map(load_memory);

    `uvm_info("", $sformatf("load memh file to memory: %s", filename), UVM_LOW)
    emit_load_payloads(load_memory);
    return 1;
endfunction

function void {{ class_prefix }}seq_tools::emit_load_payloads(ref bit [7:0] load_memory[bit [63:0]]);
    bit has_run;
    bit [63:0] run_addr;
    bit [63:0] last_addr;
    bit [7:0] data_q[$];

    foreach (load_memory[addr]) begin
        if (!has_run) begin
            has_run = 1;
            run_addr = addr;
            last_addr = addr;
            data_q.delete();
            data_q.push_back(load_memory[addr]);
        end else if (addr == last_addr + 1) begin
            last_addr = addr;
            data_q.push_back(load_memory[addr]);
        end else begin
            emit_load_payload(run_addr, data_q);
            run_addr = addr;
            last_addr = addr;
            data_q.delete();
            data_q.push_back(load_memory[addr]);
        end
    end

    if (has_run)
        emit_load_payload(run_addr, data_q);
endfunction

function void {{ class_prefix }}seq_tools::emit_load_payload(bit [63:0] addr, ref bit [7:0] data_q[$]);
    uvm_tlm_generic_payload payload;
    byte unsigned data_dyn[];

    data_dyn = new[data_q.size()];
    foreach (data_q[i])
        data_dyn[i] = data_q[i];

    payload = uvm_tlm_generic_payload::type_id::create($sformatf("%s.load_payload_%0h", m_sqr.get_full_name(), addr));
    payload.set_command(UVM_TLM_WRITE_COMMAND);
    payload.set_address(addr);
    payload.set_data(data_dyn);
    payload.set_data_length(data_dyn.size());
    payload.set_streaming_width(data_dyn.size());
    payload.set_response_status(UVM_TLM_OK_RESPONSE);
    `uvm_info("", $sformatf("load payload output:\n%s", payload.sprint()), UVM_DEBUG)
    m_sqr.o_load_ap.write(payload);
endfunction

function bit {{ class_prefix }}seq_tools::save_file(string filename);
    return m_eng.write_from_map(filename, m_sqr.memory);
endfunction

function bit {{ class_prefix }}seq_tools::compare_file(string filename);
    return m_eng.compare_map_to_memh(m_sqr.memory, filename);
endfunction

function bit {{ class_prefix }}seq_tools::compare_memory(ref bit [7:0] expected[bit [63:0]], input string expected_name);
    return m_eng.compare_maps(m_sqr.memory, expected, expected_name);
endfunction

`endif
