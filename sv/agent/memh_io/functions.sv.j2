`ifndef {{ (class_prefix ~ "functions") | upper }}
`define {{ (class_prefix ~ "functions") | upper }}

function automatic int {{ class_prefix }}memh_addr_hex_digits(input bit [63:0] max_addr);
    bit [63:0] a;
    int d;
    if (max_addr == 0)
        return 1;
    d = 0;
    a = max_addr;
    do begin
        d++;
        a = a >> 4;
    end while (a != 0);
    return d;
endfunction

function automatic string {{ class_prefix }}memh_padded_hex_addr(input bit [63:0] addr, input int hex_digits);
    string s;
    string ch;
    int i;
    bit [3:0] nib;
    s = "";
    for (i = hex_digits - 1; i >= 0; i--) begin
        nib = (addr >> (4 * i)) & 4'hF;
        $sformat(ch, "%0h", nib);
        s = {s, ch};
    end
    return s;
endfunction

function automatic void {{ class_prefix }}emit_memh_run(
    input int file,
    ref bit [7:0] src[bit [63:0]],
    input bit [63:0] base,
    input int len,
    input int addr_hex_digits,
    input int max_bytes_per_line
);
    int pos;
    int n;
    int k;
    bit [63:0] cur_addr;
    string addr_str;
    bit [7:0] b;

    for (pos = 0; pos < len; pos += max_bytes_per_line) begin
        n = len - pos;
        if (n > max_bytes_per_line)
            n = max_bytes_per_line;
        cur_addr = base + pos;
        addr_str = {{ class_prefix }}memh_padded_hex_addr(cur_addr, addr_hex_digits);
        $fwrite(file, "@%s", addr_str);
        for (k = 0; k < n; k++) begin
            b = src[cur_addr + k];
            $fwrite(file, " %02h", b);
        end
        $fwrite(file, "\n");
    end
endfunction

function automatic bit {{ class_prefix }}read_memh_file(string filename, ref bit [7:0] dst[bit [63:0]], input bit clear_first=1);
    int file;
    int code;
    int value;
    bit [63:0] addr;
    string token;
    string rest_of_line;

    if (clear_first)
        dst.delete();

    file = $fopen(filename, "r");
    if (!file) begin
        `uvm_error("", $sformatf("failed to open memh file: %s", filename))
        return 0;
    end

    addr = '0;
    while (!$feof(file)) begin
        code = $fscanf(file, "%s", token);
        if (code != 1) begin
            void'($fgets(rest_of_line, file));
            continue;
        end

        if (!token.len())
            continue;

        if (token.len() >= 2 && token.substr(0, 1) == "//") begin
            void'($fgets(rest_of_line, file));
            continue;
        end

        if (token.substr(0, 0) == "@") begin
            if (token.len() <= 1 || $sscanf(token.substr(1, token.len() - 1), "%h", addr) != 1) begin
                `uvm_error("", $sformatf("invalid memh address token '%s' in %s", token, filename))
                $fclose(file);
                return 0;
            end
        end else begin
            if ($sscanf(token, "%h", value) != 1) begin
                `uvm_error("", $sformatf("invalid memh data token '%s' in %s", token, filename))
                $fclose(file);
                return 0;
            end
            dst[addr] = value[7:0];
            addr++;
        end
    end

    $fclose(file);
    `uvm_info("", $sformatf("loaded %0d bytes from %s", dst.num(), filename), UVM_LOW)
    return 1;
endfunction

function automatic bit {{ class_prefix }}write_memh_file(
    string filename,
    ref bit [7:0] src[bit [63:0]],
    input int max_bytes_per_line={{ memh_max_bytes_per_line }}
);
    int file;
    int bytes_per_line;
    bit [63:0] max_addr;
    int addr_hex_digits;
    bit [63:0] addrs[$];
    bit [63:0] run_base;
    int run_len;
    int i;

    bytes_per_line = max_bytes_per_line;
    if (bytes_per_line < 1)
        bytes_per_line = 1;

    file = $fopen(filename, "w");
    if (!file) begin
        `uvm_error("", $sformatf("failed to open memh output file: %s", filename))
        return 0;
    end

    if (src.num() == 0) begin
        $fclose(file);
        return 1;
    end

    max_addr = 0;
    foreach (src[a])
        if (a > max_addr)
            max_addr = a;
    addr_hex_digits = {{ class_prefix }}memh_addr_hex_digits(max_addr);

    addrs.delete();
    foreach (src[a])
        addrs.push_back(a);
    addrs.sort();

    run_base = addrs[0];
    run_len = 1;
    for (i = 1; i < addrs.size(); i++) begin
        if (addrs[i] == addrs[i - 1] + 1)
            run_len++;
        else begin
            {{ class_prefix }}emit_memh_run(file, src, run_base, run_len, addr_hex_digits, bytes_per_line);
            run_base = addrs[i];
            run_len = 1;
        end
    end
    {{ class_prefix }}emit_memh_run(file, src, run_base, run_len, addr_hex_digits, bytes_per_line);

    $fclose(file);
    return 1;
endfunction

function automatic bit {{ class_prefix }}compare_memory(
    ref bit [7:0] actual[bit [63:0]],
    ref bit [7:0] expected[bit [63:0]],
    input string expected_name="expected"
);
    bit pass;

    pass = 1;
    foreach (actual[addr]) begin
        if (!expected.exists(addr)) begin
            `uvm_error("", $sformatf("memory compare failed: unexpected byte @0x%016h actual=0x%02h expected=<missing> (%s)", addr, actual[addr], expected_name))
            pass = 0;
        end else if (actual[addr] != expected[addr]) begin
            `uvm_error("", $sformatf("memory compare failed: mismatch @0x%016h actual=0x%02h expected=0x%02h (%s)", addr, actual[addr], expected[addr], expected_name))
            pass = 0;
        end
    end

    foreach (expected[addr]) begin
        if (!actual.exists(addr)) begin
            `uvm_error("", $sformatf("memory compare failed: missing byte @0x%016h actual=<missing> expected=0x%02h (%s)", addr, expected[addr], expected_name))
            pass = 0;
        end
    end

    if (pass)
        `uvm_info("", $sformatf("memory compare passed with %0d bytes (%s)", actual.num(), expected_name), UVM_LOW)
    return pass;
endfunction

function automatic bit {{ class_prefix }}compare_memh_file(
    ref bit [7:0] actual[bit [63:0]],
    input string filename
);
    bit [7:0] expected[bit [63:0]];

    if (!{{ class_prefix }}read_memh_file(filename, expected, 1))
        return 0;
    return {{ class_prefix }}compare_memory(actual, expected, filename);
endfunction

`endif
