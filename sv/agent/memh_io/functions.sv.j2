`ifndef {{ (class_prefix ~ "functions") | upper }}
`define {{ (class_prefix ~ "functions") | upper }}

// 读 memh 文件，把结果放进 dst；clear_first 为真则先清空 dst
function automatic bit {{ class_prefix }}read_memh_file(string filename, ref bit [7:0] dst[bit [63:0]], input bit clear_first=1);
    {{ class_prefix }}memh_engine eng;
    eng = new();
    return eng.read_into_map(filename, dst, clear_first);
endfunction

// 读完文件后从 start_addr 起按地址连续取字节放进 q；len 为负时遇到第一个没有数据的地址就停；len 非负时必须能连续取出 len 个字节
function automatic bit {{ class_prefix }}read_memh_file_to_byte_q(
    input string filename,
    output bit [7:0] q[$],
    input bit [63:0] start_addr='0,
    input int len=-1
);
    {{ class_prefix }}memh_engine eng;
    eng = new();
    return eng.read_file_to_byte_q(filename, q, start_addr, len);
endfunction

// 把（地址到字节）的存储写成 memh；每行数据字节数由引擎在生成时确定
function automatic bit {{ class_prefix }}write_memh_file(
    string filename,
    ref bit [7:0] src[bit [63:0]]
);
    {{ class_prefix }}memh_engine eng;
    eng = new();
    return eng.write_from_map(filename, src);
endfunction

// 两个存储里出现的地址必须相同，同一地址上的字节也必须相同
function automatic bit {{ class_prefix }}compare_memory(
    ref bit [7:0] actual[bit [63:0]],
    ref bit [7:0] expected[bit [63:0]],
    input string expected_name="expected"
);
    {{ class_prefix }}memh_engine eng;
    eng = new();
    return eng.compare_maps(actual, expected, expected_name);
endfunction

// 从 memh 文件读出期望数据，再和 actual 比较
function automatic bit {{ class_prefix }}compare_memh_file(
    ref bit [7:0] actual[bit [63:0]],
    input string filename
);
    {{ class_prefix }}memh_engine eng;
    eng = new();
    return eng.compare_map_to_memh(actual, filename);
endfunction

`endif
