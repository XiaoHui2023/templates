`ifndef {{ (class_prefix ~ "agent") | upper }}
`define {{ (class_prefix ~ "agent") | upper }}

class {{ class_prefix }}agent extends uvm_agent;
    `uvm_component_utils({{ class_prefix }}agent)

    {{ class_prefix }}sequencer sqr;
    uvm_analysis_port #(uvm_tlm_generic_payload) {{ o_ap }};

    protected uvm_reg_block regmodel;
    protected uvm_reg_map m_map;
    protected string init_file;
    protected string dump_file;
    protected {{ class_prefix }}reg_monitor_cb m_reg_cb;

    function new(string name="{{ class_prefix }}agent", uvm_component parent=null);
        super.new(name, parent);
    endfunction

    // 创建 sequencer、analysis port，挂 reg 回调与 config_db。
    extern function void build_phase(uvm_phase phase);
    // 仿真开始时按需清空或截断写出文件。
    extern function void start_of_simulation_phase(uvm_phase phase);
    // 将监控缓存写出 dump_file。
    extern function void final_phase(uvm_phase phase);
endclass

function void {{ class_prefix }}agent::build_phase(uvm_phase phase);
    super.build_phase(phase);

    sqr = {{ class_prefix }}sequencer::type_id::create("sqr", this);
    {{ o_ap }} = new("{{ o_ap }}", this);

    if (!uvm_config_db #(uvm_reg_block)::get(this, "", "regmodel", regmodel) || regmodel == null)
        `uvm_fatal("REG_IO", "uvm_config_db #(uvm_reg_block) regmodel is required")

    m_map = regmodel.get_default_map();
    if (m_map == null)
        `uvm_fatal("REG_IO", "no default uvm_reg_map on regmodel; add a default map")

    void'(uvm_config_db #(string)::get(this, "", "init_file", init_file));
    void'(uvm_config_db #(string)::get(this, "", "dump_file", dump_file));

    uvm_config_db #(uvm_reg_block)::set(this, "sqr", "regmodel", regmodel);
    uvm_config_db #(string)::set(this, "sqr", "init_file", init_file);

    m_reg_cb = {{ class_prefix }}reg_monitor_cb::type_id::create("ral_mon_cb", null);
    m_reg_cb.configure({{ o_ap }}, dump_file, m_map, regmodel);
    {{ class_prefix }}attach_reg_monitor_callbacks(regmodel, m_reg_cb);
    uvm_config_db #({{ class_prefix }}reg_monitor_cb)::set(this, "sqr", "reg_mon_cb", m_reg_cb);
endfunction

function void {{ class_prefix }}agent::start_of_simulation_phase(uvm_phase phase);
    int fd;

    super.start_of_simulation_phase(phase);

    if (!dump_file.len())
        return;

    if (m_reg_cb != null)
        m_reg_cb.clear_dump_rows();

    if (init_file.len() && init_file == dump_file)
        return;

    fd = $fopen(dump_file, "w");
    if (!fd)
        `uvm_warning("REG_IO_DUMP", $sformatf("could not truncate dump_file at sim start: %s", dump_file))
    else
        $fclose(fd);
endfunction

function void {{ class_prefix }}agent::final_phase(uvm_phase phase);
    super.final_phase(phase);

    if (dump_file.len() && m_reg_cb != null) begin
        `uvm_info("REG_IO_DUMP", $sformatf("writing reg csv dump to %s", dump_file), UVM_LOW)
        if (!m_reg_cb.flush_dump_csv(dump_file))
            `uvm_error("REG_IO_DUMP", $sformatf("flush_dump_csv failed path=%s", dump_file))
    end
endfunction

`endif
