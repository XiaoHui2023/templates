`ifndef {{ (class_prefix ~ "ral_bridge") | upper }}
`define {{ (class_prefix ~ "ral_bridge") | upper }}

// 按 '.' 拆分点分路径；从左到右填入 parts。
// s_in — 输入路径字符串
// parts — 各段名称
function automatic void {{ class_prefix }}split_dotted_path(input string s_in, ref string parts[$]);
    int start;
    int i;
    int k;
    string seg;
    string s;
    parts.delete();
    s = s_in;
    {{ class_prefix }}csv_trim_both(s);
    start = 0;
    for (i = 0; i < s.len(); i++) begin
        if (s.getc(i) == ".") begin
            if (i > start) begin
                seg = "";
                for (k = start; k < i; k++)
                    seg = {seg, s.getc(k)};
                {{ class_prefix }}csv_trim_both(seg);
                if (seg.len())
                    parts.push_back(seg);
            end
            start = i + 1;
        end
    end
    if (start < s.len()) begin
        seg = "";
        for (k = start; k < s.len(); k++)
            seg = {seg, s.getc(k)};
        {{ class_prefix }}csv_trim_both(seg);
        if (seg.len())
            parts.push_back(seg);
    end
endfunction

// 从 root 沿层次按名查找，返回末级的 uvm_reg。
// root — 起始寄存器块
// dotted_path — 相对 root 的点分路径，名称与 RAL 一致
function automatic uvm_reg {{ class_prefix }}resolve_reg_by_path(uvm_reg_block root, string dotted_path);
    uvm_reg_block cur;
    uvm_reg rg;
    string parts[$];
    int i;

    if (root == null || !dotted_path.len())
        return null;

    {{ class_prefix }}split_dotted_path(dotted_path, parts);
    if (!parts.size())
        return null;

    cur = root;
    for (i = 0; i < parts.size() - 1; i++) begin
        uvm_reg_block nxt;
        nxt = cur.get_block_by_name(parts[i]);
        if (nxt == null)
            return null;
        cur = nxt;
    end

    rg = cur.get_reg_by_name(parts[parts.size() - 1]);
    if (rg == null)
        return null;
    return rg;
endfunction

// 单个字符是否为十六进制数码；是则输出 0～15。
// ch — 输入字符
// nib — 输出的四位值
function automatic bit {{ class_prefix }}hex_nibble(input byte ch, output bit [3:0] nib);
    if (ch >= "0" && ch <= "9") begin
        nib = ch - "0";
        return 1;
    end
    if (ch >= "a" && ch <= "f") begin
        nib = 10 + (ch - "a");
        return 1;
    end
    if (ch >= "A" && ch <= "F") begin
        nib = 10 + (ch - "A");
        return 1;
    end
    return 0;
endfunction

// 解析 CSV「值」列为小端字节序列（支持 Verilog 宽度字面量、0x、纯十进制）。
// value_text — CSV 第二列原文
// n_bits — 寄存器位宽
// le_bytes — 输出的字节序列
function automatic bit {{ class_prefix }}parse_reg_value_text(
    string value_text,
    int n_bits,
    ref bit [7:0] le_bytes[$]
);
    string t;
    int i;
    int apos;
    bit [3:0] nib;
    bit [4095:0] acc;
    bit [4095:0] dec_acc;
    bit [4095:0] one;
    int w;
    string radix;
    string body;
    int n_bytes;

    le_bytes.delete();
    if (n_bits < 1) begin
        `uvm_error("REG_IO_RAL", "parse_reg_value_text: n_bits < 1")
        return 0;
    end

    n_bytes = (n_bits + 7) / 8;
    t = value_text;
    {{ class_prefix }}csv_trim_both(t);
    if (!t.len()) begin
        `uvm_error("REG_IO_RAL", "parse_reg_value_text: empty value")
        return 0;
    end

    apos = -1;
    for (i = 0; i < t.len(); i++)
        if (t.getc(i) == "'") begin
            apos = i;
            break;
        end

    if (apos >= 0 && apos + 2 < t.len()) begin
        if (apos > 0) begin
            if ($sscanf(t.substr(0, apos - 1), "%d", w) != 1) begin
                `uvm_error("REG_IO_RAL", $sformatf("bad verilog width in '%s'", value_text))
                return 0;
            end
        end else
            w = n_bits;
        radix = t.substr(apos + 1, apos + 1);
        body = t.substr(apos + 2, t.len() - 1);
        {{ class_prefix }}csv_trim_both(body);
        if (radix == "h" || radix == "H") begin
            acc = 0;
            foreach (body[j]) begin
                if (body.getc(j) == "_")
                    continue;
                if (!{{ class_prefix }}hex_nibble(body.getc(j), nib)) begin
                    `uvm_error("REG_IO_RAL", $sformatf("bad hex char in '%s'", value_text))
                    return 0;
                end
                acc = (acc << 4) | nib;
            end
        end else if (radix == "d" || radix == "D") begin
            dec_acc = 0;
            foreach (body[j]) begin
                if (body.getc(j) == "_")
                    continue;
                if (body.getc(j) < "0" || body.getc(j) > "9") begin
                    `uvm_error("REG_IO_RAL", $sformatf("bad dec char in '%s'", value_text))
                    return 0;
                end
                dec_acc = dec_acc * 10 + (body.getc(j) - "0");
            end
            acc = dec_acc;
        end else begin
            `uvm_error("REG_IO_RAL", $sformatf("unsupported radix in '%s' (use h or d)", value_text))
            return 0;
        end
    end else if (t.len() >= 2 && (t.substr(0, 1) == "0x" || t.substr(0, 1) == "0X")) begin
        body = t.substr(2, t.len() - 1);
        acc = 0;
        foreach (body[j]) begin
            if (body.getc(j) == "_")
                continue;
            if (!{{ class_prefix }}hex_nibble(body.getc(j), nib)) begin
                `uvm_error("REG_IO_RAL", $sformatf("bad 0x hex in '%s'", value_text))
                return 0;
            end
            acc = (acc << 4) | nib;
        end
    end else begin
        longint dec64;
        if ($sscanf(t, "%d", dec64) != 1) begin
            `uvm_error("REG_IO_RAL", $sformatf("bad decimal value '%s'", value_text))
            return 0;
        end
        acc = dec64;
    end

    if (n_bits < 4096) begin
        one = 1;
        acc = acc & ((one << n_bits) - 1);
    end
    for (i = 0; i < n_bytes; i++)
        le_bytes.push_back(acc[8 * i +: 8]);
    return 1;
endfunction

// 将小端字节格式化为 CSV 第二列常用十六进制字符串。
// le_bytes — 寄存器数据字节
// n_bits — 寄存器位宽
function automatic string {{ class_prefix }}format_le_bytes_as_csv_value(ref bit [7:0] le_bytes[$], input int n_bits);
    int n_bytes;
    bit [4095:0] acc;
    bit [4095:0] ext;
    int i;
    string s;
    string ch;
    int nib;
    int n_nib;
    int ms_nz;

    n_bytes = (n_bits + 7) / 8;
    acc = 0;
    for (i = 0; i < le_bytes.size() && i < n_bytes; i++) begin
        ext = 0;
        ext[7:0] = le_bytes[i];
        acc |= ext << (8 * i);
    end

    n_nib = (n_bits + 3) / 4;
    if (n_nib < 1)
        n_nib = 1;
    ms_nz = -1;
    for (nib = n_nib - 1; nib >= 0; nib--) begin
        if (((acc >> (4 * nib)) & 4'hF) != 0) begin
            ms_nz = nib;
            break;
        end
    end
    if (ms_nz < 0)
        ms_nz = 0;

    s = "0x";
    for (nib = ms_nz; nib >= 0; nib--) begin
        $sformat(ch, "%0h", (acc >> (4 * nib)) & 4'hF);
        s = {s, ch};
    end
    return s;
endfunction

// 递归遍历寄存器块树：为本层每个寄存器登记「起始地址 + 字节宽 → 相对路径」。
// blk — 当前块
// map — 用于算物理地址的 map
// rel_prefix — 当前块相对路径前缀
// lut — 输出查找表
function automatic void {{ class_prefix }}walk_register_map(
    uvm_reg_block blk,
    uvm_reg_map map,
    string rel_prefix,
    ref {{ class_prefix }}addr_hit lut[string]
);
    uvm_reg regs[$];
    uvm_reg_block subs[$];
    uvm_reg rg;
    uvm_reg_addr_t ra;
    int nb;
    string key;
    string pth;
    {{ class_prefix }}addr_hit hit;

    blk.get_registers(regs, UVM_NO_HIER);
    foreach (regs[i]) begin
        rg = regs[i];
        ra = rg.get_address(map);
        nb = (rg.get_n_bits() + 7) / 8;
        key = $sformatf("%016h_%0d", ra, nb);
        if (rel_prefix.len())
            pth = {rel_prefix, ".", rg.get_name()};
        else
            pth = rg.get_name();
        hit = new;
        hit.path = pth;
        hit.n_bytes = nb;
        if (lut.exists(key) && lut[key].path != hit.path)
            `uvm_warning("REG_IO_RAL", $sformatf("addr lut collision key=%s old=%s new=%s", key, lut[key].path, hit.path))
        lut[key] = hit;
    end

    blk.get_blocks(subs, UVM_NO_HIER);
    foreach (subs[j]) begin
        string np;
        if (rel_prefix.len())
            np = {rel_prefix, ".", subs[j].get_name()};
        else
            np = subs[j].get_name();
        {{ class_prefix }}walk_register_map(subs[j], map, np, lut);
    end
endfunction

// 清空并重建 root 子树下整张「地址+字节宽 → 寄存器路径」查找表。
// root — 起始寄存器块
// map — 地址 map
// lut — 输出查找表
function automatic bit {{ class_prefix }}build_reg_addr_lut(
    uvm_reg_block root,
    uvm_reg_map map,
    ref {{ class_prefix }}addr_hit lut[string]
);
    lut.delete();
    if (root == null || map == null)
        return 0;
    {{ class_prefix }}walk_register_map(root, map, "", lut);
    return 1;
endfunction

// 将一行 CSV 转成一笔 TLM 写事务（不访问寄存器）。
// root — 寄存器根块
// map — 地址 map
// row — 路径与值文本
// payload_o — 输出的写事务
function automatic bit {{ class_prefix }}reg_row_to_payload(
    uvm_reg_block root,
    uvm_reg_map map,
    {{ class_prefix }}csv_row row,
    output uvm_tlm_generic_payload payload_o
);
    uvm_reg rg;
    int nb;
    uvm_reg_addr_t ra;
    bit [7:0] le[$];
    byte unsigned dyn[];
    uvm_tlm_generic_payload p;

    payload_o = null;
    if (root == null || map == null)
        return 0;

    rg = {{ class_prefix }}resolve_reg_by_path(root, row.path);
    if (rg == null) begin
        `uvm_error("REG_IO_RAL", $sformatf("resolve failed: %s", row.path))
        return 0;
    end

    if (!{{ class_prefix }}parse_reg_value_text(row.value_text, rg.get_n_bits(), le))
        return 0;

    nb = le.size();
    ra = rg.get_address(map);
    dyn = new[nb];
    foreach (le[i])
        dyn[i] = le[i];

    p = uvm_tlm_generic_payload::type_id::create($sformatf("reg_io_row_%0t_%0d", $time, $urandom()));
    p.set_command(UVM_TLM_WRITE_COMMAND);
    p.set_address(ra);
    p.set_data(dyn);
    p.set_data_length(nb);
    p.set_streaming_width(nb);
    p.set_response_status(UVM_TLM_OK_RESPONSE);
    payload_o = p;
    return 1;
endfunction

// 按一行 CSV 经前门写入寄存器模型。
// root — 寄存器根块
// map — 地址 map
// row — 路径与值
// ok — 写入是否成功
task automatic {{ class_prefix }}commit_csv_row_to_reg(
    uvm_reg_block root,
    uvm_reg_map map,
    {{ class_prefix }}csv_row row,
    output bit ok
);
    uvm_reg rg;
    bit [7:0] le[$];
    uvm_reg_data_t v;
    uvm_status_e st;

    ok = 0;
    if (root == null || map == null)
        return;

    rg = {{ class_prefix }}resolve_reg_by_path(root, row.path);
    if (rg == null) begin
        `uvm_error("REG_IO_RAL", $sformatf("commit resolve failed: %s", row.path))
        return;
    end

    if (!{{ class_prefix }}parse_reg_value_text(row.value_text, rg.get_n_bits(), le))
        return;
    if (!{{ class_prefix }}le_bytes_to_uvm_reg_data(le, rg.get_n_bits(), v))
        return;

    rg.write(st, v, UVM_FRONTDOOR, map, null);
    if (st != UVM_IS_OK) begin
        `uvm_error("REG_IO_RAL", $sformatf("commit reg write failed path=%s", row.path))
        return;
    end
    `uvm_info("REG_IO", $sformatf("csv commit path=%s value=%s", row.path, row.value_text), UVM_LOW)
    ok = 1;
endtask

// 小端字节队列合并为 uvm_reg_data_t（与其它接口字节序一致）。
// le — 数据字节
// n_bits — 寄存器位宽
// val — 输出的寄存器值
function automatic bit {{ class_prefix }}le_bytes_to_uvm_reg_data(
    ref bit [7:0] le[$],
    input int n_bits,
    output uvm_reg_data_t val
);
    int n_bytes;
    int i;
    val = 0;
    n_bytes = (n_bits + 7) / 8;
    if (n_bits > $bits(val)) begin
        `uvm_error("REG_IO_RAL", $sformatf("register width %0d exceeds uvm_reg_data_t", n_bits))
        return 0;
    end
    for (i = 0; i < le.size() && i < n_bytes; i++)
        val |= uvm_reg_data_t'(le[i]) << (8 * i);
    return 1;
endfunction

// 从 TLM generic payload 取出数据字节序列。
// p — 输入事务
// le — 输出的字节序列
function automatic bit {{ class_prefix }}payload_to_le_bytes(
    uvm_tlm_generic_payload p,
    ref bit [7:0] le[$]
);
    byte unsigned dyn[];
    int len;
    int i;

    le.delete();
    if (p == null)
        return 0;
    p.get_data(dyn);
    len = p.get_data_length();
    if (len <= 0 || len > dyn.size())
        len = dyn.size();
    for (i = 0; i < len; i++)
        le.push_back(dyn[i]);
    return 1;
endfunction

// 寄存器相对根寄存器块的点分路径；若 rg 不在该子树下返回空串。
// root — 路径展开的参考根块
// rg — 目标寄存器
function automatic string {{ class_prefix }}reg_path_under_root(uvm_reg_block root, uvm_reg rg);
    uvm_object ob;
    string segs[$];
    int guard;
    bit found;

    if (root == null || rg == null)
        return "";
    found = 0;
    ob = rg.get_parent();
    segs.push_back(rg.get_name());
    guard = 0;
    while (ob != null && guard < 512) begin
        uvm_reg_block blk;
        if ($cast(blk, ob)) begin
            if (blk == root) begin
                found = 1;
                break;
            end
            segs.push_front(blk.get_name());
        end
        ob = ob.get_parent();
        guard++;
    end
    if (!found)
        return "";
    begin
        string s;
        int i;
        s = "";
        for (i = 0; i < segs.size(); i++) begin
            if (i > 0)
                s = {s, ".", segs[i]};
            else
                s = segs[i];
        end
        return s;
    end
endfunction

// 将寄存器数值按位宽拆成小端字节序列。
// v — 寄存器值
// n_bits — 位宽
// le — 输出字节序列
function automatic void {{ class_prefix }}uvm_reg_data_to_le(
    input uvm_reg_data_t v,
    input int n_bits,
    ref bit [7:0] le[$]
);
    int n_bytes;
    int i;

    le.delete();
    n_bytes = (n_bits + 7) / 8;
    for (i = 0; i < n_bytes; i++)
        le.push_back(v[8 * i +: 8]);
endfunction

// 从 uvm_reg_item 拼整寄存器数值（按各 field 的 LSB 对齐）。
// rg — 寄存器句柄
// rw — RAL 访问项
// v — 输出的合并值
function automatic bit {{ class_prefix }}reg_item_pack_value(
    uvm_reg rg,
    uvm_reg_item rw,
    output uvm_reg_data_t v
);
    uvm_reg_field fds[$];
    int i;
    int n;

    v = 0;
    if (rg == null || rw == null)
        return 0;

    rg.get_fields(fds);
    n = fds.size();
    if (n == 0) begin
        if (rw.value.size() >= 1)
            v = rw.value[0];
        return 1;
    end
    if (rw.value.size() < n)
        n = rw.value.size();
    for (i = 0; i < n; i++)
        v |= rw.value[i] << fds[i].get_lsb_pos();
    return 1;
endfunction

// 将一次寄存器访问项转成 TLM generic payload（用于监控口）。
// root — 路径参考根块
// map — 默认 map；rw.map 非空时优先使用
// rw — RAL 回调传入的访问项
// is_write — 本次是否为写
// p — 输出的 TLM 事务
function automatic bit {{ class_prefix }}reg_item_to_tlm(
    uvm_reg_block root,
    uvm_reg_map map,
    uvm_reg_item rw,
    input bit is_write,
    output uvm_tlm_generic_payload p
);
    uvm_reg rg;
    uvm_reg_map use_map;
    uvm_reg_addr_t ra;
    uvm_reg_data_t val;
    int nb;
    bit [7:0] le[$];
    byte unsigned dyn[];

    p = null;
    if (root == null || map == null || rw == null)
        return 0;
    if (!$cast(rg, rw.element))
        return 0;

    use_map = rw.map;
    if (use_map == null)
        use_map = map;

    if (!{{ class_prefix }}reg_item_pack_value(rg, rw, val))
        return 0;

    {{ class_prefix }}uvm_reg_data_to_le(val, rg.get_n_bits(), le);
    nb = le.size();
    ra = rg.get_address(use_map);
    dyn = new[nb];
    foreach (le[i])
        dyn[i] = le[i];

    p = uvm_tlm_generic_payload::type_id::create(
        $sformatf("ral_io_evt_%0t_%0d", $time, $urandom())
    );
    p.set_command(is_write ? UVM_TLM_WRITE_COMMAND : UVM_TLM_READ_COMMAND);
    p.set_address(ra);
    p.set_data(dyn);
    p.set_data_length(nb);
    p.set_streaming_width(nb);
    p.set_response_status(UVM_TLM_OK_RESPONSE);
    return 1;
endfunction

// 按地址 LUT 将 TLM 写事务前门写入对应寄存器。
// root — 寄存器根块
// map — 地址 map
// lut — 地址与字节宽键到寄存器路径
// p — 输入写事务
// ok — 是否写入成功
task automatic {{ class_prefix }}apply_payload_to_reg(
    uvm_reg_block root,
    uvm_reg_map map,
    ref {{ class_prefix }}addr_hit lut[string],
    input uvm_tlm_generic_payload p,
    output bit ok
);
    uvm_reg_addr_t ra;
    int len;
    string key;
    {{ class_prefix }}addr_hit hit;
    uvm_reg rg;
    bit [7:0] le[$];
    uvm_reg_data_t v;
    uvm_status_e st;

    ok = 0;
    if (root == null || map == null || p == null)
        return;

    ra = p.get_address();
    len = p.get_data_length();
    key = $sformatf("%016h_%0d", ra, len);

    if (!lut.exists(key)) begin
        `uvm_warning("REG_IO_RAL", $sformatf("no reg for payload addr=0x%0h len=%0d", ra, len))
        return;
    end

    hit = lut[key];
    rg = {{ class_prefix }}resolve_reg_by_path(root, hit.path);
    if (rg == null) begin
        `uvm_error("REG_IO_RAL", $sformatf("lut path resolve failed: %s", hit.path))
        return;
    end

    if (!{{ class_prefix }}payload_to_le_bytes(p, le))
        return;
    if (!{{ class_prefix }}le_bytes_to_uvm_reg_data(le, rg.get_n_bits(), v))
        return;

    rg.write(st, v, UVM_FRONTDOOR, map, null);
    if (st != UVM_IS_OK)
        `uvm_error("REG_IO_RAL", $sformatf("reg write failed path=%s", hit.path))
    ok = (st == UVM_IS_OK);
endtask

`endif
