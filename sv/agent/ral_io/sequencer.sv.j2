`ifndef {{ (class_prefix ~ "sequencer") | upper }}
`define {{ (class_prefix ~ "sequencer") | upper }}

class {{ class_prefix }}sequencer extends uvm_sequencer;
    `uvm_component_utils({{ class_prefix }}sequencer)

    protected uvm_reg_block m_root;
    protected uvm_reg_map m_map;
    protected string init_file;

    function new(string name="{{ class_prefix }}sequencer", uvm_component parent=null);
        super.new(name, parent);
    endfunction

    extern function void build_phase(uvm_phase phase);
    extern task main_phase(uvm_phase phase);

    // load_csv — 读寄存器 CSV 并前门写入模型。
    // filename — CSV 路径
    // clear_dump_first — 为 1 时先清空监控回调里待写出的写记录队列
    // ok — 全程是否成功
    extern task load_csv(
        input string filename,
        input bit clear_dump_first,
        output bit ok
    );
endclass

function void {{ class_prefix }}sequencer::build_phase(uvm_phase phase);
    super.build_phase(phase);

    if (!uvm_config_db #(uvm_reg_block)::get(this, "", "regmodel", m_root) || m_root == null)
        `uvm_fatal("REG_IO", "uvm_config_db #(uvm_reg_block) regmodel is required for reg_io sequencer")

    m_map = m_root.get_default_map();
    if (m_map == null)
        `uvm_fatal("REG_IO", "no default uvm_reg_map on regmodel; add a default map")

    void'(uvm_config_db #(string)::get(this, "", "init_file", init_file));
endfunction

task {{ class_prefix }}sequencer::main_phase(uvm_phase phase);
    if (init_file.len()) begin
        bit ok;

        phase.raise_objection(this);
        `uvm_info("REG_IO", $sformatf("init reg csv (main_phase): %s", init_file), UVM_LOW)
        load_csv(init_file, 0, ok);
        if (!ok)
            `uvm_error("REG_IO", $sformatf("load_csv failed for init_file=%s", init_file))
        phase.drop_objection(this);
    end
    super.main_phase(phase);
endtask

task {{ class_prefix }}sequencer::load_csv(
    input string filename,
    input bit clear_dump_first,
    output bit ok
);
    {{ class_prefix }}csv_row rows[$];

    ok = 0;
    if (clear_dump_first) begin
        {{ class_prefix }}reg_monitor_cb mon_cb;
        if (uvm_config_db #({{ class_prefix }}reg_monitor_cb)::get(this, "", "reg_mon_cb", mon_cb))
            if (mon_cb != null)
                mon_cb.clear_dump_rows();
    end

    if (!{{ class_prefix }}read_reg_csv_file(filename, rows))
        return;

    foreach (rows[i]) begin
        bit row_ok;
        {{ class_prefix }}commit_csv_row_to_reg(m_root, m_map, rows[i], row_ok);
        if (!row_ok)
            return;
    end
    ok = 1;
endtask

`endif
