`ifndef {{ (class_prefix ~ "ral_xact") | upper }}
`define {{ (class_prefix ~ "ral_xact") | upper }}

// TLM generic payload 与 CSV 行、RAL 前门访问之间的桥接。
class {{ class_prefix }}ral_xact;
    protected {{ class_prefix }}ral_conv m_conv;
    protected {{ class_prefix }}ral_path m_path;

    function new({{ class_prefix }}ral_conv conv = null, {{ class_prefix }}ral_path path = null);
        if (conv == null)
            m_conv = new;
        else
            m_conv = conv;
        if (path == null)
            m_path = new;
        else
            m_path = path;
    endfunction

    // 从 TLM payload 抽出字节序列为小端队列。
    // p — generic payload 句柄
    // le — 输出字节队列
    extern function bit payload_to_le_bytes(
        uvm_tlm_generic_payload p,
        ref bit [7:0] le[$]
    );
    // 将 CSV 行解析为前门写命令对应的 TLM payload。
    // root — RAL 根块
    // map — 前门 map
    // row — CSV 行（路径与值文本）
    // payload_o — 输出写事务 payload
    extern function bit reg_row_to_payload(
        uvm_reg_block root,
        uvm_reg_map map,
        {{ class_prefix }}csv_row row,
        output uvm_tlm_generic_payload payload_o
    );
    // 单行 CSV 解析并前门写入寄存器。
    // root — RAL 根块
    // map — 前门 map
    // row — CSV 行
    // ok — 全程是否成功
    extern task commit_csv_row_to_reg(
        uvm_reg_block root,
        uvm_reg_map map,
        {{ class_prefix }}csv_row row,
        output bit ok
    );
    // 将寄存器访问事务镜像打成 TLM generic payload。
    // root — RAL 根块
    // map — 前门 map（rw.map 为空时回退）
    // rw — uvm_reg_item 事务
    // is_write — 1 为写侧镜像，0 为读侧
    // p — 输出 payload
    extern function bit reg_item_to_tlm(
        uvm_reg_block root,
        uvm_reg_map map,
        uvm_reg_item rw,
        input bit is_write,
        output uvm_tlm_generic_payload p
    );
    // 按地址 LUT 键将 payload 写回对应寄存器。
    // root — RAL 根块
    // map — 前门 map
    // lut — 地址键到路径的查找表
    // p — 待写入的 TLM payload
    // ok — 写是否成功
    extern task apply_payload_to_reg(
        uvm_reg_block root,
        uvm_reg_map map,
        ref {{ class_prefix }}addr_hit lut[string],
        input uvm_tlm_generic_payload p,
        output bit ok
    );
endclass

function bit {{ class_prefix }}ral_xact::payload_to_le_bytes(
    uvm_tlm_generic_payload p,
    ref bit [7:0] le[$]
);
    byte unsigned dyn[];
    int len;
    int i;

    le.delete();
    if (p == null)
        return 0;
    p.get_data(dyn);
    len = p.get_data_length();
    if (len <= 0 || len > dyn.size())
        len = dyn.size();
    for (i = 0; i < len; i++)
        le.push_back(dyn[i]);
    return 1;
endfunction

function bit {{ class_prefix }}ral_xact::reg_row_to_payload(
    uvm_reg_block root,
    uvm_reg_map map,
    {{ class_prefix }}csv_row row,
    output uvm_tlm_generic_payload payload_o
);
    uvm_reg rg;
    int nb;
    uvm_reg_addr_t ra;
    bit [7:0] le[$];
    byte unsigned dyn[];
    uvm_tlm_generic_payload p;

    payload_o = null;
    if (root == null || map == null)
        return 0;

    rg = m_path.resolve_reg_by_path(root, row.path);
    if (rg == null) begin
        `uvm_error("REG_IO_RAL", $sformatf("resolve failed: %s", row.path))
        return 0;
    end

    if (!m_conv.parse_reg_value_text(row.value_text, rg.get_n_bits(), le))
        return 0;

    nb = le.size();
    ra = rg.get_address(map);
    dyn = new[nb];
    foreach (le[i])
        dyn[i] = le[i];

    p = uvm_tlm_generic_payload::type_id::create($sformatf("reg_io_row_%0t_%0d", $time, $urandom()));
    p.set_command(UVM_TLM_WRITE_COMMAND);
    p.set_address(ra);
    p.set_data(dyn);
    p.set_data_length(nb);
    p.set_streaming_width(nb);
    p.set_response_status(UVM_TLM_OK_RESPONSE);
    payload_o = p;
    return 1;
endfunction

task {{ class_prefix }}ral_xact::commit_csv_row_to_reg(
    uvm_reg_block root,
    uvm_reg_map map,
    {{ class_prefix }}csv_row row,
    output bit ok
);
    uvm_reg rg;
    bit [7:0] le[$];
    uvm_reg_data_t v;
    uvm_status_e st;

    ok = 0;
    if (root == null || map == null)
        return;

    rg = m_path.resolve_reg_by_path(root, row.path);
    if (rg == null) begin
        `uvm_error("REG_IO_RAL", $sformatf("commit resolve failed: %s", row.path))
        return;
    end

    if (!m_conv.parse_reg_value_text(row.value_text, rg.get_n_bits(), le))
        return;
    if (!m_conv.le_bytes_to_uvm_reg_data(le, rg.get_n_bits(), v))
        return;

    rg.write(st, v, UVM_FRONTDOOR, map, null);
    if (st != UVM_IS_OK) begin
        `uvm_error("REG_IO_RAL", $sformatf("commit reg write failed path=%s", row.path))
        return;
    end
    `uvm_info("REG_IO", $sformatf("csv commit path=%s value=%s", row.path, row.value_text), UVM_LOW)
    ok = 1;
endtask

function bit {{ class_prefix }}ral_xact::reg_item_to_tlm(
    uvm_reg_block root,
    uvm_reg_map map,
    uvm_reg_item rw,
    input bit is_write,
    output uvm_tlm_generic_payload p
);
    uvm_reg rg;
    uvm_reg_map use_map;
    uvm_reg_addr_t ra;
    uvm_reg_data_t val;
    int nb;
    bit [7:0] le[$];
    byte unsigned dyn[];

    p = null;
    if (root == null || map == null || rw == null)
        return 0;
    if (!$cast(rg, rw.element))
        return 0;

    use_map = rw.map;
    if (use_map == null)
        use_map = map;

    if (!m_conv.reg_item_pack_value(rg, rw, val))
        return 0;

    m_conv.uvm_reg_data_to_le(val, rg.get_n_bits(), le);
    nb = le.size();
    ra = rg.get_address(use_map);
    dyn = new[nb];
    foreach (le[i])
        dyn[i] = le[i];

    p = uvm_tlm_generic_payload::type_id::create(
        $sformatf("ral_io_evt_%0t_%0d", $time, $urandom())
    );
    p.set_command(is_write ? UVM_TLM_WRITE_COMMAND : UVM_TLM_READ_COMMAND);
    p.set_address(ra);
    p.set_data(dyn);
    p.set_data_length(nb);
    p.set_streaming_width(nb);
    p.set_response_status(UVM_TLM_OK_RESPONSE);
    return 1;
endfunction

task {{ class_prefix }}ral_xact::apply_payload_to_reg(
    uvm_reg_block root,
    uvm_reg_map map,
    ref {{ class_prefix }}addr_hit lut[string],
    input uvm_tlm_generic_payload p,
    output bit ok
);
    uvm_reg_addr_t ra;
    int len;
    string key;
    {{ class_prefix }}addr_hit hit;
    uvm_reg rg;
    bit [7:0] le[$];
    uvm_reg_data_t v;
    uvm_status_e st;

    ok = 0;
    if (root == null || map == null || p == null)
        return;

    ra = p.get_address();
    len = p.get_data_length();
    key = $sformatf("%016h_%0d", ra, len);

    if (!lut.exists(key)) begin
        `uvm_warning("REG_IO_RAL", $sformatf("no reg for payload addr=0x%0h len=%0d", ra, len))
        return;
    end

    hit = lut[key];
    rg = m_path.resolve_reg_by_path(root, hit.path);
    if (rg == null) begin
        `uvm_error("REG_IO_RAL", $sformatf("lut path resolve failed: %s", hit.path))
        return;
    end

    if (!payload_to_le_bytes(p, le))
        return;
    if (!m_conv.le_bytes_to_uvm_reg_data(le, rg.get_n_bits(), v))
        return;

    rg.write(st, v, UVM_FRONTDOOR, map, null);
    if (st != UVM_IS_OK)
        `uvm_error("REG_IO_RAL", $sformatf("reg write failed path=%s", hit.path))
    ok = (st == UVM_IS_OK);
endtask

`endif
