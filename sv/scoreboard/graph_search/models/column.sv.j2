`ifndef {{ class_column | upper }}
`define {{ class_column | upper }}

class {{ class_column }};
    typedef {{ class_transfer }} transfer_queue[$];

    function new(int id=-1,{{ class_transfer }} transfer_list[$]='{},int pointer=0);
        this.id = id;
        this.transfer_list = transfer_list;
        this.pointer = pointer;
    endfunction

