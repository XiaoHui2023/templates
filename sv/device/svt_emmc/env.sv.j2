`ifndef {{ class_prefix | upper }}ENV
`define {{ class_prefix | upper }}ENV

class {{ class_prefix }}env extends uvm_env;
    `uvm_component_utils({{ class_prefix }}env)

    virtual svt_emmc_if svt_if; // ??
    svt_emmc_card_agent svt_agt;
    {{ class_prefix }}catcher catcher;
    {{ class_prefix }}system_configuration sys_cfg;
    {{ class_prefix }}svt_configuration svt_cfg;

    function new(string name = "{{ class_prefix }}env", uvm_component parent = null);
        super.new(name, parent);

        sys_cfg = {{ class_prefix }}system_configuration::type_id::create({get_full_name(), ".sys_cfg"});
    endfunction

    extern function void build();
    extern function void start_of_simulation();

    // ????
    extern virtual function void ignore_report();

    // ??????ID
    extern virtual function void ignore_report_id(string id, uvm_severity src_severity=UVM_ERROR, uvm_severity tar_severity=UVM_INFO);
endclass

function void {{ class_prefix }}env::build();
    super.build();

    uvm_config_db#({{ class_prefix }}system_configuration)::get(this,"","sys_cfg",sys_cfg);
    if(!uvm_config_db#(virtual svt_emmc_if)::get(this, "", "svt_if", svt_if))
        `uvm_fatal("","require svt_if")

    svt_agt = svt_emmc_card_agent::type_id::create("svt_agt",this);

    // catcher
    catcher = new;
    uvm_report_cb::add(svt_agt,catcher);
    uvm_report_cb::add(svt_agt.card,catcher);

    if(!sys_cfg.has_randomized)
        assert(sys_cfg.randomize()) else `uvm_fatal("","randomize failed")
    `uvm_info("",$psprintf("system config: \n%s",sys_cfg.sprint()),UVM_LOW)

    // generate svt configuration
    svt_cfg = {{ class_prefix }}svt_configuration::type_id::create({get_full_name(),".svt_cfg"});
    svt_cfg.configure(sys_cfg);
    `uvm_info("",$psprintf("svt config :\n%s",svt_cfg.sprint()),UVM_DEBUG)

    /** Apply the card configuration to the card agent */
    uvm_config_db#(svt_emmc_card_agent_configuration)::set(this,"svt_agt","cfg", svt_cfg);

    /** Set up the VIF references in card & host config */
    svt_cfg.emmc_if = svt_if;
endfunction

function void {{ class_prefix }}env::start_of_simulation();
    super.start_of_simulation();

    ignore_report();
endfunction

function void {{ class_prefix }}env::ignore_report();
    ignore_report_id("Invalid Frequency change");

    {%- if is_emmc %}
    ignore_report_id("register_fail:EMMC:timing_group:max_data_transfer_frequency_check");
    ignore_report_id("register_fail:EMMC:timing_group:emmc_device_interface_timing_mode_config_frequency_range_check",UVM_WARNING);
    ignore_report_id("register_fail:EMMC:cmd_group:cmd1_argument_values_check");
    {%- elif is_sdio %}
    ignore_report_id("register_fail:SDIO:timing_group:sd_voltage_switching_low_clk_timing_check");
    ignore_report_id("register_fail:SDIO:timing_group:nwr_check",UVM_WARNING);
    {%- elif is_sdcard %}
    ignore_report_id("register_fail:SD:timing_group:sd_voltage_switching_low_clk_timing_check");
    // ??CMD5
    ignore_report_id("register_fail:SD:cmd_group:reserved_command_check");
    ignore_report_id("register_fail:SD:fsm_group:cmds_allowed_during_init_check");
    ignore_report_id("register_fail:SD:fsm_group:sd_valid_commands_in_idle_state_check");
    ignore_report_id("register_fail:SD:cmd_group:card_command_class_check");
    ignore_report_id("register_fail:SD:cmd_group:cmds_valid_card_is_not_selected_check");
    {%- endif %}

    if(!sys_cfg.should_check_timing) begin
        `uvm_info("","Ignore timing",UVM_LOW)
        {%- if is_emmc %}
        ignore_report_id("register_fail:EMMC:timing_group:input_setup_timing_check");
        ignore_report_id("register_fail:EMMC:timing_group:input_hold_timing_check");
        {%- elif is_sdio %}
        ignore_report_id("register_fail:SDIO:timing_group:sd_input_setup_timing_check");
        ignore_report_id("register_fail:SDIO:timing_group:sd_input_hold_timing_check");
        {%- elif is_sdcard %}
        ignore_report_id("register_fail:SD:timing_group:sd_input_setup_timing_check");
        ignore_report_id("register_fail:SD:timing_group:sd_input_hold_timing_check");
        {%- endif %}
    end
endfunction

function void {{ class_prefix }}env::ignore_report_id(string id,uvm_severity src_severity,uvm_severity tar_severity);
    svt_agt.set_report_severity_id_override(src_severity,id,tar_severity);
    svt_agt.set_report_id_verbosity(id,UVM_DEBUG);
    svt_agt.card.set_report_id_verbosity(id,UVM_DEBUG);
    catcher.add(id);
endfunction

`endif
