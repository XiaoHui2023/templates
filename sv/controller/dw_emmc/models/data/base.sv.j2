function {{ class_prefix }}bytes {{ class_prefix }}base_data::unpack();
    uvm_packer pk;
    byte unsigned d[];

    pk = new();
    pk.big_endian = 0;

    this.pack_bytes(d, pk);
    foreach(d[j])
        unpack[j] = d[j];
endfunction

function void {{ class_prefix }}base_data::pre_randomize();
    bit[7:0] d[$];
    super.pre_randomize();

    d = unpack();
    sizeof = d.size();
endfunction

