`define {{ class_prefix | upper }}BASE_DATA

class {{ class_prefix }}base_data extends {{ class_prefix }}base_item;
    `uvm_object_utils_begin({{ class_prefix }}base_data)
        `uvm_field_int(sizeof, UVM_ALL_ON | UVM_NOPACK | UVM_NOPRINT)
    `uvm_object_utils_end

    function new(string name = "{{ class_prefix }}base_data");
        super.new(name);
    endfunction

