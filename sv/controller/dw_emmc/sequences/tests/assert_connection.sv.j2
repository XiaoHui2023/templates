`ifndef {{ class_prefix | upper }}ASSERT_CONNECTION_TEST_SEQ
`define {{ class_prefix | upper }}ASSERT_CONNECTION_TEST_SEQ

class {{ class_prefix }}assert_connection_test_seq extends {{ class_prefix }}default_seq;
  `uvm_object_utils_begin({{ class_prefix }}assert_connection_test_seq)
    `uvm_field_int(should,UVM_ALL_ON)
                                            {%- for con in connections %}
    `uvm_field_int(should_{{ con.name }},UVM_ALL_ON)
                                            {%- endfor %}
  `uvm_object_utils_end

  function new(string name="{{ class_prefix }}assert_connection_test_seq");
    super.new(name);
  endfunction

  rand bit should; // 是否检查
                                            {%- for con in connections %}
  rand bit should_{{ con.name }}; // 是否检查{{ con.name }}
                                            {%- endfor %}

  constraint cst_test {
    soft should == sys_cfg.asrt_con_cfg.should;
                                            {%- for con in connections %}
    soft should_{{ con.name }} == sys_cfg.asrt_con_cfg.should_{{ con.name }};
                                            {%- endfor %}
  };

  extern task body();
endclass

task {{ class_prefix }}assert_connection_test_seq::body();
  if(!should)
    return;

  `uvm_info("",$psprintf("assert connections:\n%s",sprint()),UVM_DEBUG)

                                            {%- for con in connections %}
  if(should_{{ con.name }})
    p_sequencer.vif.connections_if.request_{{ con.name }};
                                            {%- endfor %}
endtask

`endif
