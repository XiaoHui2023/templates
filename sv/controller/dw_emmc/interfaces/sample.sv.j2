`ifndef {{ class_prefix | upper }}SAMPLE_INTERFACE
`define {{ class_prefix | upper }}SAMPLE_INTERFACE

interface {{ class_prefix }}sample_interface#(
    parameter int DW=1
)(
    input wire [DW-1:0] v
);

timeunit 1fs;
timeprecision 1fs;

bit is_enabled;
reg[DW-1:0] r;

initial begin
    r = {{ "'" }}0;
    if( ^v === {DW{1'bZ}} )
        is_enabled = 0;
end

// 采样
// wait forever begin @(v); if (v !== r) wait(is_enabled); end
// 注意使能
function automatic void enable(bit en);
    is_enabled = en;
    if(en) begin
        r = v;
    end
endfunction

endinterface
`endif
