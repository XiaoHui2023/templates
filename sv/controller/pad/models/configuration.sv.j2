`ifndef {{ class_configuration | upper }}
`define {{ class_configuration | upper }}

class {{ class_configuration }} extends uvm_sequence_item;
    `uvm_object_utils_begin({{ class_configuration }})
        `uvm_field_string(group_name,UVM_ALL_ON)
        `uvm_field_object(regmodel,UVM_ALL_ON|UVM_NOPRINT|UVM_NOCOPY)
        `uvm_field_int(has_randomized,UVM_ALL_ON|UVM_NOPRINT)
    `uvm_object_utils_end

    string group_name; // 组名
    virtual {{ class_pin_interface }} pin_if; // 引脚接口
    {{ class_regmodel }} regmodel; // 寄存器模型
    rand bit has_randomized; // 是否随机过

    {{ class_pull_data }} pull_datas[$]; // 上下拉数据

    // 构建
    extern function void build();
    // 添加上下拉数据，更新到末尾
    extern protected function void build_pull_data();

    function new(string name="{{ class_configuration }}");
        super.new(name);
    endfunction

    constraint cst {
        has_randomized == 1;
        regmodel != null;
    }

    /*
        添加上下拉数据

        id : 序号
        reg_pull_up : 上拉动作寄存器
        reg_pull_down : 下拉动作寄存器
        is_fixed_pull_up : 是否固定上拉
        is_fixed_pull_down : 是否固定下拉
    */
    extern virtual function void add_pull_data(int id,{{ class_reg_struct }} reg_pull_up,{{ class_reg_struct }} reg_pull_down,bit is_fixed_pull_up=0,bit is_fixed_pull_down=0);

    constraint cst_user;
    constraint cst_case;
endclass

function void {{ class_configuration }}::build();
    build_pull_data();
endfunction

function void {{ class_configuration }}::add_pull_data(int id,{{ class_reg_struct }} reg_pull_up,{{ class_reg_struct }} reg_pull_down,bit is_fixed_pull_up,bit is_fixed_pull_down);
    {{ class_pull_data }} data;

    data = new(
        .id(id),
        .reg_pull_up(reg_pull_up),
        .reg_pull_down(reg_pull_down),
        .is_fixed_pull_up(is_fixed_pull_up),
        .is_fixed_pull_down(is_fixed_pull_down)
    );

    pull_datas.push_back(data);
endfunction

`endif
