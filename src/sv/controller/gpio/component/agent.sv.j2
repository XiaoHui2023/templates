`ifndef {{ class_agent | upper }}
`define {{ class_agent | upper }}

class {{ class_agent }} extends uvm_agent;
    `uvm_component_utils({{ class_agent }})

    {{ class_sequencer }} sqr;
    {{ class_configuration }} cfg;

    function new(string name,uvm_component parent);
        super.new(name,parent);

        cfg = {{ class_configuration }}::type_id::create({get_full_name(),".cfg"});
        sqr = {{ class_sequencer }}::type_id::create("sqr",this);
    endfunction

    extern function void build();
    extern function void connect();
endclass

function void {{ class_agent }}::build();
    super.build();

    uvm_config_db#(uvm_object_wrapper)::set(sqr,
        "main_phase",
        "default_sequence",
        {{ class_main_phase_seq }}::type_id::get());
endfunction

function void {{ class_agent }}::connect();
    super.connect();

    $cast(sqr.cfg,cfg);
endfunction

`endif
