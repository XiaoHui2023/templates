`ifndef {{ class_main_phase_seq | upper }}
`define {{ class_main_phase_seq | upper }}

class {{ class_main_phase_seq }} extends {{ class_base_seq }};
    `uvm_object_utils({{ class_main_phase_seq }})

    function new(string name = "{{ class_main_phase_seq }}");
        super.new(name);
    endfunction

    extern task pre_start();
    extern task body();
    extern task post_start();

    // 屏蔽无效引脚
    extern task mask_invalid_pin();
endclass

task {{ class_main_phase_seq }}::pre_start();
    super.pre_start();

    if(starting_phase)
        starting_phase.raise_objection(this);
    `uvm_info("","Enter",UVM_LOW)

    mask_invalid_pin();
endtask

task {{ class_main_phase_seq }}::body();
    `uvm_info("","require override",UVM_LOW)
endtask

task {{ class_main_phase_seq }}::post_start();
    super.post_start();

    `uvm_info("","Exit",UVM_LOW)

    if(starting_phase)
        starting_phase.drop_objection(this);
endtask

task {{ class_main_phase_seq }}::mask_invalid_pin();
    sdk.set_mask(~cfg.pin_mask);
endtask

`endif
