{%- set _rst = reset | default(false) %}
{%- if _rst %}
`ifndef {{ (class_prefix ~ "single_reg_fd_reset_seq") | upper }}
`define {{ (class_prefix ~ "single_reg_fd_reset_seq") | upper }}

class {{ class_prefix }}single_reg_fd_reset_seq extends uvm_sequence;
    `uvm_object_utils({{ class_prefix }}single_reg_fd_reset_seq)

    uvm_reg rg;

    function new(string name = "{{ class_prefix }}single_reg_fd_reset_seq");
        super.new(name);
    endfunction

    protected function bit field_is_skipped(uvm_reg_field fld);
        return uvm_resource_db#(bit)::get_by_name({"FIELD::", fld.get_full_name()},
            "NO_FIELD_TESTS", 0) != null;
    endfunction

    protected function uvm_reg_data_t reset_check_mask(uvm_reg rg);
        uvm_reg_field fields[$];
        uvm_reg_data_t mask;
        int lsb;
        int n_bits;

        mask = 0;
        rg.get_fields(fields);
        foreach (fields[i]) begin
            if (field_is_skipped(fields[i]))
                continue;
            lsb = fields[i].get_lsb_pos();
            n_bits = fields[i].get_n_bits();
            mask |= (uvm_reg_data_t'((1) << n_bits) - 1) << lsb;
        end
        return mask;
    endfunction

    virtual task body();
        uvm_reg_map maps[$];

        if (rg == null) begin
            `uvm_error("RAL_TEST/REG_FD", "No register specified to run sequence on")
            return;
        end

        if (uvm_resource_db#(bit)::get_by_name({"REG::", rg.get_full_name()},
                "NO_REG_TESTS", 0) != null ||
                uvm_resource_db#(bit)::get_by_name({"REG::", rg.get_full_name()},
                "NO_REG_HW_RESET_TEST", 0) != null) begin
            return;
        end

        rg.get_maps(maps);

        foreach (maps[j]) begin
            uvm_status_e status;
            uvm_reg_data_t rdata, exp, mask;

            mask = reset_check_mask(rg);
            if (mask == 0)
                continue;

            `uvm_info("RAL_TEST/REG_FD", {"Verifying reset value of register '",
                rg.get_full_name(), "' in map '", maps[j].get_full_name(),
                "' ..."}, UVM_LOW)

            exp = rg.get();
            rg.read(status, rdata, UVM_FRONTDOOR, maps[j], this);
            if (status != UVM_IS_OK) begin
                `uvm_error("RAL_TEST/REG_FD", {"Status was '", status.name(),
                    "' when reading reset value of register '",
                    rg.get_full_name(), "' through map '",
                    maps[j].get_full_name(), "'"})
            end
            else if ((rdata & mask) != (exp & mask)) begin
                `uvm_error("RAL_TEST/REG_FD", {"Reset value mismatch on register '",
                    rg.get_full_name(), "' in map '", maps[j].get_full_name(),
                    "': read 0x", $sformatf("%0h", rdata & mask), ", expected 0x",
                    $sformatf("%0h", exp & mask), "'"})
            end
        end
    endtask
endclass

`endif
{%- endif %}
