{
  "version": 1,
  "base_input": {"class_prefix": "general_observe_", "data_width_expr": "16"},
  "example_profile": "off",
  "files": ["interface.sv", "monitor.sv", "all.f"],
  "filelists": {"all.f": ["interface.sv", "monitor.sv"]},
  "features": {
    "address_increment": [
      ["monitor.sv", "\\bbit\\s*\\[63:0\\]\\s*m_stream_byte_addr\\s*;"],
      ["monitor.sv", "set_address\\(m_stream_byte_addr\\)"],
      ["monitor.sv", "m_stream_byte_addr\\s*\\+="]
    ],
    "report_payload": [
      ["monitor.sv", "`uvm_info\\("],
      ["monitor.sv", "out\\.sprint\\("]
    ]
  },
  "profiles": {
    "off": {"settings": {"address_increment": false, "report_payload": false}},
    "address": {"settings": {"address_increment": true, "report_payload": false}},
    "log": {"settings": {"address_increment": false, "report_payload": true}, "input": {}},
    "all": {"settings": {"address_increment": true, "report_payload": true}}
  }
}
