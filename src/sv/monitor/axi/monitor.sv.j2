`ifndef {{ (class_prefix ~ 'monitor') | upper }}
`define {{ (class_prefix ~ 'monitor') | upper }}

class {{ class_prefix }}monitor extends uvm_monitor;
    `uvm_component_utils({{ class_prefix }}monitor)

    uvm_analysis_port #(uvm_tlm_generic_payload) o_ap;
    svt_axi_system_env vip;
    {{ class_prefix }}converter converter;
    protected svt_axi_system_configuration cfg;
    protected virtual svt_axi_if vif;

    // 创建被动 VIP 和事务转换器。
    function new(string name = "{{ class_prefix }}monitor", uvm_component parent = null);
        super.new(name, parent);
        o_ap = new("o_ap", this);
        vip = svt_axi_system_env::type_id::create("vip", this);
        converter = {{ class_prefix }}converter::type_id::create("converter", this);
    endfunction

    // 绑定总线接口并配置被动采样。
    extern virtual function void build_phase(uvm_phase phase);
    // 连接完整事务采样端口和通用载荷输出端口。
    extern virtual function void connect_phase(uvm_phase phase);
endclass

function void {{ class_prefix }}monitor::build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db#(virtual svt_axi_if)::get(this, "", "vif", vif) || vif == null) begin
        `uvm_fatal("AXI_GP_VIF", "set virtual svt_axi_if vif before build")
        return;
    end
    cfg = svt_axi_system_configuration::type_id::create("cfg");
    cfg.num_masters = 1;
    cfg.num_slaves = 0;
    cfg.create_sub_cfgs(1, 0);
    cfg.system_monitor_enable = 0;
    cfg.master_cfg[0].is_active = 0;
    cfg.master_cfg[0].axi_interface_type = svt_axi_port_configuration::{{ protocol }};
    cfg.master_cfg[0].addr_width = {{ addr_width }};
    cfg.master_cfg[0].data_width = {{ data_width }};
    cfg.master_cfg[0].id_width = {{ id_width }};
    cfg.master_cfg[0].wysiwyg_enable = 1;
    uvm_config_db#(svt_axi_system_configuration)::set(this, "vip", "cfg", cfg);
    uvm_config_db#(virtual svt_axi_if)::set(this, "vip", "vif", vif);
endfunction

function void {{ class_prefix }}monitor::connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    vip.master[0].monitor.item_observed_port.connect(converter.analysis_export);
    converter.o_ap.connect(o_ap);
endfunction

`endif
