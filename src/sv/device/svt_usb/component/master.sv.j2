`ifndef {{ class_prefix | upper }}MASTER
`define {{ class_prefix | upper }}MASTER

class {{ class_prefix }}master extends uvm_component;
    `uvm_component_utils({{ class_prefix }}master)

    {{ class_prefix }}sdk sqr;

    function new(string name="{{ class_prefix }}master", uvm_component parent=null);
        super.new(name, parent);

        sqr = {{ class_prefix }}sdk::type_id::create("sqr", this);
    endfunction

    extern function void build();
endclass

function void {{ class_prefix }}master::build();
    super.build();

    if(!uvm_config_db#(virtual {{ class_prefix }}interface)::get(this, "", "if", sqr.vif))
        `uvm_fatal("", "require vif")
    if(!uvm_config_db#({{ class_prefix }}svt_configuration)::get(this, "", "svt_cfg", sqr.svt_cfg))
        `uvm_fatal("", "require svt_cfg")
    if(!uvm_config_db#({{ class_prefix }}system_configuration)::get(this, "", "sys_cfg", sqr.sys_cfg))
        `uvm_fatal("", "require sys_cfg")
    if(!uvm_config_db#({{ class_prefix }}base_callback)::get(this, "", "callback", sqr.callback))
        `uvm_fatal("", "require callback")
    if(!uvm_config_db#(svt_usb_agent)::get(this, "", "svt_agt", sqr.svt_agt))
        `uvm_fatal("", "require svt_agt")

    uvm_config_db#(uvm_object_wrapper)::set(sqr,
        "run_phase",
        "default_sequence",
        {{ class_prefix }}run_phase_seq::type_id::get());

    uvm_config_db#(uvm_object_wrapper)::set(sqr,
        "reset_phase",
        "default_sequence",
        {{ class_prefix }}reset_phase_seq::type_id::get());

    uvm_config_db#(uvm_object_wrapper)::set(sqr,
        "main_phase",
        "default_sequence",
        {{ class_prefix }}main_phase_seq::type_id::get());
endfunction

`endif
