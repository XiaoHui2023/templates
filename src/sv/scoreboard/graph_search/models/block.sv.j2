function bit {{ class_block }}::get_leading_identical(int n);
    bit pre[$];

    for(int j=0;j<n;j++) begin
        bit cur[$];

        foreach(column_list[k])
            cur[k] = column_list[k].get_transfer(j) != null;

        if(pre.size && pre != cur)
            return 0;

        pre = cur;
    end

    return 1;
