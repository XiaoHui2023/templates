    tb.push_back(split);
    tb.push_back(this.head);
    tb.push_back(split);

    // ???
    foreach(body[j]) begin
        lf(body[j],tb);

        // ???
        tb.push_back(split);
    end

    // ???
    foreach(tb[row,column])
        if(tb[row] != split)
            tb[row][column] = {str_padding,tb[row][column],str_padding};

    // ????
    foreach(tb[row,column])
        width[column] = $max(width[column],length(tb[row][column]));

