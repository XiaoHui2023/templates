function int {{ class_sheet }}::count(string s,string tar);
    int sum;
    int n;
    int lo;

    // alias
    lo = 0;
    n = 0;

    // ??
    sum = s.len-tar.len+1;

    while(lo < sum) begin
        string t;

        // ??
        t = s.substr(lo,lo+tar.len-1);

        if(t == tar) begin
            n++;
            lo += tar.len-1;
        end

        // ++
        lo++;
    end

    return n;
endfunction

function int {{ class_sheet }}::length(string s);
    int n;

    // alias
    n = 0;

    for(int j=0;j<s.len;j++) begin
        int asc;

        asc = s.getc(j);

        if(asc >= 0)
            n += 1;
        else begin
            j += 2;
            if(asc < -28)
                n += 1;
            else
                n += 2;
        end
    end

    return n;
endfunction

function string {{ class_sheet }}::layout(string s,int len,string sign,int align);
    int n;

    // alias
    n = 0;

    for(int j=0;j<s.len;j++) begin
        int asc;

        asc = s.getc(j);

        if(asc >= 0)
            n += 1;
        else begin
            j += 2;
            if(asc < -28)
                n += 1;
            else
                n += 2;
        end
    end

    while(n < len) begin
        if(align < 0) begin
            s = {s,sign};
            n++;
        end
        else if(align > 0) begin
            s = {sign,s};
            n++;
        end
        else begin
            s = {s,sign};
            n++;
            if(n < len) begin
                s = {sign,s};
                n++;
            end
        end
    end

    return s;
endfunction

function void {{ class_sheet }}::transpose(input string i[$][$],output string o[$][$]);
    foreach(i[j,k])
        o[k][j] = i[j][k];
endfunction

function void {{ class_sheet }}::lf(input string i[$],ref string o[$][$]);
    string sp[$][$]; // [?][?]
    string tr[$][$]; // [?][?]
    int max_size;

    foreach(i[j])
        uvm_split_string(i[j],"\n",sp[j]);

    foreach(sp[j])
        max_size = $max(max_size,sp[j].size);

    foreach(sp[j])
        while(sp[j].size < max_size)
            sp[j].push_back("");

    transpose(sp,tr);
    o = {o,tr};
endfunction

