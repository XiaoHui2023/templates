{%- endif %}
{%- if expected_units < 0 and require_match %}
    localparam bit [5:0] NO_MATCH = 6'b000100;
{%- endif %}
{%- if check_count %}
    localparam bit [5:0] COUNT = 6'b001000;
{%- endif %}
{%- if check_missing %}
    localparam bit [5:0] MISSING = 6'b010000;
{%- endif %}
{%- if check_unexpected %}
