`ifndef {{ (class_prefix ~ "scoreboard") | upper }}
`define {{ (class_prefix ~ "scoreboard") | upper }}

`uvm_analysis_imp_decl(_{{ class_prefix }}golden)
`uvm_analysis_imp_decl(_{{ class_prefix }}monitor)

class {{ class_prefix }}scoreboard extends uvm_scoreboard;
    `uvm_component_utils({{ class_prefix }}scoreboard)

    uvm_analysis_port #(uvm_tlm_generic_payload) i_golden_ap;
    uvm_analysis_port #(uvm_tlm_generic_payload) i_monitor_ap;
    protected uvm_analysis_imp_{{ class_prefix }}golden #(uvm_tlm_generic_payload, {{ class_prefix }}scoreboard) golden_imp;
    protected uvm_analysis_imp_{{ class_prefix }}monitor #(uvm_tlm_generic_payload, {{ class_prefix }}scoreboard) monitor_imp;
    protected {{ class_prefix }}config cfg;
    protected {{ class_prefix }}adapter adapter;
    protected {{ class_prefix }}pending golden_pending;
    protected {{ class_prefix }}pending monitor_pending;
    protected bit golden_keys[string];
    protected bit started;
    protected bit checked;
    protected bit pending_checked;
    protected bit failed;
    protected bit golden_closed;
    protected bit monitor_closed;
    protected bit expected_set;
    protected longint round_id;
    protected longint expected_units;
    protected longint golden_packets;
    protected longint monitor_packets;
    protected longint golden_units;
    protected longint monitor_units;
    protected longint golden_valid_bytes;
    protected longint monitor_valid_bytes;
    protected longint input_errors;
    protected longint protocol_errors;
    protected longint timeout_count;
    protected longint check_errors;
    typedef enum {COMPLETE, FAILED, TIMED_OUT, RESET} completion_e;
    protected longint covered_units;
    longint matched_count;
    longint mismatched_count;
    longint dropped_count;

    // Construct input ports and private comparison state.
    function new(string name = "{{ class_prefix }}scoreboard", uvm_component parent = null);
        super.new(name, parent);
        i_golden_ap = new("i_golden_ap", this);
        i_monitor_ap = new("i_monitor_ap", this);
        golden_imp = new("golden_imp", this);
        monitor_imp = new("monitor_imp", this);
        cfg = new;
        adapter = new(cfg);
        golden_pending = new;
        monitor_pending = new;
        round_id = 0;
        clear();
    endfunction

    // Read the optional config_db object named config.
    extern function void build_phase(uvm_phase phase);
    // Connect both public inputs to their private receivers.
    extern function void connect_phase(uvm_phase phase);
    // Check all outstanding expectations after stimulus has ended.
    extern function void check_phase(uvm_phase phase);
    // Discard comparisons and counters at reset entry.
    extern task reset_phase(uvm_phase phase);
    // Copy options before the first input after construction or clear.
    extern function void configure({{ class_prefix }}config options);
    // Release pending data and reopen configuration.
    extern function void clear();
    // Replace the number of golden comparison units requiring first coverage.
    extern function void set_expected_units(longint count);
    // Extend the number of golden comparison units requiring first coverage.
    extern function void add_expected_units(longint count);
    // Declare that all golden input for this round has been submitted.
    extern function void end_golden();
    // Declare that the monitor will submit no further input for this round.
    extern function void end_monitor();
    // Close both inputs after their producers have stopped.
    extern function void end_round();
    // Return true only for a closed round that satisfies every completion policy.
    extern function bit is_complete();
    // Check boundary, nonempty policies, quantity, failures and pending units.
    extern function bit check_round();
    // Wait for this round to close, fail, time out, or be cleared.
    // timeout_ns — Numeric nanoseconds for the whole call; zero disables the timer.
    extern task wait_complete(output completion_e result, input real timeout_ns = 0.0);
    // Return an independent snapshot with packet, valid-byte and unit counts.
    extern function void get_statistics(output {{ class_prefix }}statistics result);
    // Record a round API violation without accepting new input.
    extern protected function void protocol_error(string message);
    // Count extra monitor units that are relevant under the selected policy.
    extern protected function int unexpected_monitor_count();
    // Receive a standard golden GP and preserve its independent contents.
    extern function void write_{{ class_prefix }}golden(uvm_tlm_generic_payload payload);
    // Receive a standard monitor GP and apply the configured filtering policy.
    extern function void write_{{ class_prefix }}monitor(uvm_tlm_generic_payload payload);
    // Select a monitor sample and a consumable or reusable golden candidate.
    extern protected function bit match(input string key, output int golden_index, output int monitor_index);
    // Compare every selected sample and update first coverage independently.
    extern protected function void drain(string key);
    // Process validated comparison units without retaining caller handles.
    extern protected function void accept(uvm_tlm_generic_payload payload, bit golden);
    // Report uncovered retained expectations and relevant extra monitor units once.
    extern function void check_pending();
    // Return pending unit counts without producing a report.
    extern function void pending_counts(output int golden, output int monitor);
    // Emit the standard GP printer output as a single UVM_INFO message.
    // id — UVM report ID used for verbosity and action configuration.
    extern function void print_payload(uvm_tlm_generic_payload payload,
        string id = "GP", int verbosity = UVM_HIGH);
endclass

function void {{ class_prefix }}scoreboard::build_phase(uvm_phase phase);
    {{ class_prefix }}config options;

    super.build_phase(phase);
    if(uvm_config_db #({{ class_prefix }}config)::get(this, "", "config", options))
        configure(options);
endfunction

function void {{ class_prefix }}scoreboard::connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    i_golden_ap.connect(golden_imp);
    i_monitor_ap.connect(monitor_imp);
endfunction

function void {{ class_prefix }}scoreboard::check_phase(uvm_phase phase);
    super.check_phase(phase);
    void'(check_round());
endfunction

task {{ class_prefix }}scoreboard::reset_phase(uvm_phase phase);
    super.reset_phase(phase);
    clear();
endtask

function void {{ class_prefix }}scoreboard::configure({{ class_prefix }}config options);
    if(started) begin
        `uvm_fatal("GP_CONFIG", "configuration changed during an active comparison")
        return;
    end
    if(options == null) begin
        `uvm_fatal("GP_CONFIG", "null configuration")
        return;
    end
    if(!options.valid()) begin
        `uvm_fatal("GP_CONFIG", "invalid comparison options")
        return;
    end
    cfg.copy(options);
endfunction

function void {{ class_prefix }}scoreboard::clear();
    golden_pending.clear();
    monitor_pending.clear();
    golden_keys.delete();
    round_id++;
    started = 0;
    checked = 0;
    pending_checked = 0;
    failed = 0;
    golden_closed = 0;
    monitor_closed = 0;
    expected_set = 0;
    expected_units = 0;
    golden_packets = 0;
    monitor_packets = 0;
    golden_units = 0;
    monitor_units = 0;
    golden_valid_bytes = 0;
    monitor_valid_bytes = 0;
    input_errors = 0;
    protocol_errors = 0;
    timeout_count = 0;
    check_errors = 0;
    covered_units = 0;
    matched_count = 0;
    mismatched_count = 0;
    dropped_count = 0;
endfunction

function void {{ class_prefix }}scoreboard::write_{{ class_prefix }}golden(uvm_tlm_generic_payload payload);
    accept(payload, 1);
endfunction

function void {{ class_prefix }}scoreboard::write_{{ class_prefix }}monitor(uvm_tlm_generic_payload payload);
    accept(payload, 0);
endfunction

function bit {{ class_prefix }}scoreboard::match(input string key, output int golden_index, output int monitor_index);
    golden_index = -1;
    monitor_index = -1;
    for(int m = 0; m < monitor_pending.key_size(key); m++) begin
        {{ class_prefix }}entry mon;
        int first_uncovered;

        if(cfg.mode != {{ class_prefix }}config::SET && m > 0)
            break;
        mon = monitor_pending.at(key, m);
        first_uncovered = -1;
        for(int g = 0; g < golden_pending.key_size(key); g++) begin
            {{ class_prefix }}entry gld;

            gld = golden_pending.at(key, g);
            if(!gld.covered) begin
                first_uncovered = g;
                break;
            end
        end
        if(cfg.reuse_read_expectations && mon.payload.is_read()) begin
            int covered_match;
            int fallback;

            if(!golden_closed)
                continue;
            covered_match = -1;
            fallback = -1;
            for(int g = 0; g < golden_pending.key_size(key); g++) begin
                {{ class_prefix }}entry gld;

                gld = golden_pending.at(key, g);
                if(!gld.payload.is_read())
                    continue;
                if(cfg.mode == {{ class_prefix }}config::ORDERED && !gld.covered && g != first_uncovered)
                    continue;
                if(fallback < 0 || (golden_pending.at(key, fallback).covered && !gld.covered))
                    fallback = g;
                if(adapter.equal(gld.payload, mon.payload)) begin
                    if(!gld.covered) begin
                        golden_index = g;
                        monitor_index = m;
                        return 1;
                    end
                    if(covered_match < 0)
                        covered_match = g;
                end
            end
            if(covered_match >= 0)
                golden_index = covered_match;
            else if(fallback >= 0)
                golden_index = fallback;
            else if(cfg.mode == {{ class_prefix }}config::ORDERED)
                golden_index = first_uncovered;
            if(golden_index >= 0) begin
                monitor_index = m;
                return 1;
            end
        end
        else begin
            for(int g = 0; g < golden_pending.key_size(key); g++) begin
                {{ class_prefix }}entry gld;

                gld = golden_pending.at(key, g);
                if(gld.covered)
                    continue;
                if(cfg.mode == {{ class_prefix }}config::SET && !adapter.equal(gld.payload, mon.payload))
                    continue;
                golden_index = g;
                monitor_index = m;
                return 1;
            end
        end
    end
    return 0;
endfunction

function void {{ class_prefix }}scoreboard::drain(string key);
    int g;
    int m;

    while(match(key, g, m)) begin
        {{ class_prefix }}entry gld;
        {{ class_prefix }}entry mon;

        gld = golden_pending.at(key, g);
        mon = monitor_pending.at(key, m);
        if(adapter.equal(gld.payload, mon.payload)) begin
            matched_count++;
            if(golden_pending.mark_covered(key, g))
                covered_units++;
        end
        else begin
            failed = 1;
            mismatched_count++;
            `uvm_error("GP_MISMATCH", "payload comparison failed")
            print_payload(gld.payload, "GP_GOLDEN", UVM_LOW);
            print_payload(mon.payload, "GP_MONITOR", UVM_LOW);
        end
        if(!cfg.reuse_read_expectations || (gld.payload.is_write() && mon.payload.is_write()))
            golden_pending.remove(key, g);
        monitor_pending.remove(key, m);
    end
endfunction

function void {{ class_prefix }}scoreboard::accept(uvm_tlm_generic_payload payload, bit golden);
    uvm_tlm_generic_payload units[$];
    string reason;
    byte unsigned enables[];
    int enable_length;
    longint valid_bytes;

    if((golden && golden_closed) || (!golden && monitor_closed)) begin
        protocol_error(golden ? "golden input after end_golden" : "monitor input after end_monitor");
        return;
    end
    valid_bytes = 0;
    started = 1;
    checked = 0;
    pending_checked = 0;
    if(!adapter.convert(payload, units, reason)) begin
        failed = 1;
        input_errors++;
        `uvm_error("GP_INPUT", reason)
        return;
    end
    if(payload.get_command() != UVM_TLM_IGNORE_COMMAND) begin
        payload.get_byte_enable(enables);
        enable_length = int'(payload.get_byte_enable_length());
        for(int j = 0; j < int'(payload.get_data_length()); j++) begin
            if(enable_length == 0 || enables[j % enable_length] != 0)
                valid_bytes++;
        end
    end
    if(golden) begin
        golden_packets++;
        golden_units += units.size();
        golden_valid_bytes += valid_bytes;
    end
    else begin
        monitor_packets++;
        monitor_units += units.size();
        monitor_valid_bytes += valid_bytes;
    end
    foreach(units[j]) begin
        string key;

        key = adapter.key(units[j]);
        if(golden && !golden_keys.exists(key)) begin
            if(golden_keys.num() >= cfg.max_keys) begin
                failed = 1;
                protocol_errors++;
                `uvm_fatal("GP_CAPACITY", "golden key limit exceeded")
                return;
            end
            golden_keys[key] = 1;
        end
        if(!golden && !golden_keys.exists(key) && cfg.monitor_policy == {{ class_prefix }}config::DROP) begin
            dropped_count++;
            continue;
        end
        if(golden)
            golden_pending.push(key, units[j]);
        else
            monitor_pending.push(key, units[j]);
        drain(key);
        if(golden_pending.retained_size() > cfg.max_pending) begin
            golden_pending.remove(key, golden_pending.key_size(key) - 1);
            failed = 1;
            protocol_errors++;
            `uvm_fatal("GP_CAPACITY", "golden retained limit exceeded")
            return;
        end
        if(monitor_pending.retained_size() > cfg.max_pending) begin
            monitor_pending.remove(key, monitor_pending.key_size(key) - 1);
            failed = 1;
            protocol_errors++;
            `uvm_fatal("GP_CAPACITY", "monitor pending limit exceeded")
            return;
        end
    end
endfunction

function void {{ class_prefix }}scoreboard::check_pending();
    if(pending_checked)
        return;
    pending_checked = 1;
    if(golden_pending.size() != 0) begin
        failed = 1;
        check_errors++;
        `uvm_error("GP_MISSING", "golden payloads remain unmatched")
    end
    if(unexpected_monitor_count() != 0) begin
        failed = 1;
        check_errors++;
        `uvm_error("GP_UNEXPECTED", "relevant monitor payloads remain unmatched")
    end
endfunction

function void {{ class_prefix }}scoreboard::pending_counts(output int golden, output int monitor);
    golden = golden_pending.size();
    monitor = monitor_pending.size();
endfunction

function void {{ class_prefix }}scoreboard::print_payload(uvm_tlm_generic_payload payload,
    string id = "GP", int verbosity = UVM_HIGH);
    if(payload != null)
        `uvm_info(id, payload.sprint(uvm_default_line_printer), verbosity)
endfunction

function void {{ class_prefix }}scoreboard::protocol_error(string message);
    failed = 1;
    protocol_errors++;
    checked = 0;
    `uvm_error("GP_ROUND", message)
endfunction

function void {{ class_prefix }}scoreboard::set_expected_units(longint count);
    if(golden_closed || count < 0) begin
        protocol_error("expected units must be nonnegative and set before end_golden");
        return;
    end
    expected_units = count;
    expected_set = 1;
    checked = 0;
endfunction

function void {{ class_prefix }}scoreboard::add_expected_units(longint count);
    if(golden_closed || count < 0 || count > 64'sh7fffffffffffffff - expected_units) begin
        protocol_error("expected unit increment is negative, overflows, or follows end_golden");
        return;
    end
    expected_units += count;
    expected_set = 1;
    checked = 0;
endfunction

function void {{ class_prefix }}scoreboard::end_golden();
    if(golden_closed)
        return;
    started = 1;
    golden_closed = 1;
    if(!expected_set) begin
        expected_units = golden_units;
        expected_set = 1;
    end
    foreach(golden_keys[key])
        drain(key);
    checked = 0;
    pending_checked = 0;
endfunction

function void {{ class_prefix }}scoreboard::end_monitor();
    if(monitor_closed)
        return;
    started = 1;
    monitor_closed = 1;
    checked = 0;
endfunction

function void {{ class_prefix }}scoreboard::end_round();
    end_golden();
    end_monitor();
endfunction

function int {{ class_prefix }}scoreboard::unexpected_monitor_count();
    int count;

    count = 0;
    if(cfg.monitor_policy == {{ class_prefix }}config::STRICT)
        return monitor_pending.size();
    foreach(golden_keys[key])
        count += monitor_pending.key_size(key);
    return count;
endfunction

function bit {{ class_prefix }}scoreboard::is_complete();
    return golden_closed && monitor_closed && !failed
        && (!cfg.require_golden || golden_packets > 0)
        && (!cfg.require_match || matched_count > 0)
        && (!expected_set || (golden_units == expected_units
            && covered_units == expected_units))
        && golden_pending.size() == 0 && unexpected_monitor_count() == 0;
endfunction

function bit {{ class_prefix }}scoreboard::check_round();
    if(checked)
        return is_complete();
    check_pending();
    if(!golden_closed || !monitor_closed) begin
        failed = 1;
        check_errors++;
        `uvm_error("GP_ROUND_OPEN", "both inputs must explicitly close the round")
    end
    if(cfg.require_golden && golden_packets == 0) begin
        failed = 1;
        check_errors++;
        `uvm_error("GP_EMPTY_GOLDEN", "no valid golden packet was received")
    end
    if(cfg.require_match && matched_count == 0) begin
        failed = 1;
        check_errors++;
        `uvm_error("GP_NO_MATCH", "no comparison unit matched successfully")
    end
    if(expected_set && (golden_units != expected_units
        || covered_units != expected_units)) begin
        failed = 1;
        check_errors++;
        `uvm_error("GP_COUNT", "submitted or covered unit count differs from expected units")
    end
    checked = 1;
    return is_complete();
endfunction

task {{ class_prefix }}scoreboard::wait_complete(output completion_e result, input real timeout_ns = 0.0);
    longint waiting_round;
    time timeout_ticks;
    time now_tick;

    waiting_round = round_id;
    if(!(timeout_ns >= 0.0) || !(timeout_ns * 1.0e6 < 18446744073709551616.0)) begin
        protocol_error("timeout_ns must be finite, nonnegative and representable in femtoseconds");
        result = FAILED;
        return;
    end
    if(timeout_ns > 0.0) begin
        timeout_ticks = {{ class_prefix }}time_domain::ticks_from_ns(timeout_ns);
        now_tick = {{ class_prefix }}time_domain::now_ticks();
        if(timeout_ticks > ~now_tick) begin
            protocol_error("timeout deadline exceeds the time domain range");
            result = FAILED;
            return;
        end
    end
    if(!failed && !(golden_closed && monitor_closed)) begin
        if(timeout_ns == 0.0)
            wait(failed || (golden_closed && monitor_closed) || round_id != waiting_round);
        else begin
            fork
                begin
                    fork
                        begin
                            wait(failed || (golden_closed && monitor_closed) || round_id != waiting_round);
                        end
                        begin
                            {{ class_prefix }}time_domain::delay_ns(timeout_ns);
                        end
                    join_any
                    disable fork;
                end
            join
        end
    end
    if(round_id != waiting_round)
        result = RESET;
    else if(golden_closed && monitor_closed)
        result = check_round() ? COMPLETE : FAILED;
    else if(failed)
        result = FAILED;
    else begin
        failed = 1;
        timeout_count++;
        checked = 0;
        result = TIMED_OUT;
        `uvm_error("GP_TIMEOUT", "round did not close within timeout_ns")
    end
endtask

function void {{ class_prefix }}scoreboard::get_statistics(output {{ class_prefix }}statistics result);
    result = new;
    result.round_id = round_id;
    result.golden_packets = golden_packets;
    result.monitor_packets = monitor_packets;
    result.golden_units = golden_units;
    result.monitor_units = monitor_units;
    result.golden_valid_bytes = golden_valid_bytes;
    result.monitor_valid_bytes = monitor_valid_bytes;
    result.compared_units = matched_count + mismatched_count;
    result.covered_units = covered_units;
    result.retained_golden = golden_pending.retained_size();
    result.matched_count = matched_count;
    result.mismatched_count = mismatched_count;
    result.dropped_count = dropped_count;
    result.input_errors = input_errors;
    result.protocol_errors = protocol_errors;
    result.timeout_count = timeout_count;
    result.check_errors = check_errors;
    result.expected_units = expected_units;
    result.expected_set = expected_set;
    result.golden_closed = golden_closed;
    result.monitor_closed = monitor_closed;
    result.failed = failed;
    result.complete = is_complete();
    result.pending_golden = golden_pending.size();
    result.pending_monitor = monitor_pending.size();
    result.unexpected_monitor = unexpected_monitor_count();
endfunction

`endif
