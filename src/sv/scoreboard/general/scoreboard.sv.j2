`ifndef {{ class_prefix }}scoreboard_SV
`define {{ class_prefix }}scoreboard_SV

class {{ class_prefix }}scoreboard extends uvm_scoreboard;
    `uvm_component_utils({{ class_prefix }}scoreboard)
    `uvm_register_cb({{ class_prefix }}scoreboard, {{ class_prefix }}scoreboard_callback)
    `uvm_analysis_imp_decl(_{{ class_prefix }}scoreboard_golden)
    `uvm_analysis_imp_decl(_{{ class_prefix }}scoreboard_monitor)

    uvm_analysis_port #(uvm_tlm_generic_payload) i_golden_ap;
    uvm_analysis_port #(uvm_tlm_generic_payload) i_monitor_ap;
    local uvm_analysis_imp_{{ class_prefix }}scoreboard_golden #(uvm_tlm_generic_payload, {{ class_prefix }}scoreboard) golden_imp;
    local uvm_analysis_imp_{{ class_prefix }}scoreboard_monitor #(uvm_tlm_generic_payload, {{ class_prefix }}scoreboard) monitor_imp;
    local {{ class_prefix }}scoreboard_config cfg;
    local {{ class_prefix }}scoreboard_adapter adapter;
    local {{ class_prefix }}scoreboard_pending golden_pending;
    local {{ class_prefix }}scoreboard_pending monitor_pending;
    local bit golden_keys[string];
    typedef enum {ACCEPTING, SEALED, CHECKED} lifecycle_e;
    typedef enum {RESET_EVENT, COMPARE_EVENT, CHECK_EVENT} notification_e;
    local lifecycle_e lifecycle;
    local bit notifying;
    local bit failed;
    localparam bit [5:0] ROUND_OPEN = 6'b000001;
    localparam bit [5:0] EMPTY_GOLDEN = 6'b000010;
    localparam bit [5:0] NO_MATCH = 6'b000100;
    localparam bit [5:0] COUNT = 6'b001000;
    localparam bit [5:0] MISSING = 6'b010000;
    localparam bit [5:0] UNEXPECTED = 6'b100000;
    local longint round_id;
    local longint skipped_packets;
    local longint golden_packets;
    local longint monitor_packets;
    local longint golden_units;
    local longint monitor_units;
    local longint golden_valid_bytes;
    local longint monitor_valid_bytes;
    local longint input_errors;
    local longint protocol_errors;
    local longint check_errors;
    local longint covered_units;
    local longint matched_count;
    local longint mismatched_count;
    local longint dropped_count;

    // Construct input ports and independent comparison state.
    function new(string name = "{{ class_prefix }}scoreboard", uvm_component parent = null);
        super.new(name, parent);
        i_golden_ap = new("i_golden_ap", this);
        i_monitor_ap = new("i_monitor_ap", this);
        golden_imp = new("golden_imp", this);
        monitor_imp = new("monitor_imp", this);
        cfg = new;
        adapter = new(cfg);
        golden_pending = new;
        monitor_pending = new;
        round_id = 0;
        reset_state();
    endfunction

    // Resolve and validate build-time check settings.
    extern virtual function void build_phase(uvm_phase phase);
    // Bind both public inputs to their owner-scoped receivers.
    extern virtual function void connect_phase(uvm_phase phase);
    // Discard this round at the standard reset boundary.
    extern virtual task reset_phase(uvm_phase phase);
    // Seal sampling and finish comparisons after all runtime phases end.
    extern virtual function void extract_phase(uvm_phase phase);
    // Finalize the round and notify observers exactly once.
    extern virtual function void check_phase(uvm_phase phase);
    // Return success only after automatic checking has finished.
    extern function bit is_complete();
    // Return an independent statistics snapshot without reporting.
    extern function void get_statistics(output {{ class_prefix }}scoreboard_statistics result);
    // Receive an owned copy of a standard golden GP.
    extern function void write_{{ class_prefix }}scoreboard_golden(uvm_tlm_generic_payload payload);
    // Receive a standard monitor GP through the configured filter.
    extern function void write_{{ class_prefix }}scoreboard_monitor(uvm_tlm_generic_payload payload);
    // Emit standard GP printer output as one UVM_INFO.
    // id — UVM report ID used for verbosity and action configuration.
    extern function void print_payload(uvm_tlm_generic_payload payload,
        string id = "GP", int verbosity = UVM_HIGH);
    // Clear all transient state while retaining the build-time configuration.
    extern local function void reset_state();
    // Select one monitor sample and a golden candidate with its comparison result.
    extern local function bit match(input string key, output int golden_index, output int monitor_index, output bit equal);
    // Consume every selected sample and record first coverage independently.
    extern local function void drain(string key);
    // Accept validated units only while runtime sampling is open.
    extern local function void accept(uvm_tlm_generic_payload payload, bit golden);
    // Count residual monitor units relevant under the configured filter.
    extern local function int unexpected_monitor_count();
    // Return the number of independent golden obligations under this policy.
    extern local function longint required_units();
    // Compute every completion issue from authoritative state.
    extern local function bit [5:0] completion_issues();
    // Record and report each issue in a single automatic check.
    extern local function void report_checks(bit [5:0] issues);
    // Notify enabled callbacks with fresh detached values for each observer.
    extern local function void notify(notification_e kind,
        uvm_tlm_generic_payload golden = null, uvm_tlm_generic_payload monitor = null,
        bit matched = 0, bit first_coverage = 0);
endclass

function void {{ class_prefix }}scoreboard::build_phase(uvm_phase phase);
    {{ class_prefix }}scoreboard_config options;

    super.build_phase(phase);
    if(uvm_config_db #({{ class_prefix }}scoreboard_config)::get(this, "", "config", options)) begin
        if(options == null) begin
            `uvm_fatal("GP_CONFIG", "null configuration")
            return;
        end
        cfg.copy(options);
    end
    void'(uvm_config_db #(bit)::get(this, "", "checks_enabled", cfg.checks_enabled));
    void'(uvm_config_db #(bit)::get(this, "", "require_golden", cfg.require_golden));
    void'(uvm_config_db #(bit)::get(this, "", "require_match", cfg.require_match));
    void'(uvm_config_db #(bit)::get(this, "", "check_count", cfg.check_count));
    void'(uvm_config_db #(bit)::get(this, "", "check_missing", cfg.check_missing));
    void'(uvm_config_db #(bit)::get(this, "", "check_unexpected", cfg.check_unexpected));
    void'(uvm_config_db #(bit)::get(this, "", "compare_address", cfg.compare_address));
    void'(uvm_config_db #(bit)::get(this, "", "compare_command", cfg.compare_command));
    void'(uvm_config_db #(bit)::get(this, "", "compare_data", cfg.compare_data));
    void'(uvm_config_db #(bit)::get(this, "", "compare_response", cfg.compare_response));
    if(!cfg.valid())
        `uvm_fatal("GP_CONFIG", "invalid comparison options")
endfunction

function void {{ class_prefix }}scoreboard::connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    i_golden_ap.connect(golden_imp);
    i_monitor_ap.connect(monitor_imp);
endfunction

task {{ class_prefix }}scoreboard::reset_phase(uvm_phase phase);
    super.reset_phase(phase);
    reset_state();
    notify(RESET_EVENT);
endtask

function void {{ class_prefix }}scoreboard::extract_phase(uvm_phase phase);
    super.extract_phase(phase);
    if(lifecycle != ACCEPTING)
        return;
    lifecycle = SEALED;
    foreach(golden_keys[key])
        drain(key);
endfunction

function void {{ class_prefix }}scoreboard::check_phase(uvm_phase phase);
    super.check_phase(phase);
    if(lifecycle == CHECKED)
        return;
    if(cfg.checks_enabled)
        report_checks(completion_issues());
    lifecycle = CHECKED;
    notify(CHECK_EVENT);
endfunction

function void {{ class_prefix }}scoreboard::reset_state();
    golden_pending.clear();
    monitor_pending.clear();
    golden_keys.delete();
    round_id++;
    lifecycle = ACCEPTING;
    notifying = 0;
    failed = 0;
    skipped_packets = 0;
    golden_packets = 0;
    monitor_packets = 0;
    golden_units = 0;
    monitor_units = 0;
    golden_valid_bytes = 0;
    monitor_valid_bytes = 0;
    input_errors = 0;
    protocol_errors = 0;
    check_errors = 0;
    covered_units = 0;
    matched_count = 0;
    mismatched_count = 0;
    dropped_count = 0;
endfunction

function void {{ class_prefix }}scoreboard::write_{{ class_prefix }}scoreboard_golden(uvm_tlm_generic_payload payload);
    accept(payload, 1);
endfunction

function void {{ class_prefix }}scoreboard::write_{{ class_prefix }}scoreboard_monitor(uvm_tlm_generic_payload payload);
    accept(payload, 0);
endfunction

function bit {{ class_prefix }}scoreboard::match(input string key, output int golden_index, output int monitor_index, output bit equal);
    golden_index = -1;
    monitor_index = -1;
    equal = 0;
    if(cfg.mode == {{ class_prefix }}scoreboard_config::STATE && lifecycle == ACCEPTING)
        return 0;
    for(int m = 0; m < monitor_pending.key_size(key); m++) begin
        {{ class_prefix }}scoreboard_entry mon;
        int first_uncovered;

        if(cfg.mode != {{ class_prefix }}scoreboard_config::SET && m > 0)
            break;
        mon = monitor_pending.at(key, m);
        first_uncovered = -1;
        if(cfg.reuse_read_expectations && mon.payload.is_read()
            && cfg.mode == {{ class_prefix }}scoreboard_config::ORDERED) begin
            for(int g = 0; g < golden_pending.key_size(key); g++) begin
                if(!golden_pending.at(key, g).covered) begin
                    first_uncovered = g;
                    break;
                end
            end
        end
        if(cfg.reuse_read_expectations && mon.payload.is_read()) begin
            int covered_match;
            int fallback;

            if(lifecycle == ACCEPTING)
                continue;
            covered_match = -1;
            fallback = -1;
            for(int g = 0; g < golden_pending.key_size(key); g++) begin
                {{ class_prefix }}scoreboard_entry gld;

                gld = golden_pending.at(key, g);
                if(!gld.payload.is_read())
                    continue;
                if(cfg.mode == {{ class_prefix }}scoreboard_config::ORDERED && !gld.covered && g != first_uncovered)
                    continue;
                if(fallback < 0 || (golden_pending.at(key, fallback).covered && !gld.covered))
                    fallback = g;
                if(adapter.equal(gld.payload, mon.payload)) begin
                    if(!gld.covered) begin
                        golden_index = g;
                        monitor_index = m;
                        equal = 1;
                        return 1;
                    end
                    if(covered_match < 0)
                        covered_match = g;
                end
            end
            if(covered_match >= 0) begin
                golden_index = covered_match;
                equal = 1;
            end
            else if(fallback >= 0)
                golden_index = fallback;
            else if(cfg.mode == {{ class_prefix }}scoreboard_config::ORDERED)
                golden_index = first_uncovered;
            if(golden_index >= 0) begin
                monitor_index = m;
                return 1;
            end
        end
        else begin
            for(int g = 0; g < golden_pending.key_size(key); g++) begin
                {{ class_prefix }}scoreboard_entry gld;

                gld = golden_pending.at(key, g);
                if(gld.covered)
                    continue;
                equal = adapter.equal(gld.payload, mon.payload);
                if(cfg.mode == {{ class_prefix }}scoreboard_config::SET && !equal)
                    continue;
                golden_index = g;
                monitor_index = m;
                return 1;
            end
        end
    end
    return 0;
endfunction

function void {{ class_prefix }}scoreboard::drain(string key);
    int g;
    int m;
    bit equal;

    while(match(key, g, m, equal)) begin
        {{ class_prefix }}scoreboard_entry gld;
        {{ class_prefix }}scoreboard_entry mon;
        bit first_coverage;

        first_coverage = 0;
        gld = golden_pending.at(key, g);
        mon = monitor_pending.at(key, m);
        if(equal) begin
            matched_count++;
            first_coverage = golden_pending.mark_covered(key, g);
            if(first_coverage)
                covered_units++;
        end
        else begin
            failed = 1;
            mismatched_count++;
            `uvm_error("GP_MISMATCH", "payload comparison failed")
            print_payload(gld.payload, "GP_GOLDEN", UVM_LOW);
            print_payload(mon.payload, "GP_MONITOR", UVM_LOW);
        end
        if(!cfg.reuse_read_expectations || (gld.payload.is_write() && mon.payload.is_write()))
            golden_pending.remove(key, g);
        monitor_pending.remove(key, m);
        notify(COMPARE_EVENT, gld.payload, mon.payload, equal, first_coverage);
    end
endfunction

function void {{ class_prefix }}scoreboard::accept(uvm_tlm_generic_payload payload, bit golden);
    uvm_tlm_generic_payload units[$];
    string reason;
    longint valid_bytes;

    if(!cfg.checks_enabled) begin
        if(lifecycle == ACCEPTING && !notifying)
            skipped_packets++;
        return;
    end
    if(notifying || lifecycle != ACCEPTING) begin
        failed = 1;
        protocol_errors++;
        if(notifying)
            `uvm_error("GP_CALLBACK", "input submitted recursively during an observer callback")
        else
            `uvm_error("GP_PHASE", "input submitted after extract_phase sealed sampling")
        return;
    end
    valid_bytes = 0;
    if(!adapter.convert(payload, units, reason, valid_bytes)) begin
        failed = 1;
        input_errors++;
        `uvm_error("GP_INPUT", reason)
        return;
    end
    if(golden) begin
        golden_packets++;
        golden_units += units.size();
        golden_valid_bytes += valid_bytes;
    end
    else begin
        monitor_packets++;
        monitor_units += units.size();
        monitor_valid_bytes += valid_bytes;
    end
    foreach(units[j]) begin
        string key;

        key = adapter.key(units[j]);
        if(golden && !golden_keys.exists(key)) begin
            if(golden_keys.num() >= cfg.max_keys) begin
                failed = 1;
                protocol_errors++;
                `uvm_fatal("GP_CAPACITY", "golden key limit exceeded")
                return;
            end
            golden_keys[key] = 1;
        end
        if(!golden && !golden_keys.exists(key) && cfg.monitor_policy == {{ class_prefix }}scoreboard_config::DROP) begin
            dropped_count++;
            continue;
        end
        if(golden) begin
            if(cfg.mode == {{ class_prefix }}scoreboard_config::STATE)
                golden_pending.put_latest(key, units[j]);
            else
                golden_pending.push(key, units[j]);
        end
        else begin
            if(cfg.mode == {{ class_prefix }}scoreboard_config::STATE)
                monitor_pending.put_latest(key, units[j]);
            else
                monitor_pending.push(key, units[j]);
        end
        drain(key);
        if(golden_pending.retained_size() > cfg.max_pending) begin
            golden_pending.remove(key, golden_pending.key_size(key) - 1);
            failed = 1;
            protocol_errors++;
            `uvm_fatal("GP_CAPACITY", "golden retained limit exceeded")
            return;
        end
        if(monitor_pending.retained_size() > cfg.max_pending) begin
            monitor_pending.remove(key, monitor_pending.key_size(key) - 1);
            failed = 1;
            protocol_errors++;
            `uvm_fatal("GP_CAPACITY", "monitor pending limit exceeded")
            return;
        end
    end
endfunction

function int {{ class_prefix }}scoreboard::unexpected_monitor_count();
    int count;

    count = 0;
    if(cfg.monitor_policy == {{ class_prefix }}scoreboard_config::STRICT)
        return monitor_pending.size();
    foreach(golden_keys[key])
        count += monitor_pending.key_size(key);
    return count;
endfunction

function longint {{ class_prefix }}scoreboard::required_units();
    return cfg.mode == {{ class_prefix }}scoreboard_config::STATE ? longint'(golden_keys.num()) : golden_units;
endfunction

function bit [5:0] {{ class_prefix }}scoreboard::completion_issues();
    bit [5:0] issues;
    longint required;

    issues = 0;
    required = required_units();
    if(lifecycle == ACCEPTING)
        issues |= ROUND_OPEN;
    if(cfg.expected_units < 0) begin
        if(cfg.require_golden && golden_packets == 0)
            issues |= EMPTY_GOLDEN;
        if(cfg.require_match && matched_count == 0)
            issues |= NO_MATCH;
    end
    if(cfg.check_count && ((cfg.expected_units >= 0 && (required != cfg.expected_units || covered_units != cfg.expected_units))
        || (cfg.expected_units < 0 && lifecycle != ACCEPTING && covered_units != required)))
        issues |= COUNT;
    if(cfg.check_missing && golden_pending.size() != 0)
        issues |= MISSING;
    if(cfg.check_unexpected && unexpected_monitor_count() != 0)
        issues |= UNEXPECTED;
    return issues;
endfunction

function void {{ class_prefix }}scoreboard::report_checks(bit [5:0] issues);
    if(issues != 0)
        failed = 1;
    for(int i = 0; i < 6; i++) begin
        if(issues[i])
            check_errors++;
    end
    if((issues & MISSING) != 0)
        `uvm_error("GP_MISSING", "golden payloads remain unmatched")
    if((issues & UNEXPECTED) != 0)
        `uvm_error("GP_UNEXPECTED", "relevant monitor payloads remain unmatched")
    if((issues & ROUND_OPEN) != 0)
        `uvm_error("GP_ROUND_OPEN", "extract_phase must seal sampling before checking")
    if((issues & EMPTY_GOLDEN) != 0)
        `uvm_error("GP_EMPTY_GOLDEN", "no valid golden packet was received")
    if((issues & NO_MATCH) != 0)
        `uvm_error("GP_NO_MATCH", "no comparison unit matched successfully")
    if((issues & COUNT) != 0)
        `uvm_error("GP_COUNT", "submitted or covered unit count differs from expected units")
endfunction

function bit {{ class_prefix }}scoreboard::is_complete();
    return cfg.checks_enabled && lifecycle == CHECKED && !failed && completion_issues() == 0;
endfunction

function void {{ class_prefix }}scoreboard::get_statistics(output {{ class_prefix }}scoreboard_statistics result);
    result = new;
    result.round_id = round_id;
    result.checks_enabled = cfg.checks_enabled;
    result.skipped_packets = skipped_packets;
    result.golden_packets = golden_packets;
    result.monitor_packets = monitor_packets;
    result.golden_units = golden_units;
    result.monitor_units = monitor_units;
    result.golden_valid_bytes = golden_valid_bytes;
    result.monitor_valid_bytes = monitor_valid_bytes;
    result.compared_units = matched_count + mismatched_count;
    result.covered_units = covered_units;
    result.retained_golden = golden_pending.retained_size();
    result.matched_count = matched_count;
    result.mismatched_count = mismatched_count;
    result.dropped_count = dropped_count;
    result.input_errors = input_errors;
    result.protocol_errors = protocol_errors;
    result.check_errors = check_errors;
    result.required_units = required_units();
    if(cfg.checks_enabled) begin
        result.expected_units = cfg.expected_units >= 0 ? cfg.expected_units : result.required_units;
        result.expected_set = cfg.expected_units >= 0 || lifecycle != ACCEPTING;
        result.expected_explicit = cfg.expected_units >= 0;
    end
    result.sealed = lifecycle != ACCEPTING;
    result.checked = cfg.checks_enabled && lifecycle == CHECKED;
    result.failed = failed;
    result.complete = is_complete();
    result.pending_golden = golden_pending.size();
    result.pending_monitor = monitor_pending.size();
    result.unexpected_monitor = unexpected_monitor_count();
endfunction

function void {{ class_prefix }}scoreboard::notify(notification_e kind,
    uvm_tlm_generic_payload golden = null, uvm_tlm_generic_payload monitor = null,
    bit matched = 0, bit first_coverage = 0);
    uvm_callback_iter #({{ class_prefix }}scoreboard, {{ class_prefix }}scoreboard_callback) iterator_;
    {{ class_prefix }}scoreboard_callback observer;

    notifying = 1;
    iterator_ = new(this);
    for(observer = iterator_.first(); observer != null; observer = iterator_.next()) begin
        {{ class_prefix }}scoreboard_statistics stats;

        get_statistics(stats);
        case(kind)
            RESET_EVENT: observer.on_reset(get_full_name(), stats);
            COMPARE_EVENT: observer.on_compare(get_full_name(), adapter.copy_payload(golden),
                adapter.copy_payload(monitor), matched, first_coverage, stats);
            CHECK_EVENT: observer.on_check(get_full_name(), stats);
        endcase
    end
    notifying = 0;
endfunction

function void {{ class_prefix }}scoreboard::print_payload(uvm_tlm_generic_payload payload,
    string id = "GP", int verbosity = UVM_HIGH);
    if(payload != null)
        `uvm_info(id, payload.sprint(uvm_default_line_printer), verbosity)
endfunction

`endif
