{%- endif %}
endclass

function void {{ class_prefix }}scoreboard::connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    i_golden_ap.connect(golden_imp);
    i_monitor_ap.connect(monitor_imp);
endfunction

task {{ class_prefix }}scoreboard::reset_phase(uvm_phase phase);
    super.reset_phase(phase);
    reset_state();
{%- if checks_enabled and callbacks_enabled %}
    notify(RESET_EVENT);
{%- endif %}
endtask

function void {{ class_prefix }}scoreboard::extract_phase(uvm_phase phase);
    super.extract_phase(phase);
{%- if checks_enabled %}
    if(lifecycle != ACCEPTING)
        return;
    lifecycle = SEALED;
{%- if mode == 'state' or reuse_read_expectations %}
    foreach(golden_keys[key])
        drain(key);
{%- endif %}
{%- else %}
    sealed = 1;
{%- endif %}
endfunction

{%- if checks_enabled %}
function void {{ class_prefix }}scoreboard::check_phase(uvm_phase phase);
    super.check_phase(phase);
    if(lifecycle == CHECKED)
        return;
    report_checks(completion_issues());
    lifecycle = CHECKED;
{%- if callbacks_enabled %}
    notify(CHECK_EVENT);
{%- endif %}
endfunction
{%- endif %}

function void {{ class_prefix }}scoreboard::reset_state();
    round_id++;
{%- if checks_enabled %}
    golden_pending.clear();
    monitor_pending.clear();
    golden_keys.delete();
    lifecycle = ACCEPTING;
{%- if callbacks_enabled %}
    notifying = 0;
{%- endif %}
    failed = 0;
    golden_packets = 0;
    monitor_packets = 0;
    golden_units = 0;
    monitor_units = 0;
    golden_valid_bytes = 0;
    monitor_valid_bytes = 0;
    input_errors = 0;
    protocol_errors = 0;
    check_errors = 0;
    covered_units = 0;
    matched_count = 0;
    mismatched_count = 0;
{%- if monitor_policy == 'drop' %}
    dropped_count = 0;
{%- endif %}
{%- else %}
    sealed = 0;
    skipped_packets = 0;
{%- endif %}
endfunction

function void {{ class_prefix }}scoreboard::write_{{ class_prefix }}scoreboard_golden(uvm_tlm_generic_payload payload);
{%- if checks_enabled %}
    accept(payload, 1);
{%- else %}
    if(!sealed)
        skipped_packets++;
{%- endif %}
endfunction

function void {{ class_prefix }}scoreboard::write_{{ class_prefix }}scoreboard_monitor(uvm_tlm_generic_payload payload);
{%- if checks_enabled %}
    accept(payload, 0);
{%- else %}
    if(!sealed)
        skipped_packets++;
{%- endif %}
endfunction

{%- if checks_enabled %}
function bit {{ class_prefix }}scoreboard::match(input string key, output int golden_index, output int monitor_index, output bit equal);
{%- if mode != 'set' and not reuse_read_expectations %}
    {{ class_prefix }}scoreboard_entry golden_entry;
    {{ class_prefix }}scoreboard_entry monitor_entry;

    golden_index = -1;
    monitor_index = -1;
    equal = 0;
    golden_entry = golden_pending.at(key, 0);
    monitor_entry = monitor_pending.at(key, 0);
    if(golden_entry == null || monitor_entry == null)
        return 0;
    golden_index = 0;
    monitor_index = 0;
    equal = adapter.equal(golden_entry.payload, monitor_entry.payload);
    return 1;
{%- else %}
    golden_index = -1;
    monitor_index = -1;
    equal = 0;
    for(int m = 0; m < monitor_pending.key_size(key); m++) begin
        {{ class_prefix }}scoreboard_entry mon;
{%- if reuse_read_expectations and mode == 'ordered' %}
        int first_uncovered;
{%- endif %}
{%- if mode != 'set' %}
        if(m > 0)
            break;
{%- endif %}
        mon = monitor_pending.at(key, m);
{%- if reuse_read_expectations and mode == 'ordered' %}
        first_uncovered = -1;
        if(mon.payload.is_read()) begin
            for(int g = 0; g < golden_pending.key_size(key); g++) begin
                if(!golden_pending.at(key, g).covered) begin
                    first_uncovered = g;
                    break;
                end
            end
        end
{%- endif %}
{%- if reuse_read_expectations %}
        if(mon.payload.is_read()) begin
            int covered_match;
            int fallback;

            if(lifecycle == ACCEPTING)
                continue;
            covered_match = -1;
            fallback = -1;
            for(int g = 0; g < golden_pending.key_size(key); g++) begin
                {{ class_prefix }}scoreboard_entry gld;

                gld = golden_pending.at(key, g);
                if(!gld.payload.is_read())
                    continue;
{%- if mode == 'ordered' %}
                if(!gld.covered && g != first_uncovered)
                    continue;
{%- endif %}
                if(fallback < 0 || (golden_pending.at(key, fallback).covered && !gld.covered))
                    fallback = g;
                if(adapter.equal(gld.payload, mon.payload)) begin
                    if(!gld.covered) begin
                        golden_index = g;
                        monitor_index = m;
                        equal = 1;
                        return 1;
                    end
                    if(covered_match < 0)
                        covered_match = g;
                end
            end
            if(covered_match >= 0) begin
                golden_index = covered_match;
                equal = 1;
            end
            else if(fallback >= 0)
                golden_index = fallback;
{%- if mode == 'ordered' %}
            else
                golden_index = first_uncovered;
{%- endif %}
            if(golden_index >= 0) begin
                monitor_index = m;
                return 1;
            end
        end
        else
{%- endif %}
        begin
            for(int g = 0; g < golden_pending.key_size(key); g++) begin
                {{ class_prefix }}scoreboard_entry gld;

                gld = golden_pending.at(key, g);
{%- if reuse_read_expectations %}
                if(gld.covered)
                    continue;
{%- endif %}
                equal = adapter.equal(gld.payload, mon.payload);
{%- if mode == 'set' %}
                if(!equal)
                    continue;
{%- endif %}
                golden_index = g;
                monitor_index = m;
                return 1;
            end
        end
    end
    return 0;
{%- endif %}
endfunction

function void {{ class_prefix }}scoreboard::drain(string key);
    int g;
    int m;
    bit equal;

    while(match(key, g, m, equal)) begin
{%- if reuse_read_expectations or callbacks_enabled or print_payload_enabled %}
        {{ class_prefix }}scoreboard_entry gld;
        {{ class_prefix }}scoreboard_entry mon;
{%- endif %}
{%- if reuse_read_expectations and callbacks_enabled %}
        bit first_coverage;

        first_coverage = 0;
{%- endif %}
{%- if reuse_read_expectations or callbacks_enabled or print_payload_enabled %}
        gld = golden_pending.at(key, g);
        mon = monitor_pending.at(key, m);
{%- endif %}
        if(equal) begin
            matched_count++;
{%- if reuse_read_expectations %}
{%- if callbacks_enabled %}
            first_coverage = golden_pending.mark_covered(key, g);
            if(first_coverage)
{%- else %}
            if(golden_pending.mark_covered(key, g))
{%- endif %}
                covered_units++;
{%- else %}
            covered_units++;
{%- endif %}
        end
        else begin
            failed = 1;
            mismatched_count++;
            `uvm_error("GP_MISMATCH", "payload comparison failed")
{%- if print_payload_enabled %}
            print_payload(gld.payload, "GP_GOLDEN", UVM_LOW);
            print_payload(mon.payload, "GP_MONITOR", UVM_LOW);
{%- endif %}
        end
{%- if reuse_read_expectations %}
        if(gld.payload.is_write() && mon.payload.is_write())
            golden_pending.remove(key, g);
{%- else %}
        golden_pending.remove(key, g);
{%- endif %}
        monitor_pending.remove(key, m);
{%- if callbacks_enabled %}
        notify(COMPARE_EVENT, gld.payload, mon.payload, equal, {{ 'first_coverage' if reuse_read_expectations else 'equal' }});
{%- endif %}
    end
endfunction

function void {{ class_prefix }}scoreboard::accept(uvm_tlm_generic_payload payload, bit golden);
    uvm_tlm_generic_payload units[$];
    string reason;
    longint valid_bytes;

    if({{ 'notifying || ' if callbacks_enabled else '' }}lifecycle != ACCEPTING) begin
        failed = 1;
        protocol_errors++;
{%- if callbacks_enabled %}
        if(notifying)
            `uvm_error("GP_CALLBACK", "input submitted recursively during an observer callback")
        else
            `uvm_error("GP_PHASE", "input submitted after extract_phase sealed sampling")
{%- else %}
        `uvm_error("GP_PHASE", "input submitted after extract_phase sealed sampling")
{%- endif %}
        return;
    end
    valid_bytes = 0;
    if(!adapter.convert(payload, units, reason, valid_bytes)) begin
        failed = 1;
        input_errors++;
        `uvm_error("GP_INPUT", reason)
        return;
    end
    if(golden) begin
        golden_packets++;
        golden_units += units.size();
        golden_valid_bytes += valid_bytes;
    end
    else begin
        monitor_packets++;
        monitor_units += units.size();
        monitor_valid_bytes += valid_bytes;
    end
    foreach(units[j]) begin
        string key;

        key = adapter.key(units[j]);
        if(golden && !golden_keys.exists(key)) begin
            if(golden_keys.num() >= {{ max_keys }}) begin
                failed = 1;
                protocol_errors++;
                `uvm_fatal("GP_CAPACITY", "golden key limit exceeded")
                return;
            end
            golden_keys[key] = 1;
        end
{%- if monitor_policy == 'drop' %}
        if(!golden && !golden_keys.exists(key)) begin
            dropped_count++;
            continue;
        end
{%- endif %}
        if(golden) begin
{%- if mode == 'state' %}
            golden_pending.put_latest(key, units[j]);
{%- else %}
            golden_pending.push(key, units[j]);
{%- endif %}
        end
        else begin
{%- if mode == 'state' %}
            monitor_pending.put_latest(key, units[j]);
{%- else %}
            monitor_pending.push(key, units[j]);
{%- endif %}
        end
{%- if mode != 'state' %}
        drain(key);
{%- endif %}
        if(golden_pending.{{ 'retained_size' if reuse_read_expectations else 'size' }}() > {{ max_pending }}) begin
            golden_pending.remove(key, golden_pending.key_size(key) - 1);
            failed = 1;
            protocol_errors++;
            `uvm_fatal("GP_CAPACITY", "golden retained limit exceeded")
            return;
        end
        if(monitor_pending.size() > {{ max_pending }}) begin
            monitor_pending.remove(key, monitor_pending.key_size(key) - 1);
            failed = 1;
            protocol_errors++;
            `uvm_fatal("GP_CAPACITY", "monitor pending limit exceeded")
            return;
        end
    end
endfunction

function int {{ class_prefix }}scoreboard::unexpected_monitor_count();
{%- if monitor_policy == 'strict' %}
    return monitor_pending.size();
{%- else %}
    int count;

    count = 0;
    foreach(golden_keys[key])
        count += monitor_pending.key_size(key);
    return count;
{%- endif %}
endfunction

function longint {{ class_prefix }}scoreboard::required_units();
    return {{ "longint'(golden_keys.num())" if mode == 'state' else 'golden_units' }};
endfunction

function bit [5:0] {{ class_prefix }}scoreboard::completion_issues();
    bit [5:0] issues;

    issues = 0;
    if(lifecycle == ACCEPTING)
        issues |= ROUND_OPEN;
{%- if expected_units < 0 and require_golden %}
    if(golden_packets == 0)
        issues |= EMPTY_GOLDEN;
{%- endif %}
{%- if expected_units < 0 and require_match %}
    if(matched_count == 0)
        issues |= NO_MATCH;
{%- endif %}
{%- if check_count %}
{%- if expected_units >= 0 %}
    if(required_units() != {{ expected_units }} || covered_units != {{ expected_units }})
{%- else %}
    if(lifecycle != ACCEPTING && covered_units != required_units())
{%- endif %}
        issues |= COUNT;
{%- endif %}
{%- if check_missing %}
    if(golden_pending.size() != 0)
        issues |= MISSING;
{%- endif %}
{%- if check_unexpected %}
    if(unexpected_monitor_count() != 0)
        issues |= UNEXPECTED;
{%- endif %}
    return issues;
endfunction

function void {{ class_prefix }}scoreboard::report_checks(bit [5:0] issues);
    if(issues != 0)
        failed = 1;
    for(int i = 0; i < 6; i++) begin
        if(issues[i])
            check_errors++;
    end
{%- if check_missing %}
    if((issues & MISSING) != 0)
        `uvm_error("GP_MISSING", "golden payloads remain unmatched")
{%- endif %}
{%- if check_unexpected %}
    if((issues & UNEXPECTED) != 0)
        `uvm_error("GP_UNEXPECTED", "relevant monitor payloads remain unmatched")
{%- endif %}
    if((issues & ROUND_OPEN) != 0)
        `uvm_error("GP_ROUND_OPEN", "extract_phase must seal sampling before checking")
{%- if expected_units < 0 and require_golden %}
    if((issues & EMPTY_GOLDEN) != 0)
        `uvm_error("GP_EMPTY_GOLDEN", "no valid golden packet was received")
{%- endif %}
{%- if expected_units < 0 and require_match %}
    if((issues & NO_MATCH) != 0)
        `uvm_error("GP_NO_MATCH", "no comparison unit matched successfully")
{%- endif %}
{%- if check_count %}
    if((issues & COUNT) != 0)
        `uvm_error("GP_COUNT", "submitted or covered unit count differs from expected units")
{%- endif %}
endfunction

function bit {{ class_prefix }}scoreboard::is_complete();
    return lifecycle == CHECKED && !failed;
endfunction
{%- endif %}

function void {{ class_prefix }}scoreboard::get_statistics(output {{ class_prefix }}scoreboard_statistics result);
    result = new;
    result.round_id = round_id;
{%- if checks_enabled %}
    result.golden_packets = golden_packets;
    result.monitor_packets = monitor_packets;
    result.golden_units = golden_units;
    result.monitor_units = monitor_units;
    result.golden_valid_bytes = golden_valid_bytes;
    result.monitor_valid_bytes = monitor_valid_bytes;
    result.compared_units = matched_count + mismatched_count;
    result.covered_units = covered_units;
    result.retained_golden = golden_pending.{{ 'retained_size' if reuse_read_expectations else 'size' }}();
    result.matched_count = matched_count;
    result.mismatched_count = mismatched_count;
{%- if monitor_policy == 'drop' %}
    result.dropped_count = dropped_count;
{%- endif %}
    result.input_errors = input_errors;
    result.protocol_errors = protocol_errors;
    result.check_errors = check_errors;
    result.required_units = required_units();
{%- if expected_units >= 0 %}
    result.expected_units = {{ expected_units }};
    result.expected_set = 1;
    result.expected_explicit = 1;
{%- else %}
    result.expected_units = result.required_units;
    result.expected_set = lifecycle != ACCEPTING;
{%- endif %}
    result.sealed = lifecycle != ACCEPTING;
    result.checked = lifecycle == CHECKED;
    result.failed = failed;
    result.complete = is_complete();
    result.pending_golden = golden_pending.size();
    result.pending_monitor = monitor_pending.size();
    result.unexpected_monitor = unexpected_monitor_count();
{%- else %}
    result.sealed = sealed;
    result.skipped_packets = skipped_packets;
{%- endif %}
endfunction

{%- if checks_enabled and callbacks_enabled %}
function void {{ class_prefix }}scoreboard::notify(notification_e kind,
    uvm_tlm_generic_payload golden = null, uvm_tlm_generic_payload monitor = null,
    bit matched = 0, bit first_coverage = 0);
    uvm_callback_iter #({{ class_prefix }}scoreboard, {{ class_prefix }}scoreboard_callback) iterator_;
    {{ class_prefix }}scoreboard_callback observer;

    notifying = 1;
    iterator_ = new(this);
    for(observer = iterator_.first(); observer != null; observer = iterator_.next()) begin
        {{ class_prefix }}scoreboard_statistics stats;

        get_statistics(stats);
        case(kind)
            RESET_EVENT: observer.on_reset(get_full_name(), stats);
            COMPARE_EVENT: observer.on_compare(get_full_name(), adapter.copy_payload(golden),
                adapter.copy_payload(monitor), matched, first_coverage, stats);
            CHECK_EVENT: observer.on_check(get_full_name(), stats);
        endcase
    end
    notifying = 0;
endfunction
{%- endif %}

{%- if checks_enabled and print_payload_enabled %}
function void {{ class_prefix }}scoreboard::print_payload(uvm_tlm_generic_payload payload,
    string id = "GP", int verbosity = UVM_HIGH);
    if(payload != null)
        `uvm_info(id, payload.sprint(uvm_default_line_printer), verbosity)
endfunction
{%- endif %}

`endif
