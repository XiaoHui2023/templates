{%- if checks_enabled %}
`ifndef {{ class_prefix }}scoreboard_adapter_SV
`define {{ class_prefix }}scoreboard_adapter_SV

class {{ class_prefix }}scoreboard_adapter;
    // Validate standard GP fields and create independently owned comparison units.
    // units — Empty on rejection, IGNORE commands, or fully disabled transfers.
    // reason — Validation failure text, empty on success.
    // valid_bytes — Enabled-byte count, zero on rejection or IGNORE.
    extern function bit convert(input uvm_tlm_generic_payload payload,
        output uvm_tlm_generic_payload units[$], output string reason, output longint valid_bytes);
{%- if not atomize or callbacks_enabled %}
    // Copy only standard GP fields into an independent payload.
    extern function uvm_tlm_generic_payload copy_payload(uvm_tlm_generic_payload payload);
{%- endif %}
    // Construct a key from the enabled identity fields.
    extern function string key(uvm_tlm_generic_payload payload);
    // Compare selected GP fields, honoring golden byte enables.
    extern function bit equal(uvm_tlm_generic_payload golden, uvm_tlm_generic_payload monitor);
endclass

function bit {{ class_prefix }}scoreboard_adapter::convert(input uvm_tlm_generic_payload payload,
    output uvm_tlm_generic_payload units[$], output string reason, output longint valid_bytes);
    byte unsigned data[];
    byte unsigned enables[];
    int length;
    int enable_length;
    int width;
    longint enabled_count;
    uvm_tlm_generic_payload snapshot;

    units.delete();
    reason = "";
    valid_bytes = 0;
    enabled_count = 0;
    if(payload == null) begin
        reason = "null payload";
        return 0;
    end
    if(payload.get_object_type() != uvm_tlm_generic_payload::get_type()) begin
        reason = "only uvm_tlm_generic_payload is supported";
        return 0;
    end
    if(payload.get_command() == UVM_TLM_IGNORE_COMMAND)
        return 1;
{%- if mode == 'state' %}
    if(!payload.is_write()) begin
        reason = "state mode accepts WRITE or IGNORE payloads only";
        return 0;
    end
{%- else %}
    if(!(payload.get_command() inside {UVM_TLM_READ_COMMAND, UVM_TLM_WRITE_COMMAND})) begin
        reason = "invalid command";
        return 0;
    end
{%- endif %}
    if(payload.get_data_length() == 0 || payload.get_data_length() > {{ max_payload_bytes }}) begin
        reason = "invalid data length";
        return 0;
    end
    if(payload.get_byte_enable_length() > {{ max_payload_bytes }}) begin
        reason = "invalid byte enable length";
        return 0;
    end
    length = int'(payload.get_data_length());
    enable_length = int'(payload.get_byte_enable_length());
    width = length;
    if(payload.get_streaming_width() != 0 && payload.get_streaming_width() < length)
        width = int'(payload.get_streaming_width());
    payload.get_data(data);
    payload.get_byte_enable(enables);
    if(data.size() < length || enables.size() < enable_length) begin
        reason = "GP length exceeds array capacity";
        return 0;
    end
    for(int j = 0; j < enable_length; j++) begin
        if(!(enables[j] inside {8'h00, 8'hff})) begin
            reason = "byte enable must be 00 or ff";
            return 0;
        end
    end
    for(int j = 0; j < length; j++) begin
        if(enable_length == 0 || enables[j % enable_length] != 0)
            enabled_count++;
        if(payload.get_address() > 64'hffffffffffffffff - 64'(j % width)) begin
            reason = "address overflow";
            return 0;
        end
    end
    valid_bytes = enabled_count;
    if(enabled_count == 0)
        return 1;
{%- if atomize %}
    for(int j = 0; j < length; j++) begin
        byte unsigned single_byte[];

        if(enable_length != 0 && enables[j % enable_length] == 0)
            continue;
        single_byte = new[1];
        single_byte[0] = data[j];
        snapshot = new("byte");
        snapshot.set_address(payload.get_address() + 64'(j % width));
        snapshot.set_command(payload.get_command());
        snapshot.set_response_status(payload.get_response_status());
        snapshot.set_streaming_width(1);
        snapshot.set_data(single_byte);
        snapshot.set_data_length(1);
        units.push_back(snapshot);
    end
{%- else %}
    snapshot = copy_payload(payload);
    snapshot.set_streaming_width(width);
    units.push_back(snapshot);
{%- endif %}
    return 1;
endfunction

{%- if not atomize or callbacks_enabled %}
function uvm_tlm_generic_payload {{ class_prefix }}scoreboard_adapter::copy_payload(uvm_tlm_generic_payload payload);
    uvm_tlm_generic_payload result;
    byte unsigned data[];
    byte unsigned enables[];

    if(payload == null)
        return null;
    result = new("snapshot");
    payload.get_data(data);
    payload.get_byte_enable(enables);
    data = new[payload.get_data_length()](data);
    enables = new[payload.get_byte_enable_length()](enables);
    result.set_address(payload.get_address());
    result.set_command(payload.get_command());
    result.set_response_status(payload.get_response_status());
    result.set_streaming_width(payload.get_streaming_width());
    result.set_data(data);
    result.set_data_length(payload.get_data_length());
    result.set_byte_enable(enables);
    result.set_byte_enable_length(payload.get_byte_enable_length());
    return result;
endfunction
{%- endif %}

function string {{ class_prefix }}scoreboard_adapter::key(uvm_tlm_generic_payload payload);
{%- if mode == 'ordered' %}
    return "ordered";
{%- elif match_address and (match_command or reuse_read_expectations) %}
    return $sformatf("%016h:%0d", payload.get_address(), int'(payload.get_command()));
{%- elif match_address %}
    return $sformatf("%016h", payload.get_address());
{%- elif match_command or reuse_read_expectations %}
    return $sformatf("%0d", int'(payload.get_command()));
{%- else %}
    return "all";
{%- endif %}
endfunction

function bit {{ class_prefix }}scoreboard_adapter::equal(uvm_tlm_generic_payload golden, uvm_tlm_generic_payload monitor);
{%- if compare_data %}
    byte unsigned gdata[];
    byte unsigned mdata[];
{%- endif %}
{%- if not atomize %}
    byte unsigned genables[];
    byte unsigned menables[];
    int glen;
    int mlen;
{%- endif %}
{%- if compare_data or not atomize %}

{%- endif %}
{%- if compare_address and (mode == 'ordered' or not match_address) %}
    if(golden.get_address() != monitor.get_address())
        return 0;
{%- endif %}
{%- if (compare_command or reuse_read_expectations) and mode != 'state' and (mode == 'ordered' or not (match_command or reuse_read_expectations)) %}
    if(golden.get_command() != monitor.get_command())
        return 0;
{%- endif %}
{%- if compare_response %}
    if(golden.get_response_status() != monitor.get_response_status())
        return 0;
{%- endif %}
{%- if not atomize %}
    if(golden.get_data_length() != monitor.get_data_length()
        || golden.get_streaming_width() != monitor.get_streaming_width())
        return 0;
{%- endif %}
{%- if compare_data %}
    golden.get_data(gdata);
    monitor.get_data(mdata);
{%- endif %}
{%- if not atomize %}
    golden.get_byte_enable(genables);
    monitor.get_byte_enable(menables);
    glen = int'(golden.get_byte_enable_length());
    mlen = int'(monitor.get_byte_enable_length());
    for(int j = 0; j < int'(golden.get_data_length()); j++) begin
        bit genabled;
        bit menabled;

        genabled = glen == 0 || genables[j % glen] != 0;
        menabled = mlen == 0 || menables[j % mlen] != 0;
        if(genabled != menabled)
            return 0;
{%- if compare_data %}
        if(genabled && gdata[j] != mdata[j])
            return 0;
{%- endif %}
    end
{%- elif compare_data %}
    if(gdata[0] != mdata[0])
        return 0;
{%- endif %}
    return 1;
endfunction

`endif
{%- endif %}
