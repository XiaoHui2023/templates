`ifndef {{ (class_prefix ~ "settings") | upper }}
`define {{ (class_prefix ~ "settings") | upper }}

class {{ class_prefix }}settings extends {{ class_prefix }}spec#(uvm_object);
    `uvm_object_utils_begin({{ class_prefix }}settings)
        `uvm_field_enum(ssi_variant_e, ssi_variant, UVM_ALL_ON)
        `uvm_field_int(default_baud_div, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(fifo_depth_bytes, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(max_output_hz, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(min_hclk_hz, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(min_ssi_clk_hz, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(clock_check_tolerance_ppm, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(default_tx_fifo_threshold, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(default_rx_fifo_threshold, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(default_rx_sample_delay_ns, UVM_ALL_ON | UVM_DEC)
    `uvm_object_utils_end

    rand ssi_variant_e ssi_variant;
    rand int unsigned default_baud_div;
    rand int unsigned fifo_depth_bytes;
    rand longint unsigned max_output_hz;
    rand longint unsigned min_hclk_hz;
    rand longint unsigned min_ssi_clk_hz;
    rand int unsigned clock_check_tolerance_ppm;
    rand int unsigned default_tx_fifo_threshold;
    rand int unsigned default_rx_fifo_threshold;
    rand int unsigned default_rx_sample_delay_ns;
    {{ regmodel_type }} regmodel;
    virtual {{ class_prefix }}interface vif;

    function new(string name="{{ class_prefix }}settings");
        super.new(name);
        ssi_variant = {{ ssi_variant }};
        default_baud_div = {{ default_baud_div }};
        fifo_depth_bytes = {{ fifo_depth_bytes }};
        max_output_hz = {{ max_output_hz }};
        min_hclk_hz = {{ min_hclk_hz }};
        min_ssi_clk_hz = {{ min_ssi_clk_hz }};
        clock_check_tolerance_ppm = {{ clock_check_tolerance_ppm }};
        default_tx_fifo_threshold = {{ default_tx_fifo_threshold }};
        default_rx_fifo_threshold = {{ default_rx_fifo_threshold }};
        default_rx_sample_delay_ns = {{ default_rx_sample_delay_ns }};
    endfunction

    constraint cst {
        soft ssi_variant == {{ ssi_variant }};
        soft default_baud_div == {{ default_baud_div }};
        soft fifo_depth_bytes == {{ fifo_depth_bytes }};
        soft max_output_hz == {{ max_output_hz }};
        soft min_hclk_hz == {{ min_hclk_hz }};
        soft min_ssi_clk_hz == {{ min_ssi_clk_hz }};
        soft clock_check_tolerance_ppm == {{ clock_check_tolerance_ppm }};
        soft default_tx_fifo_threshold == {{ default_tx_fifo_threshold }};
        soft default_rx_fifo_threshold == {{ default_rx_fifo_threshold }};
        soft default_rx_sample_delay_ns == {{ default_rx_sample_delay_ns }};
        default_baud_div inside {[2:65534]};
        default_baud_div[0] == 1'b0;
        fifo_depth_bytes inside {[1:4096]};
        default_tx_fifo_threshold < fifo_depth_bytes;
        default_rx_fifo_threshold < fifo_depth_bytes;
        min_hclk_hz > 0;
        min_ssi_clk_hz > 0;
        clock_check_tolerance_ppm <= 1000000;
{% if not support_rx_sample_delay %}
        default_rx_sample_delay_ns == 0;
{% endif %}
    }

    constraint cst_user;
    constraint cst_case;
endclass

`endif
