`ifndef {{ (class_prefix ~ "read2x_flash_command") | upper }}
`define {{ (class_prefix ~ "read2x_flash_command") | upper }}

class {{ class_prefix }}read2x_flash_command extends {{ class_prefix }}flash_command;
    `uvm_object_utils({{ class_prefix }}read2x_flash_command)

    // Creates a dual-I/O read command packet.
    function new(string name="{{ class_prefix }}read2x_flash_command");
        super.new(name);
    endfunction

    constraint cst_read2x {
        opcode == 8'hBB;
        frame_mode == ENHANCED;
        transfer_mode == EEPROM_READ;
        io_lanes == 2;
        address_lanes == 2;
        speed_multiplier == 2;
        inst_bytes == 1;
        addr_bytes inside {3, 4};
        dummy_cycles == 4;
        rx_skip_bytes == addr_bytes;
        payload_is_read == 1'b1;
        payload_is_write == 1'b0;
    }
endclass

`endif
