`ifndef {{ (class_prefix ~ "fast_read1x_flash_command") | upper }}
`define {{ (class_prefix ~ "fast_read1x_flash_command") | upper }}

class {{ class_prefix }}fast_read1x_flash_command extends {{ class_prefix }}flash_command;
    `uvm_object_utils({{ class_prefix }}fast_read1x_flash_command)

    // Creates an enhanced single-lane fast-read command packet.
    function new(string name="{{ class_prefix }}fast_read1x_flash_command");
        super.new(name);
    endfunction

    constraint cst_fast_read1x {
        opcode == 8'h0B;
        frame_mode == ENHANCED;
        transfer_mode == EEPROM_READ;
        io_lanes == 1;
        address_lanes == 1;
        speed_multiplier == 1;
        inst_bytes == 1;
        addr_bytes inside {3, 4};
        dummy_cycles == 8;
        payload_is_read == 1'b1;
        payload_is_write == 1'b0;
    }
endclass

