`ifndef {{ (class_prefix ~ "register_config_builder") | upper }}
`define {{ (class_prefix ~ "register_config_builder") | upper }}

class {{ class_prefix }}register_config_builder extends {{ class_prefix }}spec#(uvm_object);
    `uvm_object_utils({{ class_prefix }}register_config_builder)

    {{ class_prefix }}settings settings;

    function new(string name="{{ class_prefix }}register_config_builder");
        super.new(name);
    endfunction

    function int unsigned spi_frf_from_speed(int unsigned speed_multiplier);
        case (speed_multiplier)
            1: return CTRLR0_SPI_FRF_STANDARD;
            2: return CTRLR0_SPI_FRF_DUAL;
            4: return CTRLR0_SPI_FRF_QUAD;
            8: return CTRLR0_SPI_FRF_OCTAL;
            default: return CTRLR0_SPI_FRF_STANDARD;
        endcase
    endfunction

    function longint unsigned ceil_div(
            longint unsigned dividend,
            longint unsigned divisor);
        if (divisor == 0)
            return 0;
        return (dividend + divisor - 1) / divisor;
    endfunction

    function int unsigned baudr_from_clock(
            longint unsigned ssi_clk_hz,
            longint unsigned target_sclk_hz);
        longint unsigned div;

        if (ssi_clk_hz == 0 || target_sclk_hz == 0)
            return 0;
        div = ceil_div(ssi_clk_hz, target_sclk_hz);
        if (div < 2)
            div = 2;
        if (div[0])
            div++;
        if (div > 65534)
            return 0;
        return int'(div);
    endfunction

    task build(
            {{ class_prefix }}transfer_req rq,
            output {{ class_prefix }}configuration cfg);
        int unsigned length;
        int unsigned spi_frf;
        int unsigned baudr;
        longint unsigned ssi_clk_hz;
        host_mode_e host_mode;
        transfer_mode_e transfer_mode;
        bit rdmae;
        bit tdmae;

        if (settings == null)
            `uvm_fatal("DW_SPI_CFG", "settings is null")
        if (rq == null)
            `uvm_fatal("DW_SPI_CFG", "transfer req is null")
        if (rq.payload == null)
            `uvm_fatal("DW_SPI_CFG", "transfer req payload is null")
        if (!$cast(host_mode, rq.host_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast host_mode")
        if (!$cast(transfer_mode, rq.transfer_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast transfer_mode")
        if (settings.vif == null)
            `uvm_fatal("DW_SPI_CFG", "settings.vif is null; BAUDR requires measured ssi_clk")
        if (!settings.vif.has_ssi_clk())
            `uvm_fatal("DW_SPI_CFG", "ssi_clk must be connected to derive BAUDR")

        settings.vif.ssi_clk_if.measure_frequency_hz(
            ssi_clk_hz,
            settings.min_ssi_clk_hz,
            settings.clock_check_tolerance_ppm);
        baudr = baudr_from_clock(ssi_clk_hz, settings.target_sclk_hz);
        if (baudr == 0)
            `uvm_fatal("DW_SPI_CFG", $sformatf(
                "failed to derive BAUDR: ssi_clk_hz=%0d target_sclk_hz=%0d",
                ssi_clk_hz,
                settings.target_sclk_hz))
        length = rq.payload.get_data_length();
        spi_frf = spi_frf_from_speed(rq.speed_multiplier);
        rdmae = rq.use_dma && (transfer_mode inside {RX_ONLY, EEPROM_READ});
        tdmae = rq.use_dma && (transfer_mode inside {TX_ONLY, TX_AND_RX});

        cfg = {{ class_prefix }}configuration::type_id::create("configuration");
        cfg.settings = settings;
        if (!$cast(cfg.host_mode, host_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast configuration host_mode")
        if (!$cast(cfg.transfer_mode, transfer_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast configuration transfer_mode")
        cfg.host_mode.rand_mode(0);
        cfg.transfer_mode.rand_mode(0);
        if (!cfg.randomize() with {
                spi_frf == local::spi_frf;
                spi_mode == rq.spi_mode;
                data_frame_bits == rq.data_frame_bits;
                baudr == local::baudr;
                if (local::transfer_mode inside {RX_ONLY, EEPROM_READ}) {
                    ndf == (local::length > 0 ? local::length - 1 : 0);
                } else {
                    ndf == 0;
                }
                ser == (32'h1 << rq.cs_id);
                rdmae == local::rdmae;
                tdmae == local::tdmae;
            })
            `uvm_fatal("DW_SPI_CFG", "failed to randomize register configuration")
        cfg.host_mode.rand_mode(1);
        cfg.transfer_mode.rand_mode(1);
    endtask
endclass

`endif
