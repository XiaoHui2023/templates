`ifndef {{ (class_prefix ~ "register_config_builder") | upper }}
`define {{ (class_prefix ~ "register_config_builder") | upper }}

class {{ class_prefix }}register_config_builder extends {{ class_prefix }}spec#(uvm_object);
    `uvm_object_utils({{ class_prefix }}register_config_builder)

    {{ class_prefix }}settings settings;

    function new(string name="{{ class_prefix }}register_config_builder");
        super.new(name);
    endfunction

    function int spi_frf_from_speed(int speed_multiplier);
        case (speed_multiplier)
            1: return CTRLR0_SPI_FRF_STANDARD;
            2: return CTRLR0_SPI_FRF_DUAL;
            4: return CTRLR0_SPI_FRF_QUAD;
            default: return CTRLR0_SPI_FRF_STANDARD;
        endcase
    endfunction

    function int inst_l_from_bytes(int inst_bytes);
        case (inst_bytes)
            0: return 0;
            1: return 2;
            2: return 3;
            default: return 2;
        endcase
    endfunction

    function int addr_l_from_bytes(int addr_bytes);
        if (addr_bytes == 0)
            return 0;
        return addr_bytes * 2;
    endfunction

    function longint ceil_div(
            longint dividend,
            longint divisor);
        if (divisor == 0)
            return 0;
        return (dividend + divisor - 1) / divisor;
    endfunction

    function int baudr_from_clock(
            longint ssi_clk_hz,
            longint target_sclk_hz);
        longint div;

        if (ssi_clk_hz == 0 || target_sclk_hz == 0)
            return 0;
        div = ceil_div(ssi_clk_hz, target_sclk_hz);
        if (div < 2)
            div = 2;
        if (div[0])
            div++;
        if (div > 65534)
            return 0;
        return int'(div);
    endfunction

    function int frame_count_from_bytes(
            int byte_count,
            int data_frame_bits);
        longint bits;
        longint frame_count;

        if (byte_count == 0)
            return 0;
        if (data_frame_bits == 0)
            `uvm_fatal("DW_SPI_CFG", "data_frame_bits must be non-zero to derive frame count for CTRLR1.NDF")
        bits = longint'(byte_count) * 8;
        frame_count = ceil_div(bits, data_frame_bits);
        return int'(frame_count);
    endfunction

    function int actual_ndf_from_transfer(
            {{ class_prefix }}transfer_req rq,
            int payload_bytes);
        int byte_phase_frames;
        int actual_ndf;

        if (rq.inst_bytes == 1 && rq.addr_bytes == 0 && rq.dummy_cycles == 0 && payload_bytes == 0)
            return 0;
        byte_phase_frames = frame_count_from_bytes(
            rq.inst_bytes + rq.addr_bytes + payload_bytes,
            rq.data_frame_bits);
        actual_ndf = byte_phase_frames + rq.dummy_cycles;
        return actual_ndf;
    endfunction

    function int phase_sclk_cycles(
            int bits,
            int lanes);
        if (bits == 0)
            return 0;
        if (lanes == 0)
            lanes = 1;
        return int'(ceil_div(bits, lanes));
    endfunction

    function int transfer_timeout_cycles(
            {{ class_prefix }}transfer_req rq,
            int baudr,
            int data_bytes,
            frame_mode_e frame_mode);
        longint inst_cycles;
        longint addr_cycles;
        longint data_cycles;
        longint serial_cycles;
        longint base_cycles;
        longint fifo_chunks;
        longint fifo_cycles;
        longint margin_cycles;
        longint timeout_cycles;
        int data_width;
        int addr_width;

        data_width = frame_mode == ENHANCED ? rq.speed_multiplier : 1;
        addr_width = frame_mode == ENHANCED ? rq.speed_multiplier : 1;
        inst_cycles = phase_sclk_cycles(rq.inst_bytes * 8, 1);
        addr_cycles = phase_sclk_cycles(rq.addr_bytes * 8, addr_width);
        data_cycles = phase_sclk_cycles(data_bytes * 8, data_width);
        serial_cycles = inst_cycles + addr_cycles + rq.dummy_cycles + data_cycles;
        if (serial_cycles == 0)
            serial_cycles = 1;
        base_cycles = serial_cycles * baudr;
        fifo_chunks = ceil_div(data_bytes == 0 ? 1 : data_bytes, settings.fifo_depth_bytes);
        fifo_cycles = fifo_chunks * baudr;
        margin_cycles = ((base_cycles + fifo_cycles) * settings.interrupt_timeout_margin_percent + 99) / 100;
        timeout_cycles = base_cycles + fifo_cycles + margin_cycles + settings.interrupt_timeout_extra_ssi_clk_cycles;
        if (timeout_cycles > 32'hffff_ffff)
            return 32'hffff_ffff;
        `uvm_info("DW_SPI_CFG", $sformatf(
            "interrupt timeout detail: inst_sclk=%0d addr_sclk=%0d dummy_sclk=%0d data_sclk=%0d serial_sclk=%0d baudr=%0d base_ssi=%0d fifo_chunks=%0d fifo_ssi=%0d margin_percent=%0d margin_ssi=%0d extra_ssi=%0d timeout_ssi=%0d",
            inst_cycles,
            addr_cycles,
            rq.dummy_cycles,
            data_cycles,
            serial_cycles,
            baudr,
            base_cycles,
            fifo_chunks,
            fifo_cycles,
            settings.interrupt_timeout_margin_percent,
            margin_cycles,
            settings.interrupt_timeout_extra_ssi_clk_cycles,
            timeout_cycles), UVM_DEBUG)
        return timeout_cycles;
    endfunction

    task build(
            {{ class_prefix }}transfer_req rq,
            output {{ class_prefix }}configuration cfg);
        int length;
        int actual_ndf;
        int spi_frf;
        int baudr;
        int inst_l;
        int addr_l;
        int trans_type;
        int ndf_reg_value;
        bit spi_ctrlr0_en;
        bit spi_clk_stretch_en;
        int wait_cycles;
        int interrupt_timeout_cycles;
        longint ssi_clk_hz;
        host_mode_e host_mode;
        frame_mode_e frame_mode;
        transfer_mode_e transfer_mode;
        completion_mode_e completion_mode;
{% if internal_dma %}
        bit write_internal_dma_regs;
{% endif %}
{% if internal_dma or external_dma %}
        bit rdmae;
        bit tdmae;
{% endif %}
{% if internal_dma %}
        bit [63:0] flash_addr;
        bit [31:0] sdar;
{% endif %}

        if (settings == null)
            `uvm_fatal("DW_SPI_CFG", "settings is null")
        if (rq == null)
            `uvm_fatal("DW_SPI_CFG", "transfer req is null")
        if (rq.payload == null)
            `uvm_fatal("DW_SPI_CFG", "transfer req payload is null")
        if (!$cast(host_mode, rq.host_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast host_mode")
        if (!$cast(frame_mode, rq.frame_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast frame_mode")
        if (!$cast(transfer_mode, rq.transfer_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast transfer_mode")
        if (!$cast(completion_mode, settings.default_completion_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast settings.default_completion_mode")
        if (settings.vif == null)
            `uvm_fatal("DW_SPI_CFG", "settings.vif is null; BAUDR requires measured ssi_clk")
        if (!settings.vif.has_ssi_clk())
            `uvm_fatal("DW_SPI_CFG", "ssi_clk must be connected to derive BAUDR")

        `uvm_info("DW_SPI_CFG", "measuring ssi_clk before deriving BAUDR", UVM_LOW)
        settings.vif.ssi_clk_if.measure_frequency_hz(
            ssi_clk_hz,
            settings.min_ssi_clk_hz,
            settings.clock_check_tolerance_ppm);
        `uvm_info("DW_SPI_CFG", $sformatf(
            "measured ssi_clk: hz=%0d min_hz=%0d tolerance_ppm=%0d target_sclk_hz=%0d",
            ssi_clk_hz,
            settings.min_ssi_clk_hz,
            settings.clock_check_tolerance_ppm,
            settings.target_sclk_hz), UVM_DEBUG)
        baudr = baudr_from_clock(ssi_clk_hz, settings.target_sclk_hz);
        if (baudr == 0)
            `uvm_fatal("DW_SPI_CFG", $sformatf(
                "failed to derive BAUDR: ssi_clk_hz=%0d target_sclk_hz=%0d",
                ssi_clk_hz,
                settings.target_sclk_hz))
        length = rq.payload.get_data_length();
        actual_ndf = actual_ndf_from_transfer(rq, length);
        spi_frf = spi_frf_from_speed(rq.speed_multiplier);
        inst_l = inst_l_from_bytes(rq.inst_bytes);
        addr_l = addr_l_from_bytes(rq.addr_bytes);
        trans_type = frame_mode == ENHANCED ? 1 : 0;
        spi_ctrlr0_en = frame_mode == ENHANCED;
        spi_clk_stretch_en = spi_ctrlr0_en;
        wait_cycles = spi_ctrlr0_en ? rq.dummy_cycles : 0;
        ndf_reg_value = actual_ndf == 0 ? 0 : actual_ndf - 1;
        interrupt_timeout_cycles = transfer_timeout_cycles(
            rq, baudr, length, frame_mode);
        `uvm_info("DW_SPI_CFG", $sformatf(
            "derived transfer fields: inst_bytes=%0d addr_bytes=%0d dummy_cycles=%0d payload_bytes=%0d data_frame_bits=%0d actual_ndf=%0d ndf_reg_value=%0d spi_frf=%0d inst_l=%0d addr_l=%0d trans_type=%0d spi_ctrlr0_en=%0b spi_clk_stretch_en=%0b wait_cycles=%0d interrupt_timeout_cycles=%0d",
            rq.inst_bytes,
            rq.addr_bytes,
            rq.dummy_cycles,
            length,
            rq.data_frame_bits,
            actual_ndf,
            ndf_reg_value,
            spi_frf,
            inst_l,
            addr_l,
            trans_type,
            spi_ctrlr0_en,
            spi_clk_stretch_en,
            wait_cycles,
            interrupt_timeout_cycles), UVM_DEBUG)
{% if internal_dma %}
        write_internal_dma_regs = rq.use_dma;
        flash_addr = rq.payload.get_address();
        sdar = flash_addr[31:0];
        `uvm_info("DW_SPI_CFG", $sformatf(
            "derived internal DMA fields: use_dma=%0b flash_addr=0x%0h sdar=0x%08h axi_addr=0x%08h awlen_field=0x%0h arlen_field=0x%0h spi_inst=0x%02h",
            rq.use_dma,
            flash_addr,
            sdar,
            rq.axi_addr,
            ({8'h0, rq.awlen} << 8),
            ({8'h0, rq.arlen} << 8),
            rq.opcode), UVM_DEBUG)
{% endif %}
{% if internal_dma or external_dma %}
        rdmae = rq.use_dma && (transfer_mode inside {RX_ONLY, EEPROM_READ, TX_AND_RX});
        tdmae = rq.use_dma && (transfer_mode inside {TX_ONLY, TX_AND_RX});
        `uvm_info("DW_SPI_CFG", $sformatf(
            "derived DMA handshake fields: use_dma=%0b rdmae=%0b tdmae=%0b transfer_mode=%s",
            rq.use_dma, rdmae, tdmae, transfer_mode.name()), UVM_DEBUG)
{% endif %}

        cfg = {{ class_prefix }}configuration::type_id::create("configuration");
        cfg.settings = settings;
        if (!$cast(cfg.host_mode, host_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast configuration host_mode")
        if (!$cast(cfg.transfer_mode, transfer_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast configuration transfer_mode")
        cfg.host_mode.rand_mode(0);
        cfg.transfer_mode.rand_mode(0);
        `uvm_info("DW_SPI_CFG", "randomizing one-shot register configuration", UVM_LOW)
        if (!cfg.randomize() with {
                spi_frf == local::spi_frf;
                spi_ctrlr0_en == local::spi_ctrlr0_en;
                spi_clk_stretch_en == local::spi_clk_stretch_en;
                sste == 1'b0;
                wait_cycles == local::wait_cycles;
                inst_l == local::inst_l;
                addr_l == local::addr_l;
                trans_type == local::trans_type;
                spi_mode == rq.spi_mode;
                data_frame_bits == rq.data_frame_bits;
                completion_mode == local::completion_mode;
                baudr == local::baudr;
                ndf == local::ndf_reg_value;
                interrupt_timeout_ssi_clk_cycles == local::interrupt_timeout_cycles;
                ser == (32'h1 << rq.cs_id);
{% if internal_dma %}
                write_internal_dma_regs == local::write_internal_dma_regs;
                rdmae == local::rdmae;
                tdmae == local::tdmae;
                idmae == local::write_internal_dma_regs;
                ainc == local::write_internal_dma_regs;
                awlen == ({8'h0, rq.awlen} << 8);
                arlen == ({8'h0, rq.arlen} << 8);
                spi_inst == {24'h0, rq.opcode};
                sdar == local::sdar;
                axiar0 == rq.axi_addr;
{% endif %}
{% if external_dma %}
                rdmae == local::rdmae;
                tdmae == local::tdmae;
{% endif %}
            })
            `uvm_fatal("DW_SPI_CFG", "failed to randomize register configuration")
        cfg.host_mode.rand_mode(1);
        cfg.transfer_mode.rand_mode(1);
        `uvm_info("DW_SPI_CFG", $sformatf(
            "register configuration derived: ssi_clk=%0d Hz target_sclk=%0d Hz baudr=%0d dfs_bits=%0d ndf_reg_value=%0d actual_ndf=%0d spi_frf=%0d completion_mode=%s timeout_ssi_cycles=%0d ser=0x%0h",
            ssi_clk_hz,
            settings.target_sclk_hz,
            cfg.baudr,
            cfg.data_frame_bits,
            cfg.ndf,
            actual_ndf,
            cfg.spi_frf,
            cfg.completion_mode.name(),
            cfg.interrupt_timeout_ssi_clk_cycles,
            cfg.ser), UVM_LOW)
    endtask
endclass

`endif
