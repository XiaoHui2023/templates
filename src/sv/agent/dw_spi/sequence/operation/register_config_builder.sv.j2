`ifndef {{ (class_prefix ~ "register_config_builder") | upper }}
`define {{ (class_prefix ~ "register_config_builder") | upper }}

class {{ class_prefix }}register_config_builder extends {{ class_prefix }}base_object;
    `uvm_object_utils({{ class_prefix }}register_config_builder)

    {{ class_prefix }}settings settings;

    // Creates one register-configuration derivation tool.
    function new(string name="{{ class_prefix }}register_config_builder");
        super.new(name);
    endfunction

    // Encodes the requested serial width in CTRLR0.SPI_FRF.
    function int spi_frf_from_speed(int speed_multiplier);
        case (speed_multiplier)
            1: return CTRLR0_SPI_FRF_STANDARD;
            2: return CTRLR0_SPI_FRF_DUAL;
            4: return CTRLR0_SPI_FRF_QUAD;
            default: return CTRLR0_SPI_FRF_STANDARD;
        endcase
    endfunction

    // Encodes the instruction byte count in SPI_CTRLR0.INST_L.
    function int inst_l_from_bytes(int inst_bytes);
        case (inst_bytes)
            0: return 0;
            1: return 2;
            2: return 3;
            default: begin
                `uvm_fatal("DW_SPI_CFG", $sformatf(
                    "unsupported SPI_CTRLR0.INST_L width: inst_bytes=%0d; local encoding supports 0, 1, or 2 bytes",
                    inst_bytes))
                return 0;
            end
        endcase
    endfunction

    // Encodes the address byte count in SPI_CTRLR0.ADDR_L.
    function int addr_l_from_bytes(int addr_bytes);
        if (addr_bytes == 0)
            return 0;
        return addr_bytes * 2;
    endfunction

    // Places an opcode in the internal-DMA instruction register format.
    function bit [15:0] spi_inst_from_opcode(
            bit [7:0] opcode,
            int inst_bytes);
        case (inst_bytes)
            0: return 16'h0000;
            1: return {8'h00, opcode};
            default: begin
                `uvm_fatal("DW_SPI_CFG", $sformatf(
                    "unsupported SPIDR.SPI_INST width: inst_bytes=%0d opcode=0x%02h; current opcode model carries one byte",
                    inst_bytes, opcode))
                return 16'h0000;
            end
        endcase
    endfunction

    // Divides positive integer quantities with upward rounding.
    function longint ceil_div(
            longint dividend,
            longint divisor);
        if (divisor == 0)
            return 0;
        return (dividend + divisor - 1) / divisor;
    endfunction

    // Derives an even BAUDR that does not exceed the target serial clock.
    function int baudr_from_clock(
            longint ssi_clk_hz,
            longint target_sclk_hz);
        longint div;

        if (ssi_clk_hz == 0 || target_sclk_hz == 0)
            return 0;
        div = ceil_div(ssi_clk_hz, target_sclk_hz);
        if (div < 2)
            div = 2;
        if (div[0])
            div++;
        if (div > 65534)
            return 0;
        return int'(div);
    endfunction

    // Converts a byte count into controller data frames.
    function int frame_count_from_bytes(
            int byte_count,
            int data_frame_bits);
        longint bits;
        longint frame_count;

        if (byte_count == 0)
            return 0;
        if (data_frame_bits == 0)
            `uvm_fatal("DW_SPI_CFG", "data_frame_bits must be non-zero to derive frame count for CTRLR1.NDF")
        bits = longint'(byte_count) * 8;
        frame_count = ceil_div(bits, data_frame_bits);
        return int'(frame_count);
    endfunction

    // Returns the payload frame count represented by CTRLR1.NDF.
    function int actual_ndf_from_transfer(
            input {{ class_prefix }}transfer_req rq,
            int payload_bytes);
        return frame_count_from_bytes(payload_bytes, rq.data_frame_bits);
    endfunction

    // Converts phase bits and lane count into serial clock cycles.
    function int phase_sclk_cycles(
            int bits,
            int lanes);
        if (bits == 0)
            return 0;
        if (lanes == 0)
            lanes = 1;
        return int'(ceil_div(bits, lanes));
    endfunction

    // Encodes instruction and address lane usage in SPI_CTRLR0.TRANS_TYPE.
    function int trans_type_from_phase_lanes(
            frame_mode_e frame_mode,
            int instruction_lanes,
            int address_lanes,
            int speed_multiplier,
            int addr_bytes);
        if (frame_mode == STANDARD)
            return 0;
        if (instruction_lanes == 1 && (addr_bytes == 0 || address_lanes == 1))
            return 0;
        if (instruction_lanes == 1 && address_lanes == speed_multiplier)
            return 1;
        if (instruction_lanes == speed_multiplier &&
                (addr_bytes == 0 || address_lanes == speed_multiplier))
            return 2;
        `uvm_fatal("DW_SPI_CFG", $sformatf(
            "unsupported enhanced phase lanes: instruction_lanes=%0d address_lanes=%0d speed_multiplier=%0d addr_bytes=%0d",
            instruction_lanes,
            address_lanes,
            speed_multiplier,
            addr_bytes))
        return 0;
    endfunction

    // Derives a bounded completion timeout from the complete serial transfer.
    function int transfer_timeout_cycles(
            input {{ class_prefix }}transfer_req rq,
            int baudr,
            int data_bytes,
            frame_mode_e frame_mode);
        longint inst_cycles;
        longint addr_cycles;
        longint data_cycles;
        longint serial_cycles;
        longint base_cycles;
        longint fifo_chunks;
        longint fifo_cycles;
        longint margin_cycles;
        longint timeout_cycles;
        int data_width;
        int inst_width;
        int addr_width;

        data_width = frame_mode == ENHANCED ? rq.speed_multiplier : 1;
        inst_width = frame_mode == ENHANCED ? rq.instruction_lanes : 1;
        addr_width = frame_mode == ENHANCED ? rq.address_lanes : 1;
        inst_cycles = phase_sclk_cycles(rq.inst_bytes * 8, inst_width);
        addr_cycles = phase_sclk_cycles(rq.addr_bytes * 8, addr_width);
        data_cycles = phase_sclk_cycles(data_bytes * 8, data_width);
        serial_cycles = inst_cycles + addr_cycles + rq.dummy_cycles + data_cycles;
        if (serial_cycles == 0)
            serial_cycles = 1;
        base_cycles = serial_cycles * baudr;
        fifo_chunks = ceil_div(data_bytes == 0 ? 1 : data_bytes, settings.fifo_depth_bytes);
        fifo_cycles = fifo_chunks * baudr;
        margin_cycles = ((base_cycles + fifo_cycles) * settings.interrupt_timeout_margin_percent + 99) / 100;
        timeout_cycles = base_cycles + fifo_cycles + margin_cycles + settings.interrupt_timeout_extra_ssi_clk_cycles;
        if (timeout_cycles > 32'hffff_ffff)
            return 32'hffff_ffff;
        `uvm_info("DW_SPI_CFG", $sformatf(
            "interrupt timeout detail: inst_sclk=%0d addr_sclk=%0d dummy_sclk=%0d data_sclk=%0d serial_sclk=%0d baudr=%0d base_ssi=%0d fifo_chunks=%0d fifo_ssi=%0d margin_percent=%0d margin_ssi=%0d extra_ssi=%0d timeout_ssi=%0d",
            inst_cycles,
            addr_cycles,
            rq.dummy_cycles,
            data_cycles,
            serial_cycles,
            baudr,
            base_cycles,
            fifo_chunks,
            fifo_cycles,
            settings.interrupt_timeout_margin_percent,
            margin_cycles,
            settings.interrupt_timeout_extra_ssi_clk_cycles,
            timeout_cycles), UVM_DEBUG)
        return timeout_cycles;
    endfunction

    // Builds the one-shot register configuration for a transfer request.
    task build(
            input {{ class_prefix }}transfer_req rq,
            output {{ class_prefix }}configuration cfg);
        int length;
        int actual_ndf;
        int spi_frf;
        int baudr;
        int inst_l;
        int addr_l;
        int trans_type;
        int ndf_reg_value;
        bit spi_ctrlr0_en;
        bit spi_clk_stretch_en;
        int wait_cycles;
        int interrupt_timeout_cycles;
        longint ssi_clk_hz;
        bit [15:0] spi_inst;
        bit [63:0] flash_addr;
        bit [31:0] sdar;
        host_mode_e host_mode;
        frame_mode_e frame_mode;
        transfer_mode_e transfer_mode;
        completion_mode_e completion_mode;
{%- if internal_dma %}
        bit write_internal_dma_regs;
{%- endif %}
{%- if internal_dma or external_dma %}
        bit rdmae;
        bit tdmae;
{%- endif %}

        if (settings == null)
            `uvm_fatal("DW_SPI_CFG", "settings is null")
        if (rq == null)
            `uvm_fatal("DW_SPI_CFG", "transfer req is null")
        if (rq.payload == null)
            `uvm_fatal("DW_SPI_CFG", "transfer req payload is null")
        if (!$cast(host_mode, rq.host_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast host_mode")
        if (!$cast(frame_mode, rq.frame_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast frame_mode")
        if (!$cast(transfer_mode, rq.transfer_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast transfer_mode")
        if (!$cast(completion_mode, settings.default_completion_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast settings.default_completion_mode")
        if (settings.vif == null)
            `uvm_fatal("DW_SPI_CFG", "settings.vif is null; BAUDR requires measured ssi_clk")
        if (!settings.vif.has_ssi_clk())
            `uvm_fatal("DW_SPI_CFG", "ssi_clk must be connected to derive BAUDR")

        `uvm_info("DW_SPI_CFG", "measuring ssi_clk before deriving BAUDR", UVM_DEBUG)
        settings.vif.ssi_clk_if.measure_frequency_hz(
            ssi_clk_hz,
            settings.min_ssi_clk_hz,
            settings.clock_check_tolerance_ppm);
        `uvm_info("DW_SPI_CFG", $sformatf(
            "measured ssi_clk: hz=%0d min_hz=%0d tolerance_ppm=%0d target_sclk_hz=%0d",
            ssi_clk_hz,
            settings.min_ssi_clk_hz,
            settings.clock_check_tolerance_ppm,
            settings.target_sclk_hz), UVM_DEBUG)
        baudr = baudr_from_clock(ssi_clk_hz, settings.target_sclk_hz);
        if (baudr == 0)
            `uvm_fatal("DW_SPI_CFG", $sformatf(
                "failed to derive BAUDR: ssi_clk_hz=%0d target_sclk_hz=%0d",
                ssi_clk_hz,
                settings.target_sclk_hz))
        length = rq.payload.get_data_length();
        actual_ndf = actual_ndf_from_transfer(rq, length);
        spi_frf = spi_frf_from_speed(rq.speed_multiplier);
        inst_l = inst_l_from_bytes(rq.inst_bytes);
        addr_l = addr_l_from_bytes(rq.addr_bytes);
        trans_type = trans_type_from_phase_lanes(
            frame_mode,
            rq.instruction_lanes,
            rq.address_lanes,
            rq.speed_multiplier,
            rq.addr_bytes);
        spi_ctrlr0_en = frame_mode == ENHANCED;
        spi_clk_stretch_en = spi_ctrlr0_en;
        spi_inst = '0;
        sdar = '0;
        if (spi_ctrlr0_en{% if internal_dma %} || rq.use_dma{% endif %}) begin
            spi_inst = spi_inst_from_opcode(rq.opcode, rq.inst_bytes);
            flash_addr = rq.payload.get_address();
            sdar = flash_addr[31:0];
        end
        wait_cycles = (spi_ctrlr0_en && (transfer_mode inside {RX_ONLY, EEPROM_READ, TX_AND_RX})) ? rq.dummy_cycles : 0;
        ndf_reg_value = actual_ndf == 0 ? 0 : actual_ndf - 1;
        if (ndf_reg_value > settings.ctrlr1_ndf_max)
            `uvm_fatal("DW_SPI_CFG", $sformatf(
                "CTRLR1.NDF exceeds configured register limit: ndf_reg_value=%0d actual_data_frames=%0d ctrlr1_ndf_max=%0d payload_bytes=%0d data_frame_bits=%0d",
                ndf_reg_value,
                actual_ndf,
                settings.ctrlr1_ndf_max,
                length,
                rq.data_frame_bits))
        interrupt_timeout_cycles = transfer_timeout_cycles(
            rq, baudr, length, frame_mode);
        `uvm_info("DW_SPI_CFG", $sformatf(
            "derived transfer fields: inst_bytes=%0d addr_bytes=%0d instruction_lanes=%0d address_lanes=%0d dummy_cycles=%0d payload_bytes=%0d data_frame_bits=%0d actual_data_frames=%0d ndf_reg_value=%0d spi_frf=%0d inst_l=%0d addr_l=%0d trans_type=%0d spi_ctrlr0_en=%0b spi_inst=0x%04h sdar=0x%08h spi_clk_stretch_en=%0b wait_cycles=%0d interrupt_timeout_cycles=%0d",
            rq.inst_bytes,
            rq.addr_bytes,
            rq.instruction_lanes,
            rq.address_lanes,
            rq.dummy_cycles,
            length,
            rq.data_frame_bits,
            actual_ndf,
            ndf_reg_value,
            spi_frf,
            inst_l,
            addr_l,
            trans_type,
            spi_ctrlr0_en,
            spi_inst,
            sdar,
            spi_clk_stretch_en,
            wait_cycles,
            interrupt_timeout_cycles), UVM_DEBUG)
{%- if internal_dma %}
        write_internal_dma_regs = rq.use_dma;
        `uvm_info("DW_SPI_CFG", $sformatf(
            "derived internal DMA fields: use_dma=%0b axi_addr=0x%08h awlen_field=0x%0h arlen_field=0x%0h",
            rq.use_dma,
            rq.axi_addr,
            rq.awlen,
            rq.arlen), UVM_DEBUG)
{%- endif %}
{%- if internal_dma or external_dma %}
        rdmae = rq.use_dma && (transfer_mode inside {RX_ONLY, EEPROM_READ, TX_AND_RX});
{%- if external_dma %}
        tdmae = rq.use_dma && ((transfer_mode inside {TX_ONLY, TX_AND_RX}) ||
            (rq.protocol == FLASH_SPI && rq.inst_bytes > 0));
{%- else %}
        tdmae = rq.use_dma && (transfer_mode inside {TX_ONLY, TX_AND_RX});
{%- endif %}
        `uvm_info("DW_SPI_CFG", $sformatf(
            "derived DMA handshake fields: use_dma=%0b rdmae=%0b tdmae=%0b transfer_mode=%s",
            rq.use_dma, rdmae, tdmae, transfer_mode.name()), UVM_DEBUG)
{%- endif %}

        cfg = {{ class_prefix }}configuration::type_id::create("configuration");
        cfg.settings = settings;
        if (!$cast(cfg.host_mode, host_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast configuration host_mode")
        if (!$cast(cfg.transfer_mode, transfer_mode))
            `uvm_fatal("DW_SPI_CFG", "failed to cast configuration transfer_mode")
        cfg.host_mode.rand_mode(0);
        cfg.transfer_mode.rand_mode(0);
        `uvm_info("DW_SPI_CFG", "randomizing one-shot register configuration", UVM_DEBUG)
        if (!cfg.randomize() with {
                spi_frf == local::spi_frf;
                spi_ctrlr0_en == local::spi_ctrlr0_en;
                spi_clk_stretch_en == local::spi_clk_stretch_en;
                sste == 1'b0;
                wait_cycles == local::wait_cycles;
                inst_l == local::inst_l;
                addr_l == local::addr_l;
                trans_type == local::trans_type;
                spi_inst == local::spi_inst;
                sdar == local::sdar;
                spi_mode == rq.spi_mode;
                data_frame_bits == rq.data_frame_bits;
                actual_data_frames == local::actual_ndf;
                completion_mode == local::completion_mode;
{%- if internal_dma or external_dma %}
                baudr == (rq.use_dma ? (local::baudr >> 1) : local::baudr);
{%- else %}
                baudr == local::baudr;
{%- endif %}
                ndf == local::ndf_reg_value;
                interrupt_timeout_ssi_clk_cycles == local::interrupt_timeout_cycles;
                ser == (32'h1 << rq.cs_id);
{%- if internal_dma %}
                write_internal_dma_regs == local::write_internal_dma_regs;
                rdmae == local::rdmae;
                tdmae == local::tdmae;
                idmae == local::write_internal_dma_regs;
                ainc == local::write_internal_dma_regs;
                awlen == rq.awlen;
                arlen == rq.arlen;
                axiar0 == rq.axi_addr;
{%- endif %}
{%- if external_dma %}
                rdmae == local::rdmae;
                tdmae == local::tdmae;
{%- endif %}
            })
            `uvm_fatal("DW_SPI_CFG", "failed to randomize register configuration")
        cfg.host_mode.rand_mode(1);
        cfg.transfer_mode.rand_mode(1);
        `uvm_info("DW_SPI_CFG", $sformatf(
            "register configuration derived: opcode=0x%02h address=0x%0h payload_bytes=%0d inst_bytes=%0d addr_bytes=%0d instruction_lanes=%0d address_lanes=%0d dummy_cycles=%0d ssi_clk=%0d Hz target_sclk=%0d Hz logical_baudr=%0d sckdv=%0d dfs_bits=%0d ndf_reg_value=%0d actual_data_frames=%0d spi_frf=%0d trans_type=%0d completion_mode=%s timeout_ssi_cycles=%0d ser=0x%0h",
            rq.opcode,
            rq.payload.get_address(),
            length,
            rq.inst_bytes,
            rq.addr_bytes,
            rq.instruction_lanes,
            rq.address_lanes,
            rq.dummy_cycles,
            ssi_clk_hz,
            settings.target_sclk_hz,
            baudr,
            cfg.baudr,
            cfg.data_frame_bits,
            cfg.ndf,
            actual_ndf,
            cfg.spi_frf,
            cfg.trans_type,
            cfg.completion_mode.name(),
            cfg.interrupt_timeout_ssi_clk_cycles,
            cfg.ser), UVM_DEBUG)
    endtask
endclass

`endif
