        soft check_ssi_clk == 1'b1;
        soft tolerance_ppm == {{ clock_check_tolerance_ppm }};
        soft min_hclk_hz == {{ min_hclk_hz }};
        soft min_ssi_clk_hz == {{ min_ssi_clk_hz }};
