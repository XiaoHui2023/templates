`ifndef {{ (class_prefix ~ "check_clock_seq") | upper }}
`define {{ (class_prefix ~ "check_clock_seq") | upper }}

class {{ class_prefix }}check_clock_seq extends uvm_sequence #(
    {{ class_prefix }}check_clock_req,
    {{ class_prefix }}check_clock_rsp
);
    `uvm_object_utils({{ class_prefix }}check_clock_seq)
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    localparam longint unsigned PPM_SCALE = 1000000;

    function new(string name="{{ class_prefix }}check_clock_seq");
        super.new(name);
    endfunction

    extern virtual task body();
    extern function bit in_range(
        longint unsigned value_hz,
        longint unsigned min_hz,
        longint unsigned max_hz,
        int unsigned tolerance_ppm,
        string label);
    extern function longint unsigned ceil_div(
        longint unsigned dividend,
        longint unsigned divisor);
endclass

function longint unsigned {{ class_prefix }}check_clock_seq::ceil_div(
        longint unsigned dividend,
        longint unsigned divisor);
    if (divisor == 0)
        return 0;
    return (dividend + divisor - 1) / divisor;
endfunction

function bit {{ class_prefix }}check_clock_seq::in_range(
        longint unsigned value_hz,
        longint unsigned min_hz,
        longint unsigned max_hz,
        int unsigned tolerance_ppm,
        string label);
    longint unsigned min_allowed_hz;
    longint unsigned max_allowed_hz;

    if (value_hz == 0) begin
        `uvm_error("DW_SPI_CLK", {label, " frequency is not measurable"})
        return 1'b0;
    end
    if (tolerance_ppm > PPM_SCALE) begin
        `uvm_error("DW_SPI_CLK", $sformatf(
            "%s tolerance_ppm %0d exceeds %0d",
            label,
            tolerance_ppm,
            PPM_SCALE))
        return 1'b0;
    end
    min_allowed_hz = (min_hz * (PPM_SCALE - tolerance_ppm)) / PPM_SCALE;
    max_allowed_hz = ceil_div(max_hz * (PPM_SCALE + tolerance_ppm), PPM_SCALE);
    if (min_hz > 0 && value_hz < min_allowed_hz) begin
        `uvm_error("DW_SPI_CLK", $sformatf(
            "%s frequency %0d Hz is below %0d Hz with tolerance",
            label,
            value_hz,
            min_hz))
        return 1'b0;
    end
    if (max_hz > 0 && value_hz > max_allowed_hz) begin
        `uvm_error("DW_SPI_CLK", $sformatf(
            "%s frequency %0d Hz is above %0d Hz with tolerance",
            label,
            value_hz,
            max_hz))
        return 1'b0;
    end
    return 1'b1;
endfunction

task {{ class_prefix }}check_clock_seq::body();
    {{ class_prefix }}check_clock_req rq;
    {{ class_prefix }}check_clock_rsp rs;
    longint unsigned max_allowed_sclk_out_hz;

    if (req == null)
        rq = {{ class_prefix }}check_clock_req::type_id::create("req");
    else
        rq = req;
    rs = {{ class_prefix }}check_clock_rsp::type_id::create("rsp");
    if (p_sequencer.settings.vif == null)
        `uvm_fatal("DW_SPI_CLK", "check_clock requires virtual dw_spi_interface in sequencer settings")

    rs.hclk_connected = p_sequencer.settings.vif.has_hclk();
    rs.ssi_clk_connected = p_sequencer.settings.vif.has_ssi_clk();

    if (rq.check_hclk && rs.hclk_connected) begin
        p_sequencer.settings.vif.hclk_if.measure_frequency_hz(
            rs.hclk_hz, rq.min_hclk_hz, rq.tolerance_ppm);
        if (rq.check_hclk)
            rs.ok &= in_range(rs.hclk_hz, rq.min_hclk_hz, 0, rq.tolerance_ppm, "hclk");
    end

    if ((rq.check_ssi_clk || rq.check_sclk_out) && rs.ssi_clk_connected) begin
        p_sequencer.settings.vif.ssi_clk_if.measure_frequency_hz(
            rs.ssi_clk_hz, rq.min_ssi_clk_hz, rq.tolerance_ppm);
        if (rq.check_ssi_clk)
            rs.ok &= in_range(rs.ssi_clk_hz, rq.min_ssi_clk_hz, 0, rq.tolerance_ppm, "ssi_clk");
    end

    if (rq.check_sclk_out && rs.ssi_clk_connected && rs.ssi_clk_hz > 0) begin
        rs.sclk_out_hz = ceil_div(rs.ssi_clk_hz, p_sequencer.settings.default_baud_div);
        rs.recommended_baudr = p_sequencer.settings.vif.baudr_for_target(
            rs.ssi_clk_hz, p_sequencer.settings.max_output_hz);
        max_allowed_sclk_out_hz = ceil_div(
            rq.max_sclk_out_hz * (PPM_SCALE + rq.tolerance_ppm),
            PPM_SCALE);
        if (rq.max_sclk_out_hz > 0 && rs.sclk_out_hz > max_allowed_sclk_out_hz) begin
            `uvm_error("DW_SPI_CLK", $sformatf(
                "sclk_out %0d Hz exceeds max_output_hz %0d Hz with tolerance; sclk_out = ssi_clk/default_baud_div",
                rs.sclk_out_hz,
                rq.max_sclk_out_hz))
            rs.ok = 1'b0;
        end
    end

    rsp = rs;
endtask

`endif
