`ifndef {{ (class_prefix ~ "check_clock_seq") | upper }}
`define {{ (class_prefix ~ "check_clock_seq") | upper }}

class {{ class_prefix }}check_clock_seq extends {{ class_prefix }}base_seq #(
    {{ class_prefix }}check_clock_req,
    {{ class_prefix }}check_clock_rsp
);
    `uvm_object_utils({{ class_prefix }}check_clock_seq)
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    localparam longint PPM_SCALE = 1000000;

    function new(string name="{{ class_prefix }}check_clock_seq");
        super.new(name);
    endfunction

    extern virtual task body();
    extern function bit above_min_frequency(
        longint value_hz,
        longint min_hz,
        int tolerance_ppm,
        string label);
endclass

function bit {{ class_prefix }}check_clock_seq::above_min_frequency(
        longint value_hz,
        longint min_hz,
        int tolerance_ppm,
        string label);
    longint min_allowed_hz;

    if (value_hz == 0) begin
        `uvm_error("DW_SPI_CLK", {label, " frequency is not measurable"})
        return 1'b0;
    end
    if (tolerance_ppm > PPM_SCALE) begin
        `uvm_error("DW_SPI_CLK", $sformatf(
            "%s tolerance_ppm %0d exceeds %0d",
            label,
            tolerance_ppm,
            PPM_SCALE))
        return 1'b0;
    end
    min_allowed_hz = (min_hz * (PPM_SCALE - tolerance_ppm)) / PPM_SCALE;
    if (value_hz < min_allowed_hz) begin
        `uvm_error("DW_SPI_CLK", $sformatf(
            "%s frequency %0d Hz is below %0d Hz with tolerance",
            label,
            value_hz,
            min_hz))
        return 1'b0;
    end
    return 1'b1;
endfunction

task {{ class_prefix }}check_clock_seq::body();
    {{ class_prefix }}check_clock_req rq;
    {{ class_prefix }}check_clock_rsp rs;

    if (req == null)
        rq = {{ class_prefix }}check_clock_req::type_id::create("req");
    else
        rq = req;
    rs = {{ class_prefix }}check_clock_rsp::type_id::create("rsp");
    if (p_sequencer.settings.vif == null)
        `uvm_fatal("DW_SPI_CLK", "check_clock requires virtual dw_spi_interface in sequencer settings")

    rs.hclk_connected = p_sequencer.settings.vif.has_hclk();
    rs.ssi_clk_connected = p_sequencer.settings.vif.has_ssi_clk();
    `uvm_info("DW_SPI_CLK", $sformatf(
        "check_clock start: check_hclk=%0b hclk_connected=%0b check_ssi_clk=%0b ssi_clk_connected=%0b",
        rq.check_hclk,
        rs.hclk_connected,
        rq.check_ssi_clk,
        rs.ssi_clk_connected), UVM_LOW)

    if (rq.check_hclk && rs.hclk_connected) begin
        `uvm_info("DW_SPI_CLK", "measuring hclk frequency", UVM_LOW)
        `uvm_info("DW_SPI_CLK", $sformatf(
            "hclk measurement detail: min_hz=%0d tolerance_ppm=%0d",
            rq.min_hclk_hz, rq.tolerance_ppm), UVM_DEBUG)
        p_sequencer.settings.vif.hclk_if.measure_frequency_hz(
            rs.hclk_hz, rq.min_hclk_hz, rq.tolerance_ppm);
        rs.ok &= above_min_frequency(rs.hclk_hz, rq.min_hclk_hz, rq.tolerance_ppm, "hclk");
        if (rs.ok)
            `uvm_info("DW_SPI_CLK", $sformatf(
                "hclk check passed: measured=%0d Hz min=%0d Hz tolerance_ppm=%0d",
                rs.hclk_hz, rq.min_hclk_hz, rq.tolerance_ppm), UVM_LOW)
    end else if (rq.check_hclk) begin
        `uvm_info("DW_SPI_CLK", "hclk check skipped: hclk is not connected", UVM_LOW)
    end

    if (rq.check_ssi_clk && rs.ssi_clk_connected) begin
        `uvm_info("DW_SPI_CLK", "measuring ssi_clk frequency", UVM_LOW)
        `uvm_info("DW_SPI_CLK", $sformatf(
            "ssi_clk measurement detail: min_hz=%0d tolerance_ppm=%0d",
            rq.min_ssi_clk_hz, rq.tolerance_ppm), UVM_DEBUG)
        p_sequencer.settings.vif.ssi_clk_if.measure_frequency_hz(
            rs.ssi_clk_hz, rq.min_ssi_clk_hz, rq.tolerance_ppm);
        rs.ok &= above_min_frequency(rs.ssi_clk_hz, rq.min_ssi_clk_hz, rq.tolerance_ppm, "ssi_clk");
        if (rs.ok)
            `uvm_info("DW_SPI_CLK", $sformatf(
                "ssi_clk check passed: measured=%0d Hz min=%0d Hz tolerance_ppm=%0d",
                rs.ssi_clk_hz, rq.min_ssi_clk_hz, rq.tolerance_ppm), UVM_LOW)
    end else if (rq.check_ssi_clk) begin
        `uvm_info("DW_SPI_CLK", "ssi_clk check skipped: ssi_clk is not connected", UVM_LOW)
    end

    rsp = rs;
    `uvm_info("DW_SPI_CLK", $sformatf("check_clock done: ok=%0b", rs.ok), UVM_LOW)
endtask

`endif
