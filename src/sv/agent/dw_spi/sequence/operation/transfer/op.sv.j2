`ifndef {{ (class_prefix ~ "transfer_seq") | upper }}
`define {{ (class_prefix ~ "transfer_seq") | upper }}

class {{ class_prefix }}transfer_seq extends {{ class_prefix }}base_seq #(
    {{ class_prefix }}transfer_req,
    {{ class_prefix }}transfer_rsp
);
    `uvm_object_utils({{ class_prefix }}transfer_seq)
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    // Creates one primitive controller transfer sequence.
    function new(string name="{{ class_prefix }}transfer_seq");
        super.new(name);
    endfunction

    // Executes controller setup, data movement, completion, and scoreboarding.
    extern virtual task body();
    // Formats a bounded byte queue preview for diagnostics.
    extern protected function string byte_queue_preview(
        bit [7:0] data[$],
        int max_bytes);
    // Builds controller TX items; enhanced dummy cycles stay in SPI_CTRLR0.
    extern protected function void build_tx_items(
        input {{ class_prefix }}transfer_req rq,
        input bit include_payload,
        output bit [31:0] dr0_items[$]);
    // Reports whether this transfer may use the local internal-DMA done interrupt.
    extern protected function bit can_use_internal_dma_done_interrupt(
        {{ class_prefix }}transfer_req rq);
    // Reports whether a WRITE transfer updates the flash memory mirror.
    extern protected function bit should_record_expected_write(
        {{ class_prefix }}transfer_req rq,
        uvm_tlm_command_e command);
    // Waits for the top interrupt associated with a known completion source.
    extern protected task wait_transfer_interrupt(
        {{ class_prefix }}transfer_req rq,
        {{ class_prefix }}configuration cfg,
        string expected_source);
    // Waits for the completion source valid for the selected transfer path.
    extern protected task wait_transfer_completion(
        input {{ class_prefix }}transfer_req rq,
        input {{ class_prefix }}configuration cfg,
        input {{ class_prefix }}register_access register_access,
        output bit ok);
    // Starts the configured hardware or software chip-select window.
    extern protected task activate_transfer_cs(
        input {{ class_prefix }}transfer_req rq,
        input {{ class_prefix }}configuration cfg,
        input {{ class_prefix }}register_access register_access,
        output bit cs_started);
    // Closes the configured hardware or software chip-select window.
    extern protected task release_transfer_cs(
        input {{ class_prefix }}transfer_req rq,
        input {{ class_prefix }}register_access register_access,
        input bit cs_started);
    // Refills the transmit FIFO while preserving one chip-select window.
    extern protected task write_pio_stream_under_cs(
        input {{ class_prefix }}transfer_req rq,
        input {{ class_prefix }}configuration cfg,
        input {{ class_prefix }}register_access register_access,
        input bit [31:0] dr0_items[$],
        output bit cs_started,
        output bit ok);
{%- if external_dma %}
    // Prefills external-DMA read control items until the transmit start threshold is met.
    extern protected task prefill_external_dma_read_control(
        input {{ class_prefix }}transfer_req rq,
        input {{ class_prefix }}configuration cfg,
        input {{ class_prefix }}register_access register_access,
        output bit ok);
{%- endif %}
{%- if internal_dma %}
    // Writes write payload or read control items into the internal-DMA AXI source buffer.
    extern protected task cpu_write_dma_source_to_axi(
        input {{ class_prefix }}transfer_req rq,
        output bit ok);
    // Reads the internal-DMA AXI destination buffer into a byte queue.
    extern protected task cpu_read_payload_from_axi(
        input bit [31:0] axi_addr,
        input int length,
        output bit [7:0] read_data[$],
        output bit ok);
{%- endif %}
endclass

task {{ class_prefix }}transfer_seq::body();
    {{ class_prefix }}transfer_req rq;
    {{ class_prefix }}transfer_rsp rs;
    {{ class_prefix }}configuration cfg;
    {{ class_prefix }}register_config_builder config_builder;
    {{ class_prefix }}register_access register_access;
    uvm_tlm_command_e command;
    bit pio_ok;
    bit dma_ok;
    bit completion_ok;
    bit cs_started;
    bit record_write_expected;
    bit [7:0] write_data[$];
    bit [31:0] pio_dr0_items[$];
    string write_reason;
    byte unsigned gp_data[];

    if (req == null)
        `uvm_fatal("DW_SPI", "transfer: req is null")
    if (req.payload == null)
        `uvm_fatal("DW_SPI", "transfer: req.payload is null")
    if (p_sequencer.scoreboard == null)
        `uvm_fatal("DW_SPI", "transfer: sequencer scoreboard is null")
    rq = req;
    command = rq.payload.get_command();
    cs_started = 1'b0;
    record_write_expected = 1'b0;
    write_reason = "";
    rs = {{ class_prefix }}transfer_rsp::type_id::create("rsp");
    `uvm_info("DW_SPI_XFER", $sformatf(
        "transfer start: protocol=%s mode=%s frame=%s cs_mode=%s opcode=0x%02h address=0x%0h payload_bytes=%0d inst_bytes=%0d addr_bytes=%0d instruction_lanes=%0d address_lanes=%0d dummy_cycles=%0d cs=%0d lanes=%0d speed=%0dx dfs_bits=%0d{% if internal_dma or external_dma %} use_dma=%0b{% endif %}",
        rq.protocol.name(),
        rq.transfer_mode.name(),
        rq.frame_mode.name(),
        rq.cs_control_mode.name(),
        rq.opcode,
        rq.payload.get_address(),
        rq.payload.get_data_length(),
        rq.inst_bytes,
        rq.addr_bytes,
        rq.instruction_lanes,
        rq.address_lanes,
        rq.dummy_cycles,
        rq.cs_id,
        rq.io_lanes,
        rq.speed_multiplier,
        rq.data_frame_bits{% if internal_dma or external_dma %},
        rq.use_dma{% endif %}), UVM_DEBUG)
    config_builder = {{ class_prefix }}register_config_builder::type_id::create("config_builder");
    config_builder.settings = p_sequencer.settings;
    `uvm_info("DW_SPI_XFER", "building register configuration for transfer", UVM_DEBUG)
    config_builder.build(rq, cfg);
{%- if internal_dma %}
    if (rq.use_dma && command inside {UVM_TLM_WRITE_COMMAND, UVM_TLM_READ_COMMAND}) begin
        `uvm_info("DW_SPI_XFER", $sformatf(
            "preparing internal DMA source buffer before controller start: command=%s axi_addr=0x%08h payload_bytes=%0d awlen=%0d arlen=%0d",
            command.name(), rq.axi_addr, rq.payload.get_data_length(), rq.awlen, rq.arlen), UVM_HIGH)
        cpu_write_dma_source_to_axi(rq, dma_ok);
        if (!dma_ok) begin
            rs.ok = 1'b0;
            `uvm_error("DW_SPI_XFER", $sformatf(
                "internal DMA source preparation failed: opcode=0x%02h command=%s axi_addr=0x%08h payload_bytes=%0d",
                rq.opcode, command.name(), rq.axi_addr, rq.payload.get_data_length()))
            `uvm_info("DW_SPI_XFER", "internal DMA source buffer preparation failed", UVM_HIGH)
            rsp = rs;
            return;
        end
    end
{%- elif external_dma %}
    if (rq.use_dma) begin
        dma_ok = 1'b1;
        `uvm_info("DW_SPI_XFER", "arming external DMA before controller start", UVM_HIGH)
        p_sequencer.start_external_dma(rq);
    end
{%- endif %}
    register_access = {{ class_prefix }}register_access::type_id::create("register_access");
    register_access.settings = p_sequencer.settings;
    register_access.report_context = p_sequencer;
    `uvm_info("DW_SPI_XFER", "applying controller register configuration", UVM_DEBUG)
    register_access.apply_configuration(cfg);
    `uvm_info("DW_SPI_XFER", "controller configured with SER released; transfer sequence will select CS at the transaction boundary", UVM_DEBUG)
{%- if internal_dma %}
    if (rq.use_dma) begin
        dma_ok = 1'b1;
        if (dma_ok) begin
            `uvm_info("DW_SPI_XFER", "internal DMA transfer armed; selecting CS before waiting for configured completion", UVM_HIGH)
            activate_transfer_cs(rq, cfg, register_access, cs_started);
        end
    end
    else begin
        pio_ok = 1'b1;
        if (command inside {UVM_TLM_WRITE_COMMAND, UVM_TLM_READ_COMMAND}) begin
            build_tx_items(
                rq, command == UVM_TLM_WRITE_COMMAND, pio_dr0_items);
            `uvm_info("DW_SPI_XFER", $sformatf(
                "PIO path: writing control/write-data stream to DR0: opcode=0x%02h address=0x%0h payload_bytes=%0d configured_dummy_cycles=%0d dr0_items=%0d",
                rq.opcode, rq.payload.get_address(), rq.payload.get_data_length(),
                rq.dummy_cycles, pio_dr0_items.size()), UVM_HIGH)
            write_pio_stream_under_cs(
                rq, cfg, register_access, pio_dr0_items, cs_started, pio_ok);
        end
    end
{%- elif external_dma %}
    if (rq.use_dma) begin
        if (command == UVM_TLM_READ_COMMAND)
            prefill_external_dma_read_control(rq, cfg, register_access, dma_ok);
        if (dma_ok) begin
            `uvm_info("DW_SPI_XFER", "external DMA armed; selecting CS before waiting for completion", UVM_HIGH)
            activate_transfer_cs(rq, cfg, register_access, cs_started);
        end
    end
    else begin
        pio_ok = 1'b1;
        if (command inside {UVM_TLM_WRITE_COMMAND, UVM_TLM_READ_COMMAND}) begin
            build_tx_items(
                rq, command == UVM_TLM_WRITE_COMMAND, pio_dr0_items);
            `uvm_info("DW_SPI_XFER", $sformatf(
                "PIO path: writing control/write-data stream to DR0: opcode=0x%02h address=0x%0h payload_bytes=%0d configured_dummy_cycles=%0d dr0_items=%0d",
                rq.opcode, rq.payload.get_address(), rq.payload.get_data_length(),
                rq.dummy_cycles, pio_dr0_items.size()), UVM_HIGH)
            write_pio_stream_under_cs(
                rq, cfg, register_access, pio_dr0_items, cs_started, pio_ok);
        end
    end
{%- else %}
    pio_ok = 1'b1;
    if (command inside {UVM_TLM_WRITE_COMMAND, UVM_TLM_READ_COMMAND}) begin
        build_tx_items(
            rq, command == UVM_TLM_WRITE_COMMAND, pio_dr0_items);
        `uvm_info("DW_SPI_XFER", $sformatf(
            "PIO path: writing control/write-data stream to DR0: opcode=0x%02h address=0x%0h payload_bytes=%0d configured_dummy_cycles=%0d dr0_items=%0d",
            rq.opcode, rq.payload.get_address(), rq.payload.get_data_length(),
            rq.dummy_cycles, pio_dr0_items.size()), UVM_HIGH)
        write_pio_stream_under_cs(
            rq, cfg, register_access, pio_dr0_items, cs_started, pio_ok);
    end
{%- endif %}
{%- if internal_dma %}
    if (rq.use_dma) begin
        if (dma_ok) begin
            wait_transfer_completion(rq, cfg, register_access, completion_ok);
            dma_ok = dma_ok && completion_ok;
        end
        release_transfer_cs(rq, register_access, cs_started);
        if (dma_ok && command == UVM_TLM_READ_COMMAND) begin
            `uvm_info("DW_SPI_XFER", "internal DMA read path: reading destination buffer through CPU callback", UVM_HIGH)
            cpu_read_payload_from_axi(
                rq.axi_addr, rq.payload.get_data_length(), rs.read_data, dma_ok);
        end
        if (dma_ok && command == UVM_TLM_WRITE_COMMAND) begin
            if (should_record_expected_write(rq, command)) begin
                `uvm_info("DW_SPI_XFER", "internal DMA write path: staging expected payload for scoreboard", UVM_HIGH)
                rq.payload.get_data(gp_data);
                foreach (gp_data[i])
                    write_data.push_back(gp_data[i]);
                record_write_expected = 1'b1;
                write_reason = "internal_dma_write";
            end
            else begin
                `uvm_info("DW_SPI_XFER", $sformatf(
                    "internal DMA write path does not update flash memory mirror: opcode=0x%02h",
                    rq.opcode), UVM_HIGH)
            end
        end
        rs.ok = dma_ok;
    end
    else begin
        if (pio_ok && command == UVM_TLM_READ_COMMAND) begin
            `uvm_info("DW_SPI_XFER", $sformatf(
                "PIO read path: reading payload from DR0: expected_bytes=%0d",
                rq.payload.get_data_length()), UVM_HIGH)
            register_access.read_dr0_to_payload(rq.payload, rs.read_data, pio_ok);
            `uvm_info("DW_SPI_XFER", $sformatf(
                "PIO read path received data: bytes=%0d data_preview=%s",
                rs.read_data.size(), byte_queue_preview(rs.read_data, 16)), UVM_HIGH)
        end
        if (pio_ok) begin
            wait_transfer_completion(rq, cfg, register_access, completion_ok);
            pio_ok = pio_ok && completion_ok;
        end
        release_transfer_cs(rq, register_access, cs_started);
        if (pio_ok && command == UVM_TLM_WRITE_COMMAND) begin
            if (should_record_expected_write(rq, command)) begin
                `uvm_info("DW_SPI_XFER", "PIO write path: staging expected payload for scoreboard", UVM_DEBUG)
                rq.payload.get_data(gp_data);
                foreach (gp_data[i])
                    write_data.push_back(gp_data[i]);
                record_write_expected = 1'b1;
                write_reason = "pio_write";
            end
            else begin
                `uvm_info("DW_SPI_XFER", $sformatf(
                    "PIO write path does not update flash memory mirror: opcode=0x%02h",
                    rq.opcode), UVM_HIGH)
            end
        end
        rs.ok = pio_ok;
    end
{%- elif external_dma %}
    if (rq.use_dma) begin
        if (dma_ok) begin
            wait_transfer_completion(rq, cfg, register_access, completion_ok);
            dma_ok = dma_ok && completion_ok;
        end
        if (dma_ok) begin
            `uvm_info("DW_SPI_XFER", "waiting for external DMA completion and collecting read data", UVM_HIGH)
            p_sequencer.finish_external_dma(rq, rs.read_data, dma_ok);
        end
        release_transfer_cs(rq, register_access, cs_started);
        if (dma_ok && command == UVM_TLM_WRITE_COMMAND) begin
            if (should_record_expected_write(rq, command)) begin
                rq.payload.get_data(gp_data);
                foreach (gp_data[i])
                    write_data.push_back(gp_data[i]);
                record_write_expected = 1'b1;
                write_reason = "external_dma_write";
            end
            else begin
                `uvm_info("DW_SPI_XFER", $sformatf(
                    "external DMA write path does not update flash memory mirror: opcode=0x%02h",
                    rq.opcode), UVM_HIGH)
            end
        end
        rs.ok = dma_ok;
    end
    else begin
        if (pio_ok && command == UVM_TLM_READ_COMMAND) begin
            `uvm_info("DW_SPI_XFER", $sformatf(
                "PIO read path: reading payload from DR0: expected_bytes=%0d",
                rq.payload.get_data_length()), UVM_HIGH)
            register_access.read_dr0_to_payload(rq.payload, rs.read_data, pio_ok);
            `uvm_info("DW_SPI_XFER", $sformatf(
                "PIO read path received data: bytes=%0d data_preview=%s",
                rs.read_data.size(), byte_queue_preview(rs.read_data, 16)), UVM_HIGH)
        end
        if (pio_ok) begin
            wait_transfer_completion(rq, cfg, register_access, completion_ok);
            pio_ok = pio_ok && completion_ok;
        end
        release_transfer_cs(rq, register_access, cs_started);
        if (pio_ok && command == UVM_TLM_WRITE_COMMAND) begin
            if (should_record_expected_write(rq, command)) begin
                rq.payload.get_data(gp_data);
                foreach (gp_data[i])
                    write_data.push_back(gp_data[i]);
                record_write_expected = 1'b1;
                write_reason = "pio_write";
            end
            else begin
                `uvm_info("DW_SPI_XFER", $sformatf(
                    "PIO write path does not update flash memory mirror: opcode=0x%02h",
                    rq.opcode), UVM_HIGH)
            end
        end
        rs.ok = pio_ok;
    end
{%- else %}
    if (pio_ok && command == UVM_TLM_READ_COMMAND) begin
        `uvm_info("DW_SPI_XFER", $sformatf(
            "PIO read path: reading payload from DR0: expected_bytes=%0d",
            rq.payload.get_data_length()), UVM_HIGH)
        register_access.read_dr0_to_payload(rq.payload, rs.read_data, pio_ok);
        `uvm_info("DW_SPI_XFER", $sformatf(
            "PIO read path received data: bytes=%0d data_preview=%s",
            rs.read_data.size(), byte_queue_preview(rs.read_data, 16)), UVM_HIGH)
    end
    if (pio_ok) begin
        wait_transfer_completion(rq, cfg, register_access, completion_ok);
        pio_ok = pio_ok && completion_ok;
    end
    release_transfer_cs(rq, register_access, cs_started);
    if (pio_ok && command == UVM_TLM_WRITE_COMMAND) begin
        if (should_record_expected_write(rq, command)) begin
            `uvm_info("DW_SPI_XFER", "PIO write path: staging expected payload for scoreboard", UVM_DEBUG)
            rq.payload.get_data(gp_data);
            foreach (gp_data[i])
                write_data.push_back(gp_data[i]);
            record_write_expected = 1'b1;
            write_reason = "pio_write";
        end
        else begin
            `uvm_info("DW_SPI_XFER", $sformatf(
                "PIO write path does not update flash memory mirror: opcode=0x%02h",
                rq.opcode), UVM_HIGH)
        end
    end
    rs.ok = pio_ok;
{%- endif %}
    if (rs.ok && record_write_expected) begin
        `uvm_info("DW_SPI_XFER", $sformatf(
            "recording expected payload in scoreboard after CS release: reason=%s bytes=%0d data_preview=%s",
            write_reason, write_data.size(), byte_queue_preview(write_data, 16)), UVM_HIGH)
        rs.ok = p_sequencer.scoreboard.record_expected_write(
            rq.payload.get_address(), write_data, write_reason);
    end
    if (!rs.ok)
        `uvm_error("DW_SPI_XFER", $sformatf(
            "transfer failed: protocol=%s mode=%s opcode=0x%02h address=0x%0h length=%0d read_bytes=%0d",
            rq.protocol.name(), rq.transfer_mode.name(), rq.opcode,
            rq.payload.get_address(), rq.payload.get_data_length(),
            rs.read_data.size()))
    `uvm_info("DW_SPI_XFER", $sformatf(
        "transfer done: ok=%0b protocol=%s mode=%s cs_mode=%s address=0x%0h length=%0d read_bytes=%0d",
        rs.ok,
        rq.protocol.name(),
        rq.transfer_mode.name(),
        rq.cs_control_mode.name(),
        rq.payload.get_address(),
        rq.payload.get_data_length(),
        rs.read_data.size()), UVM_HIGH)
    rsp = rs;
endtask

function string {{ class_prefix }}transfer_seq::byte_queue_preview(
        bit [7:0] data[$],
        int max_bytes);
    string preview;
    int limit;

    preview = "";
    limit = data.size();
    if (max_bytes > 0 && limit > max_bytes)
        limit = max_bytes;
    for (int i = 0; i < limit; i++) begin
        if (i != 0)
            preview = {preview, " "};
        preview = {preview, $sformatf("%02h", data[i])};
    end
    if (data.size() > limit)
        preview = {preview, $sformatf(" ... (%0d bytes total)", data.size())};
    if (data.size() == 0)
        preview = "<empty>";
    return preview;
endfunction

function bit {{ class_prefix }}transfer_seq::should_record_expected_write(
        {{ class_prefix }}transfer_req rq,
        uvm_tlm_command_e command);
    protocol_e protocol;

    if (rq == null)
        return 1'b0;
    if (command != UVM_TLM_WRITE_COMMAND)
        return 1'b0;
    if (!$cast(protocol, rq.protocol))
        `uvm_fatal("DW_SPI", "transfer: failed to cast protocol")

    if (protocol == FLASH_SPI)
        return rq.records_memory_write;
    return 1'b0;
endfunction

task {{ class_prefix }}transfer_seq::activate_transfer_cs(
        input {{ class_prefix }}transfer_req rq,
        input {{ class_prefix }}configuration cfg,
        input {{ class_prefix }}register_access register_access,
        output bit cs_started);
    cs_started = 1'b0;
    if (rq == null)
        `uvm_fatal("DW_SPI", "transfer: req is null")
    if (cfg == null)
        `uvm_fatal("DW_SPI", "transfer: configuration is null")
    if (register_access == null)
        `uvm_fatal("DW_SPI", "transfer: register_access is null")

    if (rq.cs_control_mode == SOFTWARE_CS) begin
        `uvm_info("DW_SPI_XFER", $sformatf(
            "activating software chip select through callback: cs=%0d",
            rq.cs_id), UVM_HIGH)
        p_sequencer.activate_chip_select(rq.cs_id);
    end
    `uvm_info("DW_SPI_XFER", $sformatf(
        "selecting hardware chip through SER at transaction boundary: cs=%0d ser=0x%0h",
        rq.cs_id, cfg.ser), UVM_HIGH)
    register_access.select_hardware_chip(cfg.ser);
    cs_started = 1'b1;
endtask

task {{ class_prefix }}transfer_seq::release_transfer_cs(
        input {{ class_prefix }}transfer_req rq,
        input {{ class_prefix }}register_access register_access,
        input bit cs_started);
    if (!cs_started)
        return;
    if (rq == null)
        `uvm_fatal("DW_SPI", "transfer: req is null")
    if (register_access == null)
        `uvm_fatal("DW_SPI", "transfer: register_access is null")

    `uvm_info("DW_SPI_XFER", $sformatf(
        "releasing hardware chip select after transaction: cs=%0d",
        rq.cs_id), UVM_HIGH)
    register_access.release_hardware_chip_selects();
    if (rq.cs_control_mode == SOFTWARE_CS) begin
        `uvm_info("DW_SPI_XFER", $sformatf(
            "releasing software chip select through callback: cs=%0d",
            rq.cs_id), UVM_HIGH)
        p_sequencer.release_chip_select(rq.cs_id);
    end
endtask

task {{ class_prefix }}transfer_seq::write_pio_stream_under_cs(
        input {{ class_prefix }}transfer_req rq,
        input {{ class_prefix }}configuration cfg,
        input {{ class_prefix }}register_access register_access,
        input bit [31:0] dr0_items[$],
        output bit cs_started,
        output bit ok);
    bit [31:0] prefill_items[$];
    bit [31:0] remaining_items[$];
    int prefill_count;

    ok = 1'b1;
    cs_started = 1'b0;
    if (rq == null)
        `uvm_fatal("DW_SPI", "transfer: req is null")
    if (cfg == null)
        `uvm_fatal("DW_SPI", "transfer: configuration is null")
    if (register_access == null)
        `uvm_fatal("DW_SPI", "transfer: register_access is null")
    if (p_sequencer.settings == null)
        `uvm_fatal("DW_SPI", "transfer: settings is null")

    if (dr0_items.size() == 0) begin
        `uvm_info("DW_SPI_XFER", "PIO stream is empty; no CS transaction is started", UVM_HIGH)
        return;
    end

    prefill_count = dr0_items.size();
    if (prefill_count > p_sequencer.settings.fifo_depth_bytes)
        prefill_count = p_sequencer.settings.fifo_depth_bytes;
    foreach (dr0_items[i]) begin
        if (i < prefill_count)
            prefill_items.push_back(dr0_items[i]);
        else
            remaining_items.push_back(dr0_items[i]);
    end
    `uvm_info("DW_SPI_XFER", $sformatf(
        "PIO CS-continuous stream: prefill_before_cs=%0d remaining_under_cs=%0d fifo_depth_bytes=%0d txftlr=%0d",
        prefill_items.size(),
        remaining_items.size(),
        p_sequencer.settings.fifo_depth_bytes,
        cfg.txftlr), UVM_HIGH)
    register_access.write_items_to_dr0(
        prefill_items, "pio_prefill_before_cs", ok);
    if (!ok)
        return;

    activate_transfer_cs(rq, cfg, register_access, cs_started);
    if (remaining_items.size() != 0) begin
        `uvm_info("DW_SPI_XFER", $sformatf(
            "PIO path: feeding remaining DR0 items while CS is active: items=%0d wait_condition=SR.TFNF txftlr=%0d",
            remaining_items.size(),
            cfg.txftlr), UVM_HIGH)
        register_access.write_items_to_dr0(
            remaining_items, "pio_remaining_under_cs", ok);
    end
endtask

{%- if external_dma %}

task {{ class_prefix }}transfer_seq::prefill_external_dma_read_control(
        input {{ class_prefix }}transfer_req rq,
        input {{ class_prefix }}configuration cfg,
        input {{ class_prefix }}register_access register_access,
        output bit ok);
    bit [31:0] control_items[$];
    int required_items;

    ok = 1'b1;
    if (rq == null)
        `uvm_fatal("DW_SPI_DMA", "external DMA read prefill req is null")
    if (cfg == null)
        `uvm_fatal("DW_SPI_DMA", "external DMA read prefill configuration is null")
    if (register_access == null)
        `uvm_fatal("DW_SPI_DMA", "external DMA read prefill register_access is null")
    if (p_sequencer.settings == null)
        `uvm_fatal("DW_SPI_DMA", "external DMA read prefill settings is null")

    required_items = cfg.txftlr + 1;
    if (required_items > p_sequencer.settings.fifo_depth_bytes)
        `uvm_fatal("DW_SPI_DMA", $sformatf(
            "external DMA read TX FIFO start threshold exceeds FIFO depth: required_items=%0d txftlr=%0d fifo_depth_bytes=%0d",
            required_items,
            cfg.txftlr,
            p_sequencer.settings.fifo_depth_bytes))

    build_tx_items(rq, 1'b0, control_items);
    while (control_items.size() < required_items)
        control_items.push_back(32'h0);
    if (control_items.size() > p_sequencer.settings.fifo_depth_bytes)
        `uvm_fatal("DW_SPI_DMA", $sformatf(
            "external DMA read control prefill exceeds FIFO depth: control_items=%0d fifo_depth_bytes=%0d",
            control_items.size(),
            p_sequencer.settings.fifo_depth_bytes))

    `uvm_info("DW_SPI_DMA", $sformatf(
        "prefilling external DMA read TX FIFO before CS: opcode=0x%02h address=0x%0h control_items=%0d required_items=%0d txftlr=%0d",
        rq.opcode,
        rq.payload.get_address(),
        control_items.size(),
        required_items,
        cfg.txftlr), UVM_HIGH)
    register_access.write_items_to_dr0(
        control_items, "external_dma_read_control_prefill_before_cs", ok);
    if (!ok)
        `uvm_error("DW_SPI_DMA", $sformatf(
            "external DMA read TX FIFO prefill failed before CS: opcode=0x%02h address=0x%0h control_items=%0d required_items=%0d txftlr=%0d",
            rq.opcode,
            rq.payload.get_address(),
            control_items.size(),
            required_items,
            cfg.txftlr))
endtask
{%- endif %}

// Reports whether this transfer may use the local internal-DMA done interrupt.
function bit {{ class_prefix }}transfer_seq::can_use_internal_dma_done_interrupt(
        {{ class_prefix }}transfer_req rq);
{%- if internal_dma %}
    if (rq != null && rq.use_dma)
        return 1'b1;
{%- endif %}
    return 1'b0;
endfunction

task {{ class_prefix }}transfer_seq::wait_transfer_completion(
        input {{ class_prefix }}transfer_req rq,
        input {{ class_prefix }}configuration cfg,
        input {{ class_prefix }}register_access register_access,
        output bit ok);
    completion_mode_e completion_mode;
    bit dones_completion_available;

    if (cfg == null)
        `uvm_fatal("DW_SPI", "transfer: configuration is null")
    if (register_access == null)
        `uvm_fatal("DW_SPI", "transfer: register_access is null")
    if (!$cast(completion_mode, cfg.completion_mode))
        `uvm_fatal("DW_SPI", "transfer: failed to cast completion_mode")

    ok = 1'b0;
    dones_completion_available = can_use_internal_dma_done_interrupt(rq);
    case (completion_mode)
        PREFER_INTERRUPT_COMPLETION: begin
            if (p_sequencer.settings == null)
                `uvm_fatal("DW_SPI", "transfer: settings is null")
            if (dones_completion_available && p_sequencer.settings.vif != null && p_sequencer.settings.vif.has_irq()) begin
                `uvm_info("DW_SPI_XFER", "waiting internal DMA completion interrupt, then checking ISR.DONES", UVM_HIGH)
                wait_transfer_interrupt(rq, cfg, "ISR.DONES internal DMA completion");
                register_access.check_internal_dma_dones(ok);
            end else begin
                `uvm_info("DW_SPI_XFER", $sformatf(
                    "using SR polling for transfer completion: reason=%s timeout_cycles=%0d",
                    dones_completion_available ? "intr_not_connected" : "ISR.DONES_not_valid_for_non_internal_dma",
                    cfg.interrupt_timeout_ssi_clk_cycles), UVM_HIGH)
                register_access.wait_idle(cfg.interrupt_timeout_ssi_clk_cycles, ok);
            end
        end
        POLLING_COMPLETION: begin
            `uvm_info("DW_SPI_XFER", $sformatf(
                "waiting transfer completion by polling SR.TFE && !SR.BUSY: timeout_cycles=%0d",
                cfg.interrupt_timeout_ssi_clk_cycles), UVM_HIGH)
            register_access.wait_idle(cfg.interrupt_timeout_ssi_clk_cycles, ok);
        end
        INTERRUPT_COMPLETION: begin
            if (!dones_completion_available)
                `uvm_fatal("DW_SPI_XFER", "INTERRUPT_COMPLETION uses ISR.DONES and is only valid for internal DMA transfers; non-DMA PIO must use SR polling or implement a FIFO IRQ state machine")
            `uvm_info("DW_SPI_XFER", "waiting forced internal DMA completion interrupt, then checking ISR.DONES", UVM_HIGH)
            wait_transfer_interrupt(rq, cfg, "ISR.DONES internal DMA completion");
            register_access.check_internal_dma_dones(ok);
        end
        default: begin
            `uvm_fatal("DW_SPI", "transfer: unsupported completion_mode")
        end
    endcase
    `uvm_info("DW_SPI_XFER", $sformatf(
        "transfer completion wait done: mode=%s ok=%0b",
        completion_mode.name(), ok), UVM_HIGH)
endtask

function void {{ class_prefix }}transfer_seq::build_tx_items(
        input {{ class_prefix }}transfer_req rq,
        input bit include_payload,
        output bit [31:0] dr0_items[$]);
    protocol_e protocol;
    frame_mode_e frame_mode;
    byte unsigned gp_data[];
    bit [63:0] address;
    int dummy_bytes;

    dr0_items.delete();
    if (rq == null)
        `uvm_fatal("DW_SPI", "transfer: req is null")
    if (rq.payload == null)
        `uvm_fatal("DW_SPI", "transfer: req.payload is null")
    if (!$cast(protocol, rq.protocol))
        `uvm_fatal("DW_SPI", "transfer: failed to cast protocol")
    if (!$cast(frame_mode, rq.frame_mode))
        `uvm_fatal("DW_SPI", "transfer: failed to cast frame_mode")
    if (protocol == FLASH_SPI) begin
        address = rq.payload.get_address();
        if (frame_mode == ENHANCED) begin
            if (rq.inst_bytes != 0)
                dr0_items.push_back({24'h0, rq.opcode});
            if (rq.addr_bytes != 0) begin
                case (rq.addr_bytes)
                    1: dr0_items.push_back({24'h0, address[7:0]});
                    2: dr0_items.push_back({16'h0, address[15:0]});
                    3: dr0_items.push_back({8'h0, address[23:0]});
                    4: dr0_items.push_back(address[31:0]);
                    default: `uvm_fatal("DW_SPI", $sformatf(
                        "unsupported enhanced address width: addr_bytes=%0d", rq.addr_bytes))
                endcase
            end
        end
        else begin
            if (rq.inst_bytes != 0)
                dr0_items.push_back({24'h0, rq.opcode});
            for (int i = rq.addr_bytes; i > 0; i--)
                dr0_items.push_back({24'h0, address[(i - 1) * 8 +: 8]});
            dummy_bytes = rq.dummy_cycles <= 0 ? 0 : (rq.dummy_cycles + 7) / 8;
            for (int i = 0; i < dummy_bytes; i++)
                dr0_items.push_back(32'h0);
        end
    end

    if (include_payload) begin
        rq.payload.get_data(gp_data);
        foreach (gp_data[i])
            dr0_items.push_back({24'h0, gp_data[i]});
    end

    `uvm_info("DW_SPI_XFER", $sformatf(
        "controller TX item stream built: protocol=%s frame=%s opcode=0x%02h address=0x%0h inst_bytes=%0d addr_bytes=%0d dummy_cycles=%0d include_payload=%0b payload_bytes=%0d control_items=%0d total_items=%0d",
        protocol.name(),
        frame_mode.name(),
        rq.opcode,
        rq.payload.get_address(),
        rq.inst_bytes,
        rq.addr_bytes,
        rq.dummy_cycles,
        include_payload,
        rq.payload.get_data_length(),
        protocol == FLASH_SPI ? (rq.inst_bytes != 0 ? 1 : 0) + (rq.addr_bytes != 0 ? (frame_mode == ENHANCED ? 1 : rq.addr_bytes) : 0) : 0,
        dr0_items.size()), UVM_DEBUG)
endfunction

{%- if internal_dma %}

task {{ class_prefix }}transfer_seq::cpu_write_dma_source_to_axi(
        input {{ class_prefix }}transfer_req rq,
        output bit ok);
    uvm_tlm_command_e command;
    byte unsigned gp_data[];
    bit [7:0] preview_data[$];
    bit [31:0] control_items[$];
    bit [31:0] word;
    int index;

    ok = 1'b1;
    if (rq == null)
        `uvm_fatal("DW_SPI_DMA", "internal DMA source req is null")
    if (rq.payload == null)
        `uvm_fatal("DW_SPI_DMA", "internal DMA source payload is null")
    if (rq.axi_addr == 0 || rq.axi_addr[1:0] != 2'b00)
        `uvm_fatal("DW_SPI_DMA", $sformatf(
            "internal DMA source axi_addr must be nonzero and 4-byte aligned: axi_addr=0x%08h",
            rq.axi_addr))
    command = rq.payload.get_command();
    if (command == UVM_TLM_READ_COMMAND) begin
        build_tx_items(rq, 1'b0, control_items);
        if (control_items.size() == 0)
            `uvm_fatal("DW_SPI_DMA", "internal DMA read source has no control items")
        `uvm_info("DW_SPI_DMA", $sformatf(
            "cpu writing internal DMA read control buffer: axi_addr=0x%08h control_words=%0d arlen=%0d",
            rq.axi_addr, control_items.size(), rq.arlen), UVM_HIGH)
        foreach (control_items[i]) begin
            `uvm_info("DW_SPI_DMA", $sformatf(
                "CPU write internal DMA read control word: addr=0x%0h word=0x%08h word_index=%0d",
                {32'h0, rq.axi_addr + i * 4}, control_items[i], i), UVM_DEBUG)
            p_sequencer.cpu_write(
                {32'h0, rq.axi_addr + i * 4}, control_items[i], UVM_BACKDOOR);
        end
        `uvm_info("DW_SPI_DMA", $sformatf(
            "cpu wrote internal DMA read control buffer: axi_addr=0x%08h control_words=%0d",
            rq.axi_addr, control_items.size()), UVM_HIGH)
        return;
    end
    if (command != UVM_TLM_WRITE_COMMAND)
        `uvm_fatal("DW_SPI_DMA", $sformatf(
            "unsupported internal DMA source command: %s", command.name()))
    rq.payload.get_data(gp_data);
    preview_data.delete();
    foreach (gp_data[i])
        preview_data.push_back(gp_data[i]);
    `uvm_info("DW_SPI_DMA", $sformatf(
        "cpu writing DMA source buffer: axi_addr=0x%08h bytes=%0d data_preview=%s",
        rq.axi_addr, gp_data.size(), byte_queue_preview(preview_data, 16)), UVM_HIGH)
    index = 0;
    while (index < gp_data.size()) begin
        word = '0;
        for (int byte_index = 0; byte_index < 4; byte_index++) begin
            if (index + byte_index < gp_data.size())
                word[byte_index * 8 +: 8] = gp_data[index + byte_index];
        end
        `uvm_info("DW_SPI_DMA", $sformatf(
            "CPU write DMA source word: addr=0x%0h word=0x%08h byte_index=%0d",
            {32'h0, rq.axi_addr + index}, word, index), UVM_DEBUG)
        p_sequencer.cpu_write({32'h0, rq.axi_addr + index}, word, UVM_BACKDOOR);
        index += 4;
    end
    `uvm_info("DW_SPI_DMA", $sformatf(
        "cpu wrote DMA source buffer: axi_addr=0x%08h bytes=%0d",
        rq.axi_addr, gp_data.size()), UVM_HIGH)
endtask

task {{ class_prefix }}transfer_seq::cpu_read_payload_from_axi(
        input bit [31:0] axi_addr,
        input int length,
        output bit [7:0] read_data[$],
        output bit ok);
    bit [31:0] word;
    int index;

    ok = 1'b1;
    read_data.delete();
    index = 0;
    while (index < length) begin
        `uvm_info("DW_SPI_DMA", $sformatf(
            "CPU read DMA destination word: addr=0x%0h byte_index=%0d",
            {32'h0, axi_addr + index}, index), UVM_DEBUG)
        p_sequencer.cpu_read({32'h0, axi_addr + index}, word, UVM_BACKDOOR);
        `uvm_info("DW_SPI_DMA", $sformatf(
            "CPU read DMA destination word done: addr=0x%0h word=0x%08h",
            {32'h0, axi_addr + index}, word), UVM_DEBUG)
        for (int byte_index = 0; byte_index < 4; byte_index++) begin
            if (index + byte_index < length)
                read_data.push_back(word[byte_index * 8 +: 8]);
        end
        index += 4;
    end
    `uvm_info("DW_SPI_DMA", $sformatf(
        "cpu read DMA destination buffer: axi_addr=0x%08h bytes=%0d data_preview=%s",
        axi_addr, read_data.size(), byte_queue_preview(read_data, 16)), UVM_HIGH)
endtask
{%- endif %}

task {{ class_prefix }}transfer_seq::wait_transfer_interrupt(
        {{ class_prefix }}transfer_req rq,
        {{ class_prefix }}configuration cfg,
        string expected_source);
    bit timed_out;
    bit missing_signal;

    if (p_sequencer.settings == null)
        `uvm_fatal("DW_SPI", "transfer: settings is null")
    if (p_sequencer.settings.vif == null)
        `uvm_fatal("DW_SPI", "transfer: settings.vif is null")
    if (cfg == null)
        `uvm_fatal("DW_SPI", "transfer: configuration is null")

    `uvm_info("DW_SPI_XFER", $sformatf(
        "waiting intr asserted: expected_source=%s timeout_cycles=%0d min_ssi_clk_hz=%0d tolerance_ppm=%0d",
        expected_source,
        cfg.interrupt_timeout_ssi_clk_cycles,
        p_sequencer.settings.min_ssi_clk_hz,
        p_sequencer.settings.clock_check_tolerance_ppm), UVM_HIGH)
    p_sequencer.settings.vif.wait_interrupt_asserted(
        cfg.interrupt_timeout_ssi_clk_cycles,
        p_sequencer.settings.min_ssi_clk_hz,
        p_sequencer.settings.clock_check_tolerance_ppm,
        timed_out,
        missing_signal);
    if (missing_signal)
        `uvm_fatal("DW_SPI", $sformatf(
            "missing signal while waiting transfer completion interrupt: waiting_for=top intr asserted expected_source=%s required=intr_and_ssi_clk has_irq=%0b has_ssi_clk=%0b cs_id=%0d opcode=0x%02h address=0x%0h length=%0d transfer_mode=%s protocol=%s frame_mode=%s",
            expected_source,
            p_sequencer.settings.vif.has_irq(),
            p_sequencer.settings.vif.has_ssi_clk(),
            rq.cs_id,
            rq.opcode,
            rq.payload.get_address(),
            rq.payload.get_data_length(),
            rq.transfer_mode.name(),
            rq.protocol.name(),
            rq.frame_mode.name()))
    if (timed_out)
        `uvm_fatal("DW_SPI", $sformatf(
            "transfer interrupt timeout: waiting_for=top intr asserted expected_source=%s timeout_cycles=%0d cs_id=%0d opcode=0x%02h address=0x%0h length=%0d transfer_mode=%s protocol=%s frame_mode=%s",
            expected_source,
            cfg.interrupt_timeout_ssi_clk_cycles,
            rq.cs_id,
            rq.opcode,
            rq.payload.get_address(),
            rq.payload.get_data_length(),
            rq.transfer_mode.name(),
            rq.protocol.name(),
            rq.frame_mode.name()))
    `uvm_info("DW_SPI_XFER", $sformatf(
        "transfer completion interrupt observed: expected_source=%s",
        expected_source), UVM_HIGH)
endtask

`endif
