`ifndef {{ (settings.class_prefix ~ "transfer_seq") | upper }}
`define {{ (settings.class_prefix ~ "transfer_seq") | upper }}

class {{ settings.class_prefix }}transfer_seq extends uvm_sequence #(
    {{ settings.class_prefix }}transfer_req,
    {{ settings.class_prefix }}transfer_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}transfer_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    function new(string name="{{ settings.class_prefix }}transfer_seq");
        super.new(name);
    endfunction

    extern virtual task body();
endclass

task {{ settings.class_prefix }}transfer_seq::body();
    {{ settings.class_prefix }}transfer_req rq;
    {{ settings.class_prefix }}transfer_rsp rs;
    uvm_tlm_generic_payload gp;
    byte unsigned gp_data[];

    if (req == null)
        `uvm_fatal("DW_SPI", "transfer: req is null")
    if (req.tr == null)
        `uvm_fatal("DW_SPI", "transfer: req.tr is null")
    if (p_sequencer.scoreboard == null)
        `uvm_fatal("DW_SPI", "transfer: sequencer scoreboard is null")
    rq = req;
    rs = {{ settings.class_prefix }}transfer_rsp::type_id::create("rsp");
    p_sequencer.begin_transfer(rq.tr);
    gp = uvm_tlm_generic_payload::type_id::create("gp");
    gp.set_address(rq.tr.address);
    gp.set_command(rq.tr.write ? UVM_TLM_WRITE_COMMAND : UVM_TLM_READ_COMMAND);
    if (rq.tr.write) begin
        gp_data = new[rq.tr.data.size()];
        foreach (rq.tr.data[i])
            gp_data[i] = rq.tr.data[i];
        gp.set_data(gp_data);
    end else begin
        gp.set_data_length(rq.tr.length);
    end
    rs.ok = p_sequencer.scoreboard.apply_payload(gp, rs.read_data);
    p_sequencer.end_transfer(rq.tr);
    rsp = rs;
endtask

`endif
