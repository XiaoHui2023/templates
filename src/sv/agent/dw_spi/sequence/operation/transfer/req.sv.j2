`ifndef {{ (class_prefix ~ "transfer_req") | upper }}
`define {{ (class_prefix ~ "transfer_req") | upper }}

class {{ class_prefix }}transfer_req extends {{ class_prefix }}base_item;
    `uvm_object_utils_begin({{ class_prefix }}transfer_req)
        `uvm_field_object(payload, UVM_ALL_ON)
        `uvm_field_string(payload_command, UVM_ALL_ON)
        `uvm_field_int(payload_address, UVM_ALL_ON | UVM_HEX)
        `uvm_field_int(payload_data_length, UVM_ALL_ON | UVM_DEC)
        `uvm_field_string(payload_data_preview, UVM_ALL_ON)
        `uvm_field_enum(host_mode_e, host_mode, UVM_ALL_ON)
        `uvm_field_enum(protocol_e, protocol, UVM_ALL_ON)
        `uvm_field_enum(frame_mode_e, frame_mode, UVM_ALL_ON)
        `uvm_field_enum(cs_control_mode_e, cs_control_mode, UVM_ALL_ON)
        `uvm_field_enum(transfer_mode_e, transfer_mode, UVM_ALL_ON)
        `uvm_field_int(opcode, UVM_ALL_ON | UVM_HEX)
        `uvm_field_int(io_lanes, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(instruction_lanes, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(address_lanes, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(speed_multiplier, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(spi_mode, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(data_frame_bits, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(cs_id, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(inst_bytes, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(addr_bytes, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(dummy_cycles, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(rx_skip_bytes, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(records_memory_write, UVM_ALL_ON)
{%- if internal_dma or external_dma %}
        `uvm_field_int(use_dma, UVM_ALL_ON)
{%- endif %}
{%- if internal_dma %}
        `uvm_field_int(awlen, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(arlen, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(axi_addr, UVM_ALL_ON | UVM_HEX)
{%- endif %}
    `uvm_object_utils_end

    uvm_tlm_generic_payload payload;
    string payload_command;
    longint payload_address;
    int payload_data_length;
    string payload_data_preview;
    rand host_mode_e host_mode;
    rand protocol_e protocol;
    rand frame_mode_e frame_mode;
    rand cs_control_mode_e cs_control_mode;
    rand transfer_mode_e transfer_mode;
    rand bit [7:0] opcode;
    rand int io_lanes;
    rand int instruction_lanes;
    rand int address_lanes;
    rand int speed_multiplier;
    rand int spi_mode;
    rand int data_frame_bits;
    rand int cs_id;
    rand int inst_bytes;
    rand int addr_bytes;
    rand int dummy_cycles;
    rand int rx_skip_bytes;
    rand bit records_memory_write;
{%- if internal_dma or external_dma %}
    rand bit use_dma;
{%- endif %}
{%- if internal_dma %}
    rand bit [3:0] awlen;
    rand bit [3:0] arlen;
    rand bit [31:0] axi_addr;
{%- endif %}

    // Creates a primitive transfer request.
    function new(string name="{{ class_prefix }}transfer_req");
        super.new(name);
    endfunction

    // Refreshes the compact payload summary used by UVM field printing.
    function void update_print_summary(int max_bytes = 16);
        uvm_tlm_command_e command;
        byte unsigned gp_data[];

        if (payload == null) begin
            payload_command = "NO_PAYLOAD";
            payload_address = '0;
            payload_data_length = 0;
            payload_data_preview = "<null>";
            return;
        end

        command = payload.get_command();
        payload_command = command.name();
        payload_address = payload.get_address();
        payload_data_length = payload.get_data_length();
        payload_data_preview = "";

        if (command == UVM_TLM_WRITE_COMMAND) begin
            payload.get_data(gp_data);
            if (gp_data.size() == 0) begin
                payload_data_preview = "<empty>";
            end
            else begin
                foreach (gp_data[i]) begin
                    if (i < max_bytes) begin
                        if (payload_data_preview != "")
                            payload_data_preview = {payload_data_preview, " "};
                        payload_data_preview = {payload_data_preview, $sformatf("%02h", gp_data[i])};
                    end
                end
                if (gp_data.size() > max_bytes)
                    payload_data_preview = {payload_data_preview, $sformatf(" ... (%0d bytes)", gp_data.size())};
                else
                    payload_data_preview = {payload_data_preview, $sformatf(" (%0d bytes)", gp_data.size())};
            end
        end
        else if (command == UVM_TLM_READ_COMMAND) begin
            payload_data_preview = $sformatf("<read %0d bytes>", payload_data_length);
        end
        else begin
            payload_data_preview = "<ignored>";
        end
    endfunction

    constraint cst {
        io_lanes inside {1, 2, 4};
        instruction_lanes inside {1, 2, 4};
        address_lanes inside {1, 2, 4};
        speed_multiplier inside {1{% if max_speed_multiplier >= 2 %}, 2{% endif %}{% if max_speed_multiplier >= 4 %}, 4{% endif %}};
        soft instruction_lanes == 1;
        soft address_lanes == 1;
        soft records_memory_write == 1'b0;
        if (speed_multiplier == 1) {
            frame_mode == STANDARD;
            instruction_lanes == 1;
            address_lanes == 1;
        }
        else frame_mode == ENHANCED;
        if (instruction_lanes != 1) instruction_lanes == speed_multiplier;
        if (addr_bytes == 0) address_lanes == 1;
        if (address_lanes != 1) address_lanes == speed_multiplier;
        if (cs_control_mode == SOFTWARE_CS) {
            host_mode == MASTER;
            frame_mode == STANDARD;
            speed_multiplier == 1;
            instruction_lanes == 1;
            address_lanes == 1;
        }
        spi_mode inside {[0:3]};
        data_frame_bits inside {[4:32]};
        cs_id < {{ num_cs }};
        inst_bytes inside {[0:1]};
        addr_bytes inside {[0:4]};
        soft rx_skip_bytes == 0;
        rx_skip_bytes >= 0;
{%- if internal_dma or external_dma %}
        soft use_dma == 1'b0;
        if (use_dma) speed_multiplier > 1;
{%- endif %}
{%- if internal_dma %}
        soft awlen == '0;
        soft arlen == '0;
        soft axi_addr == '0;
        if (use_dma) {
            axi_addr != 0;
            axi_addr[1:0] == 2'b00;
        }
{%- endif %}
        if (protocol == FLASH_SPI) {
            inst_bytes == 1;
        }
{%- if not support_master %}
        host_mode != MASTER;
{%- endif %}
{%- if not support_slave %}
        host_mode != SLAVE;
{%- endif %}
{%- if not support_general_spi %}
        protocol != GENERAL_SPI;
{%- endif %}
{%- if not support_flash_spi %}
        protocol != FLASH_SPI;
{%- endif %}
    }
endclass

`endif
