{% if internal_dma or external_dma -%}
`ifndef {{ (class_prefix ~ "dma_test_seq") | upper }}
`define {{ (class_prefix ~ "dma_test_seq") | upper }}

class {{ class_prefix }}dma_test_seq extends {{ class_prefix }}spec#(uvm_sequence);
    `uvm_object_utils_begin({{ class_prefix }}dma_test_seq)
        `uvm_field_int(address, UVM_ALL_ON | UVM_HEX)
        `uvm_field_queue_int(write_data, UVM_ALL_ON | UVM_HEX)
        `uvm_field_object(configuration, UVM_ALL_ON)
        `uvm_field_int(ok, UVM_ALL_ON)
    `uvm_object_utils_end
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    rand bit [31:0] address;
    rand bit [7:0] write_data[$];
    {{ class_prefix }}transfer_configuration configuration;
    bit ok;

    // Creates a DMA-forced flash read/write test scenario.
    function new(string name="{{ class_prefix }}dma_test_seq");
        super.new(name);
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
    endfunction

    constraint cst {
        soft address == '0;
        soft write_data.size() == {{ default_rw_data_bytes }};
    }

    // Executes one read/write test with the generated DMA architecture enabled.
    extern virtual task body();
endclass

task {{ class_prefix }}dma_test_seq::body();
    {{ class_prefix }}rw_test_seq rw_seq;

    if (configuration == null)
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
    configuration.settings = p_sequencer.settings;
    if (configuration.use_dma !== 1'b1) begin
        if (!configuration.randomize() with { use_dma == 1'b1; })
            `uvm_fatal("DW_SPI_DMA_TEST", "dma_test failed to randomize configuration")
    end
    if (configuration.use_dma !== 1'b1)
        `uvm_fatal("DW_SPI_DMA_TEST", "dma_test requires use_dma=1")
    if (write_data.size() == 0) begin
        if (!randomize(write_data) with {
                write_data.size() == {{ default_rw_data_bytes }};
            })
            `uvm_fatal("DW_SPI_DMA_TEST", "dma_test failed to randomize write_data")
    end

    `uvm_info("DW_SPI_DMA_TEST", $sformatf(
        "dma_test start: dma={{ 'internal' if internal_dma else 'external' }} address=0x%08h bytes=%0d speed=%0dx lanes=%0d",
        address, write_data.size(), configuration.speed_multiplier, configuration.io_lanes), UVM_LOW)
    rw_seq = {{ class_prefix }}rw_test_seq::type_id::create("rw_test");
    rw_seq.address = address;
    rw_seq.write_data = write_data;
    rw_seq.configuration = configuration;
    rw_seq.start(p_sequencer);
    ok = rw_seq.ok;
    `uvm_info("DW_SPI_DMA_TEST", $sformatf(
        "dma_test done: ok=%0b dma={{ 'internal' if internal_dma else 'external' }} address=0x%08h bytes=%0d",
        ok, address, write_data.size()), UVM_LOW)
endtask

`endif
{%- endif %}
