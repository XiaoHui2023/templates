`ifndef {{ (class_prefix ~ "rw_test_seq") | upper }}
`define {{ (class_prefix ~ "rw_test_seq") | upper }}

class {{ class_prefix }}rw_test_seq extends {{ class_prefix }}spec#(uvm_sequence #(
    {{ class_prefix }}rw_test_req,
    {{ class_prefix }}rw_test_rsp
));
    `uvm_object_utils({{ class_prefix }}rw_test_seq)
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    function new(string name="{{ class_prefix }}rw_test_seq");
        super.new(name);
    endfunction

    extern virtual task body();
endclass

task {{ class_prefix }}rw_test_seq::body();
    {{ class_prefix }}flash_write_req wr_req;
    {{ class_prefix }}flash_write_rsp wr_rsp;
    {{ class_prefix }}flash_write_seq wr_seq;
    {{ class_prefix }}flash_read_req rd_req;
    {{ class_prefix }}flash_read_rsp rd_rsp;
    {{ class_prefix }}flash_read_seq rd_seq;
    {{ class_prefix }}rw_test_rsp rs;
    {{ class_prefix }}transfer_configuration cfg;

    if (req == null)
        `uvm_fatal("DW_SPI", "rw_test: req is null")
    if (req.configuration == null) begin
        req.configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
        if (!req.configuration.randomize())
            `uvm_fatal("DW_SPI", "rw_test: failed to randomize configuration")
    end
    cfg = req.configuration;
    rs = {{ class_prefix }}rw_test_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    wr_req = {{ class_prefix }}flash_write_req::type_id::create("wr_req");
    wr_req.address = req.address;
    wr_req.data = req.write_data;
    wr_req.configuration = cfg;
    wr_seq = {{ class_prefix }}flash_write_seq::type_id::create("flash_write");
    wr_seq.req = wr_req;
    wr_seq.start(p_sequencer);
    wr_rsp = wr_seq.rsp;
    if (wr_rsp == null || !wr_rsp.ok)
        rs.ok = 1'b0;

    rd_req = {{ class_prefix }}flash_read_req::type_id::create("rd_req");
    rd_req.address = req.address;
    rd_req.length = req.write_data.size();
    rd_req.configuration = cfg;
    rd_seq = {{ class_prefix }}flash_read_seq::type_id::create("flash_read");
    rd_seq.req = rd_req;
    rd_seq.start(p_sequencer);
    rd_rsp = rd_seq.rsp;
    if (rd_rsp == null || !rd_rsp.ok)
        rs.ok = 1'b0;
    else
        rs.model_read_data = rd_rsp.data;

    if (rs.ok) begin
        rs.ok = p_sequencer.scoreboard.compare_actual(
            req.address, req.write_data, "model_readback");
    end
    rsp = rs;
endtask

`endif
