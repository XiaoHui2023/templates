`ifndef {{ (class_prefix ~ "rw_test_seq") | upper }}
`define {{ (class_prefix ~ "rw_test_seq") | upper }}

class {{ class_prefix }}rw_test_seq extends {{ class_prefix }}spec#(uvm_sequence);
    `uvm_object_utils_begin({{ class_prefix }}rw_test_seq)
        `uvm_field_int(address, UVM_ALL_ON | UVM_HEX)
        `uvm_field_queue_int(write_data, UVM_ALL_ON | UVM_HEX)
        `uvm_field_object(configuration, UVM_ALL_ON)
        `uvm_field_int(ok, UVM_ALL_ON)
        `uvm_field_queue_int(read_data, UVM_ALL_ON | UVM_HEX)
    `uvm_object_utils_end
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    rand bit [31:0] address;
    rand bit [7:0] write_data[$];
    {{ class_prefix }}transfer_configuration configuration;
    bit ok;
    bit [7:0] read_data[$];

    function new(string name="{{ class_prefix }}rw_test_seq");
        super.new(name);
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
    endfunction

    constraint cst {
        soft address == '0;
        soft write_data.size() == {{ default_rw_data_bytes }};
    }

    extern virtual task body();
endclass

task {{ class_prefix }}rw_test_seq::body();
    {{ class_prefix }}flash_write_seq wr_seq;
    {{ class_prefix }}flash_read_seq rd_seq;
    {{ class_prefix }}transfer_configuration cfg;

    if (configuration == null) begin
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
        configuration.settings = p_sequencer.settings;
        if (!configuration.randomize())
            `uvm_fatal("DW_SPI", "rw_test: failed to randomize configuration")
    end
    configuration.settings = p_sequencer.settings;
    if (write_data.size() == 0) begin
        if (!randomize(write_data) with {
                write_data.size() == {{ default_rw_data_bytes }};
            })
            `uvm_fatal("DW_SPI", "rw_test: failed to randomize write_data")
    end
    cfg = configuration;
    ok = 1'b1;
    read_data.delete();
    `uvm_info("DW_SPI_TEST", $sformatf(
        "rw_test start: address=0x%08h bytes=%0d lanes=%0d speed=%0dx frame=%s cs_mode=%s{% if internal_dma or external_dma %} use_dma=%0b{% endif %}",
        address,
        write_data.size(),
        cfg.io_lanes,
        cfg.speed_multiplier,
        cfg.frame_mode.name(),
        cfg.cs_control_mode.name(){% if internal_dma or external_dma %},
        cfg.use_dma{% endif %}), UVM_LOW)

    wr_seq = {{ class_prefix }}flash_write_seq::type_id::create("flash_write");
    `uvm_info("DW_SPI_TEST", "rw_test starting write phase", UVM_LOW)
    wr_seq.address = address;
    wr_seq.data = write_data;
    wr_seq.configuration = cfg;
    wr_seq.start(p_sequencer);
    if (!wr_seq.ok)
        ok = 1'b0;

    rd_seq = {{ class_prefix }}flash_read_seq::type_id::create("flash_read");
    `uvm_info("DW_SPI_TEST", "rw_test starting readback phase", UVM_LOW)
    rd_seq.address = address;
    rd_seq.length = write_data.size();
    rd_seq.configuration = cfg;
    rd_seq.start(p_sequencer);
    if (!rd_seq.ok)
        ok = 1'b0;
    else
        read_data = rd_seq.data;

    if (ok) begin
        `uvm_info("DW_SPI_TEST", "rw_test checking readback data against scoreboard", UVM_LOW)
        ok = p_sequencer.scoreboard.check_actual_read(
            address, read_data, "rw_readback_actual");
    end
    `uvm_info("DW_SPI_TEST", $sformatf(
        "rw_test done: ok=%0b address=0x%08h bytes=%0d read_bytes=%0d",
        ok, address, write_data.size(), read_data.size()), UVM_LOW)
endtask

`endif
