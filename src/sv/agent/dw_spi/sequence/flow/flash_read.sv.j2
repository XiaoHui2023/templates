`ifndef {{ (class_prefix ~ "flash_read_seq") | upper }}
`define {{ (class_prefix ~ "flash_read_seq") | upper }}

class {{ class_prefix }}flash_read_seq extends {{ class_prefix }}spec#(uvm_sequence);
    `uvm_object_utils_begin({{ class_prefix }}flash_read_seq)
        `uvm_field_int(address, UVM_ALL_ON | UVM_HEX)
        `uvm_field_int(length, UVM_ALL_ON | UVM_DEC)
        `uvm_field_object(configuration, UVM_ALL_ON)
        `uvm_field_int(ok, UVM_ALL_ON)
        `uvm_field_queue_int(data, UVM_ALL_ON | UVM_HEX)
    `uvm_object_utils_end
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    rand bit [31:0] address;
    rand int length;
    {{ class_prefix }}transfer_configuration configuration;
    bit ok;
    bit [7:0] data[$];

    function new(string name="{{ class_prefix }}flash_read_seq");
        super.new(name);
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
    endfunction

    extern virtual task body();
    extern function bit [7:0] read_opcode(
        int speed_multiplier,
        frame_mode_e frame_mode);
endclass

function bit [7:0] {{ class_prefix }}flash_read_seq::read_opcode(
        int speed_multiplier,
        frame_mode_e frame_mode);
    case (speed_multiplier)
        1: return frame_mode == ENHANCED ? 8'h0B : 8'h03;
        2: return 8'hBB;
        4: return 8'hEB;
        default: begin
            `uvm_fatal("DW_SPI", $sformatf(
                "unsupported flash read speed_multiplier=%0d",
                speed_multiplier))
            return 8'h03;
        end
    endcase
endfunction

task {{ class_prefix }}flash_read_seq::body();
    {{ class_prefix }}transfer_req op_req;
    {{ class_prefix }}transfer_rsp op_rsp;
    {{ class_prefix }}transfer_seq op_seq;
    {{ class_prefix }}transfer_configuration cfg;
    frame_mode_e frame_mode;

    if (configuration == null) begin
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
        if (!configuration.randomize())
            `uvm_fatal("DW_SPI", "flash_read: failed to randomize configuration")
    end
    cfg = configuration;
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_read start: address=0x%08h length=%0d lanes=%0d speed=%0dx frame=%s{% if internal_dma or external_dma %} use_dma=%0b{% endif %}",
        address,
        length,
        cfg.io_lanes,
        cfg.speed_multiplier,
        cfg.frame_mode.name(){% if internal_dma or external_dma %},
        cfg.use_dma{% endif %}), UVM_LOW)
    op_req = {{ class_prefix }}transfer_req::type_id::create("op_req");
    op_req.payload = uvm_tlm_generic_payload::type_id::create("payload");
    op_req.payload.set_command(UVM_TLM_READ_COMMAND);
    op_req.payload.set_address(address);
    op_req.payload.set_data_length(length);
    if (!$cast(op_req.host_mode, cfg.host_mode))
        `uvm_fatal("DW_SPI", "flash_read: failed to cast host_mode")
    if (!$cast(op_req.protocol, FLASH_SPI))
        `uvm_fatal("DW_SPI", "flash_read: failed to cast protocol")
    if (!$cast(op_req.frame_mode, cfg.frame_mode))
        `uvm_fatal("DW_SPI", "flash_read: failed to cast frame_mode")
    if (!$cast(frame_mode, cfg.frame_mode))
        `uvm_fatal("DW_SPI", "flash_read: failed to cast local frame_mode")
    if (!$cast(op_req.transfer_mode, RX_ONLY))
        `uvm_fatal("DW_SPI", "flash_read: failed to cast transfer_mode")
    op_req.opcode = read_opcode(cfg.speed_multiplier, frame_mode);
    op_req.io_lanes = cfg.io_lanes;
    op_req.speed_multiplier = cfg.speed_multiplier;
    op_req.spi_mode = cfg.spi_mode;
    op_req.data_frame_bits = cfg.data_frame_bits;
    op_req.cs_id = cfg.cs_id;
    op_req.inst_bytes = 1;
    op_req.addr_bytes = cfg.addr_bytes;
    op_req.dummy_cycles = cfg.dummy_cycles;
{% if internal_dma or external_dma %}
    op_req.use_dma = cfg.use_dma;
{% endif %}
{% if internal_dma %}
    op_req.awlen = cfg.awlen;
    op_req.arlen = cfg.arlen;
    op_req.axi_addr = cfg.axi_addr;
{% endif %}
    `uvm_info("DW_SPI_FLASH", "starting primitive transfer for flash read", UVM_LOW)
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_read request detail: opcode=0x%02h mode=%s frame=%s addr=0x%08h length=%0d inst_bytes=%0d addr_bytes=%0d dummy_cycles=%0d cs=%0d lanes=%0d speed=%0dx dfs_bits=%0d{% if internal_dma or external_dma %} use_dma=%0b{% endif %}",
        op_req.opcode,
        op_req.transfer_mode.name(),
        op_req.frame_mode.name(),
        address,
        length,
        op_req.inst_bytes,
        op_req.addr_bytes,
        op_req.dummy_cycles,
        op_req.cs_id,
        op_req.io_lanes,
        op_req.speed_multiplier,
        op_req.data_frame_bits{% if internal_dma or external_dma %},
        op_req.use_dma{% endif %}), UVM_DEBUG)
    op_seq = {{ class_prefix }}transfer_seq::type_id::create("transfer");
    op_seq.req = op_req;
    op_seq.start(p_sequencer);
    op_rsp = op_seq.rsp;
    ok = op_rsp != null && op_rsp.ok;
    data.delete();
    if (op_rsp != null)
        data = op_rsp.read_data;
    if (ok) begin
        `uvm_info("DW_SPI_FLASH", "checking flash read actual data against scoreboard", UVM_LOW)
        ok = p_sequencer.scoreboard.check_actual_read(address, data, "flash_read_actual");
    end
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_read done: ok=%0b address=0x%08h requested=%0d received=%0d opcode=0x%02h",
        ok, address, length, data.size(), op_req.opcode), UVM_LOW)
endtask

`endif
