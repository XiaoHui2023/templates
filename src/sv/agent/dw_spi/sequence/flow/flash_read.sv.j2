`ifndef {{ (class_prefix ~ "flash_read_seq") | upper }}
`define {{ (class_prefix ~ "flash_read_seq") | upper }}

class {{ class_prefix }}flash_read_seq extends {{ class_prefix }}spec#(uvm_sequence);
    `uvm_object_utils_begin({{ class_prefix }}flash_read_seq)
        `uvm_field_int(address, UVM_ALL_ON | UVM_HEX)
        `uvm_field_int(length, UVM_ALL_ON | UVM_DEC)
        `uvm_field_object(configuration, UVM_ALL_ON)
        `uvm_field_int(ok, UVM_ALL_ON)
        `uvm_field_queue_int(data, UVM_ALL_ON | UVM_HEX)
    `uvm_object_utils_end
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    rand bit [31:0] address;
    rand int length;
    {{ class_prefix }}transfer_configuration configuration;
    bit ok;
    bit [7:0] data[$];

    // Creates a flash read flow with a host configuration packet.
    function new(string name="{{ class_prefix }}flash_read_seq");
        super.new(name);
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
    endfunction

    // Executes one opcode-specific flash read and checks the returned data.
    extern virtual task body();
    // Selects and configures the read command packet for the requested speed.
    extern function {{ class_prefix }}flash_command create_read_command(
        {{ class_prefix }}transfer_configuration cfg);
endclass

function {{ class_prefix }}flash_command {{ class_prefix }}flash_read_seq::create_read_command(
        {{ class_prefix }}transfer_configuration cfg);
    {{ class_prefix }}flash_command command;
    frame_mode_e frame_mode;

    if (cfg == null)
        `uvm_fatal("DW_SPI", "flash_read: configuration is null")
    if (!$cast(frame_mode, cfg.frame_mode))
        `uvm_fatal("DW_SPI", "flash_read: failed to cast frame_mode")
    case (cfg.speed_multiplier)
        1: begin
            if (frame_mode == ENHANCED)
                command = {{ class_prefix }}fast_read1x_flash_command::type_id::create("fast_read1x_command");
            else
                command = {{ class_prefix }}read1x_flash_command::type_id::create("read1x_command");
        end
        2: command = {{ class_prefix }}read2x_flash_command::type_id::create("read2x_command");
        4: command = {{ class_prefix }}read4x_flash_command::type_id::create("read4x_command");
        default: begin
            `uvm_fatal("DW_SPI", $sformatf(
                "unsupported flash read speed_multiplier=%0d",
                cfg.speed_multiplier))
        end
    endcase
    if (!command.randomize() with {
            addr_bytes == local::cfg.addr_bytes;
            data_frame_bits == local::cfg.data_frame_bits;
        })
        `uvm_fatal("DW_SPI", "flash_read: failed to randomize read flash command")
    return command;
endfunction

task {{ class_prefix }}flash_read_seq::body();
    {{ class_prefix }}flash_command command;
    {{ class_prefix }}flash_command_adapter adapter;
    {{ class_prefix }}transfer_req op_req;
    {{ class_prefix }}transfer_rsp op_rsp;
    {{ class_prefix }}transfer_seq op_seq;
    {{ class_prefix }}transfer_configuration cfg;

    if (configuration == null) begin
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
        configuration.settings = p_sequencer.settings;
        if (!configuration.randomize())
            `uvm_fatal("DW_SPI", "flash_read: failed to randomize configuration")
    end
    configuration.settings = p_sequencer.settings;
    cfg = configuration;
    command = create_read_command(cfg);
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_read start: address=0x%08h length=%0d addr_bytes=%0d opcode=0x%02h dummy_cycles=%0d lanes=%0d speed=%0dx frame=%s cs_mode=%s{% if internal_dma or external_dma %} use_dma=%0b{% endif %}",
        address,
        length,
        cfg.addr_bytes,
        command.opcode,
        command.dummy_cycles,
        cfg.io_lanes,
        cfg.speed_multiplier,
        cfg.frame_mode.name(),
        cfg.cs_control_mode.name(){% if internal_dma or external_dma %},
        cfg.use_dma{% endif %}), UVM_HIGH)
    adapter = {{ class_prefix }}flash_command_adapter::type_id::create("flash_command_adapter");
    begin
        byte unsigned empty_payload[];
        empty_payload = new[0];
        op_req = adapter.create_transfer_req(
            command, cfg, "read_req", address, UVM_TLM_READ_COMMAND, empty_payload, length{% if internal_dma or external_dma %}, cfg.use_dma{% endif %});
    end
    `uvm_info("DW_SPI_FLASH", "starting primitive transfer for flash read", UVM_HIGH)
    `uvm_info("DW_SPI_FLASH", {"flash read command:\n", command.sprint()}, UVM_LOW)
    `uvm_info("DW_SPI_FLASH", {"flash read transfer req:\n", op_req.sprint()}, UVM_LOW)
    op_seq = {{ class_prefix }}transfer_seq::type_id::create("transfer");
    op_seq.req = op_req;
    op_seq.start(p_sequencer);
    op_rsp = op_seq.rsp;
    ok = op_rsp != null && op_rsp.ok;
    data.delete();
    if (op_rsp != null)
        data = op_rsp.read_data;
    if (ok) begin
        `uvm_info("DW_SPI_FLASH", "checking flash read actual data against scoreboard", UVM_HIGH)
        ok = p_sequencer.scoreboard.check_actual_read(address, data, "flash_read_actual");
    end
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_read done: ok=%0b address=0x%08h requested=%0d received=%0d opcode=0x%02h",
        ok, address, length, data.size(), op_req.opcode), UVM_HIGH)
endtask

`endif
