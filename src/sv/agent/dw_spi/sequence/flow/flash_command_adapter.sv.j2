`ifndef {{ (class_prefix ~ "flash_command_adapter") | upper }}
`define {{ (class_prefix ~ "flash_command_adapter") | upper }}

class {{ class_prefix }}flash_command_adapter extends {{ class_prefix }}base_object;
    `uvm_object_utils({{ class_prefix }}flash_command_adapter)

    // Creates a flash-command adapter.
    function new(string name="{{ class_prefix }}flash_command_adapter");
        super.new(name);
    endfunction

    // Converts a command packet and transfer settings into a primitive request.
    function {{ class_prefix }}transfer_req create_transfer_req(
            {{ class_prefix }}flash_command command,
            {{ class_prefix }}transfer_configuration cfg,
            string req_name,
            bit [31:0] addr,
            uvm_tlm_command_e payload_command,
            byte unsigned payload_data[],
            int payload_length{% if internal_dma or external_dma %},
            bit use_dma{% endif %});
        {{ class_prefix }}transfer_req op_req;

        if (command == null)
            `uvm_fatal("DW_SPI_FLASH", "flash command is null")
        if (cfg == null)
            `uvm_fatal("DW_SPI_FLASH", "transfer configuration is null")

        op_req = {{ class_prefix }}transfer_req::type_id::create(req_name);
        op_req.payload = uvm_tlm_generic_payload::type_id::create({req_name, "_payload"});
        op_req.payload.set_command(payload_command);
        op_req.payload.set_address(addr);
        if (payload_command == UVM_TLM_WRITE_COMMAND && payload_data.size() != 0)
            op_req.payload.set_data(payload_data);
        op_req.payload.set_data_length(payload_length);

        if (!$cast(op_req.host_mode, cfg.host_mode))
            `uvm_fatal("DW_SPI_FLASH", "failed to cast host_mode")
        if (!$cast(op_req.protocol, FLASH_SPI))
            `uvm_fatal("DW_SPI_FLASH", "failed to cast protocol")
        if (!$cast(op_req.frame_mode, command.frame_mode))
            `uvm_fatal("DW_SPI_FLASH", "failed to cast frame_mode")
        if (!$cast(op_req.cs_control_mode, cfg.cs_control_mode))
            `uvm_fatal("DW_SPI_FLASH", "failed to cast cs_control_mode")
{%- if internal_dma %}
        if (use_dma && payload_command == UVM_TLM_READ_COMMAND &&
                command.speed_multiplier inside {2, 4}) begin
            if (!$cast(op_req.transfer_mode, RX_ONLY))
                `uvm_fatal("DW_SPI_FLASH", "failed to cast internal DMA enhanced read transfer_mode")
        end
        else if (!$cast(op_req.transfer_mode, command.transfer_mode))
            `uvm_fatal("DW_SPI_FLASH", "failed to cast transfer_mode")
{%- else %}
        if (!$cast(op_req.transfer_mode, command.transfer_mode))
            `uvm_fatal("DW_SPI_FLASH", "failed to cast transfer_mode")
{%- endif %}
        op_req.opcode = command.opcode;
        op_req.io_lanes = command.io_lanes;
        op_req.instruction_lanes = command.instruction_lanes;
        op_req.address_lanes = command.address_lanes;
        op_req.speed_multiplier = command.speed_multiplier;
        op_req.spi_mode = cfg.spi_mode;
        op_req.data_frame_bits = command.data_frame_bits;
        op_req.cs_id = cfg.cs_id;
        op_req.inst_bytes = command.inst_bytes;
        op_req.addr_bytes = command.addr_bytes;
        op_req.dummy_cycles = command.dummy_cycles;
        op_req.rx_skip_bytes = command.rx_skip_bytes;
        op_req.records_memory_write = command.records_memory_write;
{%- if internal_dma or external_dma %}
        op_req.use_dma = use_dma;
{%- endif %}
{%- if internal_dma %}
        op_req.axi_addr = cfg.axi_addr;
        if (use_dma) begin
            if (cfg.axi_addr == 0 || cfg.axi_addr[1:0] != 2'b00)
                `uvm_fatal("DW_SPI_DMA", $sformatf(
                    "internal DMA axi_addr must be nonzero and 4-byte aligned: axi_addr=0x%08h",
                    cfg.axi_addr))
            if (!(payload_command inside {UVM_TLM_READ_COMMAND, UVM_TLM_WRITE_COMMAND}))
                `uvm_fatal("DW_SPI_DMA", $sformatf(
                    "internal DMA does not support payload command %s",
                    payload_command.name()))
            op_req.awlen = 4'hf;
            op_req.arlen = 4'hf;
            `uvm_info("DW_SPI_DMA", $sformatf(
                "configured internal DMA maximum AXI burst lengths: awlen=%0d arlen=%0d",
                op_req.awlen, op_req.arlen), UVM_DEBUG)
        end
{%- endif %}
        op_req.update_print_summary();
        return op_req;
    endfunction
endclass

`endif
