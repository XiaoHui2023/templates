`ifndef {{ (class_prefix ~ "flash_write_seq") | upper }}
`define {{ (class_prefix ~ "flash_write_seq") | upper }}

class {{ class_prefix }}flash_write_seq extends {{ class_prefix }}spec#(uvm_sequence);
    `uvm_object_utils_begin({{ class_prefix }}flash_write_seq)
        `uvm_field_int(address, UVM_ALL_ON | UVM_HEX)
        `uvm_field_queue_int(data, UVM_ALL_ON | UVM_HEX)
        `uvm_field_object(configuration, UVM_ALL_ON)
        `uvm_field_int(ok, UVM_ALL_ON)
        `uvm_field_int(bytes_written, UVM_ALL_ON | UVM_DEC)
    `uvm_object_utils_end
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    rand bit [31:0] address;
    rand bit [7:0] data[$];
    {{ class_prefix }}transfer_configuration configuration;
    bit ok;
    int bytes_written;

    function new(string name="{{ class_prefix }}flash_write_seq");
        super.new(name);
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
    endfunction

    extern virtual task body();
    extern task run_write_enable(output bit ok);
    extern task run_program(bit [31:0] addr, bit [7:0] program_data[$], output bit ok);
    extern function bit [7:0] page_program_opcode(int speed_multiplier);
endclass

function bit [7:0] {{ class_prefix }}flash_write_seq::page_program_opcode(
        int speed_multiplier);
    case (speed_multiplier)
        1: return 8'h02;
        2: return 8'hA2;
        4: return 8'h32;
        default: begin
            `uvm_fatal("DW_SPI", $sformatf(
                "unsupported flash write speed_multiplier=%0d",
                speed_multiplier))
            return 8'h02;
        end
    endcase
endfunction

task {{ class_prefix }}flash_write_seq::run_write_enable(output bit ok);
    {{ class_prefix }}transfer_req op_req;
    {{ class_prefix }}transfer_rsp op_rsp;
    {{ class_prefix }}transfer_seq op_seq;
    {{ class_prefix }}transfer_configuration cfg;

    cfg = configuration;
    op_req = {{ class_prefix }}transfer_req::type_id::create("op_req");
    op_req.payload = uvm_tlm_generic_payload::type_id::create("payload");
    op_req.payload.set_command(UVM_TLM_WRITE_COMMAND);
    op_req.payload.set_address(0);
    op_req.payload.set_data_length(0);
    if (!$cast(op_req.host_mode, cfg.host_mode))
        `uvm_fatal("DW_SPI", "flash_write: failed to cast write-enable host_mode")
    if (!$cast(op_req.protocol, FLASH_SPI))
        `uvm_fatal("DW_SPI", "flash_write: failed to cast write-enable protocol")
    if (!$cast(op_req.frame_mode, cfg.frame_mode))
        `uvm_fatal("DW_SPI", "flash_write: failed to cast write-enable frame_mode")
    if (!$cast(op_req.cs_control_mode, cfg.cs_control_mode))
        `uvm_fatal("DW_SPI", "flash_write: failed to cast write-enable cs_control_mode")
    if (!$cast(op_req.transfer_mode, TX_ONLY))
        `uvm_fatal("DW_SPI", "flash_write: failed to cast write-enable transfer_mode")
    op_req.opcode = 8'h06;
    op_req.io_lanes = cfg.io_lanes;
    op_req.speed_multiplier = cfg.speed_multiplier;
    op_req.spi_mode = cfg.spi_mode;
    op_req.data_frame_bits = cfg.data_frame_bits;
    op_req.cs_id = cfg.cs_id;
    op_req.inst_bytes = 1;
    op_req.addr_bytes = 0;
{% if internal_dma or external_dma %}
    op_req.use_dma = 1'b0;
{% endif %}
{% if internal_dma %}
    op_req.awlen = cfg.awlen;
    op_req.arlen = cfg.arlen;
    op_req.axi_addr = cfg.axi_addr;
{% endif %}
    `uvm_info("DW_SPI_FLASH", "starting write-enable command before flash program", UVM_LOW)
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "write-enable request detail: opcode=0x%02h mode=%s frame=%s cs_mode=%s cs=%0d lanes=%0d speed=%0dx dfs_bits=%0d",
        op_req.opcode,
        op_req.transfer_mode.name(),
        op_req.frame_mode.name(),
        op_req.cs_control_mode.name(),
        op_req.cs_id,
        op_req.io_lanes,
        op_req.speed_multiplier,
        op_req.data_frame_bits), UVM_LOW)
    op_seq = {{ class_prefix }}transfer_seq::type_id::create("write_enable");
    op_seq.req = op_req;
    op_seq.start(p_sequencer);
    op_rsp = op_seq.rsp;
    ok = op_rsp != null && op_rsp.ok;
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_write write-enable done: ok=%0b cs=%0d",
        ok, cfg.cs_id), UVM_LOW)
endtask

task {{ class_prefix }}flash_write_seq::run_program(
        bit [31:0] addr,
        bit [7:0] program_data[$],
        output bit ok);
    {{ class_prefix }}transfer_req op_req;
    {{ class_prefix }}transfer_rsp op_rsp;
    {{ class_prefix }}transfer_seq op_seq;
    {{ class_prefix }}transfer_configuration cfg;
    byte unsigned payload_data[];

    cfg = configuration;
    op_req = {{ class_prefix }}transfer_req::type_id::create("op_req");
    op_req.payload = uvm_tlm_generic_payload::type_id::create("payload");
    op_req.payload.set_command(UVM_TLM_WRITE_COMMAND);
    op_req.payload.set_address(addr);
    payload_data = new[program_data.size()];
    foreach (program_data[i])
        payload_data[i] = program_data[i];
    op_req.payload.set_data(payload_data);
    if (!$cast(op_req.host_mode, cfg.host_mode))
        `uvm_fatal("DW_SPI", "flash_write: failed to cast host_mode")
    if (!$cast(op_req.protocol, FLASH_SPI))
        `uvm_fatal("DW_SPI", "flash_write: failed to cast protocol")
    if (!$cast(op_req.frame_mode, cfg.frame_mode))
        `uvm_fatal("DW_SPI", "flash_write: failed to cast frame_mode")
    if (!$cast(op_req.cs_control_mode, cfg.cs_control_mode))
        `uvm_fatal("DW_SPI", "flash_write: failed to cast cs_control_mode")
    if (!$cast(op_req.transfer_mode, TX_AND_RX))
        `uvm_fatal("DW_SPI", "flash_write: failed to cast transfer_mode")
    op_req.opcode = page_program_opcode(cfg.speed_multiplier);
    op_req.io_lanes = cfg.io_lanes;
    op_req.speed_multiplier = cfg.speed_multiplier;
    op_req.spi_mode = cfg.spi_mode;
    op_req.data_frame_bits = cfg.data_frame_bits;
    op_req.cs_id = cfg.cs_id;
    op_req.inst_bytes = 1;
    op_req.addr_bytes = cfg.addr_bytes;
    op_req.dummy_cycles = cfg.dummy_cycles;
{% if internal_dma or external_dma %}
    op_req.use_dma = cfg.use_dma;
{% endif %}
{% if internal_dma %}
    op_req.awlen = cfg.awlen;
    op_req.arlen = cfg.arlen;
    op_req.axi_addr = cfg.axi_addr;
{% endif %}
    `uvm_info("DW_SPI_FLASH", "starting flash program data transfer", UVM_LOW)
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash program request detail: opcode=0x%02h mode=%s frame=%s cs_mode=%s addr=0x%08h bytes=%0d inst_bytes=%0d addr_bytes=%0d dummy_cycles=%0d cs=%0d lanes=%0d speed=%0dx dfs_bits=%0d{% if internal_dma or external_dma %} use_dma=%0b{% endif %}{% if internal_dma %} axi_addr=0x%08h awlen=%0d arlen=%0d{% endif %}",
        op_req.opcode,
        op_req.transfer_mode.name(),
        op_req.frame_mode.name(),
        op_req.cs_control_mode.name(),
        addr,
        program_data.size(),
        op_req.inst_bytes,
        op_req.addr_bytes,
        op_req.dummy_cycles,
        op_req.cs_id,
        op_req.io_lanes,
        op_req.speed_multiplier,
        op_req.data_frame_bits{% if internal_dma or external_dma %},
        op_req.use_dma{% endif %}{% if internal_dma %},
        op_req.axi_addr,
        op_req.awlen,
        op_req.arlen{% endif %}), UVM_LOW)
    op_seq = {{ class_prefix }}transfer_seq::type_id::create("transfer");
    op_seq.req = op_req;
    op_seq.start(p_sequencer);
    op_rsp = op_seq.rsp;
    ok = op_rsp != null && op_rsp.ok;
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_write program transfer done: ok=%0b address=0x%08h bytes=%0d opcode=0x%02h{% if internal_dma or external_dma %} use_dma=%0b{% endif %}",
        ok,
        addr,
        program_data.size(),
        op_req.opcode{% if internal_dma or external_dma %},
        op_req.use_dma{% endif %}), UVM_LOW)
endtask

task {{ class_prefix }}flash_write_seq::body();
    bit chunk_ok;

    if (configuration == null) begin
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
        configuration.settings = p_sequencer.settings;
        if (!configuration.randomize())
            `uvm_fatal("DW_SPI", "flash_write: failed to randomize configuration")
    end
    configuration.settings = p_sequencer.settings;
    ok = 1'b1;
    bytes_written = 0;
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_write start: address=0x%08h bytes=%0d addr_bytes=%0d dummy_cycles=%0d lanes=%0d speed=%0dx frame=%s cs_mode=%s{% if internal_dma or external_dma %} use_dma=%0b{% endif %}",
        address,
        data.size(),
        configuration.addr_bytes,
        configuration.dummy_cycles,
        configuration.io_lanes,
        configuration.speed_multiplier,
        configuration.frame_mode.name(),
        configuration.cs_control_mode.name(){% if internal_dma or external_dma %},
        configuration.use_dma{% endif %}), UVM_LOW)
    if (data.size() == 0)
        `uvm_fatal("DW_SPI", "flash_write requires non-empty data; use rw_test empty write_data only for random default data")

    `uvm_info("DW_SPI_FLASH",
        "flash_write flow will issue one write-enable followed by one continuous program transaction", UVM_LOW)
    run_write_enable(chunk_ok);
    if (!chunk_ok) begin
        ok = 1'b0;
    end else begin
        `uvm_info("DW_SPI_FLASH",
            "write-enable succeeded; starting one continuous program transaction", UVM_LOW)
        run_program(address, data, chunk_ok);
        ok = chunk_ok;
        if (chunk_ok)
            bytes_written = data.size();
    end
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_write done: ok=%0b address=0x%08h bytes_written=%0d",
        ok, address, bytes_written), UVM_LOW)
endtask

`endif
