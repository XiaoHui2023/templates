`ifndef {{ (class_prefix ~ "flash_write_seq") | upper }}
`define {{ (class_prefix ~ "flash_write_seq") | upper }}

class {{ class_prefix }}flash_write_seq extends {{ class_prefix }}spec#(uvm_sequence);
    `uvm_object_utils_begin({{ class_prefix }}flash_write_seq)
        `uvm_field_int(address, UVM_ALL_ON | UVM_HEX)
        `uvm_field_queue_int(data, UVM_ALL_ON | UVM_HEX)
        `uvm_field_object(configuration, UVM_ALL_ON)
        `uvm_field_int(ok, UVM_ALL_ON)
        `uvm_field_int(bytes_written, UVM_ALL_ON | UVM_DEC)
    `uvm_object_utils_end
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    rand bit [31:0] address;
    rand bit [7:0] data[$];
    {{ class_prefix }}transfer_configuration configuration;
    bit ok;
    int bytes_written;

    function new(string name="{{ class_prefix }}flash_write_seq");
        super.new(name);
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
    endfunction

    extern virtual task body();
    extern task run_write_enable(output bit ok);
    extern task run_write_status_qe(output bit ok);
    extern task run_program(bit [31:0] addr, bit [7:0] program_data[$], output bit ok);
    extern function {{ class_prefix }}flash_command create_program_command(
        {{ class_prefix }}transfer_configuration cfg);
endclass

function {{ class_prefix }}flash_command {{ class_prefix }}flash_write_seq::create_program_command(
        {{ class_prefix }}transfer_configuration cfg);
    {{ class_prefix }}flash_command command;

    if (cfg == null)
        `uvm_fatal("DW_SPI", "flash_write: configuration is null")
    case (cfg.speed_multiplier)
        1: command = {{ class_prefix }}page_program_flash_command::type_id::create("page_program_command");
        2: command = {{ class_prefix }}dual_page_program_flash_command::type_id::create("dual_page_program_command");
        4: command = {{ class_prefix }}quad_page_program_flash_command::type_id::create("quad_page_program_command");
        default: begin
            `uvm_fatal("DW_SPI", $sformatf(
                "unsupported flash write speed_multiplier=%0d",
                cfg.speed_multiplier))
        end
    endcase
    if (!command.randomize() with {
            frame_mode == local::cfg.frame_mode;
            addr_bytes == local::cfg.addr_bytes;
            dummy_cycles == 0;
            data_frame_bits == local::cfg.data_frame_bits;
        })
        `uvm_fatal("DW_SPI", "flash_write: failed to randomize program flash command")
    return command;
endfunction

task {{ class_prefix }}flash_write_seq::run_write_enable(output bit ok);
    {{ class_prefix }}write_enable_flash_command command;
    {{ class_prefix }}flash_command_adapter adapter;
    {{ class_prefix }}transfer_req op_req;
    {{ class_prefix }}transfer_rsp op_rsp;
    {{ class_prefix }}transfer_seq op_seq;
    {{ class_prefix }}transfer_configuration cfg;
    byte unsigned payload_data[];

    cfg = configuration;
    command = {{ class_prefix }}write_enable_flash_command::type_id::create("write_enable_command");
    if (!command.randomize() with {
            frame_mode == local::cfg.frame_mode;
        })
        `uvm_fatal("DW_SPI", "flash_write: failed to randomize write-enable flash command")
    adapter = {{ class_prefix }}flash_command_adapter::type_id::create("flash_command_adapter");
    payload_data = new[0];
    op_req = adapter.create_transfer_req(
        command, cfg, "write_enable_req", 32'h0, UVM_TLM_WRITE_COMMAND, payload_data, 0{% if internal_dma or external_dma %}, 1'b0{% endif %});
    `uvm_info("DW_SPI_FLASH", "starting write-enable command before flash program", UVM_HIGH)
    `uvm_info("DW_SPI_FLASH", {"write-enable flash command:\n", command.sprint()}, UVM_LOW)
    `uvm_info("DW_SPI_FLASH", {"write-enable transfer req:\n", op_req.sprint()}, UVM_LOW)
    op_seq = {{ class_prefix }}transfer_seq::type_id::create("write_enable");
    op_seq.req = op_req;
    op_seq.start(p_sequencer);
    op_rsp = op_seq.rsp;
    ok = op_rsp != null && op_rsp.ok;
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_write write-enable done: ok=%0b cs=%0d",
        ok, cfg.cs_id), UVM_HIGH)
endtask

task {{ class_prefix }}flash_write_seq::run_write_status_qe(output bit ok);
    {{ class_prefix }}write_status_qe_flash_command command;
    {{ class_prefix }}flash_command_adapter adapter;
    {{ class_prefix }}transfer_req op_req;
    {{ class_prefix }}transfer_rsp op_rsp;
    {{ class_prefix }}transfer_seq op_seq;
    {{ class_prefix }}transfer_configuration cfg;
    byte unsigned payload_data[];

    cfg = configuration;
    command = {{ class_prefix }}write_status_qe_flash_command::type_id::create("write_status_qe_command");
    if (!command.randomize() with {
            frame_mode == local::cfg.frame_mode;
        })
        `uvm_fatal("DW_SPI", "flash_write: failed to randomize write-status QE flash command")
    adapter = {{ class_prefix }}flash_command_adapter::type_id::create("flash_command_adapter");
    payload_data = new[2];
    payload_data[0] = 8'h00;
    payload_data[1] = 8'h02;
    op_req = adapter.create_transfer_req(
        command, cfg, "write_status_qe_req", 32'h0, UVM_TLM_WRITE_COMMAND, payload_data, 2{% if internal_dma or external_dma %}, 1'b0{% endif %});
    `uvm_info("DW_SPI_FLASH", "starting write-status command to set QE before QPP", UVM_HIGH)
    `uvm_info("DW_SPI_FLASH", {"write-status QE flash command:\n", command.sprint()}, UVM_LOW)
    `uvm_info("DW_SPI_FLASH", {"write-status QE transfer req:\n", op_req.sprint()}, UVM_LOW)
    op_seq = {{ class_prefix }}transfer_seq::type_id::create("write_status_qe");
    op_seq.req = op_req;
    op_seq.start(p_sequencer);
    op_rsp = op_seq.rsp;
    ok = op_rsp != null && op_rsp.ok;
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_write WRSR QE done: ok=%0b cs=%0d status16=0x%04h",
        ok, cfg.cs_id, 16'h0200), UVM_HIGH)
endtask

task {{ class_prefix }}flash_write_seq::run_program(
        bit [31:0] addr,
        bit [7:0] program_data[$],
        output bit ok);
    {{ class_prefix }}flash_command command;
    {{ class_prefix }}flash_command_adapter adapter;
    {{ class_prefix }}transfer_req op_req;
    {{ class_prefix }}transfer_rsp op_rsp;
    {{ class_prefix }}transfer_seq op_seq;
    {{ class_prefix }}transfer_configuration cfg;
    byte unsigned payload_data[];

    cfg = configuration;
    command = create_program_command(cfg);
    adapter = {{ class_prefix }}flash_command_adapter::type_id::create("flash_command_adapter");
    payload_data = new[program_data.size()];
    foreach (program_data[i])
        payload_data[i] = program_data[i];
    op_req = adapter.create_transfer_req(
        command, cfg, "program_req", addr, UVM_TLM_WRITE_COMMAND, payload_data, program_data.size(){% if internal_dma or external_dma %}, cfg.use_dma && command.records_memory_write{% endif %});
    `uvm_info("DW_SPI_FLASH", "starting flash program data transfer", UVM_HIGH)
    `uvm_info("DW_SPI_FLASH", {"flash program command:\n", command.sprint()}, UVM_LOW)
    `uvm_info("DW_SPI_FLASH", {"flash program transfer req:\n", op_req.sprint()}, UVM_LOW)
    op_seq = {{ class_prefix }}transfer_seq::type_id::create("transfer");
    op_seq.req = op_req;
    op_seq.start(p_sequencer);
    op_rsp = op_seq.rsp;
    ok = op_rsp != null && op_rsp.ok;
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_write program transfer done: ok=%0b address=0x%08h bytes=%0d opcode=0x%02h{% if internal_dma or external_dma %} use_dma=%0b{% endif %}",
        ok,
        addr,
        program_data.size(),
        op_req.opcode{% if internal_dma or external_dma %},
        op_req.use_dma{% endif %}), UVM_HIGH)
endtask

task {{ class_prefix }}flash_write_seq::body();
    bit chunk_ok;
    bit qe_ok;

    if (configuration == null) begin
        configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
        configuration.settings = p_sequencer.settings;
        if (!configuration.randomize())
            `uvm_fatal("DW_SPI", "flash_write: failed to randomize configuration")
    end
    configuration.settings = p_sequencer.settings;
    ok = 1'b1;
    bytes_written = 0;
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_write start: address=0x%08h bytes=%0d addr_bytes=%0d program_dummy_cycles=0 lanes=%0d speed=%0dx frame=%s cs_mode=%s{% if internal_dma or external_dma %} use_dma=%0b{% endif %}",
        address,
        data.size(),
        configuration.addr_bytes,
        configuration.io_lanes,
        configuration.speed_multiplier,
        configuration.frame_mode.name(),
        configuration.cs_control_mode.name(){% if internal_dma or external_dma %},
        configuration.use_dma{% endif %}), UVM_HIGH)
    if (data.size() == 0)
        `uvm_fatal("DW_SPI", "flash_write requires non-empty data; use rw_test empty write_data only for random default data")

    if (configuration.speed_multiplier == 4) begin
        `uvm_info("DW_SPI_FLASH",
            "QPP flow: WREN -> WRSR(QE=1) -> WREN -> one continuous QPP transaction", UVM_HIGH)
        run_write_enable(chunk_ok);
        if (!chunk_ok) begin
            ok = 1'b0;
        end
        else begin
            run_write_status_qe(qe_ok);
            if (!qe_ok) begin
                ok = 1'b0;
            end
            else begin
                `uvm_info("DW_SPI_FLASH",
                    "WRSR may clear WEL; issuing WREN again before QPP", UVM_HIGH)
                run_write_enable(chunk_ok);
                if (!chunk_ok)
                    ok = 1'b0;
            end
        end
    end
    else begin
        `uvm_info("DW_SPI_FLASH",
            "flash_write flow will issue one write-enable followed by one continuous program transaction", UVM_HIGH)
        run_write_enable(chunk_ok);
        if (!chunk_ok)
            ok = 1'b0;
    end

    if (ok) begin
        `uvm_info("DW_SPI_FLASH",
            "write-enable is active; starting one continuous program transaction", UVM_HIGH)
        run_program(address, data, chunk_ok);
        ok = chunk_ok;
        if (chunk_ok)
            bytes_written = data.size();
    end
    `uvm_info("DW_SPI_FLASH", $sformatf(
        "flash_write done: ok=%0b address=0x%08h bytes_written=%0d",
        ok, address, bytes_written), UVM_HIGH)
endtask

`endif
