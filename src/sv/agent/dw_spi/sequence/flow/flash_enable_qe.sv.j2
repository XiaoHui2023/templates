`ifndef {{ (class_prefix ~ "flash_enable_qe_seq") | upper }}
`define {{ (class_prefix ~ "flash_enable_qe_seq") | upper }}

class {{ class_prefix }}flash_enable_qe_seq extends {{ class_prefix }}base_seq;
    `uvm_object_utils_begin({{ class_prefix }}flash_enable_qe_seq)
        `uvm_field_object(configuration, UVM_ALL_ON)
        `uvm_field_int(ok, UVM_ALL_ON)
    `uvm_object_utils_end
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    {{ class_prefix }}transfer_configuration configuration;
    bit ok;

    // Creates a QE-enable flow.
    function new(string name="{{ class_prefix }}flash_enable_qe_seq");
        super.new(name);
    endfunction

    // Executes WREN followed by the QE status-register write.
    extern virtual task body();
    // Executes one command packet and reports transfer success.
    extern protected task run_command(
        input {{ class_prefix }}flash_command command,
        input string req_name,
        input byte unsigned payload_data[],
        output bit command_ok);
endclass

task {{ class_prefix }}flash_enable_qe_seq::run_command(
        input {{ class_prefix }}flash_command command,
        input string req_name,
        input byte unsigned payload_data[],
        output bit command_ok);
    {{ class_prefix }}flash_command_adapter adapter;
    {{ class_prefix }}transfer_req op_req;
    {{ class_prefix }}transfer_rsp op_rsp;
    {{ class_prefix }}transfer_seq op_seq;

    adapter = {{ class_prefix }}flash_command_adapter::type_id::create({req_name, "_adapter"});
    op_req = adapter.create_transfer_req(
        command, configuration, req_name, 32'h0, UVM_TLM_WRITE_COMMAND,
        payload_data, payload_data.size(){% if internal_dma or external_dma %}, 1'b0{% endif %});
    `uvm_info("DW_SPI_FLASH", {req_name, " command:\n", command.sprint()}, UVM_LOW)
    `uvm_info("DW_SPI_FLASH", {req_name, " transfer req:\n", op_req.sprint()}, UVM_LOW)
    op_seq = {{ class_prefix }}transfer_seq::type_id::create({req_name, "_transfer"});
    op_seq.req = op_req;
    op_seq.start(p_sequencer);
    op_rsp = op_seq.rsp;
    command_ok = op_rsp != null && op_rsp.ok;
endtask

task {{ class_prefix }}flash_enable_qe_seq::body();
    {{ class_prefix }}write_enable_flash_command wren_command;
    {{ class_prefix }}write_status_qe_flash_command wrsr_command;
    {{ class_prefix }}transfer_configuration cfg;
    byte unsigned empty_payload[];
    byte unsigned status_payload[];
    bit command_ok;

    if (configuration == null)
        `uvm_fatal("DW_SPI_FLASH", "flash_enable_qe: configuration is null")
    configuration.settings = p_sequencer.settings;
    cfg = configuration;
    ok = 1'b1;

    wren_command = {{ class_prefix }}write_enable_flash_command::type_id::create("write_enable_command");
    if (!wren_command.randomize() with {
            frame_mode == local::cfg.frame_mode;
        })
        `uvm_fatal("DW_SPI_FLASH", "flash_enable_qe: failed to randomize WREN command")
    empty_payload = new[0];
    `uvm_info("DW_SPI_FLASH", "QE-enable flow issuing WREN", UVM_LOW)
    run_command(wren_command, "qe_write_enable", empty_payload, command_ok);
    if (!command_ok) begin
        ok = 1'b0;
        `uvm_error("DW_SPI_FLASH", "QE-enable WREN failed")
        return;
    end

    wrsr_command = {{ class_prefix }}write_status_qe_flash_command::type_id::create("write_status_qe_command");
    if (!wrsr_command.randomize() with {
            frame_mode == local::cfg.frame_mode;
        })
        `uvm_fatal("DW_SPI_FLASH", "flash_enable_qe: failed to randomize WRSR command")
    status_payload = new[2];
    status_payload[0] = 8'h00;
    status_payload[1] = 8'h02;
    `uvm_info("DW_SPI_FLASH", "QE-enable flow issuing WRSR with status16=0x0200", UVM_LOW)
    run_command(wrsr_command, "qe_write_status", status_payload, command_ok);
    if (!command_ok) begin
        ok = 1'b0;
        `uvm_error("DW_SPI_FLASH", "QE-enable WRSR failed")
        return;
    end
    `uvm_info("DW_SPI_FLASH", "QE-enable flow completed", UVM_LOW)
endtask

`endif
