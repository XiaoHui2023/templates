`ifndef {{ (class_prefix ~ "interface") | upper }}
`define {{ (class_prefix ~ "interface") | upper }}

interface {{ class_prefix }}interface(
        input logic hclk,
        input logic ssi_clk,
        input logic intr);
    timeunit 1ns;
    timeprecision 1fs;

    {{ class_prefix }}clock_if hclk_if(.clk(hclk));
    {{ class_prefix }}clock_if ssi_clk_if(.clk(ssi_clk));
    {{ class_prefix }}interrupt_if interrupt_if(.intr(intr));

    function bit has_hclk();
        return hclk_if.is_connected();
    endfunction

    function bit has_ssi_clk();
        return ssi_clk_if.is_connected();
    endfunction

    function bit has_irq();
        return interrupt_if.is_connected();
    endfunction

    function int unsigned baudr_for_target(real input_hz, real target_hz);
        int unsigned div;

        if (input_hz <= 0.0 || target_hz <= 0.0)
            return 0;
        div = int'($ceil(input_hz / target_hz));
        if (div < 2)
            div = 2;
        if (div[0])
            div++;
        return div;
    endfunction

    task automatic measure_hclk_frequency_hz(output real frequency_hz);
        hclk_if.measure_frequency_hz(frequency_hz);
    endtask

    task automatic measure_ssi_clk_frequency_hz(output real frequency_hz);
        ssi_clk_if.measure_frequency_hz(frequency_hz);
    endtask
endinterface

`endif
