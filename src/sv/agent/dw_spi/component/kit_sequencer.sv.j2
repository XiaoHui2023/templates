task {{ class_prefix }}kit_sequencer::init_registers({{ class_prefix }}transfer_req transfer_req);
    {{ class_prefix }}init_registers_req req;
    {{ class_prefix }}init_registers_rsp seq_rsp;
    {{ class_prefix }}init_registers_seq seq;

    req = {{ class_prefix }}init_registers_req::type_id::create("req");
    req.transfer_req = transfer_req;
    seq = {{ class_prefix }}init_registers_seq::type_id::create("init_registers");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp == null || !seq_rsp.ok)
        `uvm_fatal("DW_SPI", "init_registers failed")
endtask

task {{ class_prefix }}kit_sequencer::flash_write(
        bit [31:0] address,
        bit [7:0] data[$],
        int unsigned io_lanes = {{ default_io_lanes }},
        int unsigned speed_multiplier = {{ default_speed_multiplier }},
        int unsigned spi_mode = {{ default_spi_mode }},
        int unsigned data_frame_bits = {{ default_data_frame_bits }},
        int unsigned cs_id = {{ default_cs }},
        int unsigned addr_bytes = {{ default_addr_bytes }},
        bit use_dma = {{ "1'b1" if default_use_dma else "1'b0" }});
    {{ class_prefix }}flash_write_req req;
    {{ class_prefix }}flash_write_rsp seq_rsp;
    {{ class_prefix }}flash_write_seq seq;

    req = {{ class_prefix }}flash_write_req::type_id::create("req");
    req.address = address;
    req.data = data;
    req.configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
    if (!req.configuration.randomize() with {
            io_lanes == local::io_lanes;
            speed_multiplier == local::speed_multiplier;
            spi_mode == local::spi_mode;
            data_frame_bits == local::data_frame_bits;
            cs_id == local::cs_id;
            addr_bytes == local::addr_bytes;
            use_dma == local::use_dma;
        })
        `uvm_fatal("DW_SPI", "failed to randomize flash_write configuration")
    seq = {{ class_prefix }}flash_write_seq::type_id::create("flash_write");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp == null || !seq_rsp.ok)
        `uvm_fatal("DW_SPI", "flash_write failed")
endtask

