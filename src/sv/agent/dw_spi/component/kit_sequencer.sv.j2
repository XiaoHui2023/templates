task {{ settings.class_prefix }}kit_sequencer::flash_read(
        output bit [7:0] data[$],
        bit [63:0] address,
        int unsigned length);
    {{ settings.class_prefix }}flash_read_req req;
    {{ settings.class_prefix }}flash_read_rsp seq_rsp;
    {{ settings.class_prefix }}flash_read_seq seq;

    data.delete();
    req = {{ settings.class_prefix }}flash_read_req::type_id::create("req");
    req.address = address;
    req.length = length;
    req.io_lanes = settings.default_io_lanes;
    req.speed_multiplier = settings.default_speed_multiplier;
    req.spi_mode = settings.default_spi_mode;
    req.data_frame_bits = settings.default_data_frame_bits;
    req.cs_id = settings.default_cs;
    req.addr_bytes = settings.default_addr_bytes;
    req.frame_mode = settings.default_frame_mode;
    req.dummy_cycles = settings.default_frame_mode == {{ settings.class_prefix }}settings::ENHANCED ? 8 : 0;
    seq = {{ settings.class_prefix }}flash_read_seq::type_id::create("flash_read");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp == null || !seq_rsp.ok)
        `uvm_fatal("DW_SPI", "flash_read failed")
    data = seq_rsp.data;
endtask

