task {{ class_prefix }}kit_sequencer::init_registers({{ class_prefix }}transfer_req transfer_req);
    {{ class_prefix }}init_registers_req req;
    {{ class_prefix }}init_registers_rsp seq_rsp;
    {{ class_prefix }}init_registers_seq seq;

    req = {{ class_prefix }}init_registers_req::type_id::create("req");
    req.transfer_req = transfer_req;
    seq = {{ class_prefix }}init_registers_seq::type_id::create("init_registers");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp == null || !seq_rsp.ok)
        `uvm_fatal("DW_SPI", "init_registers failed")
endtask

function {{ class_prefix }}host_configuration {{ class_prefix }}kit_sequencer::build_host_configuration(
        int unsigned io_lanes = {{ default_io_lanes }},
        int unsigned speed_multiplier = {{ default_speed_multiplier }},
        int unsigned spi_mode = {{ default_spi_mode }},
        int unsigned data_frame_bits = {{ default_data_frame_bits }},
        int unsigned cs_id = {{ default_cs }},
        int unsigned addr_bytes = {{ default_addr_bytes }});
    {{ class_prefix }}host_configuration cfg;

    cfg = {{ class_prefix }}host_configuration::type_id::create("configuration");
    cfg.io_lanes = io_lanes;
    cfg.speed_multiplier = speed_multiplier;
    cfg.spi_mode = spi_mode;
    cfg.data_frame_bits = data_frame_bits;
    cfg.cs_id = cs_id;
    cfg.addr_bytes = addr_bytes;
    cfg.io_lanes.rand_mode(0);
    cfg.speed_multiplier.rand_mode(0);
    cfg.spi_mode.rand_mode(0);
    cfg.data_frame_bits.rand_mode(0);
    cfg.cs_id.rand_mode(0);
    cfg.addr_bytes.rand_mode(0);
    if (!cfg.randomize())
        `uvm_fatal("DW_SPI", "failed to randomize host transfer configuration")
    return cfg;
endfunction

