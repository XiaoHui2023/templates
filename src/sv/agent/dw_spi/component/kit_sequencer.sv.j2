`ifndef {{ (class_prefix ~ "kit_sequencer") | upper }}
`define {{ (class_prefix ~ "kit_sequencer") | upper }}

class {{ class_prefix }}kit_sequencer extends {{ class_prefix }}sequencer;
    `uvm_component_utils({{ class_prefix }}kit_sequencer)

    // Creates the convenience sequencer facade.
    function new(string name="{{ class_prefix }}kit_sequencer", uvm_component parent=null);
        super.new(name, parent);
    endfunction

    // Initializes controller registers for one primitive transfer request.
    extern task init_registers({{ class_prefix }}transfer_req transfer_req);
    // Runs one flash write flow.
    extern task flash_write(bit [31:0] address,
        bit [7:0] data[$],
        int speed_multiplier = {{ default_speed_multiplier }},
        int spi_mode = {{ default_spi_mode }},
        int data_frame_bits = {{ default_data_frame_bits }},
        int cs_id = {{ default_cs }},
        int addr_bytes = {{ default_addr_bytes }}{% if internal_dma or external_dma %},
        bit use_dma = 1'b0{% endif %}{% if internal_dma %},
        bit [31:0] axi_addr = 32'h1000_0000{% endif %});
    // Runs one flash read flow.
    extern task flash_read(bit [31:0] address,
        int length,
        int speed_multiplier = {{ default_speed_multiplier }},
        int spi_mode = {{ default_spi_mode }},
        int data_frame_bits = {{ default_data_frame_bits }},
        int cs_id = {{ default_cs }},
        int addr_bytes = {{ default_addr_bytes }}{% if internal_dma or external_dma %},
        bit use_dma = 1'b0{% endif %}{% if internal_dma %},
        bit [31:0] axi_addr = 32'h1000_0000{% endif %});
    // Checks all connected controller clocks.
    extern task check_clocks();
    // Runs one flash write/readback scenario.
    extern task rw_test(
        bit [31:0] address = '0,
        bit [7:0] write_data[$] = '{},
        int speed_multiplier = {{ default_speed_multiplier }},
        int spi_mode = {{ default_spi_mode }},
        int data_frame_bits = {{ default_data_frame_bits }},
        int cs_id = {{ default_cs }},
        int addr_bytes = {{ default_addr_bytes }}{% if internal_dma or external_dma %},
        bit use_dma = 1'b0{% endif %}{% if internal_dma %},
        bit [31:0] axi_addr = 32'h1000_0000{% endif %});
    // Runs all generated read/write speeds.
    extern task speed_test(
        bit [31:0] address = '0,
        bit [7:0] write_data[$] = '{},
        int spi_mode = {{ default_spi_mode }},
        int data_frame_bits = {{ default_data_frame_bits }},
        int cs_id = {{ default_cs }},
        int addr_bytes = {{ default_addr_bytes }});
{%- if internal_dma or external_dma %}
    // Runs one flash read/writeback scenario through DMA.
    extern task dma_test(
        bit [31:0] address = '0,
        bit [7:0] write_data[$] = '{},
        int speed_multiplier = {{ max_speed_multiplier }},
        int spi_mode = {{ default_spi_mode }},
        int data_frame_bits = {{ default_data_frame_bits }},
        int cs_id = {{ default_cs }},
        int addr_bytes = {{ default_addr_bytes }}{% if internal_dma %},
        bit [31:0] axi_addr = 32'h1000_0000{% endif %});
{%- endif %}
endclass

task {{ class_prefix }}kit_sequencer::init_registers({{ class_prefix }}transfer_req transfer_req);
    {{ class_prefix }}init_registers_req req;
    {{ class_prefix }}init_registers_rsp seq_rsp;
    {{ class_prefix }}init_registers_seq seq;

    req = {{ class_prefix }}init_registers_req::type_id::create("req");
    req.transfer_req = transfer_req;
    seq = {{ class_prefix }}init_registers_seq::type_id::create("init_registers");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp == null || !seq_rsp.ok)
        `uvm_error("DW_SPI", "init_registers failed")
endtask

task {{ class_prefix }}kit_sequencer::flash_write(
        bit [31:0] address,
        bit [7:0] data[$],
        int speed_multiplier = {{ default_speed_multiplier }},
        int spi_mode = {{ default_spi_mode }},
        int data_frame_bits = {{ default_data_frame_bits }},
        int cs_id = {{ default_cs }},
        int addr_bytes = {{ default_addr_bytes }}{% if internal_dma or external_dma %},
        bit use_dma = 1'b0{% endif %}{% if internal_dma %},
        bit [31:0] axi_addr = 32'h1000_0000{% endif %});
    {{ class_prefix }}flash_write_seq seq;

    seq = {{ class_prefix }}flash_write_seq::type_id::create("flash_write");
    seq.address = address;
    seq.data = data;
    seq.configuration = {{ class_prefix }}host_configuration::type_id::create("configuration");
    seq.configuration.settings = settings;
    if (!seq.configuration.randomize() with {
            speed_multiplier == local::speed_multiplier;
            spi_mode == local::spi_mode;
            data_frame_bits == local::data_frame_bits;
            cs_id == local::cs_id;
            addr_bytes == local::addr_bytes;
{%- if internal_dma or external_dma %}
            use_dma == local::use_dma;
{%- endif %}
{%- if internal_dma %}
            axi_addr == local::axi_addr;
{%- endif %}
        })
        `uvm_fatal("DW_SPI", "failed to randomize flash_write configuration")
    seq.start(this);
    if (!seq.ok)
        `uvm_error("DW_SPI", "flash_write failed")
endtask

