task {{ settings.class_prefix }}kit_sequencer::reg_write(int unsigned offset, bit [31:0] value);
    {{ settings.class_prefix }}reg_write_req req;
    {{ settings.class_prefix }}reg_write_rsp seq_rsp;
    {{ settings.class_prefix }}reg_write_seq seq;

    req = {{ settings.class_prefix }}reg_write_req::type_id::create("req");
    req.offset = offset;
    req.value = value;
    seq = {{ settings.class_prefix }}reg_write_seq::type_id::create("reg_write");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp == null || !seq_rsp.ok)
        `uvm_fatal("DW_SPI", "reg_write failed")
endtask

task {{ settings.class_prefix }}kit_sequencer::reg_read(output bit [31:0] value, int unsigned offset);
    {{ settings.class_prefix }}reg_read_req req;
    {{ settings.class_prefix }}reg_read_rsp seq_rsp;
    {{ settings.class_prefix }}reg_read_seq seq;

    value = '0;
    req = {{ settings.class_prefix }}reg_read_req::type_id::create("req");
    req.offset = offset;
    seq = {{ settings.class_prefix }}reg_read_seq::type_id::create("reg_read");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp == null || !seq_rsp.ok)
        `uvm_fatal("DW_SPI", "reg_read failed")
    value = seq_rsp.value;
endtask

