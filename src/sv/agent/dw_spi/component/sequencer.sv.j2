`ifndef {{ (settings.class_prefix ~ "sequencer") | upper }}
`define {{ (settings.class_prefix ~ "sequencer") | upper }}

class {{ settings.class_prefix }}sequencer extends uvm_sequencer;
    `uvm_component_utils({{ settings.class_prefix }}sequencer)
    `uvm_register_cb({{ settings.class_prefix }}sequencer, {{ settings.class_prefix }}callback)

    {{ settings.class_prefix }}settings settings;
    {{ settings.class_prefix }}scoreboard scoreboard;
    virtual {{ settings.class_prefix }}interface vif;

    function new(string name="{{ settings.class_prefix }}sequencer", uvm_component parent=null);
        super.new(name, parent);
        settings = {{ settings.class_prefix }}settings::type_id::create("settings");
    endfunction

    extern function void build_phase(uvm_phase phase);
    extern task activate_chip_select(int unsigned cs_id);
    extern task release_chip_select(int unsigned cs_id);
endclass

function void {{ settings.class_prefix }}sequencer::build_phase(uvm_phase phase);
    super.build_phase(phase);
    void'(uvm_config_db #({{ settings.class_prefix }}settings)::get(this, "", "settings", settings));
    void'(uvm_config_db #({{ settings.class_prefix }}scoreboard)::get(this, "", "scoreboard", scoreboard));
    void'(uvm_config_db #(virtual {{ settings.class_prefix }}interface)::get(this, "", "vif", vif));
    if (settings == null)
        `uvm_fatal("DW_SPI", "sequencer settings is null")
    if (scoreboard == null)
        `uvm_fatal("DW_SPI", "sequencer scoreboard is null")
    if (settings.vif == null)
        settings.vif = vif;
    if (vif == null)
        vif = settings.vif;
endfunction

task {{ settings.class_prefix }}sequencer::activate_chip_select(int unsigned cs_id);
    `uvm_do_obj_callbacks({{ settings.class_prefix }}sequencer, {{ settings.class_prefix }}callback, this, activate_chip_select(cs_id))
endtask

task {{ settings.class_prefix }}sequencer::release_chip_select(int unsigned cs_id);
    `uvm_do_obj_callbacks({{ settings.class_prefix }}sequencer, {{ settings.class_prefix }}callback, this, release_chip_select(cs_id))
endtask

`endif
