`ifndef {{ (class_prefix ~ "sequencer") | upper }}
`define {{ (class_prefix ~ "sequencer") | upper }}

class {{ class_prefix }}sequencer extends uvm_sequencer;
    `uvm_component_utils({{ class_prefix }}sequencer)
    `uvm_register_cb({{ class_prefix }}sequencer, {{ class_prefix }}callback)

    {{ class_prefix }}settings settings;
    {{ class_prefix }}scoreboard scoreboard;
    virtual {{ class_prefix }}interface vif;

    // Creates the base sequencer and its default settings object.
    function new(string name="{{ class_prefix }}sequencer", uvm_component parent=null);
        super.new(name, parent);
        settings = {{ class_prefix }}settings::type_id::create("settings");
    endfunction

    // Resolves shared settings, scoreboard, and interface handles.
    extern function void build_phase(uvm_phase phase);
{%- if software_cs %}
    // Dispatches one software chip-select state change to registered callbacks.
    extern task set_chip_select(input int cs_id, input bit selected);
{%- endif %}
{%- if byte_reorder %}
    // Dispatches byte ordering while preserving the input queue length.
    extern function void reorder_bytes(
        input bit [7:0] data[$],
        input bit is_read,
        output bit [7:0] reordered_data[$]);
{%- endif %}
{%- if internal_dma %}
    // Dispatches a CPU read request to registered callbacks.
    extern task cpu_read(input bit [63:0] addr, output bit [31:0] data, input uvm_path_e path);
    // Dispatches a CPU write request to registered callbacks.
    extern task cpu_write(input bit [63:0] addr, input bit [31:0] data, input uvm_path_e path);
{%- endif %}
{%- if external_dma %}
    // Dispatches external DMA arming to registered callbacks.
    extern task start_external_dma({{ class_prefix }}transfer_req transfer_req);
    // Dispatches external DMA completion and read-data collection.
    extern task finish_external_dma(
        input {{ class_prefix }}transfer_req transfer_req,
        output bit [7:0] read_data[$],
        output bit ok);
{%- endif %}
endclass

function void {{ class_prefix }}sequencer::build_phase(uvm_phase phase);
    super.build_phase(phase);
    void'(uvm_config_db #({{ class_prefix }}settings)::get(this, "", "settings", settings));
    void'(uvm_config_db #({{ class_prefix }}scoreboard)::get(this, "", "scoreboard", scoreboard));
    void'(uvm_config_db #(virtual {{ class_prefix }}interface)::get(this, "", "vif", vif));
    if (settings == null)
        `uvm_fatal("DW_SPI", "sequencer settings is null")
    if (scoreboard == null)
        `uvm_fatal("DW_SPI", "sequencer scoreboard is null")
    if (settings.vif == null)
        settings.vif = vif;
    if (vif == null)
        vif = settings.vif;
endfunction

{%- if software_cs %}
task {{ class_prefix }}sequencer::set_chip_select(input int cs_id, input bit selected);
    uvm_callback_iter#({{ class_prefix }}sequencer, {{ class_prefix }}callback) iter;

    iter = new(this);
    if (iter.first() == null)
        `uvm_fatal("DW_SPI_CB", "set_chip_select requires a registered callback when SOFTWARE_CS is used")
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, this,
        set_chip_select(cs_id, selected))
endtask
{%- endif %}

{%- if byte_reorder %}
function void {{ class_prefix }}sequencer::reorder_bytes(
        input bit [7:0] data[$],
        input bit is_read,
        output bit [7:0] reordered_data[$]);
    reordered_data = data;
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, this,
        reorder_bytes(data, is_read, reordered_data))
endfunction
{%- endif %}

{%- if internal_dma %}

// Dispatches a CPU read request to registered callbacks.
task {{ class_prefix }}sequencer::cpu_read(input bit [63:0] addr, output bit [31:0] data, input uvm_path_e path);
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, this, cpu_read(addr, data, path))
endtask

// Dispatches a CPU write request to registered callbacks.
task {{ class_prefix }}sequencer::cpu_write(input bit [63:0] addr, input bit [31:0] data, input uvm_path_e path);
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, this, cpu_write(addr, data, path))
endtask
{%- endif %}
{%- if external_dma %}

task {{ class_prefix }}sequencer::start_external_dma(
        {{ class_prefix }}transfer_req transfer_req);
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, this,
        start_external_dma(transfer_req))
endtask

task {{ class_prefix }}sequencer::finish_external_dma(
        input {{ class_prefix }}transfer_req transfer_req,
        output bit [7:0] read_data[$],
        output bit ok);
    `uvm_do_obj_callbacks({{ class_prefix }}sequencer, {{ class_prefix }}callback, this,
        finish_external_dma(transfer_req, read_data, ok))
endtask
{%- endif %}

`endif
