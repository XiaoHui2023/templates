`ifndef {{ (class_prefix ~ "register_access") | upper }}
`define {{ (class_prefix ~ "register_access") | upper }}

class {{ class_prefix }}register_access extends {{ class_prefix }}spec#(uvm_object);
    `uvm_object_utils({{ class_prefix }}register_access)

    {{ class_prefix }}settings settings;

    function new(string name="{{ class_prefix }}register_access");
        super.new(name);
    endfunction

    function bit [1:0] transfer_mode_bits(transfer_mode_e mode);
        case (mode)
            TX_AND_RX: return 2'h0;
            TX_ONLY: return 2'h1;
            RX_ONLY: return 2'h2;
            EEPROM_READ: return 2'h3;
            default: return 2'h0;
        endcase
    endfunction

    task apply_configuration({{ class_prefix }}configuration cfg);
        uvm_status_e status;
        host_mode_e host_mode;
        transfer_mode_e transfer_mode;
        uvm_reg_data_t dfs;
        uvm_reg_data_t reg_data;

        if (cfg == null)
            `uvm_fatal("DW_SPI_REG", "configuration is null")
        if (settings == null || settings.regmodel == null)
            `uvm_fatal("DW_SPI_REG", "settings.regmodel is null")
        if (!$cast(host_mode, cfg.host_mode))
            `uvm_fatal("DW_SPI_REG", "failed to cast configuration host_mode")
        if (!$cast(transfer_mode, cfg.transfer_mode))
            `uvm_fatal("DW_SPI_REG", "failed to cast configuration transfer_mode")

        settings.regmodel.SSIENR.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read SSIENR failed status=%s", status.name()))
        settings.regmodel.SSIENR.SSIC_EN.set(0);
        settings.regmodel.SSIENR.write(status, settings.regmodel.SSIENR.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write SSIENR failed status=%s", status.name()))

        settings.regmodel.IMR.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read IMR failed status=%s", status.name()))
        settings.regmodel.IMR.TXEIM.set(cfg.txeim);
        settings.regmodel.IMR.TXOIM.set(cfg.txoim);
        settings.regmodel.IMR.RXUIM.set(cfg.rxuim);
        settings.regmodel.IMR.RXOIM.set(cfg.rxoim);
        settings.regmodel.IMR.RXFIM.set(cfg.rxfim);
        settings.regmodel.IMR.MSTIM.set(cfg.mstim);
        settings.regmodel.IMR.write(status, settings.regmodel.IMR.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write IMR failed status=%s", status.name()))

        settings.regmodel.ICR.write(status, '0);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write ICR failed status=%s", status.name()))

        settings.regmodel.SER.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read SER failed status=%s", status.name()))
        settings.regmodel.SER.SER.set(0);
        settings.regmodel.SER.write(status, settings.regmodel.SER.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write SER failed status=%s", status.name()))

        dfs = cfg.data_frame_bits - 1;
        settings.regmodel.CTRLR0.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read CTRLR0 failed status=%s", status.name()))
        settings.regmodel.CTRLR0.DFS.set(dfs);
        settings.regmodel.CTRLR0.SPI_FRF.set(cfg.spi_frf);
        settings.regmodel.CTRLR0.SCPH.set(cfg.spi_mode[0]);
        settings.regmodel.CTRLR0.SCPOL.set(cfg.spi_mode[1]);
        settings.regmodel.CTRLR0.TMOD.set(transfer_mode_bits(transfer_mode));
        settings.regmodel.CTRLR0.SSI_IS_MST.set(host_mode == MASTER);
        settings.regmodel.CTRLR0.write(status, settings.regmodel.CTRLR0.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write CTRLR0 failed status=%s", status.name()))

        settings.regmodel.CTRLR1.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read CTRLR1 failed status=%s", status.name()))
        settings.regmodel.CTRLR1.NDF.set(cfg.ndf);
        settings.regmodel.CTRLR1.write(status, settings.regmodel.CTRLR1.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write CTRLR1 failed status=%s", status.name()))

        settings.regmodel.BAUDR.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read BAUDR failed status=%s", status.name()))
        settings.regmodel.BAUDR.SCKDV.set(cfg.baudr);
        settings.regmodel.BAUDR.write(status, settings.regmodel.BAUDR.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write BAUDR failed status=%s", status.name()))

        settings.regmodel.TXFTLR.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read TXFTLR failed status=%s", status.name()))
        settings.regmodel.TXFTLR.TFT.set(cfg.txftlr);
        settings.regmodel.TXFTLR.write(status, settings.regmodel.TXFTLR.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write TXFTLR failed status=%s", status.name()))

        settings.regmodel.RXFTLR.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read RXFTLR failed status=%s", status.name()))
        settings.regmodel.RXFTLR.RFT.set(cfg.rxftlr);
        settings.regmodel.RXFTLR.write(status, settings.regmodel.RXFTLR.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write RXFTLR failed status=%s", status.name()))

{% if internal_dma or external_dma %}
        settings.regmodel.DMACR.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read DMACR failed status=%s", status.name()))
{% if external_dma %}
        settings.regmodel.DMACR.RDMAE.set(cfg.rdmae);
        settings.regmodel.DMACR.TDMAE.set(cfg.tdmae);
{% endif %}
{% if internal_dma %}
        settings.regmodel.DMACR.IDMAE.set(cfg.idmae);
        settings.regmodel.DMACR.AINC.set(cfg.ainc);
{% endif %}
        settings.regmodel.DMACR.write(status, settings.regmodel.DMACR.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write DMACR failed status=%s", status.name()))

        settings.regmodel.DMATDLR.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read DMATDLR failed status=%s", status.name()))
        settings.regmodel.DMATDLR.DMATDL.set(cfg.dmatdl);
        settings.regmodel.DMATDLR.write(status, settings.regmodel.DMATDLR.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write DMATDLR failed status=%s", status.name()))

        settings.regmodel.DMARDLR.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read DMARDLR failed status=%s", status.name()))
        settings.regmodel.DMARDLR.DMARDL.set(cfg.dmardl);
        settings.regmodel.DMARDLR.write(status, settings.regmodel.DMARDLR.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write DMARDLR failed status=%s", status.name()))

{% if internal_dma %}
        if (cfg.write_internal_dma_regs) begin
            settings.regmodel.AXIAWLEN.read(status, reg_data);
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("read AXIAWLEN failed status=%s", status.name()))
            settings.regmodel.AXIAWLEN.AWLEN.set(cfg.awlen);
            settings.regmodel.AXIAWLEN.write(status, settings.regmodel.AXIAWLEN.get());
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("write AXIAWLEN failed status=%s", status.name()))

            settings.regmodel.AXIARLEN.read(status, reg_data);
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("read AXIARLEN failed status=%s", status.name()))
            settings.regmodel.AXIARLEN.ARLEN.set(cfg.arlen);
            settings.regmodel.AXIARLEN.write(status, settings.regmodel.AXIARLEN.get());
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("write AXIARLEN failed status=%s", status.name()))

            settings.regmodel.SPIDR.read(status, reg_data);
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("read SPIDR failed status=%s", status.name()))
            settings.regmodel.SPIDR.SPI_INST.set(cfg.spi_inst);
            settings.regmodel.SPIDR.write(status, settings.regmodel.SPIDR.get());
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("write SPIDR failed status=%s", status.name()))

            settings.regmodel.SPIAR.read(status, reg_data);
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("read SPIAR failed status=%s", status.name()))
            settings.regmodel.SPIAR.SDAR.set(cfg.sdar);
            settings.regmodel.SPIAR.write(status, settings.regmodel.SPIAR.get());
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("write SPIAR failed status=%s", status.name()))

            settings.regmodel.AXIAR0.read(status, reg_data);
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("read AXIAR0 failed status=%s", status.name()))
            settings.regmodel.AXIAR0.AXIAR0.set(cfg.axiar0);
            settings.regmodel.AXIAR0.write(status, settings.regmodel.AXIAR0.get());
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("write AXIAR0 failed status=%s", status.name()))
        end
{% endif %}
{% endif %}

        if (cfg.write_rx_sample_delay) begin
            settings.regmodel.RX_SAMPLE_DELAY.read(status, reg_data);
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("read RX_SAMPLE_DELAY failed status=%s", status.name()))
            settings.regmodel.RX_SAMPLE_DELAY.RSD.set(cfg.rx_sample_delay);
            settings.regmodel.RX_SAMPLE_DELAY.write(status, settings.regmodel.RX_SAMPLE_DELAY.get());
            if (status != UVM_IS_OK)
                `uvm_error("DW_SPI_REG", $sformatf("write RX_SAMPLE_DELAY failed status=%s", status.name()))
        end

        settings.regmodel.SER.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read SER failed status=%s", status.name()))
        settings.regmodel.SER.SER.set(cfg.ser);
        settings.regmodel.SER.write(status, settings.regmodel.SER.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write SER failed status=%s", status.name()))

        settings.regmodel.SSIENR.read(status, reg_data);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("read SSIENR failed status=%s", status.name()))
        settings.regmodel.SSIENR.SSIC_EN.set(cfg.ssi_en);
        settings.regmodel.SSIENR.write(status, settings.regmodel.SSIENR.get());
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write SSIENR failed status=%s", status.name()))
    endtask
endclass

`endif
