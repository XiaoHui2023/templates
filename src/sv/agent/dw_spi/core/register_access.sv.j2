`ifndef {{ (class_prefix ~ "register_access") | upper }}
`define {{ (class_prefix ~ "register_access") | upper }}

class {{ class_prefix }}register_access extends {{ class_prefix }}spec#(uvm_object);
    `uvm_object_utils({{ class_prefix }}register_access)

    {{ class_prefix }}settings settings;
    uvm_report_object report_context;

    function new(string name="{{ class_prefix }}register_access");
        super.new(name);
    endfunction

    function uvm_report_object get_report_context();
        if (report_context != null)
            return report_context;
        return uvm_root::get();
    endfunction

    function void report_info(string id, string message, int verbosity);
        uvm_report_object cntxt;

        cntxt = get_report_context();
        if (cntxt.uvm_report_enabled(verbosity, UVM_INFO, id))
            cntxt.uvm_report_info(id, message, verbosity);
    endfunction

    function void report_error(string id, string message);
        get_report_context().uvm_report_error(id, message);
    endfunction

    function void report_fatal(string id, string message);
        get_report_context().uvm_report_fatal(id, message);
    endfunction

    function bit [1:0] transfer_mode_bits(transfer_mode_e mode);
        case (mode)
            TX_AND_RX: return 2'h0;
            TX_ONLY: return 2'h1;
            RX_ONLY: return 2'h2;
            EEPROM_READ: return 2'h3;
            default: return 2'h0;
        endcase
    endfunction

    task wait_tfnf(output bit ok);
        uvm_status_e status;
        {{ regmodel_type }} rm;
        uvm_reg_data_t reg_data;

        if (settings == null || settings.regmodel == null)
            report_fatal("DW_SPI_REG", "settings.regmodel is null");
        rm = settings.regmodel;
        ok = 1'b0;
        report_info("DW_SPI_REG", $sformatf(
            "waiting SR.TFNF before DR write: timeout_cycles=%0d",
            settings.fifo_status_timeout_ssi_clk_cycles), UVM_DEBUG);
        repeat (settings.fifo_status_timeout_ssi_clk_cycles) begin
            rm.SR.read(status, reg_data);
            report_info("DW_SPI_REG", $sformatf(
                "poll SR while waiting TFNF: raw=0x%0h TFNF=%0b RFNE=%0b TFE=%0b RFF=%0b BUSY=%0b",
                reg_data,
                rm.SR.TFNF.get(),
                rm.SR.RFNE.get(),
                rm.SR.TFE.get(),
                rm.SR.RFF.get(),
                rm.SR.BUSY.get()), UVM_DEBUG);
            if (rm.SR.TFNF.get()) begin
                ok = 1'b1;
                report_info("DW_SPI_REG", "SR.TFNF asserted; DR write can proceed", UVM_DEBUG);
                return;
            end
        end
        report_error("DW_SPI_REG", $sformatf(
            "timeout waiting SR.TFNF before DR write: waiting_for=SR.TFNF==1 timeout_cycles=%0d last_SR=0x%0h last_TFNF=%0b last_RFNE=%0b last_TFE=%0b last_RFF=%0b last_BUSY=%0b",
            settings.fifo_status_timeout_ssi_clk_cycles,
            reg_data,
            rm.SR.TFNF.get(),
            rm.SR.RFNE.get(),
            rm.SR.TFE.get(),
            rm.SR.RFF.get(),
            rm.SR.BUSY.get()));
    endtask

    task wait_rfne(output bit ok);
        uvm_status_e status;
        {{ regmodel_type }} rm;
        uvm_reg_data_t reg_data;

        if (settings == null || settings.regmodel == null)
            report_fatal("DW_SPI_REG", "settings.regmodel is null");
        rm = settings.regmodel;
        ok = 1'b0;
        report_info("DW_SPI_REG", $sformatf(
            "waiting SR.RFNE before DR read: timeout_cycles=%0d",
            settings.fifo_status_timeout_ssi_clk_cycles), UVM_DEBUG);
        repeat (settings.fifo_status_timeout_ssi_clk_cycles) begin
            rm.SR.read(status, reg_data);
            report_info("DW_SPI_REG", $sformatf(
                "poll SR while waiting RFNE: raw=0x%0h TFNF=%0b RFNE=%0b TFE=%0b RFF=%0b BUSY=%0b",
                reg_data,
                rm.SR.TFNF.get(),
                rm.SR.RFNE.get(),
                rm.SR.TFE.get(),
                rm.SR.RFF.get(),
                rm.SR.BUSY.get()), UVM_DEBUG);
            if (rm.SR.RFNE.get()) begin
                ok = 1'b1;
                report_info("DW_SPI_REG", "SR.RFNE asserted; DR read can proceed", UVM_DEBUG);
                return;
            end
        end
        report_error("DW_SPI_REG", $sformatf(
            "timeout waiting SR.RFNE before DR read: waiting_for=SR.RFNE==1 timeout_cycles=%0d last_SR=0x%0h last_TFNF=%0b last_RFNE=%0b last_TFE=%0b last_RFF=%0b last_BUSY=%0b",
            settings.fifo_status_timeout_ssi_clk_cycles,
            reg_data,
            rm.SR.TFNF.get(),
            rm.SR.RFNE.get(),
            rm.SR.TFE.get(),
            rm.SR.RFF.get(),
            rm.SR.BUSY.get()));
    endtask

    task write_bytes_to_dr(
            bit [7:0] data[$],
            string reason,
            output bit ok);
        uvm_status_e status;
        {{ regmodel_type }} rm;
        bit ready;

        if (settings == null || settings.regmodel == null)
            report_fatal("DW_SPI_REG", "settings.regmodel is null");
        rm = settings.regmodel;
        ok = 1'b1;
        report_info("DW_SPI_REG", $sformatf(
            "writing bytes to DR: reason=%s bytes=%0d",
            reason, data.size()), UVM_HIGH);
        foreach (data[i]) begin
            report_info("DW_SPI_REG", $sformatf(
                "DR write byte[%0d]=0x%02h: wait TX FIFO not full",
                i, data[i]), UVM_DEBUG);
            wait_tfnf(ready);
            if (!ready) begin
                ok = 1'b0;
                return;
            end
            report_info("DW_SPI_REG", $sformatf(
                "DR write byte[%0d]=0x%02h", i, data[i]), UVM_DEBUG);
            rm.DR.write(status, uvm_reg_data_t'(data[i]));
        end
        report_info("DW_SPI_REG", $sformatf(
            "wrote %0d byte(s) to DR: reason=%s",
            data.size(), reason), UVM_HIGH);
    endtask

    task write_payload_to_dr(uvm_tlm_generic_payload payload, output bit ok);
        byte unsigned gp_data[];
        bit [7:0] data[$];

        if (payload == null)
            report_fatal("DW_SPI_REG", "payload is null");
        payload.get_data(gp_data);
        foreach (gp_data[i])
            data.push_back(gp_data[i]);
        write_bytes_to_dr(data, "payload", ok);
    endtask

    task read_dr_to_payload(
            uvm_tlm_generic_payload payload,
            output bit [7:0] read_data[$],
            output bit ok);
        uvm_status_e status;
        {{ regmodel_type }} rm;
        uvm_reg_data_t reg_data;
        byte unsigned gp_data[];
        bit ready;
        int length;

        if (settings == null || settings.regmodel == null)
            report_fatal("DW_SPI_REG", "settings.regmodel is null");
        rm = settings.regmodel;
        ok = 1'b1;
        read_data.delete();
        if (payload == null)
            report_fatal("DW_SPI_REG", "payload is null");
        length = payload.get_data_length();
        gp_data = new[length];
        report_info("DW_SPI_REG", $sformatf(
            "reading payload from DR: bytes=%0d", length), UVM_HIGH);
        for (int i = 0; i < length; i++) begin
            report_info("DW_SPI_REG", $sformatf(
                "DR read byte[%0d]: wait RX FIFO not empty", i), UVM_DEBUG);
            wait_rfne(ready);
            if (!ready) begin
                ok = 1'b0;
                return;
            end
            rm.DR.read(status, reg_data);
            report_info("DW_SPI_REG", $sformatf(
                "DR read byte[%0d]=0x%02h raw=0x%0h",
                i, reg_data[7:0], reg_data), UVM_DEBUG);
            read_data.push_back(reg_data[7:0]);
            gp_data[i] = reg_data[7:0];
        end
        payload.set_data(gp_data);
        report_info("DW_SPI_REG", $sformatf("read %0d byte(s) from DR", read_data.size()), UVM_HIGH);
    endtask

    task wait_idle(
            int timeout_cycles,
            output bit ok);
        uvm_status_e status;
        {{ regmodel_type }} rm;
        uvm_reg_data_t reg_data;

        if (settings == null || settings.regmodel == null)
            report_fatal("DW_SPI_REG", "settings.regmodel is null");
        rm = settings.regmodel;
        ok = 1'b0;
        report_info("DW_SPI_REG", $sformatf(
            "waiting transfer idle by polling SR.TFE && !SR.BUSY: timeout_cycles=%0d",
            timeout_cycles), UVM_HIGH);
        repeat (timeout_cycles) begin
            rm.SR.read(status, reg_data);
            report_info("DW_SPI_REG", $sformatf(
                "poll SR while waiting idle: raw=0x%0h TFNF=%0b RFNE=%0b TFE=%0b RFF=%0b BUSY=%0b",
                reg_data,
                rm.SR.TFNF.get(),
                rm.SR.RFNE.get(),
                rm.SR.TFE.get(),
                rm.SR.RFF.get(),
                rm.SR.BUSY.get()), UVM_DEBUG);
            if (rm.SR.TFE.get() && !rm.SR.BUSY.get()) begin
                ok = 1'b1;
                report_info("DW_SPI_REG", "transfer idle observed: SR.TFE=1 SR.BUSY=0", UVM_HIGH);
                return;
            end
        end
        report_error("DW_SPI_REG", $sformatf(
            "timeout waiting transfer idle: waiting_for=SR.TFE==1 && SR.BUSY==0 timeout_cycles=%0d last_SR=0x%0h last_TFNF=%0b last_RFNE=%0b last_TFE=%0b last_RFF=%0b last_BUSY=%0b",
            timeout_cycles,
            reg_data,
            rm.SR.TFNF.get(),
            rm.SR.RFNE.get(),
            rm.SR.TFE.get(),
            rm.SR.RFF.get(),
            rm.SR.BUSY.get()));
    endtask

    task check_internal_dma_dones(output bit ok);
        uvm_status_e status;
        {{ regmodel_type }} rm;
        uvm_reg_data_t reg_data;

        if (settings == null || settings.regmodel == null)
            report_fatal("DW_SPI_REG", "settings.regmodel is null");
        rm = settings.regmodel;
        rm.ISR.read(status, reg_data);
        ok = rm.ISR.DONES.get();
        report_info("DW_SPI_REG", $sformatf(
            "check ISR.DONES after internal DMA interrupt: raw=0x%0h DONES=%0b",
            reg_data, ok), UVM_DEBUG);
        if (ok)
            report_info("DW_SPI_REG", "internal DMA completion confirmed by ISR.DONES", UVM_HIGH);
        else
            report_error("DW_SPI_REG", $sformatf(
                "top interrupt observed but internal DMA done bit is not set: waiting_for=ISR.DONES==1 ISR=0x%0h DONES=%0b",
                reg_data, ok));
    endtask

    task select_hardware_chip(input int ser_value);
        uvm_status_e status;
        {{ regmodel_type }} rm;
        uvm_reg_data_t reg_data;

        if (settings == null || settings.regmodel == null)
            report_fatal("DW_SPI_REG", "settings.regmodel is null");
        rm = settings.regmodel;
        rm.SER.read(status, reg_data);
        rm.SER.SER.set(ser_value);
        report_info("DW_SPI_REG", $sformatf(
            "select hardware chip select: SER=0x%0h raw=0x%0h",
            ser_value, rm.SER.get()), UVM_HIGH);
        rm.SER.write(status, rm.SER.get());
    endtask

    task release_hardware_chip_selects();
        uvm_status_e status;
        {{ regmodel_type }} rm;
        uvm_reg_data_t reg_data;

        if (settings == null || settings.regmodel == null)
            report_fatal("DW_SPI_REG", "settings.regmodel is null");
        rm = settings.regmodel;
        rm.SER.read(status, reg_data);
        rm.SER.SER.set(0);
        report_info("DW_SPI_REG", $sformatf(
            "release hardware chip selects: raw=0x%0h", rm.SER.get()), UVM_HIGH);
        rm.SER.write(status, rm.SER.get());
    endtask

    task apply_configuration({{ class_prefix }}configuration cfg);
        uvm_status_e status;
        {{ regmodel_type }} rm;
        host_mode_e host_mode;
        transfer_mode_e transfer_mode;
        uvm_reg_data_t dfs;
        uvm_reg_data_t reg_data;
        string ndf_detail;

        if (cfg == null)
            report_fatal("DW_SPI_REG", "configuration is null");
        if (settings == null || settings.regmodel == null)
            report_fatal("DW_SPI_REG", "settings.regmodel is null");
        rm = settings.regmodel;
        if (!$cast(host_mode, cfg.host_mode))
            report_fatal("DW_SPI_REG", "failed to cast configuration host_mode");
        if (!$cast(transfer_mode, cfg.transfer_mode))
            report_fatal("DW_SPI_REG", "failed to cast configuration transfer_mode");
        if (cfg.ndf != 0)
            ndf_detail = $sformatf("CTRLR1.NDF register=%0d actual_ndf=%0d", cfg.ndf, cfg.ndf + 1);
        else
            ndf_detail = $sformatf("CTRLR1.NDF register=0 actual_ndf=0_or_1_command_only");

        report_info("DW_SPI_REG", "applying controller register configuration", UVM_DEBUG);
        report_info("DW_SPI_REG", $sformatf(
            "configuration detail: host_mode=%s transfer_mode=%s completion_mode=%s spi_frf=%0d spi_ctrlr0_en=%0b spi_clk_stretch_en=%0b wait_cycles=%0d inst_l=%0d addr_l=%0d trans_type=%0d spi_mode=%0d sste=%0b data_frame_bits=%0d %s ser=0x%0h baudr=%0d txftlr=%0d rxftlr=%0d interrupt_timeout_cycles=%0d",
            host_mode.name(),
            transfer_mode.name(),
            cfg.completion_mode.name(),
            cfg.spi_frf,
            cfg.spi_ctrlr0_en,
            cfg.spi_clk_stretch_en,
            cfg.wait_cycles,
            cfg.inst_l,
            cfg.addr_l,
            cfg.trans_type,
            cfg.spi_mode,
            cfg.sste,
            cfg.data_frame_bits,
            ndf_detail,
            cfg.ser,
            cfg.baudr,
            cfg.txftlr,
            cfg.rxftlr,
            cfg.interrupt_timeout_ssi_clk_cycles), UVM_DEBUG);

        report_info("DW_SPI_REG", "disabling controller before register programming", UVM_DEBUG);
        rm.SSIENR.read(status, reg_data);
        rm.SSIENR.SSIC_EN.set(0);
        report_info("DW_SPI_REG", $sformatf(
            "write SSIENR: SSIC_EN=0 raw=0x%0h", rm.SSIENR.get()), UVM_DEBUG);
        rm.SSIENR.write(status, rm.SSIENR.get());

        rm.IMR.read(status, reg_data);
        rm.IMR.TXEIM.set(cfg.txeim);
        rm.IMR.TXOIM.set(cfg.txoim);
        rm.IMR.RXUIM.set(cfg.rxuim);
        rm.IMR.RXOIM.set(cfg.rxoim);
        rm.IMR.RXFIM.set(cfg.rxfim);
        rm.IMR.MSTIM.set(cfg.mstim);
        report_info("DW_SPI_REG", $sformatf(
            "write IMR: TXEIM=%0b TXOIM=%0b RXUIM=%0b RXOIM=%0b RXFIM=%0b MSTIM=%0b raw=0x%0h",
            cfg.txeim, cfg.txoim, cfg.rxuim, cfg.rxoim, cfg.rxfim, cfg.mstim,
            rm.IMR.get()), UVM_DEBUG);
        rm.IMR.write(status, rm.IMR.get());

        report_info("DW_SPI_REG", "clear interrupt status with ICR write", UVM_DEBUG);
        rm.ICR.write(status, '0);

        rm.SER.read(status, reg_data);
        rm.SER.SER.set(0);
        report_info("DW_SPI_REG", $sformatf(
            "release SER before configuration: raw=0x%0h", rm.SER.get()), UVM_DEBUG);
        rm.SER.write(status, rm.SER.get());

        dfs = cfg.data_frame_bits - 1;
        rm.CTRLR0.read(status, reg_data);
        rm.CTRLR0.DFS.set(dfs);
        rm.CTRLR0.SPI_FRF.set(cfg.spi_frf);
        rm.CTRLR0.SCPH.set(cfg.spi_mode[0]);
        rm.CTRLR0.SCPOL.set(cfg.spi_mode[1]);
        rm.CTRLR0.SSTE.set(cfg.sste);
        rm.CTRLR0.TMOD.set(transfer_mode_bits(transfer_mode));
        rm.CTRLR0.SSI_IS_MST.set(host_mode == MASTER);
        report_info("DW_SPI_REG", $sformatf(
            "write CTRLR0: DFS=%0d SPI_FRF=%0d SCPH=%0b SCPOL=%0b SSTE=%0b TMOD=%0d SSI_IS_MST=%0b raw=0x%0h",
            dfs, cfg.spi_frf, cfg.spi_mode[0], cfg.spi_mode[1],
            cfg.sste,
            transfer_mode_bits(transfer_mode), host_mode == MASTER,
            rm.CTRLR0.get()), UVM_DEBUG);
        rm.CTRLR0.write(status, rm.CTRLR0.get());

        if (cfg.spi_ctrlr0_en) begin
            rm.SPI_CTRLR0.read(status, reg_data);
            rm.SPI_CTRLR0.WAIT_CYCLES.set(cfg.wait_cycles);
            rm.SPI_CTRLR0.INST_L.set(cfg.inst_l);
            rm.SPI_CTRLR0.ADDR_L.set(cfg.addr_l);
            rm.SPI_CTRLR0.TRANS_TYPE.set(cfg.trans_type);
            rm.SPI_CTRLR0.CLK_STRETCH_EN.set(cfg.spi_clk_stretch_en);
            report_info("DW_SPI_REG", $sformatf(
                "write SPI_CTRLR0: WAIT_CYCLES=%0d INST_L=%0d ADDR_L=%0d TRANS_TYPE=%0d CLK_STRETCH_EN=%0b raw=0x%0h",
                cfg.wait_cycles, cfg.inst_l, cfg.addr_l, cfg.trans_type,
                cfg.spi_clk_stretch_en,
                rm.SPI_CTRLR0.get()), UVM_DEBUG);
            rm.SPI_CTRLR0.write(status, rm.SPI_CTRLR0.get());
        end

        rm.CTRLR1.read(status, reg_data);
        rm.CTRLR1.NDF.set(cfg.ndf);
        report_info("DW_SPI_REG", $sformatf(
            "write CTRLR1: %s raw=0x%0h", ndf_detail, rm.CTRLR1.get()), UVM_DEBUG);
        rm.CTRLR1.write(status, rm.CTRLR1.get());

        rm.BAUDR.read(status, reg_data);
        rm.BAUDR.SCKDV.set(cfg.baudr);
        report_info("DW_SPI_REG", $sformatf(
            "write BAUDR: SCKDV=%0d raw=0x%0h", cfg.baudr, rm.BAUDR.get()), UVM_DEBUG);
        rm.BAUDR.write(status, rm.BAUDR.get());

        rm.TXFTLR.read(status, reg_data);
        rm.TXFTLR.TFT.set(cfg.txftlr);
        report_info("DW_SPI_REG", $sformatf(
            "write TXFTLR: TFT=%0d raw=0x%0h", cfg.txftlr, rm.TXFTLR.get()), UVM_DEBUG);
        rm.TXFTLR.write(status, rm.TXFTLR.get());

        rm.RXFTLR.read(status, reg_data);
        rm.RXFTLR.RFT.set(cfg.rxftlr);
        report_info("DW_SPI_REG", $sformatf(
            "write RXFTLR: RFT=%0d raw=0x%0h", cfg.rxftlr, rm.RXFTLR.get()), UVM_DEBUG);
        rm.RXFTLR.write(status, rm.RXFTLR.get());

{%- if internal_dma or external_dma %}
        rm.DMACR.read(status, reg_data);
{%- if external_dma %}
        rm.DMACR.RDMAE.set(cfg.rdmae);
        rm.DMACR.TDMAE.set(cfg.tdmae);
{%- endif %}
{%- if internal_dma %}
        rm.DMACR.RDMAE.set(cfg.rdmae);
        rm.DMACR.TDMAE.set(cfg.tdmae);
        rm.DMACR.IDMAE.set(cfg.idmae);
        rm.DMACR.AINC.set(cfg.ainc);
{%- endif %}
        report_info("DW_SPI_REG", $sformatf(
            "write DMACR: RDMAE=%0b TDMAE=%0b{% if internal_dma %} IDMAE=%0b AINC=%0b{% endif %} raw=0x%0h",
            cfg.rdmae,
            cfg.tdmae{% if internal_dma %},
            cfg.idmae,
            cfg.ainc{% endif %},
            rm.DMACR.get()), UVM_DEBUG);
        rm.DMACR.write(status, rm.DMACR.get());

        rm.DMATDLR.read(status, reg_data);
        rm.DMATDLR.DMATDL.set(cfg.dmatdl);
        report_info("DW_SPI_REG", $sformatf(
            "write DMATDLR: DMATDL=%0d raw=0x%0h",
            cfg.dmatdl, rm.DMATDLR.get()), UVM_DEBUG);
        rm.DMATDLR.write(status, rm.DMATDLR.get());

        rm.DMARDLR.read(status, reg_data);
        rm.DMARDLR.DMARDL.set(cfg.dmardl);
        report_info("DW_SPI_REG", $sformatf(
            "write DMARDLR: DMARDL=%0d raw=0x%0h",
            cfg.dmardl, rm.DMARDLR.get()), UVM_DEBUG);
        rm.DMARDLR.write(status, rm.DMARDLR.get());

{%- if internal_dma %}
        if (cfg.write_internal_dma_regs) begin
            rm.AXIAWLEN.read(status, reg_data);
            rm.AXIAWLEN.AWLEN.set(cfg.awlen);
            report_info("DW_SPI_REG", $sformatf(
                "write AXIAWLEN: AWLEN=0x%0h raw=0x%0h",
                cfg.awlen, rm.AXIAWLEN.get()), UVM_DEBUG);
            rm.AXIAWLEN.write(status, rm.AXIAWLEN.get());

            rm.AXIARLEN.read(status, reg_data);
            rm.AXIARLEN.ARLEN.set(cfg.arlen);
            report_info("DW_SPI_REG", $sformatf(
                "write AXIARLEN: ARLEN=0x%0h raw=0x%0h",
                cfg.arlen, rm.AXIARLEN.get()), UVM_DEBUG);
            rm.AXIARLEN.write(status, rm.AXIARLEN.get());

            rm.SPIDR.read(status, reg_data);
            rm.SPIDR.SPI_INST.set(cfg.spi_inst);
            report_info("DW_SPI_REG", $sformatf(
                "write SPIDR: SPI_INST=0x%04h raw=0x%0h",
                cfg.spi_inst, rm.SPIDR.get()), UVM_DEBUG);
            rm.SPIDR.write(status, rm.SPIDR.get());

            rm.SPIAR.read(status, reg_data);
            rm.SPIAR.SDAR.set(cfg.sdar);
            report_info("DW_SPI_REG", $sformatf(
                "write SPIAR: SDAR=0x%0h raw=0x%0h",
                cfg.sdar, rm.SPIAR.get()), UVM_DEBUG);
            rm.SPIAR.write(status, rm.SPIAR.get());

            rm.AXIAR0.read(status, reg_data);
            rm.AXIAR0.AXIAR0.set(cfg.axiar0);
            report_info("DW_SPI_REG", $sformatf(
                "write AXIAR0: AXIAR0=0x%0h raw=0x%0h",
                cfg.axiar0, rm.AXIAR0.get()), UVM_DEBUG);
            rm.AXIAR0.write(status, rm.AXIAR0.get());
        end
{%- endif %}
{%- endif %}

        if (cfg.write_rx_sample_delay) begin
            rm.RX_SAMPLE_DELAY.read(status, reg_data);
            rm.RX_SAMPLE_DELAY.RSD.set(cfg.rx_sample_delay);
            report_info("DW_SPI_REG", $sformatf(
                "write RX_SAMPLE_DELAY: RSD=%0d raw=0x%0h",
                cfg.rx_sample_delay, rm.RX_SAMPLE_DELAY.get()), UVM_DEBUG);
            rm.RX_SAMPLE_DELAY.write(status, rm.RX_SAMPLE_DELAY.get());
        end

        rm.SSIENR.read(status, reg_data);
        rm.SSIENR.SSIC_EN.set(cfg.ssi_en);
        report_info("DW_SPI_REG", $sformatf(
            "enable controller with SSIENR: SSIC_EN=%0b raw=0x%0h",
            cfg.ssi_en, rm.SSIENR.get()), UVM_DEBUG);
        rm.SSIENR.write(status, rm.SSIENR.get());
        report_info("DW_SPI_REG", "controller register configuration applied with SER released; transfer sequence selects CS after any PIO FIFO prefill", UVM_DEBUG);
    endtask
endclass

`endif
