`ifndef {{ (class_prefix ~ "register_access") | upper }}
`define {{ (class_prefix ~ "register_access") | upper }}

class {{ class_prefix }}register_access extends {{ class_prefix }}spec#(uvm_object);
    `uvm_object_utils({{ class_prefix }}register_access)

    {{ class_prefix }}settings settings;

    function new(string name="{{ class_prefix }}register_access");
        super.new(name);
    endfunction

    function bit [1:0] transfer_mode_bits(transfer_mode_e mode);
        case (mode)
            TX_AND_RX: return 2'h0;
            TX_ONLY: return 2'h1;
            RX_ONLY: return 2'h2;
            EEPROM_READ: return 2'h3;
            default: return 2'h0;
        endcase
    endfunction

    function bit [1:0] spi_frf_bits(int unsigned speed_multiplier);
        case (speed_multiplier)
            1: return 2'h0;
            2: return 2'h1;
            4: return 2'h2;
            8: return 2'h3;
            default: return 2'h0;
        endcase
    endfunction

    function bit [31:0] pack_ctrlr0({{ class_prefix }}transfer_req req);
        bit [31:0] v;
        int unsigned dfs;
        bit [1:0] tmod;
        host_mode_e host_mode;
        transfer_mode_e transfer_mode;

        v = '0;
        if (!$cast(host_mode, req.host_mode))
            `uvm_fatal("DW_SPI_REG", "failed to cast host_mode")
        if (!$cast(transfer_mode, req.transfer_mode))
            `uvm_fatal("DW_SPI_REG", "failed to cast transfer_mode")
        dfs = req.data_frame_bits - 1;
        tmod = transfer_mode_bits(transfer_mode);
        if (settings.ssi_variant == HSSI) begin
            v[4:0] = dfs[4:0];
            v[7:6] = spi_frf_bits(req.speed_multiplier);
            v[8] = req.spi_mode[0];
            v[9] = req.spi_mode[1];
            v[11:10] = tmod;
            if (host_mode == MASTER)
                v[31] = 1'b1;
        end else begin
            if (req.data_frame_bits > 16)
                v[20:16] = dfs[4:0];
            else
                v[3:0] = dfs[3:0];
            v[5:4] = spi_frf_bits(req.speed_multiplier);
            v[6] = req.spi_mode[0];
            v[7] = req.spi_mode[1];
            v[9:8] = tmod;
            if (host_mode == SLAVE)
                v[10] = 1'b1;
        end
        return v;
    endfunction

    function bit [31:0] dma_control_bits({{ class_prefix }}transfer_req req);
        bit [31:0] v;
        transfer_mode_e transfer_mode;

        v = '0;
        if (req == null || !req.use_dma)
            return v;
        if (!$cast(transfer_mode, req.transfer_mode))
            `uvm_fatal("DW_SPI_REG", "failed to cast DMA transfer_mode")
        if (transfer_mode inside {RX_ONLY, EEPROM_READ})
            v[DMACR_RDMAE] = 1'b1;
        if (transfer_mode inside {TX_ONLY, TX_AND_RX})
            v[DMACR_TDMAE] = 1'b1;
        return v;
    endfunction

    function void build_configuration(
            {{ class_prefix }}transfer_req req,
            output {{ class_prefix }}configuration cfg);
        int unsigned length;
        transfer_mode_e transfer_mode;

        if (settings == null)
            `uvm_fatal("DW_SPI_REG", "settings is null")
        if (req == null)
            `uvm_fatal("DW_SPI_REG", "transfer req is null")
        if (req.payload == null)
            `uvm_fatal("DW_SPI_REG", "transfer req payload is null")
        cfg = {{ class_prefix }}configuration::type_id::create("configuration");
        cfg.settings = settings;
        length = req.payload.get_data_length();
        if (!$cast(transfer_mode, req.transfer_mode))
            `uvm_fatal("DW_SPI_REG", "failed to cast transfer_mode for configuration")
        if (!cfg.randomize() with {
                if (transfer_mode inside {
                        RX_ONLY,
                        EEPROM_READ
                    }) {
                    ctrlr1 == (length > 0 ? length - 1 : 0);
                } else {
                    ctrlr1 == 0;
                }
                dmacr == dma_control_bits(req);
                ser == (32'h1 << req.cs_id);
            })
            `uvm_fatal("DW_SPI_REG", "failed to randomize register configuration")
        cfg.ctrlr0 = pack_ctrlr0(req);
    endfunction

    task apply_configuration({{ class_prefix }}configuration cfg);
        uvm_status_e status;

        if (cfg == null)
            `uvm_fatal("DW_SPI_REG", "configuration is null")
        if (settings == null || settings.regmodel == null)
            `uvm_fatal("DW_SPI_REG", "settings.regmodel is null")
        settings.regmodel.SSIENR.write(status, cfg.ssienr_disable);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write SSIENR failed status=%s", status.name()))
        settings.regmodel.IMR.write(status, cfg.imr);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write IMR failed status=%s", status.name()))
        settings.regmodel.ICR.write(status, '0);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write ICR failed status=%s", status.name()))
        settings.regmodel.SER.write(status, '0);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write SER failed status=%s", status.name()))
        settings.regmodel.CTRLR0.write(status, cfg.ctrlr0);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write CTRLR0 failed status=%s", status.name()))
        settings.regmodel.CTRLR1.write(status, cfg.ctrlr1);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write CTRLR1 failed status=%s", status.name()))
        settings.regmodel.BAUDR.write(status, cfg.baudr);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write BAUDR failed status=%s", status.name()))
        settings.regmodel.TXFTLR.write(status, cfg.txftlr);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write TXFTLR failed status=%s", status.name()))
        settings.regmodel.RXFTLR.write(status, cfg.rxftlr);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write RXFTLR failed status=%s", status.name()))
        settings.regmodel.DMACR.write(status, cfg.dmacr);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write DMACR failed status=%s", status.name()))
        settings.regmodel.DMATDLR.write(status, cfg.dmatdlr);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write DMATDLR failed status=%s", status.name()))
        settings.regmodel.DMARDLR.write(status, cfg.dmardlr);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write DMARDLR failed status=%s", status.name()))
        if (cfg.write_rx_sample_delay)
            settings.regmodel.RX_SAMPLE_DELAY.write(status, cfg.rx_sample_delay);
        if (cfg.write_rx_sample_delay && status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write RX_SAMPLE_DELAY failed status=%s", status.name()))
        settings.regmodel.SER.write(status, cfg.ser);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write SER failed status=%s", status.name()))
        settings.regmodel.SSIENR.write(status, cfg.ssienr_enable);
        if (status != UVM_IS_OK) `uvm_error("DW_SPI_REG", $sformatf("write SSIENR failed status=%s", status.name()))
    endtask
endclass

`endif
