`ifndef {{ (class_prefix ~ "register_access") | upper }}
`define {{ (class_prefix ~ "register_access") | upper }}

class {{ class_prefix }}register_access extends {{ class_prefix }}spec#(uvm_object);
    `uvm_object_utils({{ class_prefix }}register_access)

    {{ class_prefix }}settings settings;

    function new(string name="{{ class_prefix }}register_access");
        super.new(name);
    endfunction

    function bit [1:0] transfer_mode_bits(transfer_mode_e mode);
        case (mode)
            TX_AND_RX: return 2'h0;
            TX_ONLY: return 2'h1;
            RX_ONLY: return 2'h2;
            EEPROM_READ: return 2'h3;
            default: return 2'h0;
        endcase
    endfunction

    protected function uvm_reg_field get_field(
            uvm_reg rg,
            string reg_name,
            string field_name);
        uvm_reg_field field;

        if (rg == null)
            `uvm_fatal("DW_SPI_REG", $sformatf("%s register handle is null", reg_name))
        field = rg.get_field_by_name(field_name);
        if (field == null)
            `uvm_fatal("DW_SPI_REG", $sformatf("%s.%s field handle is null", reg_name, field_name))
        return field;
    endfunction

    protected function void set_field(
            uvm_reg rg,
            string reg_name,
            string field_name,
            uvm_reg_data_t value);
        get_field(rg, reg_name, field_name).set(value);
    endfunction

    protected task update_reg(uvm_reg rg, string reg_name);
        uvm_status_e status;

        if (rg == null)
            `uvm_fatal("DW_SPI_REG", $sformatf("%s register handle is null", reg_name))
        rg.update(status);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("update %s failed status=%s", reg_name, status.name()))
    endtask

    task apply_configuration({{ class_prefix }}configuration cfg);
        uvm_status_e status;
        host_mode_e host_mode;
        transfer_mode_e transfer_mode;
        uvm_reg_data_t dfs;

        if (cfg == null)
            `uvm_fatal("DW_SPI_REG", "configuration is null")
        if (settings == null || settings.regmodel == null)
            `uvm_fatal("DW_SPI_REG", "settings.regmodel is null")
        if (!$cast(host_mode, cfg.host_mode))
            `uvm_fatal("DW_SPI_REG", "failed to cast configuration host_mode")
        if (!$cast(transfer_mode, cfg.transfer_mode))
            `uvm_fatal("DW_SPI_REG", "failed to cast configuration transfer_mode")

        set_field(settings.regmodel.SSIENR, "SSIENR", "SSI_EN", 0);
        update_reg(settings.regmodel.SSIENR, "SSIENR");

        set_field(settings.regmodel.IMR, "IMR", "TXEIM", cfg.txeim);
        set_field(settings.regmodel.IMR, "IMR", "TXOIM", cfg.txoim);
        set_field(settings.regmodel.IMR, "IMR", "RXUIM", cfg.rxuim);
        set_field(settings.regmodel.IMR, "IMR", "RXOIM", cfg.rxoim);
        set_field(settings.regmodel.IMR, "IMR", "RXFIM", cfg.rxfim);
        set_field(settings.regmodel.IMR, "IMR", "MSTIM", cfg.mstim);
        update_reg(settings.regmodel.IMR, "IMR");

        settings.regmodel.ICR.write(status, '0);
        if (status != UVM_IS_OK)
            `uvm_error("DW_SPI_REG", $sformatf("write ICR failed status=%s", status.name()))

        set_field(settings.regmodel.SER, "SER", "SER", 0);
        update_reg(settings.regmodel.SER, "SER");

        dfs = cfg.data_frame_bits - 1;
        if (settings.ssi_variant == HSSI) begin
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "DFS", dfs);
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "SPI_FRF", cfg.spi_frf);
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "SCPH", cfg.spi_mode[0]);
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "SCPOL", cfg.spi_mode[1]);
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "TMOD", transfer_mode_bits(transfer_mode));
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "SSI_IS_MST", host_mode == MASTER);
        end else begin
            if (cfg.data_frame_bits > 16)
                set_field(settings.regmodel.CTRLR0, "CTRLR0", "DFS_32", dfs);
            else
                set_field(settings.regmodel.CTRLR0, "CTRLR0", "DFS", dfs);
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "SPI_FRF", cfg.spi_frf);
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "SCPH", cfg.spi_mode[0]);
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "SCPOL", cfg.spi_mode[1]);
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "TMOD", transfer_mode_bits(transfer_mode));
            set_field(settings.regmodel.CTRLR0, "CTRLR0", "SSI_IS_MST", host_mode == MASTER);
        end
        update_reg(settings.regmodel.CTRLR0, "CTRLR0");

        set_field(settings.regmodel.CTRLR1, "CTRLR1", "NDF", cfg.ndf);
        update_reg(settings.regmodel.CTRLR1, "CTRLR1");

        set_field(settings.regmodel.BAUDR, "BAUDR", "SCKDV", cfg.baudr);
        update_reg(settings.regmodel.BAUDR, "BAUDR");

        set_field(settings.regmodel.TXFTLR, "TXFTLR", "TFT", cfg.txftlr);
        update_reg(settings.regmodel.TXFTLR, "TXFTLR");

        set_field(settings.regmodel.RXFTLR, "RXFTLR", "RFT", cfg.rxftlr);
        update_reg(settings.regmodel.RXFTLR, "RXFTLR");

        set_field(settings.regmodel.DMACR, "DMACR", "RDMAE", cfg.rdmae);
        set_field(settings.regmodel.DMACR, "DMACR", "TDMAE", cfg.tdmae);
        update_reg(settings.regmodel.DMACR, "DMACR");

        set_field(settings.regmodel.DMATDLR, "DMATDLR", "DMATDL", cfg.dmatdl);
        update_reg(settings.regmodel.DMATDLR, "DMATDLR");

        set_field(settings.regmodel.DMARDLR, "DMARDLR", "DMARDL", cfg.dmardl);
        update_reg(settings.regmodel.DMARDLR, "DMARDLR");

        if (cfg.write_rx_sample_delay) begin
            set_field(settings.regmodel.RX_SAMPLE_DELAY, "RX_SAMPLE_DELAY", "RSD", cfg.rx_sample_delay);
            update_reg(settings.regmodel.RX_SAMPLE_DELAY, "RX_SAMPLE_DELAY");
        end

        set_field(settings.regmodel.SER, "SER", "SER", cfg.ser);
        update_reg(settings.regmodel.SER, "SER");

        set_field(settings.regmodel.SSIENR, "SSIENR", "SSI_EN", cfg.ssi_en);
        update_reg(settings.regmodel.SSIENR, "SSIENR");
    endtask
endclass

`endif
