`ifndef {{ class_prefix | upper }}AGENT
`define {{ class_prefix | upper }}AGENT

class {{ class_prefix }}agent extends uvm_component;
    `uvm_component_utils({{ class_prefix }}agent)

    {{ class_prefix }}configuration cfg; // 配置
    {{ class_prefix }}sequencer sqr;
    {{ class_prefix }}driver drv;

    function new(string name="{{ class_prefix }}agent", uvm_component parent);
        super.new(name,parent);
        sqr = {{ class_prefix }}sequencer::type_id::create("sqr",this);
        drv = {{ class_prefix }}driver::type_id::create("drv",this);
    endfunction

    // 取得配置并设置默认序列。
    extern function void build();
    // 连接驱动和 sequencer。
    extern function void connect();
    // 检查接口与运行期配置。
    extern function void start_of_simulation();
endclass

function void {{ class_prefix }}agent::build();
    super.build();

    uvm_config_db#({{ class_prefix }}configuration)::get(this,"","cfg",cfg);
    if(!cfg)
        cfg = {{ class_prefix }}configuration::type_id::create({get_full_name(),".cfg"});

endfunction

function void {{ class_prefix }}agent::connect();
    super.connect();

    drv.seq_item_port.connect(sqr.seq_item_export);
    $cast(sqr.cfg,cfg);
    $cast(drv.cfg,cfg);
endfunction

function void {{ class_prefix }}agent::start_of_simulation();
    super.start_of_simulation();

    uvm_config_db#(virtual {{ class_prefix }}interface)::get(this,"","vif",cfg.vif);
    cfg.apply();
    `uvm_info("",$sformatf("system config\n%s",cfg.sprint()),UVM_LOW)
endfunction

`endif
