`ifndef {{ class_sequencer | upper }}
`define {{ class_sequencer | upper }}

class {{ class_sequencer }} extends uvm_sequencer;
    `uvm_component_utils({{ class_sequencer }})

    {{ class_settings }} settings;
    {{ class_reg_rw }} rw;

    function new(string name, uvm_component parent);
        super.new(name, parent);
        rw = new();
    endfunction

    extern task reset_phase(uvm_phase phase);
    extern function void start_of_simulation_phase(uvm_phase phase);
    extern function void check_ready();
    extern task config_signal({{ class_signal_data }} signal, logic[31:0] value);
    extern function logic[31:0] get_signal({{ class_pad_data }} pad, string signal_name);
endclass

task {{ class_sequencer }}::reset_phase(uvm_phase phase);
    super.reset_phase(phase);
    stop_sequences();
    start_phase_sequence(phase);
endtask

function void {{ class_sequencer }}::start_of_simulation_phase(uvm_phase phase);
    super.start_of_simulation_phase(phase);

    if (settings == null)
        `uvm_fatal("PAD", "require settings")
    if (!settings.has_randomized)
        assert(settings.randomize()) else `uvm_fatal("PAD", "settings randomize failed")
    settings.build();
    `uvm_info("PAD", $sformatf("built %0d pad data objects", settings.pads.size()), UVM_LOW)
endfunction

function void {{ class_sequencer }}::check_ready();
    if (settings == null)
        `uvm_fatal("PAD", "require settings")
    if (settings.vif == null)
        `uvm_fatal("PAD", "require settings.vif")
    if (settings.regmodel == null)
        `uvm_fatal("PAD", "require settings.regmodel")
    if (settings.pads.size() == 0)
        `uvm_fatal("PAD", "settings.pads is empty; call settings.build() first")
endfunction

task {{ class_sequencer }}::config_signal({{ class_signal_data }} signal, logic[31:0] value);
    check_ready();
    if (signal == null)
        `uvm_fatal("PAD", "config_signal: signal is null")
    if (signal.has_fix)
        return;
    if (!signal.has_reg || signal.reg_bind == null)
        `uvm_fatal("PAD", $sformatf("config_signal: %s reg_bind is null", signal.name))
    rw.set_write(signal.reg_bind, value);
endtask

function logic[31:0] {{ class_sequencer }}::get_signal({{ class_pad_data }} pad, string signal_name);
    if (pad == null || pad.vif == null)
        `uvm_fatal("PAD", "get_signal: pad vif is null")
{% for signal in signal_keys %}
    if (signal_name == "{{ signal.name }}")
        return pad.vif.{{ signal.sv_name }};
{% endfor %}
    `uvm_fatal("PAD", $sformatf("get_signal: unknown signal %s", signal_name))
    return '0;
endfunction

`endif
