`ifndef {{ class_reg_binding | upper }}
`define {{ class_reg_binding | upper }}

class {{ class_reg_binding }};
    uvm_reg_field field;
    int lsb;
    int width;
    bit has_read;

    // Initializes a field binding and optional bit slice.
    function new(uvm_reg_field field=null, int lsb=0, int width=0);
        this.field = field;
        this.lsb = lsb;
        this.width = width;
        this.has_read = 1'b0;
    endfunction

    // Returns the configured slice width or the complete field width.
    function int bound_width();
        if (field == null)
            `uvm_fatal("PAD", "bound_width: field is null")
        if (width > 0)
            return width;
        return field.get_n_bits();
    endfunction
endclass

`endif
