`ifndef {{ class_connection_test_seq | upper }}
`define {{ class_connection_test_seq | upper }}

class {{ class_connection_test_seq }} extends {{ class_base_seq }};
    `uvm_object_utils_begin({{ class_connection_test_seq }})
        `uvm_field_int(ok,UVM_ALL_ON)
    `uvm_object_utils_end

    bit ok = 1'b1;

    function new(string name = "{{ class_connection_test_seq }}");
        super.new(name);
    endfunction

    extern function logic[31:0] bit_mask(int width);
    extern task body();
    extern task check_one({{ class_pad_data }} pad);
    extern task check_signal({{ class_pad_data }} pad, {{ class_signal_data }} signal, logic[31:0] value);
endclass

function logic[31:0] {{ class_connection_test_seq }}::bit_mask(int width);
    if (width <= 0)
        return '0;
    if (width >= 32)
        return 32'hffff_ffff;
    return 32'hffff_ffff >> (32 - width);
endfunction

task {{ class_connection_test_seq }}::body();
    ok = 1'b1;
    p_sequencer.check_ready();
    foreach (settings.pads[i])
        check_one(settings.pads[i]);
endtask

task {{ class_connection_test_seq }}::check_one({{ class_pad_data }} pad);
    if (pad == null)
        `uvm_fatal("PAD", "check_one: pad is null")

    foreach (pad.signals[i]) begin
        if (pad.signals[i].has_fix) begin
            check_signal(pad, pad.signals[i], pad.signals[i].fix_value);
        end else if (pad.signals[i].has_reg) begin
            check_signal(pad, pad.signals[i], 0);
            check_signal(pad, pad.signals[i], bit_mask(pad.signals[i].width));
        end
    end
endtask

task {{ class_connection_test_seq }}::check_signal(
        {{ class_pad_data }} pad,
        {{ class_signal_data }} signal,
        logic[31:0] value);
    logic[31:0] mask;
    logic[31:0] expect;
    logic[31:0] actual;

    if (signal == null)
        `uvm_fatal("PAD", "check_signal: signal is null")
    mask = bit_mask(signal.width);
    expect = value & mask;
    p_sequencer.config_signal(signal, expect);
    #1ns;
    actual = p_sequencer.get_signal(pad, signal.name);
    if ((actual & mask) !== expect) begin
        ok = 1'b0;
        `uvm_error("PAD", $sformatf(
            "%s.%s connection mismatch: expect 0x%0h actual 0x%0h",
            pad.name, signal.name, expect, actual & mask))
    end
endtask

`endif
