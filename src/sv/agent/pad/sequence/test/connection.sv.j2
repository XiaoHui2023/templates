`ifndef {{ class_connection_test_seq | upper }}
`define {{ class_connection_test_seq | upper }}

class {{ class_connection_test_seq }} extends {{ class_base_seq }};
    `uvm_object_utils_begin({{ class_connection_test_seq }})
        `uvm_field_int(ok,UVM_ALL_ON)
    `uvm_object_utils_end

    bit ok = 1'b1;

    function new(string name = "{{ class_connection_test_seq }}");
        super.new(name);
    endfunction

    extern function logic[31:0] bit_mask(int width);
    extern task body();
    extern task check_one({{ class_pad_data }} pad);
    extern task check_signal({{ class_pad_data }} pad, string signal_name, {{ class_reg_binding }} rb, logic[31:0] value);
endclass

function logic[31:0] {{ class_connection_test_seq }}::bit_mask(int width);
    if (width <= 0)
        return '0;
    if (width >= 32)
        return 32'hffff_ffff;
    return 32'hffff_ffff >> (32 - width);
endfunction

task {{ class_connection_test_seq }}::body();
    ok = 1'b1;
    p_sequencer.check_ready();
    foreach (settings.pads[i])
        check_one(settings.pads[i]);
endtask

task {{ class_connection_test_seq }}::check_one({{ class_pad_data }} pad);
    if (pad == null)
        `uvm_fatal("PAD", "check_one: pad is null")

    check_signal(pad, "output", pad.output_reg, 0);
    check_signal(pad, "output", pad.output_reg, bit_mask(pad.output_reg.bound_width()));
    check_signal(pad, "pull_up", pad.pull_up_reg, 0);
    check_signal(pad, "pull_up", pad.pull_up_reg, bit_mask(pad.pull_up_reg.bound_width()));
    check_signal(pad, "pull_down", pad.pull_down_reg, 0);
    check_signal(pad, "pull_down", pad.pull_down_reg, bit_mask(pad.pull_down_reg.bound_width()));
    check_signal(pad, "drive_strength", pad.drive_strength_reg, 0);
    check_signal(pad, "drive_strength", pad.drive_strength_reg, bit_mask(pad.drive_strength_reg.bound_width()));
endtask

task {{ class_connection_test_seq }}::check_signal(
        {{ class_pad_data }} pad,
        string signal_name,
        {{ class_reg_binding }} rb,
        logic[31:0] value);
    logic[31:0] mask;
    logic[31:0] expect;
    logic[31:0] actual;

    mask = bit_mask(rb.bound_width());
    expect = value & mask;
    p_sequencer.write_signal(rb, expect);
    #1ns;
    if (signal_name == "output")
        actual = p_sequencer.get_output_value(pad);
    else if (signal_name == "pull_up")
        actual = p_sequencer.get_pull_up(pad);
    else if (signal_name == "pull_down")
        actual = p_sequencer.get_pull_down(pad);
    else if (signal_name == "drive_strength")
        actual = p_sequencer.get_drive_strength(pad);
    else
        `uvm_fatal("PAD", $sformatf("unknown signal %s", signal_name))
    if ((actual & mask) !== expect) begin
        ok = 1'b0;
        `uvm_error("PAD", $sformatf(
            "%s.%s connection mismatch: expect 0x%0h actual 0x%0h",
            pad.name, signal_name, expect, actual & mask))
    end
endtask

`endif
