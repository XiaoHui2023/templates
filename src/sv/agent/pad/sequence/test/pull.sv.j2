`ifndef {{ class_pull_test_seq | upper }}
`define {{ class_pull_test_seq | upper }}

class {{ class_pull_test_seq }} extends {{ class_base_seq }};
    `uvm_object_utils_begin({{ class_pull_test_seq }})
        `uvm_field_int(ok,UVM_ALL_ON)
    `uvm_object_utils_end

    bit ok = 1'b1;

    function new(string name = "{{ class_pull_test_seq }}");
        super.new(name);
    endfunction

    extern function logic[31:0] bit_mask(int width);
    extern task body();
    extern task test_one_bit({{ class_pad_data }} pad, int bit_index, bit target_pull_up);
    extern task test_pull({{ class_pad_data }} pad, logic[31:0] pull_up, logic[31:0] pull_down, logic[31:0] expect);
    extern function logic[31:0] expected_value({{ class_pad_data }} pad, logic[31:0] pull_up, logic[31:0] pull_down);
endclass

function logic[31:0] {{ class_pull_test_seq }}::bit_mask(int width);
    if (width <= 0)
        return '0;
    if (width >= 32)
        return 32'hffff_ffff;
    return 32'hffff_ffff >> (32 - width);
endfunction

task {{ class_pull_test_seq }}::body();
    ok = 1'b1;
    p_sequencer.check_ready();
    foreach (settings.pads[i])
        for (int bit_index = 0; bit_index < settings.pads[i].pad_value_width; bit_index++) begin
            test_one_bit(settings.pads[i], bit_index, 1'b1);
            test_one_bit(settings.pads[i], bit_index, 1'b0);
        end
endtask

task {{ class_pull_test_seq }}::test_one_bit({{ class_pad_data }} pad, int bit_index, bit target_pull_up);
    logic[31:0] mask;
    logic[31:0] bit_value;
    logic[31:0] pull_up;
    logic[31:0] pull_down;
    logic[31:0] expect;

    if (pad == null)
        `uvm_fatal("PAD", "test_one_bit: pad is null")
    mask = bit_mask(pad.pad_value_width);
    bit_value = 32'h1 << bit_index;
    if (target_pull_up) begin
        pull_up = bit_value;
        pull_down = mask & ~bit_value;
    end else begin
        pull_up = mask & ~bit_value;
        pull_down = bit_value;
    end
    expect = expected_value(pad, pull_up, pull_down);
    test_pull(pad, pull_up, pull_down, expect);
endtask

task {{ class_pull_test_seq }}::test_pull(
        {{ class_pad_data }} pad,
        logic[31:0] pull_up,
        logic[31:0] pull_down,
        logic[31:0] expect);
    logic[31:0] mask;
    logic[31:0] actual;

    if (pad == null)
        `uvm_fatal("PAD", "test_pull: pad is null")
    p_sequencer.config_pad(
        pad,
        0,
        pull_up,
        pull_down,
        0);
    #1ns;
    mask = bit_mask(pad.pad_value_width);
    actual = p_sequencer.get_pad_value(pad);
    if ((actual & mask) !== (expect & mask)) begin
        ok = 1'b0;
        `uvm_error("PAD", $sformatf(
            "%s pull mismatch: pull_up=0x%0h pull_down=0x%0h fixed_up=%0b fixed_down=%0b expect=0x%0h actual=0x%0h",
            pad.name, pull_up, pull_down, pad.fixed_pull_up, pad.fixed_pull_down, expect & mask, actual & mask))
    end
endtask

function logic[31:0] {{ class_pull_test_seq }}::expected_value(
        {{ class_pad_data }} pad,
        logic[31:0] pull_up,
        logic[31:0] pull_down);
    logic[31:0] mask;

    mask = bit_mask(pad.pad_value_width);
    if (pad.fixed_pull_up)
        return mask;
    if (pad.fixed_pull_down)
        return '0;
    return pull_up & ~pull_down & mask;
endfunction

`endif
