`ifndef {{ class_pull_test_seq | upper }}
`define {{ class_pull_test_seq | upper }}

class {{ class_pull_test_seq }} extends {{ class_base_seq }};
    `uvm_object_utils_begin({{ class_pull_test_seq }})
        `uvm_field_int(ok,UVM_ALL_ON)
    `uvm_object_utils_end

    bit ok = 1'b1;

    function new(string name = "{{ class_pull_test_seq }}");
        super.new(name);
    endfunction

    extern function logic[31:0] bit_mask(int width);
    extern task body();
    extern task test_one_bit({{ class_pad_data }} pad, int bit_index, bit target_pull_up);
    extern task test_pull({{ class_pad_data }} pad, {{ class_signal_data }} pad_value_signal, {{ class_signal_data }} pull_up_signal, {{ class_signal_data }} pull_down_signal, logic[31:0] pull_up, logic[31:0] pull_down);
    extern function logic[31:0] effective_value({{ class_signal_data }} signal, logic[31:0] configured_value);
    extern function logic[31:0] expected_value({{ class_pad_data }} pad, {{ class_signal_data }} pull_up_signal, {{ class_signal_data }} pull_down_signal, logic[31:0] pull_up, logic[31:0] pull_down);
endclass

function logic[31:0] {{ class_pull_test_seq }}::bit_mask(int width);
    if (width <= 0)
        return '0;
    if (width >= 32)
        return 32'hffff_ffff;
    return 32'hffff_ffff >> (32 - width);
endfunction

task {{ class_pull_test_seq }}::body();
    {{ class_signal_data }} pad_value_signal;

    ok = 1'b1;
    p_sequencer.check_ready();
    foreach (settings.pads[i]) begin
        pad_value_signal = settings.pads[i].find_signal("pad_value");
        if (pad_value_signal == null) begin
            `uvm_info("PAD", $sformatf("omit pull test for %s: no pad_value signal", settings.pads[i].name), UVM_LOW)
            continue;
        end
        for (int bit_index = 0; bit_index < pad_value_signal.width; bit_index++) begin
            test_one_bit(settings.pads[i], bit_index, 1'b1);
            test_one_bit(settings.pads[i], bit_index, 1'b0);
        end
    end
endtask

task {{ class_pull_test_seq }}::test_one_bit({{ class_pad_data }} pad, int bit_index, bit target_pull_up);
    {{ class_signal_data }} pad_value_signal;
    {{ class_signal_data }} pull_up_signal;
    {{ class_signal_data }} pull_down_signal;
    logic[31:0] mask;
    logic[31:0] bit_value;
    logic[31:0] pull_up;
    logic[31:0] pull_down;

    if (pad == null)
        `uvm_fatal("PAD", "test_one_bit: pad is null")
    pad_value_signal = pad.find_signal("pad_value");
    pull_up_signal = pad.find_signal("pull_up");
    pull_down_signal = pad.find_signal("pull_down");
    if (pad_value_signal == null || pull_up_signal == null || pull_down_signal == null) begin
        `uvm_info("PAD", $sformatf(
            "omit pull test for %s: no pad_value, pull_up, or pull_down signal", pad.name), UVM_LOW)
        return;
    end
    mask = bit_mask(pad_value_signal.width);
    bit_value = 32'h1 << bit_index;
    if (target_pull_up) begin
        pull_up = bit_value;
        pull_down = mask & ~bit_value;
    end else begin
        pull_up = mask & ~bit_value;
        pull_down = bit_value;
    end
    test_pull(pad, pad_value_signal, pull_up_signal, pull_down_signal, pull_up, pull_down);
endtask

task {{ class_pull_test_seq }}::test_pull(
        {{ class_pad_data }} pad,
        {{ class_signal_data }} pad_value_signal,
        {{ class_signal_data }} pull_up_signal,
        {{ class_signal_data }} pull_down_signal,
        logic[31:0] pull_up,
        logic[31:0] pull_down);
    logic[31:0] mask;
    logic[31:0] expect;
    logic[31:0] actual;

    if (pad == null)
        `uvm_fatal("PAD", "test_pull: pad is null")
    p_sequencer.config_signal(pull_up_signal, pull_up);
    p_sequencer.config_signal(pull_down_signal, pull_down);
    #1ns;
    mask = bit_mask(pad_value_signal.width);
    expect = expected_value(pad, pull_up_signal, pull_down_signal, pull_up, pull_down);
    actual = p_sequencer.get_signal(pad, pad_value_signal.name);
    if ((actual & mask) !== (expect & mask)) begin
        ok = 1'b0;
        `uvm_error("PAD", $sformatf(
            "%s pull mismatch: pull_up=0x%0h pull_down=0x%0h expect=0x%0h actual=0x%0h",
            pad.name, pull_up, pull_down, expect & mask, actual & mask))
    end
endtask

function logic[31:0] {{ class_pull_test_seq }}::effective_value(
        {{ class_signal_data }} signal,
        logic[31:0] configured_value);
    if (signal.has_fix)
        return signal.fix_value;
    return configured_value;
endfunction

function logic[31:0] {{ class_pull_test_seq }}::expected_value(
        {{ class_pad_data }} pad,
        {{ class_signal_data }} pull_up_signal,
        {{ class_signal_data }} pull_down_signal,
        logic[31:0] pull_up,
        logic[31:0] pull_down);
    logic[31:0] mask;
    logic[31:0] effective_pull_up;
    logic[31:0] effective_pull_down;
    {{ class_signal_data }} pad_value_signal;

    pad_value_signal = pad.find_signal("pad_value");
    if (pad_value_signal == null)
        `uvm_fatal("PAD", "expected_value requires pad_value signal")
    mask = bit_mask(pad_value_signal.width);
    effective_pull_up = effective_value(pull_up_signal, pull_up);
    effective_pull_down = effective_value(pull_down_signal, pull_down);
    return effective_pull_up & ~effective_pull_down & mask;
endfunction

`endif
