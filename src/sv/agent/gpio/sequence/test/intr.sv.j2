    end
endtask

task {{ class_prefix }}intr_test_seq::op_clear_intr_status(output bit ok);
    {{ class_prefix }}clear_intr_status_req req;
    {{ class_prefix }}clear_intr_status_rsp seq_rsp;
    {{ class_prefix }}clear_intr_status_seq seq;

    ok = 1'b1;
    req = {{ class_prefix }}clear_intr_status_req::type_id::create("req");
    seq = {{ class_prefix }}clear_intr_status_seq::type_id::create("clear_intr_status");
    seq.req = req;
    seq.start(p_sequencer);
