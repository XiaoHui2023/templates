`ifndef {{ (class_prefix ~ "inout_test_seq") | upper }}
`define {{ (class_prefix ~ "inout_test_seq") | upper }}

class {{ class_prefix }}inout_test_seq extends uvm_sequence #(
        {{ class_prefix }}inout_test_req,
        {{ class_prefix }}inout_test_rsp);
    `uvm_object_utils({{ class_prefix }}inout_test_seq)
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    {{ class_prefix }}configuration cfg;
    virtual {{ class_prefix }}sub_interface vif;

    function new(string name = "{{ class_prefix }}inout_test_seq");
        super.new(name);
    endfunction

    extern task pre_start();
    extern task body();
    extern task post_start();
    extern task run_one(bit[31:0] dir, bit[31:0] data, output bit ok);
    extern task op_mask_invalid_pin(output bit ok);
    extern task op_set_dir(bit[31:0] data, output bit ok);
    extern task op_set_value(bit[31:0] data, output bit ok);
    extern task op_drive_input(bit[31:0] data, bit[31:0] enable, output bit ok);
    extern task op_get_value(output bit[31:0] data, output bit ok);
endclass

task {{ class_prefix }}inout_test_seq::pre_start();
    super.pre_start();

    cfg = p_sequencer.cfg;
    if (cfg == null)
        `uvm_fatal("", "require cfg")
    vif = p_sequencer.vif;

    if (starting_phase)
        starting_phase.raise_objection(this);
    `uvm_info("", "Enter", UVM_LOW)
endtask

task {{ class_prefix }}inout_test_seq::body();
    {{ class_prefix }}inout_test_req rq;
    {{ class_prefix }}inout_test_rsp rs;
    bit[31:0] dir;
    bit[31:0] data;
    bit ok;

    if (req == null) begin
        rq = {{ class_prefix }}inout_test_req::type_id::create("req");
    end else begin
        rq = req;
    end

    rs = {{ class_prefix }}inout_test_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    op_mask_invalid_pin(ok);
    rs.ok &= ok;

    for (int i = 0; i < cfg.num; i++) begin
        if (cfg.mask[i])
            continue;

        dir = 1 << i;

        data = 1 << i;
        run_one(dir, data, ok);
        rs.ok &= ok;

        data = ~data;
        run_one(dir, data, ok);
        rs.ok &= ok;

        dir = ~dir;

        data = 1 << i;
        run_one(dir, data, ok);
        rs.ok &= ok;

        data = ~data;
        run_one(dir, data, ok);
        rs.ok &= ok;
    end

    rsp = rs;
endtask

task {{ class_prefix }}inout_test_seq::post_start();
    super.post_start();

    `uvm_info("", "Exit", UVM_LOW)
    if (starting_phase)
        starting_phase.drop_objection(this);
endtask

task {{ class_prefix }}inout_test_seq::run_one(bit[31:0] dir, bit[31:0] data, output bit ok);
    bit[31:0] rdata;
    bit[31:0] active_mask;
    bit op_ok;

    ok = 1'b1;
    active_mask = '0;
    for (int i = 0; i < cfg.num; i++)
        active_mask[i] = !cfg.mask[i];

    op_set_dir(dir & active_mask, op_ok);
    ok &= op_ok;
    op_set_value(data & active_mask, op_ok);
    ok &= op_ok;
    op_drive_input(data & active_mask, ~dir & active_mask, op_ok);
    ok &= op_ok;
    op_get_value(rdata, op_ok);
    ok &= op_ok;

    if ((rdata & active_mask) != (data & active_mask)) begin
        ok = 1'b0;
        `uvm_error("", $sformatf("gpio data mismatch: expect=%h actual=%h", data & active_mask, rdata & active_mask))
    end
endtask

task {{ class_prefix }}inout_test_seq::op_mask_invalid_pin(output bit ok);
    {{ class_prefix }}mask_invalid_pin_req req;
    {{ class_prefix }}mask_invalid_pin_rsp seq_rsp;
    {{ class_prefix }}mask_invalid_pin_seq seq;

    ok = 1'b1;
    req = {{ class_prefix }}mask_invalid_pin_req::type_id::create("req");
    seq = {{ class_prefix }}mask_invalid_pin_seq::type_id::create("mask_invalid_pin");
    seq.req = req;
    seq.start(p_sequencer);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok) begin
        ok = 1'b0;
        `uvm_error("", "mask_invalid_pin operation failed")
    end
endtask

task {{ class_prefix }}inout_test_seq::op_set_dir(bit[31:0] data, output bit ok);
    {{ class_prefix }}set_dir_req req;
    {{ class_prefix }}set_dir_rsp seq_rsp;
    {{ class_prefix }}set_dir_seq seq;

    ok = 1'b1;
    req = {{ class_prefix }}set_dir_req::type_id::create("req");
    req.data = data;
    seq = {{ class_prefix }}set_dir_seq::type_id::create("set_dir");
    seq.req = req;
    seq.start(p_sequencer);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok) begin
        ok = 1'b0;
        `uvm_error("", "set_dir operation failed")
    end
endtask

task {{ class_prefix }}inout_test_seq::op_set_value(bit[31:0] data, output bit ok);
    {{ class_prefix }}set_value_req req;
    {{ class_prefix }}set_value_rsp seq_rsp;
    {{ class_prefix }}set_value_seq seq;

    ok = 1'b1;
    req = {{ class_prefix }}set_value_req::type_id::create("req");
    req.data = data;
    seq = {{ class_prefix }}set_value_seq::type_id::create("set_value");
    seq.req = req;
    seq.start(p_sequencer);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok) begin
        ok = 1'b0;
        `uvm_error("", "set_value operation failed")
    end
endtask

task {{ class_prefix }}inout_test_seq::op_drive_input(bit[31:0] data, bit[31:0] enable, output bit ok);
    {{ class_prefix }}drive_input_req req;
    {{ class_prefix }}drive_input_rsp seq_rsp;
    {{ class_prefix }}drive_input_seq seq;

    ok = 1'b1;
    req = {{ class_prefix }}drive_input_req::type_id::create("req");
    req.data = data;
    req.enable = enable;
    seq = {{ class_prefix }}drive_input_seq::type_id::create("drive_input");
    seq.req = req;
    seq.start(p_sequencer);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok) begin
        ok = 1'b0;
        `uvm_error("", "drive_input operation failed")
    end
endtask

task {{ class_prefix }}inout_test_seq::op_get_value(output bit[31:0] data, output bit ok);
    {{ class_prefix }}get_value_req req;
    {{ class_prefix }}get_value_rsp seq_rsp;
    {{ class_prefix }}get_value_seq seq;

    ok = 1'b1;
    req = {{ class_prefix }}get_value_req::type_id::create("req");
    seq = {{ class_prefix }}get_value_seq::type_id::create("get_value");
    seq.req = req;
    seq.start(p_sequencer);
    seq_rsp = seq.rsp;
    if (seq_rsp == null || !seq_rsp.ok) begin
        ok = 1'b0;
        `uvm_error("", "get_value operation failed")
    end else begin
        data = seq_rsp.data;
    end
endtask

`endif
