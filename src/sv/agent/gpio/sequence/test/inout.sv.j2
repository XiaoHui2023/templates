`ifndef {{ (class_prefix ~ "inout_test_seq") | upper }}
`define {{ (class_prefix ~ "inout_test_seq") | upper }}

class {{ class_prefix }}inout_test_seq extends uvm_sequence;
    `uvm_object_utils_begin({{ class_prefix }}inout_test_seq)
        `uvm_field_int(quiet,UVM_ALL_ON)
        `uvm_field_int(ok,UVM_ALL_ON)
    `uvm_object_utils_end
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    bit quiet;
    bit ok = 1'b1;
    {{ class_prefix }}configuration cfg;
    virtual {{ class_prefix }}sub_interface vif;

    function new(string name = "{{ class_prefix }}inout_test_seq");
        super.new(name);
    endfunction

    extern task pre_start();
    extern task body();
    extern task post_start();
    extern task run_one(int bit_index, bit[31:0] dir, bit[31:0] data, output bit ok);
    extern task op_mask_invalid_pin(output bit ok);
    extern task op_set_dir(bit[31:0] data, output bit ok);
    extern task op_set_value(bit[31:0] data, output bit ok);
    extern task op_drive_input(bit[31:0] data, bit[31:0] enable, output bit ok);
    extern task op_get_value(output bit[31:0] data, output bit ok);
    extern task op_get_external_value(output bit[31:0] data, output bit ok);
endclass

task {{ class_prefix }}inout_test_seq::pre_start();
    super.pre_start();

    cfg = p_sequencer.cfg;
    if (cfg == null)
        `uvm_fatal("", "require cfg")
    vif = p_sequencer.vif;

    if (starting_phase)
        starting_phase.raise_objection(this);
    `uvm_info("", "Enter", UVM_LOW)
endtask

task {{ class_prefix }}inout_test_seq::body();
    bit[31:0] dir;
    bit[31:0] data;
    bit op_ok;

    ok = 1'b1;

    op_mask_invalid_pin(op_ok);
    ok &= op_ok;

    for (int i = 0; i < cfg.num; i++) begin
        if (cfg.mask[i])
            continue;

        dir = 1 << i;

        data = 1 << i;
        run_one(i, dir, data, op_ok);
        ok &= op_ok;

        data = ~data;
        run_one(i, dir, data, op_ok);
        ok &= op_ok;

        dir = ~dir;

        data = 1 << i;
        run_one(i, dir, data, op_ok);
        ok &= op_ok;

        data = ~data;
        run_one(i, dir, data, op_ok);
        ok &= op_ok;
    end

    op_drive_input(0, '0, op_ok);
    ok &= op_ok;
    op_set_value(0, op_ok);
    ok &= op_ok;
    op_set_dir(0, op_ok);
    ok &= op_ok;
endtask

task {{ class_prefix }}inout_test_seq::post_start();
    super.post_start();

    `uvm_info("", "Exit", UVM_LOW)
    if (starting_phase)
        starting_phase.drop_objection(this);
endtask

task {{ class_prefix }}inout_test_seq::run_one(int bit_index, bit[31:0] dir, bit[31:0] data, output bit ok);
    bit[31:0] external_data;
    bit[31:0] controller_data;
    bit[31:0] actual_data;
    bit[31:0] active_mask;
    bit[31:0] output_mask;
    bit[31:0] input_mask;
    bit op_ok;

    ok = 1'b1;
    active_mask = '0;
    for (int i = 0; i < cfg.num; i++)
        active_mask[i] = !cfg.mask[i];

    op_set_dir(dir & active_mask, op_ok);
    ok &= op_ok;
    op_set_value(data & active_mask, op_ok);
    ok &= op_ok;
    op_drive_input(data & active_mask, ~dir & active_mask, op_ok);
    ok &= op_ok;
    output_mask = dir & active_mask;
    input_mask = ~dir & active_mask;
    op_get_external_value(external_data, op_ok);
    ok &= op_ok;
    op_get_value(controller_data, op_ok);
    ok &= op_ok;
    actual_data = (external_data & output_mask) | (controller_data & input_mask);

    if ((actual_data & active_mask) != (data & active_mask)) begin
        ok = 1'b0;
        `uvm_error("", $sformatf("gpio inout test mismatch: group=%s bit=%0d output_mask=%h input_mask=%h expect=%h actual=%h external=%h controller=%h",
                cfg.group_name,
                bit_index,
                output_mask,
                input_mask,
                data & active_mask,
                actual_data & active_mask,
                external_data & active_mask,
                controller_data & active_mask))
    end
endtask

task {{ class_prefix }}inout_test_seq::op_mask_invalid_pin(output bit ok);
    {{ class_prefix }}mask_invalid_pin_req req;
    {{ class_prefix }}mask_invalid_pin_rsp seq_rsp;
    {{ class_prefix }}mask_invalid_pin_seq seq;

    ok = 1'b1;
    req = {{ class_prefix }}mask_invalid_pin_req::type_id::create("req");
    seq = {{ class_prefix }}mask_invalid_pin_seq::type_id::create("mask_invalid_pin");
    seq.req = req;
    seq.start(p_sequencer);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok) begin
        ok = 1'b0;
        `uvm_error("", "mask_invalid_pin operation failed")
    end
endtask

