task {{ class_prefix }}intr_test_seq::op_wait_intr(output bit intr_ok, int timeout, output bit op_ok);
    {{ class_prefix }}wait_intr_req req;
    {{ class_prefix }}wait_intr_rsp seq_rsp;
    {{ class_prefix }}wait_intr_seq seq;

    intr_ok = 1'b0;
    op_ok = 1'b1;
    req = {{ class_prefix }}wait_intr_req::type_id::create("req");
    req.timeout = timeout;
    seq = {{ class_prefix }}wait_intr_seq::type_id::create("wait_intr");
    seq.req = req;
    seq.start(p_sequencer);
    seq_rsp = seq.rsp;
    if (seq_rsp == null) begin
        op_ok = 1'b0;
        `uvm_error("", "wait_intr operation failed")
    end else begin
        intr_ok = seq_rsp.ok;
    end
endtask

task {{ class_prefix }}intr_test_seq::op_get_intr_status(output bit intr, output bit ok);
    {{ class_prefix }}get_intr_status_req req;
    {{ class_prefix }}get_intr_status_rsp seq_rsp;
    {{ class_prefix }}get_intr_status_seq seq;

    ok = 1'b1;
    req = {{ class_prefix }}get_intr_status_req::type_id::create("req");
    seq = {{ class_prefix }}get_intr_status_seq::type_id::create("get_intr_status");
    seq.req = req;
    seq.start(p_sequencer);
    seq_rsp = seq.rsp;
    if (seq_rsp == null || !seq_rsp.ok) begin
        ok = 1'b0;
        `uvm_error("", "get_intr_status operation failed")
    end else begin
        intr = seq_rsp.intr;
    end
endtask

`endif
