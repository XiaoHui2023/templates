    {{ class_prefix }}clear_intr_status_req req;
    {{ class_prefix }}clear_intr_status_rsp seq_rsp;
    {{ class_prefix }}clear_intr_status_seq seq;

    ok = 1'b1;
    req = {{ class_prefix }}clear_intr_status_req::type_id::create("req");
