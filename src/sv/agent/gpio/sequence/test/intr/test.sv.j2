task {{ class_prefix }}intr_test_seq::op_set_rise_intr(bit[31:0] data, output bit ok);
    {{ class_prefix }}set_rise_intr_req req;
    {{ class_prefix }}set_rise_intr_rsp seq_rsp;
    {{ class_prefix }}set_rise_intr_seq seq;

    ok = 1'b1;
    req = {{ class_prefix }}set_rise_intr_req::type_id::create("req");
    req.data = data;
    seq = {{ class_prefix }}set_rise_intr_seq::type_id::create("set_rise_intr");
    seq.req = req;
    seq.start(p_sequencer);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok) begin
