`ifndef {{ (class_prefix ~ "set_rise_intr_seq") | upper }}
`define {{ (class_prefix ~ "set_rise_intr_seq") | upper }}

class {{ class_prefix }}set_rise_intr_seq extends uvm_sequence #(
        {{ class_prefix }}set_rise_intr_req,
        {{ class_prefix }}set_rise_intr_rsp);
    `uvm_object_utils({{ class_prefix }}set_rise_intr_seq)
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    function new(string name="{{ class_prefix }}set_rise_intr_seq");
        super.new(name);
    endfunction

    extern virtual task body();
endclass

task {{ class_prefix }}set_rise_intr_seq::body();
    {{ class_prefix }}set_rise_intr_rsp rs;
    uvm_status_e status;
    bit[31:0] active_mask;

    if (req == null)
        `uvm_fatal("", "set_rise_intr req is null")
    rs = {{ class_prefix }}set_rise_intr_rsp::type_id::create("rsp");
    active_mask = '0;
    for (int i = 0; i < p_sequencer.cfg.num; i++)
        active_mask[i] = !p_sequencer.cfg.mask[i];
    p_sequencer.cfg.regmodel.{{ regmodel.int0_en }}.write(status, req.data & active_mask);
    p_sequencer.cfg.regmodel.{{ regmodel.int_rise_en }}.write(status, req.data & active_mask);
    rsp = rs;
endtask

`endif
