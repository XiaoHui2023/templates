`ifndef {{ (class_prefix ~ "sub_configuration") | upper }}
`define {{ (class_prefix ~ "sub_configuration") | upper }}

class {{ class_prefix }}sub_configuration extends uvm_sequence_item;
    `uvm_object_utils_begin({{ class_prefix }}sub_configuration)
        `uvm_field_string(group_name,UVM_ALL_ON)
        `uvm_field_int(num,UVM_ALL_ON)
        `uvm_field_int(pin_mask,UVM_ALL_ON)
        `uvm_field_object(regmodel,UVM_ALL_ON|UVM_NOPRINT|UVM_NOCOPY)
        `uvm_field_int(has_randomized,UVM_ALL_ON|UVM_NOPRINT)
    `uvm_object_utils_end

    string group_name;
    virtual {{ class_prefix }}sub_interface vif;
    {{ class_regmodel }} regmodel;
    rand int num;
    rand bit[31:0] pin_mask;
    rand bit has_randomized;

    function new(string name="{{ class_prefix }}sub_configuration");
        super.new(name);
    endfunction

    constraint cst {
        regmodel != null;
        has_randomized == 1;

        foreach(pin_mask[i]) {
            if(i < num)
                soft pin_mask[i] == 1;
            else
                pin_mask[i] == 0;
        }

        soft num == 32;
        num inside {[0:32]};
    }

    function void post_randomize();
        super.post_randomize();

        if(!vif)
            `uvm_fatal("", "require vif")
    endfunction

    constraint cst_user;
    constraint cst_case;
endclass

`endif
