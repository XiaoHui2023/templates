{
    "settings": {
        "class_prefix": "clk_tree_",
        "class_regmodel": "regmodel_t",
        "direct_config": true,
        "plugin": {}
    },
    "nodes": {
        "osc": {
            "kind": "source",
            "config": {
                "frequence": 24000000
            }
        },
        "pll_tci": {
            "kind": "pll_tci",
            "source": "osc",
            "config": {
                "frequence": 48000000
            },
            "regs": {
                "lock": "blk_pll_tci.lock",
                "bypass": "blk_pll_tci.bypass",
                "pwrdn": "blk_pll_tci.pwrdn",
                "reset": "blk_pll_tci.reset",
                "clkod": "blk_pll_tci.clkod",
                "clkf": "blk_pll_tci.clkf",
                "clkr": "blk_pll_tci.clkr",
                "bwadj": "blk_pll_tci.bwadj"
            }
        },
        "mux0": {
            "kind": "mux",
            "source": {
                "0": "osc",
                "1": "pll_tci"
            },
            "reg": "blk_mux0.sel",
            "config": {
                "max_sel": 1
            }
        },
        "gate0": {
            "kind": "gate",
            "source": "mux0",
            "reg": "blk_gate0.en"
        },
        "div0": {
            "kind": "div_div",
            "source": "gate0",
            "regs": {
                "rst": "blk_div0.rst",
                "load": "blk_div0.load",
                "div": "blk_div0.div"
            }
        },
        "clk_out": {
            "kind": "clk",
            "path": "dut.clk_out",
            "source": "div0"
        }
    }
}
