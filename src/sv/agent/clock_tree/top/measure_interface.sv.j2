{% if any_node_path %}
`ifndef {{ (settings.class_prefix ~ "measure_interface") | upper }}
`define {{ (settings.class_prefix ~ "measure_interface") | upper }}

interface {{ settings.class_prefix }}measure_interface #(
    parameter int MIN_FREQ_HZ = {{ settings.min_freq_hz }},
    parameter int STABLE_CYCLES = {{ settings.stable_cycles }},
    parameter real PERIOD_TOL = {{ settings.period_tolerance }},
    parameter real DUTY_MIN_PCT = {{ settings.duty_min }},
    parameter real DUTY_MAX_PCT = {{ settings.duty_max }}
) (
    input wire in
);
    timeunit 1ns;
    timeprecision 1fs;

    localparam real DUTY_MIN = DUTY_MIN_PCT / 100.0;
    localparam real DUTY_MAX = DUTY_MAX_PCT / 100.0;
    localparam real DUTY_BOUND_EPS = 1.0e-9;
    localparam real RT_PER_SEC = 1.0e9;

    bit meas_en;

    logic active;
    real freq_hz;
    real duty;
    logic duty_ok;
    logic stable;

    realtime last_edge_t;
    realtime last_posedge_t;
    realtime last_period_t;
    realtime high_end_t;
    int stable_match_cnt;
    int min_freq_hz_rt;
    int meas_timeout_ns_rt;
    real max_edge_period_rt;

    // 按最低频率更新超时与最大边沿间隔
    // hz — 最低频率，Hz
    function automatic void update_meas_timing_from_min_freq(int hz);
        if (hz < MIN_FREQ_HZ)
            hz = MIN_FREQ_HZ;
        min_freq_hz_rt = hz;
        meas_timeout_ns_rt = (1_000_000_000 + hz - 1) / hz;
        max_edge_period_rt = RT_PER_SEC / hz;
    endfunction

    // 清零测量结果与边沿状态
    function automatic void reset_measure();
        active = 1'b0;
        stable = 1'b0;
        freq_hz = 0.0;
        duty = 0.0;
        duty_ok = 1'b0;
        last_edge_t = 0.0;
        last_posedge_t = 0.0;
        last_period_t = 0.0;
        high_end_t = 0.0;
        stable_match_cnt = 0;
    endfunction

    // 超时表示测量结束且无有效边沿
    function automatic void mark_timeout();
        active = 1'b0;
        stable = 1'b1;
        freq_hz = 0.0;
        duty = 0.0;
        duty_ok = 1'b0;
        stable_match_cnt = 0;
    endfunction

    // 根据相邻上升沿更新频率、占空比与 stable
    function automatic void sample_period(realtime pos_t, realtime prev_pos_t);
        realtime period_t;
        realtime high_t;
        real rel_diff;

        period_t = pos_t - prev_pos_t;
        if (period_t <= 0.0)
            return;

        if (period_t > max_edge_period_rt)
            return;

        freq_hz = RT_PER_SEC / period_t;

        if (high_end_t > prev_pos_t && high_end_t <= pos_t) begin
            high_t = high_end_t - prev_pos_t;
            duty = high_t / period_t;
            if (duty < 0.0)
                duty = 0.0;
            else if (duty > 1.0)
                duty = 1.0;
            duty_ok = (duty + DUTY_BOUND_EPS >= DUTY_MIN)
                && (duty <= DUTY_MAX + DUTY_BOUND_EPS);
        end

        if (last_period_t > 0.0) begin
            rel_diff = (period_t > last_period_t) ?
                (period_t - last_period_t) / last_period_t :
                (last_period_t - period_t) / last_period_t;
            if (rel_diff <= PERIOD_TOL)
                stable_match_cnt++;
            else
                stable_match_cnt = 0;
            if (stable_match_cnt >= STABLE_CYCLES - 1)
                stable = 1'b1;
        end

        last_period_t = period_t;
    endfunction

    // 可测量的最低频率，单位 Hz
    // hz — 最低频率，Hz
    function automatic void set_min_freq_hz(int hz);
        update_meas_timing_from_min_freq(hz);
    endfunction

    // 写测量开关；关时清零测量结果
    // en — 测量开关
    function automatic void set_measure_en(bit en);
        meas_en = en;
        if (!en)
            reset_measure();
    endfunction

    // 清零测量结果后开启测量
    function automatic void start_measure();
        reset_measure();
        meas_en = 1'b1;
    endfunction

    // 关闭测量并清零测量结果
    function automatic void stop_measure();
        set_measure_en(1'b0);
    endfunction

    // 轮询 stable，最长 meas_timeout_ns_rt
    // ok — 为真表示在时限内达到稳定
    task automatic wait_measure_stable(output bit ok);
        int elapsed_ns;

        elapsed_ns = 0;
        ok = 1'b0;
        while (!stable && elapsed_ns < meas_timeout_ns_rt) begin
            #1ns;
            elapsed_ns++;
        end
        ok = stable;
    endtask

    // 监视上升沿并采样周期
    task automatic watch_posedge();
        realtime now_t;
        realtime prev_pos_t;

        forever begin
            @(posedge in);
            if (!meas_en)
                continue;

            now_t = $realtime;
            last_edge_t = now_t;
            active = 1'b1;

            prev_pos_t = last_posedge_t;
            last_posedge_t = now_t;

            if (prev_pos_t > 0.0)
                sample_period(now_t, prev_pos_t);
        end
    endtask

    // 监视下降沿并记录高电平结束时刻
    task automatic watch_negedge();
        forever begin
            @(negedge in);
            if (!meas_en)
                continue;

            last_edge_t = $realtime;
            active = 1'b1;
            high_end_t = last_edge_t;
        end
    endtask

    initial begin
        meas_en = 1'b0;
        update_meas_timing_from_min_freq(MIN_FREQ_HZ);
        reset_measure();
    end

    initial begin
        watch_posedge();
    end

    initial begin
        watch_negedge();
    end

    initial begin : meas_timeout_loop
        forever begin
            wait (meas_en === 1'b1);
            forever begin
                #(meas_timeout_ns_rt * 1ns);
                if (!meas_en)
                    break;
                if (last_edge_t <= 0.0)
                    mark_timeout();
                else if (($realtime - last_edge_t) >= max_edge_period_rt)
                    mark_timeout();
            end
            reset_measure();
        end
    end
endinterface

`endif
{% endif %}
