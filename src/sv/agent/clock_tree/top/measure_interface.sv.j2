`ifndef {{ (settings.class_prefix ~ "measure_interface") | upper }}
`define {{ (settings.class_prefix ~ "measure_interface") | upper }}

interface {{ settings.class_prefix }}measure_interface #(
    parameter int MIN_FREQ_HZ = {{ settings.min_freq_hz }},
    parameter int ACTIVE_CYCLES = {{ settings.active_cycles }},
    parameter int STABLE_CYCLES = {{ settings.stable_cycles }},
    parameter real PERIOD_TOL = {{ settings.period_tolerance }},
    parameter real DUTY_MIN_PCT = {{ settings.duty_min }},
    parameter real DUTY_MAX_PCT = {{ settings.duty_max }},
    parameter real DUTY_TOL_PCT = {{ settings.duty_tolerance_pct }}
) (
    input wire in
);
    timeunit 1ns;
    timeprecision 1fs;

    localparam real DUTY_MIN = (DUTY_MIN_PCT - DUTY_TOL_PCT) / 100.0;
    localparam real DUTY_MAX = (DUTY_MAX_PCT + DUTY_TOL_PCT) / 100.0;
    localparam real DUTY_BOUND_EPS = 1.0e-12;
    localparam real RT_PER_SEC = 1.0e9;

    bit meas_en;

    logic active;
    logic activity_ok;
    logic inactive;
    real freq_hz;
    real duty;
    logic duty_ok;
    logic freq_stable;
    logic duty_stable;
    logic timed_out;
    real phase_frac;

    real last_freq_hz;
    real last_duty;
    real last_phase_frac;
    logic last_valid;

    realtime last_edge_t;
    realtime ref_posedge_t;
    realtime last_posedge_t;
    realtime last_period_t;
    realtime high_end_t;
    int activity_edge_cnt;
    int freq_stable_cnt;
    int duty_stable_cnt;
    int min_freq_hz_rt;
    int active_timeout_ns_rt;
    int stable_timeout_ns_rt;
    real max_edge_period_rt;
    realtime activity_start_t;

    // 周期内归一化相位，取值 0 以上且小于 1
    // t — 上升沿时刻
    // t_ref — 参考 0 时刻
    // period — 当前周期
    function automatic real frac_phase(
            realtime t,
            realtime t_ref,
            real period);
        real offset;
        real cycles;

        if (period <= 0.0)
            return 0.0;
        offset = (t - t_ref) / period;
        cycles = offset - $floor(offset);
        if (cycles < 0.0)
            cycles += 1.0;
        return cycles;
    endfunction

    // 按最低频率更新活动与稳定阶段超时及最大边沿间隔
    // hz — 最低频率，Hz
    function automatic void update_meas_timing_from_min_freq(int hz);
        int period_ns;

        if (hz < MIN_FREQ_HZ)
            hz = MIN_FREQ_HZ;
        min_freq_hz_rt = hz;
        period_ns = (1_000_000_000 + hz - 1) / hz;
        active_timeout_ns_rt = period_ns * ACTIVE_CYCLES;
        // 频率稳定需要一个基准周期，再累计 STABLE_CYCLES 次比较。
        stable_timeout_ns_rt = period_ns * (STABLE_CYCLES + 1);
        max_edge_period_rt = RT_PER_SEC / hz;
    endfunction

    // 活动阶段：自起点或上一边沿起超过 max_edge_period_rt 仍无边沿则 inactive
    function automatic void check_activity_silence_inactive();
        if (activity_ok || inactive || !meas_en)
            return;
        if (activity_edge_cnt == 0) begin
            if (($realtime - activity_start_t) >= max_edge_period_rt)
                mark_inactive();
        end
        else if (($realtime - last_edge_t) >= max_edge_period_rt)
            mark_inactive();
    endfunction

    // 将当前读数写入 last_* 快照
    function automatic void latch_last_results();
        if (activity_ok) begin
            last_freq_hz = freq_hz;
            last_duty = duty;
            last_phase_frac = phase_frac;
            last_valid = 1'b1;
        end
    endfunction

    // 清零测量结果与边沿状态
    function automatic void reset_measure();
        active = 1'b0;
        activity_ok = 1'b0;
        inactive = 1'b0;
        freq_stable = 1'b0;
        duty_stable = 1'b0;
        timed_out = 1'b0;
        freq_hz = 0.0;
        duty = 0.0;
        duty_ok = 1'b0;
        phase_frac = 0.0;
        last_edge_t = 0.0;
        ref_posedge_t = 0.0;
        last_posedge_t = 0.0;
        last_period_t = 0.0;
        high_end_t = 0.0;
        activity_edge_cnt = 0;
        freq_stable_cnt = 0;
        duty_stable_cnt = 0;
    endfunction

    // 活动阶段未采够上升沿时结束测量
    function automatic void mark_inactive();
        active = 1'b0;
        activity_ok = 1'b0;
        inactive = 1'b1;
        timed_out = 1'b0;
        freq_stable = 1'b0;
        duty_stable = 1'b0;
        freq_stable_cnt = 0;
        duty_stable_cnt = 0;
    endfunction

    // 活动已确认但在稳定阶段时限内未达到稳定计数
    function automatic void mark_timeout();
        latch_last_results();
        active = 1'b1;
        activity_ok = 1'b1;
        inactive = 1'b0;
        timed_out = 1'b1;
        freq_stable = 1'b0;
        duty_stable = 1'b0;
        freq_stable_cnt = 0;
        duty_stable_cnt = 0;
    endfunction

    // 活动确认后根据相邻上升沿更新频率、占空比与稳定计数
    function automatic void sample_period(realtime pos_t, realtime prev_pos_t);
        realtime period_t;
        realtime high_t;
        real rel_diff;

        period_t = pos_t - prev_pos_t;
        if (period_t <= 0.0)
            return;

        if (period_t > max_edge_period_rt)
            return;

        freq_hz = RT_PER_SEC / period_t;

        if (ref_posedge_t <= 0.0)
            ref_posedge_t = pos_t;
        phase_frac = frac_phase(pos_t, ref_posedge_t, period_t);

        if (high_end_t > prev_pos_t && high_end_t <= pos_t) begin
            high_t = high_end_t - prev_pos_t;
            duty = high_t / period_t;
            if (duty < 0.0)
                duty = 0.0;
            else if (duty > 1.0)
                duty = 1.0;
            duty_ok = (duty + DUTY_BOUND_EPS >= DUTY_MIN)
                && (duty <= DUTY_MAX + DUTY_BOUND_EPS);
        end

        if (last_period_t > 0.0) begin
            rel_diff = (period_t > last_period_t) ?
                (period_t - last_period_t) / last_period_t :
                (last_period_t - period_t) / last_period_t;
            if (rel_diff <= PERIOD_TOL) begin
                freq_stable_cnt++;
                if (freq_stable_cnt >= STABLE_CYCLES)
                    freq_stable = 1'b1;
            end
            else begin
                freq_stable_cnt = 0;
                freq_stable = 1'b0;
            end
        end

        if (duty_ok) begin
            duty_stable_cnt++;
            if (duty_stable_cnt >= STABLE_CYCLES)
                duty_stable = 1'b1;
        end
        else begin
            duty_stable_cnt = 0;
            duty_stable = 1'b0;
        end

        last_period_t = period_t;
    endfunction

    // 可测量的最低频率，单位 Hz
    // hz — 最低频率，Hz
    function automatic void set_min_freq_hz(int hz);
        update_meas_timing_from_min_freq(hz);
    endfunction

    // 写测量开关；关时写入 last_* 并清零测量结果
    // en — 测量开关
    function automatic void set_measure_en(bit en);
        if (!en && meas_en)
            latch_last_results();
        meas_en = en;
        if (!en)
            reset_measure();
    endfunction

    // 清零测量结果后开启测量
    function automatic void start_measure();
        reset_measure();
        meas_en = 1'b1;
        activity_start_t = $realtime;
    endfunction

    // 关闭测量并写入 last_* 快照
    function automatic void stop_measure();
        set_measure_en(1'b0);
    endfunction

    // 一次完成频率测量：开启、等待频率稳定、关闭；结果读 meas.last_freq_hz 等
    task automatic measure_freq_hz();
        bit ok;

        start_measure();
        wait_measure_stable(1'b1, 1'b0, ok);
        stop_measure();
    endtask

    // 轮询活动确认与频率、占空比稳定
    // need_freq — 为真时等待 freq_stable
    // need_duty — 为真时等待 duty_stable
    // ok — 为真表示活动已确认且在稳定时限内达到所需稳定
    task automatic wait_measure_stable(
            input bit need_freq,
            input bit need_duty,
            output bit ok);
        int elapsed_ns;
        bit freq_done;
        bit duty_done;

        elapsed_ns = 0;
        ok = 1'b0;
        while (elapsed_ns < active_timeout_ns_rt) begin
            check_activity_silence_inactive();
            if (activity_ok || inactive)
                break;
            if (!meas_en)
                break;
            #1ns;
            elapsed_ns++;
        end
        if (!activity_ok) begin
            if (!inactive && meas_en)
                mark_inactive();
            return;
        end

        elapsed_ns = 0;
        while (elapsed_ns < stable_timeout_ns_rt) begin
            if (timed_out)
                break;
            if (!meas_en)
                break;
            freq_done = !need_freq || freq_stable;
            duty_done = !need_duty || duty_stable;
            if (freq_done && duty_done) begin
                ok = 1'b1;
                break;
            end
            #1ns;
            elapsed_ns++;
        end
        if (!ok && !timed_out && meas_en) begin
            if (($realtime - last_edge_t) >= max_edge_period_rt
                    || !freq_stable || !duty_stable)
                mark_timeout();
        end
    endtask

    // 监视上升沿并采样周期
    task automatic watch_posedge();
        realtime now_t;
        realtime prev_pos_t;

        forever begin
            @(posedge in);
            if (!meas_en)
                continue;

            now_t = $realtime;
            last_edge_t = now_t;

            prev_pos_t = last_posedge_t;
            last_posedge_t = now_t;

            if (!activity_ok) begin
                activity_edge_cnt++;
                if (activity_edge_cnt >= ACTIVE_CYCLES) begin
                    activity_ok = 1'b1;
                    active = 1'b1;
                    freq_stable_cnt = 0;
                    duty_stable_cnt = 0;
                    freq_stable = 1'b0;
                    duty_stable = 1'b0;
                    last_period_t = 0.0;
                end
            end

            if (activity_ok && prev_pos_t > 0.0)
                sample_period(now_t, prev_pos_t);
        end
    endtask

    // 监视下降沿并记录高电平结束时刻
    task automatic watch_negedge();
        forever begin
            @(negedge in);
            if (!meas_en)
                continue;

            last_edge_t = $realtime;
            high_end_t = last_edge_t;
        end
    endtask

    initial begin
        meas_en = 1'b0;
        last_valid = 1'b0;
        last_freq_hz = 0.0;
        last_duty = 0.0;
        last_phase_frac = 0.0;
        update_meas_timing_from_min_freq(MIN_FREQ_HZ);
        reset_measure();
    end

    initial begin
        watch_posedge();
    end

    initial begin
        watch_negedge();
    end

    initial begin : meas_timeout_loop
        int activity_elapsed_ns;
        forever begin
            wait (meas_en === 1'b1);
            activity_start_t = $realtime;
            activity_elapsed_ns = 0;
            forever begin
                if (!meas_en)
                    break;
                if (activity_ok || inactive)
                    break;
                check_activity_silence_inactive();
                if (inactive)
                    break;
                if (activity_elapsed_ns >= active_timeout_ns_rt) begin
                    if (!activity_ok)
                        mark_inactive();
                    break;
                end
                #1ns;
                activity_elapsed_ns++;
            end
            if (!meas_en)
                continue;
            if (!activity_ok) begin
                if (!inactive)
                    mark_inactive();
                meas_en = 1'b0;
                continue;
            end
            forever begin
                #(stable_timeout_ns_rt * 1ns);
                if (!meas_en)
                    break;
                if (($realtime - last_edge_t) >= max_edge_period_rt
                        || !freq_stable || !duty_stable) begin
                    mark_timeout();
                    meas_en = 1'b0;
                    break;
                end
                latch_last_results();
                meas_en = 1'b0;
                break;
            end
        end
    end
endinterface

`endif
