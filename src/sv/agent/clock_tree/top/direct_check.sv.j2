{% if settings.direct_mode and any_node_path %}
`ifndef {{ (settings.class_prefix ~ "direct_check") | upper }}
`define {{ (settings.class_prefix ~ "direct_check") | upper }}

task automatic {{ settings.class_prefix }}direct_check(
    virtual {{ settings.class_prefix }}tree_interface tree_if
);
    bit ok;

    ok = 1'b1;

    if (tree_if == null)
        $fatal(1, "CLK_TREE: direct_check tree_if is null");

{%- for slot in tree.connectable_slots %}
{%- set node = tree.nodes[slot.node_key] %}
{%- set vif_name = slot.node_key ~ ("_" ~ slot.group_id if slot.group_id else "") ~ "_if" %}
{%- if node.kind == "clk" and node.disable %}
    {{ settings.class_prefix }}direct_check_inactive("{{ slot.access }}", tree_if.{{ vif_name }}, ok);
{%- elif node.kind == "clk" and node.freq is not none and node.freq > 0 %}
    {{ settings.class_prefix }}direct_check_freq("{{ slot.access }}", tree_if.{{ vif_name }}, {% if node.freq > 2147483647 %}64'd{{ node.freq }}{% else %}{{ node.freq }}{% endif %}, ok);
{%- elif node.kind == "source" and node.freq is not none and node.freq > 0 %}
    {{ settings.class_prefix }}direct_check_freq("{{ slot.access }}", tree_if.{{ vif_name }}, {% if node.freq > 2147483647 %}64'd{{ node.freq }}{% else %}{{ node.freq }}{% endif %}, ok);
{%- elif node.kind == "pll" and node.freq is mapping and node.freq[slot.group_id] > 0 %}
    {{ settings.class_prefix }}direct_check_freq("{{ slot.access }}", tree_if.{{ vif_name }}, {% if node.freq[slot.group_id] > 2147483647 %}64'd{{ node.freq[slot.group_id] }}{% else %}{{ node.freq[slot.group_id] }}{% endif %}, ok);
{%- elif node.kind == "pll" and node.freq is not mapping and node.freq > 0 %}
    {{ settings.class_prefix }}direct_check_freq("{{ slot.access }}", tree_if.{{ vif_name }}, {% if node.freq > 2147483647 %}64'd{{ node.freq }}{% else %}{{ node.freq }}{% endif %}, ok);
{%- endif %}
{%- endfor %}

    if (ok)
        $display("CLK_TREE: direct_check passed");
    else
        $error("CLK_TREE: direct_check failed");
endtask

task automatic {{ settings.class_prefix }}direct_check_freq(
    input string node_name,
    virtual {{ settings.class_prefix }}interface vif,
    input longint expected_hz,
    inout bit ok
);
    bit stable_ok;
    real measured_hz;
    real expected_real;
    real rel_diff;

    vif.start_measure();
    vif.wait_measure_stable(1'b1, 1'b0, stable_ok);

    if (vif.meas.inactive) begin
        $error("CLK_TREE: node %s expected %0d Hz no activity", node_name, expected_hz);
        ok = 1'b0;
        vif.stop_measure();
        return;
    end

    if (!vif.meas.activity_ok) begin
        $error("CLK_TREE: node %s activity not confirmed expected %0d Hz", node_name, expected_hz);
        ok = 1'b0;
        vif.stop_measure();
        return;
    end

    if (vif.meas.timed_out || !vif.meas.freq_stable) begin
        $error("CLK_TREE: node %s frequency did not stabilize expected %0d Hz", node_name, expected_hz);
        ok = 1'b0;
        vif.stop_measure();
        return;
    end

    measured_hz = vif.meas.freq_hz;
    expected_real = real'(expected_hz);
    rel_diff = (measured_hz > expected_real) ?
        (measured_hz - expected_real) / expected_real :
        (expected_real - measured_hz) / expected_real;

    if (rel_diff > {{ settings.period_tolerance }}) begin
        $error("CLK_TREE: node %s freq expected %0d Hz measured %0.2f Hz rel %0.4f",
            node_name, expected_hz, measured_hz, rel_diff);
        ok = 1'b0;
    end
    else begin
        $display("CLK_TREE: node %s freq passed", node_name);
    end

    vif.stop_measure();
endtask

task automatic {{ settings.class_prefix }}direct_check_inactive(
    input string node_name,
    virtual {{ settings.class_prefix }}interface vif,
    inout bit ok
);
    bit stable_ok;

    vif.start_measure();
    vif.wait_measure_stable(1'b0, 1'b0, stable_ok);

    if (!vif.meas.inactive) begin
        $error("CLK_TREE: node %s expected inactive, measured active", node_name);
        ok = 1'b0;
    end
    else begin
        $display("CLK_TREE: node %s inactive passed", node_name);
    end

    vif.stop_measure();
endtask

`endif
{% endif %}
