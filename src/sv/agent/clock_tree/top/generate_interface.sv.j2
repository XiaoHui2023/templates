{% if any_node_path %}
`ifndef {{ (settings.class_prefix ~ "generate_interface") | upper }}
`define {{ (settings.class_prefix ~ "generate_interface") | upper }}

interface {{ settings.class_prefix }}generate_interface (
    output wire out
);
    timeunit 1ns;
    timeprecision 1fs;

    bit gen_en;
    real gen_hz;
    reg gen_clk;

    assign out = gen_en ? gen_clk : 1'bz;

    function automatic void set_clock_gen(bit en, real hz);
        gen_en = en;
        gen_hz = hz;
    endfunction

    task automatic drive_gen_clock();
        realtime half_ns;

        gen_clk = 1'b0;
        forever begin
            @(gen_en or gen_hz);
            while (!gen_en)
                @(gen_en);

            forever begin
                if (gen_hz > 0.0)
                    half_ns = 0.5e9 / gen_hz;
                else
                    half_ns = 0.0;

                if (half_ns <= 0.0) begin
                    gen_clk = 1'b0;
                    @(gen_hz or gen_en);
                    if (!gen_en)
                        break;
                    continue;
                end

                gen_clk = ~gen_clk;
                #(half_ns * 1ns);

                if (!gen_en) begin
                    gen_clk = 1'b0;
                    break;
                end
            end
        end
    endtask

    initial begin
        gen_en = 1'b0;
        gen_hz = 0.0;
        gen_clk = 1'b0;
        fork
            drive_gen_clock();
        join_none
    end
endinterface

`endif
{% endif %}
