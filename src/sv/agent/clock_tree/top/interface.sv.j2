{% if any_node_path %}
`ifndef {{ (settings.class_prefix ~ "interface") | upper }}
`define {{ (settings.class_prefix ~ "interface") | upper }}

interface {{ settings.class_prefix }}interface #(
    parameter int MIN_FREQ_HZ = {{ settings.min_freq_hz }},
    parameter int STABLE_CYCLES = {{ settings.stable_cycles }},
    parameter real PERIOD_TOL = {{ settings.period_tolerance }},
    parameter real DUTY_MIN_PCT = {{ settings.duty_min }},
    parameter real DUTY_MAX_PCT = {{ settings.duty_max }}
) (
    input wire in
);
    timeunit 1ns;
    timeprecision 1fs;

    {{ settings.class_prefix }}measure_interface #(
        .MIN_FREQ_HZ(MIN_FREQ_HZ),
        .STABLE_CYCLES(STABLE_CYCLES),
        .PERIOD_TOL(PERIOD_TOL),
        .DUTY_MIN_PCT(DUTY_MIN_PCT),
        .DUTY_MAX_PCT(DUTY_MAX_PCT)
    ) meas(.in(in));

    // 写测量开关；关时清零测量结果
    // en — 测量开关
    function automatic void set_measure_en(bit en);
        meas.set_measure_en(en);
    endfunction

    // 清零测量结果后开启测量
    function automatic void start_measure();
        meas.start_measure();
    endfunction

    // 关闭测量并清零测量结果
    function automatic void stop_measure();
        meas.stop_measure();
    endfunction

    // 可测量的最低频率，单位 Hz
    // hz — 最低频率，Hz
    function automatic void set_min_freq_hz(int hz);
        meas.set_min_freq_hz(hz);
    endfunction

    // 轮询 stable，最长 meas_timeout_ns_rt
    // ok — 为真表示在时限内达到稳定
    task automatic wait_measure_stable(output bit ok);
        meas.wait_measure_stable(ok);
    endtask
endinterface

`endif
{% endif %}
