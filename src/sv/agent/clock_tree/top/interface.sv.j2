{% if any_node_path %}
`ifndef {{ (settings.class_prefix ~ "interface") | upper }}
`define {{ (settings.class_prefix ~ "interface") | upper }}

interface {{ settings.class_prefix }}interface #(
    parameter int MIN_FREQ_HZ = {{ settings.min_freq_hz }},
    parameter int ACTIVE_CYCLES = {{ settings.active_cycles }},
    parameter int STABLE_CYCLES = {{ settings.stable_cycles }},
    parameter real PERIOD_TOL = {{ settings.period_tolerance }},
    parameter real DUTY_MIN_PCT = {{ settings.duty_min }},
    parameter real DUTY_MAX_PCT = {{ settings.duty_max }},
    parameter real DUTY_TOL_PCT = {{ settings.duty_tolerance_pct }}
) (
    input wire in
);
    timeunit 1ns;
    timeprecision 1fs;

    {{ settings.class_prefix }}measure_interface #(
        .MIN_FREQ_HZ(MIN_FREQ_HZ),
        .ACTIVE_CYCLES(ACTIVE_CYCLES),
        .STABLE_CYCLES(STABLE_CYCLES),
        .PERIOD_TOL(PERIOD_TOL),
        .DUTY_MIN_PCT(DUTY_MIN_PCT),
        .DUTY_MAX_PCT(DUTY_MAX_PCT),
        .DUTY_TOL_PCT(DUTY_TOL_PCT)
    ) meas(.in(in));

    // 写测量开关；关时写入 last_* 并清零测量结果
    // en — 测量开关
    function automatic void set_measure_en(bit en);
        meas.set_measure_en(en);
    endfunction

    // 清零测量结果后开启测量
    function automatic void start_measure();
        meas.start_measure();
    endfunction

    // 关闭测量并写入 last_* 快照
    function automatic void stop_measure();
        meas.stop_measure();
    endfunction

    // 可测量的最低频率，单位 Hz
    // hz — 最低频率，Hz
    function automatic void set_min_freq_hz(int hz);
        meas.set_min_freq_hz(hz);
    endfunction

    // 一次完成频率测量：开启、等待频率稳定、关闭；结果读 meas.last_freq_hz 等
    task automatic measure_freq_hz();
        meas.measure_freq_hz();
    endtask

    // 轮询活动确认与频率、占空比稳定
    // need_freq — 为真时等待 freq_stable
    // need_duty — 为真时等待 duty_stable
    // ok — 为真表示活动已确认且在稳定时限内达到所需稳定
    task automatic wait_measure_stable(
            input bit need_freq,
            input bit need_duty,
            output bit ok);
        meas.wait_measure_stable(need_freq, need_duty, ok);
    endtask
endinterface

`endif
{% endif %}
