`ifndef {{ (class_prefix ~ "connection") | upper }}
`define {{ (class_prefix ~ "connection") | upper }}

{% set _mac_conn = "_" ~ (class_prefix ~ "conn_if") | replace("-", "_") | upper %}
`define {{ _mac_conn }}(id, p) \
    {{ class_prefix }}interface {{ class_prefix }}##id##_if ( .in(p) ); \
    initial begin \
        forever begin \
            @({{ class_prefix }}##id##_if.out); \
            if ($isunknown({{ class_prefix }}##id##_if.out)) \
                release p; \
            else \
                force p = {{ class_prefix }}##id##_if.out; \
        end \
    end

{%- for tree in trees %}
{%- for node in tree.nodes_ordered %}
{%- if node.path %}
`{{ _mac_conn }}({{ tree.name }}_{{ node.name }}, {{ node.path }})
{%- endif %}
{%- endfor %}
{%- endfor %}

{% for tree in trees %}
function automatic {{ class_prefix }}{{ tree.name }}_tree {{ class_prefix }}build_{{ tree.name }}_tree({% if class_regmodel %}{{ class_regmodel }} regmodel = null{% else %}uvm_reg_block regmodel = null{% endif %});
    {{ class_prefix }}{{ tree.name }}_tree t;

    t = {{ class_prefix }}{{ tree.name }}_tree::type_id::create("{{ tree.name }}");
{%- for node in tree.nodes_ordered %}
{%- if node.path %}
    t.{{ node.name }}.vif = {{ class_prefix }}{{ tree.name }}_{{ node.name }}_if;
{%- endif %}
{%- endfor %}
{% for tree_name, node_name, member, path, offset, width in reg_bindings if tree_name == tree.name %}
    if (regmodel != null) begin
        t.{{ node_name }}.{{ member }}.field = regmodel.{{ path }};
        t.{{ node_name }}.{{ member }}.offset = {{ offset if offset is not none else 0 }};
{%- if width is none %}
        t.{{ node_name }}.{{ member }}.width = t.{{ node_name }}.{{ member }}.field.get_n_bits();
{%- else %}
        t.{{ node_name }}.{{ member }}.width = {{ width }};
{%- endif %}
    end
{% endfor %}
    if (!t.randomize())
        uvm_report_fatal("CLK_TREE", "{{ class_prefix }}build_{{ tree.name }}_tree randomize failed");
    return t;
endfunction

{% endfor %}
function automatic void {{ class_prefix }}build_all_trees(
        ref {{ class_prefix }}base_tree trees[$],
{% if class_regmodel %}
        input {{ class_regmodel }} regmodel = null
{% else %}
        input uvm_reg_block regmodel = null
{% endif %}
    );
    trees.delete();
{% for tree in trees %}
    trees.push_back({{ class_prefix }}build_{{ tree.name }}_tree(regmodel));
{% endfor %}
endfunction

`undef {{ _mac_conn }}

`endif
