{% if any_node_path and regs_enabled %}
`ifndef {{ (settings.class_prefix ~ "test_duty_seq") | upper }}
`define {{ (settings.class_prefix ~ "test_duty_seq") | upper }}

class {{ settings.class_prefix }}test_duty_seq extends uvm_sequence #(
    {{ settings.class_prefix }}test_duty_req,
    {{ settings.class_prefix }}test_duty_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}test_duty_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    function new(string name = "{{ settings.class_prefix }}test_duty_seq");
        super.new(name);
    endfunction

    extern virtual task body();
    extern task run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    extern task run_check_duty(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
endclass

task {{ settings.class_prefix }}test_duty_seq::run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    {{ settings.class_prefix }}config_reg_req cfg_req;
    {{ settings.class_prefix }}config_reg_seq cfg_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_duty: tree is null for config_reg")
    cfg_req = {{ settings.class_prefix }}config_reg_req::type_id::create("cfg_req");
    cfg_req.tree = tree;
    cfg_req.quiet = quiet;
    cfg_seq = {{ settings.class_prefix }}config_reg_seq::type_id::create("config_reg");
    cfg_seq.req = cfg_req;
    cfg_seq.start(p_sequencer);
    if (cfg_seq.rsp == null || !cfg_seq.rsp.ok)
        `uvm_fatal("CLK_TREE", "test_duty: config_reg failed")
endtask

task {{ settings.class_prefix }}test_duty_seq::run_check_duty(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    {{ settings.class_prefix }}check_duty_req duty_req;
    {{ settings.class_prefix }}check_duty_rsp duty_rsp;
    {{ settings.class_prefix }}check_duty_seq duty_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_duty: tree is null for check_duty")
    duty_req = {{ settings.class_prefix }}check_duty_req::type_id::create("duty_req");
    duty_req.tree = tree;
    duty_req.quiet = quiet;
    duty_seq = {{ settings.class_prefix }}check_duty_seq::type_id::create("check_duty");
    duty_seq.req = duty_req;
    duty_seq.start(p_sequencer);
    duty_rsp = duty_seq.rsp;
    if (duty_rsp == null || !duty_rsp.ok)
        `uvm_fatal("CLK_TREE", "test_duty: check_duty failed")
endtask

task {{ settings.class_prefix }}test_duty_seq::body();
    {{ settings.class_prefix }}test_duty_req rq;
    {{ settings.class_prefix }}test_duty_rsp rs;
    {{ settings.class_prefix }}tree_base tree;

    if (req == null)
        `uvm_fatal("CLK_TREE", "test_duty: req is null")

    rq = req;
    tree = rq.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_duty: tree is null")

    if (!rq.quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_duty: begin tree %s", tree.get_name()), UVM_LOW)

    run_config_reg(tree, rq.quiet);
    run_check_duty(tree, rq.quiet);

    rs = {{ settings.class_prefix }}test_duty_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    if (!rq.quiet)
        `uvm_info("CLK_TREE", "test_duty: passed", UVM_LOW)

    rsp = rs;
endtask

`endif
{% endif %}
