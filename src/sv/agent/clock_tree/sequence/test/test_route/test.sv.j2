{% if route_test_enabled %}
`ifndef {{ (settings.class_prefix ~ "test_route_seq") | upper }}
`define {{ (settings.class_prefix ~ "test_route_seq") | upper }}

class {{ settings.class_prefix }}test_route_seq extends uvm_sequence #(
    {{ settings.class_prefix }}test_route_req,
    {{ settings.class_prefix }}test_route_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}test_route_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    function new(string name = "{{ settings.class_prefix }}test_route_seq");
        super.new(name);
    endfunction

    extern virtual task body();
    extern task run_check_freq_quiet({{ settings.class_prefix }}tree_base tree);
    extern task run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    extern task save_ctrl_snap(
        {{ settings.class_prefix }}node_base nodes[$],
        output {{ settings.class_prefix }}route_ctrl_snap_t snaps[$]);
    extern task restore_ctrl_snap(
        {{ settings.class_prefix }}node_base nodes[$],
        {{ settings.class_prefix }}route_ctrl_snap_t stored_snaps[$]);
    extern task verify_one_direction(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base subject,
        bit upstream,
        {{ settings.class_prefix }}node_base stored_nodes[$],
        {{ settings.class_prefix }}route_ctrl_snap_t stored_snaps[$],
        {{ settings.class_prefix }}node_base always_active_clk_nodes[$],
        bit quiet,
        int subject_idx,
        int subject_total);
endclass

task {{ settings.class_prefix }}test_route_seq::run_check_freq_quiet(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}check_freq_req freq_req;
    {{ settings.class_prefix }}check_freq_rsp freq_rsp;
    {{ settings.class_prefix }}check_freq_seq freq_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null for check_freq")
    freq_req = {{ settings.class_prefix }}check_freq_req::type_id::create("freq_req");
    freq_req.tree = tree;
    freq_req.quiet = 1'b1;
    freq_req.skip_config_reg = 1'b1;
    freq_seq = {{ settings.class_prefix }}check_freq_seq::type_id::create("check_freq");
    freq_seq.req = freq_req;
    freq_seq.start(p_sequencer);
    freq_rsp = freq_seq.rsp;
    if (freq_rsp == null || !freq_rsp.ok)
        `uvm_fatal("CLK_TREE", "test_route: check_freq failed")
endtask

task {{ settings.class_prefix }}test_route_seq::run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    {{ settings.class_prefix }}config_reg_req cfg_req;
    {{ settings.class_prefix }}config_reg_seq cfg_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null for config_reg")
    cfg_req = {{ settings.class_prefix }}config_reg_req::type_id::create("cfg_req");
    cfg_req.tree = tree;
    cfg_req.quiet = quiet;
    cfg_seq = {{ settings.class_prefix }}config_reg_seq::type_id::create("config_reg");
    cfg_seq.req = cfg_req;
    cfg_seq.start(p_sequencer);
    if (cfg_seq.rsp == null || !cfg_seq.rsp.ok)
        `uvm_fatal("CLK_TREE", "test_route: config_reg failed")
endtask

task {{ settings.class_prefix }}test_route_seq::save_ctrl_snap(
        {{ settings.class_prefix }}node_base nodes[$],
        output {{ settings.class_prefix }}route_ctrl_snap_t snaps[$]);
    {{ settings.class_prefix }}route_ctrl_snap_t one_snap;
    snaps.delete();
    foreach (nodes[i]) begin
        {{ settings.class_prefix }}route_structure_save_ctrl(nodes[i], one_snap);
        snaps.push_back(one_snap);
    end
endtask

task {{ settings.class_prefix }}test_route_seq::restore_ctrl_snap(
        {{ settings.class_prefix }}node_base nodes[$],
        {{ settings.class_prefix }}route_ctrl_snap_t stored_snaps[$]);
    foreach (nodes[i])
        {{ settings.class_prefix }}route_structure_apply_ctrl(nodes[i], stored_snaps[i], 1'b0);
    endtask

task {{ settings.class_prefix }}test_route_seq::verify_one_direction(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base subject,
        bit upstream,
        {{ settings.class_prefix }}node_base stored_nodes[$],
        {{ settings.class_prefix }}route_ctrl_snap_t stored_snaps[$],
        {{ settings.class_prefix }}node_base always_active_clk_nodes[$],
        bit quiet,
        int subject_idx,
        int subject_total);
    {{ settings.class_prefix }}node_base line[$];
    {{ settings.class_prefix }}node_base line_snaps_nodes[$];
    {{ settings.class_prefix }}route_ctrl_snap_t line_snaps[$];
    int n_sub;
    int n_combo;
    int sv;
    int c;
    int n_run;
    int n_skip_sub;
    int n_skip_combo;
    string dir_label;
    string line_names;
    string combo_summary;

    n_run = 0;
    n_skip_sub = 0;
    n_skip_combo = 0;

    if (upstream) begin
        {{ settings.class_prefix }}route_structure_collect_upstream_line(tree, subject, line);
        dir_label = "upstream";
    end else begin
        {{ settings.class_prefix }}route_structure_collect_downstream_line(tree, subject, line);
        dir_label = "downstream";
    end

    line_snaps_nodes = line;
    save_ctrl_snap(line_snaps_nodes, line_snaps);

    n_sub = {{ settings.class_prefix }}route_structure_variant_count(subject);
    if (n_sub <= 0)
        return;

    n_combo = {{ settings.class_prefix }}route_structure_line_combo_count(line);
    if (n_combo <= 0)
        n_combo = 1;

    if (!quiet) begin
        line_names = {{ settings.class_prefix }}route_structure_format_node_names(line);
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: subject [%0d/%0d] %s %s — line %s, %0d self x %0d combo(s)",
            subject_idx + 1, subject_total, subject.get_name(), dir_label,
            line_names, n_sub, n_combo), UVM_LOW)
    end

    for (sv = 0; sv < n_sub; sv++) begin
        restore_ctrl_snap(stored_nodes, stored_snaps);
        {{ settings.class_prefix }}route_structure_apply_variant_index(subject, sv, 1'b1);
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "test_route:   %s self [%0d/%0d] %s %s — config_reg",
                dir_label, sv + 1, n_sub, subject.get_name(),
                {{ settings.class_prefix }}route_structure_variant_label(subject, sv)),
                UVM_MEDIUM)
        run_config_reg(tree, 1'b1);
        if (always_active_clk_nodes.size() > 0
                && !{{ settings.class_prefix }}route_structure_always_active_clocks_valid(
                    always_active_clk_nodes)) begin
            n_skip_sub++;
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route:     skip self variant — always_active clk inactive"),
                    UVM_MEDIUM)
            continue;
        end

        for (c = 0; c < n_combo; c++) begin
            restore_ctrl_snap(line_snaps_nodes, line_snaps);
            if (line.size() > 0)
                {{ settings.class_prefix }}route_structure_apply_line_combo_index(
                    line, c, 1'b1);
            combo_summary = {{ settings.class_prefix }}route_structure_line_combo_summary(
                line, c);
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route:     %s line [%0d/%0d] %s — config_reg",
                    dir_label, c + 1, n_combo, combo_summary), UVM_MEDIUM)
            run_config_reg(tree, 1'b1);
            if (always_active_clk_nodes.size() > 0
                    && !{{ settings.class_prefix }}route_structure_always_active_clocks_valid(
                        always_active_clk_nodes)) begin
                n_skip_combo++;
                if (!quiet)
                    `uvm_info("CLK_TREE", $sformatf(
                        "test_route:       skip line combo — always_active clk inactive"),
                        UVM_MEDIUM)
                continue;
            end
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route:       check_freq"), UVM_MEDIUM)
            run_check_freq_quiet(tree);
            n_run++;
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route:       check_freq OK"), UVM_MEDIUM)
        end
    end

    restore_ctrl_snap(stored_nodes, stored_snaps);
    run_config_reg(tree, 1'b1);

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: subject %s %s done — %0d check_freq run(s), "
            + "%0d self variant skip(s), %0d line combo skip(s)",
            subject.get_name(), dir_label, n_run, n_skip_sub, n_skip_combo),
            UVM_LOW)
endtask

task {{ settings.class_prefix }}test_route_seq::body();
    {{ settings.class_prefix }}test_route_req rq;
    {{ settings.class_prefix }}test_route_rsp rs;
    {{ settings.class_prefix }}tree_base tree;
    {{ settings.class_prefix }}node_base subjects[$];
    {{ settings.class_prefix }}node_base probe_subjects[$];
    {{ settings.class_prefix }}node_base stored_nodes[$];
    {{ settings.class_prefix }}route_ctrl_snap_t stored_snaps[$];
    string req_clk_names;
    string subject_names;
    int i;

    if (req == null)
        `uvm_fatal("CLK_TREE", "test_route: req is null")

    rq = req;
    tree = rq.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null")

    rs = {{ settings.class_prefix }}test_route_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    if (!rq.quiet) begin
        req_clk_names = {{ settings.class_prefix }}route_structure_format_node_names(
            rq.always_active_clk_nodes);
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: begin tree %s", tree.get_name()), UVM_LOW)
        if (rq.always_active_clk_nodes.size() > 0)
            `uvm_info("CLK_TREE", $sformatf(
                "test_route: always_active clk (%0d): %s",
                rq.always_active_clk_nodes.size(), req_clk_names), UVM_LOW)
        else
            `uvm_info("CLK_TREE",
                "test_route: always_active clk unset — all clk nodes must stay active",
                UVM_LOW)
    end

    if (!rq.quiet)
        `uvm_info("CLK_TREE",
            "test_route: [1/4] initial fixes — gates open, div/dto ratio 1, mux toward clk",
            UVM_LOW)
    {{ settings.class_prefix }}route_structure_apply_initial_fixes(tree);

    if (!rq.quiet)
        `uvm_info("CLK_TREE",
            "test_route: [2/4] baseline config_reg + check_freq", UVM_LOW)
    run_config_reg(tree, rq.quiet);
    run_check_freq_quiet(tree);

    if (rq.always_active_clk_nodes.size() > 0) begin
        if (!{{ settings.class_prefix }}route_structure_always_active_clocks_valid(
                rq.always_active_clk_nodes))
            `uvm_fatal("CLK_TREE",
                "test_route: always_active clk nodes not active after initial config_reg")
        if (!rq.quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "test_route: [3/4] always_active clk active — %s", req_clk_names), UVM_LOW)
    end else begin
        if (!{{ settings.class_prefix }}route_structure_all_clocks_valid(tree))
            `uvm_fatal("CLK_TREE",
                "test_route: not all clk nodes are active after initial config_reg")
        if (!rq.quiet)
            `uvm_info("CLK_TREE",
                "test_route: [3/4] all clk nodes active", UVM_LOW)
    end

    {{ settings.class_prefix }}route_structure_collect_probe_subjects(tree, subjects);
    if (subjects.size() == 0)
        `uvm_fatal("CLK_TREE",
            "test_route: no gate/mux/div/dto nodes with bound regs")

    probe_subjects.delete();
    foreach (subjects[i]) begin
        if ({{ settings.class_prefix }}route_structure_probe_subject_skipped_for_always_active(
                subjects[i], rq.always_active_clk_nodes)) begin
            if (!rq.quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route: skip subject %s (%s) — on path to always_active clk",
                    subjects[i].get_name(), subjects[i].kind), UVM_LOW)
            continue;
        end
        probe_subjects.push_back(subjects[i]);
    end
    if (probe_subjects.size() == 0)
        `uvm_fatal("CLK_TREE",
            "test_route: no probe subjects after always_active gate/mux filter")

    if (!rq.quiet) begin
        subject_names = {{ settings.class_prefix }}route_structure_format_node_names(
            probe_subjects);
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: [4/4] structure probe — %0d subject(s): %s",
            probe_subjects.size(), subject_names), UVM_LOW)
    end

    stored_nodes = tree.nodes;
    save_ctrl_snap(stored_nodes, stored_snaps);

    {{ settings.class_prefix }}route_structure_apply_clk_unfix_policy(
        tree, rq.always_active_clk_nodes);

    for (i = 0; i < probe_subjects.size(); i++) begin
        verify_one_direction(tree, probe_subjects[i], 1'b1, stored_nodes, stored_snaps,
            rq.always_active_clk_nodes, rq.quiet, i, probe_subjects.size());
        verify_one_direction(tree, probe_subjects[i], 1'b0, stored_nodes, stored_snaps,
            rq.always_active_clk_nodes, rq.quiet, i, probe_subjects.size());
    end

    if (!rq.quiet)
        `uvm_info("CLK_TREE",
            "test_route: restore tree control + config_reg", UVM_LOW)
    {{ settings.class_prefix }}route_structure_clear_clk_unfix(tree);
    restore_ctrl_snap(stored_nodes, stored_snaps);
    run_config_reg(tree, rq.quiet);

    if (!rq.quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: passed — %0d subject(s), upstream + downstream each",
            probe_subjects.size()), UVM_LOW)

    rsp = rs;
endtask

`endif
{% endif %}
