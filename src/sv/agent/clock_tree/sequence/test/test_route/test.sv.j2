{% if route_test_enabled %}
`ifndef {{ (settings.class_prefix ~ "test_route_seq") | upper }}
`define {{ (settings.class_prefix ~ "test_route_seq") | upper }}

class {{ settings.class_prefix }}test_route_seq extends uvm_sequence #(
    {{ settings.class_prefix }}test_route_req,
    {{ settings.class_prefix }}test_route_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}test_route_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    // 构造 route 结构遍历测试序列
    function new(string name = "{{ settings.class_prefix }}test_route_seq");
        super.new(name);
    endfunction

    // 执行路由结构遍历并写回结果
    extern virtual task body();
    // 静默校验当前树 clk 频率
    extern task run_check_measure_quiet(
        {{ settings.class_prefix }}tree_base tree,
        bit debug = 1'b0,
        {{ settings.class_prefix }}node_base skip_nodes[$] = {});
    // 按当前树状态写寄存器
    extern task run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    // 保存节点控制字段快照
    extern task save_ctrl_snap(
        {{ settings.class_prefix }}node_base nodes[$],
        output {{ settings.class_prefix }}route_ctrl_snap snaps[$]);
    // 按快照恢复节点控制字段
    extern task restore_ctrl_snap(
        {{ settings.class_prefix }}node_base nodes[$],
        {{ settings.class_prefix }}route_ctrl_snap stored_snaps[$]);
    // 遍历 subject 单侧连线的控制组合
    extern task verify_one_direction(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base subject,
        bit upstream,
        {{ settings.class_prefix }}node_base stored_nodes[$],
        {{ settings.class_prefix }}route_ctrl_snap stored_snaps[$],
        {{ settings.class_prefix }}node_base pinned_path[$],
        bit quiet,
        bit debug,
        int subject_idx,
        int subject_total);
endclass

task {{ settings.class_prefix }}test_route_seq::run_check_measure_quiet(
        {{ settings.class_prefix }}tree_base tree,
        bit debug = 1'b0,
        {{ settings.class_prefix }}node_base skip_nodes[$] = {});
    {{ settings.class_prefix }}check_measure_req meas_req;
    {{ settings.class_prefix }}check_measure_rsp meas_rsp;
    {{ settings.class_prefix }}check_measure_seq meas_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null for check_measure")
    meas_req = {{ settings.class_prefix }}check_measure_req::type_id::create("meas_req");
    meas_req.tree = tree;
    meas_req.quiet = 1'b1;
    meas_req.debug = debug;
    meas_req.check_freq = 1'b1;
    meas_req.check_duty = 1'b0;
    meas_req.include_volatile = 1'b0;
    meas_req.skip_nodes = skip_nodes;
    meas_req.min_freq_hz = {{ settings.class_prefix }}route_structure_theoretical_min_freq_hz(
        tree, {{ settings.min_freq_hz }});
    meas_seq = {{ settings.class_prefix }}check_measure_seq::type_id::create("check_measure");
    meas_seq.req = meas_req;
    meas_seq.start(p_sequencer);
    meas_rsp = meas_seq.rsp;
    if (meas_rsp == null || !meas_rsp.ok)
        `uvm_fatal("CLK_TREE", "test_route: check_measure failed")
endtask

task {{ settings.class_prefix }}test_route_seq::run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    {{ settings.class_prefix }}config_reg_req cfg_req;
    {{ settings.class_prefix }}config_reg_seq cfg_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null for config_reg")
    cfg_req = {{ settings.class_prefix }}config_reg_req::type_id::create("cfg_req");
    cfg_req.tree = tree;
    cfg_req.quiet = quiet;
    cfg_seq = {{ settings.class_prefix }}config_reg_seq::type_id::create("config_reg");
    cfg_seq.req = cfg_req;
    cfg_seq.start(p_sequencer);
    if (cfg_seq.rsp == null || !cfg_seq.rsp.ok)
        `uvm_fatal("CLK_TREE", "test_route: config_reg failed")
endtask

task {{ settings.class_prefix }}test_route_seq::save_ctrl_snap(
        {{ settings.class_prefix }}node_base nodes[$],
        output {{ settings.class_prefix }}route_ctrl_snap snaps[$]);
    {{ settings.class_prefix }}route_ctrl_snap one_snap;
    snaps.delete();
    foreach (nodes[i]) begin
        {{ settings.class_prefix }}route_structure_save_ctrl(nodes[i], one_snap);
        snaps.push_back(one_snap);
    end
endtask

task {{ settings.class_prefix }}test_route_seq::restore_ctrl_snap(
        {{ settings.class_prefix }}node_base nodes[$],
        {{ settings.class_prefix }}route_ctrl_snap stored_snaps[$]);
    foreach (nodes[i])
        {{ settings.class_prefix }}route_structure_apply_ctrl(nodes[i], stored_snaps[i], 1'b0);
    endtask

task {{ settings.class_prefix }}test_route_seq::verify_one_direction(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base subject,
        bit upstream,
        {{ settings.class_prefix }}node_base stored_nodes[$],
        {{ settings.class_prefix }}route_ctrl_snap stored_snaps[$],
        {{ settings.class_prefix }}node_base pinned_path[$],
        bit quiet,
        bit debug,
        int subject_idx,
        int subject_total);
    {{ settings.class_prefix }}node_base line[$];
    {{ settings.class_prefix }}node_base line_snaps_nodes[$];
    {{ settings.class_prefix }}route_ctrl_snap line_snaps[$];
    int n_sub;
    int n_combo;
    int sv;
    int c;
    int n_run;
    int n_skip_sub;
    int n_skip_combo;
    string dir_label;
    string line_names;
    string combo_summary;
    {{ settings.class_prefix }}node_base connected[$];
    {{ settings.class_prefix }}node_base disconnected[$];

    n_run = 0;
    n_skip_sub = 0;
    n_skip_combo = 0;

    if (upstream) begin
        {{ settings.class_prefix }}route_structure_collect_upstream_line(tree, subject, line);
        dir_label = "upstream";
    end else begin
        {{ settings.class_prefix }}route_structure_collect_downstream_line(tree, subject, line);
        dir_label = "downstream";
    end
    {{ settings.class_prefix }}route_structure_filter_pinned_gate_mux_from_line(
        line, pinned_path);

    line_snaps_nodes = line;
    save_ctrl_snap(line_snaps_nodes, line_snaps);

    n_sub = {{ settings.class_prefix }}route_structure_variant_count(subject);
    if (n_sub <= 0)
        return;

    n_combo = {{ settings.class_prefix }}route_structure_line_combo_count(line);
    if (n_combo <= 0)
        n_combo = 1;

    if (!quiet) begin
        line_names = {{ settings.class_prefix }}route_structure_format_node_names(line);
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: subject [%0d/%0d] %s %s, line %s, %0d self x %0d combo(s)",
            subject_idx + 1, subject_total, subject.get_name(), dir_label,
            line_names, n_sub, n_combo), UVM_LOW)
    end

    for (sv = 0; sv < n_sub; sv++) begin
        restore_ctrl_snap(stored_nodes, stored_snaps);
        {{ settings.class_prefix }}route_structure_apply_variant_index(subject, sv, 1'b1);
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "test_route:   %s self [%0d/%0d] %s %s, config_reg",
                dir_label, sv + 1, n_sub, subject.get_name(),
                {{ settings.class_prefix }}route_structure_variant_label(subject, sv)),
                UVM_MEDIUM)
        run_config_reg(tree, 1'b1);
        if (tree.has_stable_clk()
                && !{{ settings.class_prefix }}route_structure_stable_clocks_valid(
                    tree)) begin
            n_skip_sub++;
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route:     skip self variant, stable clk invalid"),
                    UVM_MEDIUM)
            continue;
        end

        for (c = 0; c < n_combo; c++) begin
            restore_ctrl_snap(stored_nodes, stored_snaps);
            {{ settings.class_prefix }}route_structure_apply_variant_index(subject, sv, 1'b1);
            restore_ctrl_snap(line_snaps_nodes, line_snaps);
            if (line.size() > 0)
                {{ settings.class_prefix }}route_structure_apply_line_combo_index(
                    line, c, 1'b1);
            combo_summary = {{ settings.class_prefix }}route_structure_line_combo_summary(
                line, c);
            {{ settings.class_prefix }}optimized_config_scope_for_subject(
                tree, subject, pinned_path, connected, disconnected);
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route:     %s line [%0d/%0d] %s, check %s, skip %s, config_reg",
                    dir_label, c + 1, n_combo, combo_summary,
                    {{ settings.class_prefix }}route_structure_format_node_names(connected),
                    {{ settings.class_prefix }}route_structure_format_node_names(disconnected)),
                    UVM_MEDIUM)
            run_config_reg(tree, 1'b1);
            if (tree.has_stable_clk()
                    && !{{ settings.class_prefix }}route_structure_stable_clocks_valid(
                        tree)) begin
                n_skip_combo++;
                if (!quiet)
                    `uvm_info("CLK_TREE", $sformatf(
                        "test_route:       skip line combo, stable clk invalid"),
                        UVM_MEDIUM)
                continue;
            end
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route:       check_measure"), UVM_MEDIUM)
            run_check_measure_quiet(tree, debug, disconnected);
            n_run++;
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route:       check_measure OK"), UVM_MEDIUM)
        end
    end

    restore_ctrl_snap(stored_nodes, stored_snaps);
    run_config_reg(tree, 1'b1);

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: subject %s %s done, %0d check_measure run(s), %0d self variant skip(s), %0d line combo skip(s)",
            subject.get_name(), dir_label, n_run, n_skip_sub, n_skip_combo),
            UVM_LOW)
endtask

task {{ settings.class_prefix }}test_route_seq::body();
    {{ settings.class_prefix }}test_route_req rq;
    {{ settings.class_prefix }}test_route_rsp rs;
    {{ settings.class_prefix }}tree_base tree;
    {{ settings.class_prefix }}node_base subjects[$];
    {{ settings.class_prefix }}node_base probe_subjects[$];
    {{ settings.class_prefix }}node_base stored_nodes[$];
    {{ settings.class_prefix }}node_base pinned_path[$];
    {{ settings.class_prefix }}node_base stable_clk_nodes[$];
    {{ settings.class_prefix }}route_ctrl_snap stored_snaps[$];
    string req_clk_names;
    string pinned_names;
    string subject_names;
    int i;

    if (req == null)
        `uvm_fatal("CLK_TREE", "test_route: req is null")

    rq = req;
    tree = rq.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null")

    rs = {{ settings.class_prefix }}test_route_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    if (!rq.quiet || rq.debug) begin
        tree.collect_stable_clk_nodes(stable_clk_nodes);
        req_clk_names = {{ settings.class_prefix }}route_structure_format_node_names(
            stable_clk_nodes);
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: begin tree %s debug %0b", tree.get_name(), rq.debug), UVM_LOW)
        if (stable_clk_nodes.size() > 0)
            `uvm_info("CLK_TREE", $sformatf(
                "test_route: stable clk (%0d): %s",
                stable_clk_nodes.size(), req_clk_names), UVM_LOW)
        else
            `uvm_info("CLK_TREE",
                "test_route: no stable clk, all clk nodes may vary enabled",
                UVM_LOW)
    end

    {{ settings.class_prefix }}route_structure_collect_probe_subjects(tree, subjects);
    if (subjects.size() == 0)
        `uvm_fatal("CLK_TREE",
            "test_route: no gate/mux/div/dto nodes with bound regs")

    if (!rq.quiet)
        `uvm_info("CLK_TREE",
            "test_route: init, plain config_reg", UVM_LOW)
    run_config_reg(tree, rq.quiet);

    {{ settings.class_prefix }}route_structure_collect_stable_upstream_gate_mux(
        tree, pinned_path);

    probe_subjects.delete();
    foreach (subjects[i]) begin
        if ({{ settings.class_prefix }}node_in_queue(subjects[i], pinned_path)) begin
            if (!rq.quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route: skip subject %s (%s), on selected path to stable clk",
                    subjects[i].get_name(), subjects[i].kind), UVM_LOW)
            continue;
        end
        probe_subjects.push_back(subjects[i]);
    end
    if (probe_subjects.size() == 0)
        `uvm_fatal("CLK_TREE",
            "test_route: no probe subjects after stable path filter")

    if (!rq.quiet) begin
        if (pinned_path.size() > 0) begin
            pinned_names = {{ settings.class_prefix }}route_structure_format_node_names(
                pinned_path);
            `uvm_info("CLK_TREE", $sformatf(
                "test_route: init, pin path gate/mux/div/pll (%0d): %s",
                pinned_path.size(), pinned_names), UVM_LOW)
        end
    end

    {{ settings.class_prefix }}optimized_config_apply_pll_freq(tree, pinned_path);
    {{ settings.class_prefix }}optimized_config_pin_div_dto_ratio_one(tree, pinned_path);
    {{ settings.class_prefix }}route_structure_pin_gate_mux_fix(tree, pinned_path);
    {{ settings.class_prefix }}optimized_config_apply_clk_unfix(tree);

    stored_nodes = tree.nodes;
    save_ctrl_snap(stored_nodes, stored_snaps);

    if (!rq.quiet)
        `uvm_info("CLK_TREE",
            "test_route: init, pll/div/path fix + non-stable clk unfix, confirm config_reg",
            UVM_LOW)
    run_config_reg(tree, rq.quiet);

    if (!rq.quiet) begin
        subject_names = {{ settings.class_prefix }}route_structure_format_node_names(
            probe_subjects);
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: probe, %0d subject(s): %s",
            probe_subjects.size(), subject_names), UVM_LOW)
    end

    for (i = 0; i < probe_subjects.size(); i++) begin
        verify_one_direction(tree, probe_subjects[i], 1'b1, stored_nodes, stored_snaps,
            pinned_path, rq.quiet, rq.debug, i,
            probe_subjects.size());
        verify_one_direction(tree, probe_subjects[i], 1'b0, stored_nodes, stored_snaps,
            pinned_path, rq.quiet, rq.debug, i,
            probe_subjects.size());
    end

    if (!rq.quiet)
        `uvm_info("CLK_TREE",
            "test_route: clear fix/unfix + config_reg", UVM_LOW)
    {{ settings.class_prefix }}route_structure_clear_all_fix(tree);
    run_config_reg(tree, rq.quiet);

    if (!rq.quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: passed, %0d subject(s), upstream + downstream each",
            probe_subjects.size()), UVM_LOW)

    rsp = rs;
endtask

`endif
{% endif %}
