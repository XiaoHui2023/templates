{% if route_test_enabled %}
`ifndef {{ (settings.class_prefix ~ "test_flip_seq") | upper }}
`define {{ (settings.class_prefix ~ "test_flip_seq") | upper }}

class {{ settings.class_prefix }}test_flip_seq extends uvm_sequence #(
    {{ settings.class_prefix }}test_flip_req,
    {{ settings.class_prefix }}test_flip_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}test_flip_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    // 构造 div/dto 翻转测试序列
    function new(string name = "{{ settings.class_prefix }}test_flip_seq");
        super.new(name);
    endfunction

    // 验证 div/dto 控制位翻转后 clk 仍可测
    extern virtual task body();
    // 校验当前树频率，默认静默打印
    extern task run_check_measure_quiet(
        {{ settings.class_prefix }}tree_base tree,
        bit debug = 1'b0,
        {{ settings.class_prefix }}node_base skip_nodes[$] = {});
    // 按当前树状态写寄存器
    extern task run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    // 等待频率稳定并读出 last_phase_frac
    extern task measure_node_phase(
        {{ settings.class_prefix }}node_base nd,
        output real phase_frac,
        output bit ok);
    // 按 MSB 或 LSB 单比特 pattern 写 div 分频比后校验
    extern task verify_div_flip_pattern(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}div_div div_nd,
        {{ settings.class_prefix }}node_base keep_nodes[$],
        bit msb_one_lsb_zero,
        bit quiet,
        bit debug);
    // div 两种 field 单比特 pattern 各测一轮
    extern task verify_div_flip(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}div_div div_nd,
        {{ settings.class_prefix }}node_base keep_nodes[$],
        bit quiet,
        bit debug);
    // 按 MSB 或 LSB 单比特 pattern 写 dto 分频比后校验
    extern task verify_dto_flip_pattern(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}div_dto dto_nd,
        {{ settings.class_prefix }}node_base keep_nodes[$],
        bit msb_one_lsb_zero,
        bit quiet,
        bit debug);
    // dto 两种 field 单比特 pattern 各测一轮
    extern task verify_dto_flip(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}div_dto dto_nd,
        {{ settings.class_prefix }}node_base keep_nodes[$],
        bit quiet,
        bit debug);
    // 翻转 inv 控制并检查相位差约半周期
    extern task verify_inv_flip(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}inv inv_nd,
        {{ settings.class_prefix }}node_base keep_nodes[$],
        bit quiet);
endclass

task {{ settings.class_prefix }}test_flip_seq::run_check_measure_quiet(
        {{ settings.class_prefix }}tree_base tree,
        bit debug = 1'b0,
        {{ settings.class_prefix }}node_base skip_nodes[$] = {});
    {{ settings.class_prefix }}check_measure_req meas_req;
    {{ settings.class_prefix }}check_measure_rsp meas_rsp;
    {{ settings.class_prefix }}check_measure_seq meas_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_flip: tree is null for check_measure")
    meas_req = {{ settings.class_prefix }}check_measure_req::type_id::create("meas_req");
    meas_req.tree = tree;
    meas_req.quiet = 1'b1;
    meas_req.debug = debug;
    meas_req.check_freq = 1'b1;
    meas_req.check_duty = 1'b0;
    meas_req.include_volatile = 1'b0;
    meas_req.skip_nodes = skip_nodes;
    meas_seq = {{ settings.class_prefix }}check_measure_seq::type_id::create("check_measure");
    meas_seq.req = meas_req;
    meas_seq.start(p_sequencer);
    meas_rsp = meas_seq.rsp;
    if (meas_rsp == null || !meas_rsp.ok)
        `uvm_fatal("CLK_TREE", "test_flip: check_measure failed")
endtask

task {{ settings.class_prefix }}test_flip_seq::run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    {{ settings.class_prefix }}config_reg_req cfg_req;
    {{ settings.class_prefix }}config_reg_seq cfg_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_flip: tree is null for config_reg")
    cfg_req = {{ settings.class_prefix }}config_reg_req::type_id::create("cfg_req");
    cfg_req.tree = tree;
    cfg_req.quiet = quiet;
    cfg_seq = {{ settings.class_prefix }}config_reg_seq::type_id::create("config_reg");
    cfg_seq.req = cfg_req;
    cfg_seq.start(p_sequencer);
    if (cfg_seq.rsp == null || !cfg_seq.rsp.ok)
        `uvm_fatal("CLK_TREE", "test_flip: config_reg failed")
endtask

task {{ settings.class_prefix }}test_flip_seq::measure_node_phase(
        {{ settings.class_prefix }}node_base nd,
        output real phase_frac,
        output bit ok);
    int meas_period_ns;
    int meas_active_timeout_ns;
    int meas_stable_timeout_ns;
    int meas_timeout_ns;
    int elapsed_ns;

    phase_frac = 0.0;
    ok = 1'b0;
    if (nd == null || nd.vif == null)
        return;

    meas_period_ns = (1_000_000_000 + {{ settings.min_freq_hz }} - 1)
        / {{ settings.min_freq_hz }};
    meas_active_timeout_ns = meas_period_ns * {{ settings.active_cycles }};
    meas_stable_timeout_ns = meas_period_ns * {{ settings.stable_cycles }};
    meas_timeout_ns = meas_active_timeout_ns + meas_stable_timeout_ns;
    nd.vif.start_measure();
    elapsed_ns = 0;
    while (elapsed_ns < meas_active_timeout_ns) begin
        if (nd.vif.meas.activity_ok || nd.vif.meas.inactive)
            break;
        if (!nd.vif.meas.meas_en)
            break;
        #1ns;
        elapsed_ns++;
    end
    if (!nd.vif.meas.activity_ok) begin
        nd.vif.stop_measure();
        return;
    end
    elapsed_ns = 0;
    while (elapsed_ns < meas_stable_timeout_ns) begin
        if (nd.vif.meas.timed_out)
            break;
        if (!nd.vif.meas.meas_en)
            break;
        if (nd.vif.meas.freq_stable) begin
            ok = 1'b1;
            break;
        end
        #1ns;
        elapsed_ns++;
    end
    nd.vif.stop_measure();
    if (ok && nd.vif.meas.last_valid)
        phase_frac = nd.vif.meas.last_phase_frac;
    else
        ok = 1'b0;
endtask

task {{ settings.class_prefix }}test_flip_seq::verify_div_flip_pattern(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}div_div div_nd,
        {{ settings.class_prefix }}node_base keep_nodes[$],
        bit msb_one_lsb_zero,
        bit quiet,
        bit debug);
    {{ settings.class_prefix }}route_ctrl_snap snap;
    {{ settings.class_prefix }}node_base saved_nodes[$];
    {{ settings.class_prefix }}route_ctrl_snap saved_snaps[$];
    {{ settings.class_prefix }}node_base connected[$];
    {{ settings.class_prefix }}node_base disconnected[$];
    {{ settings.class_prefix }}route_activity_snap activity_snaps[$];
    int probe_ratio;
    string pat_label;

    if (div_nd == null)
        return;
    if (!div_nd.f_div.is_bound())
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_flip: div %s f_div not bound", div_nd.get_name()))

    probe_ratio = {{ settings.class_prefix }}div_ratio_for_reg_flip(
        div_nd.f_div, msb_one_lsb_zero);
    pat_label = msb_one_lsb_zero ? "msb1_lsb0" : "msb0_lsb1";

    {{ settings.class_prefix }}optimized_config_save_tree_ctrl(tree, saved_nodes, saved_snaps);
    {{ settings.class_prefix }}route_structure_save_ctrl(div_nd, snap);

    div_nd.ratio = probe_ratio;
    div_nd.unfix_ratio = 1'b0;
    {{ settings.class_prefix }}optimized_config_scope_for_subject(
        tree, div_nd, keep_nodes, connected, disconnected);
    {{ settings.class_prefix }}optimized_config_apply_disconnected_inactive(
        disconnected, activity_snaps);

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: div %s %s ratio %0d, check %s, skip %s",
            div_nd.get_name(), pat_label, probe_ratio,
            {{ settings.class_prefix }}route_structure_format_node_names(connected),
            {{ settings.class_prefix }}route_structure_format_node_names(disconnected)),
            UVM_MEDIUM)
    run_config_reg(tree, quiet);
    run_check_measure_quiet(tree, debug, disconnected);

    {{ settings.class_prefix }}optimized_config_restore_activity(activity_snaps);
    {{ settings.class_prefix }}route_structure_apply_ctrl(div_nd, snap, 1'b1);
    {{ settings.class_prefix }}optimized_config_restore_tree_ctrl(saved_nodes, saved_snaps);
    run_config_reg(tree, quiet);

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: div %s %s restored ratio %0d",
            div_nd.get_name(), pat_label, snap.ratio), UVM_MEDIUM)
endtask

task {{ settings.class_prefix }}test_flip_seq::verify_div_flip(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}div_div div_nd,
        {{ settings.class_prefix }}node_base keep_nodes[$],
        bit quiet,
        bit debug);
    int width;

    if (div_nd == null)
        return;
    width = {{ settings.class_prefix }}reg_field_width(div_nd.f_div);
    verify_div_flip_pattern(tree, div_nd, keep_nodes, 1'b1, quiet, debug);
    if (width > 1)
        verify_div_flip_pattern(tree, div_nd, keep_nodes, 1'b0, quiet, debug);
endtask

