{% if route_test_enabled %}
`ifndef {{ (settings.class_prefix ~ "test_flip_seq") | upper }}
`define {{ (settings.class_prefix ~ "test_flip_seq") | upper }}

class {{ settings.class_prefix }}test_flip_seq extends uvm_sequence #(
    {{ settings.class_prefix }}test_flip_req,
    {{ settings.class_prefix }}test_flip_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}test_flip_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    // 构造 div/dto 翻转测试序列
    function new(string name = "{{ settings.class_prefix }}test_flip_seq");
        super.new(name);
    endfunction

    // 验证 div/dto 控制位翻转后 clk 仍可测
    extern virtual task body();
    // 静默校验当前树的 clk 频率
    extern task run_check_freq_quiet(
        {{ settings.class_prefix }}tree_base tree);
    // 按当前树状态写寄存器
    extern task run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    // 按 MSB 或 LSB 单比特 pattern 写 div 分频比后校验
    extern task verify_div_flip_pattern(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}div div_nd,
        bit msb_one_lsb_zero,
        bit quiet);
    // div 两种 field 单比特 pattern 各测一轮
    extern task verify_div_flip(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}div div_nd,
        bit quiet);
    // 按 MSB 或 LSB 单比特 pattern 写 dto 分频比后校验
    extern task verify_dto_flip_pattern(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}dto dto_nd,
        bit msb_one_lsb_zero,
        bit quiet);
    // dto 两种 field 单比特 pattern 各测一轮
    extern task verify_dto_flip(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}dto dto_nd,
        bit quiet);
endclass

task {{ settings.class_prefix }}test_flip_seq::run_check_freq_quiet(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}check_freq_req freq_req;
    {{ settings.class_prefix }}check_freq_rsp freq_rsp;
    {{ settings.class_prefix }}check_freq_seq freq_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_flip: tree is null for check_freq")
    freq_req = {{ settings.class_prefix }}check_freq_req::type_id::create("freq_req");
    freq_req.tree = tree;
    freq_req.quiet = 1'b1;
    freq_seq = {{ settings.class_prefix }}check_freq_seq::type_id::create("check_freq");
    freq_seq.req = freq_req;
    freq_seq.start(p_sequencer);
    freq_rsp = freq_seq.rsp;
    if (freq_rsp == null || !freq_rsp.ok)
        `uvm_fatal("CLK_TREE", "test_flip: check_freq failed")
endtask

task {{ settings.class_prefix }}test_flip_seq::run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    {{ settings.class_prefix }}config_reg_req cfg_req;
    {{ settings.class_prefix }}config_reg_seq cfg_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_flip: tree is null for config_reg")
    cfg_req = {{ settings.class_prefix }}config_reg_req::type_id::create("cfg_req");
    cfg_req.tree = tree;
    cfg_req.quiet = quiet;
    cfg_seq = {{ settings.class_prefix }}config_reg_seq::type_id::create("config_reg");
    cfg_seq.req = cfg_req;
    cfg_seq.start(p_sequencer);
    if (cfg_seq.rsp == null || !cfg_seq.rsp.ok)
        `uvm_fatal("CLK_TREE", "test_flip: config_reg failed")
endtask

task {{ settings.class_prefix }}test_flip_seq::verify_div_flip_pattern(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}div div_nd,
        bit msb_one_lsb_zero,
        bit quiet);
    {{ settings.class_prefix }}route_ctrl_snap snap;
    int probe_ratio;
    string pat_label;

    if (div_nd == null)
        return;
    if (!div_nd.f_div.is_bound())
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_flip: div %s f_div not bound", div_nd.get_name()))

    probe_ratio = {{ settings.class_prefix }}div_ratio_for_reg_flip(
        div_nd.f_div, msb_one_lsb_zero);
    pat_label = msb_one_lsb_zero ? "msb1_lsb0" : "msb0_lsb1";

    {{ settings.class_prefix }}route_structure_save_ctrl(div_nd, snap);

    div_nd.fix_ratio = probe_ratio;

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: div %s %s fix_ratio %0d",
            div_nd.get_name(), pat_label, probe_ratio), UVM_MEDIUM)
    run_config_reg(tree, quiet);
    run_check_freq_quiet(tree);

    {{ settings.class_prefix }}route_structure_apply_ctrl(div_nd, snap, 1'b1);
    run_config_reg(tree, quiet);

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: div %s %s restored ratio %0d",
            div_nd.get_name(), pat_label, snap.ratio), UVM_MEDIUM)
endtask

task {{ settings.class_prefix }}test_flip_seq::verify_div_flip(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}div div_nd,
        bit quiet);
    int width;

    if (div_nd == null)
        return;
    width = {{ settings.class_prefix }}reg_field_width(div_nd.f_div);
    verify_div_flip_pattern(tree, div_nd, 1'b1, quiet);
    if (width > 1)
        verify_div_flip_pattern(tree, div_nd, 1'b0, quiet);
endtask

task {{ settings.class_prefix }}test_flip_seq::verify_dto_flip_pattern(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}dto dto_nd,
        bit msb_one_lsb_zero,
        bit quiet);
    {{ settings.class_prefix }}route_ctrl_snap snap;
    int probe_ratio;
    string pat_label;

    if (dto_nd == null)
        return;
    if (!dto_nd.f_step.is_bound())
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_flip: dto %s f_step not bound", dto_nd.get_name()))

    probe_ratio = {{ settings.class_prefix }}dto_ratio_for_reg_flip(
        dto_nd.f_step, msb_one_lsb_zero);
    pat_label = msb_one_lsb_zero ? "msb1_lsb0" : "msb0_lsb1";

    {{ settings.class_prefix }}route_structure_save_ctrl(dto_nd, snap);

    dto_nd.fix_ratio = probe_ratio;

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: dto %s %s fix_ratio %0d",
            dto_nd.get_name(), pat_label, probe_ratio), UVM_MEDIUM)
    run_config_reg(tree, quiet);
    run_check_freq_quiet(tree);

    {{ settings.class_prefix }}route_structure_apply_ctrl(dto_nd, snap, 1'b1);
    run_config_reg(tree, quiet);

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: dto %s %s restored ratio %0d",
            dto_nd.get_name(), pat_label, snap.ratio), UVM_MEDIUM)
endtask

task {{ settings.class_prefix }}test_flip_seq::verify_dto_flip(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}dto dto_nd,
        bit quiet);
    int width;

    if (dto_nd == null)
        return;
    width = {{ settings.class_prefix }}reg_field_width(dto_nd.f_step);
    verify_dto_flip_pattern(tree, dto_nd, 1'b1, quiet);
    if (width > 1)
        verify_dto_flip_pattern(tree, dto_nd, 1'b0, quiet);
endtask

task {{ settings.class_prefix }}test_flip_seq::body();
    {{ settings.class_prefix }}test_flip_req rq;
    {{ settings.class_prefix }}test_flip_rsp rs;
    {{ settings.class_prefix }}tree_base tree;
    {{ settings.class_prefix }}node_base subjects[$];
    {{ settings.class_prefix }}div div_nd;
    {{ settings.class_prefix }}dto dto_nd;
    int i;

    if (req == null)
        `uvm_fatal("CLK_TREE", "test_flip: req is null")

    rq = req;
    tree = rq.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_flip: tree is null")

    if (!rq.quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: begin tree %s", tree.get_name()), UVM_LOW)

    run_config_reg(tree, rq.quiet);

    if (!rq.quiet)
        `uvm_info("CLK_TREE",
            "test_flip: fix gate/mux after baseline config_reg", UVM_LOW)
    {{ settings.class_prefix }}route_structure_fix_all_gate_mux(tree);

    rs = {{ settings.class_prefix }}test_flip_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    {{ settings.class_prefix }}route_structure_collect_flip_subjects(
        tree, {}, subjects);
    if (subjects.size() == 0)
        `uvm_fatal("CLK_TREE",
            "test_flip: no div or dto node with bound regs in scope")

    {{ settings.class_prefix }}route_structure_set_all_clk_unfix_frequence(tree, 1'b1);

    for (i = 0; i < subjects.size(); i++) begin
        if ($cast(div_nd, subjects[i]))
            verify_div_flip(tree, div_nd, rq.quiet);
        else if ($cast(dto_nd, subjects[i]))
            verify_dto_flip(tree, dto_nd, rq.quiet);
        else
            `uvm_fatal("CLK_TREE", $sformatf(
                "test_flip: subject %s is not div or dto", subjects[i].get_name()))
    end

    if (!rq.quiet)
        `uvm_info("CLK_TREE",
            "test_flip: clear fix/unfix + config_reg", UVM_LOW)
    {{ settings.class_prefix }}route_structure_clear_all_fix(tree);
    run_config_reg(tree, rq.quiet);

    if (!rq.quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: passed, %0d subject node(s)", subjects.size()), UVM_LOW)

    rsp = rs;
endtask

`endif
{% endif %}
