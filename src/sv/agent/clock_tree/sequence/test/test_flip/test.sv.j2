task {{ settings.class_prefix }}test_flip_seq::verify_inv_flip(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}inv inv_nd,
        {{ settings.class_prefix }}node_base keep_nodes[$],
        bit quiet);
    real phase_before;
    real phase_after;
    real phase_diff;
    real phase_err;
    bit ok;
    bit saved_inverted;
    {{ settings.class_prefix }}node_base saved_nodes[$];
    {{ settings.class_prefix }}route_ctrl_snap saved_snaps[$];
    {{ settings.class_prefix }}node_base connected[$];
    {{ settings.class_prefix }}node_base disconnected[$];
    {{ settings.class_prefix }}route_activity_snap activity_snaps[$];

    if (inv_nd == null)
        return;
    if (inv_nd.vif == null)
        return;
    if (!inv_nd.f_reg.is_bound())
        return;

    saved_inverted = inv_nd.inverted;
    {{ settings.class_prefix }}optimized_config_save_tree_ctrl(tree, saved_nodes, saved_snaps);
    {{ settings.class_prefix }}optimized_config_scope_for_subject(
        tree, inv_nd, keep_nodes, connected, disconnected);
    {{ settings.class_prefix }}optimized_config_apply_disconnected_inactive(
        disconnected, activity_snaps);
    run_config_reg(tree, quiet);

    measure_node_phase(inv_nd, phase_before, ok);
    if (!ok)
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_flip: inv %s phase before flip did not stabilize",
            inv_nd.get_name()))

    inv_nd.inverted = !inv_nd.inverted;
    inv_nd.fix_inverted = 1'b1;

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: inv %s toggle inverted to %0b, check %s, skip %s",
            inv_nd.get_name(), inv_nd.inverted,
            {{ settings.class_prefix }}route_structure_format_node_names(connected),
            {{ settings.class_prefix }}route_structure_format_node_names(disconnected)),
            UVM_MEDIUM)
    run_config_reg(tree, quiet);

    measure_node_phase(inv_nd, phase_after, ok);
    if (!ok)
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_flip: inv %s phase after flip did not stabilize",
            inv_nd.get_name()))

    phase_diff = phase_after - phase_before;
    if (phase_diff < 0.0)
        phase_diff += 1.0;
    phase_err = (phase_diff > 0.5) ? (phase_diff - 0.5) : (0.5 - phase_diff);
    if (phase_err > {{ settings.period_tolerance }})
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_flip: inv %s phase diff %0.4f expected ~0.5 before %0.4f after %0.4f",
            inv_nd.get_name(), phase_diff, phase_before, phase_after))

    inv_nd.inverted = saved_inverted;
    inv_nd.fix_inverted = 1'b0;
    {{ settings.class_prefix }}optimized_config_restore_activity(activity_snaps);
    {{ settings.class_prefix }}optimized_config_restore_tree_ctrl(saved_nodes, saved_snaps);
    run_config_reg(tree, quiet);

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: inv %s phase flip OK diff %0.4f",
            inv_nd.get_name(), phase_diff), UVM_MEDIUM)
endtask

task {{ settings.class_prefix }}test_flip_seq::body();
    {{ settings.class_prefix }}test_flip_req rq;
    {{ settings.class_prefix }}test_flip_rsp rs;
    {{ settings.class_prefix }}tree_base tree;
    {{ settings.class_prefix }}node_base subjects[$];
    {{ settings.class_prefix }}div_div div_nd;
    {{ settings.class_prefix }}div_dto dto_nd;
    {{ settings.class_prefix }}inv inv_nd;
    {{ settings.class_prefix }}node_base stable_keep[$];
    int i;

    if (req == null)
        `uvm_fatal("CLK_TREE", "test_flip: req is null")

    rq = req;
    tree = rq.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_flip: tree is null")
    tree.require_built("test_flip");

    if (!rq.quiet || rq.debug)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: begin tree %s debug %0b", tree.get_name(), rq.debug), UVM_LOW)

    run_config_reg(tree, rq.quiet);

    {{ settings.class_prefix }}route_structure_collect_stable_upstream_gate_mux(
        tree, stable_keep);

    rs = {{ settings.class_prefix }}test_flip_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    {{ settings.class_prefix }}route_structure_collect_flip_subjects(
        tree, {}, subjects);
    if (subjects.size() == 0)
        `uvm_fatal("CLK_TREE",
            "test_flip: no div or dto node with bound regs in scope")

    {{ settings.class_prefix }}optimized_config_apply_tree(tree, stable_keep);
    {{ settings.class_prefix }}route_structure_pin_gate_mux_fix(tree, stable_keep);

    for (i = 0; i < subjects.size(); i++) begin
        if ($cast(div_nd, subjects[i]))
            verify_div_flip(tree, div_nd, stable_keep, rq.quiet, rq.debug);
        else if ($cast(dto_nd, subjects[i]))
            verify_dto_flip(tree, dto_nd, stable_keep, rq.quiet, rq.debug);
        else
            `uvm_fatal("CLK_TREE", $sformatf(
                "test_flip: subject %s is not div or dto", subjects[i].get_name()))
    end

    for (i = 0; i < tree.nodes.size(); i++) begin
        if (!$cast(inv_nd, tree.nodes[i]))
            continue;
        verify_inv_flip(tree, inv_nd, stable_keep, rq.quiet);
    end

    if (!rq.quiet)
        `uvm_info("CLK_TREE",
            "test_flip: clear fix/unfix + config_reg", UVM_LOW)
    {{ settings.class_prefix }}route_structure_clear_all_fix(tree);
    run_config_reg(tree, rq.quiet);

    if (!rq.quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: passed, %0d subject node(s)", subjects.size()), UVM_LOW)

    rsp = rs;
endtask

`endif
