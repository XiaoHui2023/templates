`ifndef {{ (settings.class_prefix ~ "flip_check_seq") | upper }}
`define {{ (settings.class_prefix ~ "flip_check_seq") | upper }}

class {{ settings.class_prefix }}flip_check_seq extends {{ settings.class_prefix }}base_seq #(
    {{ settings.class_prefix }}flip_check_req,
    {{ settings.class_prefix }}flip_check_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}flip_check_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    // Constructs the isolated state-transition test sequence.
    function new(string name = "{{ settings.class_prefix }}flip_check_seq");
        super.new(name);
    endfunction

    // Executes each node-provided transition check and returns the aggregate result.
    extern virtual task body();
    // Skips a node whose configuration can affect a stable clock path.
    extern function bit skip_stable_subject(
        input {{ settings.class_prefix }}node_base subject,
        input {{ settings.class_prefix }}node_base stable_nodes[$]);
endclass

function bit {{ settings.class_prefix }}flip_check_seq::skip_stable_subject(
        input {{ settings.class_prefix }}node_base subject,
        input {{ settings.class_prefix }}node_base stable_nodes[$]);
    if ({{ settings.class_prefix }}node_in_queue(subject, stable_nodes)) begin
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: skip %s, upstream of stable clock", subject.get_name()), UVM_LOW)
        return 1'b1;
    end
    foreach (stable_nodes[i]) begin
        if ({{ settings.class_prefix }}nodes_share_control_reg(subject, stable_nodes[i])) begin
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip %s, register shared with stable path %s",
                subject.get_name(), stable_nodes[i].get_name()), UVM_LOW)
            return 1'b1;
        end
    end
    return 1'b0;
endfunction

task {{ settings.class_prefix }}flip_check_seq::body();
    {{ settings.class_prefix }}flip_check_req rq;
    {{ settings.class_prefix }}flip_check_rsp rs;
    {{ settings.class_prefix }}tree_base tree;
    {{ settings.class_prefix }}config_reg_core cfg;
    {{ settings.class_prefix }}node_test_api api;
    {{ settings.class_prefix }}node_base stable_nodes[$];
    {{ settings.class_prefix }}node_base test_subjects[$];
    bit did_check;
    bit did_skip;
    int failure_count;
    int checked;
    int skipped;
    int subjects;
    int stable_skipped;
    int policy_skipped;
    int failed;

    if (req == null)
        `uvm_fatal("CLK_TREE", "test_flip: req is null")
    rq = req;
    tree = rq.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_flip: tree is null")
    tree.require_built("test_flip");
    if (p_sequencer.tools == null)
        `uvm_fatal("CLK_TREE", "test_flip: sequencer tools not built")

    rs = {{ settings.class_prefix }}flip_check_rsp::type_id::create("rsp");
    rs.ok = 1'b1;
    checked = 0;
    skipped = 0;
    subjects = 0;
    stable_skipped = 0;
    policy_skipped = 0;
    failed = 0;
    if (!rq.quiet || rq.debug)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: begin tree %s", tree.get_name()), UVM_LOW)

    tree.low_power();
    cfg = new(p_sequencer.tools, 1'b1);
    cfg.configure_low_power(tree, rq.quiet);
    api = new(cfg, "flip_node_api");
    {{ settings.class_prefix }}collect_stable_upstream_nodes(tree, stable_nodes);

    foreach (tree.nodes[i]) begin
        if (tree.nodes[i] == null || !tree.nodes[i].has_functional_contract())
            continue;
        subjects++;
        if (!tree.nodes[i]._should_check) begin
            policy_skipped++;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip %s, checking disabled", tree.nodes[i].get_name()), UVM_LOW)
            continue;
        end
        if (skip_stable_subject(tree.nodes[i], stable_nodes)) begin
            stable_skipped++;
            continue;
        end
        if (tree.nodes[i].requires_observed_descendant()
                && !{{ settings.class_prefix }}node_has_observed_descendant(tree, tree.nodes[i])) begin
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip %s, no observable endpoint downstream",
                tree.nodes[i].get_name()), UVM_LOW)
            continue;
        end
        test_subjects.push_back(tree.nodes[i]);
    end

    if (subjects == 0)
        `uvm_fatal("CLK_TREE", "test_flip: no node provides a transition check")
    if (test_subjects.size() == 0 && stable_skipped + policy_skipped != subjects)
        `uvm_fatal("CLK_TREE", "test_flip: no subject checked")

    foreach (test_subjects[i]) begin
        test_subjects[i].run_functional_contract(api, did_check, did_skip, failure_count);
        if (did_check == did_skip)
            `uvm_fatal("CLK_TREE", $sformatf(
                "test_flip: subject %s returned invalid check/skip status",
                test_subjects[i].get_name()))
        if (did_check)
            checked++;
        if (did_skip)
            skipped++;
        failed += failure_count;
    end

    rs.failed = failed;
    rs.ok = failed == 0;
    if (!rq.quiet || failed != 0)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: complete, %0d tested, %0d skipped, %0d checking disabled, %0d stable upstream skipped, %0d failed",
            checked, skipped, policy_skipped, stable_skipped, failed), UVM_LOW)
    rsp = rs;
endtask

`endif
