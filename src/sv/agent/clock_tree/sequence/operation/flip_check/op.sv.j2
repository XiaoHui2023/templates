`ifndef {{ (settings.class_prefix ~ "flip_check_seq") | upper }}
`define {{ (settings.class_prefix ~ "flip_check_seq") | upper }}

class {{ settings.class_prefix }}flip_check_seq extends {{ settings.class_prefix }}base_seq #(
    {{ settings.class_prefix }}flip_check_req,
    {{ settings.class_prefix }}flip_check_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}flip_check_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    // 构造端口功能测试序列
    function new(string name = "{{ settings.class_prefix }}flip_check_seq");
        super.new(name);
    endfunction

    // 执行端口功能测试并写回结果
    extern virtual task body();
    // 跳过 stable 时钟及其结构上游器件。
    extern function bit skip_stable_subject(
        input {{ settings.class_prefix }}node_base subject,
        input {{ settings.class_prefix }}node_base stable_nodes[$]);
    // 两个器件的输入驱动或输入驱动与输出观测是否使用同一结构信号。
    extern function bit subjects_conflict(
        input {{ settings.class_prefix }}node_base lhs,
        input {{ settings.class_prefix }}node_base rhs);
    // 将候选器件划分为批内无 force 冲突的并行批次。
    extern function void build_subject_batches(
        input {{ settings.class_prefix }}node_base subjects[$],
        output int batches[$][$]);
    // 测量一个端口频率
    extern task measure_port_freq(
        input virtual {{ settings.class_prefix }}interface vif,
        input string label,
        input int min_freq_hz,
        output real freq_hz,
        output bit passed);
    // 确认一个端口不活跃
    extern task check_port_inactive(
        input virtual {{ settings.class_prefix }}interface vif,
        input string label,
        input int min_freq_hz,
        output bit passed);
    // 验证 gate 开关功能
    extern task verify_gate(
        input {{ settings.class_prefix }}config_reg_core cfg,
        input semaphore reg_lock,
        input {{ settings.class_prefix }}gate gate_nd,
        output bit did_check,
        output bit did_skip,
        output int failures);
    // 验证 div 功能
    extern task verify_div(
        input {{ settings.class_prefix }}config_reg_core cfg,
        input semaphore reg_lock,
        input {{ settings.class_prefix }}div_div div_nd,
        output bit did_check,
        output bit did_skip,
        output int failures);
    // 验证 dto 分频功能。
    extern task verify_dto(
        input {{ settings.class_prefix }}config_reg_core cfg,
        input semaphore reg_lock,
        input {{ settings.class_prefix }}div_dto dto_nd,
        output bit did_check,
        output bit did_skip,
        output int failures);
    // 验证 mux 选择功能
    extern task verify_mux(
        input {{ settings.class_prefix }}config_reg_core cfg,
        input semaphore reg_lock,
        input {{ settings.class_prefix }}mux mux_nd,
        output bit did_check,
        output bit did_skip,
        output int failures);
    // 验证 inv 直通与反相功能
    extern task verify_inv(
        input {{ settings.class_prefix }}config_reg_core cfg,
        input semaphore reg_lock,
        input {{ settings.class_prefix }}inv_base inv_nd,
        output bit did_check,
        output bit did_skip,
        output int failures);
    // 按具体器件类型执行一个并行功能检查。
    extern task verify_subject(
        input {{ settings.class_prefix }}config_reg_core cfg,
        input semaphore reg_lock,
        input {{ settings.class_prefix }}node_base subject,
        output bit did_check,
        output bit did_skip,
        output int failures);
endclass

task {{ settings.class_prefix }}flip_check_seq::measure_port_freq(
        input virtual {{ settings.class_prefix }}interface vif,
        input string label,
        input int min_freq_hz,
        output real freq_hz,
        output bit passed);
    bit ok;

    freq_hz = 0.0;
    passed = 1'b0;
    if (vif == null)
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_flip: %s missing interface", label))
    vif.set_min_freq_hz(min_freq_hz);
    vif.start_measure();
    vif.wait_measure_stable(1'b1, 1'b0, ok);
    vif.stop_measure();
    vif.set_min_freq_hz({{ settings.min_freq_hz }});
    if (!ok || !vif.meas.last_valid) begin
        `uvm_error("CLK_TREE", $sformatf(
            "test_flip: %s frequency did not stabilize, expected %0d Hz",
            label, min_freq_hz))
        return;
    end
    freq_hz = vif.meas.last_freq_hz;
    passed = 1'b1;
endtask

task {{ settings.class_prefix }}flip_check_seq::check_port_inactive(
        input virtual {{ settings.class_prefix }}interface vif,
        input string label,
        input int min_freq_hz,
        output bit passed);
    bit ok;

    passed = 1'b0;
    if (vif == null)
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_flip: %s missing interface", label))
    vif.set_min_freq_hz(min_freq_hz);
    vif.start_measure();
    vif.wait_measure_stable(1'b0, 1'b0, ok);
    vif.stop_measure();
    vif.set_min_freq_hz({{ settings.min_freq_hz }});
    if (vif.meas.activity_ok) begin
        `uvm_error("CLK_TREE", $sformatf(
            "test_flip: %s expected inactive but active", label))
        return;
    end
    passed = 1'b1;
endtask

task {{ settings.class_prefix }}flip_check_seq::verify_gate(
        input {{ settings.class_prefix }}config_reg_core cfg,
        input semaphore reg_lock,
        input {{ settings.class_prefix }}gate gate_nd,
        output bit did_check,
        output bit did_skip,
        output int failures);
    virtual {{ settings.class_prefix }}interface in_vif;
    virtual {{ settings.class_prefix }}interface out_vif;
    real freq_hz;
    bit passed;

    did_check = 1'b0;
    did_skip = 1'b0;
    failures = 0;
    if (gate_nd == null)
        return;
    in_vif = gate_nd.get_in_vif();
    out_vif = gate_nd.get_out_vif();
    if (in_vif == null || out_vif == null || !gate_nd.f_reg.is_bound()) begin
        did_skip = 1'b1;
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: skip gate %s, missing interface or reg",
            gate_nd.get_name()), UVM_LOW)
        return;
    end

    `uvm_info("CLK_TREE", $sformatf(
        "test_flip: test gate %s", gate_nd.get_name()), UVM_LOW)

    in_vif.start_clock(100_000_000);
    reg_lock.get(1);
    cfg.config_reg_gate_node_reg(gate_nd, 1'b1);
    reg_lock.put(1);
    measure_port_freq(
        out_vif, {gate_nd.get_name(), ".out open"}, 100_000_000,
        freq_hz, passed);
    if (!passed)
        failures++;

    reg_lock.get(1);
    cfg.config_reg_gate_node_reg(gate_nd, 1'b0);
    reg_lock.put(1);
    #20ns;
    check_port_inactive(
        out_vif, {gate_nd.get_name(), ".out close"}, 100_000_000, passed);
    if (!passed)
        failures++;
    in_vif.release_drive();
    did_check = 1'b1;
endtask

function bit {{ settings.class_prefix }}flip_check_seq::skip_stable_subject(
        input {{ settings.class_prefix }}node_base subject,
        input {{ settings.class_prefix }}node_base stable_nodes[$]);
    if (!{{ settings.class_prefix }}node_in_queue(subject, stable_nodes))
        return 1'b0;
    `uvm_info("CLK_TREE", $sformatf(
        "test_flip: skip %s %s, upstream of stable clock",
        subject.kind, subject.get_name()), UVM_LOW)
    return 1'b1;
endfunction

function bit {{ settings.class_prefix }}flip_check_seq::subjects_conflict(
        input {{ settings.class_prefix }}node_base lhs,
        input {{ settings.class_prefix }}node_base rhs);
    {{ settings.class_prefix }}node_base lhs_inputs[$];
    {{ settings.class_prefix }}node_base rhs_inputs[$];

    if (lhs == null || rhs == null)
        return 1'b1;
    {{ settings.class_prefix }}tree_upstream_peers(lhs, lhs_inputs);
    {{ settings.class_prefix }}tree_upstream_peers(rhs, rhs_inputs);

    foreach (lhs_inputs[i]) begin
        if ({{ settings.class_prefix }}node_in_queue(lhs_inputs[i], rhs_inputs))
            return 1'b1;
    end
    if ({{ settings.class_prefix }}node_in_queue(lhs, rhs_inputs))
        return 1'b1;
    if ({{ settings.class_prefix }}node_in_queue(rhs, lhs_inputs))
        return 1'b1;
    return 1'b0;
endfunction

function void {{ settings.class_prefix }}flip_check_seq::build_subject_batches(
        input {{ settings.class_prefix }}node_base subjects[$],
        output int batches[$][$]);
    batches.delete();
    foreach (subjects[i]) begin
        bit placed;
        placed = 1'b0;
        foreach (batches[b]) begin
            bit conflict;
            conflict = 1'b0;
            foreach (batches[b][j]) begin
                if (subjects_conflict(subjects[i], subjects[batches[b][j]])) begin
                    conflict = 1'b1;
                    break;
                end
            end
            if (!conflict) begin
                batches[b].push_back(i);
                placed = 1'b1;
                break;
            end
        end
        if (!placed) begin
            int new_batch[$];
            new_batch.push_back(i);
            batches.push_back(new_batch);
        end
    end
endfunction

task {{ settings.class_prefix }}flip_check_seq::verify_div(
        input {{ settings.class_prefix }}config_reg_core cfg,
        input semaphore reg_lock,
        input {{ settings.class_prefix }}div_div div_nd,
        output bit did_check,
        output bit did_skip,
        output int failures);
    virtual {{ settings.class_prefix }}interface in_vif;
    virtual {{ settings.class_prefix }}interface out_vif;
    real out_freq_hz;
    real expected_freq_hz;
    real err_ratio;
    int ratio;
    bit passed;

    did_check = 1'b0;
    did_skip = 1'b0;
    failures = 0;
    if (div_nd == null)
        return;
    in_vif = div_nd.get_in_vif();
    out_vif = div_nd.get_out_vif();
    if (in_vif == null || out_vif == null
            || !div_nd.f_rst.is_bound() || !div_nd.f_load.is_bound()
            || !div_nd.f_div.is_bound()) begin
        did_skip = 1'b1;
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: skip div %s, missing interface or reg",
            div_nd.get_name()), UVM_LOW)
        return;
    end

    ratio = 4;
    `uvm_info("CLK_TREE", $sformatf(
        "test_flip: test div %s", div_nd.get_name()), UVM_LOW)

    in_vif.start_clock(800_000_000);
    reg_lock.get(1);
    cfg.config_reg_div_node_reg(div_nd, ratio);
    reg_lock.put(1);
    #20ns;
    measure_port_freq(
        out_vif, {div_nd.get_name(), ".out"}, 200_000_000,
        out_freq_hz, passed);

    expected_freq_hz = 800_000_000.0 / ratio;
    if (!passed)
        failures++;
    else begin
        err_ratio = (out_freq_hz > expected_freq_hz)
            ? ((out_freq_hz - expected_freq_hz) / expected_freq_hz)
            : ((expected_freq_hz - out_freq_hz) / expected_freq_hz);
        if (err_ratio > {{ settings.period_tolerance }}) begin
            failures++;
            `uvm_error("CLK_TREE", $sformatf(
                "test_flip: div %s output %0.2f Hz expected %0.2f Hz",
                div_nd.get_name(), out_freq_hz, expected_freq_hz))
        end
    end
    in_vif.release_drive();
    did_check = 1'b1;
endtask

