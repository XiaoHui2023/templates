    #1ns;
    if (out_vif.in !== 1'b1) begin
        failures++;
        `uvm_error("CLK_TREE", $sformatf(
            "test_flip: inv %s inverted input 0 output %0b",
            inv_nd.get_name(), out_vif.in))
    end
    in_vif.drive_static(1'b1);
    #1ns;
    if (out_vif.in !== 1'b0) begin
        failures++;
        `uvm_error("CLK_TREE", $sformatf(
            "test_flip: inv %s inverted input 1 output %0b",
            inv_nd.get_name(), out_vif.in))
    end
    in_vif.release_drive();
    did_check = 1'b1;
endtask

task {{ settings.class_prefix }}flip_check_seq::verify_subject(
        input {{ settings.class_prefix }}config_reg_core cfg,
        input semaphore reg_lock,
        input {{ settings.class_prefix }}node_base subject,
        output bit did_check,
        output bit did_skip,
        output int failures);
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}div_div div_nd;
    {{ settings.class_prefix }}div_dto dto_nd;
    {{ settings.class_prefix }}mux mux_nd;
    {{ settings.class_prefix }}inv_base inv_nd;

    did_check = 1'b0;
    did_skip = 1'b0;
    failures = 0;
    if ($cast(gate_nd, subject))
        verify_gate(cfg, reg_lock, gate_nd, did_check, did_skip, failures);
    else if ($cast(div_nd, subject))
        verify_div(cfg, reg_lock, div_nd, did_check, did_skip, failures);
    else if ($cast(dto_nd, subject))
        verify_dto(cfg, reg_lock, dto_nd, did_check, did_skip, failures);
    else if ($cast(mux_nd, subject))
        verify_mux(cfg, reg_lock, mux_nd, did_check, did_skip, failures);
    else if ($cast(inv_nd, subject))
        verify_inv(cfg, reg_lock, inv_nd, did_check, did_skip, failures);
endtask

task {{ settings.class_prefix }}flip_check_seq::body();
    {{ settings.class_prefix }}flip_check_req rq;
    {{ settings.class_prefix }}flip_check_rsp rs;
    {{ settings.class_prefix }}tree_base tree;
    {{ settings.class_prefix }}config_reg_core cfg;
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}div_div div_nd;
    {{ settings.class_prefix }}div_dto dto_nd;
    {{ settings.class_prefix }}mux mux_nd;
    {{ settings.class_prefix }}inv_base inv_nd;
    {{ settings.class_prefix }}pll_base pll_nd;
    {{ settings.class_prefix }}node_base stable_nodes[$];
    {{ settings.class_prefix }}node_base test_subjects[$];
    semaphore reg_lock;
    int subject_batches[$][$];
    bit did_checks[];
    bit did_skips[];
    int failure_counts[];
    int checked;
    int skipped;
    int subjects;
    int stable_skipped;
    int failed;
    int total;

    if (req == null)
        `uvm_fatal("CLK_TREE", "test_flip: req is null")

    rq = req;
    tree = rq.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_flip: tree is null")
    tree.require_built("test_flip");

    rs = {{ settings.class_prefix }}flip_check_rsp::type_id::create("rsp");
    rs.ok = 1'b1;
    checked = 0;
    skipped = 0;
    subjects = 0;
    stable_skipped = 0;
    failed = 0;

    if (!rq.quiet || rq.debug)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: begin tree %s", tree.get_name()), UVM_LOW)

    tree.low_power();
    if (p_sequencer.tools == null)
        `uvm_fatal("CLK_TREE", "test_flip: sequencer tools not built")
    cfg = new(p_sequencer.tools, 1'b1);
    cfg.configure_low_power(tree, rq.quiet);
    reg_lock = new(1);
    {{ settings.class_prefix }}collect_stable_upstream_nodes(tree, stable_nodes);

    foreach (tree.nodes[i]) begin
        if (tree.nodes[i] == null)
            continue;
        if ($cast(gate_nd, tree.nodes[i])) begin
            subjects++;
            if (skip_stable_subject(gate_nd, stable_nodes)) begin
                stable_skipped++;
                continue;
            end
            if (!{{ settings.class_prefix }}control_node_is_valid(tree, gate_nd)) begin
                `uvm_info("CLK_TREE", $sformatf(
                    "test_flip: skip gate %s, no non-volatile clock downstream",
                    gate_nd.get_name()), UVM_LOW)
                continue;
            end
            test_subjects.push_back(gate_nd);
        end else if ($cast(div_nd, tree.nodes[i])) begin
            subjects++;
            if (skip_stable_subject(div_nd, stable_nodes)) begin
                stable_skipped++;
                continue;
            end
            if (!{{ settings.class_prefix }}control_node_is_valid(tree, div_nd)) begin
                `uvm_info("CLK_TREE", $sformatf(
                    "test_flip: skip div %s, no non-volatile clock downstream",
                    div_nd.get_name()), UVM_LOW)
                continue;
            end
            test_subjects.push_back(div_nd);
        end else if ($cast(dto_nd, tree.nodes[i])) begin
            subjects++;
            if (skip_stable_subject(dto_nd, stable_nodes)) begin
                stable_skipped++;
                continue;
            end
            if (!{{ settings.class_prefix }}control_node_is_valid(tree, dto_nd)) begin
                `uvm_info("CLK_TREE", $sformatf(
                    "test_flip: skip dto %s, no non-volatile clock downstream",
                    dto_nd.get_name()), UVM_LOW)
                continue;
            end
            test_subjects.push_back(dto_nd);
        end else if ($cast(mux_nd, tree.nodes[i])) begin
            subjects++;
            if (skip_stable_subject(mux_nd, stable_nodes)) begin
                stable_skipped++;
                continue;
            end
            if (!{{ settings.class_prefix }}control_node_is_valid(tree, mux_nd)) begin
                `uvm_info("CLK_TREE", $sformatf(
                    "test_flip: skip mux %s, no non-volatile clock downstream",
                    mux_nd.get_name()), UVM_LOW)
                continue;
            end
            test_subjects.push_back(mux_nd);
        end else if ($cast(inv_nd, tree.nodes[i])) begin
            subjects++;
            if (skip_stable_subject(inv_nd, stable_nodes)) begin
                stable_skipped++;
                continue;
            end
            test_subjects.push_back(inv_nd);
        end else if ($cast(pll_nd, tree.nodes[i])) begin
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip pll %s, function test disabled",
                pll_nd.get_name()), UVM_LOW)
        end
    end

    if (subjects == 0)
        `uvm_fatal("CLK_TREE", "test_flip: no gate/div/mux/inv subject")
    if (test_subjects.size() == 0 && stable_skipped != subjects)
        `uvm_fatal("CLK_TREE", "test_flip: no subject checked")

    total = test_subjects.size();
    did_checks = new[total];
    did_skips = new[total];
    failure_counts = new[total];
    build_subject_batches(test_subjects, subject_batches);
    foreach (subject_batches[b]) begin
        fork
            begin
                foreach (subject_batches[b][i]) begin
                    fork
                        automatic int idx = subject_batches[b][i];
                        begin
                            verify_subject(cfg, reg_lock, test_subjects[idx],
                                did_checks[idx], did_skips[idx],
                                failure_counts[idx]);
                        end
                    join_none
                end
                wait fork;
            end
        join
    end

    for (int i = 0; i < total; i++) begin
        if (did_checks[i] == did_skips[i])
            `uvm_fatal("CLK_TREE", $sformatf(
                "test_flip: subject %s returned invalid check/skip status",
                test_subjects[i].get_name()))
        if (did_checks[i])
            checked++;
        if (did_skips[i])
            skipped++;
        failed += failure_counts[i];
    end

    rs.failed = failed;
    rs.ok = failed == 0;
    if (!rq.quiet || failed != 0)
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: complete, %0d tested, %0d skipped, %0d stable upstream skipped, %0d failed, pll skipped",
            checked, skipped, stable_skipped, failed), UVM_LOW)

    rsp = rs;
endtask

`endif
