    #1ns;
    if (out_vif.in !== 1'b1) begin
        failures++;
        `uvm_error("CLK_TREE", $sformatf(
            "test_flip: inv %s direct input 1 output %0b",
            inv_nd.get_name(), out_vif.in))
    end

    reg_lock.get(1);
    cfg.config_reg_inv_node_reg(inv_nd, 1'b1);
    reg_lock.put(1);
