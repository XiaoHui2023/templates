task {{ settings.class_prefix }}flip_check_seq::verify_mux(
        input {{ settings.class_prefix }}config_reg_core cfg,
        input semaphore reg_lock,
        input {{ settings.class_prefix }}mux mux_nd,
        output bit did_check,
        output bit did_skip,
        output int failures);
    virtual {{ settings.class_prefix }}interface in_vif;
    virtual {{ settings.class_prefix }}interface out_vif;
    real out_freq_hz;
    real expected_freq_hz[int];
    real err_ratio;
    string in_key;
    int stim_freq_hz;
    bit passed;

    did_check = 1'b0;
    did_skip = 1'b0;
    failures = 0;
    if (mux_nd == null)
        return;
    out_vif = mux_nd.get_out_vif();
    if (out_vif == null || !mux_nd.f_reg.is_bound()) begin
        did_skip = 1'b1;
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: skip mux %s, missing out interface or reg",
            mux_nd.get_name()), UVM_LOW)
        return;
    end

    foreach (mux_nd.to_source[k]) begin
        in_key = $sformatf("%0d", k);
        in_vif = mux_nd.get_in_vif(in_key);
        if (in_vif == null) begin
            did_skip = 1'b1;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip mux %s input %s, missing interface",
                mux_nd.get_name(), in_key), UVM_LOW)
            return;
        end
    end

    `uvm_info("CLK_TREE", $sformatf(
        "test_flip: test mux %s", mux_nd.get_name()), UVM_LOW)

    foreach (mux_nd.to_source[k]) begin
        in_key = $sformatf("%0d", k);
        in_vif = mux_nd.get_in_vif(in_key);
        stim_freq_hz = 100_000_000 + k * 37_000_000;
        expected_freq_hz[k] = stim_freq_hz;
        in_vif.start_clock(stim_freq_hz);
    end

    foreach (mux_nd.to_source[k]) begin
        reg_lock.get(1);
        cfg.config_reg_mux_node_reg(mux_nd, k);
        reg_lock.put(1);
        #50ns;
        measure_port_freq(
            out_vif, {mux_nd.get_name(), ".out"},
            int'(expected_freq_hz[k]), out_freq_hz, passed);
        if (!passed)
            failures++;
        else begin
            err_ratio = (out_freq_hz > expected_freq_hz[k])
                ? ((out_freq_hz - expected_freq_hz[k]) / expected_freq_hz[k])
                : ((expected_freq_hz[k] - out_freq_hz) / expected_freq_hz[k]);
            if (err_ratio > {{ settings.period_tolerance }}) begin
                failures++;
                `uvm_error("CLK_TREE", $sformatf(
                    "test_flip: mux %s sel %0d output %0.2f Hz expected %0.2f Hz",
                    mux_nd.get_name(), k, out_freq_hz, expected_freq_hz[k]))
            end
        end
    end

    foreach (mux_nd.to_source[k]) begin
        in_key = $sformatf("%0d", k);
        in_vif = mux_nd.get_in_vif(in_key);
        if (in_vif != null)
            in_vif.release_drive();
    end
    did_check = 1'b1;
endtask

