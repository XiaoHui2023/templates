`ifndef {{ (settings.class_prefix ~ "route_check_seq") | upper }}
`define {{ (settings.class_prefix ~ "route_check_seq") | upper }}

class {{ settings.class_prefix }}route_check_seq extends uvm_sequence #(
    {{ settings.class_prefix }}route_check_req,
    {{ settings.class_prefix }}route_check_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}route_check_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    // 构造端口连线测试序列
    function new(string name = "{{ settings.class_prefix }}route_check_seq");
        super.new(name);
    endfunction

    // 执行端口连线测试并写回结果
    extern virtual task body();
    // 按当前树状态写寄存器
    extern task run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    // 检查一条 parent.out 到 child.in 的连线
    extern task check_edge(
        input {{ settings.class_prefix }}node_base parent,
        input string out_key,
        input {{ settings.class_prefix }}node_base child,
        input string in_key,
        input string edge_name,
        input bit quiet,
        inout int checked,
        inout int skipped);
endclass

task {{ settings.class_prefix }}route_check_seq::run_config_reg(
        {{ settings.class_prefix }}tree_base tree, bit quiet);
    {{ settings.class_prefix }}config_reg_req cfg_req;
    {{ settings.class_prefix }}config_reg_seq cfg_seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null for config_reg")
    cfg_req = {{ settings.class_prefix }}config_reg_req::type_id::create("cfg_req");
    cfg_req.tree = tree;
    cfg_req.quiet = quiet;
    cfg_seq = {{ settings.class_prefix }}config_reg_seq::type_id::create("config_reg");
    cfg_seq.req = cfg_req;
    cfg_seq.start(p_sequencer);
    if (cfg_seq.rsp == null || !cfg_seq.rsp.ok)
        `uvm_fatal("CLK_TREE", "test_route: config_reg failed")
endtask

task {{ settings.class_prefix }}route_check_seq::check_edge(
        input {{ settings.class_prefix }}node_base parent,
        input string out_key,
        input {{ settings.class_prefix }}node_base child,
        input string in_key,
        input string edge_name,
        input bit quiet,
        inout int checked,
        inout int skipped);
    virtual {{ settings.class_prefix }}interface out_vif;
    virtual {{ settings.class_prefix }}interface in_vif;

    if (parent == null || child == null)
        return;

    out_vif = parent.get_out_vif(out_key);
    in_vif = child.get_in_vif(in_key);
    if (out_vif == null || in_vif == null) begin
        skipped++;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "test_route: skip %s, missing %s%s%s",
                edge_name,
                out_vif == null ? "parent out interface" : "",
                (out_vif == null && in_vif == null) ? " and " : "",
                in_vif == null ? "child in interface" : ""),
                UVM_LOW)
        return;
    end

    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: check %s", edge_name), UVM_LOW)

    out_vif.drive_static(1'b0);
    #1ns;
    if (in_vif.in !== 1'b0) begin
        out_vif.release_drive();
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_route: %s failed, force 0 measured %0b",
            edge_name, in_vif.in))
    end

    out_vif.drive_static(1'b1);
    #1ns;
    if (in_vif.in !== 1'b1) begin
        out_vif.release_drive();
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_route: %s failed, force 1 measured %0b",
            edge_name, in_vif.in))
    end

    out_vif.release_drive();
    checked++;
endtask

task {{ settings.class_prefix }}route_check_seq::body();
    {{ settings.class_prefix }}route_check_req rq;
    {{ settings.class_prefix }}route_check_rsp rs;
    {{ settings.class_prefix }}tree_base tree;
    {{ settings.class_prefix }}mux mux_nd;
    int checked;
    int skipped;
    string in_key;
    string edge_name;

    if (req == null)
        `uvm_fatal("CLK_TREE", "test_route: req is null")

    rq = req;
    tree = rq.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null")
    tree.require_built("test_route");

    rs = {{ settings.class_prefix }}route_check_rsp::type_id::create("rsp");
    rs.ok = 1'b1;
    checked = 0;
    skipped = 0;

    if (!rq.quiet || rq.debug)
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: begin tree %s", tree.get_name()), UVM_LOW)

    tree.low_power();
    run_config_reg(tree, rq.quiet);

    foreach (tree.nodes[i]) begin
        if (tree.nodes[i] == null)
            continue;
        if ($cast(mux_nd, tree.nodes[i])) begin
            foreach (mux_nd.to_source[k]) begin
                if (mux_nd.to_source[k] == null)
                    continue;
                in_key = $sformatf("%0d", k);
                edge_name = $sformatf("%s.out -> %s.in[%s]",
                    mux_nd.to_source[k].get_name(), mux_nd.get_name(), in_key);
                check_edge(mux_nd.to_source[k], "", mux_nd, in_key, edge_name,
                    rq.quiet, checked, skipped);
            end
        end else if (tree.nodes[i].source != null) begin
            edge_name = $sformatf("%s.out -> %s.in",
                tree.nodes[i].source.get_name(), tree.nodes[i].get_name());
            check_edge(tree.nodes[i].source, "", tree.nodes[i], "", edge_name,
                rq.quiet, checked, skipped);
        end
    end

    if (checked == 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "test_route: no edge checked, %0d skipped due to missing interface",
            skipped))

    if (!rq.quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: passed, %0d edge(s), %0d skipped",
            checked, skipped), UVM_LOW)

    rsp = rs;
endtask

`endif
