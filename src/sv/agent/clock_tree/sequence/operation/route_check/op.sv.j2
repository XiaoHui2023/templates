`ifndef {{ (settings.class_prefix ~ "route_check_seq") | upper }}
`define {{ (settings.class_prefix ~ "route_check_seq") | upper }}

class {{ settings.class_prefix }}route_check_seq extends {{ settings.class_prefix }}base_seq #(
    {{ settings.class_prefix }}route_check_req,
    {{ settings.class_prefix }}route_check_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}route_check_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    // 构造端口连线测试序列
    function new(string name = "{{ settings.class_prefix }}route_check_seq");
        super.new(name);
    endfunction

    // 执行端口连线测试并写回结果
    extern virtual task body();
    // Observes native transitions or probes an idle output and its fanout.
    extern task check_parent_routes(
        input {{ settings.class_prefix }}tree_base tree,
        input {{ settings.class_prefix }}node_base parent,
        output int checked,
        output int skipped,
        output int failed);
endclass

task {{ settings.class_prefix }}route_check_seq::check_parent_routes(
        input {{ settings.class_prefix }}tree_base tree,
        input {{ settings.class_prefix }}node_base parent,
        output int checked,
        output int skipped,
        output int failed);
    virtual {{ settings.class_prefix }}interface out_vif;
    virtual {{ settings.class_prefix }}interface in_vif;
    virtual {{ settings.class_prefix }}interface in_vifs[$];
    string edge_names[$];
    string input_keys[$];
    string in_key;
    string edge_name;
    time deadline;
    time observation_deadline;
    time sample_deadline;
    real idle_ns;
    real rate_hz;
    bit changed;
    bit native_activity;
    bit drive_owned;
    bit drive_blocked;
    bit expect_toggle;
    {{ settings.class_prefix }}node_base::activity_e activity;
    bit expected_value;
    logic observed_value;
    string method_name;

    checked = 0;
    skipped = 0;
    failed = 0;
    if (tree == null || parent == null)
        return;
    if (!parent._should_check) begin
        skipped = 1;
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: skip %s, checking disabled", parent.get_name()), UVM_LOW)
        return;
    end

    out_vif = parent.get_out_vif();
    foreach (tree.nodes[i]) begin
        if (tree.nodes[i] == null)
            continue;
        tree.nodes[i].collect_input_keys_from_source(parent, input_keys);
        foreach (input_keys[key_idx]) begin
            in_key = input_keys[key_idx];
            if (!tree.nodes[i]._should_check) begin
                skipped++;
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route: skip %s.out -> %s.in, checking disabled",
                    parent.get_name(), tree.nodes[i].get_name()), UVM_LOW)
                continue;
            end
            in_vif = tree.nodes[i].get_in_vif(in_key);
            edge_name = in_key == ""
                ? $sformatf("%s.out -> %s.in", parent.get_name(), tree.nodes[i].get_name())
                : $sformatf("%s.out -> %s.in[%s]",
                    parent.get_name(), tree.nodes[i].get_name(), in_key);
            if (out_vif == null || in_vif == null) begin
                skipped++;
                `uvm_info("CLK_TREE", $sformatf(
                    "test_route: skip %s, missing %s%s%s",
                    edge_name,
                    out_vif == null ? "source out interface" : "",
                    (out_vif == null && in_vif == null) ? " and " : "",
                    in_vif == null ? "sink in interface" : ""), UVM_LOW)
            end else begin
                in_vifs.push_back(in_vif);
                edge_names.push_back(edge_name);
            end
        end
    end

    if (in_vifs.size() == 0)
        return;
    checked = in_vifs.size();
    deadline = {{ settings.class_prefix }}time_domain::after_ns(req.timeout_ns);
    activity = parent.output_activity();
    expect_toggle = activity == {{ settings.class_prefix }}node_base::ACTIVITY_TOGGLING;
    native_activity = 1'b0;
    drive_blocked = !out_vif.allow_override || out_vif.drive_en;
    foreach (in_vifs[i])
        drive_blocked |= !in_vifs[i].allow_override || in_vifs[i].drive_en;
    if (activity != {{ settings.class_prefix }}node_base::ACTIVITY_STATIC) begin
        observation_deadline = deadline;
        if (!expect_toggle && !drive_blocked) begin
            idle_ns = req.idle_window_ns;
            rate_hz = parent.clock_rate_hz();
            if (rate_hz > 0.0 && 2.0e9 / rate_hz > idle_ns)
                idle_ns = 2.0e9 / rate_hz;
            observation_deadline = {{ settings.class_prefix }}time_domain::after_ns(idle_ns);
            if (observation_deadline > deadline)
                observation_deadline = deadline;
        end
        out_vif.wait_transition(observation_deadline, native_activity);
        if (!native_activity && !expect_toggle) begin
            drive_blocked = !out_vif.allow_override || out_vif.drive_en;
            foreach (in_vifs[i])
                drive_blocked |= !in_vifs[i].allow_override || in_vifs[i].drive_en;
        end
    end

    method_name = (native_activity || expect_toggle) ? "observe native stimulus" :
        (drive_blocked ? "no activity, drive unavailable" : "idle probe");
    foreach (edge_names[i])
        `uvm_info("CLK_TREE", $sformatf(
            "test_route: test %s, %s", edge_names[i],
            method_name), UVM_LOW)

    if (expect_toggle && !native_activity) begin
        failed = checked;
        `uvm_error("CLK_TREE", $sformatf(
            "test_route: %s expected native transitions, none before deadline", parent.get_name()))
        return;
    end

    drive_owned = 1'b0;
    for (int sample = 0; sample < req.transitions; sample++) begin
        if ({{ settings.class_prefix }}time_domain::now_ticks() >= deadline) begin
            failed += in_vifs.size();
            `uvm_error("CLK_TREE", $sformatf(
                "test_route: %s deadline expired%s", parent.get_name(),
                drive_blocked && !native_activity ? "; no activity and drive unavailable" : ""))
            break;
        end
        if (native_activity) begin
            if (sample != 0) begin
                out_vif.wait_transition(deadline, changed);
                if (!changed) begin
                    failed += in_vifs.size();
                    `uvm_error("CLK_TREE", $sformatf(
                        "test_route: %s native stimulus timed out after %0d transition(s)",
                        parent.get_name(), sample))
                    break;
                end
            end
            observed_value = out_vif.in;
            if ($isunknown(observed_value)) begin
                failed += in_vifs.size();
                `uvm_error("CLK_TREE", $sformatf(
                    "test_route: %s source is X/Z", parent.get_name()))
                break;
            end
            expected_value = observed_value;
        end else begin
            if (drive_blocked) begin
                failed += in_vifs.size();
                `uvm_error("CLK_TREE", $sformatf(
                    "test_route: %s has no activity and drive is unavailable",
                    parent.get_name()))
                break;
            end
            expected_value = sample[0];
            out_vif.drive_static(expected_value);
            drive_owned = 1'b1;
        end
        sample_deadline = {{ settings.class_prefix }}time_domain::after_ns(req.settle_ns);
        {{ settings.class_prefix }}time_domain::wait_until(
            sample_deadline < deadline ? sample_deadline : deadline);
        if ({{ settings.class_prefix }}time_domain::now_ticks() >= deadline ||
                out_vif.in !== expected_value) begin
            failed += in_vifs.size();
            `uvm_error("CLK_TREE", $sformatf(
                "test_route: %s source did not hold %0b or deadline expired, measured %0b",
                parent.get_name(), expected_value, out_vif.in))
            break;
        end
        foreach (in_vifs[i]) begin
            if (in_vifs[i].in !== expected_value) begin
                failed++;
                `uvm_error("CLK_TREE", $sformatf(
                    "test_route: %s expected %0b measured %0b",
                    edge_names[i], expected_value, in_vifs[i].in))
            end
        end
        if (!native_activity) begin
            sample_deadline = {{ settings.class_prefix }}time_domain::after_ns(
                req.drive_hold_ns * (sample + 1));
            {{ settings.class_prefix }}time_domain::wait_until(
                sample_deadline < deadline ? sample_deadline : deadline);
            if ({{ settings.class_prefix }}time_domain::now_ticks() >= deadline ||
                    out_vif.in !== expected_value) begin
                failed += in_vifs.size();
                `uvm_error("CLK_TREE", $sformatf(
                    "test_route: %s probe was interrupted or deadline expired",
                    parent.get_name()))
                break;
            end
            foreach (in_vifs[i]) begin
                if (in_vifs[i].in !== expected_value) begin
                    failed++;
                    `uvm_error("CLK_TREE", $sformatf(
                        "test_route: %s did not hold %0b, measured %0b",
                        edge_names[i], expected_value, in_vifs[i].in))
                end
            end
        end
    end
    if (drive_owned) begin
        out_vif.release_drive();
        {{ settings.class_prefix }}time_domain::delay_ns(req.settle_ns);
    end
endtask

task {{ settings.class_prefix }}route_check_seq::body();
    {{ settings.class_prefix }}route_check_req rq;
    {{ settings.class_prefix }}route_check_rsp rs;
    {{ settings.class_prefix }}tree_base tree;
    {{ settings.class_prefix }}node_base parents[$];
    {{ settings.class_prefix }}node_base source_nodes[$];
    int checked_counts[];
    int skipped_counts[];
    int failed_counts[];
    int checked;
    int skipped;
    int failed;
    int total;

    if (req == null)
        `uvm_fatal("CLK_TREE", "test_route: req is null")

    rq = req;
    if (!(rq.timeout_ns > 0.0) || !(rq.idle_window_ns > 0.0) ||
            !(rq.settle_ns > 0.0) || !(rq.drive_hold_ns > 0.0) ||
            rq.transitions < 2 || rq.settle_ns >= rq.drive_hold_ns ||
            rq.idle_window_ns >= rq.timeout_ns)
        `uvm_fatal("CLK_TREE", "test_route: invalid timing or transition count")
    tree = rq.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null")
    tree.require_built("test_route");

    rs = {{ settings.class_prefix }}route_check_rsp::type_id::create("rsp");
    rs.ok = 1'b1;
    checked = 0;
    skipped = 0;
    failed = 0;

    `uvm_info("CLK_TREE", $sformatf(
        "test_route: begin tree %s", tree.get_name()), UVM_LOW)

    tree.low_power();
    if (p_sequencer.tools == null)
        `uvm_fatal("CLK_TREE", "test_route: sequencer tools not built")
    tree.configure();

    foreach (tree.nodes[i]) begin
        if (tree.nodes[i] == null)
            continue;
        tree.nodes[i].collect_source_nodes(source_nodes);
        foreach (source_nodes[src_idx]) begin
            {{ settings.class_prefix }}append_unique_node(
                parents, source_nodes[src_idx]);
        end
    end

    total = parents.size();
    checked_counts = new[total];
    skipped_counts = new[total];
    failed_counts = new[total];
    foreach (parents[i]) begin
        check_parent_routes(tree, parents[i],
            checked_counts[i], skipped_counts[i], failed_counts[i]);
    end

    for (int i = 0; i < total; i++) begin
        if (checked_counts[i] == 0 && skipped_counts[i] == 0)
            `uvm_fatal("CLK_TREE", $sformatf(
                "test_route: parent %s returned no checked or skipped edge",
                parents[i].get_name()))
        checked += checked_counts[i];
        skipped += skipped_counts[i];
        failed += failed_counts[i];
    end

    if (checked == 0) begin
        if (total == 0)
            `uvm_fatal("CLK_TREE", $sformatf(
                "test_route: no route edge found in %0d tree node(s); source/to_source connections are empty",
                tree.nodes.size()))
        else
            `uvm_fatal("CLK_TREE", $sformatf(
                "test_route: all %0d route edge(s) skipped by node policy or missing interface",
                skipped))
    end

    rs.failed = failed;
    rs.ok = failed == 0;
    `uvm_info("CLK_TREE", $sformatf(
        "test_route: complete, %0d edge(s), %0d skipped, %0d failed",
        checked, skipped, failed), UVM_LOW)

    rsp = rs;
endtask

`endif
