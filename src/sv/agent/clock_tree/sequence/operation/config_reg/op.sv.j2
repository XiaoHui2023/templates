            "config_reg: dto %s ratio %0d", dto_nd.get_name(), dto_nd._resolved_ratio), UVM_MEDIUM)
    p_sequencer.tools.node.configure_dto(
        dto_nd.f_rst, dto_nd.f_load, dto_nd.f_bypass, dto_nd.f_step, dto_nd._resolved_ratio);
{%- else %}
    if (p_sequencer.tools.node.dto_rst_was_released(dto_nd.get_name())) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: dto %s skip rst, ratio %0d",
                dto_nd.get_name(), dto_nd._resolved_ratio), UVM_MEDIUM)
        p_sequencer.tools.node.configure_dto_ratio(
            dto_nd.f_load, dto_nd.f_bypass, dto_nd.f_step, dto_nd._resolved_ratio);
    end else begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: dto %s ratio %0d", dto_nd.get_name(), dto_nd._resolved_ratio), UVM_MEDIUM)
        p_sequencer.tools.node.configure_dto_direct(
            dto_nd.f_rst, dto_nd.f_load, dto_nd.f_bypass, dto_nd.f_step, dto_nd._resolved_ratio);
        p_sequencer.tools.node.note_dto_rst_released(dto_nd.get_name());
    end
{%- endif %}
endtask

