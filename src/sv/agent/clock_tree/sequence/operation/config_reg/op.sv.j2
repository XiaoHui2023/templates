{% if regs_enabled %}
`ifndef {{ (settings.class_prefix ~ "config_reg_seq") | upper }}
`define {{ (settings.class_prefix ~ "config_reg_seq") | upper }}

class {{ settings.class_prefix }}config_reg_seq extends uvm_sequence #(
    {{ settings.class_prefix }}config_reg_req,
    {{ settings.class_prefix }}config_reg_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}config_reg_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    protected bit quiet;

    // 构造寄存器配置序列
    function new(string name = "{{ settings.class_prefix }}config_reg_seq");
        super.new(name);
    endfunction

    // 按树节点顺序配置寄存器并返回结果
    extern virtual task body();
    // 写 gate 的开关控制
    extern task config_reg_gate_node({{ settings.class_prefix }}gate gate_nd);
    // 写 mux 的选择控制
    extern task config_reg_mux_node({{ settings.class_prefix }}mux mux_nd);
    // 写 div 的复位、load 与分频比
    extern task config_reg_div_node({{ settings.class_prefix }}div div_nd);
    // 写 dto 的复位、bypass、load 与 step
    extern task config_reg_dto_node({{ settings.class_prefix }}dto dto_nd);
    // 按具体 PLL 类型分派配置流程
    extern task config_reg_pll_node({{ settings.class_prefix }}pll_base pll_nd, output bit configured);
    // 按 SC PLL 目标频率写配置
    extern task config_reg_pll_sc_node({{ settings.class_prefix }}pll_sc pll_sc_nd, output bit configured);
    // 按 DW PLL 目标频率写配置
    extern task config_reg_pll_dw_node({{ settings.class_prefix }}pll_dw pll_dw_nd, output bit configured);
    // 按 Inno PLL 目标频率写配置
    extern task config_reg_pll_inno_node({{ settings.class_prefix }}pll_inno pll_inno_nd, output bit configured);
    // 等待单个 PLL 锁定
    extern task wait_pll_lock_node({{ settings.class_prefix }}pll_base pll_nd);
    // 配置全部有效 PLL 并返回需要等待 lock 的节点
    extern task config_pll_nodes(
        {{ settings.class_prefix }}tree_base tree,
        output {{ settings.class_prefix }}pll_base plls[$]);
    // 等待已配置 PLL 进入 lock 状态
    extern task wait_pll_nodes({{ settings.class_prefix }}pll_base plls[$]);
    // 写入 div 与 dto 控制寄存器
    extern task config_div_dto_nodes({{ settings.class_prefix }}tree_base tree);
    // 按 open 状态写入 gate 控制寄存器
    extern task config_gate_nodes({{ settings.class_prefix }}tree_base tree, bit open);
    // 写入 mux 选择寄存器
    extern task config_mux_nodes({{ settings.class_prefix }}tree_base tree);
endclass

// 写 gate 的开关控制
task {{ settings.class_prefix }}config_reg_seq::config_reg_gate_node({{ settings.class_prefix }}gate gate_nd);
    if (!gate_nd.f_reg.is_bound())
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: gate %s f_reg not bound", gate_nd.get_name()))
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: gate %s open %0b", gate_nd.get_name(), gate_nd.open), UVM_MEDIUM)
    p_sequencer.tools.node.configure_gate(gate_nd.f_reg, gate_nd.open);
endtask

// 写 mux 的选择控制
task {{ settings.class_prefix }}config_reg_seq::config_reg_mux_node({{ settings.class_prefix }}mux mux_nd);
    if (!mux_nd.f_reg.is_bound())
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: mux %s f_reg not bound", mux_nd.get_name()))
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: mux %s sel %0d", mux_nd.get_name(), mux_nd.sel), UVM_MEDIUM)
    p_sequencer.tools.node.configure_mux(mux_nd.f_reg, mux_nd.sel);
endtask

// 写 div 的复位、load 与分频比
task {{ settings.class_prefix }}config_reg_seq::config_reg_div_node({{ settings.class_prefix }}div div_nd);
    if (!div_nd.f_load.is_bound() || !div_nd.f_div.is_bound()
{% if settings.reset_div_on_first_config %}
            || !div_nd.f_rst.is_bound()
{% endif %}
    )
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: div %s regs not bound", div_nd.get_name()))
{%- if settings.reset_div_on_first_config %}
    if (p_sequencer.tools.node.div_rst_was_released(div_nd.get_name())) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: div %s skip rst, ratio %0d",
                div_nd.get_name(), div_nd.ratio), UVM_MEDIUM)
        p_sequencer.tools.node.configure_div_ratio(
            div_nd.f_load, div_nd.f_div, div_nd.ratio);
    end else begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: div %s ratio %0d", div_nd.get_name(), div_nd.ratio), UVM_MEDIUM)
        p_sequencer.tools.node.configure_div(
            div_nd.f_rst, div_nd.f_load, div_nd.f_div, div_nd.ratio);
        p_sequencer.tools.node.note_div_rst_released(div_nd.get_name());
    end
{%- else %}
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: div %s ratio %0d", div_nd.get_name(), div_nd.ratio), UVM_MEDIUM)
    p_sequencer.tools.node.configure_div_ratio(
        div_nd.f_load, div_nd.f_div, div_nd.ratio);
{%- endif %}
endtask

// 写 dto 的复位、bypass、load 与 step
task {{ settings.class_prefix }}config_reg_seq::config_reg_dto_node({{ settings.class_prefix }}dto dto_nd);
    if (!dto_nd.f_load.is_bound() || !dto_nd.f_bypass.is_bound()
            || !dto_nd.f_step.is_bound()
