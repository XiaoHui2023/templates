`ifndef {{ (settings.class_prefix ~ "config_reg_seq") | upper }}
`define {{ (settings.class_prefix ~ "config_reg_seq") | upper }}

class {{ settings.class_prefix }}config_reg_seq extends uvm_sequence #(
    {{ settings.class_prefix }}config_reg_req,
    {{ settings.class_prefix }}config_reg_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}config_reg_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    function new(string name = "{{ settings.class_prefix }}config_reg_seq");
        super.new(name);
    endfunction

    // 调用 core config_reg 逻辑并返回 operation 结果
    extern virtual task body();
endclass

task {{ settings.class_prefix }}config_reg_seq::body();
    {{ settings.class_prefix }}config_reg_req rq;
    {{ settings.class_prefix }}config_reg_rsp rs;
    {{ settings.class_prefix }}config_reg_core cfg;

    if (req == null)
        `uvm_fatal("CLK_TREE", "config_reg: req is null")
    if (p_sequencer.tools == null)
        `uvm_fatal("CLK_TREE", "config_reg: sequencer tools not built")

    rq = req;
    if (rq.tree == null)
        `uvm_fatal("CLK_TREE", "config_reg: req.tree is null")

    rs = {{ settings.class_prefix }}config_reg_rsp::type_id::create("rsp");
    cfg = new(p_sequencer.tools);
    cfg.configure(rq.tree, rq.quiet);
    rs.ok = 1'b1;
    rsp = rs;
endtask

`endif
