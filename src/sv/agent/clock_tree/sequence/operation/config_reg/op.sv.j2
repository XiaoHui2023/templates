// 按 Inno PLL 目标频率写配置
task {{ settings.class_prefix }}config_reg_seq::config_reg_pll_inno_node({{ settings.class_prefix }}pll_inno pll_inno_nd, output bit configured);
    longint ref_hz;
    bit write_shared;

    configured = 1'b0;
    if (pll_inno_nd.source == null)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s has no source for ref frequency", pll_inno_nd.get_name()))
    if (pll_inno_nd.frequence <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s frequence must be positive", pll_inno_nd.get_name()))
    ref_hz = pll_inno_nd.source._resolved_freq;
    if (ref_hz <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s source %s frequence must be positive",
            pll_inno_nd.get_name(), pll_inno_nd.source.get_name()))
    if (!pll_inno_nd.f_pd.is_bound() || !pll_inno_nd.f_lock.is_bound()
            || !pll_inno_nd.f_refdiv.is_bound() || !pll_inno_nd.f_fbdiv.is_bound()
            || !pll_inno_nd.f_postdiv1.is_bound() || !pll_inno_nd.f_postdiv2.is_bound())
        return;
    write_shared = pll_inno_nd.group_id == "{{ inno_pll_primary_group }}";
    if (p_sequencer.tools.pll.freq_cfg_unchanged(
            pll_inno_nd.get_name(), ref_hz, pll_inno_nd.frequence) && !write_shared) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_inno %s skip unchanged out %0d Hz ref %0d Hz",
                pll_inno_nd.get_name(), pll_inno_nd.frequence, ref_hz), UVM_MEDIUM)
        return;
    end
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s out %0d Hz ref %s %0d Hz group %0d",
            pll_inno_nd.get_name(), pll_inno_nd.frequence, pll_inno_nd.source.get_name(),
            ref_hz, pll_inno_nd.group_id), UVM_MEDIUM)
    p_sequencer.tools.pll.configure_inno_from_hz(
        pll_inno_nd.f_pd, pll_inno_nd.f_refdiv, pll_inno_nd.f_fbdiv,
        pll_inno_nd.f_postdiv1, pll_inno_nd.f_postdiv2,
        pll_inno_nd.frequence, ref_hz, write_shared);
    p_sequencer.tools.pll.note_freq_cfg(
        pll_inno_nd.get_name(), ref_hz, pll_inno_nd.frequence);
    configured = 1'b1;
endtask

// 按具体 PLL 类型分派配置流程
task {{ settings.class_prefix }}config_reg_seq::config_reg_pll_node({{ settings.class_prefix }}pll_base pll_nd, output bit configured);
    longint ref_hz;
    int clkr;
    int clkf;
    int clkod;
    int bwadj;
    {{ settings.class_prefix }}pll_tci pll_tci_nd;
    {{ settings.class_prefix }}pll_sc pll_sc_nd;
    {{ settings.class_prefix }}pll_dw pll_dw_nd;
    {{ settings.class_prefix }}pll_inno pll_inno_nd;

    configured = 1'b0;
    if (!pll_nd._resolved_active) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s skip not valid", pll_nd.get_name()), UVM_MEDIUM)
        return;
    end
    if ($cast(pll_inno_nd, pll_nd)) begin
        config_reg_pll_inno_node(pll_inno_nd, configured);
        return;
    end
    if ($cast(pll_sc_nd, pll_nd)) begin
        config_reg_pll_sc_node(pll_sc_nd, configured);
        return;
    end
    if ($cast(pll_dw_nd, pll_nd)) begin
        config_reg_pll_dw_node(pll_dw_nd, configured);
        return;
    end
    if (pll_nd.source == null)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s has no source for ref frequency", pll_nd.get_name()))
    if (pll_nd.frequence <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s frequence must be positive", pll_nd.get_name()))
    ref_hz = pll_nd.source._resolved_freq;
    if (ref_hz <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s source %s frequence must be positive",
            pll_nd.get_name(), pll_nd.source.get_name()))
    if ($cast(pll_tci_nd, pll_nd)) begin
        if (!pll_tci_nd.f_bypass.is_bound() || !pll_tci_nd.f_pwrdn.is_bound()
                || !pll_tci_nd.f_reset.is_bound() || !pll_tci_nd.f_clkod.is_bound()
                || !pll_tci_nd.f_clkf.is_bound() || !pll_tci_nd.f_clkr.is_bound()
                || !pll_tci_nd.f_bwadj.is_bound())
            return;
        if (p_sequencer.tools.pll.freq_cfg_unchanged(
                pll_tci_nd.get_name(), ref_hz, pll_tci_nd.frequence)) begin
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "config_reg: pll_tci %s skip unchanged out %0d Hz ref %0d Hz",
                    pll_tci_nd.get_name(), pll_tci_nd.frequence, ref_hz), UVM_MEDIUM)
            return;
        end
        p_sequencer.tools.pll.tci_divisors(
            pll_tci_nd.frequence, ref_hz, clkr, clkf, clkod, bwadj);
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_tci %s out %0d Hz ref %s %0d Hz clkr %0d clkf %0d clkod %0d bwadj %0d",
                pll_tci_nd.get_name(), pll_tci_nd.frequence, pll_nd.source.get_name(), ref_hz,
                clkr, clkf, clkod, bwadj), UVM_MEDIUM)
        p_sequencer.tools.pll.configure_tci(
            pll_tci_nd.f_bypass, pll_tci_nd.f_pwrdn, pll_tci_nd.f_reset, pll_tci_nd.f_clkod,
            pll_tci_nd.f_clkf, pll_tci_nd.f_clkr, pll_tci_nd.f_bwadj,
            clkr, clkf, clkod, bwadj);
        p_sequencer.tools.pll.note_freq_cfg(
            pll_tci_nd.get_name(), ref_hz, pll_tci_nd.frequence);
        configured = 1'b1;
    end else
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s is not pll_tci, pll_sc, pll_dw, or pll_inno", pll_nd.get_name()))
endtask

// 等待单个 PLL 锁定
task {{ settings.class_prefix }}config_reg_seq::wait_pll_lock_node({{ settings.class_prefix }}pll_base pll_nd);
    {{ settings.class_prefix }}pll_tci pll_tci_nd;
    {{ settings.class_prefix }}pll_sc pll_sc_nd;
    {{ settings.class_prefix }}pll_dw pll_dw_nd;
    {{ settings.class_prefix }}pll_inno pll_inno_nd;

    if ($cast(pll_inno_nd, pll_nd)) begin
        if (pll_inno_nd.group_id != "{{ inno_pll_primary_group }}")
            return;
        if (!pll_inno_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        p_sequencer.tools.pll.wait_lock(pll_inno_nd.f_lock, {{ settings.pll_lock_timeout_us }}us);
    end else if ($cast(pll_tci_nd, pll_nd)) begin
        if (!pll_tci_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        p_sequencer.tools.pll.wait_lock(pll_tci_nd.f_lock, {{ settings.pll_lock_timeout_us }}us);
    end else if ($cast(pll_sc_nd, pll_nd)) begin
        if (!pll_sc_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        p_sequencer.tools.pll.wait_lock(pll_sc_nd.f_lock, {{ settings.pll_lock_timeout_us }}us);
    end else if ($cast(pll_dw_nd, pll_nd)) begin
        if (!pll_dw_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        p_sequencer.tools.pll.wait_lock(pll_dw_nd.f_lock, {{ settings.pll_lock_timeout_us }}us);
    end else
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s is not pll_tci, pll_sc, pll_dw, or pll_inno", pll_nd.get_name()))
    pll_nd.locked = 1'b1;
endtask

// 配置全部有效 PLL 并返回需要等待 lock 的节点
task {{ settings.class_prefix }}config_reg_seq::config_pll_nodes(
        {{ settings.class_prefix }}tree_base tree,
        output {{ settings.class_prefix }}pll_base plls[$]);
    {{ settings.class_prefix }}pll_base pll_nd;
    bit pll_cfg;

    plls.delete();
    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(pll_nd, tree.nodes[i])) begin
            {{ settings.class_prefix }}pll_inno pll_inno_nd;
            config_reg_pll_node(pll_nd, pll_cfg);
            if (pll_cfg) begin
                if ($cast(pll_inno_nd, pll_nd) && pll_inno_nd.group_id != "{{ inno_pll_primary_group }}")
                    continue;
                plls.push_back(pll_nd);
            end
        end
endtask

// 等待已配置 PLL 进入 lock 状态
task {{ settings.class_prefix }}config_reg_seq::wait_pll_nodes(
        {{ settings.class_prefix }}pll_base plls[$]);
    for (int i = 0; i < plls.size(); i++)
        wait_pll_lock_node(plls[i]);
endtask

// 写入 div 与 dto 控制寄存器
task {{ settings.class_prefix }}config_reg_seq::config_div_dto_nodes(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}div_div div_div_nd;
    {{ settings.class_prefix }}div_dto div_dto_nd;
    {{ settings.class_prefix }}div_cpu_gate cpu_gate_nd;

    for (int i = 0; i < tree.nodes.size(); i++) begin
        if ($cast(div_div_nd, tree.nodes[i])) begin
            if (div_div_nd.f_rst.is_bound() && div_div_nd.f_load.is_bound()
                    && div_div_nd.f_div.is_bound())
                config_reg_div_node(div_div_nd);
        end else if ($cast(div_dto_nd, tree.nodes[i])) begin
            if (div_dto_nd.f_rst.is_bound() && div_dto_nd.f_load.is_bound()
                    && div_dto_nd.f_bypass.is_bound()
                    && div_dto_nd.f_step.is_bound())
                config_reg_dto_node(div_dto_nd);
        end else if ($cast(cpu_gate_nd, tree.nodes[i])) begin
            if (cpu_gate_nd.group_id != "{{ cpu_gate_primary_group }}")
                continue;
            if (cpu_gate_nd.f_rst.is_bound() && cpu_gate_nd.f_div.is_bound())
                config_reg_cpu_gate_node(cpu_gate_nd);
        end
    end
endtask

// 写 inv 的反相/直通控制
task {{ settings.class_prefix }}config_reg_seq::config_reg_inv_node(
        {{ settings.class_prefix }}inv_base inv_nd);
    if (!inv_nd.f_reg.is_bound())
        return;
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: inv %s inverted %0b", inv_nd.get_name(), inv_nd.inverted),
            UVM_MEDIUM)
    p_sequencer.tools.node.configure_inv(inv_nd.f_reg, inv_nd.inverted);
endtask

// 写入 inv 控制寄存器
task {{ settings.class_prefix }}config_reg_seq::config_inv_nodes(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}inv_base inv_nd;

    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(inv_nd, tree.nodes[i]) && inv_nd.f_reg.is_bound())
            config_reg_inv_node(inv_nd);
endtask

// 按 open 状态写入 gate 控制寄存器
task {{ settings.class_prefix }}config_reg_seq::config_gate_nodes(
        {{ settings.class_prefix }}tree_base tree,
        bit open);
    {{ settings.class_prefix }}gate gate_nd;

    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(gate_nd, tree.nodes[i]) && gate_nd.f_reg.is_bound()
                && gate_nd._resolved_open == open)
            config_reg_gate_node(gate_nd);
endtask

// 写入 mux 选择寄存器
task {{ settings.class_prefix }}config_reg_seq::config_mux_nodes(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}mux mux_nd;

    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(mux_nd, tree.nodes[i]) && mux_nd.f_reg.is_bound())
            config_reg_mux_node(mux_nd);
endtask

// 切换 mux 前打开上游 gate 并等待时钟稳定
task {{ settings.class_prefix }}config_reg_seq::prep_mux_switch_gates(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}mux mux_nd;
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}node_base mux_switch[$];
    {{ settings.class_prefix }}node_base gates_open[$];
    {{ settings.class_prefix }}node_base peers[$];
    {{ settings.class_prefix }}node_base upstream_gates[$];
    longint slowest_hz;
    longint peer_hz;
    int wait_ns;
    int max_wait_ns;

    mux_switch.delete();
    for (int i = 0; i < tree.nodes.size(); i++) begin
        if (!$cast(mux_nd, tree.nodes[i]))
            continue;
        if (!mux_nd.f_reg.is_bound())
            continue;
        if (p_sequencer.tools.node.mux_sel_unchanged(
                mux_nd.get_name(), mux_nd._resolved_sel))
            continue;
        {{ settings.class_prefix }}append_unique_node(mux_switch, mux_nd);
    end
    if (mux_switch.size() == 0)
        return;

    gates_open.delete();
    foreach (mux_switch[i]) begin
        upstream_gates.delete();
        {{ settings.class_prefix }}get_gates_before(tree, mux_switch[i], upstream_gates);
        foreach (upstream_gates[j]) begin
            if (!$cast(gate_nd, upstream_gates[j]))
                continue;
            {{ settings.class_prefix }}append_unique_node(gates_open, gate_nd);
        end
    end

    foreach (gates_open[i]) begin
        if (!$cast(gate_nd, gates_open[i]))
            continue;
        if (!gate_nd.f_reg.is_bound())
            continue;
        config_reg_gate_node_reg(gate_nd, 1'b1);
    end

    max_wait_ns = 0;
    foreach (mux_switch[i]) begin
        slowest_hz = 0;
        {{ settings.class_prefix }}tree_upstream_peers(mux_switch[i], peers);
        foreach (peers[j]) begin
            peer_hz = peers[j]._resolved_freq;
            if (peer_hz <= 0)
                continue;
            if (slowest_hz == 0 || peer_hz < slowest_hz)
                slowest_hz = peer_hz;
        end
        if (slowest_hz > 0) begin
            wait_ns = (1_000_000_000 + slowest_hz - 1) / slowest_hz
                * {{ settings.mux_switch_wait_cycles }};
            if (wait_ns > max_wait_ns)
                max_wait_ns = wait_ns;
        end
    end

    if (max_wait_ns > 0) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: mux switch wait %0d ns over %0d mux(s)",
                max_wait_ns, mux_switch.size()), UVM_MEDIUM)
        #(max_wait_ns * 1ns);
    end
endtask

// 按树节点顺序配置寄存器并返回结果
task {{ settings.class_prefix }}config_reg_seq::body();
    {{ settings.class_prefix }}config_reg_req rq;
    {{ settings.class_prefix }}config_reg_rsp rs;
    {{ settings.class_prefix }}tree_base tree;
    {{ settings.class_prefix }}pll_base plls[$];

    if (req == null)
        `uvm_fatal("CLK_TREE", "config_reg: req is null")
    if (p_sequencer.tools == null)
        `uvm_fatal("CLK_TREE", "config_reg: sequencer tools not built")

    rq = req;
    tree = rq.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "config_reg: req.tree is null")
    if (!tree.randomize())
        `uvm_fatal("CLK_TREE", "config_reg: tree randomize failed")

    quiet = rq.quiet;
    rs = {{ settings.class_prefix }}config_reg_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    config_pll_nodes(tree, plls);
    wait_pll_nodes(plls);
    config_div_dto_nodes(tree);
    config_inv_nodes(tree);
    prep_mux_switch_gates(tree);
    config_gate_nodes(tree, 1'b1);
    config_mux_nodes(tree);
    config_gate_nodes(tree, 1'b0);

    rsp = rs;
endtask

`endif
{% endif %}
