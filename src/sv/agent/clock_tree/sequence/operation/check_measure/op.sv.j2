{% if any_node_path %}
`ifndef {{ (settings.class_prefix ~ "check_measure_seq") | upper }}
`define {{ (settings.class_prefix ~ "check_measure_seq") | upper }}

class {{ settings.class_prefix }}check_measure_seq extends uvm_sequence #(
    {{ settings.class_prefix }}check_measure_req,
    {{ settings.class_prefix }}check_measure_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}check_measure_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    function new(string name = "{{ settings.class_prefix }}check_measure_seq");
        super.new(name);
    endfunction

    extern virtual task body();
    extern function bit node_needs_measure(
        {{ settings.class_prefix }}node_base nd,
        bit check_freq,
        bit check_duty
    );
    extern function bit node_measure_ready(
        {{ settings.class_prefix }}node_base nd,
        bit check_freq,
        bit check_duty
    );
    extern task evaluate_one_node(
        {{ settings.class_prefix }}node_base nd,
        {{ settings.class_prefix }}check_measure_req rq,
        {{ settings.class_prefix }}check_measure_rsp rs
    );
endclass

function bit {{ settings.class_prefix }}check_measure_seq::node_needs_measure(
    {{ settings.class_prefix }}node_base nd,
    bit check_freq,
    bit check_duty
);
    if (nd == null || nd.vif == null)
        return 1'b0;
    if (check_duty)
        return 1'b1;
    if (!check_freq)
        return 1'b0;
    return nd.kind == "source" || nd.kind == "clk" || nd.kind == "pll";
endfunction

function bit {{ settings.class_prefix }}check_measure_seq::node_measure_ready(
    {{ settings.class_prefix }}node_base nd,
    bit check_freq,
    bit check_duty
);
    if (nd.vif.meas.timed_out)
        return 1'b1;
    if (check_freq && !nd.vif.meas.freq_stable)
        return 1'b0;
    if (check_duty && !nd.vif.meas.duty_stable)
        return 1'b0;
    return 1'b1;
endfunction

task {{ settings.class_prefix }}check_measure_seq::evaluate_one_node(
    {{ settings.class_prefix }}node_base nd,
    {{ settings.class_prefix }}check_measure_req rq,
    {{ settings.class_prefix }}check_measure_rsp rs
);
    bit expect_active;
    real expected_hz;
    real measured_hz;
    real rel_diff;

    if (nd.vif.meas.timed_out) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s timed out", nd.get_name()))
        rs.ok = 1'b0;
        return;
    end

    if (rq.check_freq
            && (nd.kind == "source" || nd.kind == "clk" || nd.kind == "pll")) begin
        if (!nd.vif.meas.freq_stable) begin
            `uvm_error("CLK_TREE", $sformatf(
                "check_measure: node %s frequency did not stabilize",
                nd.get_name()))
            rs.ok = 1'b0;
            return;
        end

        expect_active = nd._resolved_active;
        expected_hz = real'(nd._resolved_freq);

        if (!expect_active || expected_hz <= 0.0) begin
            if (nd.vif.meas.active) begin
                `uvm_error("CLK_TREE", $sformatf(
                    "check_measure: node %s expected inactive measured %0.2f Hz",
                    nd.get_name(), nd.vif.meas.freq_hz))
                rs.ok = 1'b0;
            end
            return;
        end

        if (!nd.vif.meas.active) begin
            `uvm_error("CLK_TREE", $sformatf(
                "check_measure: node %s expected %0.0f Hz no activity",
                nd.get_name(), expected_hz))
            rs.ok = 1'b0;
            return;
        end

        measured_hz = nd.vif.meas.freq_hz;
        rel_diff = (measured_hz > expected_hz) ?
            (measured_hz - expected_hz) / expected_hz :
            (expected_hz - measured_hz) / expected_hz;
        if (rel_diff > {{ settings.period_tolerance }}) begin
            `uvm_error("CLK_TREE", $sformatf(
                "check_measure: node %s freq expected %0.0f Hz measured %0.2f Hz rel %0.4f",
                nd.get_name(), expected_hz, measured_hz, rel_diff))
            rs.ok = 1'b0;
        end
    end

    if (rq.check_duty) begin
        if (!nd.vif.meas.duty_stable) begin
            `uvm_error("CLK_TREE", $sformatf(
                "check_measure: node %s duty did not stabilize",
                nd.get_name()))
            rs.ok = 1'b0;
            return;
        end

        if (!nd.vif.meas.duty_ok) begin
            `uvm_error("CLK_TREE", $sformatf(
                "check_measure: node %s duty %0.2f%% out of range [%0.2f,%0.2f]",
                nd.get_name(), nd.vif.meas.duty * 100.0,
                {{ settings.duty_min }}, {{ settings.duty_max }}))
            rs.ok = 1'b0;
            rs.failed_nodes.push_back(nd);
        end
    end
endtask

task {{ settings.class_prefix }}check_measure_seq::body();
    {{ settings.class_prefix }}check_measure_req rq;
    {{ settings.class_prefix }}check_measure_rsp rs;
    {{ settings.class_prefix }}node_base nodes_to_check[$];
    {{ settings.class_prefix }}node_base nd;
    int meas_min_freq_hz;
    int meas_timeout_ns;
    int elapsed_ns;
    int checked;
    int pending;
    bit node_done[];

    if (req == null)
        `uvm_fatal("CLK_TREE", "check_measure: req is null")

    rq = req;
    if (rq.tree == null)
        `uvm_fatal("CLK_TREE", "check_measure: tree is null")
    if (!rq.check_freq && !rq.check_duty)
        `uvm_fatal("CLK_TREE", "check_measure: check_freq and check_duty both disabled")

    meas_min_freq_hz = rq.min_freq_hz > 0 ? rq.min_freq_hz : {{ settings.min_freq_hz }};
    meas_timeout_ns = (1_000_000_000 + meas_min_freq_hz - 1) / meas_min_freq_hz
        * {{ settings.stable_cycles }} * 3;

    foreach (rq.tree.nodes[i]) begin
        nd = rq.tree.nodes[i];
        if (!node_needs_measure(nd, rq.check_freq, rq.check_duty))
            continue;
        nodes_to_check.push_back(nd);
    end

    checked = nodes_to_check.size();
    if (checked == 0)
        `uvm_fatal("CLK_TREE", "check_measure: no node with vif in tree")

    rs = {{ settings.class_prefix }}check_measure_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    node_done = new[nodes_to_check.size()];
    pending = nodes_to_check.size();

    foreach (nodes_to_check[i]) begin
        nd = nodes_to_check[i];
        if (!rq.quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "check_measure: node %s kind %s freq %0b duty %0b expected %0d Hz active %0b",
                nd.get_name(), nd.kind, rq.check_freq, rq.check_duty,
                nd._resolved_freq, nd._resolved_active), UVM_MEDIUM)
        if (rq.check_freq
                && (nd.kind == "source" || nd.kind == "clk" || nd.kind == "pll"))
            nd.vif.set_min_freq_hz(meas_min_freq_hz);
        nd.vif.start_measure();
    end

    elapsed_ns = 0;
    while (pending > 0 && elapsed_ns < meas_timeout_ns) begin
        foreach (nodes_to_check[i]) begin
            if (node_done[i])
                continue;
            if (!node_measure_ready(
                    nodes_to_check[i], rq.check_freq, rq.check_duty))
                continue;
            evaluate_one_node(nodes_to_check[i], rq, rs);
            nodes_to_check[i].vif.stop_measure();
            node_done[i] = 1'b1;
            pending--;
        end
        if (pending > 0) begin
            #1ns;
            elapsed_ns++;
        end
    end

    foreach (nodes_to_check[i]) begin
        if (node_done[i])
            continue;
        evaluate_one_node(nodes_to_check[i], rq, rs);
        nodes_to_check[i].vif.stop_measure();
    end

    if (rs.ok && !rq.quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "check_measure: passed, %0d node(s)", checked), UVM_LOW)

    rsp = rs;
endtask

`endif
{% endif %}
