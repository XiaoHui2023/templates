`ifndef {{ (settings.class_prefix ~ "check_measure_seq") | upper }}
`define {{ (settings.class_prefix ~ "check_measure_seq") | upper }}

class {{ settings.class_prefix }}check_measure_seq extends uvm_sequence #(
    {{ settings.class_prefix }}check_measure_req,
    {{ settings.class_prefix }}check_measure_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}check_measure_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    function new(string name = "{{ settings.class_prefix }}check_measure_seq");
        super.new(name);
    endfunction

    extern virtual task body();
    extern function bit node_needs_measure(
        {{ settings.class_prefix }}node_base nd,
        bit check_clk,
        bit check_cell,
        bit check_freq,
        bit check_duty
    );
    // 该节点是否被本次测量黑名单跳过
    extern function bit node_skipped(
        {{ settings.class_prefix }}node_base nd,
        {{ settings.class_prefix }}node_base skip_nodes[$]
    );
    // 该节点是否参与频率比对
    // nd — 节点
    // check_freq — 为真时按 kind 过滤
    extern function bit node_needs_freq_check(
        {{ settings.class_prefix }}node_base nd,
        bit check_clk,
        bit check_cell,
        bit check_freq
    );
    // 该节点是否参与占空比比对
    // nd - 节点
    // check_duty - 为真时检查节点 check_duty 打开的 clk 占空比
    extern function bit node_needs_duty_check(
        {{ settings.class_prefix }}node_base nd,
        bit check_clk,
        bit check_duty
    );
    // 活动阶段是否已结束
    // nd — 节点
    extern function bit node_activity_ready(
        {{ settings.class_prefix }}node_base nd
    );
    // 频率测量是否可进入比对
    // nd — 节点
    // check_freq — 为真时等待 activity_ok 或 inactive，再等待 freq_stable 或 timed_out
    extern function bit node_freq_measure_ready(
        {{ settings.class_prefix }}node_base nd,
        bit check_clk,
        bit check_cell,
        bit check_freq
    );
    // 占空比测量是否可进入比对
    // nd — 节点
    // check_duty — 为真时等待 activity_ok 后再等 duty_stable 或 timed_out
    extern function bit node_duty_measure_ready(
        {{ settings.class_prefix }}node_base nd,
        bit check_clk,
        bit check_duty
    );
    // Record a failed node once.
    extern function void record_failed_node(
        {{ settings.class_prefix }}check_measure_rsp rs,
        {{ settings.class_prefix }}node_base nd
    );
    // 比对单节点频率并在通过时打印
    // nd — 节点
    // rq — 请求
    // rs — 响应，失败时写 ok 与 failed_nodes
    extern task evaluate_node_freq(
        {{ settings.class_prefix }}node_base nd,
        {{ settings.class_prefix }}check_measure_req rq,
        {{ settings.class_prefix }}check_measure_rsp rs
    );
    // 比对单节点占空比并在通过时打印
    // nd — 节点
    // rq — 请求
    // rs — 响应，失败时写 ok 与 failed_nodes
    extern task evaluate_node_duty(
        {{ settings.class_prefix }}node_base nd,
        {{ settings.class_prefix }}check_measure_req rq,
        {{ settings.class_prefix }}check_measure_rsp rs
    );
    // 同一 vif 是否仍有未完成节点
    // vif — 测量接口
    // except_idx — 排除的下标
    // nodes — 待测节点队列
    // done — 各节点是否已完成
    extern function bit vif_has_other_pending(
        virtual {{ settings.class_prefix }}interface vif,
        int except_idx,
        {{ settings.class_prefix }}node_base nodes[],
        bit done[]
    );
    // 首次使用该 vif 时开启测量
    // nd — 节点
    // idx — nodes 下标
    // nodes — 待测节点队列
    // rq — 请求
    // meas_min_freq_hz — 最低频率，Hz
    extern function void start_measure_if_new_vif(
        {{ settings.class_prefix }}node_base nd,
        int idx,
        {{ settings.class_prefix }}node_base nodes[],
        {{ settings.class_prefix }}check_measure_req rq,
        int meas_min_freq_hz
    );
    // 强制重启该节点 vif 上的测量
    // nd — 节点
    // rq — 请求
    // meas_min_freq_hz — 最低频率，Hz
    extern function void restart_measure_on_vif(
        {{ settings.class_prefix }}node_base nd,
        {{ settings.class_prefix }}check_measure_req rq,
        int meas_min_freq_hz
    );
    // 无其它待测节点占用该 vif 时关闭测量
    // nd — 节点
    // idx — nodes 下标
    // nodes — 待测节点队列
    // done — 各节点是否已完成
    extern function void stop_measure_if_vif_idle(
        {{ settings.class_prefix }}node_base nd,
        int idx,
        {{ settings.class_prefix }}node_base nodes[],
        bit done[]
    );
    // 未完成节点当前等待阶段名
    // activity_done — 活动阶段是否结束
    // freq_done — 频率比对是否结束
    // duty_done — 占空比比对是否结束
    // check_freq — 为真时按 kind 过滤频率
    // check_duty — 为真时检查占空比
    extern function string node_measure_stage_label(
        {{ settings.class_prefix }}node_base nd,
        bit activity_done,
        bit freq_done,
        bit duty_done,
        bit check_clk,
        bit check_cell,
        bit check_freq,
        bit check_duty
    );
    // 打印未完成节点与测量接口状态
    // rq — 请求
    // nodes_to_check — 待测节点队列
    // node_done — 各节点是否已完成
    // activity_done — 各节点活动阶段是否结束
    // freq_done — 各节点频率比对是否结束
    // duty_done — 各节点占空比比对是否结束
    // pending — 未完成节点数
    // elapsed_ns — 已等待纳秒
    // meas_timeout_ns — 总超时纳秒
    extern function void log_measure_progress(
        {{ settings.class_prefix }}check_measure_req rq,
        {{ settings.class_prefix }}node_base nodes_to_check[$],
        bit node_done[],
        bit activity_done[],
        bit freq_done[],
        bit duty_done[],
        int pending,
        int elapsed_ns,
        int meas_timeout_ns
    );
endclass

function bit {{ settings.class_prefix }}check_measure_seq::node_skipped(
    {{ settings.class_prefix }}node_base nd,
    {{ settings.class_prefix }}node_base skip_nodes[$]
);
    foreach (skip_nodes[i])
        if (skip_nodes[i] == nd)
            return 1'b1;
    return 1'b0;
endfunction

function bit {{ settings.class_prefix }}check_measure_seq::node_needs_measure(
    {{ settings.class_prefix }}node_base nd,
    bit check_clk,
    bit check_cell,
    bit check_freq,
    bit check_duty
);
    {{ settings.class_prefix }}clk clk_nd;
    if (nd == null || nd.vif == null)
        return 1'b0;
    if (nd.kind == "clk" && !check_clk)
        return 1'b0;
    if (nd.kind == "cell" && !check_cell)
        return 1'b0;
    if ($cast(clk_nd, nd) && !clk_nd.check_duty)
        return check_freq;
    if (nd.kind == "cell")
        return check_freq;
    if (!nd._resolved_active || nd._resolved_freq <= 0)
        return (nd.kind == "clk" || nd.kind == "cell")
            && (check_freq || check_duty);
    if (check_duty)
        return nd.kind == "clk" || nd.kind == "cell";
    if (!check_freq)
        return 1'b0;
    return nd.kind == "clk";
endfunction

function bit {{ settings.class_prefix }}check_measure_seq::node_needs_freq_check(
    {{ settings.class_prefix }}node_base nd,
    bit check_clk,
    bit check_cell,
    bit check_freq
);
    if (nd == null || !check_freq)
        return 1'b0;
    if (nd.kind == "clk" && !check_clk)
        return 1'b0;
    if (nd.kind == "cell" && !check_cell)
        return 1'b0;
    if (!nd._resolved_active || nd._resolved_freq <= 0)
        return nd.kind == "clk" || nd.kind == "cell";
    return nd.kind == "clk" || nd.kind == "cell";
endfunction

function bit {{ settings.class_prefix }}check_measure_seq::node_needs_duty_check(
    {{ settings.class_prefix }}node_base nd,
    bit check_clk,
    bit check_duty
);
    {{ settings.class_prefix }}clk clk_nd;
    if (nd == null || !check_duty)
        return 1'b0;
    if (!check_clk)
        return 1'b0;
    if ($cast(clk_nd, nd) && !clk_nd.check_duty)
        return 1'b0;
    return nd.kind == "clk";
endfunction

function bit {{ settings.class_prefix }}check_measure_seq::node_activity_ready(
    {{ settings.class_prefix }}node_base nd
);
    if (nd == null || nd.vif == null)
        return 1'b0;
    if (nd.vif.meas.activity_ok || nd.vif.meas.inactive)
        return 1'b1;
    if (!nd.vif.meas.meas_en && !nd.vif.meas.activity_ok && !nd.vif.meas.inactive)
        return 1'b1;
    return 1'b0;
endfunction

function bit {{ settings.class_prefix }}check_measure_seq::node_freq_measure_ready(
    {{ settings.class_prefix }}node_base nd,
    bit check_clk,
    bit check_cell,
    bit check_freq
);
    if (!node_needs_freq_check(nd, check_clk, check_cell, check_freq))
        return 1'b1;
    if (nd.vif.meas.inactive)
        return 1'b1;
    if (!nd.vif.meas.activity_ok)
        return 1'b0;
    if (nd.vif.meas.freq_stable)
        return 1'b1;
    if (nd.vif.meas.timed_out)
        return 1'b1;
    if (!nd.vif.meas.meas_en && nd.vif.meas.activity_ok)
        return 1'b1;
    return 1'b0;
endfunction

function bit {{ settings.class_prefix }}check_measure_seq::node_duty_measure_ready(
    {{ settings.class_prefix }}node_base nd,
    bit check_clk,
    bit check_duty
);
    if (!node_needs_duty_check(nd, check_clk, check_duty))
        return 1'b1;
    if (nd.vif.meas.inactive)
        return 1'b1;
    if (!nd.vif.meas.activity_ok)
        return 1'b0;
    if (nd.vif.meas.duty_stable)
        return 1'b1;
    if (nd.vif.meas.timed_out)
        return 1'b1;
    if (!nd.vif.meas.meas_en && nd.vif.meas.activity_ok)
        return 1'b1;
    return 1'b0;
endfunction

function void {{ settings.class_prefix }}check_measure_seq::record_failed_node(
    {{ settings.class_prefix }}check_measure_rsp rs,
    {{ settings.class_prefix }}node_base nd
);
    if (rs == null || nd == null)
        return;
    foreach (rs.failed_nodes[i])
        if (rs.failed_nodes[i] == nd)
            return;
    rs.failed_nodes.push_back(nd);
endfunction

task {{ settings.class_prefix }}check_measure_seq::evaluate_node_freq(
    {{ settings.class_prefix }}node_base nd,
    {{ settings.class_prefix }}check_measure_req rq,
    {{ settings.class_prefix }}check_measure_rsp rs
);
    bit expect_active;
    longint expected_freq_hz;
    real expected_hz;
    real measured_hz;
    real rel_diff;

    if (!node_needs_freq_check(nd, rq.check_clk, rq.check_cell, rq.check_freq))
        return;

    expect_active = nd._resolved_active;
    expected_freq_hz = nd._resolved_freq;
    expected_hz = real'(expected_freq_hz);

    if (nd.vif.meas.inactive) begin
        if (!expect_active || expected_hz <= 0.0) begin
            `uvm_info("CLK_TREE", $sformatf(
                "check_measure: node %s freq passed", nd.get_name()), UVM_LOW)
            return;
        end
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s expected %0d Hz no activity",
            nd.get_name(), expected_freq_hz))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    if (!nd.vif.meas.activity_ok) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s activity not confirmed expected %0d Hz",
            nd.get_name(), expected_freq_hz))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    if (!expect_active || expected_freq_hz <= 0) begin
        if (nd.vif.meas.freq_hz > 0.0)
            `uvm_error("CLK_TREE", $sformatf(
                "check_measure: node %s expected inactive, measured active %0.2f Hz",
                nd.get_name(), nd.vif.meas.freq_hz))
        else
            `uvm_error("CLK_TREE", $sformatf(
                "check_measure: node %s expected inactive, measured active",
                nd.get_name()))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    if (nd.vif.meas.timed_out) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s frequency did not stabilize expected %0d Hz",
            nd.get_name(), expected_freq_hz))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    if (!nd.vif.meas.freq_stable) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s frequency did not stabilize expected %0d Hz",
            nd.get_name(), expected_freq_hz))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    measured_hz = nd.vif.meas.freq_hz;
    rel_diff = (measured_hz > expected_hz) ?
        (measured_hz - expected_hz) / expected_hz :
        (expected_hz - measured_hz) / expected_hz;
    if (rel_diff > {{ settings.period_tolerance }}) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s freq expected %0d Hz measured %0.2f Hz rel %0.4f",
            nd.get_name(), expected_freq_hz, measured_hz, rel_diff))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    `uvm_info("CLK_TREE", $sformatf(
        "check_measure: node %s freq passed", nd.get_name()), UVM_LOW)
endtask

task {{ settings.class_prefix }}check_measure_seq::evaluate_node_duty(
    {{ settings.class_prefix }}node_base nd,
    {{ settings.class_prefix }}check_measure_req rq,
    {{ settings.class_prefix }}check_measure_rsp rs
);
    if (!node_needs_duty_check(nd, rq.check_clk, rq.check_duty))
        return;

    if (nd.vif.meas.inactive) begin
        if (!nd._resolved_active) begin
            `uvm_info("CLK_TREE", $sformatf(
                "check_measure: node %s duty passed", nd.get_name()), UVM_LOW)
            return;
        end
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s expected activity no clock edges",
            nd.get_name()))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    if (!nd.vif.meas.activity_ok) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s activity not confirmed",
            nd.get_name()))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    if (!nd._resolved_active) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s expected inactive measured duty %0.3f%%",
            nd.get_name(), nd.vif.meas.duty * 100.0))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    if (nd.vif.meas.timed_out) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s duty did not stabilize",
            nd.get_name()))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    if (!nd.vif.meas.duty_stable) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s duty did not stabilize",
            nd.get_name()))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    if (!nd.vif.meas.duty_ok) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_measure: node %s duty %0.3f%% out of range [%0.2f,%0.2f] tol %0.3f",
            nd.get_name(), nd.vif.meas.duty * 100.0,
            {{ settings.duty_min }}, {{ settings.duty_max }},
            {{ settings.duty_tolerance_pct }}))
        rs.ok = 1'b0;
        record_failed_node(rs, nd);
        return;
    end

    `uvm_info("CLK_TREE", $sformatf(
        "check_measure: node %s duty passed", nd.get_name()), UVM_LOW)
endtask

function bit {{ settings.class_prefix }}check_measure_seq::vif_has_other_pending(
    virtual {{ settings.class_prefix }}interface vif,
    int except_idx,
    {{ settings.class_prefix }}node_base nodes[],
    bit done[]
);
    for (int j = 0; j < nodes.size(); j++) begin
        if (j == except_idx || done[j])
            continue;
        if (nodes[j].vif == vif)
            return 1'b1;
    end
    return 1'b0;
endfunction

function void {{ settings.class_prefix }}check_measure_seq::start_measure_if_new_vif(
    {{ settings.class_prefix }}node_base nd,
    int idx,
    {{ settings.class_prefix }}node_base nodes[],
    {{ settings.class_prefix }}check_measure_req rq,
    int meas_min_freq_hz
);
    for (int j = 0; j < idx; j++) begin
        if (nodes[j].vif == nd.vif)
            return;
    end
    if (node_needs_freq_check(nd, rq.check_clk, rq.check_cell, rq.check_freq))
        nd.vif.set_min_freq_hz(meas_min_freq_hz);
    nd.vif.start_measure();
endfunction

function void {{ settings.class_prefix }}check_measure_seq::restart_measure_on_vif(
    {{ settings.class_prefix }}node_base nd,
    {{ settings.class_prefix }}check_measure_req rq,
    int meas_min_freq_hz
);
    if (node_needs_freq_check(nd, rq.check_clk, rq.check_cell, rq.check_freq))
        nd.vif.set_min_freq_hz(meas_min_freq_hz);
    nd.vif.start_measure();
endfunction

function void {{ settings.class_prefix }}check_measure_seq::stop_measure_if_vif_idle(
    {{ settings.class_prefix }}node_base nd,
    int idx,
    {{ settings.class_prefix }}node_base nodes[],
    bit done[]
);
    if (vif_has_other_pending(nd.vif, idx, nodes, done))
        return;
    nd.vif.stop_measure();
endfunction

function string {{ settings.class_prefix }}check_measure_seq::node_measure_stage_label(
    {{ settings.class_prefix }}node_base nd,
    bit activity_done,
    bit freq_done,
    bit duty_done,
    bit check_clk,
    bit check_cell,
    bit check_freq,
    bit check_duty
);
    if (!activity_done)
        return "activity";
    if (!freq_done && node_needs_freq_check(nd, check_clk, check_cell, check_freq))
        return "freq";
    if (!duty_done && node_needs_duty_check(nd, check_clk, check_duty))
        return "duty";
    return "done";
endfunction

function void {{ settings.class_prefix }}check_measure_seq::log_measure_progress(
    {{ settings.class_prefix }}check_measure_req rq,
    {{ settings.class_prefix }}node_base nodes_to_check[$],
    bit node_done[],
    bit activity_done[],
    bit freq_done[],
    bit duty_done[],
    int pending,
    int elapsed_ns,
    int meas_timeout_ns
);
    {{ settings.class_prefix }}node_base nd;

    `uvm_info("CLK_TREE", $sformatf(
        "check_measure progress: pending %0d elapsed %0d ns / %0d ns",
        pending, elapsed_ns, meas_timeout_ns), UVM_LOW)
    foreach (nodes_to_check[i]) begin
        if (node_done[i])
            continue;
        nd = nodes_to_check[i];
        `uvm_info("CLK_TREE", $sformatf(
            "check_measure progress: node %s stage %s meas_en %0b activity_ok %0b inactive %0b freq_stable %0b duty_stable %0b timed_out %0b",
            nd.get_name(),
            node_measure_stage_label(nd, activity_done[i], freq_done[i],
                duty_done[i], rq.check_clk, rq.check_cell,
                rq.check_freq, rq.check_duty),
            nd.vif.meas.meas_en, nd.vif.meas.activity_ok, nd.vif.meas.inactive,
            nd.vif.meas.freq_stable, nd.vif.meas.duty_stable, nd.vif.meas.timed_out),
            UVM_LOW)
    end
endfunction

task {{ settings.class_prefix }}check_measure_seq::body();
    {{ settings.class_prefix }}check_measure_req rq;
    {{ settings.class_prefix }}check_measure_rsp rs;
    {{ settings.class_prefix }}node_base nodes_to_check[$];
    {{ settings.class_prefix }}node_base nd;
    int meas_min_freq_hz;
    int meas_period_ns;
    int meas_active_timeout_ns;
    int meas_stable_timeout_ns;
    int meas_timeout_ns;
    int elapsed_ns;
    int checked;
    int pending;
    int progress_interval_ns;
    int last_progress_ns;
    bit node_done[];
    bit activity_done[];
    bit freq_done[];
    bit duty_done[];
    bit meas_restart_done[];
    {{ settings.class_prefix }}node_base nodes_arr[];

    if (req == null)
        `uvm_fatal("CLK_TREE", "check_measure: req is null")

    rq = req;
    if (rq.tree == null)
        `uvm_fatal("CLK_TREE", "check_measure: tree is null")
    rq.tree.require_built("check_measure");
    if (!(rq.check_clk && (rq.check_freq || rq.check_duty))
            && !(rq.check_cell && rq.check_freq))
        `uvm_fatal("CLK_TREE", "check_measure: no enabled check target")

    meas_min_freq_hz = rq.min_freq_hz > 0 ? rq.min_freq_hz : {{ settings.min_freq_hz }};
    meas_period_ns = (1_000_000_000 + meas_min_freq_hz - 1) / meas_min_freq_hz;
    meas_active_timeout_ns = meas_period_ns * {{ settings.active_cycles }};
    // 与 measure_interface 一致，为频率基准周期保留一个周期。
    meas_stable_timeout_ns = meas_period_ns * ({{ settings.stable_cycles }} + 1);
    meas_timeout_ns = meas_active_timeout_ns + meas_stable_timeout_ns;
    progress_interval_ns = meas_period_ns * 20;
    if (progress_interval_ns < 10_000)
        progress_interval_ns = 10_000;

    foreach (rq.tree.nodes[i]) begin
        nd = rq.tree.nodes[i];
        if (node_skipped(nd, rq.skip_nodes))
            continue;
        if (!node_needs_measure(nd, rq.check_clk, rq.check_cell,
                rq.check_freq, rq.check_duty))
            continue;
        nodes_to_check.push_back(nd);
    end

    checked = nodes_to_check.size();
    if (checked == 0)
        `uvm_fatal("CLK_TREE", "check_measure: no node with vif in tree")

    nodes_arr = new[checked];
    foreach (nodes_to_check[i])
        nodes_arr[i] = nodes_to_check[i];

    rs = {{ settings.class_prefix }}check_measure_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    node_done = new[nodes_to_check.size()];
    activity_done = new[nodes_to_check.size()];
    freq_done = new[nodes_to_check.size()];
    duty_done = new[nodes_to_check.size()];
    meas_restart_done = new[nodes_to_check.size()];
    pending = nodes_to_check.size();
    last_progress_ns = -progress_interval_ns;

    if (rq.debug)
        `uvm_info("CLK_TREE", $sformatf(
            "check_measure progress: begin %0d node(s) timeout %0d ns min_freq %0d Hz",
            checked, meas_timeout_ns, meas_min_freq_hz), UVM_LOW)

    foreach (nodes_to_check[i]) begin
        nd = nodes_to_check[i];
        if (!node_needs_freq_check(nd, rq.check_clk, rq.check_cell, rq.check_freq))
            freq_done[i] = 1'b1;
        if (!node_needs_duty_check(nd, rq.check_clk, rq.check_duty))
            duty_done[i] = 1'b1;
        if (!rq.quiet || rq.debug)
            `uvm_info("CLK_TREE", $sformatf(
                "check_measure: node %s kind %s clk %0b cell %0b freq %0b duty %0b expected %0d Hz active %0b",
                nd.get_name(), nd.kind, rq.check_clk, rq.check_cell,
                rq.check_freq,
                node_needs_duty_check(nd, rq.check_clk, rq.check_duty),
                nd._resolved_freq, nd._resolved_active), UVM_MEDIUM)
        start_measure_if_new_vif(nd, i, nodes_arr, rq, meas_min_freq_hz);
    end

    elapsed_ns = 0;
    while (pending > 0 && elapsed_ns < meas_timeout_ns) begin
        if (rq.debug && (elapsed_ns - last_progress_ns >= progress_interval_ns)) begin
            log_measure_progress(rq, nodes_to_check, node_done, activity_done,
                freq_done, duty_done, pending, elapsed_ns, meas_timeout_ns);
            last_progress_ns = elapsed_ns;
        end
        foreach (nodes_to_check[i]) begin
            if (node_done[i])
                continue;
            nd = nodes_to_check[i];
            if (!meas_restart_done[i] && !nd.vif.meas.meas_en
                    && !nd.vif.meas.timed_out && !nd.vif.meas.inactive
                    && (nd.vif.meas.activity_ok || nd.vif.meas.freq_stable
                        || (node_needs_duty_check(nd, rq.check_clk, rq.check_duty)
                            && nd.vif.meas.duty_stable))
                    && (!freq_done[i] || !duty_done[i])) begin
                meas_restart_done[i] = 1'b1;
                `uvm_warning("CLK_TREE", $sformatf(
                    "check_measure: node %s meas_en low while pending; restart measure",
                    nd.get_name()))
                restart_measure_on_vif(nd, rq, meas_min_freq_hz);
                activity_done[i] = 1'b0;
            end
            if (!activity_done[i] && node_activity_ready(nd)) begin
                activity_done[i] = 1'b1;
                if (nd.vif.meas.inactive) begin
                    if (!freq_done[i]
                            && node_needs_freq_check(nd, rq.check_clk,
                                rq.check_cell, rq.check_freq)) begin
                        evaluate_node_freq(nd, rq, rs);
                        freq_done[i] = 1'b1;
                    end
                    if (!duty_done[i]
                            && node_needs_duty_check(nd, rq.check_clk,
                                rq.check_duty)) begin
                        evaluate_node_duty(nd, rq, rs);
                        duty_done[i] = 1'b1;
                    end
                end
                else if (nd.vif.meas.activity_ok) begin
                    if (!freq_done[i]
                            && node_needs_freq_check(nd, rq.check_clk,
                                rq.check_cell, rq.check_freq)
                            && (!nd._resolved_active
                                || nd._resolved_freq <= 0.0)) begin
                        evaluate_node_freq(nd, rq, rs);
                        freq_done[i] = 1'b1;
                    end
                    if (!duty_done[i]
                            && node_needs_duty_check(nd, rq.check_clk, rq.check_duty)
                            && !nd._resolved_active) begin
                        evaluate_node_duty(nd, rq, rs);
                        duty_done[i] = 1'b1;
                    end
                end
            end
            if (!activity_done[i])
                continue;
            if (!freq_done[i]
                    && node_freq_measure_ready(nd, rq.check_clk,
                        rq.check_cell, rq.check_freq)) begin
                evaluate_node_freq(nd, rq, rs);
                freq_done[i] = 1'b1;
            end
            if (!duty_done[i]
                    && node_duty_measure_ready(nd, rq.check_clk, rq.check_duty)) begin
                evaluate_node_duty(nd, rq, rs);
                duty_done[i] = 1'b1;
            end
            if (freq_done[i] && duty_done[i]) begin
                stop_measure_if_vif_idle(nd, i, nodes_arr, node_done);
                node_done[i] = 1'b1;
                pending--;
                if (rq.debug)
                    `uvm_info("CLK_TREE", $sformatf(
                        "check_measure progress: node %s done", nd.get_name()), UVM_LOW)
            end
        end
        if (pending > 0) begin
            #1ns;
            elapsed_ns++;
        end
    end

    if (rq.debug && pending > 0)
        log_measure_progress(rq, nodes_to_check, node_done, activity_done,
            freq_done, duty_done, pending, elapsed_ns, meas_timeout_ns);

    foreach (nodes_to_check[i]) begin
        if (node_done[i])
            continue;
        nd = nodes_to_check[i];
        if (!activity_done[i] && node_activity_ready(nd))
            activity_done[i] = 1'b1;
        if (!freq_done[i]) begin
            evaluate_node_freq(nd, rq, rs);
            freq_done[i] = 1'b1;
        end
        if (!duty_done[i]
                && node_needs_duty_check(nd, rq.check_clk, rq.check_duty)) begin
            evaluate_node_duty(nd, rq, rs);
            duty_done[i] = 1'b1;
        end
        stop_measure_if_vif_idle(nd, i, nodes_arr, node_done);
    end

    if (rs.ok && !rq.quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "check_measure: passed, %0d node(s)", checked), UVM_LOW)

    rsp = rs;
endtask

`endif
