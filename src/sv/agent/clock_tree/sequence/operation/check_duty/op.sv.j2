{% if any_node_path %}
`ifndef {{ (settings.class_prefix ~ "check_duty_seq") | upper }}
`define {{ (settings.class_prefix ~ "check_duty_seq") | upper }}

class {{ settings.class_prefix }}check_duty_seq extends uvm_sequence #(
    {{ settings.class_prefix }}check_duty_req,
    {{ settings.class_prefix }}check_duty_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}check_duty_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    function new(string name = "{{ settings.class_prefix }}check_duty_seq");
        super.new(name);
    endfunction

    extern virtual task body();
endclass

task {{ settings.class_prefix }}check_duty_seq::body();
    {{ settings.class_prefix }}check_duty_req rq;
    {{ settings.class_prefix }}check_duty_rsp rs;
    {{ settings.class_prefix }}node_base nodes_to_check[$];
    {{ settings.class_prefix }}node_base nd;
    int meas_timeout_ns;
    int elapsed_ns;
    int checked;
    bit all_stable;

    meas_timeout_ns = (1_000_000_000 + {{ settings.min_freq_hz }} - 1) / {{ settings.min_freq_hz }};

    if (req == null)
        `uvm_fatal("CLK_TREE", "check_duty: req is null")

    rq = req;
    if (rq.nodes.size() == 0)
        `uvm_fatal("CLK_TREE", "check_duty: req.nodes is empty")

    foreach (rq.nodes[i]) begin
        nd = rq.nodes[i];
        if (nd == null)
            continue;
        if (nd.vif == null)
            continue;
        nodes_to_check.push_back(nd);
    end

    checked = nodes_to_check.size();
    if (checked == 0)
        `uvm_fatal("CLK_TREE", "check_duty: no node with vif in req.nodes")

    rs = {{ settings.class_prefix }}check_duty_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    foreach (nodes_to_check[i]) begin
        nd = nodes_to_check[i];
        `uvm_info("CLK_TREE", $sformatf(
            "check_duty: node %s kind %s",
            nd.get_name(), nd.kind), UVM_MEDIUM)
        nd.vif.start_measure();
    end

    all_stable = 1'b0;
    elapsed_ns = 0;
    while (!all_stable && elapsed_ns < meas_timeout_ns) begin
        all_stable = 1'b1;
        foreach (nodes_to_check[i]) begin
            if (!nodes_to_check[i].vif.meas.stable)
                all_stable = 1'b0;
        end
        if (!all_stable) begin
            #1ns;
            elapsed_ns++;
        end
    end

    foreach (nodes_to_check[i])
        nodes_to_check[i].vif.stop_measure();

    foreach (nodes_to_check[i]) begin
        nd = nodes_to_check[i];

        if (!nd.vif.meas.stable) begin
            `uvm_error("CLK_TREE", $sformatf(
                "check_duty: node %s did not stabilize", nd.get_name()))
            rs.ok = 1'b0;
            continue;
        end

        if (!nd.vif.meas.duty_ok) begin
            if (nd.allow_bad_duty) begin
                `uvm_info("CLK_TREE", $sformatf(
                    "check_duty: node %s duty %0.4f out of range [%0.2f,%0.2f], allow_bad_duty",
                    nd.get_name(), nd.vif.meas.duty,
                    {{ settings.duty_min }}, {{ settings.duty_max }}), UVM_MEDIUM)
            end else begin
                `uvm_error("CLK_TREE", $sformatf(
                    "check_duty: node %s duty %0.4f out of range [%0.2f,%0.2f]",
                    nd.get_name(), nd.vif.meas.duty,
                    {{ settings.duty_min }}, {{ settings.duty_max }}))
                rs.ok = 1'b0;
                rs.failed_nodes.push_back(nd);
            end
        end
    end

    if (rs.ok)
        `uvm_info("CLK_TREE", $sformatf(
            "check_duty: passed, %0d node(s)", checked), UVM_LOW)

    rsp = rs;
endtask

`endif
{% endif %}
