{% if any_node_path %}
`ifndef {{ (settings.class_prefix ~ "set_clock_gen_seq") | upper }}
`define {{ (settings.class_prefix ~ "set_clock_gen_seq") | upper }}

class {{ settings.class_prefix }}set_clock_gen_seq extends uvm_sequence #(
    {{ settings.class_prefix }}set_clock_gen_req,
    {{ settings.class_prefix }}set_clock_gen_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}set_clock_gen_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    function new(string name = "{{ settings.class_prefix }}set_clock_gen_seq");
        super.new(name);
    endfunction

    extern virtual task body();
endclass

task {{ settings.class_prefix }}set_clock_gen_seq::body();
    {{ settings.class_prefix }}set_clock_gen_req rq;
    {{ settings.class_prefix }}set_clock_gen_rsp rs;

    if (req == null)
        `uvm_fatal("CLK_TREE", "set_clock_gen: req is null")

    rq = req;
    if (rq.node == null)
        `uvm_fatal("CLK_TREE", "set_clock_gen: req.node is null")
    if (rq.node.vif == null)
        `uvm_fatal("CLK_TREE", $sformatf("set_clock_gen: node %s vif is null", rq.node.get_name()))

    if (rq.gen_en) begin
        if (rq.node.frequence <= 0)
            `uvm_fatal("CLK_TREE", $sformatf(
                "set_clock_gen: node %s frequence must be positive, got %0d",
                rq.node.get_name(), rq.node.frequence))
        rq.node.vif.set_clock_gen(1'b1, real'(rq.node.frequence));
    end
    else
        rq.node.vif.set_clock_gen(1'b0, 0.0);

    rs = {{ settings.class_prefix }}set_clock_gen_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    `uvm_info("CLK_TREE", $sformatf(
        "set_clock_gen: node %s, gen_en %0b, frequence %0d Hz, ok %0b",
        rq.node.get_name(), rq.gen_en, rq.node.frequence, rs.ok), UVM_HIGH)

    rsp = rs;
endtask

`endif
{% endif %}
