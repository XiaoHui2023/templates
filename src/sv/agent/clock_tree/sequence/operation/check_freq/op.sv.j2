{% if any_node_path %}
`ifndef {{ (settings.class_prefix ~ "check_freq_seq") | upper }}
`define {{ (settings.class_prefix ~ "check_freq_seq") | upper }}

class {{ settings.class_prefix }}check_freq_seq extends uvm_sequence #(
    {{ settings.class_prefix }}check_freq_req,
    {{ settings.class_prefix }}check_freq_rsp
);
    `uvm_object_utils({{ settings.class_prefix }}check_freq_seq)
    `uvm_declare_p_sequencer({{ settings.class_prefix }}sequencer)

    function new(string name = "{{ settings.class_prefix }}check_freq_seq");
        super.new(name);
    endfunction

    extern virtual task body();
    extern task evaluate_one_node(
        {{ settings.class_prefix }}node_base nd,
        {{ settings.class_prefix }}check_freq_rsp rs
    );
endclass

task {{ settings.class_prefix }}check_freq_seq::evaluate_one_node(
    {{ settings.class_prefix }}node_base nd,
    {{ settings.class_prefix }}check_freq_rsp rs
);
    real expected_hz;
    real measured_hz;
    real rel_diff;

    if (!nd.vif.meas.stable) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_freq: node %s did not stabilize", nd.get_name()))
        rs.ok = 1'b0;
        return;
    end

    expected_hz = real'(nd.frequence);
    measured_hz = nd.vif.meas.freq_hz;
    if (expected_hz <= 0.0) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_freq: node %s frequence must be positive", nd.get_name()))
        rs.ok = 1'b0;
        return;
    end

    rel_diff = (measured_hz > expected_hz) ?
        (measured_hz - expected_hz) / expected_hz :
        (expected_hz - measured_hz) / expected_hz;
    if (rel_diff > {{ settings.period_tolerance }}) begin
        `uvm_error("CLK_TREE", $sformatf(
            "check_freq: node %s freq expected %0.0f Hz measured %0.2f Hz rel %0.4f",
            nd.get_name(), expected_hz, measured_hz, rel_diff))
        rs.ok = 1'b0;
    end
endtask

task {{ settings.class_prefix }}check_freq_seq::body();
    {{ settings.class_prefix }}check_freq_req rq;
    {{ settings.class_prefix }}check_freq_rsp rs;
    {{ settings.class_prefix }}node_base nodes_to_check[$];
    {{ settings.class_prefix }}node_base nd;
    int meas_timeout_ns;
    int elapsed_ns;
    int checked;
    bit all_stable;

    meas_timeout_ns = (1_000_000_000 + {{ settings.min_freq_hz }} - 1) / {{ settings.min_freq_hz }};

    if (req == null)
        `uvm_fatal("CLK_TREE", "check_freq: req is null")

    rq = req;
    if (rq.nodes.size() == 0)
        `uvm_fatal("CLK_TREE", "check_freq: req.nodes is empty")

    foreach (rq.nodes[i]) begin
        nd = rq.nodes[i];
        if (nd == null)
            continue;
        if (nd.kind != "source" && nd.kind != "clk" && nd.kind != "pll")
            continue;
        if (nd.vif == null)
            continue;
        nodes_to_check.push_back(nd);
    end

    checked = nodes_to_check.size();
    if (checked == 0)
        `uvm_fatal("CLK_TREE",
            "check_freq: no source, clk, or pll node with vif in req.nodes")

    rs = {{ settings.class_prefix }}check_freq_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    foreach (nodes_to_check[i]) begin
        nd = nodes_to_check[i];
        `uvm_info("CLK_TREE", $sformatf(
            "check_freq: node %s kind %s expected %0d Hz",
            nd.get_name(), nd.kind, nd.frequence), UVM_MEDIUM)
        nd.vif.start_measure();
    end

    all_stable = 1'b0;
    elapsed_ns = 0;
    while (!all_stable && elapsed_ns < meas_timeout_ns) begin
        all_stable = 1'b1;
        foreach (nodes_to_check[i]) begin
            if (!nodes_to_check[i].vif.meas.stable)
                all_stable = 1'b0;
        end
        if (!all_stable) begin
            #1ns;
            elapsed_ns++;
        end
    end

    foreach (nodes_to_check[i])
        nodes_to_check[i].vif.stop_measure();

    foreach (nodes_to_check[i])
        evaluate_one_node(nodes_to_check[i], rs);

    if (rs.ok)
        `uvm_info("CLK_TREE", $sformatf(
            "check_freq: passed, %0d node(s)", checked), UVM_LOW)

    rsp = rs;
endtask

`endif
{% endif %}
