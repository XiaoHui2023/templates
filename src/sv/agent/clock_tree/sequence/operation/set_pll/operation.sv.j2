`ifndef {{ (class_prefix ~ "set_pll_seq") | upper }}
`define {{ (class_prefix ~ "set_pll_seq") | upper }}

class {{ class_prefix }}set_pll_seq extends uvm_sequence #(
    {{ class_prefix }}set_pll_req,
    {{ class_prefix }}set_pll_rsp
);
    `uvm_object_utils({{ class_prefix }}set_pll_seq)
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    function new(string name = "{{ class_prefix }}set_pll_seq");
        super.new(name);
    endfunction

    extern virtual task body();
endclass

task {{ class_prefix }}set_pll_seq::body();
    {{ class_prefix }}set_pll_req rq;
    {{ class_prefix }}set_pll_rsp rs;

    if (req == null)
        `uvm_fatal("CLK_TREE", "set_pll: req is null")

    rq = req;
    if (rq.node == null)
        `uvm_fatal("CLK_TREE", "set_pll: req.node is null")

    rs = {{ class_prefix }}set_pll_rsp::type_id::create("rsp");
    rs.ok = 1'b1;

    `uvm_info("CLK_TREE", $sformatf(
        "set_pll: node %s, pll_kind %s, frequence %0d Hz, ok %0b",
        rq.node.get_name(), rq.node.pll_kind.name(), rq.node.frequence, rs.ok), UVM_HIGH)

    rsp = rs;
endtask

`endif
