{% if any_node_path %}
`ifndef {{ (class_prefix ~ "check_pll_seq") | upper }}
`define {{ (class_prefix ~ "check_pll_seq") | upper }}

class {{ class_prefix }}check_pll_seq extends uvm_sequence #(
    {{ class_prefix }}check_pll_req,
    {{ class_prefix }}check_pll_rsp
);
    `uvm_object_utils({{ class_prefix }}check_pll_seq)
    `uvm_declare_p_sequencer({{ class_prefix }}sequencer)

    function new(string name = "{{ class_prefix }}check_pll_seq");
        super.new(name);
    endfunction

    extern virtual task body();
endclass

task {{ class_prefix }}check_pll_seq::body();
    {{ class_prefix }}check_pll_req rq;
    {{ class_prefix }}check_pll_rsp rs;
    {{ class_prefix }}base_pll pll_nd;
    int meas_timeout_ns;
    int elapsed_ns;
    real expected_hz;
    real measured_hz;
    real rel_diff;
    int checked;

    meas_timeout_ns = (1_000_000_000 + {{ min_freq_hz }} - 1) / {{ min_freq_hz }};

    if (req == null)
        `uvm_fatal("CLK_TREE", "check_pll: req is null")

    rq = req;
    if (rq.nodes.size() == 0)
        `uvm_fatal("CLK_TREE", "check_pll: req.nodes is empty")

    rs = {{ class_prefix }}check_pll_rsp::type_id::create("rsp");
    rs.ok = 1'b1;
    checked = 0;

    foreach (rq.nodes[i]) begin
        if (!$cast(pll_nd, rq.nodes[i]))
            continue;
        if (pll_nd.vif == null)
            continue;

        checked++;
        pll_nd.vif.set_measure_en(1'b1);
        elapsed_ns = 0;
        while (!pll_nd.vif.meas.stable && elapsed_ns < meas_timeout_ns) begin
            #1ns;
            elapsed_ns++;
        end
        pll_nd.vif.set_measure_en(1'b0);

        if (!pll_nd.vif.meas.stable) begin
            `uvm_error("CLK_TREE", $sformatf(
                "check_pll: node %s did not stabilize", pll_nd.get_name()))
            rs.ok = 1'b0;
            continue;
        end

        expected_hz = real'(pll_nd.frequence);
        measured_hz = pll_nd.vif.meas.freq_hz;
        if (expected_hz <= 0.0) begin
            `uvm_error("CLK_TREE", $sformatf(
                "check_pll: node %s frequence must be positive", pll_nd.get_name()))
            rs.ok = 1'b0;
            continue;
        end

        rel_diff = (measured_hz > expected_hz) ?
            (measured_hz - expected_hz) / expected_hz :
            (expected_hz - measured_hz) / expected_hz;
        if (rel_diff > {{ period_tolerance }}) begin
            `uvm_error("CLK_TREE", $sformatf(
                "check_pll: node %s freq expected %0.0f Hz measured %0.2f Hz rel %0.4f",
                pll_nd.get_name(), expected_hz, measured_hz, rel_diff))
            rs.ok = 1'b0;
        end
    end

    if (checked == 0)
        `uvm_fatal("CLK_TREE", "check_pll: no pll node with vif in req.nodes")

    if (rs.ok)
        `uvm_info("CLK_TREE", $sformatf(
            "check_pll: passed, %0d pll node(s)", checked), UVM_LOW)

    rsp = rs;
endtask

`endif
{% endif %}
