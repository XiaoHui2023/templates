{
  "version": 1,
  "requirements": [
    {"id": "clock-tree-render", "scenarios": ["success", "boundary", "failure"]},
    {"id": "direct-config", "scenarios": ["success", "boundary", "failure"]}
  ],
  "combinations": [["clock-tree-render", "direct-config"]],
  "cases": [
    {
      "id": "full",
      "input": "examples/full.yaml",
      "execution": "local",
      "gate_id": "full",
      "expected": "pass",
      "covers": [
        {"requirement": "clock-tree-render", "scenario": "success"},
        {"requirement": "direct-config", "scenario": "success"}
      ]
    },
    {
      "id": "direct-config-boundary",
      "input": "examples/direct-config.yaml",
      "execution": "local",
      "gate_id": "direct-config-boundary",
      "expected": "pass",
      "covers": [
        {"requirement": "clock-tree-render", "scenario": "boundary"},
        {"requirement": "direct-config", "scenario": "boundary"}
      ]
    },
    {
      "id": "missing-clk-path",
      "input": "examples/missing-clk-path.yaml",
      "execution": "local",
      "gate_id": "missing-clk-path",
      "expected": "fail",
      "covers": [{"requirement": "clock-tree-render", "scenario": "failure"}]
    },
    {
      "id": "missing-regmodel",
      "input": "examples/missing-regmodel.yaml",
      "execution": "local",
      "gate_id": "missing-regmodel",
      "expected": "fail",
      "covers": [{"requirement": "direct-config", "scenario": "failure"}]
    }
  ]
}
