// 按 Inno PLL 目标频率写配置
task {{ settings.class_prefix }}config_reg_core::config_reg_pll_inno_node({{ settings.class_prefix }}pll_inno pll_inno_nd, output bit configured);
    longint ref_hz;
    bit write_shared;
    bit active;
    bit reg_match;

    configured = 1'b0;
    active = pll_inno_nd._resolved_active;
    if (active && pll_inno_nd.source == null)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s has no source for ref frequency", pll_inno_nd.get_name()))
    if (active && pll_inno_nd.frequence <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s frequence must be positive", pll_inno_nd.get_name()))
    ref_hz = active ? pll_inno_nd.source._resolved_freq : 0;
    if (active && ref_hz <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s source %s frequence must be positive",
            pll_inno_nd.get_name(), pll_inno_nd.source.get_name()))
    if (!pll_inno_nd.f_pd.is_bound() || !pll_inno_nd.f_lock.is_bound()
            || !pll_inno_nd.f_refdiv.is_bound() || !pll_inno_nd.f_fbdiv.is_bound()
            || !pll_inno_nd.f_postdiv1.is_bound() || !pll_inno_nd.f_postdiv2.is_bound())
        return;
    write_shared = pll_inno_nd.group_id == "{{ inno_pll_primary_group }}";
    tools.pll.inno_regs_match_target(
        pll_inno_nd.f_pd, pll_inno_nd.f_refdiv, pll_inno_nd.f_fbdiv,
        pll_inno_nd.f_postdiv1, pll_inno_nd.f_postdiv2,
        pll_inno_nd.frequence, ref_hz, write_shared, active, reg_match);
    if (reg_match) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_inno %s skip reg match out %0d Hz ref %0d Hz",
                pll_inno_nd.get_name(), pll_inno_nd.frequence, ref_hz), UVM_MEDIUM)
        return;
    end
    if (!active) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_inno %s active 0", pll_inno_nd.get_name()), UVM_MEDIUM)
        tools.pll.configure_inno_from_hz(
            pll_inno_nd.f_pd, pll_inno_nd.f_refdiv, pll_inno_nd.f_fbdiv,
            pll_inno_nd.f_postdiv1, pll_inno_nd.f_postdiv2,
            active, pll_inno_nd.frequence, ref_hz, write_shared);
        return;
    end
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s out %0d Hz ref %s %0d Hz group %0d",
            pll_inno_nd.get_name(), pll_inno_nd.frequence, pll_inno_nd.source.get_name(),
            ref_hz, pll_inno_nd.group_id), UVM_MEDIUM)
    tools.pll.configure_inno_from_hz(
        pll_inno_nd.f_pd, pll_inno_nd.f_refdiv, pll_inno_nd.f_fbdiv,
        pll_inno_nd.f_postdiv1, pll_inno_nd.f_postdiv2,
        active, pll_inno_nd.frequence, ref_hz, write_shared);
    configured = active;
endtask

// 按具体 PLL 类型分派配置流程
task {{ settings.class_prefix }}config_reg_core::config_reg_pll_node({{ settings.class_prefix }}pll_base pll_nd, output bit configured);
    longint ref_hz;
    int clkr;
    int clkf;
    int clkod;
    int bwadj;
    {{ settings.class_prefix }}pll_tci pll_tci_nd;
    {{ settings.class_prefix }}pll_sc pll_sc_nd;
    {{ settings.class_prefix }}pll_dw pll_dw_nd;
    {{ settings.class_prefix }}pll_inno pll_inno_nd;

    configured = 1'b0;
    if (!pll_nd._resolved_active && pll_nd.enabled != 0) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s skip not valid", pll_nd.get_name()), UVM_MEDIUM)
        return;
    end
    if ($cast(pll_inno_nd, pll_nd)) begin
        config_reg_pll_inno_node(pll_inno_nd, configured);
        return;
    end
    if ($cast(pll_sc_nd, pll_nd)) begin
        config_reg_pll_sc_node(pll_sc_nd, configured);
        return;
    end
    if ($cast(pll_dw_nd, pll_nd)) begin
        config_reg_pll_dw_node(pll_dw_nd, configured);
        return;
    end
    if (pll_nd._resolved_active && pll_nd.source == null)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s has no source for ref frequency", pll_nd.get_name()))
    if (pll_nd._resolved_active && pll_nd.frequence <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s frequence must be positive", pll_nd.get_name()))
    ref_hz = pll_nd._resolved_active ? pll_nd.source._resolved_freq : 0;
    if (pll_nd._resolved_active && ref_hz <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s source %s frequence must be positive",
            pll_nd.get_name(), pll_nd.source.get_name()))
    if ($cast(pll_tci_nd, pll_nd)) begin
        bit reg_match;
        if (!pll_tci_nd.f_bypass.is_bound() || !pll_tci_nd.f_pwrdn.is_bound()
                || !pll_tci_nd.f_reset.is_bound() || !pll_tci_nd.f_clkod.is_bound()
                || !pll_tci_nd.f_clkf.is_bound() || !pll_tci_nd.f_clkr.is_bound()
                || !pll_tci_nd.f_bwadj.is_bound())
            return;
        tools.pll.tci_regs_match_target(
            pll_tci_nd.f_bypass, pll_tci_nd.f_pwrdn, pll_tci_nd.f_reset, pll_tci_nd.f_clkod,
            pll_tci_nd.f_clkf, pll_tci_nd.f_clkr, pll_tci_nd.f_bwadj,
            pll_tci_nd.frequence, ref_hz, pll_nd._resolved_active, reg_match);
        if (reg_match) begin
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "config_reg: pll_tci %s skip reg match out %0d Hz ref %0d Hz",
                    pll_tci_nd.get_name(), pll_tci_nd.frequence, ref_hz), UVM_MEDIUM)
            return;
        end
        if (!pll_nd._resolved_active) begin
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "config_reg: pll_tci %s active 0", pll_tci_nd.get_name()), UVM_MEDIUM)
            tools.pll.configure_tci(
                pll_tci_nd.f_bypass, pll_tci_nd.f_pwrdn, pll_tci_nd.f_reset,
                pll_tci_nd.f_clkod, pll_tci_nd.f_clkf, pll_tci_nd.f_clkr,
                pll_tci_nd.f_bwadj, 1'b0, 1, 1, 1, 1);
            return;
        end
        tools.pll.tci_divisors(
            pll_tci_nd.frequence, ref_hz, clkr, clkf, clkod, bwadj);
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_tci %s out %0d Hz ref %s %0d Hz clkr %0d clkf %0d clkod %0d bwadj %0d",
                pll_tci_nd.get_name(), pll_tci_nd.frequence, pll_nd.source.get_name(), ref_hz,
                clkr, clkf, clkod, bwadj), UVM_MEDIUM)
        tools.pll.configure_tci(
            pll_tci_nd.f_bypass, pll_tci_nd.f_pwrdn, pll_tci_nd.f_reset, pll_tci_nd.f_clkod,
            pll_tci_nd.f_clkf, pll_tci_nd.f_clkr, pll_tci_nd.f_bwadj,
            pll_nd._resolved_active, clkr, clkf, clkod, bwadj);
        configured = pll_nd._resolved_active;
    end else
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s is not pll_tci, pll_sc, pll_dw, or pll_inno", pll_nd.get_name()))
endtask

// 等待单个 PLL 锁定
task {{ settings.class_prefix }}config_reg_core::wait_pll_lock_node({{ settings.class_prefix }}pll_base pll_nd);
    {{ settings.class_prefix }}pll_tci pll_tci_nd;
    {{ settings.class_prefix }}pll_sc pll_sc_nd;
    {{ settings.class_prefix }}pll_dw pll_dw_nd;
    {{ settings.class_prefix }}pll_inno pll_inno_nd;

    if ($cast(pll_inno_nd, pll_nd)) begin
        if (pll_inno_nd.group_id != "{{ inno_pll_primary_group }}")
            return;
        if (!pll_inno_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        tools.pll.wait_lock(pll_inno_nd.f_lock, {{ settings.pll_lock_timeout_us }}us);
    end else if ($cast(pll_tci_nd, pll_nd)) begin
        if (!pll_tci_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        tools.pll.wait_lock(pll_tci_nd.f_lock, {{ settings.pll_lock_timeout_us }}us);
    end else if ($cast(pll_sc_nd, pll_nd)) begin
        if (!pll_sc_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        tools.pll.wait_lock(pll_sc_nd.f_lock, {{ settings.pll_lock_timeout_us }}us);
    end else if ($cast(pll_dw_nd, pll_nd)) begin
        if (!pll_dw_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        tools.pll.wait_lock(pll_dw_nd.f_lock, {{ settings.pll_lock_timeout_us }}us);
    end else
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s is not pll_tci, pll_sc, pll_dw, or pll_inno", pll_nd.get_name()))
    pll_nd.locked = 1'b1;
endtask

// 配置全部有效 PLL 并返回需要等待 lock 的节点
task {{ settings.class_prefix }}config_reg_core::config_pll_nodes(
        {{ settings.class_prefix }}tree_base tree,
        output {{ settings.class_prefix }}pll_base plls[$]);
    {{ settings.class_prefix }}pll_base pll_nd;
    bit pll_cfg;

    plls.delete();
    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(pll_nd, tree.nodes[i])) begin
            {{ settings.class_prefix }}pll_inno pll_inno_nd;
            config_reg_pll_node(pll_nd, pll_cfg);
            if (pll_cfg) begin
                if ($cast(pll_inno_nd, pll_nd) && pll_inno_nd.group_id != "{{ inno_pll_primary_group }}")
                    continue;
                plls.push_back(pll_nd);
            end
        end
endtask

// 等待已配置 PLL 进入 lock 状态
task {{ settings.class_prefix }}config_reg_core::wait_pll_nodes(
        {{ settings.class_prefix }}pll_base plls[$]);
    for (int i = 0; i < plls.size(); i++)
        wait_pll_lock_node(plls[i]);
endtask

// 打印无下游 clk 的无效控制器件
task {{ settings.class_prefix }}config_reg_core::report_invalid_control_nodes(
        {{ settings.class_prefix }}tree_base tree);
    if (quiet || tree == null)
        return;
    for (int i = 0; i < tree.nodes.size(); i++) begin
        if (tree.nodes[i] == null)
            continue;
        if (!(tree.nodes[i].kind == "gate" || tree.nodes[i].kind == "mux"
                || tree.nodes[i].kind == "div"))
            continue;
        if ({{ settings.class_prefix }}control_node_is_valid(tree, tree.nodes[i]))
            continue;
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: %s %s invalid",
            tree.nodes[i].kind, tree.nodes[i].get_name()), UVM_MEDIUM)
    end
endtask

// 写入 div 与 dto 控制寄存器
task {{ settings.class_prefix }}config_reg_core::config_div_dto_nodes(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}div_div div_div_nd;
    {{ settings.class_prefix }}div_dto div_dto_nd;

    for (int i = 0; i < tree.nodes.size(); i++) begin
        if (!{{ settings.class_prefix }}control_node_is_valid(tree, tree.nodes[i]))
            continue;
        if ($cast(div_div_nd, tree.nodes[i])) begin
            if (div_div_nd.f_rst.is_bound() && div_div_nd.f_load.is_bound()
                    && div_div_nd.f_div.is_bound())
                config_reg_div_node(div_div_nd);
        end else if ($cast(div_dto_nd, tree.nodes[i])) begin
            if (div_dto_nd.f_rst.is_bound() && div_dto_nd.f_load.is_bound()
                    && div_dto_nd.f_bypass.is_bound()
                    && div_dto_nd.f_step.is_bound())
                config_reg_dto_node(div_dto_nd);
        end
    end
endtask

// 写 inv 的反相/直通控制
task {{ settings.class_prefix }}config_reg_core::config_reg_inv_node(
        {{ settings.class_prefix }}inv_base inv_nd);
    config_reg_inv_node_reg(inv_nd, inv_nd.inverted);
endtask

task {{ settings.class_prefix }}config_reg_core::config_reg_inv_node_reg(
        {{ settings.class_prefix }}inv_base inv_nd,
        bit reg_inverted);
    if (!inv_nd.f_reg.is_bound())
        return;
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: inv %s inverted %0b", inv_nd.get_name(), reg_inverted),
            UVM_MEDIUM)
    tools.node.configure_inv(inv_nd.f_reg, reg_inverted);
endtask

// 写入 inv 控制寄存器
task {{ settings.class_prefix }}config_reg_core::config_inv_nodes(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}inv_base inv_nd;

    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(inv_nd, tree.nodes[i]) && inv_nd.f_reg.is_bound())
            config_reg_inv_node(inv_nd);
endtask

// 按 open 状态写入 gate 控制寄存器
task {{ settings.class_prefix }}config_reg_core::config_gate_nodes(
        {{ settings.class_prefix }}tree_base tree,
        bit open);
    {{ settings.class_prefix }}gate gate_nd;

    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(gate_nd, tree.nodes[i]) && gate_nd.f_reg.is_bound()
                && {{ settings.class_prefix }}control_node_is_valid(tree, gate_nd)
                && gate_nd._resolved_open == open)
            config_reg_gate_node(gate_nd);
endtask

// 写入 mux 选择寄存器
task {{ settings.class_prefix }}config_reg_core::config_mux_nodes(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}mux mux_nd;

    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(mux_nd, tree.nodes[i]) && mux_nd.f_reg.is_bound()
                && {{ settings.class_prefix }}control_node_is_valid(tree, mux_nd))
            config_reg_mux_node(mux_nd);
endtask

// 按树节点顺序配置寄存器并返回结果
task {{ settings.class_prefix }}config_reg_core::configure(
        {{ settings.class_prefix }}tree_base tree,
        bit quiet);
    {{ settings.class_prefix }}pll_base plls[$];

    if (tree == null)
        `uvm_fatal("CLK_TREE", "config_reg: tree is null")
    tree.require_built("config_reg");
    if (!tree.randomize())
        `uvm_fatal("CLK_TREE", "config_reg: tree randomize failed")

    this.quiet = quiet;

    report_invalid_control_nodes(tree);
    config_pll_nodes(tree, plls);
    wait_pll_nodes(plls);
    config_div_dto_nodes(tree);
    config_inv_nodes(tree);
    config_gate_nodes(tree, 1'b1);
    config_mux_nodes(tree);
    config_gate_nodes(tree, 1'b0);
endtask

// 只应用低功耗所需的 gate 与 mux，不等待实际时钟。
task {{ settings.class_prefix }}config_reg_core::configure_low_power(
        {{ settings.class_prefix }}tree_base tree,
        bit quiet);
    if (tree == null)
        `uvm_fatal("CLK_TREE", "low_power config: tree is null")
    tree.require_built("low_power config");
    if (!tree.randomize())
        `uvm_fatal("CLK_TREE", "low_power config: tree randomize failed")

    this.quiet = quiet;
    report_invalid_control_nodes(tree);
    config_gate_nodes(tree, 1'b1);
    config_mux_nodes(tree);
    config_gate_nodes(tree, 1'b0);
endtask

`endif
