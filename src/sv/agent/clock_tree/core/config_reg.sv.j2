`ifndef {{ (settings.class_prefix ~ "config_reg_core") | upper }}
`define {{ (settings.class_prefix ~ "config_reg_core") | upper }}

class {{ settings.class_prefix }}config_reg_core extends {{ settings.class_prefix }}base_object;
    {{ settings.class_prefix }}core_tools tools;
    protected bit quiet;

    // 绑定寄存器工具并设置日志模式。
    function new(
            {{ settings.class_prefix }}core_tools core_tools_h,
            bit quiet = 1'b0);
        super.new("{{ settings.class_prefix }}config_reg_core");
        if (core_tools_h == null)
            `uvm_fatal("CLK_TREE", "config_reg_core: tools is null")
        tools = core_tools_h;
        this.quiet = quiet;
    endfunction

    // Run tree randomize and apply all register configuration.
    extern task configure({{ settings.class_prefix }}tree_base tree, bit quiet = 1'b0);
    // Apply only gate and mux states needed by low-power tests.
    extern task configure_low_power(
        {{ settings.class_prefix }}tree_base tree,
        bit quiet = 1'b0);
    // Configure gate open state.
    extern task config_reg_gate_node({{ settings.class_prefix }}gate gate_nd);
    // Configure gate register with a requested logical open value.
    // reg_open — logical open state before polarity conversion by node_cfg
    extern task config_reg_gate_node_reg(
        {{ settings.class_prefix }}gate gate_nd,
        bit reg_open);
    // Configure mux select.
    extern task config_reg_mux_node({{ settings.class_prefix }}mux mux_nd);
    // Write an explicit mux select without tree resolution.
    extern task config_reg_mux_node_reg(
        {{ settings.class_prefix }}mux mux_nd,
        int reg_sel);
    // Configure div reset, load and ratio.
    extern task config_reg_div_node({{ settings.class_prefix }}div_div div_nd);
    // Write an explicit div ratio without tree resolution.
    extern task config_reg_div_node_reg(
        {{ settings.class_prefix }}div_div div_nd,
        int reg_ratio);
    // Configure dto reset, bypass, load and step.
    extern task config_reg_dto_node({{ settings.class_prefix }}div_dto dto_nd);
    // Write an explicit dto ratio without tree resolution.
    extern task config_reg_dto_node_reg(
        {{ settings.class_prefix }}div_dto dto_nd,
        int reg_ratio);
    // Configure inv state.
    extern task config_reg_inv_node({{ settings.class_prefix }}inv_base inv_nd);
    // Write an explicit inv state without tree resolution.
    extern task config_reg_inv_node_reg(
        {{ settings.class_prefix }}inv_base inv_nd,
        bit reg_inverted);
    // Dispatch PLL configuration by concrete type.
    extern task config_reg_pll_node({{ settings.class_prefix }}pll_base pll_nd, output bit configured);
    // Configure SC PLL target.
    extern task config_reg_pll_sc_node({{ settings.class_prefix }}pll_sc pll_sc_nd, output bit configured);
    // Configure DW PLL target.
    extern task config_reg_pll_dw_node({{ settings.class_prefix }}pll_dw pll_dw_nd, output bit configured);
    // Configure Inno PLL target.
    extern task config_reg_pll_inno_node({{ settings.class_prefix }}pll_inno pll_inno_nd, output bit configured);
    // Wait for one PLL lock.
    extern task wait_pll_lock_node({{ settings.class_prefix }}pll_base pll_nd);
    // Configure valid PLL nodes and collect nodes that need lock wait.
    extern task config_pll_nodes(
        {{ settings.class_prefix }}tree_base tree,
        output {{ settings.class_prefix }}pll_base plls[$]);
    // Wait for configured PLL nodes.
    extern task wait_pll_nodes({{ settings.class_prefix }}pll_base plls[$]);
    // Report control nodes with no downstream clk.
    extern task report_invalid_control_nodes({{ settings.class_prefix }}tree_base tree);
    // Configure div and dto nodes.
    extern task config_div_dto_nodes({{ settings.class_prefix }}tree_base tree);
    // Configure inv nodes.
    extern task config_inv_nodes({{ settings.class_prefix }}tree_base tree);
    // Configure gate nodes matching the requested open state.
    extern task config_gate_nodes({{ settings.class_prefix }}tree_base tree, bit open);
    // Configure mux nodes.
    extern task config_mux_nodes({{ settings.class_prefix }}tree_base tree);
endclass

// 写 gate 的开关控制
task {{ settings.class_prefix }}config_reg_core::config_reg_gate_node({{ settings.class_prefix }}gate gate_nd);
    if (!gate_nd.f_reg.is_bound())
        return;
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: gate %s open %0b", gate_nd.get_name(), gate_nd._resolved_open), UVM_MEDIUM)
    tools.node.configure_gate(gate_nd.f_reg, gate_nd._resolved_open);
endtask

// 向寄存器写入指定 gate 开关
task {{ settings.class_prefix }}config_reg_core::config_reg_gate_node_reg(
        {{ settings.class_prefix }}gate gate_nd,
        bit reg_open);
    if (!gate_nd.f_reg.is_bound())
        return;
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: gate %s reg open %0b", gate_nd.get_name(), reg_open), UVM_MEDIUM)
    tools.node.configure_gate(gate_nd.f_reg, reg_open);
endtask

// 写 mux 的选择控制
task {{ settings.class_prefix }}config_reg_core::config_reg_mux_node({{ settings.class_prefix }}mux mux_nd);
    config_reg_mux_node_reg(mux_nd, mux_nd._resolved_sel);
endtask

task {{ settings.class_prefix }}config_reg_core::config_reg_mux_node_reg(
        {{ settings.class_prefix }}mux mux_nd,
        int reg_sel);
    bit sel_match;

    if (!mux_nd.f_reg.is_bound())
        return;
    tools.node.mux_sel_matches(
        mux_nd.f_reg, reg_sel, sel_match);
    if (sel_match) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: mux %s skip reg sel %0d",
                mux_nd.get_name(), reg_sel), UVM_MEDIUM)
        return;
    end
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: mux %s sel %0d", mux_nd.get_name(), reg_sel), UVM_MEDIUM)
    tools.node.configure_mux(mux_nd.f_reg, reg_sel);
endtask

// 写 div 的复位、load 与分频比
task {{ settings.class_prefix }}config_reg_core::config_reg_div_node({{ settings.class_prefix }}div_div div_nd);
    config_reg_div_node_reg(div_nd, div_nd._resolved_ratio);
endtask

task {{ settings.class_prefix }}config_reg_core::config_reg_div_node_reg(
        {{ settings.class_prefix }}div_div div_nd,
        int reg_ratio);
    bit ratio_match;
    bit rst_released;

    if (!div_nd.f_load.is_bound() || !div_nd.f_div.is_bound()
            || !div_nd.f_rst.is_bound())
        return;
    tools.node.div_regs_match_ratio(
        div_nd.f_rst, div_nd.f_div, reg_ratio, ratio_match);
    if (ratio_match) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: div %s skip reg ratio %0d",
                div_nd.get_name(), reg_ratio), UVM_MEDIUM)
        return;
    end
{%- if settings.should_reset_div %}
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: div %s ratio %0d reset pulse",
            div_nd.get_name(), reg_ratio), UVM_MEDIUM)
    tools.node.configure_div(
        div_nd.f_rst, div_nd.f_load, div_nd.f_div, reg_ratio);
{%- else %}
    tools.node.div_rst_released(div_nd.f_rst, rst_released);
    if (rst_released) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: div %s reg rst released, ratio %0d",
                div_nd.get_name(), reg_ratio), UVM_MEDIUM)
        tools.node.configure_div_ratio(
            div_nd.f_load, div_nd.f_div, reg_ratio);
    end else begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: div %s reg rst active, ratio %0d",
                div_nd.get_name(), reg_ratio), UVM_MEDIUM)
        tools.node.configure_div_direct(
            div_nd.f_rst, div_nd.f_load, div_nd.f_div, reg_ratio);
    end
{%- endif %}
endtask

// 写 dto 的复位、bypass、load 与 step
task {{ settings.class_prefix }}config_reg_core::config_reg_dto_node({{ settings.class_prefix }}div_dto dto_nd);
    config_reg_dto_node_reg(dto_nd, dto_nd._resolved_ratio);
endtask

task {{ settings.class_prefix }}config_reg_core::config_reg_dto_node_reg(
        {{ settings.class_prefix }}div_dto dto_nd,
        int reg_ratio);
    bit rst_released;

    if (!dto_nd.f_load.is_bound() || !dto_nd.f_bypass.is_bound()
            || !dto_nd.f_step.is_bound() || !dto_nd.f_rst.is_bound())
        return;
{%- if settings.should_reset_dto %}
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: dto %s ratio %0d reset pulse",
            dto_nd.get_name(), reg_ratio), UVM_MEDIUM)
    tools.node.configure_dto(
        dto_nd.f_rst, dto_nd.f_load, dto_nd.f_bypass, dto_nd.f_step, reg_ratio);
{%- else %}
    tools.node.dto_rst_released(dto_nd.f_rst, rst_released);
    if (rst_released) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: dto %s reg rst released, ratio %0d",
                dto_nd.get_name(), reg_ratio), UVM_MEDIUM)
        tools.node.configure_dto_ratio(
            dto_nd.f_load, dto_nd.f_bypass, dto_nd.f_step, reg_ratio);
    end else begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: dto %s reg rst active, ratio %0d",
                dto_nd.get_name(), reg_ratio), UVM_MEDIUM)
        tools.node.configure_dto_direct(
            dto_nd.f_rst, dto_nd.f_load, dto_nd.f_bypass, dto_nd.f_step, reg_ratio);
    end
{%- endif %}
endtask

// 按 SC PLL 目标频率写配置
task {{ settings.class_prefix }}config_reg_core::config_reg_pll_sc_node({{ settings.class_prefix }}pll_sc pll_sc_nd, output bit configured);
    longint ref_hz;
    bit active;
    bit reg_match;

    configured = 1'b0;
    active = pll_sc_nd._resolved_active;
    if (active && pll_sc_nd.source == null)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_sc %s has no source for ref frequency", pll_sc_nd.get_name()))
    if (active && pll_sc_nd.frequence <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_sc %s frequence must be positive", pll_sc_nd.get_name()))
    ref_hz = active ? pll_sc_nd.source._resolved_freq : 0;
    if (active && ref_hz <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_sc %s source %s frequence must be positive",
            pll_sc_nd.get_name(), pll_sc_nd.source.get_name()))
    if (!pll_sc_nd.f_vocpd.is_bound() || !pll_sc_nd.f_postdivpd.is_bound()
            || !pll_sc_nd.f_dsmpd.is_bound() || !pll_sc_nd.f_pd.is_bound()
            || !pll_sc_nd.f_bypass.is_bound() || !pll_sc_nd.f_refdiv.is_bound()
            || !pll_sc_nd.f_postdiv2.is_bound() || !pll_sc_nd.f_postdiv1.is_bound()
            || !pll_sc_nd.f_fbdiv.is_bound())
        return;
    tools.pll.sc_regs_match_target(
        pll_sc_nd.f_vocpd, pll_sc_nd.f_postdivpd, pll_sc_nd.f_dsmpd, pll_sc_nd.f_pd,
        pll_sc_nd.f_bypass, pll_sc_nd.f_refdiv, pll_sc_nd.f_postdiv2, pll_sc_nd.f_postdiv1,
        pll_sc_nd.f_fbdiv, pll_sc_nd.frequence, ref_hz, active, reg_match);
    if (reg_match) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_sc %s skip reg match out %0d Hz ref %0d Hz",
                pll_sc_nd.get_name(), pll_sc_nd.frequence, ref_hz), UVM_MEDIUM)
        return;
    end
    if (!active) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_sc %s active 0", pll_sc_nd.get_name()), UVM_MEDIUM)
        tools.pll.configure_sc_from_hz(
            pll_sc_nd.f_vocpd, pll_sc_nd.f_postdivpd, pll_sc_nd.f_dsmpd, pll_sc_nd.f_pd,
            pll_sc_nd.f_bypass, pll_sc_nd.f_refdiv, pll_sc_nd.f_postdiv2,
            pll_sc_nd.f_postdiv1, pll_sc_nd.f_fbdiv, active, pll_sc_nd.frequence, ref_hz);
        return;
    end
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: pll_sc %s out %0d Hz ref %s %0d Hz",
            pll_sc_nd.get_name(), pll_sc_nd.frequence, pll_sc_nd.source.get_name(), ref_hz),
            UVM_MEDIUM)
    tools.pll.configure_sc_from_hz(
        pll_sc_nd.f_vocpd, pll_sc_nd.f_postdivpd, pll_sc_nd.f_dsmpd, pll_sc_nd.f_pd,
        pll_sc_nd.f_bypass, pll_sc_nd.f_refdiv, pll_sc_nd.f_postdiv2, pll_sc_nd.f_postdiv1,
        pll_sc_nd.f_fbdiv, active, pll_sc_nd.frequence, ref_hz);
    configured = active;
endtask

