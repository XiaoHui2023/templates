{% if regs_enabled %}
`ifndef {{ (class_prefix ~ "core_tools") | upper }}
`define {{ (class_prefix ~ "core_tools") | upper }}

class {{ class_prefix }}core_tools;
    {{ class_prefix }}reg_rw rw;
    {{ class_prefix }}node_cfg node;
    {{ class_prefix }}pll_cfg pll;

    function new();
        rw = new;
        node = new(rw);
        pll = new(rw);
    endfunction
endclass

`endif
{% endif %}
