{% if regs_enabled %}
`ifndef {{ (settings.class_prefix ~ "reg_rw") | upper }}
`define {{ (settings.class_prefix ~ "reg_rw") | upper }}

class {{ settings.class_prefix }}reg_rw;
    extern function uvm_reg parent_reg({{ settings.class_prefix }}reg_bind rb);
    extern function int get({{ settings.class_prefix }}reg_bind rb);
    extern function void set({{ settings.class_prefix }}reg_bind rb, int value);
    extern task read_reg(uvm_reg r, output int rdata);
    extern task read({{ settings.class_prefix }}reg_bind rb, output int value);
    extern task write_reg(uvm_reg r);
    extern task write({{ settings.class_prefix }}reg_bind rb);
    extern task set_write({{ settings.class_prefix }}reg_bind rb, int value);
    extern task apply(ref {{ settings.class_prefix }}reg_bind binds[$], ref int vals[$]);
endclass

function uvm_reg {{ settings.class_prefix }}reg_rw::parent_reg({{ settings.class_prefix }}reg_bind rb);
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "parent_reg: field is null")
    return rb.field.get_register();
endfunction

function int {{ settings.class_prefix }}reg_rw::get({{ settings.class_prefix }}reg_bind rb);
    int full;
    int mask;
    int slice;
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "get: field is null")
    full = rb.field.get();
    if (rb.width == rb.field.get_n_bits() && rb.offset == 0)
        return full;
    mask = (1 << rb.width) - 1;
    slice = (full >> rb.offset) & mask;
    return slice;
endfunction

function void {{ settings.class_prefix }}reg_rw::set({{ settings.class_prefix }}reg_bind rb, int value);
    uvm_status_e status;
    int cur;
    int mask;
    int slice_mask;
    int newval;
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "set: field is null")
    slice_mask = (1 << rb.width) - 1;
    if (rb.offset == 0 && rb.width == rb.field.get_n_bits()) begin
        rb.field.set(value, status);
    end else begin
        cur = rb.field.get();
        mask = slice_mask << rb.offset;
        newval = (cur & ~mask) | ((value & slice_mask) << rb.offset);
        rb.field.set(newval, status);
    end
    if (status != UVM_IS_OK)
        `uvm_fatal("CLK_TREE", $sformatf(
            "set: %s set 0x%0h failed", rb.field.get_full_name(), value))
endfunction

task {{ settings.class_prefix }}reg_rw::read_reg(uvm_reg r, output int rdata);
    uvm_status_e status;
    if (r == null)
        `uvm_fatal("CLK_TREE", "read_reg: reg is null")
    r.read(status, rdata);
    if (status != UVM_IS_OK)
        `uvm_fatal("CLK_TREE", $sformatf(
            "read_reg: read %s failed", r.get_full_name()))
endtask

task {{ settings.class_prefix }}reg_rw::read({{ settings.class_prefix }}reg_bind rb, output int value);
    uvm_reg r;
    int reg_rdata;
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "read: field is null")
    r = parent_reg(rb);
    read_reg(r, reg_rdata);
    value = get(rb);
endtask

task {{ settings.class_prefix }}reg_rw::write_reg(uvm_reg r);
    uvm_status_e status;
    int wdata;
    if (r == null)
        `uvm_fatal("CLK_TREE", "write_reg: reg is null")
    wdata = r.get();
    r.write(status, wdata);
    if (status != UVM_IS_OK)
        `uvm_fatal("CLK_TREE", $sformatf(
            "write_reg: write %s 0x%0h failed", r.get_full_name(), wdata))
endtask

task {{ settings.class_prefix }}reg_rw::write({{ settings.class_prefix }}reg_bind rb);
    write_reg(parent_reg(rb));
endtask

task {{ settings.class_prefix }}reg_rw::set_write({{ settings.class_prefix }}reg_bind rb, int value);
    set(rb, value);
    write(rb);
endtask

task {{ settings.class_prefix }}reg_rw::apply(
        ref {{ settings.class_prefix }}reg_bind binds[$],
        ref int vals[$]);
    uvm_reg regs[$];
    if (binds.size() != vals.size())
        `uvm_fatal("CLK_TREE", $sformatf(
            "apply: binds size %0d != vals size %0d", binds.size(), vals.size()))
    for (int i = 0; i < binds.size(); i++)
        set(binds[i], vals[i]);
    for (int i = 0; i < binds.size(); i++) begin
        uvm_reg r;
        bit seen;
        r = parent_reg(binds[i]);
        seen = 0;
        foreach (regs[j])
            if (regs[j] == r)
                seen = 1;
        if (!seen)
            regs.push_back(r);
    end
    foreach (regs[i])
        write_reg(regs[i]);
endtask

`endif
{% endif %}
