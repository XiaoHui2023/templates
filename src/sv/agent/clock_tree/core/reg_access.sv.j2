`ifndef {{ (settings.class_prefix ~ "reg_rw") | upper }}
`define {{ (settings.class_prefix ~ "reg_rw") | upper }}

// 已绑定 field 有效位宽
function automatic int {{ settings.class_prefix }}reg_bound_width(
        {{ settings.class_prefix }}reg rb);
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "reg_bound_width: field is null")
    if (rb.width > 0)
        return rb.width;
    return rb.field.get_n_bits();
endfunction

// 按绑定位宽得切片可写最大值
function automatic int {{ settings.class_prefix }}reg_bound_max(
        {{ settings.class_prefix }}reg rb);
    int w;
    w = {{ settings.class_prefix }}reg_bound_width(rb);
    return (1 << w) - 1;
endfunction

class {{ settings.class_prefix }}reg_rw;
    // 取 field 所属 uvm_reg
    extern function uvm_reg parent_reg({{ settings.class_prefix }}reg rb);
    // 按 offset/width 读出 field 切片
    extern function int get({{ settings.class_prefix }}reg rb);
    // 按 offset/width 合并写入 field，其余位不变
    extern function void set({{ settings.class_prefix }}reg rb, int value);
    // 若尚未总线读则先 read
    extern task ensure_read({{ settings.class_prefix }}reg rb);
    // 前门读整寄存器
    extern task read_reg(uvm_reg r, output int rdata);
    // 前门读父寄存器并解析 field 切片
    extern task read({{ settings.class_prefix }}reg rb, output int value);
    // 将 field 镜像写回总线
    extern task write_reg(uvm_reg r);
    // ensure_read 后写父寄存器
    extern task write({{ settings.class_prefix }}reg rb);
    // 值未变则跳过；否则 set 后写父寄存器
    extern task set_write({{ settings.class_prefix }}reg rb, int value);
    // binds — field 绑定队列
    // vals — 与 binds 同下标的写入值
    extern task apply(input {{ settings.class_prefix }}reg binds[$], input int vals[$]);
endclass

function uvm_reg {{ settings.class_prefix }}reg_rw::parent_reg({{ settings.class_prefix }}reg rb);
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "parent_reg: field is null")
    return rb.field.get_register();
endfunction

function int {{ settings.class_prefix }}reg_rw::get({{ settings.class_prefix }}reg rb);
    int full;
    int mask;
    int slice;
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "get: field is null")
    full = rb.field.get();
    if (rb.width == rb.field.get_n_bits() && rb.offset == 0)
        return full;
    mask = (1 << rb.width) - 1;
    slice = (full >> rb.offset) & mask;
    return slice;
endfunction

function void {{ settings.class_prefix }}reg_rw::set({{ settings.class_prefix }}reg rb, int value);
    uvm_status_e status;
    int cur;
    int mask;
    int slice_mask;
    int newval;
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "set: field is null")
    slice_mask = (1 << rb.width) - 1;
    if (rb.offset == 0 && rb.width == rb.field.get_n_bits()) begin
        rb.field.set(value, status);
    end else begin
        cur = rb.field.get();
        mask = slice_mask << rb.offset;
        newval = (cur & ~mask) | ((value & slice_mask) << rb.offset);
        rb.field.set(newval, status);
    end
    if (status != UVM_IS_OK)
        `uvm_fatal("CLK_TREE", $sformatf(
            "set: %s set 0x%0h failed", rb.field.get_full_name(), value))
endfunction

task {{ settings.class_prefix }}reg_rw::read_reg(uvm_reg r, output int rdata);
    uvm_status_e status;
    if (r == null)
        `uvm_fatal("CLK_TREE", "read_reg: reg is null")
    r.read(status, rdata);
    if (status != UVM_IS_OK)
        `uvm_fatal("CLK_TREE", $sformatf(
            "read_reg: read %s failed", r.get_full_name()))
endtask

task {{ settings.class_prefix }}reg_rw::ensure_read({{ settings.class_prefix }}reg rb);
    int dummy;
    if (!rb.has_read)
        read(rb, dummy);
endtask

task {{ settings.class_prefix }}reg_rw::read({{ settings.class_prefix }}reg rb, output int value);
    uvm_reg r;
    int reg_rdata;
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "read: field is null")
    r = parent_reg(rb);
    read_reg(r, reg_rdata);
    rb.has_read = 1'b1;
    value = get(rb);
endtask

task {{ settings.class_prefix }}reg_rw::write_reg(uvm_reg r);
    uvm_status_e status;
    int wdata;
    if (r == null)
        `uvm_fatal("CLK_TREE", "write_reg: reg is null")
    wdata = r.get();
    r.write(status, wdata);
    if (status != UVM_IS_OK)
        `uvm_fatal("CLK_TREE", $sformatf(
            "write_reg: write %s 0x%0h failed", r.get_full_name(), wdata))
endtask

task {{ settings.class_prefix }}reg_rw::write({{ settings.class_prefix }}reg rb);
    ensure_read(rb);
    write_reg(parent_reg(rb));
endtask

task {{ settings.class_prefix }}reg_rw::set_write({{ settings.class_prefix }}reg rb, int value);
    int cur;
    ensure_read(rb);
    cur = get(rb);
    if (cur == value)
        return;
    set(rb, value);
    write_reg(parent_reg(rb));
endtask

task {{ settings.class_prefix }}reg_rw::apply(
        input {{ settings.class_prefix }}reg binds[$],
        input int vals[$]);
    uvm_reg regs[$];
    uvm_reg read_regs[$];
    if (binds.size() != vals.size())
        `uvm_fatal("CLK_TREE", $sformatf(
            "apply: binds size %0d != vals size %0d", binds.size(), vals.size()))
    for (int i = 0; i < binds.size(); i++) begin
        int cur;
        uvm_reg r;
        bit seen;
        bit reg_read;
        r = parent_reg(binds[i]);
        reg_read = 0;
        foreach (read_regs[j])
            if (read_regs[j] == r)
                reg_read = 1;
        if (!reg_read) begin
            int dummy;
            read_reg(r, dummy);
            read_regs.push_back(r);
        end
        binds[i].has_read = 1'b1;
        cur = get(binds[i]);
        if (cur == vals[i])
            continue;
        set(binds[i], vals[i]);
        seen = 0;
        foreach (regs[j])
            if (regs[j] == r)
                seen = 1;
        if (!seen)
            regs.push_back(r);
    end
    foreach (regs[i])
        write_reg(regs[i]);
endtask

`endif
