{% if route_test_enabled %}
`ifndef {{ (settings.class_prefix ~ "route_structure") | upper }}
`define {{ (settings.class_prefix ~ "route_structure") | upper }}

typedef struct {
    bit     gate_open;
    int     mux_sel;
    int     ratio;
{%- if enable_node_fix %}
    bit     fix_open;
    bit     fix_close;
    int     fix_sel;
    int     fix_ratio;
{%- endif %}
} {{ settings.class_prefix }}route_ctrl_snap_t;

// gate/mux/div/dto 所需 field 均已绑定
function automatic bit {{ settings.class_prefix }}route_structure_regs_ready(
        {{ settings.class_prefix }}node_base nd);
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}mux mux_nd;
    {{ settings.class_prefix }}div div_nd;
    {{ settings.class_prefix }}dto dto_nd;

    if (nd == null)
        return 1'b0;
    if ($cast(gate_nd, nd))
        return gate_nd.f_reg.is_bound();
    if ($cast(mux_nd, nd))
        return mux_nd.f_reg.is_bound();
    if ($cast(div_nd, nd))
        return div_nd.f_rst.is_bound() && div_nd.f_load.is_bound()
            && div_nd.f_div.is_bound();
    if ($cast(dto_nd, nd))
        return dto_nd.f_rst.is_bound() && dto_nd.f_load.is_bound()
            && dto_nd.f_bypass.is_bound() && dto_nd.f_step.is_bound();
    return 1'b0;
endfunction

// kind 是否为 gate、mux、div、dto
function automatic bit {{ settings.class_prefix }}route_structure_is_probe_kind(
        {{ settings.class_prefix }}node_base nd);
    if (nd == null)
        return 1'b0;
    return nd.kind == "gate" || nd.kind == "mux" || nd.kind == "div"
        || nd.kind == "dto";
endfunction

// 读出节点当前 open/sel/ratio 等到 snap
function automatic void {{ settings.class_prefix }}route_structure_save_ctrl(
        {{ settings.class_prefix }}node_base nd,
        output {{ settings.class_prefix }}route_ctrl_snap_t snap);
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}mux mux_nd;
    {{ settings.class_prefix }}div div_nd;
    {{ settings.class_prefix }}dto dto_nd;

    snap.gate_open = 1'b0;
    snap.mux_sel = 0;
    snap.ratio = 1;
{%- if enable_node_fix %}
    snap.fix_open = 0;
    snap.fix_close = 0;
    snap.fix_sel = -1;
    snap.fix_ratio = 0;
{%- endif %}
    if ($cast(gate_nd, nd)) begin
        snap.gate_open = gate_nd.open;
{%- if enable_node_fix %}
        snap.fix_open = gate_nd.fix_open;
        snap.fix_close = gate_nd.fix_close;
{%- endif %}
    end else if ($cast(mux_nd, nd)) begin
        snap.mux_sel = mux_nd.sel;
{%- if enable_node_fix %}
        snap.fix_sel = mux_nd.fix_sel;
{%- endif %}
    end else if ($cast(div_nd, nd)) begin
        snap.ratio = div_nd.ratio;
{%- if enable_node_fix %}
        snap.fix_ratio = div_nd.fix_ratio;
{%- endif %}
    end else if ($cast(dto_nd, nd)) begin
        snap.ratio = dto_nd.ratio;
{%- if enable_node_fix %}
        snap.fix_ratio = dto_nd.fix_ratio;
{%- endif %}
    end
endfunction

// clear_fix — 为真时清除 fix 约束字段
function automatic void {{ settings.class_prefix }}route_structure_apply_ctrl(
        {{ settings.class_prefix }}node_base nd,
        {{ settings.class_prefix }}route_ctrl_snap_t snap,
        bit clear_fix);
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}mux mux_nd;
    {{ settings.class_prefix }}div div_nd;
    {{ settings.class_prefix }}dto dto_nd;

    if ($cast(gate_nd, nd)) begin
        gate_nd.open = snap.gate_open;
{%- if enable_node_fix %}
        if (clear_fix) begin
            gate_nd.fix_open = snap.gate_open;
            gate_nd.fix_close = !snap.gate_open;
        end else begin
            gate_nd.fix_open = snap.fix_open;
            gate_nd.fix_close = snap.fix_close;
        end
{%- endif %}
    end else if ($cast(mux_nd, nd)) begin
        mux_nd.sel = snap.mux_sel;
{%- if enable_node_fix %}
        if (clear_fix)
            mux_nd.fix_sel = snap.mux_sel;
        else
            mux_nd.fix_sel = snap.fix_sel;
{%- endif %}
        mux_nd.post_randomize();
    end else if ($cast(div_nd, nd)) begin
        div_nd.ratio = snap.ratio;
{%- if enable_node_fix %}
        if (clear_fix)
            div_nd.fix_ratio = snap.ratio;
        else
            div_nd.fix_ratio = snap.fix_ratio;
{%- endif %}
    end else if ($cast(dto_nd, nd)) begin
        dto_nd.ratio = snap.ratio;
{%- if enable_node_fix %}
        if (clear_fix)
            dto_nd.fix_ratio = snap.ratio;
        else
            dto_nd.fix_ratio = snap.fix_ratio;
{%- endif %}
    end
endfunction

// 设 gate open 并 post_randomize
function automatic void {{ settings.class_prefix }}route_structure_set_gate_open(
        {{ settings.class_prefix }}gate gate_nd, bit open_val, bit clear_fix);
    {{ settings.class_prefix }}route_ctrl_snap_t snap;
    if (gate_nd == null)
        return;
    {{ settings.class_prefix }}route_structure_save_ctrl(gate_nd, snap);
    snap.gate_open = open_val;
    {{ settings.class_prefix }}route_structure_apply_ctrl(gate_nd, snap, clear_fix);
endfunction

// 设 mux sel 并 post_randomize
function automatic void {{ settings.class_prefix }}route_structure_set_mux_sel(
        {{ settings.class_prefix }}mux mux_nd, int sel_val, bit clear_fix);
    {{ settings.class_prefix }}route_ctrl_snap_t snap;
    if (mux_nd == null)
        return;
    {{ settings.class_prefix }}route_structure_save_ctrl(mux_nd, snap);
    snap.mux_sel = sel_val;
    {{ settings.class_prefix }}route_structure_apply_ctrl(mux_nd, snap, clear_fix);
endfunction

// 设 div/dto ratio 并 post_randomize
function automatic void {{ settings.class_prefix }}route_structure_set_ratio(
        {{ settings.class_prefix }}node_base nd, int ratio_val, bit clear_fix);
    {{ settings.class_prefix }}route_ctrl_snap_t snap;
    if (nd == null)
        return;
    {{ settings.class_prefix }}route_structure_save_ctrl(nd, snap);
    snap.ratio = ratio_val;
    {{ settings.class_prefix }}route_structure_apply_ctrl(nd, snap, clear_fix);
endfunction

// 沿 source 链判断 ancestor 是否为 desc 前级
function automatic bit {{ settings.class_prefix }}route_structure_is_ancestor_of(
        {{ settings.class_prefix }}node_base ancestor,
        {{ settings.class_prefix }}node_base desc);
    {{ settings.class_prefix }}node_base cur;

    if (ancestor == null || desc == null)
        return 1'b0;
    cur = desc;
    while (cur != null) begin
        if (cur == ancestor)
            return 1'b1;
        cur = cur.source;
    end
    return 1'b0;
endfunction

// 仅保留寄存器已绑定的 line 节点
function automatic void {{ settings.class_prefix }}route_structure_filter_line_regs(
        {{ settings.class_prefix }}node_base line[$],
        output {{ settings.class_prefix }}node_base filtered[$]);
    filtered.delete();
    foreach (line[i])
        if ({{ settings.class_prefix }}route_structure_regs_ready(line[i]))
            filtered.push_back(line[i]);
endfunction

// subject 上游 gate/mux/div/dto，仅保留寄存器已绑定
function automatic void {{ settings.class_prefix }}route_structure_collect_upstream_line(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base subject,
        output {{ settings.class_prefix }}node_base line[$]);
    {{ settings.class_prefix }}node_base raw[$];
    line.delete();
    if (tree == null || subject == null)
        return;
    {{ settings.class_prefix }}get_nodes_before(tree, subject, raw);
    foreach (raw[i]) begin
        if (raw[i] == subject)
            continue;
        if ({{ settings.class_prefix }}route_structure_is_probe_kind(raw[i]))
            line.push_back(raw[i]);
    end
    begin
        {{ settings.class_prefix }}node_base filtered[$];
        {{ settings.class_prefix }}route_structure_filter_line_regs(line, filtered);
        line = filtered;
    end
endfunction

// subject 下游 gate/mux/div/dto，仅保留寄存器已绑定
function automatic void {{ settings.class_prefix }}route_structure_collect_downstream_line(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base subject,
        output {{ settings.class_prefix }}node_base line[$]);
    {{ settings.class_prefix }}node_base raw[$];
    line.delete();
    if (tree == null || subject == null)
        return;
    {{ settings.class_prefix }}get_nodes_after(tree, subject, raw);
    foreach (raw[i]) begin
        if (raw[i] == subject)
            continue;
        if ({{ settings.class_prefix }}route_structure_is_probe_kind(raw[i]))
            line.push_back(raw[i]);
    end
    begin
        {{ settings.class_prefix }}node_base filtered[$];
        {{ settings.class_prefix }}route_structure_filter_line_regs(line, filtered);
        line = filtered;
    end
endfunction

// 全树寄存器就绪的 gate/mux/div/dto
function automatic void {{ settings.class_prefix }}route_structure_collect_probe_subjects(
        {{ settings.class_prefix }}tree_base tree,
        output {{ settings.class_prefix }}node_base subjects[$]);
    subjects.delete();
    if (tree == null)
        return;
    foreach (tree.nodes[i]) begin
        if (!{{ settings.class_prefix }}route_structure_is_probe_kind(tree.nodes[i]))
            continue;
        if (!{{ settings.class_prefix }}route_structure_regs_ready(tree.nodes[i]))
            continue;
        {{ settings.class_prefix }}append_unique_node(subjects, tree.nodes[i]);
    end
endfunction

// filter 非空时从中取 div/dto，否则扫全树
function automatic void {{ settings.class_prefix }}route_structure_collect_flip_subjects(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base filter[$],
        output {{ settings.class_prefix }}node_base subjects[$]);
    subjects.delete();
    if (filter.size() > 0) begin
        foreach (filter[i]) begin
            if (filter[i] == null)
                continue;
            if (filter[i].kind != "div" && filter[i].kind != "dto")
                continue;
            if (!{{ settings.class_prefix }}route_structure_regs_ready(filter[i]))
                continue;
            {{ settings.class_prefix }}append_unique_node(subjects, filter[i]);
        end
        return;
    end
    if (tree == null)
        return;
    foreach (tree.nodes[i]) begin
        if (tree.nodes[i] == null)
            continue;
        if (tree.nodes[i].kind != "div" && tree.nodes[i].kind != "dto")
            continue;
        if (!{{ settings.class_prefix }}route_structure_regs_ready(tree.nodes[i]))
            continue;
        {{ settings.class_prefix }}append_unique_node(subjects, tree.nodes[i]);
    end
endfunction

// 变体下标对应 gate/mux/div/dto 控制量摘要
function automatic string {{ settings.class_prefix }}route_structure_variant_label(
        {{ settings.class_prefix }}node_base nd, int idx);
    {{ settings.class_prefix }}mux mux_nd;
    int keys[$];
    if (nd == null)
        return "?";
    if (nd.kind == "gate")
        return $sformatf("open=%0b", idx != 0);
    if (nd.kind == "div" || nd.kind == "dto")
        return $sformatf("ratio=%0d", idx == 0 ? 1 : 2);
    if ($cast(mux_nd, nd)) begin
        foreach (mux_nd.to_source[k])
            keys.push_back(k);
        keys.sort();
        if (idx >= 0 && idx < keys.size())
            return $sformatf("sel=%0d", keys[idx]);
        return $sformatf("sel_idx=%0d", idx);
    end
    return $sformatf("variant=%0d", idx);
endfunction

// line 组合下标对应的各节点控制量摘要
function automatic string {{ settings.class_prefix }}route_structure_line_combo_summary(
        {{ settings.class_prefix }}node_base line[$], int combo_idx);
    int n;
    int pick;
    int rem;
    string s;
    rem = combo_idx;
    s = "";
    foreach (line[i]) begin
        n = {{ settings.class_prefix }}route_structure_variant_count(line[i]);
        if (n <= 0)
            continue;
        pick = rem % n;
        rem = rem / n;
        if (s.len() > 0)
            s = {s, ", "};
        s = {s, line[i].get_name(), " ",
            {{ settings.class_prefix }}route_structure_variant_label(line[i], pick)};
    end
    if (s == "")
        s = "default";
    return s;
endfunction

// 节点队列名字与 kind，逗号分隔
function automatic string {{ settings.class_prefix }}route_structure_format_node_names(
        {{ settings.class_prefix }}node_base nodes[$]);
    string s;
    s = "";
    foreach (nodes[i]) begin
        if (nodes[i] == null)
            continue;
        if (s.len() > 0)
            s = {s, ", "};
        s = {s, nodes[i].get_name(), " (", nodes[i].kind, ")"};
    end
    if (s == "")
        s = "none";
    return s;
endfunction

// 单节点路由变体数：gate/div/dto 为 2，mux 为输入数
function automatic int {{ settings.class_prefix }}route_structure_variant_count(
        {{ settings.class_prefix }}node_base nd);
    {{ settings.class_prefix }}mux mux_nd;
    int n;
    int keys[$];
    if (nd == null)
        return 0;
    if (nd.kind == "gate")
        return 2;
    if (nd.kind == "div" || nd.kind == "dto")
        return 2;
    if ($cast(mux_nd, nd)) begin
        foreach (mux_nd.to_source[k])
            keys.push_back(k);
        return keys.size();
    end
    return 0;
endfunction

// 按 idx 应用 gate/mux/div/dto 变体
function automatic void {{ settings.class_prefix }}route_structure_apply_variant_index(
        {{ settings.class_prefix }}node_base nd, int idx, bit clear_fix);
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}mux mux_nd;
    int keys[$];
    if (nd == null)
        return;
    if ($cast(gate_nd, nd))
        {{ settings.class_prefix }}route_structure_set_gate_open(
            gate_nd, idx != 0, clear_fix);
    else if (nd.kind == "div" || nd.kind == "dto")
        {{ settings.class_prefix }}route_structure_set_ratio(
            nd, idx == 0 ? 1 : 2, clear_fix);
    else if ($cast(mux_nd, nd)) begin
        foreach (mux_nd.to_source[k])
            keys.push_back(k);
        keys.sort();
        if (idx < 0 || idx >= keys.size())
            `uvm_fatal("CLK_TREE", $sformatf(
                "route_structure: mux %s variant idx %0d out of range",
                mux_nd.get_name(), idx))
        {{ settings.class_prefix }}route_structure_set_mux_sel(
            mux_nd, keys[idx], clear_fix);
    end
endfunction

// line 上各节点变体数的乘积
function automatic int {{ settings.class_prefix }}route_structure_line_combo_count(
        {{ settings.class_prefix }}node_base line[$]);
    int total;
    int n;
    total = 1;
    foreach (line[i]) begin
        n = {{ settings.class_prefix }}route_structure_variant_count(line[i]);
        if (n <= 0)
            continue;
        total *= n;
    end
    return total;
endfunction

// combo_idx — line 组合变体的线性下标
function automatic void {{ settings.class_prefix }}route_structure_apply_line_combo_index(
        {{ settings.class_prefix }}node_base line[$],
        int combo_idx,
        bit clear_fix);
    int n;
    int pick;
    int rem;
    rem = combo_idx;
    foreach (line[i]) begin
        n = {{ settings.class_prefix }}route_structure_variant_count(line[i]);
        if (n <= 0)
            continue;
        pick = rem % n;
        rem = rem / n;
        {{ settings.class_prefix }}route_structure_apply_variant_index(
            line[i], pick, clear_fix);
    end
endfunction

// always_active_clk_nodes 队列是否含该 clk 句柄
function automatic bit {{ settings.class_prefix }}route_structure_clk_is_always_active(
        {{ settings.class_prefix }}clk clk_nd,
        {{ settings.class_prefix }}node_base always_active_clk_nodes[$]);
    if (clk_nd == null)
        return 1'b0;
    foreach (always_active_clk_nodes[i]) begin
        if (always_active_clk_nodes[i] == null)
            continue;
        if (always_active_clk_nodes[i] == clk_nd)
            return 1'b1;
    end
    return 1'b0;
endfunction

// 结构探测前：全部 clk unfix_frequence；须活动的 clk unfix_enabled 为 0
function automatic void {{ settings.class_prefix }}route_structure_apply_clk_unfix_policy(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base always_active_clk_nodes[$]);
{%- if enable_node_fix %}
    {{ settings.class_prefix }}clk clk_nd;
    if (tree == null)
        return;
    foreach (tree.nodes[i]) begin
        if (!$cast(clk_nd, tree.nodes[i]))
            continue;
        clk_nd.unfix_frequence = 1'b1;
        if (always_active_clk_nodes.size() > 0)
            clk_nd.unfix_enabled = !{{ settings.class_prefix }}route_structure_clk_is_always_active(
                clk_nd, always_active_clk_nodes);
        else
            clk_nd.unfix_enabled = 1'b0;
    end
{%- endif %}
endfunction

// config_reg 之后：自 always_active clk 沿已配置的 source 选通链向上，收集 gate/mux
function automatic void {{ settings.class_prefix }}route_structure_collect_always_active_upstream_gate_mux(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base always_active_clk_nodes[$],
        output {{ settings.class_prefix }}node_base collected[$]);
    {{ settings.class_prefix }}node_base cur;

    collected.delete();
    if (tree == null || always_active_clk_nodes.size() == 0)
        return;
    foreach (always_active_clk_nodes[i]) begin
        if (always_active_clk_nodes[i] == null)
            continue;
        if (always_active_clk_nodes[i].kind != "clk")
            continue;
        cur = always_active_clk_nodes[i].source;
        while (cur != null) begin
            if (cur.kind == "gate" || cur.kind == "mux")
                {{ settings.class_prefix }}append_unique_node(collected, cur);
            cur = cur.source;
        end
    end
endfunction

// gate 固定打开、mux 以当前 sel 设 fix_sel
function automatic void {{ settings.class_prefix }}route_structure_pin_gate_mux_fix(
        {{ settings.class_prefix }}node_base gate_mux[$]);
{%- if enable_node_fix %}
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}mux mux_nd;

    foreach (gate_mux[i]) begin
        if (gate_mux[i] == null)
            continue;
        if ($cast(gate_nd, gate_mux[i]))
            {{ settings.class_prefix }}route_structure_set_gate_open(gate_nd, 1'b1, 1'b1);
        else if ($cast(mux_nd, gate_mux[i])) begin
            mux_nd.fix_sel = mux_nd.sel;
            mux_nd.post_randomize();
        end
    end
{%- endif %}
endfunction

// 从 line 去掉已 fix 锁定的 gate/mux
function automatic void {{ settings.class_prefix }}route_structure_filter_pinned_gate_mux_from_line(
        ref {{ settings.class_prefix }}node_base line[$],
        {{ settings.class_prefix }}node_base pinned_gate_mux[$]);
    {{ settings.class_prefix }}node_base kept[$];

    kept.delete();
    foreach (line[i]) begin
        if ({{ settings.class_prefix }}node_in_queue(line[i], pinned_gate_mux))
            continue;
        kept.push_back(line[i]);
    end
    line = kept;
endfunction

// 全部 clk 设同一 unfix_frequence 值
function automatic void {{ settings.class_prefix }}route_structure_set_all_clk_unfix_frequence(
        {{ settings.class_prefix }}tree_base tree,
        bit unfix_val);
{%- if enable_node_fix %}
    {{ settings.class_prefix }}clk clk_nd;
    if (tree == null)
        return;
    foreach (tree.nodes[i]) begin
        if ($cast(clk_nd, tree.nodes[i]))
            clk_nd.unfix_frequence = unfix_val;
    end
{%- endif %}
endfunction

// 全部 clk 设同一 unfix_enabled 值
function automatic void {{ settings.class_prefix }}route_structure_set_all_clk_unfix_enabled(
        {{ settings.class_prefix }}tree_base tree,
        bit unfix_val);
{%- if enable_node_fix %}
    {{ settings.class_prefix }}clk clk_nd;
    if (tree == null)
        return;
    foreach (tree.nodes[i]) begin
        if ($cast(clk_nd, tree.nodes[i]))
            clk_nd.unfix_enabled = unfix_val;
    end
{%- endif %}
endfunction

// 全部 clk 清除 unfix_frequence
function automatic void {{ settings.class_prefix }}route_structure_clear_clk_unfix_frequence(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}route_structure_set_all_clk_unfix_frequence(tree, 1'b0);
endfunction

// 全部 clk 清除 unfix_enabled
function automatic void {{ settings.class_prefix }}route_structure_clear_clk_unfix_enabled(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}route_structure_set_all_clk_unfix_enabled(tree, 1'b0);
endfunction

// 全部 clk 清除 unfix_frequence 与 unfix_enabled
function automatic void {{ settings.class_prefix }}route_structure_clear_clk_unfix(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}route_structure_clear_clk_unfix_frequence(tree);
    {{ settings.class_prefix }}route_structure_clear_clk_unfix_enabled(tree);
endfunction

// 按当前 open、sel 锁定整树 gate 与 mux
function automatic void {{ settings.class_prefix }}route_structure_fix_all_gate_mux(
        {{ settings.class_prefix }}tree_base tree);
{%- if enable_node_fix %}
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}mux mux_nd;
    {{ settings.class_prefix }}route_ctrl_snap_t snap;

    if (tree == null)
        return;
    foreach (tree.nodes[i]) begin
        if ($cast(gate_nd, tree.nodes[i])) begin
            {{ settings.class_prefix }}route_structure_save_ctrl(gate_nd, snap);
            {{ settings.class_prefix }}route_structure_apply_ctrl(gate_nd, snap, 1'b1);
        end else if ($cast(mux_nd, tree.nodes[i])) begin
            {{ settings.class_prefix }}route_structure_save_ctrl(mux_nd, snap);
            {{ settings.class_prefix }}route_structure_apply_ctrl(mux_nd, snap, 1'b1);
        end
    end
{%- endif %}
endfunction

// 清除整树 fix_* 与 clk unfix_*，恢复自然约束求解
function automatic void {{ settings.class_prefix }}route_structure_clear_all_fix(
        {{ settings.class_prefix }}tree_base tree);
{%- if enable_node_fix %}
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}mux mux_nd;
    {{ settings.class_prefix }}div div_nd;
    {{ settings.class_prefix }}dto dto_nd;

    if (tree == null)
        return;
    {{ settings.class_prefix }}route_structure_clear_clk_unfix(tree);
    foreach (tree.nodes[i]) begin
        if ($cast(gate_nd, tree.nodes[i])) begin
            gate_nd.fix_open = 1'b0;
            gate_nd.fix_close = 1'b0;
        end else if ($cast(mux_nd, tree.nodes[i])) begin
            mux_nd.fix_sel = -1;
        end else if ($cast(div_nd, tree.nodes[i])) begin
            div_nd.fix_ratio = 0;
        end else if ($cast(dto_nd, tree.nodes[i])) begin
            dto_nd.fix_ratio = 0;
        end
    end
{%- endif %}
endfunction

// always_active_clk_nodes 所列 clk 节点 _resolved_active 均为真
function automatic bit {{ settings.class_prefix }}route_structure_always_active_clocks_valid(
        {{ settings.class_prefix }}node_base always_active_clk_nodes[$]);
    foreach (always_active_clk_nodes[i]) begin
        if (always_active_clk_nodes[i] == null)
            continue;
        if (always_active_clk_nodes[i].kind != "clk")
            continue;
        if (!always_active_clk_nodes[i]._resolved_active)
            return 1'b0;
    end
    return 1'b1;
endfunction

`endif
{% endif %}
