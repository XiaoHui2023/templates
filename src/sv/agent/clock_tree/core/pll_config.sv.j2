task {{ settings.class_prefix }}pll_cfg::configure_dw(
        {{ settings.class_prefix }}reg f_fbdiv,
        {{ settings.class_prefix }}reg f_prediv,
        {{ settings.class_prefix }}reg f_reset,
        {{ settings.class_prefix }}reg f_pwron,
        {{ settings.class_prefix }}reg f_shift,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_divvcor,
        {{ settings.class_prefix }}reg f_r,
        {{ settings.class_prefix }}reg f_p,
        {{ settings.class_prefix }}reg f_divvcop,
        {{ settings.class_prefix }}reg f_enr,
        {{ settings.class_prefix }}reg f_enp,
        bit active,
        int fbdiv,
        int prediv,
        int divvcop,
        int p,
        int divvcor,
        int r);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];

    if (!active) begin
        binds = '{f_reset, f_pwron, f_shift, f_bypass, f_enr, f_enp};
        vals = '{1, 0, 0, 0, 0, 0};
        rw.apply(binds, vals);
        return;
    end

    binds = '{f_fbdiv, f_prediv};
    vals = '{fbdiv, prediv};
    rw.apply(binds, vals);

    rw.set_write(f_reset, 1);

    binds = '{f_pwron, f_shift, f_bypass};
    vals = '{1, 1, 0};
    rw.apply(binds, vals);
    #4us;

    binds = '{f_reset, f_shift};
    vals = '{0, 0};
    rw.apply(binds, vals);
    #10us;

    binds = '{f_divvcor, f_r, f_p, f_divvcop};
    vals = '{divvcor, r, p, divvcop};
    rw.apply(binds, vals);

    binds = '{f_enr, f_enp};
    vals = '{1, 1};
    rw.apply(binds, vals);
endtask

task {{ settings.class_prefix }}pll_cfg::tci_regs_match_target(
        input {{ settings.class_prefix }}reg f_bypass,
        input {{ settings.class_prefix }}reg f_pwrdn,
        input {{ settings.class_prefix }}reg f_reset,
        input {{ settings.class_prefix }}reg f_clkod,
        input {{ settings.class_prefix }}reg f_clkf,
        input {{ settings.class_prefix }}reg f_clkr,
        input {{ settings.class_prefix }}reg f_bwadj,
        input longint out_hz,
        input longint ref_hz,
        input bit active,
        output bit match);
    int exp_clkr;
    int exp_clkf;
    int exp_clkod;
    int exp_bwadj;
    int act;
    match = 1'b1;
    rw.read(f_bypass, act);
    if (act != 0)
        match = 1'b0;
    rw.read(f_pwrdn, act);
    if (act != !active)
        match = 1'b0;
    rw.read(f_reset, act);
    if (act != !active)
        match = 1'b0;
    if (!active)
        return;
    tci_divisors(out_hz, ref_hz, exp_clkr, exp_clkf, exp_clkod, exp_bwadj);
    rw.read(f_clkod, act);
    if (act != exp_clkod)
        match = 1'b0;
    rw.read(f_clkf, act);
    if (act != exp_clkf)
        match = 1'b0;
    rw.read(f_clkr, act);
    if (act != exp_clkr)
        match = 1'b0;
    rw.read(f_bwadj, act);
    if (act != exp_bwadj)
        match = 1'b0;
endtask

