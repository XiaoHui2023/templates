function void {{ class_prefix }}pll_cfg::tci_divisors(
        input longint out_hz,
        input longint ref_hz,
        output int clkr,
        output int clkf,
        output int clkod,
        output int bwadj);
    clkr = 1;
    clkod = 1;
    if (ref_hz > 0 && out_hz > 0)
        clkf = out_hz / ref_hz;
    else
        clkf = 1;
    bwadj = clkf;
endfunction

function void {{ class_prefix }}pll_cfg::sc_divisors(
        input longint out_hz,
        input longint ref_hz,
        output int fbdiv,
        output int refdiv,
        output int postdiv1,
        output int postdiv2);
    int refdiv_try;
    int postdiv1_try;
    int postdiv2_try;
    int fbdiv_i;
    longint product;
    longint actual_hz;
    longint err;
    longint best_err;
    real fbdiv_r;
    bit have_best;
    int best_refdiv;
    int best_postdiv1;
    int best_postdiv2;
    int best_fbdiv;
    refdiv = 2;
    postdiv1 = 1;
    postdiv2 = 1;
    fbdiv = 1;
    if (ref_hz <= 0 || out_hz <= 0)
        return;
    have_best = 0;
    for (refdiv_try = 1; refdiv_try <= 63; refdiv_try++) begin
        for (postdiv1_try = 1; postdiv1_try <= 7; postdiv1_try++) begin
            for (postdiv2_try = 1; postdiv2_try <= 7; postdiv2_try++) begin
                product = refdiv_try * postdiv1_try * postdiv2_try;
                fbdiv_r = real'(out_hz) * real'(product) / real'(ref_hz);
                fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
                if (fbdiv_i < SC_FBDIV_MIN || fbdiv_i > SC_FBDIV_MAX)
                    continue;
                actual_hz = (ref_hz * fbdiv_i) / product;
                err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
                if (!have_best || err < best_err) begin
                    best_err = err;
                    best_fbdiv = fbdiv_i;
                    best_refdiv = refdiv_try;
                    best_postdiv1 = postdiv1_try;
                    best_postdiv2 = postdiv2_try;
                    have_best = 1;
                end
            end
        end
    end
    if (have_best) begin
        fbdiv = best_fbdiv;
        refdiv = best_refdiv;
        postdiv1 = best_postdiv1;
        postdiv2 = best_postdiv2;
    end
endfunction

function void {{ class_prefix }}pll_cfg::dw_divisors(
        input longint out_hz,
        input longint ref_hz,
        output int fbdiv,
        output int prediv,
        output int divvcop,
        output int p,
        output int divvcor,
        output int r);
    int p_try;
    int fbdiv_i;
    longint actual_hz;
    longint err;
    longint best_err;
    real fbdiv_r;
    bit have_best;
    int best_p;
    int best_fbdiv;
    prediv = 0;
    divvcop = 0;
    divvcor = 0;
    r = 4;
    p = 0;
    fbdiv = 1;
    if (ref_hz <= 0 || out_hz <= 0)
        return;
    have_best = 0;
    for (p_try = 0; p_try <= 7; p_try++) begin
        fbdiv_r = real'(out_hz) * real'(p_try + 1) / real'(ref_hz);
        fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
        if (fbdiv_i < DW_FBDIV_MIN || fbdiv_i > DW_FBDIV_MAX)
            continue;
        actual_hz = (ref_hz * fbdiv_i) / (p_try + 1);
        err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
        if (!have_best || err < best_err) begin
            best_err = err;
            best_fbdiv = fbdiv_i;
            best_p = p_try;
            have_best = 1;
        end
    end
    if (have_best) begin
        fbdiv = best_fbdiv;
        p = best_p;
    end
endfunction

task {{ class_prefix }}pll_cfg::configure_sc_from_hz(
        {{ class_prefix }}reg_bind f_vocpd,
        {{ class_prefix }}reg_bind f_postdivpd,
        {{ class_prefix }}reg_bind f_dsmpd,
        {{ class_prefix }}reg_bind f_pd,
        {{ class_prefix }}reg_bind f_bypass,
        {{ class_prefix }}reg_bind f_refdiv,
        {{ class_prefix }}reg_bind f_postdiv2,
        {{ class_prefix }}reg_bind f_postdiv1,
        {{ class_prefix }}reg_bind f_fbdiv,
        input longint out_hz,
        input longint ref_hz);
    int fbdiv;
    int refdiv;
    int postdiv1;
    int postdiv2;
    sc_divisors(out_hz, ref_hz, fbdiv, refdiv, postdiv1, postdiv2);
    configure_sc(
        f_vocpd, f_postdivpd, f_dsmpd, f_pd, f_bypass,
        f_refdiv, f_postdiv2, f_postdiv1, f_fbdiv,
        fbdiv, refdiv, postdiv1, postdiv2);
endtask

task {{ class_prefix }}pll_cfg::configure_dw_from_hz(
        {{ class_prefix }}reg_bind f_fbdiv,
        {{ class_prefix }}reg_bind f_prediv,
        {{ class_prefix }}reg_bind f_reset,
        {{ class_prefix }}reg_bind f_pwron,
        {{ class_prefix }}reg_bind f_shift,
        {{ class_prefix }}reg_bind f_bypass,
        {{ class_prefix }}reg_bind f_divvcor,
        {{ class_prefix }}reg_bind f_r,
        {{ class_prefix }}reg_bind f_p,
        {{ class_prefix }}reg_bind f_divvcop,
        {{ class_prefix }}reg_bind f_enr,
        {{ class_prefix }}reg_bind f_enp,
        input longint out_hz,
        input longint ref_hz);
    int fbdiv;
    int prediv;
    int divvcop;
    int p;
    int divvcor;
    int r;
    dw_divisors(out_hz, ref_hz, fbdiv, prediv, divvcop, p, divvcor, r);
    configure_dw(
        f_fbdiv, f_prediv, f_reset, f_pwron, f_shift, f_bypass,
