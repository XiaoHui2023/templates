{% if regs_enabled %}
`ifndef {{ (settings.class_prefix ~ "pll_cfg") | upper }}
`define {{ (settings.class_prefix ~ "pll_cfg") | upper }}

class {{ settings.class_prefix }}pll_cfg;
    localparam int SC_FBDIV_HW_MIN = 1;
    localparam int SC_FBDIV_HW_MAX = 4095;
    localparam int SC_FBDIV_PREF_MIN = {{ settings.pll_sc_fbdiv_min }};
    localparam int SC_FBDIV_PREF_MAX = {{ settings.pll_sc_fbdiv_max }};
    localparam int DW_FBDIV_MIN = 1;
    localparam int DW_FBDIV_MAX = 1023;

    {{ settings.class_prefix }}reg_rw rw;
    protected longint cfg_ref_hz[string];
    protected longint cfg_out_hz[string];

    function new({{ settings.class_prefix }}reg_rw reg_rw);
        if (reg_rw == null)
            `uvm_fatal("CLK_TREE", "pll_cfg: reg_rw is null")
        rw = reg_rw;
    endfunction

    // 由 out_hz、ref_hz 算 TCI 分频系数
    extern function void tci_divisors(
        longint out_hz,
        longint ref_hz,
        output int clkr,
        output int clkf,
        output int clkod,
        output int bwadj);
    // 由 out_hz、ref_hz 搜 SC 分频，优先 fbdiv 配置区间
    extern function void sc_divisors(
        longint out_hz,
        longint ref_hz,
        output int fbdiv,
        output int refdiv,
        output int postdiv1,
        output int postdiv2);
    // 由 out_hz、ref_hz 搜 DW 分频
    extern function void dw_divisors(
        longint out_hz,
        longint ref_hz,
        output int fbdiv,
        output int prediv,
        output int divvcop,
        output int p,
        output int divvcor,
        output int r);
    // Inno 共享级 fbdiv、refdiv
    extern function void inno_shared_divisors(
        longint out_hz,
        longint ref_hz,
        output int fbdiv,
        output int refdiv);
    // 已知 fbdiv、refdiv 时搜 postdiv
    extern function void inno_postdivisors(
        longint out_hz,
        longint ref_hz,
        int fbdiv,
        int refdiv,
        output int postdiv1,
        output int postdiv2);
    // 按给定 TCI 系数写寄存器序列
    extern task configure_tci(
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_pwrdn,
        {{ settings.class_prefix }}reg f_reset,
        {{ settings.class_prefix }}reg f_clkod,
        {{ settings.class_prefix }}reg f_clkf,
        {{ settings.class_prefix }}reg f_clkr,
        {{ settings.class_prefix }}reg f_bwadj,
        int clkr,
        int clkf,
        int clkod,
        int bwadj);
    // 按给定 SC 系数写寄存器序列
    extern task configure_sc(
        {{ settings.class_prefix }}reg f_vocpd,
        {{ settings.class_prefix }}reg f_postdivpd,
        {{ settings.class_prefix }}reg f_dsmpd,
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_postdiv2,
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_fbdiv,
        int fbdiv,
        int refdiv,
        int postdiv1,
        int postdiv2);
    // 按给定 DW 系数写寄存器序列
    extern task configure_dw(
        {{ settings.class_prefix }}reg f_fbdiv,
        {{ settings.class_prefix }}reg f_prediv,
        {{ settings.class_prefix }}reg f_reset,
        {{ settings.class_prefix }}reg f_pwron,
        {{ settings.class_prefix }}reg f_shift,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_divvcor,
        {{ settings.class_prefix }}reg f_r,
        {{ settings.class_prefix }}reg f_p,
        {{ settings.class_prefix }}reg f_divvcop,
        {{ settings.class_prefix }}reg f_enr,
        {{ settings.class_prefix }}reg f_enp,
        int fbdiv,
        int prediv,
        int divvcop,
        int p,
        int divvcor,
        int r);
    // 由 Hz 算 SC 系数并 configure_sc
    extern task configure_sc_from_hz(
        {{ settings.class_prefix }}reg f_vocpd,
        {{ settings.class_prefix }}reg f_postdivpd,
        {{ settings.class_prefix }}reg f_dsmpd,
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_postdiv2,
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_fbdiv,
        longint out_hz,
        longint ref_hz);
    // 由 Hz 算 DW 系数并 configure_dw
    extern task configure_dw_from_hz(
        {{ settings.class_prefix }}reg f_fbdiv,
        {{ settings.class_prefix }}reg f_prediv,
        {{ settings.class_prefix }}reg f_reset,
        {{ settings.class_prefix }}reg f_pwron,
        {{ settings.class_prefix }}reg f_shift,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_divvcor,
        {{ settings.class_prefix }}reg f_r,
        {{ settings.class_prefix }}reg f_p,
        {{ settings.class_prefix }}reg f_divvcop,
        {{ settings.class_prefix }}reg f_enr,
        {{ settings.class_prefix }}reg f_enp,
        longint out_hz,
        longint ref_hz);
    // 写 Inno 共享级 pd、refdiv、fbdiv
    extern task configure_inno_shared(
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_fbdiv,
        int fbdiv,
        int refdiv);
    // 写 Inno postdiv1、postdiv2
    extern task configure_inno_postdiv(
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_postdiv2,
        int postdiv1,
        int postdiv2);
    // write_shared — 为真时重算共享级，否则读回 fbdiv/refdiv
    extern task configure_inno_from_hz(
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_fbdiv,
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_postdiv2,
        longint out_hz,
        longint ref_hz,
        bit write_shared);
    // timeout — 轮询 f_lock 为 1 的最长等待
    extern task wait_lock({{ settings.class_prefix }}reg f_lock, time timeout);
    // 与 note_freq_cfg 记录比对 ref/out 是否均未变
    extern function bit freq_cfg_unchanged(string node_name, longint ref_hz, longint out_hz);
    // 记录节点上次配置的 ref_hz、out_hz
    extern function void note_freq_cfg(string node_name, longint ref_hz, longint out_hz);
endclass

function void {{ settings.class_prefix }}pll_cfg::tci_divisors(
        longint out_hz,
        longint ref_hz,
        output int clkr,
        output int clkf,
        output int clkod,
        output int bwadj);
    clkr = 1;
    clkod = 1;
    if (ref_hz > 0 && out_hz > 0)
        clkf = out_hz / ref_hz;
    else
        clkf = 1;
    bwadj = clkf;
endfunction

function void {{ settings.class_prefix }}pll_cfg::sc_divisors(
        longint out_hz,
        longint ref_hz,
        output int fbdiv,
        output int refdiv,
        output int postdiv1,
        output int postdiv2);
    int refdiv_try;
    int postdiv1_try;
    int postdiv2_try;
    int fbdiv_i;
    longint product;
    longint actual_hz;
    longint err;
    longint best_err;
    real fbdiv_r;
    bit have_best;
    int best_refdiv;
    int best_postdiv1;
    int best_postdiv2;
    int best_fbdiv;
    bit pref_only;
    refdiv = 2;
    postdiv1 = 1;
    postdiv2 = 1;
    fbdiv = 1;
    if (ref_hz <= 0 || out_hz <= 0)
        return;
    have_best = 0;
    pref_only = 1;
    for (refdiv_try = 1; refdiv_try <= 63; refdiv_try++) begin
        for (postdiv1_try = 1; postdiv1_try <= 7; postdiv1_try++) begin
            for (postdiv2_try = 1; postdiv2_try <= 7; postdiv2_try++) begin
                product = refdiv_try * postdiv1_try * postdiv2_try;
                fbdiv_r = real'(out_hz) * real'(product) / real'(ref_hz);
                fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
                if (fbdiv_i < SC_FBDIV_HW_MIN || fbdiv_i > SC_FBDIV_HW_MAX)
                    continue;
                if (pref_only && (fbdiv_i < SC_FBDIV_PREF_MIN || fbdiv_i > SC_FBDIV_PREF_MAX))
                    continue;
                actual_hz = (ref_hz * fbdiv_i) / product;
                err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
                if (!have_best || err < best_err) begin
                    best_err = err;
                    best_fbdiv = fbdiv_i;
                    best_refdiv = refdiv_try;
                    best_postdiv1 = postdiv1_try;
                    best_postdiv2 = postdiv2_try;
                    have_best = 1;
                end
            end
        end
    end
    if (!have_best && pref_only) begin
        pref_only = 0;
        for (refdiv_try = 1; refdiv_try <= 63; refdiv_try++) begin
            for (postdiv1_try = 1; postdiv1_try <= 7; postdiv1_try++) begin
                for (postdiv2_try = 1; postdiv2_try <= 7; postdiv2_try++) begin
                    product = refdiv_try * postdiv1_try * postdiv2_try;
                    fbdiv_r = real'(out_hz) * real'(product) / real'(ref_hz);
                    fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
                    if (fbdiv_i < SC_FBDIV_HW_MIN || fbdiv_i > SC_FBDIV_HW_MAX)
                        continue;
                    actual_hz = (ref_hz * fbdiv_i) / product;
                    err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
                    if (!have_best || err < best_err) begin
                        best_err = err;
                        best_fbdiv = fbdiv_i;
                        best_refdiv = refdiv_try;
                        best_postdiv1 = postdiv1_try;
                        best_postdiv2 = postdiv2_try;
                        have_best = 1;
                    end
                end
            end
        end
    end
    if (have_best) begin
        fbdiv = best_fbdiv;
        refdiv = best_refdiv;
        postdiv1 = best_postdiv1;
        postdiv2 = best_postdiv2;
    end
endfunction

function void {{ settings.class_prefix }}pll_cfg::dw_divisors(
        longint out_hz,
        longint ref_hz,
        output int fbdiv,
        output int prediv,
        output int divvcop,
        output int p,
        output int divvcor,
        output int r);
    int p_try;
    int fbdiv_i;
    longint actual_hz;
    longint err;
    longint best_err;
    real fbdiv_r;
    bit have_best;
    int best_p;
    int best_fbdiv;
    prediv = 0;
    divvcop = 0;
    divvcor = 0;
    r = 4;
    p = 0;
    fbdiv = 1;
    if (ref_hz <= 0 || out_hz <= 0)
        return;
    have_best = 0;
    for (p_try = 0; p_try <= 7; p_try++) begin
        fbdiv_r = real'(out_hz) * real'(p_try + 1) / real'(ref_hz);
        fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
        if (fbdiv_i < DW_FBDIV_MIN || fbdiv_i > DW_FBDIV_MAX)
            continue;
        actual_hz = (ref_hz * fbdiv_i) / (p_try + 1);
        err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
        if (!have_best || err < best_err) begin
            best_err = err;
            best_fbdiv = fbdiv_i;
            best_p = p_try;
            have_best = 1;
        end
    end
    if (have_best) begin
        fbdiv = best_fbdiv;
        p = best_p;
    end
endfunction

task {{ settings.class_prefix }}pll_cfg::configure_sc_from_hz(
        {{ settings.class_prefix }}reg f_vocpd,
        {{ settings.class_prefix }}reg f_postdivpd,
        {{ settings.class_prefix }}reg f_dsmpd,
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_postdiv2,
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_fbdiv,
        longint out_hz,
        longint ref_hz);
    int fbdiv;
    int refdiv;
    int postdiv1;
    int postdiv2;
    sc_divisors(out_hz, ref_hz, fbdiv, refdiv, postdiv1, postdiv2);
    if (fbdiv < SC_FBDIV_PREF_MIN || fbdiv > SC_FBDIV_PREF_MAX)
        `uvm_error("CLK_TREE", $sformatf(
            "pll_sc fbdiv %0d outside preferred [%0d:%0d] for out %0d Hz ref %0d Hz",
            fbdiv, SC_FBDIV_PREF_MIN, SC_FBDIV_PREF_MAX, out_hz, ref_hz))
    configure_sc(
        f_vocpd, f_postdivpd, f_dsmpd, f_pd, f_bypass,
        f_refdiv, f_postdiv2, f_postdiv1, f_fbdiv,
        fbdiv, refdiv, postdiv1, postdiv2);
endtask

function void {{ settings.class_prefix }}pll_cfg::inno_shared_divisors(
        longint out_hz,
        longint ref_hz,
        output int fbdiv,
        output int refdiv);
    int refdiv_try;
    int fbdiv_i;
    longint actual_hz;
    longint err;
    longint best_err;
    real fbdiv_r;
    bit have_best;
    int best_refdiv;
    int best_fbdiv;
    refdiv = 1;
    fbdiv = 1;
    if (ref_hz <= 0 || out_hz <= 0)
        return;
    have_best = 0;
    for (refdiv_try = 1; refdiv_try <= 63; refdiv_try++) begin
        fbdiv_r = real'(out_hz) * real'(refdiv_try) / real'(ref_hz);
        fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
        if (fbdiv_i < 1 || fbdiv_i > 4095)
            continue;
        actual_hz = (ref_hz * fbdiv_i) / refdiv_try;
        err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
        if (!have_best || err < best_err) begin
            best_err = err;
            best_fbdiv = fbdiv_i;
            best_refdiv = refdiv_try;
            have_best = 1;
        end
    end
    if (have_best) begin
        fbdiv = best_fbdiv;
        refdiv = best_refdiv;
    end
endfunction

function void {{ settings.class_prefix }}pll_cfg::inno_postdivisors(
        longint out_hz,
        longint ref_hz,
        int fbdiv,
        int refdiv,
        output int postdiv1,
        output int postdiv2);
    int postdiv1_try;
    int postdiv2_try;
    longint product;
    longint actual_hz;
    longint err;
    longint best_err;
    bit have_best;
    int best_postdiv1;
    int best_postdiv2;
    postdiv1 = 1;
    postdiv2 = 1;
    if (ref_hz <= 0 || out_hz <= 0 || fbdiv < 1 || refdiv < 1)
        return;
    have_best = 0;
    for (postdiv1_try = 1; postdiv1_try <= 7; postdiv1_try++) begin
        for (postdiv2_try = 1; postdiv2_try <= 7; postdiv2_try++) begin
            product = refdiv * postdiv1_try * postdiv2_try;
            if (product < 1)
                continue;
            actual_hz = (ref_hz * fbdiv) / product;
            err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
            if (!have_best || err < best_err) begin
                best_err = err;
                best_postdiv1 = postdiv1_try;
                best_postdiv2 = postdiv2_try;
                have_best = 1;
            end
        end
    end
    if (have_best) begin
        postdiv1 = best_postdiv1;
        postdiv2 = best_postdiv2;
    end
endfunction

task {{ settings.class_prefix }}pll_cfg::configure_inno_shared(
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_fbdiv,
        int fbdiv,
        int refdiv);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];

    rw.set_write(f_pd, 1);

    binds = '{f_pd, f_refdiv, f_fbdiv};
    vals = '{0, refdiv, fbdiv};
    rw.apply(binds, vals);
endtask

task {{ settings.class_prefix }}pll_cfg::configure_inno_postdiv(
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_postdiv2,
        int postdiv1,
        int postdiv2);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];

    binds = '{f_postdiv1, f_postdiv2};
    vals = '{postdiv1, postdiv2};
    rw.apply(binds, vals);
endtask

task {{ settings.class_prefix }}pll_cfg::configure_inno_from_hz(
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_fbdiv,
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_postdiv2,
        longint out_hz,
        longint ref_hz,
        bit write_shared);
    int fbdiv;
    int refdiv;
    int postdiv1;
    int postdiv2;
    if (write_shared)
        inno_shared_divisors(out_hz, ref_hz, fbdiv, refdiv);
    else begin
        rw.read(f_fbdiv, fbdiv);
        rw.read(f_refdiv, refdiv);
    end
    inno_postdivisors(out_hz, ref_hz, fbdiv, refdiv, postdiv1, postdiv2);
    if (write_shared)
        configure_inno_shared(f_pd, f_refdiv, f_fbdiv, fbdiv, refdiv);
    configure_inno_postdiv(f_postdiv1, f_postdiv2, postdiv1, postdiv2);
endtask

task {{ settings.class_prefix }}pll_cfg::configure_dw_from_hz(
        {{ settings.class_prefix }}reg f_fbdiv,
        {{ settings.class_prefix }}reg f_prediv,
        {{ settings.class_prefix }}reg f_reset,
        {{ settings.class_prefix }}reg f_pwron,
        {{ settings.class_prefix }}reg f_shift,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_divvcor,
        {{ settings.class_prefix }}reg f_r,
        {{ settings.class_prefix }}reg f_p,
        {{ settings.class_prefix }}reg f_divvcop,
        {{ settings.class_prefix }}reg f_enr,
        {{ settings.class_prefix }}reg f_enp,
        longint out_hz,
        longint ref_hz);
    int fbdiv;
    int prediv;
    int divvcop;
    int p;
    int divvcor;
    int r;
    dw_divisors(out_hz, ref_hz, fbdiv, prediv, divvcop, p, divvcor, r);
    configure_dw(
        f_fbdiv, f_prediv, f_reset, f_pwron, f_shift, f_bypass,
        f_divvcor, f_r, f_p, f_divvcop, f_enr, f_enp,
        fbdiv, prediv, divvcop, p, divvcor, r);
endtask

task {{ settings.class_prefix }}pll_cfg::configure_tci(
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_pwrdn,
        {{ settings.class_prefix }}reg f_reset,
        {{ settings.class_prefix }}reg f_clkod,
        {{ settings.class_prefix }}reg f_clkf,
        {{ settings.class_prefix }}reg f_clkr,
        {{ settings.class_prefix }}reg f_bwadj,
        int clkr,
        int clkf,
        int clkod,
        int bwadj);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];

    rw.set_write(f_reset, 1);

    binds = '{f_bypass, f_pwrdn, f_clkod, f_clkf, f_clkr, f_bwadj};
    vals = '{1, 0, clkod, clkf, clkr, bwadj};
    rw.apply(binds, vals);

    binds = '{f_reset, f_bypass};
    vals = '{0, 0};
    rw.apply(binds, vals);
endtask

task {{ settings.class_prefix }}pll_cfg::configure_sc(
        {{ settings.class_prefix }}reg f_vocpd,
        {{ settings.class_prefix }}reg f_postdivpd,
        {{ settings.class_prefix }}reg f_dsmpd,
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_postdiv2,
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_fbdiv,
        int fbdiv,
        int refdiv,
        int postdiv1,
        int postdiv2);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];

    binds = '{f_vocpd, f_postdivpd, f_dsmpd, f_pd, f_bypass};
    vals = '{1, 1, 1, 1, 1};
    rw.apply(binds, vals);

    binds = '{f_vocpd, f_postdivpd, f_dsmpd, f_pd, f_bypass,
        f_refdiv, f_postdiv2, f_postdiv1, f_fbdiv};
    vals = '{0, 0, 0, 0, 0, refdiv, postdiv2, postdiv1, fbdiv};
    rw.apply(binds, vals);
endtask

task {{ settings.class_prefix }}pll_cfg::configure_dw(
        {{ settings.class_prefix }}reg f_fbdiv,
        {{ settings.class_prefix }}reg f_prediv,
        {{ settings.class_prefix }}reg f_reset,
        {{ settings.class_prefix }}reg f_pwron,
        {{ settings.class_prefix }}reg f_shift,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_divvcor,
        {{ settings.class_prefix }}reg f_r,
        {{ settings.class_prefix }}reg f_p,
        {{ settings.class_prefix }}reg f_divvcop,
        {{ settings.class_prefix }}reg f_enr,
        {{ settings.class_prefix }}reg f_enp,
        int fbdiv,
        int prediv,
        int divvcop,
        int p,
        int divvcor,
        int r);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];

    binds = '{f_fbdiv, f_prediv};
    vals = '{fbdiv, prediv};
    rw.apply(binds, vals);

    rw.set_write(f_reset, 1);

    binds = '{f_pwron, f_shift, f_bypass};
    vals = '{1, 1, 0};
    rw.apply(binds, vals);
    #4us;

    binds = '{f_reset, f_shift};
    vals = '{0, 0};
    rw.apply(binds, vals);
    #10us;

    binds = '{f_divvcor, f_r, f_p, f_divvcop};
    vals = '{divvcor, r, p, divvcop};
    rw.apply(binds, vals);

    binds = '{f_enr, f_enp};
    vals = '{1, 1};
    rw.apply(binds, vals);
endtask

function bit {{ settings.class_prefix }}pll_cfg::freq_cfg_unchanged(
        string node_name, longint ref_hz, longint out_hz);
    if (!cfg_ref_hz.exists(node_name))
        return 1'b0;
    return cfg_ref_hz[node_name] == ref_hz && cfg_out_hz[node_name] == out_hz;
endfunction

function void {{ settings.class_prefix }}pll_cfg::note_freq_cfg(
        string node_name, longint ref_hz, longint out_hz);
    cfg_ref_hz[node_name] = ref_hz;
    cfg_out_hz[node_name] = out_hz;
endfunction

task {{ settings.class_prefix }}pll_cfg::wait_lock({{ settings.class_prefix }}reg f_lock, time timeout);
    time elapsed;
    int lock_val;

    if (f_lock.field == null)
        `uvm_fatal("CLK_TREE", "wait_lock: f_lock not bound")

    elapsed = 0;
    while (elapsed < timeout) begin
        rw.read(f_lock, lock_val);
        if (lock_val == 1)
            return;
        #2us;
        elapsed += 2us;
    end
    `uvm_fatal("CLK_TREE", $sformatf(
        "wait_lock: %s lock not 1 within %0t", f_lock.field.get_full_name(), timeout))
endtask

`endif
{% endif %}
