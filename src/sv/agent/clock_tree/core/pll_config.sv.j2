task {{ settings.class_prefix }}pll_cfg::configure_tci(
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_pwrdn,
        {{ settings.class_prefix }}reg f_reset,
        {{ settings.class_prefix }}reg f_clkod,
        {{ settings.class_prefix }}reg f_clkf,
        {{ settings.class_prefix }}reg f_clkr,
        {{ settings.class_prefix }}reg f_bwadj,
        bit active,
        int clkr,
        int clkf,
        int clkod,
        int bwadj);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];

    if (!active) begin
        binds = '{f_bypass, f_pwrdn, f_reset};
        vals = '{0, 1, 1};
        rw.apply(binds, vals);
        return;
    end

    rw.set_write(f_reset, 1);

    binds = '{f_bypass, f_pwrdn, f_clkod, f_clkf, f_clkr, f_bwadj};
    vals = '{1, 0, clkod, clkf, clkr, bwadj};
    rw.apply(binds, vals);

    binds = '{f_reset, f_bypass};
    vals = '{0, 0};
    rw.apply(binds, vals);
endtask

