function void {{ settings.class_prefix }}pll_cfg::tci_divisors(
        input longint out_hz,
        input longint ref_hz,
        output int clkr,
        output int clkf,
        output int clkod,
        output int bwadj);
    clkr = 1;
    clkod = 1;
    if (ref_hz > 0 && out_hz > 0)
        clkf = out_hz / ref_hz;
    else
        clkf = 1;
    bwadj = clkf;
endfunction

function bit {{ settings.class_prefix }}pll_cfg::sc_divisors(
        input longint out_hz,
        input longint ref_hz,
        output int fbdiv,
        output int refdiv,
        output int postdiv1,
        output int postdiv2,
        output longint actual_hz,
        output longint pfd_hz,
        output longint vco_hz,
        output real error_ratio);
    int refdiv_try;
    int postdiv1_try;
    int postdiv2_try;
    int neighbor;
    int fbdiv_try;
    int previous_fbdiv;
    longint fbdiv_floor;
    longint fbdiv_candidate;
    longint legal_fbdiv_min;
    longint legal_fbdiv_max;
    longint product;
    longint target_num;
    longint actual_num;
    longint error_num;
    longint compare_lhs;
    longint compare_rhs;
    longint best_actual_num;
    longint best_error_num;
    longint best_product;
    bit have_best;
    bit use_candidate;
    int best_refdiv;
    int best_postdiv1;
    int best_postdiv2;
    int best_fbdiv;
    fbdiv = 0;
    refdiv = 0;
    postdiv1 = 0;
    postdiv2 = 0;
    actual_hz = 0;
    pfd_hz = 0;
    vco_hz = 0;
    error_ratio = 0.0;
    if (ref_hz <= 0 || out_hz <= 0)
        return 1'b0;
    have_best = 0;
    for (refdiv_try = 1; refdiv_try <= 63; refdiv_try++) begin
        if (ref_hz < SC_PFD_MIN_HZ * refdiv_try)
            continue;
        legal_fbdiv_min = (SC_VCO_MIN_HZ * refdiv_try + ref_hz - 1) / ref_hz;
        legal_fbdiv_max = (SC_VCO_MAX_HZ * refdiv_try) / ref_hz;
        if (legal_fbdiv_min < SC_FBDIV_MIN)
            legal_fbdiv_min = SC_FBDIV_MIN;
        if (legal_fbdiv_max > SC_FBDIV_MAX)
            legal_fbdiv_max = SC_FBDIV_MAX;
        if (legal_fbdiv_min > legal_fbdiv_max)
            continue;
        for (postdiv1_try = 1; postdiv1_try <= 7; postdiv1_try++) begin
            for (postdiv2_try = 1; postdiv2_try <= 7; postdiv2_try++) begin
                product = refdiv_try * postdiv1_try * postdiv2_try;
                target_num = out_hz * product;
                fbdiv_floor = target_num / ref_hz;
                previous_fbdiv = -1;
                for (neighbor = 0; neighbor <= 1; neighbor++) begin
                    fbdiv_candidate = fbdiv_floor + neighbor;
                    if (fbdiv_candidate < legal_fbdiv_min)
                        fbdiv_candidate = legal_fbdiv_min;
                    if (fbdiv_candidate > legal_fbdiv_max)
                        fbdiv_candidate = legal_fbdiv_max;
                    fbdiv_try = fbdiv_candidate;
                    if (fbdiv_try == previous_fbdiv)
                        continue;
                    previous_fbdiv = fbdiv_try;
                    actual_num = ref_hz * fbdiv_try;
                    error_num = target_num >= actual_num
                        ? target_num - actual_num : actual_num - target_num;
                    use_candidate = !have_best;
                    if (have_best) begin
                        compare_lhs = error_num * best_product;
                        compare_rhs = best_error_num * product;
                        use_candidate = compare_lhs < compare_rhs;
                        if (compare_lhs == compare_rhs) begin
                            use_candidate = refdiv_try < best_refdiv;
                            if (refdiv_try == best_refdiv) begin
                                use_candidate = actual_num > best_actual_num;
                                if (actual_num == best_actual_num) begin
                                    use_candidate = postdiv1_try < best_postdiv1;
                                    if (postdiv1_try == best_postdiv1)
                                        use_candidate = postdiv2_try < best_postdiv2;
                                end
                            end
                        end
                    end
                    if (use_candidate) begin
                        best_error_num = error_num;
                        best_actual_num = actual_num;
                        best_product = product;
                        best_fbdiv = fbdiv_try;
                        best_refdiv = refdiv_try;
                        best_postdiv1 = postdiv1_try;
                        best_postdiv2 = postdiv2_try;
                        have_best = 1;
                    end
                end
            end
        end
    end
    if (!have_best)
        return 1'b0;
    fbdiv = best_fbdiv;
    refdiv = best_refdiv;
    postdiv1 = best_postdiv1;
    postdiv2 = best_postdiv2;
    actual_hz = best_actual_num / best_product;
    pfd_hz = ref_hz / best_refdiv;
    vco_hz = best_actual_num / best_refdiv;
    error_ratio = real'(best_error_num)
        / (real'(out_hz) * real'(best_product));
    return 1'b1;
endfunction

function void {{ settings.class_prefix }}pll_cfg::resolve_sc_divisors(
        input longint out_hz,
        input longint ref_hz,
        output int fbdiv,
        output int refdiv,
        output int postdiv1,
        output int postdiv2);
    longint actual_hz;
    longint pfd_hz;
    longint vco_hz;
    real error_ratio;
    bit found;
    found = sc_divisors(
        out_hz, ref_hz, fbdiv, refdiv, postdiv1, postdiv2,
        actual_hz, pfd_hz, vco_hz, error_ratio);
    if (!found)
        `uvm_fatal("CLK_TREE", $sformatf(
            {"pll_sc no legal divisors for out %0d Hz ref %0d Hz; ",
             "pfd >= %0d Hz, vco [%0d:%0d] Hz, fbdiv [%0d:%0d]"},
            out_hz, ref_hz, SC_PFD_MIN_HZ, SC_VCO_MIN_HZ, SC_VCO_MAX_HZ,
            SC_FBDIV_MIN, SC_FBDIV_MAX))
    else if (error_ratio > SC_FREQ_TOLERANCE)
        `uvm_fatal("CLK_TREE", $sformatf(
            {"pll_sc best output %0d Hz for target %0d Hz ref %0d Hz ",
             "exceeds tolerance %0.6f; pfd %0d Hz, vco %0d Hz, ",
             "fbdiv %0d, refdiv %0d, postdiv %0d x %0d"},
            actual_hz, out_hz, ref_hz, SC_FREQ_TOLERANCE, pfd_hz, vco_hz,
            fbdiv, refdiv, postdiv1, postdiv2))
endfunction

function void {{ settings.class_prefix }}pll_cfg::dw_divisors(
        input longint out_hz,
        input longint ref_hz,
        output int fbdiv,
        output int prediv,
        output int divvcop,
        output int p,
        output int divvcor,
        output int r);
    int p_try;
    int fbdiv_i;
    longint actual_hz;
    longint err;
    longint best_err;
    real fbdiv_r;
    bit have_best;
    int best_p;
    int best_fbdiv;
    prediv = 0;
    divvcop = 0;
    divvcor = 0;
    r = 4;
    p = 0;
    fbdiv = 1;
    if (ref_hz <= 0 || out_hz <= 0)
        return;
    have_best = 0;
    for (p_try = 0; p_try <= 7; p_try++) begin
        fbdiv_r = real'(out_hz) * real'(p_try + 1) / real'(ref_hz);
        fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
        if (fbdiv_i < DW_FBDIV_MIN || fbdiv_i > DW_FBDIV_MAX)
            continue;
        actual_hz = (ref_hz * fbdiv_i) / (p_try + 1);
        err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
        if (!have_best || err < best_err) begin
            best_err = err;
            best_fbdiv = fbdiv_i;
            best_p = p_try;
            have_best = 1;
        end
    end
    if (have_best) begin
        fbdiv = best_fbdiv;
        p = best_p;
    end
endfunction

task {{ settings.class_prefix }}pll_cfg::configure_sc_from_hz(
        {{ settings.class_prefix }}reg f_vocpd,
        {{ settings.class_prefix }}reg f_postdivpd,
        {{ settings.class_prefix }}reg f_dsmpd,
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_postdiv2,
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_fbdiv,
        bit active,
        longint out_hz,
        longint ref_hz);
    int fbdiv;
    int refdiv;
    int postdiv1;
    int postdiv2;
    if (!active) begin
        configure_sc(
            f_vocpd, f_postdivpd, f_dsmpd, f_pd, f_bypass,
            f_refdiv, f_postdiv2, f_postdiv1, f_fbdiv,
            active, 1, 1, 1, 1);
        return;
    end
    resolve_sc_divisors(out_hz, ref_hz, fbdiv, refdiv, postdiv1, postdiv2);
    configure_sc(
        f_vocpd, f_postdivpd, f_dsmpd, f_pd, f_bypass,
        f_refdiv, f_postdiv2, f_postdiv1, f_fbdiv,
        active, fbdiv, refdiv, postdiv1, postdiv2);
endtask

function void {{ settings.class_prefix }}pll_cfg::inno_shared_divisors(
        input longint out_hz,
        input longint ref_hz,
        input int fbdiv_max,
        output int fbdiv,
        output int refdiv);
    int refdiv_try;
    int fbdiv_i;
    longint actual_hz;
    longint err;
    longint best_err;
    real fbdiv_r;
    bit have_best;
    int best_refdiv;
    int best_fbdiv;
    refdiv = 1;
    fbdiv = 1;
    if (ref_hz <= 0 || out_hz <= 0)
        return;
    have_best = 0;
    for (refdiv_try = 1; refdiv_try <= 63; refdiv_try++) begin
        fbdiv_r = real'(out_hz) * real'(refdiv_try) / real'(ref_hz);
        fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
        if (fbdiv_i < 1 || fbdiv_i > fbdiv_max)
            continue;
        if (!{{ settings.class_prefix }}inno_fbdiv_legal(fbdiv_i))
            continue;
        actual_hz = (ref_hz * fbdiv_i) / refdiv_try;
        err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
        if (!have_best || err < best_err) begin
            best_err = err;
            best_fbdiv = fbdiv_i;
            best_refdiv = refdiv_try;
            have_best = 1;
        end
    end
    if (have_best) begin
        fbdiv = best_fbdiv;
        refdiv = best_refdiv;
    end
endfunction

function void {{ settings.class_prefix }}pll_cfg::inno_postdivisors(
        input longint out_hz,
        input longint ref_hz,
        input int fbdiv,
        input int refdiv,
        output int postdiv1,
        output int postdiv2);
    int postdiv1_try;
    int postdiv2_try;
    longint product;
    longint actual_hz;
    longint err;
    longint best_err;
    bit have_best;
    int best_postdiv1;
    int best_postdiv2;
    postdiv1 = 1;
    postdiv2 = 1;
    if (ref_hz <= 0 || out_hz <= 0 || fbdiv < 1 || refdiv < 1)
        return;
    have_best = 0;
    for (postdiv1_try = 1; postdiv1_try <= 7; postdiv1_try++) begin
        for (postdiv2_try = 1; postdiv2_try <= 7; postdiv2_try++) begin
            product = refdiv * postdiv1_try * postdiv2_try;
            if (product < 1)
                continue;
            actual_hz = (ref_hz * fbdiv) / product;
            err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
            if (!have_best || err < best_err) begin
                best_err = err;
                best_postdiv1 = postdiv1_try;
                best_postdiv2 = postdiv2_try;
                have_best = 1;
            end
        end
    end
    if (have_best) begin
        postdiv1 = best_postdiv1;
        postdiv2 = best_postdiv2;
    end
endfunction

task {{ settings.class_prefix }}pll_cfg::configure_inno_shared(
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_fbdiv,
        bit active,
        int fbdiv,
        int refdiv);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];

    if (!active) begin
        rw.set_write(f_pd, 1);
        return;
    end

    rw.set_write(f_pd, 1);
    binds = '{f_pd, f_refdiv, f_fbdiv};
    vals = '{0, refdiv, fbdiv};
    rw.apply(binds, vals);
endtask

task {{ settings.class_prefix }}pll_cfg::configure_inno_postdiv(
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_postdiv2,
        int postdiv1,
        int postdiv2);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];

    binds = '{f_postdiv1, f_postdiv2};
    vals = '{postdiv1 - 1, postdiv2 - 1};
    rw.apply(binds, vals);
endtask

task {{ settings.class_prefix }}pll_cfg::configure_inno_from_hz(
        {{ settings.class_prefix }}reg f_pd,
        {{ settings.class_prefix }}reg f_refdiv,
        {{ settings.class_prefix }}reg f_fbdiv,
        {{ settings.class_prefix }}reg f_postdiv1,
        {{ settings.class_prefix }}reg f_postdiv2,
        bit active,
        longint out_hz,
        longint ref_hz,
        bit write_shared);
    int fbdiv;
    int refdiv;
    int postdiv1;
    int postdiv2;
    if (!active) begin
        if (write_shared)
            configure_inno_shared(f_pd, f_refdiv, f_fbdiv, active, 1, 1);
        return;
    end
    if (write_shared)
        inno_shared_divisors(
            out_hz, ref_hz, {{ settings.class_prefix }}reg_bound_max(f_fbdiv), fbdiv, refdiv);
    else begin
        rw.read(f_fbdiv, fbdiv);
        rw.read(f_refdiv, refdiv);
    end
    inno_postdivisors(out_hz, ref_hz, fbdiv, refdiv, postdiv1, postdiv2);
    if (write_shared)
        configure_inno_shared(f_pd, f_refdiv, f_fbdiv, active, fbdiv, refdiv);
    configure_inno_postdiv(f_postdiv1, f_postdiv2, postdiv1, postdiv2);
endtask

