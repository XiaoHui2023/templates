`ifndef {{ (settings.class_prefix ~ "pll_cfg") | upper }}
`define {{ (settings.class_prefix ~ "pll_cfg") | upper }}

// Inno fbdiv 不得为 0～7 或 11
function automatic bit {{ settings.class_prefix }}inno_fbdiv_legal(int fbdiv);
    if (fbdiv >= 0 && fbdiv <= 7)
        return 0;
    if (fbdiv == 11)
        return 0;
    return 1;
endfunction

