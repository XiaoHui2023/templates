task {{ settings.class_prefix }}pll_cfg::inno_regs_match_target(
        input {{ settings.class_prefix }}reg f_pd,
        input {{ settings.class_prefix }}reg f_refdiv,
        input {{ settings.class_prefix }}reg f_fbdiv,
        input {{ settings.class_prefix }}reg f_postdiv1,
        input {{ settings.class_prefix }}reg f_postdiv2,
        input longint out_hz,
        input longint ref_hz,
        input bit write_shared,
        input bit active,
        output bit match);
    int fbdiv;
    int refdiv;
    int exp_fbdiv;
    int exp_refdiv;
    int exp_postdiv1;
    int exp_postdiv2;
    int act;
    match = 1'b1;
    rw.read(f_pd, act);
    if (act != !active)
        match = 1'b0;
    if (!active)
        return;
    if (write_shared)
        inno_shared_divisors(
            out_hz, ref_hz, {{ settings.class_prefix }}reg_bound_max(f_fbdiv),
            exp_fbdiv, exp_refdiv);
    else begin
        rw.read(f_fbdiv, fbdiv);
        rw.read(f_refdiv, refdiv);
        exp_fbdiv = fbdiv;
        exp_refdiv = refdiv;
    end
    inno_postdivisors(out_hz, ref_hz, exp_fbdiv, exp_refdiv, exp_postdiv1, exp_postdiv2);
    if (write_shared) begin
        rw.read(f_refdiv, act);
        if (act != exp_refdiv)
            match = 1'b0;
        rw.read(f_fbdiv, act);
        if (act != exp_fbdiv)
            match = 1'b0;
    end
    rw.read(f_postdiv1, act);
    if (act != exp_postdiv1 - 1)
        match = 1'b0;
    rw.read(f_postdiv2, act);
    if (act != exp_postdiv2 - 1)
        match = 1'b0;
endtask

task {{ settings.class_prefix }}pll_cfg::wait_lock({{ settings.class_prefix }}reg f_lock, time timeout);
    time elapsed;
    int lock_val;

    if (f_lock.field == null)
        `uvm_fatal("CLK_TREE", "wait_lock: f_lock not bound")

    elapsed = 0;
    while (elapsed < timeout) begin
        rw.read(f_lock, lock_val);
        if (lock_val == 1)
            return;
        #2us;
        elapsed += 2us;
    end
    `uvm_fatal("CLK_TREE", $sformatf(
        "wait_lock: %s lock not 1 within %0t", f_lock.field.get_full_name(), timeout))
endtask

