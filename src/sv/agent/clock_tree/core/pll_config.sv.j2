task {{ settings.class_prefix }}pll_cfg::configure_dw(
        {{ settings.class_prefix }}reg f_fbdiv,
        {{ settings.class_prefix }}reg f_prediv,
        {{ settings.class_prefix }}reg f_reset,
        {{ settings.class_prefix }}reg f_pwron,
        {{ settings.class_prefix }}reg f_shift,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_divvcor,
        {{ settings.class_prefix }}reg f_r,
        {{ settings.class_prefix }}reg f_p,
        {{ settings.class_prefix }}reg f_divvcop,
        {{ settings.class_prefix }}reg f_enr,
        {{ settings.class_prefix }}reg f_enp,
        bit active,
        int fbdiv,
        int prediv,
        int divvcop,
        int p,
        int divvcor,
        int r);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];

    if (!active) begin
        binds = '{f_reset, f_pwron, f_shift, f_bypass, f_enr, f_enp};
        vals = '{1, 0, 0, 0, 0, 0};
        rw.apply(binds, vals);
        return;
    end

    binds = '{f_fbdiv, f_prediv};
    vals = '{fbdiv, prediv};
