        fbdiv, prediv, divvcop, p, divvcor, r);
endtask

task {{ class_prefix }}pll_cfg::configure_tci(
        {{ class_prefix }}reg_bind f_bypass,
        {{ class_prefix }}reg_bind f_pwrdn,
        {{ class_prefix }}reg_bind f_reset,
        {{ class_prefix }}reg_bind f_clkod,
        {{ class_prefix }}reg_bind f_clkf,
        {{ class_prefix }}reg_bind f_clkr,
        {{ class_prefix }}reg_bind f_bwadj,
        input int clkr,
        input int clkf,
        input int clkod,
        input int bwadj);
    {{ class_prefix }}reg_bind binds[$];
    int vals[$];

    binds = '{f_bypass, f_pwrdn, f_reset};
    vals = '{1, 0, 1};
    rw.apply(binds, vals);

    binds = '{f_clkod, f_clkf, f_clkr, f_bwadj};
    vals = '{clkod, clkf, clkr, bwadj};
    rw.apply(binds, vals);

    binds = '{f_reset};
    vals = '{0};
    rw.apply(binds, vals);

    binds = '{f_bypass};
    vals = '{0};
    rw.apply(binds, vals);
endtask

task {{ class_prefix }}pll_cfg::configure_sc(
        {{ class_prefix }}reg_bind f_vocpd,
        {{ class_prefix }}reg_bind f_postdivpd,
        {{ class_prefix }}reg_bind f_dsmpd,
        {{ class_prefix }}reg_bind f_pd,
        {{ class_prefix }}reg_bind f_bypass,
        {{ class_prefix }}reg_bind f_refdiv,
        {{ class_prefix }}reg_bind f_postdiv2,
        {{ class_prefix }}reg_bind f_postdiv1,
        {{ class_prefix }}reg_bind f_fbdiv,
        input int fbdiv,
        input int refdiv,
        input int postdiv1,
        input int postdiv2);
    {{ class_prefix }}reg_bind binds[$];
    int vals[$];

    binds = '{f_vocpd, f_postdivpd, f_dsmpd, f_pd, f_bypass};
    vals = '{1, 1, 1, 1, 1};
    rw.apply(binds, vals);

    binds = '{f_refdiv, f_postdiv2, f_postdiv1, f_fbdiv};
    vals = '{refdiv, postdiv2, postdiv1, fbdiv};
    rw.apply(binds, vals);

    binds = '{f_vocpd, f_postdivpd, f_dsmpd, f_pd, f_bypass};
    vals = '{0, 0, 0, 0, 0};
    rw.apply(binds, vals);
endtask

task {{ class_prefix }}pll_cfg::configure_dw(
        {{ class_prefix }}reg_bind f_fbdiv,
        {{ class_prefix }}reg_bind f_prediv,
        {{ class_prefix }}reg_bind f_reset,
        {{ class_prefix }}reg_bind f_pwron,
        {{ class_prefix }}reg_bind f_shift,
        {{ class_prefix }}reg_bind f_bypass,
        {{ class_prefix }}reg_bind f_divvcor,
        {{ class_prefix }}reg_bind f_r,
        {{ class_prefix }}reg_bind f_p,
        {{ class_prefix }}reg_bind f_divvcop,
        {{ class_prefix }}reg_bind f_enr,
        {{ class_prefix }}reg_bind f_enp,
        input int fbdiv,
        input int prediv,
        input int divvcop,
        input int p,
        input int divvcor,
        input int r);
    {{ class_prefix }}reg_bind binds[$];
    int vals[$];

    binds = '{f_fbdiv, f_prediv};
    vals = '{fbdiv, prediv};
    rw.apply(binds, vals);

    binds = '{f_reset, f_pwron, f_shift, f_bypass};
    vals = '{1, 1, 1, 0};
    rw.apply(binds, vals);
    #4us;

    binds = '{f_reset};
    vals = '{0};
    rw.apply(binds, vals);
    #16us;

    binds = '{f_shift};
    vals = '{0};
    rw.apply(binds, vals);
    #10us;

    binds = '{f_divvcor, f_r, f_p, f_divvcop};
    vals = '{divvcor, r, p, divvcop};
    rw.apply(binds, vals);

    binds = '{f_enr, f_enp};
    vals = '{1, 1};
    rw.apply(binds, vals);
endtask

task {{ class_prefix }}pll_cfg::wait_lock({{ class_prefix }}reg_bind f_lock, input time timeout);
    time elapsed;
    uvm_status_e status;
    int rdata;
    uvm_reg r;

    if (f_lock.field == null)
        `uvm_fatal("CLK_TREE", "wait_lock: f_lock not bound")

    elapsed = 0;
    while (elapsed < timeout) begin
        r = f_lock.field.get_register();
        r.read(status, rdata);
        if (status != UVM_IS_OK)
            `uvm_fatal("CLK_TREE", $sformatf(
                "wait_lock: read %s failed", r.get_full_name()))
        if (rw.get(f_lock) == 1)
            return;
        #2us;
        elapsed += 2us;
    end
    `uvm_fatal("CLK_TREE", $sformatf(
        "wait_lock: %s lock not 1 within %0t", f_lock.field.get_full_name(), timeout))
endtask

`endif
