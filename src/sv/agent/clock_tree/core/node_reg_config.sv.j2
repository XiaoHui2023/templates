{% if regs_enabled %}
`ifndef {{ (settings.class_prefix ~ "node_cfg") | upper }}
`define {{ (settings.class_prefix ~ "node_cfg") | upper }}

class {{ settings.class_prefix }}node_cfg;
    {{ settings.class_prefix }}reg_rw rw;

    function new({{ settings.class_prefix }}reg_rw reg_rw);
        if (reg_rw == null)
            `uvm_fatal("CLK_TREE", "node_cfg: reg_rw is null")
        rw = reg_rw;
    endfunction

    // open — 仿真门开闭，按极性写入 f_reg
    extern task configure_gate({{ settings.class_prefix }}reg f_reg, bit open);
    // sel — mux 选择值
    extern task configure_mux({{ settings.class_prefix }}reg f_reg, int sel);
    // ratio — 分频比 N，寄存器编码为 N-1
    extern task configure_div(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_div,
        int ratio);
    // ratio — DTO 目标比，转为 step 写入
    extern task configure_dto(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_step,
        int ratio);
endclass

task {{ settings.class_prefix }}node_cfg::configure_gate({{ settings.class_prefix }}reg f_reg, bit open);
{%- if settings.gate_reg_high_means_open %}
    rw.set_write(f_reg, open);
{%- else %}
    rw.set_write(f_reg, !open);
{%- endif %}
endtask

task {{ settings.class_prefix }}node_cfg::configure_mux({{ settings.class_prefix }}reg f_reg, int sel);
    rw.set_write(f_reg, sel);
endtask

task {{ settings.class_prefix }}node_cfg::configure_div(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_div,
        int ratio);
    int n;
    n = {{ settings.class_prefix }}div_ratio_to_n(ratio);
{%- if settings.div_reg_high_means_reset %}
    rw.set_write(f_rst, 1);
    rw.set_write(f_rst, 0);
{%- else %}
    rw.set_write(f_rst, 0);
    rw.set_write(f_rst, 1);
{%- endif %}
    rw.set_write(f_div, n);
    rw.set_write(f_load, 0);
    rw.set_write(f_load, 1);
endtask

task {{ settings.class_prefix }}node_cfg::configure_dto(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_step,
        int ratio);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];
    int step;
    step = {{ settings.class_prefix }}dto_ratio_to_step(ratio);
{%- if settings.dto_reg_high_means_reset %}
    rw.set_write(f_rst, 1);
    rw.set_write(f_rst, 0);
{%- else %}
    rw.set_write(f_rst, 0);
    rw.set_write(f_rst, 1);
{%- endif %}
    binds = '{f_load, f_bypass, f_step};
    vals = '{1, 0, step};
    rw.apply(binds, vals);
endtask

`endif
{% endif %}
