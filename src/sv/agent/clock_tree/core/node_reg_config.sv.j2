`ifndef {{ (settings.class_prefix ~ "node_cfg") | upper }}
`define {{ (settings.class_prefix ~ "node_cfg") | upper }}

class {{ settings.class_prefix }}node_cfg;
    {{ settings.class_prefix }}reg_rw rw;

    function new({{ settings.class_prefix }}reg_rw reg_rw);
        if (reg_rw == null)
            `uvm_fatal("CLK_TREE", "node_cfg: reg_rw is null")
        rw = reg_rw;
    endfunction

    // open — 仿真门开闭，按极性写入 f_reg
    extern task configure_gate({{ settings.class_prefix }}reg f_reg, bit open);
    // inverted — 反相输出电平，按极性写入 f_reg
    extern task configure_inv({{ settings.class_prefix }}reg f_reg, bit inverted);
    // sel — mux 选择值
    extern task configure_mux({{ settings.class_prefix }}reg f_reg, int sel);
    // ratio — 先复位脉冲，再写 div 与 load
    extern task configure_div(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_div,
        int ratio);
    // ratio — rst 写不复位电平并更新 div 与 load
    extern task configure_div_direct(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_div,
        int ratio);
    // ratio — 仅更新 div 与 load 脉冲
    extern task configure_div_ratio(
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_div,
        int ratio);
    // ratio — 先复位脉冲，再写 step、load 与 bypass
    extern task configure_dto(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_step,
        int ratio);
    // ratio — rst 写不复位电平并更新 step、load 与 bypass
    extern task configure_dto_direct(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_step,
        int ratio);
    // ratio — 仅更新 step、load 与 bypass
    extern task configure_dto_ratio(
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_step,
        int ratio);
    // Ensure the final load write creates a rising edge.
    extern task prepare_dto_load_edge({{ settings.class_prefix }}reg f_load);
    // rst_val — 读回的 rst 位是否为 div 已释放、非复位电平
    extern function bit div_rst_released_val(int rst_val);
    // rst_val — 读回的 rst 位是否为 dto 已释放、非复位电平
    extern function bit dto_rst_released_val(int rst_val);
    // f_reg、sel — 读回 mux sel 是否与目标相同
    extern task mux_sel_matches({{ settings.class_prefix }}reg f_reg, int sel, output bit match);
    // f_rst、f_div、ratio — 读回 div 是否已与目标 ratio 一致且 rst 已释放
    extern task div_regs_match_ratio(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_div,
        int ratio,
        output bit match);
    // f_rst — 读回 div rst 是否已为释放电平
    extern task div_rst_released({{ settings.class_prefix }}reg f_rst, output bit released);
    // f_rst — 读回 dto rst 是否已为释放电平
    extern task dto_rst_released({{ settings.class_prefix }}reg f_rst, output bit released);
endclass

task {{ settings.class_prefix }}node_cfg::configure_gate({{ settings.class_prefix }}reg f_reg, bit open);
{%- if settings.gate_reg_high_means_open %}
    rw.set_write(f_reg, open);
{%- else %}
    rw.set_write(f_reg, !open);
{%- endif %}
endtask

task {{ settings.class_prefix }}node_cfg::configure_inv({{ settings.class_prefix }}reg f_reg, bit inverted);
{%- if settings.inv_reg_high_means_inverted %}
    rw.set_write(f_reg, inverted);
{%- else %}
    rw.set_write(f_reg, !inverted);
{%- endif %}
endtask

task {{ settings.class_prefix }}node_cfg::configure_mux(
        {{ settings.class_prefix }}reg f_reg,
        int sel);
    rw.set_write(f_reg, sel);
endtask

task {{ settings.class_prefix }}node_cfg::configure_div(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_div,
        int ratio);
    int n;
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];
    n = {{ settings.class_prefix }}div_ratio_to_n(f_div, ratio);
{%- if settings.div_reg_high_means_reset %}
    rw.set_write(f_rst, 1);
    binds = '{f_rst, f_div, f_load};
    vals = '{0, n, 0};
{%- else %}
    rw.set_write(f_rst, 0);
    binds = '{f_rst, f_div, f_load};
    vals = '{1, n, 0};
{%- endif %}
    rw.apply(binds, vals);
    rw.set_write(f_load, 1);
endtask

task {{ settings.class_prefix }}node_cfg::configure_div_direct(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_div,
        int ratio);
    int n;
    n = {{ settings.class_prefix }}div_ratio_to_n(f_div, ratio);
{%- if settings.div_reg_high_means_reset %}
    rw.set_write(f_rst, 0);
{%- else %}
    rw.set_write(f_rst, 1);
{%- endif %}
    rw.set_write(f_div, n);
    rw.set_write(f_load, 0);
    rw.set_write(f_load, 1);
endtask

task {{ settings.class_prefix }}node_cfg::configure_div_ratio(
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_div,
        int ratio);
    int n;
    n = {{ settings.class_prefix }}div_ratio_to_n(f_div, ratio);
    rw.set_write(f_div, n);
    rw.set_write(f_load, 0);
    rw.set_write(f_load, 1);
endtask

task {{ settings.class_prefix }}node_cfg::configure_dto(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_step,
        int ratio);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];
    int step;
{%- if settings.dto_reg_high_means_reset %}
    rw.set_write(f_rst, 1);
{%- else %}
    rw.set_write(f_rst, 0);
{%- endif %}
    prepare_dto_load_edge(f_load);
    if ({{ settings.class_prefix }}dto_ratio_is_bypass(ratio)) begin
        binds = '{f_rst, f_load, f_bypass, f_step};
{%- if settings.dto_reg_high_means_reset %}
        vals = '{0, 1, 1, 0};
{%- else %}
        vals = '{1, 1, 1, 0};
{%- endif %}
    end else begin
        step = {{ settings.class_prefix }}dto_ratio_to_step(ratio);
        binds = '{f_rst, f_load, f_bypass, f_step};
{%- if settings.dto_reg_high_means_reset %}
        vals = '{0, 1, 0, step};
{%- else %}
        vals = '{1, 1, 0, step};
{%- endif %}
    end
    rw.apply(binds, vals);
endtask

task {{ settings.class_prefix }}node_cfg::configure_dto_direct(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_step,
        int ratio);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];
    int step;
{%- if settings.dto_reg_high_means_reset %}
    rw.set_write(f_rst, 0);
{%- else %}
    rw.set_write(f_rst, 1);
{%- endif %}
    prepare_dto_load_edge(f_load);
    if ({{ settings.class_prefix }}dto_ratio_is_bypass(ratio)) begin
        binds = '{f_load, f_bypass, f_step};
        vals = '{1, 1, 0};
        rw.apply(binds, vals);
    end else begin
        step = {{ settings.class_prefix }}dto_ratio_to_step(ratio);
        binds = '{f_load, f_bypass, f_step};
        vals = '{1, 0, step};
        rw.apply(binds, vals);
    end
endtask

task {{ settings.class_prefix }}node_cfg::configure_dto_ratio(
        {{ settings.class_prefix }}reg f_load,
        {{ settings.class_prefix }}reg f_bypass,
        {{ settings.class_prefix }}reg f_step,
        int ratio);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];
    int step;
    prepare_dto_load_edge(f_load);
    if ({{ settings.class_prefix }}dto_ratio_is_bypass(ratio)) begin
        binds = '{f_load, f_bypass, f_step};
        vals = '{1, 1, 0};
        rw.apply(binds, vals);
    end else begin
        step = {{ settings.class_prefix }}dto_ratio_to_step(ratio);
        binds = '{f_load, f_bypass, f_step};
        vals = '{1, 0, step};
        rw.apply(binds, vals);
    end
endtask

task {{ settings.class_prefix }}node_cfg::prepare_dto_load_edge(
        {{ settings.class_prefix }}reg f_load);
    int load_val;
    rw.read(f_load, load_val);
    if (load_val != 0)
        rw.set_write(f_load, 0);
endtask

function bit {{ settings.class_prefix }}node_cfg::div_rst_released_val(int rst_val);
{%- if settings.div_reg_high_means_reset %}
    return rst_val == 0;
{%- else %}
    return rst_val == 1;
{%- endif %}
endfunction

function bit {{ settings.class_prefix }}node_cfg::dto_rst_released_val(int rst_val);
{%- if settings.dto_reg_high_means_reset %}
    return rst_val == 0;
{%- else %}
    return rst_val == 1;
{%- endif %}
endfunction

task {{ settings.class_prefix }}node_cfg::mux_sel_matches(
        {{ settings.class_prefix }}reg f_reg,
        int sel,
        output bit match);
    int cur;
    rw.read(f_reg, cur);
    match = cur == sel;
endtask

task {{ settings.class_prefix }}node_cfg::div_regs_match_ratio(
        {{ settings.class_prefix }}reg f_rst,
        {{ settings.class_prefix }}reg f_div,
        int ratio,
        output bit match);
    int rst_val;
    int div_val;
    int exp_n;
    exp_n = {{ settings.class_prefix }}div_ratio_to_n(f_div, ratio);
    rw.read(f_rst, rst_val);
    rw.read(f_div, div_val);
    match = div_rst_released_val(rst_val) && div_val == exp_n;
endtask

task {{ settings.class_prefix }}node_cfg::div_rst_released(
        {{ settings.class_prefix }}reg f_rst,
        output bit released);
    int rst_val;
    rw.read(f_rst, rst_val);
    released = div_rst_released_val(rst_val);
endtask

task {{ settings.class_prefix }}node_cfg::dto_rst_released(
        {{ settings.class_prefix }}reg f_rst,
        output bit released);
    int rst_val;
    rw.read(f_rst, rst_val);
    released = dto_rst_released_val(rst_val);
endtask

`endif
