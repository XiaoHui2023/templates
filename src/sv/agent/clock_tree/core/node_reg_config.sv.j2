`ifndef {{ (class_prefix ~ "node_cfg") | upper }}
`define {{ (class_prefix ~ "node_cfg") | upper }}

class {{ class_prefix }}node_cfg;
    {{ class_prefix }}reg_rw reg;

    function new({{ class_prefix }}reg_rw reg_rw);
        if (reg_rw == null)
            `uvm_fatal("CLK_TREE", "node_cfg: reg_rw is null")
        reg = reg_rw;
    endfunction

    extern task configure_gate({{ class_prefix }}reg_bind f_reg, input bit open);
    extern task configure_mux({{ class_prefix }}reg_bind f_reg, input int sel);
    extern task configure_div(
        {{ class_prefix }}reg_bind f_rst,
        {{ class_prefix }}reg_bind f_load,
        {{ class_prefix }}reg_bind f_div,
        input int ratio);
    extern task configure_dto(
        {{ class_prefix }}reg_bind f_rstn,
        {{ class_prefix }}reg_bind f_load,
        {{ class_prefix }}reg_bind f_bypass,
        {{ class_prefix }}reg_bind f_step,
        input int ratio);
endclass

task {{ class_prefix }}node_cfg::configure_gate({{ class_prefix }}reg_bind f_reg, input bit open);
    reg.set_write(f_reg, open);
endtask

task {{ class_prefix }}node_cfg::configure_mux({{ class_prefix }}reg_bind f_reg, input int sel);
    reg.set_write(f_reg, sel);
endtask

task {{ class_prefix }}node_cfg::configure_div(
        {{ class_prefix }}reg_bind f_rst,
        {{ class_prefix }}reg_bind f_load,
        {{ class_prefix }}reg_bind f_div,
        input int ratio);
    int n;
    n = {{ class_prefix }}div_ratio_to_n(ratio);
    reg.set_write(f_rst, 0);
    reg.set_write(f_div, n);
    reg.set_write(f_load, 0);
    reg.set_write(f_load, 1);
endtask

task {{ class_prefix }}node_cfg::configure_dto(
        {{ class_prefix }}reg_bind f_rstn,
        {{ class_prefix }}reg_bind f_load,
        {{ class_prefix }}reg_bind f_bypass,
        {{ class_prefix }}reg_bind f_step,
        input int ratio);
    {{ class_prefix }}reg_bind binds[$];
    int vals[$];
    int step;
    step = {{ class_prefix }}dto_ratio_to_step(ratio);
    binds = '{f_rstn, f_load, f_bypass, f_step};
    vals = '{0, 1, 0, step};
    reg.apply(binds, vals);
endtask

`endif
