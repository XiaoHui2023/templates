`ifndef {{ (settings.class_prefix ~ "trees") | upper }}
`define {{ (settings.class_prefix ~ "trees") | upper }}

{%- for tree in trees %}
class {{ settings.class_prefix }}{{ tree.name }}_tree extends {{ settings.class_prefix }}tree_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}{{ tree.name }}_tree)
{%- for node in tree.nodes_ordered %}
{%- set field_flags = "UVM_ALL_ON" if node.kind in ["clk", "pll", "source"] else "UVM_ALL_ON | UVM_NOPRINT" %}
{%- if node.sv_is_array %}
        `uvm_field_sarray_object({{ node.name }}, {{ field_flags }})
{%- else %}
        `uvm_field_object({{ node.name }}, {{ field_flags }})
{%- endif %}
{%- endfor %}
    `uvm_object_utils_end

{%- for node in tree.nodes_ordered %}
{%- if node.kind == "pll" %}
{%- if node.sv_is_array %}
    rand {{ settings.class_prefix }}{{ node.sv_pll_class }} {{ node.name }}[{{ node.output_count }}];
{%- else %}
    rand {{ settings.class_prefix }}{{ node.sv_pll_class }} {{ node.name }};
{%- endif %}
{%- elif node.sv_is_array %}
    rand {{ settings.class_prefix }}{{ node.kind }} {{ node.name }}[{{ node.output_count }}];
{%- else %}
    rand {{ settings.class_prefix }}{{ node.kind }} {{ node.name }};
{%- endif %}
{%- endfor %}

    constraint cst_base;
    constraint cst_user;
    constraint cst_case;

    // Create node objects, connect sources, and populate tree queues.
    function new(string name="{{ settings.class_prefix }}{{ tree.name }}_tree");
        super.new(name);
{%- for node in tree.nodes_ordered %}
{%- if node.sv_is_array %}
{%- for i in range(node.output_count) %}
        {{ node.name }}[{{ i }}] = {{ settings.class_prefix }}{% if node.kind == "pll" %}{{ node.sv_pll_class }}{% else %}{{ node.kind }}{% endif %}::type_id::create($sformatf("{{ node.name }}[%0d]", {{ i }}));
        {{ node.name }}[{{ i }}].group_id = {{ i }};
{%- endfor %}
{%- for i in range(node.output_count) %}
{%- for j in range(node.output_count) %}
{%- if i != j %}
        {{ node.name }}[{{ i }}].to_group[{{ j }}] = {{ node.name }}[{{ j }}];
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- elif node.kind == "pll" %}
        {{ node.name }} = {{ settings.class_prefix }}{{ node.sv_pll_class }}::type_id::create("{{ node.name }}");
{%- else %}
        {{ node.name }} = {{ settings.class_prefix }}{{ node.kind }}::type_id::create("{{ node.name }}");
{%- endif %}
{%- endfor %}
{%- for node in tree.nodes_ordered %}
{%- for src in node.sources %}
{%- set peer = tree.nodes[src.name] %}
{%- set peer_oc = peer.output_count if peer.kind == "pll" else 1 %}
{%- if peer_oc > 1 %}
{%- set peer_access = src.name ~ '[' ~ src.out_idx ~ ']' %}
{%- else %}
{%- set peer_access = src.name %}
{%- endif %}
{%- if node.sv_is_array %}
{%- for i in range(node.output_count) %}
        {{ node.name }}[{{ i }}].source = {{ peer_access }};
{%- endfor %}
{%- elif node.kind == "mux" %}
        {{ node.name }}.to_source[{{ src.key }}] = {{ peer_access }};
{%- else %}
        {{ node.name }}.source = {{ peer_access }};
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- for node in tree.nodes_ordered %}
{%- if node.freq is not none %}
{%- if node.kind in ["clk", "pll", "source"] %}
{%- if node.sv_is_array %}
{%- for i in range(node.output_count) %}
        {{ node.name }}[{{ i }}].frequence = {{ node.freq }};
{%- if node.kind == "clk" %}
        {{ node.name }}[{{ i }}].enabled = {{ 1 if node.freq > 0 else 0 }};
{%- endif %}
{%- endfor %}
{%- else %}
        {{ node.name }}.frequence = {{ node.freq }};
{%- if node.kind == "clk" %}
        {{ node.name }}.enabled = {{ 1 if node.freq > 0 else 0 }};
{%- endif %}
{%- endif %}
{%- endif %}
{%- endif %}
{%- if node.kind == "mux" %}
        {{ node.name }}.max_sel = {{ node.mux_max_sel }};
{%- endif %}
{%- endfor %}
        nodes.delete();
{%- for slot in tree.sv_slots %}
        nodes.push_back({{ slot.access }});
{%- endfor %}
        clock_nodes.delete();
        foreach (nodes[i]) begin
            {{ settings.class_prefix }}clk clk_nd;
            if ($cast(clk_nd, nodes[i]))
                clock_nodes.push_back(clk_nd);
        end
    endfunction

    // Bind node register fields when a register model is provided.
    extern function void build({% if regs_enabled %}{{ settings.class_regmodel }} regmodel = null{% endif %});
endclass

function void {{ settings.class_prefix }}{{ tree.name }}_tree::build({% if regs_enabled %}{{ settings.class_regmodel }} regmodel{% endif %});
{%- if regs_enabled %}
    if (regmodel != null) begin
{%- for tree_name, sv_access, member, path, offset, width in reg_bindings %}
{%- if tree_name == tree.name %}
        {{ sv_access }}.{{ member }}.field = regmodel.{{ path }};
        {{ sv_access }}.{{ member }}.offset = {{ offset if offset is not none else 0 }};
{%- if width is none %}
        {{ sv_access }}.{{ member }}.width = {{ sv_access }}.{{ member }}.field.get_n_bits();
{%- else %}
        {{ sv_access }}.{{ member }}.width = {{ width }};
{%- endif %}
{%- endif %}
{%- endfor %}
    end
{%- endif %}
endfunction

{%- endfor %}
`endif
