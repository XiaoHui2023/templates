`ifndef {{ (settings.class_prefix ~ "trees") | upper }}
`define {{ (settings.class_prefix ~ "trees") | upper }}

{%- for tree in trees %}
class {{ settings.class_prefix }}{{ tree.name }}_tree extends {{ settings.class_prefix }}base_tree;
    `uvm_object_utils_begin({{ settings.class_prefix }}{{ tree.name }}_tree)
{%- for node in tree.nodes_ordered %}
        `uvm_field_object({{ node.name }}, UVM_ALL_ON)
{%- endfor %}
    `uvm_object_utils_end

{%- for node in tree.nodes_ordered %}
{%- if node.kind == "pll" %}
    rand {{ settings.class_prefix }}{{ node.sv_pll_class }} {{ node.name }};
{%- else %}
    rand {{ settings.class_prefix }}{{ node.kind }} {{ node.name }};
{%- endif %}
{%- endfor %}

    constraint cst_base;
    constraint cst_sys;
    constraint cst_user;
    constraint cst_case;

    function new(string name="{{ settings.class_prefix }}{{ tree.name }}_tree");
        super.new(name);
{%- for node in tree.nodes_ordered %}
{%- if node.kind == "pll" %}
        {{ node.name }} = {{ settings.class_prefix }}{{ node.sv_pll_class }}::type_id::create("{{ node.name }}");
{%- else %}
        {{ node.name }} = {{ settings.class_prefix }}{{ node.kind }}::type_id::create("{{ node.name }}");
{%- endif %}
{%- endfor %}
{%- for node in tree.nodes_ordered %}
{%- for src in node.sources %}
{%- if node.kind == "mux" %}
        {{ node.name }}.to_source[{{ src.key }}] = {{ src.name }};
{%- else %}
        {{ node.name }}.source = {{ src.name }};
{%- endif %}
{%- endfor %}
{%- endfor %}
        nodes.delete();
{%- for node in tree.nodes_ordered %}
        nodes.push_back({{ node.name }});
{%- endfor %}
    endfunction

    extern function void build({% if regs_enabled %}{{ settings.class_regmodel }} regmodel = null{% endif %});
endclass

function void {{ settings.class_prefix }}{{ tree.name }}_tree::build({% if regs_enabled %}{{ settings.class_regmodel }} regmodel{% endif %});
{%- if regs_enabled %}
{%- for tree_name, node_name, member, path, offset, width in reg_bindings %}
{%- if tree_name == tree.name %}
    if (regmodel != null) begin
        {{ node_name }}.{{ member }}.field = regmodel.{{ path }};
        {{ node_name }}.{{ member }}.offset = {{ offset if offset is not none else 0 }};
{%- if width is none %}
        {{ node_name }}.{{ member }}.width = {{ node_name }}.{{ member }}.field.get_n_bits();
{%- else %}
        {{ node_name }}.{{ member }}.width = {{ width }};
{%- endif %}
    end
{%- endif %}
{%- endfor %}
{%- endif %}
    if (!this.randomize())
        `uvm_fatal("CLK_TREE", "{{ settings.class_prefix }}{{ tree.name }}_tree build randomize failed")
endfunction

{%- endfor %}
`endif
