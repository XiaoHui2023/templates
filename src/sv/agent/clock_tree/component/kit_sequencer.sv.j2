{% endif %}
endclass

{% if any_node_path %}
task {{ class_prefix }}kit_sequencer::set_clock_gen(
        {{ class_prefix }}node_base nodes[$], bit gen_en);
    if (nodes.size() == 0) begin
        if (tree == null)
            `uvm_fatal("CLK_TREE", "set_clock_gen: nodes empty and tree is null")
        set_clock_gen(tree.nodes, gen_en);
        return;
    end

    foreach (nodes[i]) begin
        {{ class_prefix }}set_clock_gen_req req;
        {{ class_prefix }}set_clock_gen_seq seq;
        {{ class_prefix }}set_clock_gen_rsp seq_rsp;

        if (nodes[i] == null)
            continue;
        if (nodes[i].vif == null)
            continue;

        req = {{ class_prefix }}set_clock_gen_req::type_id::create("req");
        req.node = nodes[i];
        req.gen_en = gen_en;

        seq = {{ class_prefix }}set_clock_gen_seq::type_id::create("set_clock_gen");
        seq.req = req;
        seq.start(this);
        seq_rsp = seq.rsp;
        if (seq_rsp != null && !seq_rsp.ok)
            `uvm_fatal("CLK_TREE", $sformatf(
                "set_clock_gen: node %s failed", nodes[i].get_name()))
    end
endtask
{% endif %}

