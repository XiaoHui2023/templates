`ifndef {{ (settings.class_prefix ~ "kit_sequencer") | upper }}
`define {{ (settings.class_prefix ~ "kit_sequencer") | upper }}

class {{ settings.class_prefix }}kit_sequencer extends {{ settings.class_prefix }}sequencer;
    `uvm_component_utils({{ settings.class_prefix }}kit_sequencer)

    {{ settings.class_prefix }}tree_base tree;

    function new(string name="{{ settings.class_prefix }}kit_sequencer", uvm_component parent=null);
        super.new(name, parent);
    endfunction

    // 按树节点写寄存器
    extern task config_reg({{ settings.class_prefix }}tree_base tree = null);
    // 校验频率与占空比
    extern task check_measure(
        {{ settings.class_prefix }}tree_base tree = null,
        bit check_clk = 1'b1,
        bit check_cell = 1'b1,
        bit check_freq = 1'b1,
        bit check_duty = 1'b1,
        bit debug = 1'b0);
    // 写寄存器后校验频率与占空比
    extern task test_measure(
        {{ settings.class_prefix }}tree_base tree = null,
        bit check_clk = 1'b1,
        bit check_cell = 1'b1,
        bit check_freq = 1'b1,
        bit check_duty = 1'b1,
        bit debug = 1'b0);
    // 检查控制器件的寄存器功能
    extern task test_flip(
        {{ settings.class_prefix }}tree_base tree = null,
        bit debug = 1'b0);
    // 检查器件之间的 RTL 连线
    // tree — 时钟树句柄，空则用 kit.tree
    extern task test_route(
        {{ settings.class_prefix }}tree_base tree = null,
        bit debug = 1'b0);
endclass

task {{ settings.class_prefix }}kit_sequencer::config_reg(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}config_reg_req req;
    {{ settings.class_prefix }}config_reg_rsp seq_rsp;
    {{ settings.class_prefix }}config_reg_seq seq;

    if (tree == null)
        tree = this.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "config_reg: tree is null")

    req = {{ settings.class_prefix }}config_reg_req::type_id::create("req");
    req.tree = tree;

    seq = {{ settings.class_prefix }}config_reg_seq::type_id::create("config_reg");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok)
        `uvm_fatal("CLK_TREE", "config_reg: operation failed")
endtask

