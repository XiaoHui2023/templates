    if (nodes.size() == 0) begin
        if (tree == null)
            `uvm_fatal("CLK_TREE", "config_reg: nodes empty and tree is null")
        config_reg(tree.nodes);
        return;
    end

    req = {{ class_prefix }}config_reg_req::type_id::create("req");
    req.nodes = nodes;

    seq = {{ class_prefix }}config_reg_seq::type_id::create("config_reg");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok)
        `uvm_fatal("CLK_TREE", "config_reg: operation failed")
endtask

