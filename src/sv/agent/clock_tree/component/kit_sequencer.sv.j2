`ifndef {{ (class_prefix ~ "kit_sequencer") | upper }}
`define {{ (class_prefix ~ "kit_sequencer") | upper }}

class {{ class_prefix }}kit_sequencer extends {{ class_prefix }}sequencer;
    `uvm_component_utils({{ class_prefix }}kit_sequencer)

    {{ class_prefix }}base_tree trees[$];

    function new(string name="{{ class_prefix }}kit_sequencer", uvm_component parent=null);
        super.new(name, parent);
    endfunction

{% if setting_defs %}
    extern function void apply_settings({{ class_prefix }}settings settings = null);
{% endif %}
    extern function void set_clock_gen(
        {{ class_prefix }}node_base nodes[$], bit gen_en = 1'b1);
    extern function void gen_source_clock();
    extern function {{ class_prefix }}set_pll_rsp set_pll({{ class_prefix }}pll node);
    extern function {{ class_prefix }}configure_rsp configure({{ class_prefix }}node_base nodes[$]);
    extern function {{ class_prefix }}check_clk_rsp check_clk({{ class_prefix }}node_base nodes[$]);
    extern function {{ class_prefix }}check_pll_rsp check_pll({{ class_prefix }}node_base nodes[$]);
    extern function {{ class_prefix }}check_duty_rsp check_duty({{ class_prefix }}node_base nodes[$]);
    extern function {{ class_prefix }}test_duty_wavefront_rsp test_duty_wavefront(
        {{ class_prefix }}node_base nodes[$]);
endclass

{% if setting_defs %}
function void {{ class_prefix }}kit_sequencer::apply_settings({{ class_prefix }}settings settings);
    if (settings == null) begin
        if (trees.size() == 0)
            `uvm_fatal("CLK_TREE", "apply_settings: settings null and no trees")
        foreach (trees[i]) begin
            if (trees[i] == null)
                `uvm_fatal("CLK_TREE", "apply_settings: tree is null")
            if (trees[i].settings == null)
                `uvm_fatal("CLK_TREE", $sformatf(
                    "apply_settings: tree %s settings is null", trees[i].get_name()))
            apply_settings(trees[i].settings);
        end
        return;
    end
    super.apply_settings(settings);
endfunction
{% endif %}

function void {{ class_prefix }}kit_sequencer::set_clock_gen(
        {{ class_prefix }}node_base nodes[$], bit gen_en);
    if (nodes.size() == 0) begin
        if (trees.size() == 0)
            `uvm_fatal("CLK_TREE", "set_clock_gen: nodes empty and no trees")
        foreach (trees[i])
            set_clock_gen(trees[i].nodes, gen_en);
        return;
    end

    foreach (nodes[i]) begin
        {{ class_prefix }}set_clock_gen_req req;
        {{ class_prefix }}set_clock_gen_rsp rsp;
        {{ class_prefix }}set_clock_gen_seq seq;

        if (nodes[i] == null)
            continue;
        if (nodes[i].vif == null)
            continue;

        req = {{ class_prefix }}set_clock_gen_req::type_id::create("req");
        req.node = nodes[i];
        req.gen_en = gen_en;

        seq = {{ class_prefix }}set_clock_gen_seq::type_id::create("set_clock_gen");
        seq.req = req;
        seq.start(this);
        void'(seq.get_response(rsp));
    end
endfunction

function void {{ class_prefix }}kit_sequencer::gen_source_clock();
    {{ class_prefix }}source src;
    {{ class_prefix }}node_base src_nodes[$];

    foreach (trees[i]) begin
        foreach (trees[i].nodes[j]) begin
            if ($cast(src, trees[i].nodes[j]))
                src_nodes.push_back(src);
        end
    end
    set_clock_gen(src_nodes, 1'b1);
endfunction

function {{ class_prefix }}set_pll_rsp {{ class_prefix }}kit_sequencer::set_pll(
        {{ class_prefix }}pll node);
    {{ class_prefix }}set_pll_req req;
    {{ class_prefix }}set_pll_rsp rsp;
    {{ class_prefix }}set_pll_seq seq;

    if (node == null)
        `uvm_fatal("CLK_TREE", "set_pll: node is null")

    req = {{ class_prefix }}set_pll_req::type_id::create("req");
    req.node = node;

    seq = {{ class_prefix }}set_pll_seq::type_id::create("set_pll");
    seq.req = req;
    seq.start(this);
    void'(seq.get_response(rsp));
    return rsp;
endfunction

function {{ class_prefix }}configure_rsp {{ class_prefix }}kit_sequencer::configure(
        {{ class_prefix }}node_base nodes[$]);
    {{ class_prefix }}configure_req req;
    {{ class_prefix }}configure_rsp rsp;
    {{ class_prefix }}configure_seq seq;

    if (nodes.size() == 0) begin
        if (trees.size() == 0)
            `uvm_fatal("CLK_TREE", "configure: nodes empty and no trees")
        foreach (trees[i])
            rsp = configure(trees[i].nodes);
        return rsp;
    end

    req = {{ class_prefix }}configure_req::type_id::create("req");
    req.nodes = nodes;

    seq = {{ class_prefix }}configure_seq::type_id::create("configure");
    seq.req = req;
    seq.start(this);
    void'(seq.get_response(rsp));
    return rsp;
endfunction

