`ifndef {{ (settings.class_prefix ~ "kit_sequencer") | upper }}
`define {{ (settings.class_prefix ~ "kit_sequencer") | upper }}

class {{ settings.class_prefix }}kit_sequencer extends {{ settings.class_prefix }}sequencer;
    `uvm_component_utils({{ settings.class_prefix }}kit_sequencer)

    {{ settings.class_prefix }}tree_base tree;

    function new(string name="{{ settings.class_prefix }}kit_sequencer", uvm_component parent=null);
        super.new(name, parent);
    endfunction

{% if regs_enabled %}
    extern task config_reg({{ settings.class_prefix }}tree_base tree = null);
{% endif %}
{% if any_node_path %}
    extern task check_freq({{ settings.class_prefix }}node_base nodes[$] = {});
    extern task check_duty({{ settings.class_prefix }}node_base nodes[$] = {});
{% endif %}
{% if route_test_enabled %}
    extern task check_flip({{ settings.class_prefix }}node_base nodes[$] = {});
    extern task test_route({{ settings.class_prefix }}tree_base tree = null);
{% endif %}
endclass

{% if regs_enabled %}
task {{ settings.class_prefix }}kit_sequencer::config_reg(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}config_reg_req req;
    {{ settings.class_prefix }}config_reg_rsp seq_rsp;
    {{ settings.class_prefix }}config_reg_seq seq;

    if (tree == null)
        tree = this.tree;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "config_reg: tree is null")

    req = {{ settings.class_prefix }}config_reg_req::type_id::create("req");
    req.tree = tree;

    seq = {{ settings.class_prefix }}config_reg_seq::type_id::create("config_reg");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok)
        `uvm_fatal("CLK_TREE", "config_reg: operation failed")
endtask
{% endif %}

{% if any_node_path %}
task {{ settings.class_prefix }}kit_sequencer::check_freq({{ settings.class_prefix }}node_base nodes[$]);
    {{ settings.class_prefix }}check_freq_req req;
    {{ settings.class_prefix }}check_freq_rsp seq_rsp;
    {{ settings.class_prefix }}check_freq_seq seq;

    if (nodes.size() == 0) begin
        if (tree == null)
            `uvm_fatal("CLK_TREE", "check_freq: nodes empty and tree is null")
        check_freq(tree.nodes);
        return;
    end

    req = {{ settings.class_prefix }}check_freq_req::type_id::create("req");
    req.nodes = nodes;

    seq = {{ settings.class_prefix }}check_freq_seq::type_id::create("check_freq");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok)
        `uvm_fatal("CLK_TREE", "check_freq: operation failed")
endtask

task {{ settings.class_prefix }}kit_sequencer::check_duty({{ settings.class_prefix }}node_base nodes[$]);
    {{ settings.class_prefix }}check_duty_req req;
    {{ settings.class_prefix }}check_duty_rsp seq_rsp;
    {{ settings.class_prefix }}check_duty_seq seq;

    if (nodes.size() == 0) begin
        if (tree == null)
            `uvm_fatal("CLK_TREE", "check_duty: nodes empty and tree is null")
        check_duty(tree.nodes);
        return;
    end

    req = {{ settings.class_prefix }}check_duty_req::type_id::create("req");
    req.nodes = nodes;

    seq = {{ settings.class_prefix }}check_duty_seq::type_id::create("check_duty");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok)
        `uvm_fatal("CLK_TREE", "check_duty: operation failed")
endtask
{% endif %}

{% if route_test_enabled %}
task {{ settings.class_prefix }}kit_sequencer::check_flip(
        {{ settings.class_prefix }}node_base nodes[$]);
    {{ settings.class_prefix }}check_flip_req req;
    {{ settings.class_prefix }}check_flip_rsp seq_rsp;
    {{ settings.class_prefix }}check_flip_seq seq;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "check_flip: tree is null")

    req = {{ settings.class_prefix }}check_flip_req::type_id::create("req");
    req.nodes = nodes;
    req.tree = tree;

    seq = {{ settings.class_prefix }}check_flip_seq::type_id::create("check_flip");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok)
        `uvm_fatal("CLK_TREE", "check_flip: operation failed")
endtask

task {{ settings.class_prefix }}kit_sequencer::test_route(
        {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}test_route_req req;
    {{ settings.class_prefix }}test_route_rsp seq_rsp;
    {{ settings.class_prefix }}test_route_seq seq;

    req = {{ settings.class_prefix }}test_route_req::type_id::create("req");
    req.tree = tree;
    if (req.tree == null)
        req.tree = this.tree;
    if (req.tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null")

    seq = {{ settings.class_prefix }}test_route_seq::type_id::create(
        "test_route");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok)
        `uvm_fatal("CLK_TREE", "test_route: operation failed")
endtask
{% endif %}

`endif
