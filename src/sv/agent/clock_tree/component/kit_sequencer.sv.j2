    extern function void gen_source_clock();
{% endif %}
    extern function {{ class_prefix }}set_pll_rsp set_pll({{ class_prefix }}base_pll node);
    extern function {{ class_prefix }}configure_rsp configure({{ class_prefix }}node_base nodes[$]);
{% if any_node_path %}
