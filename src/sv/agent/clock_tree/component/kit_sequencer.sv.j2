task {{ settings.class_prefix }}kit_sequencer::test_route(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base always_active_clk_nodes[$]);
    {{ settings.class_prefix }}test_route_req req;
    {{ settings.class_prefix }}test_route_rsp seq_rsp;
    {{ settings.class_prefix }}test_route_seq seq;

    req = {{ settings.class_prefix }}test_route_req::type_id::create("req");
    req.tree = tree;
    if (req.tree == null)
        req.tree = this.tree;
    if (req.tree == null)
        `uvm_fatal("CLK_TREE", "test_route: tree is null")
    req.always_active_clk_nodes = always_active_clk_nodes;

    seq = {{ settings.class_prefix }}test_route_seq::type_id::create(
        "test_route");
    seq.req = req;
    seq.start(this);
    seq_rsp = seq.rsp;
    if (seq_rsp != null && !seq_rsp.ok)
        `uvm_fatal("CLK_TREE", "test_route: operation failed")
endtask
{% endif %}

`endif
