`ifndef {{ (class_prefix ~ "kit_sequencer") | upper }}
`define {{ (class_prefix ~ "kit_sequencer") | upper }}

class {{ class_prefix }}kit_sequencer extends {{ class_prefix }}sequencer;
    `uvm_component_utils({{ class_prefix }}kit_sequencer)

    {{ class_prefix }}base_tree tree;

    function new(string name="{{ class_prefix }}kit_sequencer", uvm_component parent=null);
        super.new(name, parent);
    endfunction

{% if any_node_path %}
    extern task set_clock_gen(
        {{ class_prefix }}node_base nodes[$] = {}, bit gen_en = 1'b1);
{% endif %}
    extern task config_reg({{ class_prefix }}node_base nodes[$] = {});
{% if any_node_path %}
    extern task check_clk({{ class_prefix }}node_base nodes[$] = {});
    extern task check_pll({{ class_prefix }}node_base nodes[$] = {});
    extern task check_duty({{ class_prefix }}node_base nodes[$] = {});
