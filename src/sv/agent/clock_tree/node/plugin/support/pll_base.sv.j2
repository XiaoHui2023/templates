`ifndef {{ (settings.class_prefix ~ "pll_base") | upper }}
`define {{ (settings.class_prefix ~ "pll_base") | upper }}

class {{ settings.class_prefix }}pll_base extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}pll_base)
        `uvm_field_int(frequence, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(enabled, UVM_ALL_ON | (enabled >= 0 ? 0 : UVM_NOPRINT))
    `uvm_object_utils_end

    longint frequence;
    int enabled;
    pll_kind_e pll_kind;
    bit locked;

    constraint cst_pll {
        enabled == 0 -> !_resolved_active;
        enabled > 0 && source == null -> _resolved_active;
        enabled > 0 && source != null -> _resolved_active == source._resolved_active;
        enabled < 0 && source == null -> _resolved_active;
        enabled < 0 && source != null -> _resolved_active == source._resolved_active;
        _resolved_active -> _resolved_freq == frequence;
        !_resolved_active -> _resolved_freq == 0;
    }

    constraint cst_resolve_freq_from_src {
    }

    constraint cst_resolve_active_from_src {
    }

    // 初始化 PLL 的非强制活动状态。
    function new(string name = "");
        super.new(name);
        frequence = 0;
        enabled = -1;
        kind = "pll";
    endfunction
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Keeps PLL timing under RTL control during transition checks.
    virtual function bit preserves_native_input();
        return 1'b1;
    endfunction
`endif

    // PLL 最先配置，供下游节点使用稳定输出。
    virtual function int configuration_priority();
        return 100;
    endfunction

    // PLL 配置后需要等待 lock。
    virtual function bit waits_after_configuration();
        return 1'b1;
    endfunction

    // Delegate PLL encoding to the plugin service.
    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        {{ settings.class_prefix }}plugin_configuration plugin_cfg;
        plugin_cfg = new(cfg.tools, cfg.quiet);
        plugin_cfg.configure_pll(this, configured);
    endtask

    // 等待当前 PLL 的 lock 状态。
    virtual task await_configuration(input {{ settings.class_prefix }}node_config_api cfg);
        {{ settings.class_prefix }}plugin_configuration plugin_cfg;
        plugin_cfg = new(cfg.tools, cfg.quiet);
        plugin_cfg.wait_for_pll_lock(this);
    endtask
endclass

`endif
