`ifndef {{ (settings.class_prefix ~ "ratio_base") | upper }}
`define {{ (settings.class_prefix ~ "ratio_base") | upper }}
{%- set div_freq_tol_num, div_freq_tol_den = plugin_fraction("divider", "freq_tolerance", 0.01) %}
{%- set div_freq_tol_lo = div_freq_tol_den - div_freq_tol_num %}
{%- set div_freq_tol_hi = div_freq_tol_den + div_freq_tol_num %}

class {{ settings.class_prefix }}ratio_base extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}ratio_base)
        `uvm_field_int(_resolved_ratio, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(ratio, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(unfix_ratio, UVM_DEFAULT|UVM_DEC|(_should_print ? 0 : UVM_NOPRINT))
    `uvm_object_utils_end

    rand int _resolved_ratio;
    int ratio;
    bit unfix_ratio;

    constraint cst_ratio {
        !(unfix_ratio || ratio < 0) -> ratio == _resolved_ratio;
    }

    constraint cst_resolve_freq_from_src {
        source != null && _resolved_ratio > 0 -> {
            _resolved_freq >= (source._resolved_freq / _resolved_ratio) * {{ div_freq_tol_lo }} / {{ div_freq_tol_den }};
            _resolved_freq <= (source._resolved_freq / _resolved_ratio) * {{ div_freq_tol_hi }} / {{ div_freq_tol_den }};
        }
    }

    // Starts with an unconstrained ratio.
    function new(string name = "");
        super.new(name);
        ratio = -1;
        unfix_ratio = 1'b1;
    endfunction

    // Makes the input available for synchronous configuration controls.
    virtual function void plan_configuration(
            {{ settings.class_prefix }}config_context context_h,
            {{ settings.class_prefix }}config_action target);
        require_source(context_h, target);
    endfunction

    // Uses the programmed ratio rather than the constraint tolerance band.
    virtual function real clock_rate_hz();
        if (source == null || _resolved_ratio <= 0)
            return 0.0;
        return source.clock_rate_hz() / real'(_resolved_ratio);
    endfunction

    // Skips branches without an observable descendant.
    virtual function bit requires_observed_descendant();
        return 1'b1;
    endfunction

endclass

`endif
