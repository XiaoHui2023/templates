`ifndef {{ (settings.class_prefix ~ "frequency_synth_base") | upper }}
`define {{ (settings.class_prefix ~ "frequency_synth_base") | upper }}

class {{ settings.class_prefix }}frequency_synth_base extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}frequency_synth_base)
        `uvm_field_int(frequence, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(enabled, UVM_ALL_ON | (enabled >= 0 ? 0 : UVM_NOPRINT))
    `uvm_object_utils_end

    longint frequence;
    int enabled;
    bit locked;

    constraint cst_pll {
        enabled == 0 -> !_resolved_active;
        enabled > 0 && source == null -> _resolved_active;
        enabled > 0 && source != null -> _resolved_active == source._resolved_active;
        enabled < 0 && source == null -> _resolved_active;
        enabled < 0 && source != null -> _resolved_active == source._resolved_active;
        _resolved_active -> _resolved_freq == frequence;
        !_resolved_active -> _resolved_freq == 0;
    }

    constraint cst_resolve_freq_from_src {
    }

    constraint cst_resolve_active_from_src {
    }

    // Starts with activity determined by graph constraints.
    function new(string name = "");
        super.new(name);
        frequence = 0;
        enabled = -1;
    endfunction
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Retains native timing during transition checks.
    virtual function bit preserves_native_input();
        return 1'b1;
    endfunction
`endif

    // Provides a programmable final operating state.
    virtual function bit has_configuration(); return configuration_is_bound(); endfunction

    // Power-down must follow all temporary consumers.
    virtual function bit configuration_preserves_availability(); return _resolved_active; endfunction

    // Reports whether all power and frequency controls are accessible.
    virtual function bit configuration_is_bound(); return 1'b0; endfunction

    // Validates programmable supply before any configuration writes.
    virtual function void plan_requirement(
            {{ settings.class_prefix }}config_context context_h,
            {{ settings.class_prefix }}config_lease lease_h);
        {{ settings.class_prefix }}reg field_h;
        field_h = lock_reg();
        if (!configuration_is_bound() || frequence <= 0 || field_h == null || !field_h.is_bound()) begin
            context_h.fail($sformatf("%s cannot satisfy availability requirement", get_name()));
            return;
        end
        super.plan_requirement(context_h, lease_h);
    endfunction

    // Requires a running reference while programming an active target.
    virtual function void plan_configuration(
            {{ settings.class_prefix }}config_context context_h,
            {{ settings.class_prefix }}config_action target);
        {{ settings.class_prefix }}config_lease reference_h;
        if (_resolved_active && source != null) begin
            reference_h = context_h.require_available(source, target);
            context_h.after_action(target, reference_h.ready);
        end
    endfunction

    // Applies the final operating state without changing resolved members.
    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        program_configuration(cfg, _resolved_active, configured);
    endtask

    // Confirms active targets even when register values already match.
    virtual task execute_configuration(
            input {{ settings.class_prefix }}config_context context_h,
            input int token);
        bit configured;
        if (token != 0)
            `uvm_fatal("CLK_TREE", "unknown synthesis configuration action")
        apply_configuration(context_h.io, configured);
        if (_resolved_active)
            await_configuration(context_h.io);
    endtask

    // Programs hardware-specific frequency and power controls.
    virtual task program_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            input bit active,
            output bit configured);
        configured = 1'b0;
        `uvm_fatal("CLK_TREE", "frequency provider has no programming implementation")
    endtask

    // Makes the programmed output available until its lease ends.
    virtual task acquire_requirement(
            input {{ settings.class_prefix }}config_context context_h,
            input {{ settings.class_prefix }}config_lease lease_h);
        bit configured;
        {{ settings.class_prefix }}reg field_h;
        field_h = lock_reg();
        if (field_h == null || !field_h.is_bound())
            `uvm_fatal("CLK_TREE", $sformatf("%s cannot confirm frequency-provider readiness", get_name()))
        if (lease_h.has_target && _resolved_active)
            return;
        program_configuration(context_h.io, 1'b1, configured);
        await_configuration(context_h.io);
    endtask

    // A synthesizer owns its rate and cannot inherit its reference rate.
    virtual function real clock_rate_hz();
        return real'(frequence);
    endfunction

    // Returns the optional lock field.
    virtual function {{ settings.class_prefix }}reg lock_reg(); return null; endfunction

    // Polls the declared lock field within the configured timeout.
    virtual task await_configuration(input {{ settings.class_prefix }}node_config_api cfg);
        {{ settings.class_prefix }}reg field_h;
        time elapsed;
        int lock_value;
        field_h = lock_reg();
        if (field_h == null || !field_h.is_bound())
            return;
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: %s wait lock", get_name()), UVM_HIGH)
        elapsed = 0;
        while (elapsed < {{ plugin_value("pll", "lock_timeout_us", 100) }}us) begin
            cfg.read_reg(field_h, lock_value);
            if (lock_value == 1) begin
                locked = 1'b1;
                return;
            end
            #2us;
            elapsed += 2us;
        end
        `uvm_fatal("CLK_TREE", $sformatf(
            "wait_lock: %s lock not 1 within %0t",
            field_h.field.get_full_name(), {{ plugin_value("pll", "lock_timeout_us", 100) }}us))
    endtask
endclass

`endif
