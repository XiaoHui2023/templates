// 按 Inno PLL 目标频率写配置
task {{ settings.class_prefix }}plugin_configuration::config_reg_pll_inno_node({{ settings.class_prefix }}pll_inno pll_inno_nd, output bit configured);
    longint ref_hz;
    bit write_shared;
    bit active;
    bit reg_match;

    configured = 1'b0;
    active = pll_inno_nd._resolved_active;
    if (active && pll_inno_nd.source == null)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s has no source for ref frequency", pll_inno_nd.get_name()))
    if (active && pll_inno_nd.frequence <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s frequence must be positive", pll_inno_nd.get_name()))
    ref_hz = active ? pll_inno_nd.source._resolved_freq : 0;
    if (active && ref_hz <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s source %s frequence must be positive",
            pll_inno_nd.get_name(), pll_inno_nd.source.get_name()))
    if (!pll_inno_nd.f_pd.is_bound() || !pll_inno_nd.f_lock.is_bound()
            || !pll_inno_nd.f_refdiv.is_bound() || !pll_inno_nd.f_fbdiv.is_bound()
            || !pll_inno_nd.f_postdiv1.is_bound() || !pll_inno_nd.f_postdiv2.is_bound())
        return;
    write_shared = pll_inno_nd.group_id == "{{ plugin_value("pll_inno", "primary_group", "0") }}";
    pll.inno_regs_match_target(
        pll_inno_nd.f_pd, pll_inno_nd.f_refdiv, pll_inno_nd.f_fbdiv,
        pll_inno_nd.f_postdiv1, pll_inno_nd.f_postdiv2,
        pll_inno_nd.frequence, ref_hz, write_shared, active, reg_match);
    if (reg_match) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_inno %s skip reg match out %0d Hz ref %0d Hz",
                pll_inno_nd.get_name(), pll_inno_nd.frequence, ref_hz), UVM_MEDIUM)
        return;
    end
    if (!active) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_inno %s active 0", pll_inno_nd.get_name()), UVM_MEDIUM)
        pll.configure_inno_from_hz(
            pll_inno_nd.f_pd, pll_inno_nd.f_refdiv, pll_inno_nd.f_fbdiv,
            pll_inno_nd.f_postdiv1, pll_inno_nd.f_postdiv2,
            active, pll_inno_nd.frequence, ref_hz, write_shared);
        return;
    end
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: pll_inno %s out %0d Hz ref %s %0d Hz group %0d",
            pll_inno_nd.get_name(), pll_inno_nd.frequence, pll_inno_nd.source.get_name(),
            ref_hz, pll_inno_nd.group_id), UVM_MEDIUM)
    pll.configure_inno_from_hz(
        pll_inno_nd.f_pd, pll_inno_nd.f_refdiv, pll_inno_nd.f_fbdiv,
        pll_inno_nd.f_postdiv1, pll_inno_nd.f_postdiv2,
        active, pll_inno_nd.frequence, ref_hz, write_shared);
    configured = active;
endtask

// 按具体 PLL 类型分派配置流程
task {{ settings.class_prefix }}plugin_configuration::config_reg_pll_node({{ settings.class_prefix }}pll_base pll_nd, output bit configured);
    longint ref_hz;
    int clkr;
    int clkf;
    int clkod;
    int bwadj;
    {{ settings.class_prefix }}pll_tci pll_tci_nd;
    {{ settings.class_prefix }}pll_sc pll_sc_nd;
    {{ settings.class_prefix }}pll_dw pll_dw_nd;
    {{ settings.class_prefix }}pll_inno pll_inno_nd;

    configured = 1'b0;
    if (!pll_nd._resolved_active && pll_nd.enabled != 0) begin
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s skip not valid", pll_nd.get_name()), UVM_MEDIUM)
        return;
    end
    if ($cast(pll_inno_nd, pll_nd)) begin
        config_reg_pll_inno_node(pll_inno_nd, configured);
        return;
    end
    if ($cast(pll_sc_nd, pll_nd)) begin
        config_reg_pll_sc_node(pll_sc_nd, configured);
        return;
    end
    if ($cast(pll_dw_nd, pll_nd)) begin
        config_reg_pll_dw_node(pll_dw_nd, configured);
        return;
    end
    if (pll_nd._resolved_active && pll_nd.source == null)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s has no source for ref frequency", pll_nd.get_name()))
    if (pll_nd._resolved_active && pll_nd.frequence <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s frequence must be positive", pll_nd.get_name()))
    ref_hz = pll_nd._resolved_active ? pll_nd.source._resolved_freq : 0;
    if (pll_nd._resolved_active && ref_hz <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s source %s frequence must be positive",
            pll_nd.get_name(), pll_nd.source.get_name()))
    if ($cast(pll_tci_nd, pll_nd)) begin
        bit reg_match;
        if (!pll_tci_nd.f_bypass.is_bound() || !pll_tci_nd.f_pwrdn.is_bound()
                || !pll_tci_nd.f_reset.is_bound() || !pll_tci_nd.f_clkod.is_bound()
                || !pll_tci_nd.f_clkf.is_bound() || !pll_tci_nd.f_clkr.is_bound()
                || !pll_tci_nd.f_bwadj.is_bound())
            return;
        pll.tci_regs_match_target(
            pll_tci_nd.f_bypass, pll_tci_nd.f_pwrdn, pll_tci_nd.f_reset, pll_tci_nd.f_clkod,
            pll_tci_nd.f_clkf, pll_tci_nd.f_clkr, pll_tci_nd.f_bwadj,
            pll_tci_nd.frequence, ref_hz, pll_nd._resolved_active, reg_match);
        if (reg_match) begin
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "config_reg: pll_tci %s skip reg match out %0d Hz ref %0d Hz",
                    pll_tci_nd.get_name(), pll_tci_nd.frequence, ref_hz), UVM_MEDIUM)
            return;
        end
        if (!pll_nd._resolved_active) begin
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "config_reg: pll_tci %s active 0", pll_tci_nd.get_name()), UVM_MEDIUM)
            pll.configure_tci(
                pll_tci_nd.f_bypass, pll_tci_nd.f_pwrdn, pll_tci_nd.f_reset,
                pll_tci_nd.f_clkod, pll_tci_nd.f_clkf, pll_tci_nd.f_clkr,
                pll_tci_nd.f_bwadj, 1'b0, 1, 1, 1, 1);
            return;
        end
        pll.tci_divisors(
            pll_tci_nd.frequence, ref_hz, clkr, clkf, clkod, bwadj);
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_tci %s out %0d Hz ref %s %0d Hz clkr %0d clkf %0d clkod %0d bwadj %0d",
                pll_tci_nd.get_name(), pll_tci_nd.frequence, pll_nd.source.get_name(), ref_hz,
                clkr, clkf, clkod, bwadj), UVM_MEDIUM)
        pll.configure_tci(
            pll_tci_nd.f_bypass, pll_tci_nd.f_pwrdn, pll_tci_nd.f_reset, pll_tci_nd.f_clkod,
            pll_tci_nd.f_clkf, pll_tci_nd.f_clkr, pll_tci_nd.f_bwadj,
            pll_nd._resolved_active, clkr, clkf, clkod, bwadj);
        configured = pll_nd._resolved_active;
    end else
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s is not pll_tci, pll_sc, pll_dw, or pll_inno", pll_nd.get_name()))
endtask

// 等待单个 PLL 锁定
task {{ settings.class_prefix }}plugin_configuration::wait_pll_lock_node({{ settings.class_prefix }}pll_base pll_nd);
    {{ settings.class_prefix }}pll_tci pll_tci_nd;
    {{ settings.class_prefix }}pll_sc pll_sc_nd;
    {{ settings.class_prefix }}pll_dw pll_dw_nd;
    {{ settings.class_prefix }}pll_inno pll_inno_nd;

    if ($cast(pll_inno_nd, pll_nd)) begin
        if (pll_inno_nd.group_id != "{{ plugin_value("pll_inno", "primary_group", "0") }}")
            return;
        if (!pll_inno_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        pll.wait_lock(pll_inno_nd.f_lock, {{ plugin_value("pll", "lock_timeout_us", 100) }}us);
    end else if ($cast(pll_tci_nd, pll_nd)) begin
        if (!pll_tci_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        pll.wait_lock(pll_tci_nd.f_lock, {{ plugin_value("pll", "lock_timeout_us", 100) }}us);
    end else if ($cast(pll_sc_nd, pll_nd)) begin
        if (!pll_sc_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        pll.wait_lock(pll_sc_nd.f_lock, {{ plugin_value("pll", "lock_timeout_us", 100) }}us);
    end else if ($cast(pll_dw_nd, pll_nd)) begin
        if (!pll_dw_nd.f_lock.is_bound())
            return;
        if (!quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll %s wait lock", pll_nd.get_name()), UVM_MEDIUM)
        pll.wait_lock(pll_dw_nd.f_lock, {{ plugin_value("pll", "lock_timeout_us", 100) }}us);
    end else
        `uvm_fatal("CLK_TREE", $sformatf(
            "config_reg: pll %s is not pll_tci, pll_sc, pll_dw, or pll_inno", pll_nd.get_name()))
    pll_nd.locked = 1'b1;
endtask

// 写 inv 的反相/直通控制
task {{ settings.class_prefix }}plugin_configuration::config_reg_inv_node(
        {{ settings.class_prefix }}inv_base inv_nd);
    config_reg_inv_node_reg(inv_nd, inv_nd.inverted);
endtask

task {{ settings.class_prefix }}plugin_configuration::config_reg_inv_node_reg(
        {{ settings.class_prefix }}inv_base inv_nd,
        bit reg_inverted);
    if (!inv_nd.f_reg.is_bound())
        return;
    if (!quiet)
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: inv %s inverted %0b", inv_nd.get_name(), reg_inverted),
            UVM_MEDIUM)
    node.configure_inv(inv_nd.f_reg, reg_inverted);
endtask

