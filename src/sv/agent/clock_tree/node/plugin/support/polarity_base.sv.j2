`ifndef {{ (settings.class_prefix ~ "polarity_base") | upper }}
`define {{ (settings.class_prefix ~ "polarity_base") | upper }}

class {{ settings.class_prefix }}polarity_base extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}polarity_base)
        `uvm_field_int(inverted, UVM_ALL_ON)
        `uvm_field_int(fix_inverted, UVM_DEFAULT|(_should_print ? 0 : UVM_NOPRINT))
    `uvm_object_utils_end

    rand bit inverted;
    bit fix_inverted;
    bit _hardwired;
    bit _fixed_inverted;
    {{ settings.class_prefix }}reg f_reg;

    virtual function activity_e default_output_activity(
            output {{ settings.class_prefix }}node_base upstream);
        upstream = source;
        return ACTIVITY_AUTO;
    endfunction

    constraint cst_resolve_active_from_src {
        source != null -> _resolved_active == source._resolved_active;
    }

    constraint cst_resolve_freq_from_src {
        source != null -> _resolved_freq == source._resolved_freq;
    }

    constraint cst_inv {
        fix_inverted -> inverted;
        _hardwired -> inverted == _fixed_inverted;
    }

    // Starts in the inverted state.
    function new(string name = "");
        super.new(name);
        inverted = 1'b1;
        fix_inverted = 0;
        f_reg = new();
    endfunction

    // Provides a register-controlled polarity.
    virtual function bit has_configuration(); return f_reg.is_bound(); endfunction

    function bit encode_polarity(bit invert_output);
        return {{ "invert_output" if plugin_value("inverter", "reg_high_means_inverted", true) else "!invert_output" }};
    endfunction

    // Writes the selected polarity when its register is bound.
    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        configured = f_reg.is_bound();
        if (!configured)
            return;
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: %s inverted %0b", get_name(), inverted), UVM_LOW)
        cfg.write_reg(f_reg, encode_polarity(inverted));
    endtask
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Allows the restored polarity control to propagate before input release.
    virtual task restore_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            input {{ settings.class_prefix }}reg_snapshot saved);
        saved.restore(cfg);
        {{ settings.class_prefix }}time_domain::delay_ns({{ plugin_value("inverter", "settle_ns", 100) }});
    endtask

    // Declares an isolated inverter transition check.
    virtual function bit has_functional_contract();
        return 1'b1;
    endfunction

    // Checks direct and inverted levels after each polarity write.
    virtual task exercise_functional_contract(
            input {{ settings.class_prefix }}node_test_api api,
            output bit did_check,
            output bit did_skip,
            output int failures);
        virtual {{ settings.class_prefix }}interface in_vif;
        virtual {{ settings.class_prefix }}interface out_vif;
        real input_hz;
        bit passed;
        bit inverted_mode;
        string label;

        did_check = 1'b0;
        did_skip = 1'b0;
        failures = 0;
        in_vif = get_in_vif();
        out_vif = get_out_vif();
        if (api == null || api.cfg == null || in_vif == null || out_vif == null
                || !f_reg.is_bound()) begin
            did_skip = 1'b1;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip %s, missing interface or reg",
                get_name()), UVM_LOW)
            return;
        end
        prepare_functional_clock(api, source, "", 1_000_000_000, input_hz);
        if (input_hz <= 0.0) begin
            did_skip = 1'b1;
            failures++;
            return;
        end
        `uvm_info("CLK_TREE", $sformatf("test_flip: test %s", get_name()), UVM_LOW)
        for (int mode = 0; mode < 2; mode++) begin
            inverted_mode = bit'(mode);
            label = {get_name(), inverted_mode ? ".out inverted" : ".out direct"};
            api.cfg.write_reg(f_reg, encode_polarity(inverted_mode));
            {{ settings.class_prefix }}time_domain::delay_ns({{ plugin_value("inverter", "settle_ns", 100) }});
            api.check_polarity(in_vif, out_vif, label, input_hz, inverted_mode, passed);
            if (!passed) failures++;
            check_output(api, out_vif, label, input_hz, passed);
            if (!passed) failures++;
        end
        did_check = 1'b1;
    endtask
`endif
endclass

`endif
