`ifndef {{ (settings.class_prefix ~ "polarity_base") | upper }}
`define {{ (settings.class_prefix ~ "polarity_base") | upper }}

class {{ settings.class_prefix }}polarity_base extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}polarity_base)
        `uvm_field_int(inverted, UVM_ALL_ON)
        `uvm_field_int(fix_inverted, UVM_DEFAULT|(_should_print ? 0 : UVM_NOPRINT))
    `uvm_object_utils_end

    rand bit inverted;
    bit fix_inverted;
    {{ settings.class_prefix }}reg f_reg;

    constraint cst_resolve_active_from_src {
        source != null -> _resolved_active == source._resolved_active;
    }

    constraint cst_resolve_freq_from_src {
        source != null -> _resolved_freq == source._resolved_freq;
    }

    constraint cst_inv {
        fix_inverted -> inverted;
    }

    // Starts in the inverted state.
    function new(string name = "");
        super.new(name);
        inverted = 1'b1;
        fix_inverted = 0;
        f_reg = new();
    endfunction

    // Provides a register-controlled polarity.
    virtual function bit has_configuration(); return f_reg.is_bound(); endfunction

    // Writes the selected polarity when its register is bound.
    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        configured = f_reg.is_bound();
        if (!configured)
            return;
        if (!cfg.quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: %s inverted %0b", get_name(), inverted), UVM_MEDIUM)
{%- if plugin_value("inverter", "reg_high_means_inverted", true) %}
        cfg.write_reg(f_reg, inverted);
{%- else %}
        cfg.write_reg(f_reg, !inverted);
{%- endif %}
    endtask
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Declares an isolated inverter transition check.
    virtual function bit has_functional_contract();
        return 1'b1;
    endfunction

    // Checks direct and inverted levels after each polarity write.
    virtual task run_functional_contract(
            input {{ settings.class_prefix }}node_test_api api,
            output bit did_check,
            output bit did_skip,
            output int failures);
        virtual {{ settings.class_prefix }}interface in_vif;
        virtual {{ settings.class_prefix }}interface out_vif;
        bit configured;

        did_check = 1'b0;
        did_skip = 1'b0;
        failures = 0;
        in_vif = get_in_vif();
        out_vif = get_out_vif();
        if (api == null || api.cfg == null || in_vif == null || out_vif == null
                || !f_reg.is_bound()) begin
            did_skip = 1'b1;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip %s, missing interface or reg",
                get_name()), UVM_LOW)
            return;
        end
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: test %s", get_name()), UVM_LOW)
{%- if plugin_value("inverter", "reg_high_means_inverted", true) %}
        api.cfg.write_reg(f_reg, 1'b0);
{%- else %}
        api.cfg.write_reg(f_reg, 1'b1);
{%- endif %}
        #({{ plugin_value("inverter", "settle_ns", 100) }}ns);
        in_vif.drive_static(1'b0);
        #1ns;
        if (out_vif.in !== 1'b0) begin
            failures++;
            `uvm_error("CLK_TREE", $sformatf(
                "test_flip: %s direct input 0 output %0b", get_name(), out_vif.in))
        end
        in_vif.drive_static(1'b1);
        #1ns;
        if (out_vif.in !== 1'b1) begin
            failures++;
            `uvm_error("CLK_TREE", $sformatf(
                "test_flip: %s direct input 1 output %0b", get_name(), out_vif.in))
        end
{%- if plugin_value("inverter", "reg_high_means_inverted", true) %}
        api.cfg.write_reg(f_reg, 1'b1);
{%- else %}
        api.cfg.write_reg(f_reg, 1'b0);
{%- endif %}
        #({{ plugin_value("inverter", "settle_ns", 100) }}ns);
        in_vif.drive_static(1'b0);
        #1ns;
        if (out_vif.in !== 1'b1) begin
            failures++;
            `uvm_error("CLK_TREE", $sformatf(
                "test_flip: %s inverted input 0 output %0b", get_name(), out_vif.in))
        end
        in_vif.drive_static(1'b1);
        #1ns;
        if (out_vif.in !== 1'b0) begin
            failures++;
            `uvm_error("CLK_TREE", $sformatf(
                "test_flip: %s inverted input 1 output %0b", get_name(), out_vif.in))
        end
        in_vif.release_drive();
        did_check = 1'b1;
    endtask
`endif
endclass

`endif
