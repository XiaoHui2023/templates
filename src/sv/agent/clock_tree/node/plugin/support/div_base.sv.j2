`ifndef {{ (settings.class_prefix ~ "div_base") | upper }}
`define {{ (settings.class_prefix ~ "div_base") | upper }}
{%- set div_freq_tol_num, div_freq_tol_den = plugin_fraction("divider", "freq_tolerance", 0.01) %}
{%- set div_freq_tol_lo = div_freq_tol_den - div_freq_tol_num %}
{%- set div_freq_tol_hi = div_freq_tol_den + div_freq_tol_num %}

class {{ settings.class_prefix }}div_base extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}div_base)
        `uvm_field_int(_resolved_ratio, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(ratio, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(unfix_ratio, UVM_DEFAULT|UVM_DEC|(_print_fix?0:UVM_NOPRINT))
    `uvm_object_utils_end

    div_kind_e div_kind;
    rand int _resolved_ratio;
    int ratio;
    bit unfix_ratio;

    constraint cst_ratio {
        !(unfix_ratio || ratio < 0) -> ratio == _resolved_ratio;
    }

    constraint cst_resolve_freq_from_src {
        source != null && _resolved_ratio > 0 -> {
            _resolved_freq >= (source._resolved_freq / _resolved_ratio) * {{ div_freq_tol_lo }} / {{ div_freq_tol_den }};
            _resolved_freq <= (source._resolved_freq / _resolved_ratio) * {{ div_freq_tol_hi }} / {{ div_freq_tol_den }};
        }
    }

    // 初始化自由分频比。
    function new(string name = "");
        super.new(name);
        ratio = -1;
        unfix_ratio = 1'b1;
        kind = "div";
    endfunction

    // div/dto 在 PLL lock 后、反相器前配置。
    virtual function int configuration_priority();
        return 200;
    endfunction

    // Skip only a branch which cannot reach an observable endpoint.
    virtual function bit requires_observed_descendant();
        return 1'b1;
    endfunction

endclass

`endif
