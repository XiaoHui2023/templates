`ifndef {{ (settings.class_prefix ~ "div_dto") | upper }}
`define {{ (settings.class_prefix ~ "div_dto") | upper }}

class {{ settings.class_prefix }}div_dto extends {{ settings.class_prefix }}ratio_base;
    `uvm_object_utils({{ settings.class_prefix }}div_dto)
    {{ settings.class_prefix }}reg f_rst;
    {{ settings.class_prefix }}reg f_load;
    {{ settings.class_prefix }}reg f_bypass;
    {{ settings.class_prefix }}reg f_step;

    constraint cst_dto {
        _resolved_ratio > 0;
        _resolved_ratio <= (1 << 25);
    }

    // Initializes the DTO control fields.
    function new(string name = "");
        super.new(name);
        kind = "div_dto";
        f_rst = new();
        f_load = new();
        f_bypass = new();
        f_step = new();
    endfunction

    // Includes the DTO accumulator's integer step quantization.
    virtual function real clock_rate_hz();
        if (source == null || _resolved_ratio <= 0)
            return 0.0;
        if ({{ settings.class_prefix }}dto_ratio_is_bypass(_resolved_ratio))
            return source.clock_rate_hz();
        return source.clock_rate_hz()
            * real'({{ settings.class_prefix }}dto_ratio_to_step(_resolved_ratio)) / real'(1 << 25);
    endfunction

    // Reports whether the complete DTO programming controls are bound.
    virtual function bit has_configuration();
        return f_rst.is_bound() && f_load.is_bound() && f_bypass.is_bound() && f_step.is_bound();
    endfunction

    // Programs data before the load edge and allows control synchronization.
    task program_ratio(
            input {{ settings.class_prefix }}node_config_api cfg,
            input int value,
            input bit reset);
        int step_value;
        bit bypass_value;
        bypass_value = {{ settings.class_prefix }}dto_ratio_is_bypass(value);
        step_value = bypass_value ? 0 : {{ settings.class_prefix }}dto_ratio_to_step(value);
        program_step(cfg, step_value, bypass_value, reset);
    endtask

    // Commits accumulator data before load and waits for synchronization.
    task program_step(
            input {{ settings.class_prefix }}node_config_api cfg,
            input int step_value,
            input bit bypass_value,
            input bit reset);
        int rst_value;
{%- if plugin_value("div_dto", "reg_high_means_reset", false) %}
        rst_value = 0;
{%- else %}
        rst_value = 1;
{%- endif %}
        if (reset) begin
            cfg.write_reg(f_rst, !rst_value);
            {{ settings.class_prefix }}time_domain::delay_ns({{ plugin_value("div_dto", "sync_wait_ns", 200) }});
        end
        cfg.write_reg(f_load, 0);
        cfg.write_reg(f_step, step_value);
        cfg.write_reg(f_bypass, bypass_value);
        cfg.write_reg(f_rst, rst_value);
        {{ settings.class_prefix }}time_domain::delay_ns({{ plugin_value("div_dto", "sync_wait_ns", 200) }});
        cfg.write_reg(f_load, 1);
        {{ settings.class_prefix }}time_domain::delay_ns({{ plugin_value("div_dto", "sync_wait_ns", 200) }});
    endtask

    // Configures a bound DTO and waits for its control synchronization budget.
    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        configured = f_rst.is_bound() && f_load.is_bound() && f_bypass.is_bound()
            && f_step.is_bound();
        if (!configured)
            return;
        if ({{ settings.class_prefix }}dto_ratio_is_bypass(_resolved_ratio)) begin
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: dto %s bypass", get_name()), UVM_LOW)
        end else begin
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: dto %s ratio %0d", get_name(), _resolved_ratio), UVM_LOW)
        end
        program_ratio(cfg, _resolved_ratio,
            {{ "1'b1" if plugin_value("div_dto", "reset_on_config", false) else "1'b0" }});
    endtask
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Declares an isolated DTO transition check.
    virtual function bit has_functional_contract();
        return 1'b1;
    endfunction

    // Accumulator pulses do not require a symmetric high/low interval.
    virtual function bit output_duty_check_enabled(string key = ""); return 1'b0; endfunction

    // Averages accumulator period jitter before comparing nominal rates.
    virtual function int output_frequency_window(string key = "");
        return int'($ceil(4.0 / {{ settings.period_tolerance }}));
    endfunction

    // Exercises bypass and both values of every accumulator control bit.
    virtual task run_functional_contract(
            input {{ settings.class_prefix }}node_test_api api,
            output bit did_check,
            output bit did_skip,
            output int failures);
        virtual {{ settings.class_prefix }}interface in_vif;
        virtual {{ settings.class_prefix }}interface out_vif;
        real expected_freq_hz;
        bit passed;
        int width;
        int mask;
        int step_value;

        did_check = 1'b0;
        did_skip = 1'b0;
        failures = 0;
        in_vif = get_in_vif();
        out_vif = get_out_vif();
        if (api == null || api.cfg == null || in_vif == null || out_vif == null
                || !f_rst.is_bound() || !f_load.is_bound() || !f_bypass.is_bound()
                || !f_step.is_bound()) begin
            did_skip = 1'b1;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip dto %s, missing interface or reg",
                get_name()), UVM_LOW)
            return;
        end
        width = {{ settings.class_prefix }}reg_field_width(f_step);
        if (width < 1 || width > 25)
            `uvm_fatal("CLK_TREE", $sformatf("test_flip: dto %s step width %0d outside [1,25]", get_name(), width))
        mask = (1 << width) - 1;
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: test dto %s", get_name()), UVM_LOW)
        in_vif.start_clock(1_000_000_000);
        program_step(api.cfg, 0, 1'b1, 1'b1);
        {{ settings.class_prefix }}time_domain::delay_ns({{ plugin_value("div_dto", "settle_ns", 200) }});
        check_output(api, out_vif, {get_name(), ".out bypass"}, 1_000_000_000, passed);
        if (!passed)
            failures++;
        for (int bit_idx = 0; bit_idx < width; bit_idx++) begin
            for (int pattern = 0; pattern < 2; pattern++) begin
                step_value = pattern == 0
                    ? (1 << (width - 1)) | (1 << bit_idx)
                    : mask ^ (1 << bit_idx);
                program_step(api.cfg, step_value, 1'b0, 1'b1);
                {{ settings.class_prefix }}time_domain::delay_ns({{ plugin_value("div_dto", "settle_ns", 200) }});
                expected_freq_hz = 1.0e9 * real'(step_value) / real'(1 << 25);
                if (step_value == 0)
                    api.check_port_inactive(out_vif, {get_name(), ".out step 0"}, 1_000_000_000, passed);
                else if (expected_freq_hz < {{ settings.min_freq_hz }}) begin
                    passed = 1'b0;
                    `uvm_error("CLK_TREE", $sformatf(
                        "test_flip: dto %s bit %0d expected %0.3f Hz below measurable %0d Hz",
                        get_name(), bit_idx, expected_freq_hz, {{ settings.min_freq_hz }}))
                end else
                    check_output(api, out_vif,
                        $sformatf("%s.out bit %0d step %0h", get_name(), bit_idx, step_value),
                        expected_freq_hz, passed);
                if (!passed)
                    failures++;
            end
        end
        in_vif.release_drive();
        did_check = 1'b1;
    endtask
`endif
endclass

`endif
