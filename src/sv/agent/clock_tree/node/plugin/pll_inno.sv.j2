`ifndef {{ (settings.class_prefix ~ "pll_inno") | upper }}
`define {{ (settings.class_prefix ~ "pll_inno") | upper }}

class {{ settings.class_prefix }}pll_inno extends {{ settings.class_prefix }}frequency_synth_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}pll_inno)
        `uvm_field_string(group_id, UVM_DEFAULT|(_print_group_id?0:UVM_NOPRINT))
    `uvm_object_utils_end
    {{ settings.class_prefix }}reg f_lock;
    {{ settings.class_prefix }}reg f_pd;
    {{ settings.class_prefix }}reg f_postdiv1;
    {{ settings.class_prefix }}reg f_refdiv;
    {{ settings.class_prefix }}reg f_postdiv2;
    {{ settings.class_prefix }}reg f_fbdiv;

    string group_id;
    bit _print_group_id;
    {{ settings.class_prefix }}pll_inno to_group[string];

    function new(string name = "");
        super.new(name);
        f_lock = new();
        f_pd = new();
        f_postdiv1 = new();
        f_refdiv = new();
        f_postdiv2 = new();
        f_fbdiv = new();
        kind = "pll_inno";
        group_id = "";
        _print_group_id = 1;
    endfunction

    virtual function {{ settings.class_prefix }}reg lock_reg(); return f_lock; endfunction

    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        {{ settings.class_prefix }}frequency_encoder encoder;
        longint ref_hz;
        bit active;
        bit write_shared;
        bit reg_match;
        configured = 1'b0;
        active = _resolved_active;
        if (active && source == null)
            `uvm_fatal("CLK_TREE", $sformatf("config_reg: pll_inno %s has no source for ref frequency", get_name()))
        if (active && frequence <= 0)
            `uvm_fatal("CLK_TREE", $sformatf("config_reg: pll_inno %s frequence must be positive", get_name()))
        ref_hz = active ? source._resolved_freq : 0;
        if (active && ref_hz <= 0)
            `uvm_fatal("CLK_TREE", $sformatf("config_reg: pll_inno %s source %s frequence must be positive", get_name(), source.get_name()))
        if (!f_pd.is_bound() || !f_lock.is_bound() || !f_refdiv.is_bound() || !f_fbdiv.is_bound()
                || !f_postdiv1.is_bound() || !f_postdiv2.is_bound())
            return;
        write_shared = group_id == "{{ plugin_value("pll_inno", "primary_group", "0") }}";
        encoder = new(cfg.tools.rw);
        encoder.inno_regs_match_target(f_pd, f_refdiv, f_fbdiv, f_postdiv1, f_postdiv2,
            frequence, ref_hz, write_shared, active, reg_match);
        if (reg_match) begin
            if (!cfg.quiet)
                `uvm_info("CLK_TREE", $sformatf("config_reg: pll_inno %s skip reg match out %0d Hz ref %0d Hz", get_name(), frequence, ref_hz), UVM_MEDIUM)
            return;
        end
        if (!cfg.quiet)
            `uvm_info("CLK_TREE", $sformatf("config_reg: pll_inno %s %s", get_name(), active ? $sformatf("out %0d Hz ref %0d Hz group %s", frequence, ref_hz, group_id) : "active 0"), UVM_MEDIUM)
        encoder.configure_inno_from_hz(f_pd, f_refdiv, f_fbdiv, f_postdiv1, f_postdiv2,
            active, frequence, ref_hz, write_shared);
        configured = active;
    endtask

    virtual task await_configuration(input {{ settings.class_prefix }}node_config_api cfg);
        if (group_id != "{{ plugin_value("pll_inno", "primary_group", "0") }}")
            return;
        super.await_configuration(cfg);
    endtask
endclass

`endif
