`ifndef {{ (settings.class_prefix ~ "mux") | upper }}
`define {{ (settings.class_prefix ~ "mux") | upper }}

class {{ settings.class_prefix }}mux extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}mux)
        `uvm_field_int(_resolved_sel, UVM_ALL_ON)
        `uvm_field_int(sel, UVM_ALL_ON)
        `uvm_field_int(unfix_sel, UVM_DEFAULT|UVM_DEC|(_should_print ? 0 : UVM_NOPRINT))
    `uvm_object_utils_end

    int max_sel;
    rand int _resolved_sel;
    int sel;
    bit unfix_sel;
    int switch_cycles;
    longint switch_timeout_ns;
    {{ settings.class_prefix }}node_base to_source[int];
    int input_keys[$];
    {{ settings.class_prefix }}reg f_reg;

    constraint cst_mux {
        _resolved_sel >= 0;
        input_keys.size() > 0 -> _resolved_sel inside {input_keys};
        max_sel >= 0 -> _resolved_sel <= max_sel;
        !(unfix_sel || sel < 0) -> sel == _resolved_sel;
    }

    constraint cst_resolve_active_from_src {
        to_source[_resolved_sel] != null
            -> _resolved_active == to_source[_resolved_sel]._resolved_active;
    }

    constraint cst_resolve_freq_from_src {
        to_source[_resolved_sel] != null
            -> _resolved_freq == to_source[_resolved_sel]._resolved_freq;
    }

    // 初始化自由选择值。
    function new(string name = "");
        super.new(name);
        max_sel = -1;
        sel = -1;
        unfix_sel = 1'b1;
        switch_cycles = {{ plugin_value("mux", "switch_cycles", 8) }};
        switch_timeout_ns = {{ plugin_value("mux", "switch_timeout_ns", 1000000) }};
        f_reg = new();
        kind = "mux";
    endfunction

    // Keeps the generic source graph and the integer mux selector map aligned.
    virtual function void set_source(
            input string key,
            input {{ settings.class_prefix }}node_base parent);
        int index;
        index = 0;
        if (key != "" && ($sscanf(key, "%d", index) != 1
                || index < 0 || key != $sformatf("%0d", index)))
            `uvm_fatal("CLK_TREE", $sformatf("mux %s invalid input key %s", get_name(), key))
        super.set_source(key, parent);
        if (!to_source.exists(index))
            input_keys.push_back(index);
        to_source[index] = parent;
    endfunction

    // 同步选择值的固定标记。
    function void post_randomize();
        super.post_randomize();
        if (to_source.exists(_resolved_sel))
            source = to_source[_resolved_sel];
        else
            source = null;
    endfunction

    // 收集全部 mux 输入来源。
    virtual function void collect_source_nodes(
            output {{ settings.class_prefix }}node_base source_nodes[$]);
        source_nodes.delete();
        foreach (to_source[key])
            if (to_source[key] != null)
                source_nodes.push_back(to_source[key]);
    endfunction

    // 返回由指定上游驱动的 mux 输入键。
    virtual function void collect_input_keys_from_source(
            input {{ settings.class_prefix }}node_base parent,
            output string keys[$]);
        keys.delete();
        foreach (to_source[key])
            if (to_source[key] == parent)
                keys.push_back(sources.num() == 0 ? "" : $sformatf("%0d", key));
    endfunction

    // Provides a selectable final input.
    virtual function bit has_configuration(); return f_reg.is_bound(); endfunction

    // Shares a selector field while preserving all logical input requirements.
    virtual function string availability_key();
        if (!f_reg.is_bound()) return super.availability_key();
        return $sformatf("mux-control:%0d:%0d:%0d", f_reg.field.get_inst_id(), f_reg.offset, f_reg.width);
    endfunction

    // Compares the encoded selector across register aliases.
    virtual function string configuration_signature(); return $sformatf("%0d", _resolved_sel); endfunction

    // Skip only a branch which cannot reach an observable endpoint.
    virtual function bit requires_observed_descendant();
        return 1'b1;
    endfunction

    // Returns the rate of the programmed input rather than a rounded target.
    virtual function real clock_rate_hz();
        if (!to_source.exists(_resolved_sel) || to_source[_resolved_sel] == null)
            return 0.0;
        return to_source[_resolved_sel].clock_rate_hz();
    endfunction

    // Rounds the slowest input's cycle budget up to whole nanoseconds.
    function real switch_delay_ns(input real slow_hz, input int cycles);
        real delay_ns;
        if (slow_hz <= 0.0 || cycles <= 0 || switch_timeout_ns <= 0) begin
            `uvm_fatal("CLK_TREE", $sformatf("config_reg: mux %s invalid switch rate or budget", get_name()))
            return 0.0;
        end
        delay_ns = $ceil(1.0e9 * real'(cycles) / slow_hz);
        if (delay_ns > real'(switch_timeout_ns)) begin
            `uvm_fatal("CLK_TREE", $sformatf(
                "config_reg: mux %s switch wait %0.0f ns exceeds %0d ns at %0.3f Hz",
                get_name(), delay_ns, switch_timeout_ns, slow_hz))
            return 0.0;
        end
        return delay_ns;
    endfunction

    // Captures the actual selector before dependencies are planned.
    virtual task observe_configuration(input {{ settings.class_prefix }}config_context context_h);
        uvm_queue#(int) state;
        int current_sel;
        if (!f_reg.is_bound())
            return;
        context_h.io.read_reg(f_reg, current_sel);
        state = new();
        state.push_back(current_sel);
        context_h.set_observation(this, state);
    endtask

    // Retrieves the selector from this transaction's readback.
    function int observed_sel({{ settings.class_prefix }}config_context context_h);
        uvm_queue#(int) state;
        if (!$cast(state, context_h.observation(this)) || state.size() != 1) begin
            context_h.fail($sformatf("mux %s missing selector observation", get_name()));
            return -1;
        end
        return state.get(0);
    endfunction

    // Holds old and new inputs until the selection transition completes.
    virtual function void plan_configuration(
            {{ settings.class_prefix }}config_context context_h,
            {{ settings.class_prefix }}config_action target);
        {{ settings.class_prefix }}config_action select_action;
        {{ settings.class_prefix }}config_lease old_input;
        {{ settings.class_prefix }}config_lease new_input;
        int current_sel;
        if (!f_reg.is_bound())
            return;
        current_sel = observed_sel(context_h);
        if (current_sel == _resolved_sel)
            return;
        if (!to_source.exists(current_sel) || to_source[current_sel] == null
                || !to_source.exists(_resolved_sel) || to_source[_resolved_sel] == null) begin
            context_h.fail($sformatf(
                "config_reg: mux %s missing old/new input %0d -> %0d",
                get_name(), current_sel, _resolved_sel));
            return;
        end
        select_action = context_h.add_action(this, 1, {get_name(), ".select"});
        old_input = context_h.require_available(to_source[current_sel], target);
        if (context_h.has_failed()) return;
        new_input = context_h.require_available(to_source[_resolved_sel], target);
        if (context_h.has_failed()) return;
        context_h.after_action(select_action, old_input.ready);
        context_h.after_action(select_action, new_input.ready);
        context_h.after_action(target, select_action);
        context_h.defer_action(target);
    endfunction

    // Keeps the selected output running for its downstream consumers.
    virtual function void plan_requirement(
            {{ settings.class_prefix }}config_context context_h,
            {{ settings.class_prefix }}config_lease lease_h);
        {{ settings.class_prefix }}config_lease selected_input;
        if (!to_source.exists(_resolved_sel) || to_source[_resolved_sel] == null) begin
            context_h.fail($sformatf("mux %s has no selected provider", get_name()));
            return;
        end
        selected_input = context_h.require_available(to_source[_resolved_sel], lease_h.release_action);
        if (context_h.has_failed()) return;
        context_h.after_action(lease_h.ready, selected_input.ready);
    endfunction

    // Rejects availability claims for an uncontrolled selector.
    virtual task acquire_requirement(
            input {{ settings.class_prefix }}config_context context_h,
            input {{ settings.class_prefix }}config_lease lease_h);
        if (!f_reg.is_bound())
            `uvm_fatal("CLK_TREE", $sformatf("mux %s missing selector register", get_name()))
    endtask

    // Writes selection and records when its completion can be confirmed.
    virtual task execute_configuration(
            input {{ settings.class_prefix }}config_context context_h,
            input int token);
        int current_sel;
        real old_hz;
        real new_hz;
        real slow_hz;
        real delay_ns;
        if (!f_reg.is_bound())
            return;
        current_sel = observed_sel(context_h);
        if (current_sel == _resolved_sel) begin
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: mux %s skip reg sel %0d", get_name(), _resolved_sel), UVM_HIGH)
            return;
        end
        old_hz = to_source[current_sel].clock_rate_hz();
        new_hz = to_source[_resolved_sel].clock_rate_hz();
        slow_hz = old_hz < new_hz ? old_hz : new_hz;
        delay_ns = switch_delay_ns(slow_hz, switch_cycles);
        if (delay_ns <= 0.0) return;
        case (token)
            1: begin
                #(switch_delay_ns(slow_hz, 1) * 1ns);
                `uvm_info("CLK_TREE", $sformatf(
                    "config_reg: mux %s sel %0d -> %0d, wait %0.0f ns (%0d cycles at %0.3f Hz)",
                    get_name(), current_sel, _resolved_sel, delay_ns, switch_cycles, slow_hz), UVM_LOW)
                context_h.io.write_reg(f_reg, _resolved_sel);
                context_h.target(this).next_poll_ns = $realtime / 1ns + delay_ns;
            end
            0: context_h.fail("mux completion action was not deferred");
            default: `uvm_fatal("CLK_TREE", "unknown mux configuration action")
        endcase
    endtask
    // Confirms the switch budget after the scheduler's wake-up time.
    virtual task poll_configuration(
            input {{ settings.class_prefix }}config_context context_h,
            input int token,
            output bit complete,
            output real retry_ns);
        complete = token == 0;
        retry_ns = 0.0;
        if (!complete) context_h.fail("unknown mux completion action");
    endtask
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Maps the sole default input to selector zero.
    virtual function virtual {{ settings.class_prefix }}interface get_in_vif(string key = "");
        if (key == "0" && sources.num() == 0 && !in_vifs.exists(key))
            return in_vif;
        return super.get_in_vif(key);
    endfunction

    // Declares an isolated mux selection transition check.
    virtual function bit has_functional_contract();
        return 1'b1;
    endfunction

    // Drives independent inputs, then checks every selectable output path.
    virtual task run_functional_contract(
            input {{ settings.class_prefix }}node_test_api api,
            output bit did_check,
            output bit did_skip,
            output int failures);
        virtual {{ settings.class_prefix }}interface in_vif;
        virtual {{ settings.class_prefix }}interface out_vif;
        real out_freq_hz;
        real expected_freq_hz[int];
        real err_ratio;
        string in_key;
        int stim_freq_hz;
        bit passed;
        bit configured;

        did_check = 1'b0;
        did_skip = 1'b0;
        failures = 0;
        out_vif = get_out_vif();
        if (api == null || api.cfg == null || out_vif == null || !f_reg.is_bound()) begin
            did_skip = 1'b1;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip mux %s, missing out interface or reg",
                get_name()), UVM_LOW)
            return;
        end
        foreach (to_source[k]) begin
            in_key = $sformatf("%0d", k);
            in_vif = get_in_vif(in_key);
            if (in_vif == null) begin
                did_skip = 1'b1;
                `uvm_info("CLK_TREE", $sformatf(
                    "test_flip: skip mux %s input %s, missing interface",
                    get_name(), in_key), UVM_LOW)
                return;
            end
        end
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: test mux %s", get_name()), UVM_LOW)
        stim_freq_hz = 900_000_000;
        foreach (to_source[k]) begin
            in_key = $sformatf("%0d", k);
            in_vif = get_in_vif(in_key);
            if (to_source[k] != null && to_source[k].preserves_native_input())
                expected_freq_hz[k] = to_source[k]._resolved_freq;
            else begin
                expected_freq_hz[k] = stim_freq_hz;
                in_vif.start_clock(stim_freq_hz);
                stim_freq_hz = int'(real'(stim_freq_hz) * (20.0 / 21.0));
            end
        end
        foreach (to_source[k]) begin
            api.cfg.write_reg(f_reg, k);
            #70ns;
            api.measure_port_freq(out_vif, {get_name(), ".out"},
                int'(expected_freq_hz[k]), out_freq_hz, passed);
            if (!passed)
                failures++;
            else begin
                err_ratio = (out_freq_hz > expected_freq_hz[k])
                    ? ((out_freq_hz - expected_freq_hz[k]) / expected_freq_hz[k])
                    : ((expected_freq_hz[k] - out_freq_hz) / expected_freq_hz[k]);
                if (err_ratio > {{ settings.period_tolerance }}) begin
                    failures++;
                    `uvm_error("CLK_TREE", $sformatf(
                        "test_flip: mux %s sel %0d output %0.2f Hz expected %0.2f Hz",
                        get_name(), k, out_freq_hz, expected_freq_hz[k]))
                end
            end
        end
        foreach (to_source[k]) begin
            in_key = $sformatf("%0d", k);
            in_vif = get_in_vif(in_key);
            if (in_vif != null && (to_source[k] == null
                    || !to_source[k].preserves_native_input()))
                in_vif.release_drive();
        end
        did_check = 1'b1;
    endtask
`endif
endclass

`endif
