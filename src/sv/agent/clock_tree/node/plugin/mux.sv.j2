`ifndef {{ (settings.class_prefix ~ "mux") | upper }}
`define {{ (settings.class_prefix ~ "mux") | upper }}

class {{ settings.class_prefix }}mux extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}mux)
        `uvm_field_int(_resolved_sel, UVM_ALL_ON)
        `uvm_field_int(sel, UVM_ALL_ON)
        `uvm_field_int(unfix_sel, UVM_DEFAULT|UVM_DEC|(_should_print ? 0 : UVM_NOPRINT))
    `uvm_object_utils_end

    int max_sel;
    rand int _resolved_sel;
    int sel;
    bit unfix_sel;
    {{ settings.class_prefix }}node_base to_source[int];
    int input_keys[$];
    {{ settings.class_prefix }}reg f_reg;

    constraint cst_mux {
        _resolved_sel >= 0;
        input_keys.size() > 0 -> _resolved_sel inside {input_keys};
        max_sel >= 0 -> _resolved_sel <= max_sel;
        !(unfix_sel || sel < 0) -> sel == _resolved_sel;
    }

    constraint cst_resolve_active_from_src {
        to_source[_resolved_sel] != null
            -> _resolved_active == to_source[_resolved_sel]._resolved_active;
    }

    constraint cst_resolve_freq_from_src {
        to_source[_resolved_sel] != null
            -> _resolved_freq == to_source[_resolved_sel]._resolved_freq;
    }

    // 初始化自由选择值。
    function new(string name = "");
        super.new(name);
        max_sel = -1;
        sel = -1;
        unfix_sel = 1'b1;
        f_reg = new();
        kind = "mux";
    endfunction

    // Keeps the generic source graph and the integer mux selector map aligned.
    virtual function void set_source(
            input string key,
            input {{ settings.class_prefix }}node_base parent);
        int index;
        index = 0;
        if (key != "" && ($sscanf(key, "%d", index) != 1
                || index < 0 || key != $sformatf("%0d", index)))
            `uvm_fatal("CLK_TREE", $sformatf("mux %s invalid input key %s", get_name(), key))
        super.set_source(key, parent);
        if (!to_source.exists(index))
            input_keys.push_back(index);
        to_source[index] = parent;
    endfunction

    // 同步选择值的固定标记。
    function void post_randomize();
        super.post_randomize();
        if (to_source.exists(_resolved_sel))
            source = to_source[_resolved_sel];
        else
            source = null;
    endfunction

    // 收集全部 mux 输入来源。
    virtual function void collect_source_nodes(
            output {{ settings.class_prefix }}node_base source_nodes[$]);
        source_nodes.delete();
        foreach (to_source[key])
            if (to_source[key] != null)
                source_nodes.push_back(to_source[key]);
    endfunction

    // 返回由指定上游驱动的 mux 输入键。
    virtual function void collect_input_keys_from_source(
            input {{ settings.class_prefix }}node_base parent,
            output string keys[$]);
        keys.delete();
        foreach (to_source[key])
            if (to_source[key] == parent)
                keys.push_back(sources.num() == 0 ? "" : $sformatf("%0d", key));
    endfunction

    // mux 在打开上游 gate 后配置。
    virtual function int configuration_priority();
        return 500;
    endfunction

    // Skip only a branch which cannot reach an observable endpoint.
    virtual function bit requires_observed_descendant();
        return 1'b1;
    endfunction

    // Writes the resolved source selector when its register is bound.
    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        int current_sel;
        configured = f_reg.is_bound();
        if (!configured)
            return;
        cfg.read_reg(f_reg, current_sel);
        if (current_sel == _resolved_sel) begin
            if (!cfg.quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "config_reg: mux %s skip reg sel %0d", get_name(), _resolved_sel), UVM_MEDIUM)
            return;
        end
        if (!cfg.quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: mux %s sel %0d", get_name(), _resolved_sel), UVM_MEDIUM)
        cfg.write_reg(f_reg, _resolved_sel);
    endtask
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Maps the sole default input to selector zero.
    virtual function virtual {{ settings.class_prefix }}interface get_in_vif(string key = "");
        if (key == "0" && sources.num() == 0 && !in_vifs.exists(key))
            return in_vif;
        return super.get_in_vif(key);
    endfunction

    // Declares an isolated mux selection transition check.
    virtual function bit has_functional_contract();
        return 1'b1;
    endfunction

    // Drives independent inputs, then checks every selectable output path.
    virtual task run_functional_contract(
            input {{ settings.class_prefix }}node_test_api api,
            output bit did_check,
            output bit did_skip,
            output int failures);
        virtual {{ settings.class_prefix }}interface in_vif;
        virtual {{ settings.class_prefix }}interface out_vif;
        real out_freq_hz;
        real expected_freq_hz[int];
        real err_ratio;
        string in_key;
        int stim_freq_hz;
        bit passed;
        bit configured;

        did_check = 1'b0;
        did_skip = 1'b0;
        failures = 0;
        out_vif = get_out_vif();
        if (api == null || api.cfg == null || out_vif == null || !f_reg.is_bound()) begin
            did_skip = 1'b1;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip mux %s, missing out interface or reg",
                get_name()), UVM_LOW)
            return;
        end
        foreach (to_source[k]) begin
            in_key = $sformatf("%0d", k);
            in_vif = get_in_vif(in_key);
            if (in_vif == null) begin
                did_skip = 1'b1;
                `uvm_info("CLK_TREE", $sformatf(
                    "test_flip: skip mux %s input %s, missing interface",
                    get_name(), in_key), UVM_LOW)
                return;
            end
        end
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: test mux %s", get_name()), UVM_LOW)
        stim_freq_hz = 900_000_000;
        foreach (to_source[k]) begin
            in_key = $sformatf("%0d", k);
            in_vif = get_in_vif(in_key);
            if (to_source[k] != null && to_source[k].preserves_native_input())
                expected_freq_hz[k] = to_source[k]._resolved_freq;
            else begin
                expected_freq_hz[k] = stim_freq_hz;
                in_vif.start_clock(stim_freq_hz);
                stim_freq_hz = int'(real'(stim_freq_hz) * (20.0 / 21.0));
            end
        end
        foreach (to_source[k]) begin
            api.cfg.write_reg(f_reg, k);
            #70ns;
            api.measure_port_freq(out_vif, {get_name(), ".out"},
                int'(expected_freq_hz[k]), out_freq_hz, passed);
            if (!passed)
                failures++;
            else begin
                err_ratio = (out_freq_hz > expected_freq_hz[k])
                    ? ((out_freq_hz - expected_freq_hz[k]) / expected_freq_hz[k])
                    : ((expected_freq_hz[k] - out_freq_hz) / expected_freq_hz[k]);
                if (err_ratio > {{ settings.period_tolerance }}) begin
                    failures++;
                    `uvm_error("CLK_TREE", $sformatf(
                        "test_flip: mux %s sel %0d output %0.2f Hz expected %0.2f Hz",
                        get_name(), k, out_freq_hz, expected_freq_hz[k]))
                end
            end
        end
        foreach (to_source[k]) begin
            in_key = $sformatf("%0d", k);
            in_vif = get_in_vif(in_key);
            if (in_vif != null && (to_source[k] == null
                    || !to_source[k].preserves_native_input()))
                in_vif.release_drive();
        end
        did_check = 1'b1;
    endtask
`endif
endclass

`endif
