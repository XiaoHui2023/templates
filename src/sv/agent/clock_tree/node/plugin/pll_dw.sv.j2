`ifndef {{ (settings.class_prefix ~ "pll_dw") | upper }}
`define {{ (settings.class_prefix ~ "pll_dw") | upper }}

class {{ settings.class_prefix }}pll_dw extends {{ settings.class_prefix }}frequency_synth_base;
    `uvm_object_utils({{ settings.class_prefix }}pll_dw)
    {{ settings.class_prefix }}reg f_lock;
    {{ settings.class_prefix }}reg f_fbdiv;
    {{ settings.class_prefix }}reg f_prediv;
    {{ settings.class_prefix }}reg f_reset;
    {{ settings.class_prefix }}reg f_pwron;
    {{ settings.class_prefix }}reg f_shift;
    {{ settings.class_prefix }}reg f_bypass;
    {{ settings.class_prefix }}reg f_divvcor;
    {{ settings.class_prefix }}reg f_r;
    {{ settings.class_prefix }}reg f_p;
    {{ settings.class_prefix }}reg f_divvcop;
    {{ settings.class_prefix }}reg f_enr;
    {{ settings.class_prefix }}reg f_enp;

    function new(string name = "");
        super.new(name);
        f_lock = new();
        f_fbdiv = new();
        f_prediv = new();
        f_reset = new();
        f_pwron = new();
        f_shift = new();
        f_bypass = new();
        f_divvcor = new();
        f_r = new();
        f_p = new();
        f_divvcop = new();
        f_enr = new();
        f_enp = new();
        kind = "pll_dw";
    endfunction

    virtual function {{ settings.class_prefix }}reg lock_reg(); return f_lock; endfunction

    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        {{ settings.class_prefix }}frequency_encoder encoder;
        longint ref_hz;
        bit active;
        bit reg_match;
        configured = 1'b0;
        active = _resolved_active;
        if (active && source == null)
            `uvm_fatal("CLK_TREE", $sformatf("config_reg: pll_dw %s has no source for ref frequency", get_name()))
        if (active && frequence <= 0)
            `uvm_fatal("CLK_TREE", $sformatf("config_reg: pll_dw %s frequence must be positive", get_name()))
        ref_hz = active ? source._resolved_freq : 0;
        if (active && ref_hz <= 0)
            `uvm_fatal("CLK_TREE", $sformatf("config_reg: pll_dw %s source %s frequence must be positive", get_name(), source.get_name()))
        if (!f_fbdiv.is_bound() || !f_prediv.is_bound() || !f_reset.is_bound() || !f_pwron.is_bound()
                || !f_shift.is_bound() || !f_bypass.is_bound() || !f_divvcor.is_bound() || !f_r.is_bound()
                || !f_p.is_bound() || !f_divvcop.is_bound() || !f_enr.is_bound() || !f_enp.is_bound())
            return;
        encoder = new(cfg.tools.rw);
        encoder.dw_regs_match_target(f_fbdiv, f_prediv, f_reset, f_pwron, f_shift, f_bypass,
            f_divvcor, f_r, f_p, f_divvcop, f_enr, f_enp, frequence, ref_hz, active, reg_match);
        if (reg_match) begin
            if (!cfg.quiet)
                `uvm_info("CLK_TREE", $sformatf("config_reg: pll_dw %s skip reg match out %0d Hz ref %0d Hz", get_name(), frequence, ref_hz), UVM_MEDIUM)
            return;
        end
        if (!cfg.quiet)
            `uvm_info("CLK_TREE", $sformatf("config_reg: pll_dw %s %s", get_name(), active ? $sformatf("out %0d Hz ref %0d Hz", frequence, ref_hz) : "active 0"), UVM_MEDIUM)
        encoder.configure_dw_from_hz(f_fbdiv, f_prediv, f_reset, f_pwron, f_shift, f_bypass,
            f_divvcor, f_r, f_p, f_divvcop, f_enr, f_enp, active, frequence, ref_hz);
        configured = active;
    endtask
endclass

`endif
