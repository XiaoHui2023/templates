`ifndef {{ (settings.class_prefix ~ "div_div") | upper }}
`define {{ (settings.class_prefix ~ "div_div") | upper }}

class {{ settings.class_prefix }}div_div extends {{ settings.class_prefix }}ratio_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}div_div)
        `uvm_field_int(max_ratio, UVM_ALL_ON | UVM_DEC)
    `uvm_object_utils_end
    {{ settings.class_prefix }}reg f_rst;
    {{ settings.class_prefix }}reg f_load;
    {{ settings.class_prefix }}reg f_div;
    int max_ratio;
    int last_configured_ratio;
    bit has_configured_ratio;

    constraint cst_div {
        max_ratio > 0;
        _resolved_ratio > 0;
        _resolved_ratio <= max_ratio;
    }

    // Initializes the divisor and optional control handles.
    function new(string name = "");
        super.new(name);
        kind = "div_div";
        max_ratio = 64;
        last_configured_ratio = 0;
        has_configured_ratio = 1'b0;
        f_rst = new();
        f_load = new();
        f_div = new();
    endfunction

    // Reports whether the programming controls are bound.
    virtual function bit has_configuration();
        return f_rst.is_bound() && f_load.is_bound() && f_div.is_bound();
    endfunction

    // Applies the divisor with the configured reset and load sequence.
    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        int rst_value;
        int div_value;
        int current_rst;
        int current_div;
        bit same_ratio;
        configured = f_rst.is_bound() && f_load.is_bound() && f_div.is_bound();
        if (!configured)
            return;
        div_value = {{ settings.class_prefix }}div_ratio_to_n(f_div, _resolved_ratio);
        cfg.read_reg(f_rst, current_rst);
        cfg.read_reg(f_div, current_div);
{%- if plugin_value("div_div", "reg_high_means_reset", false) %}
        rst_value = 0;
{%- else %}
        rst_value = 1;
{%- endif %}
        same_ratio = current_rst == rst_value && current_div == div_value;
        if (same_ratio && (f_div.alias_count == 1
                || (has_configured_ratio && last_configured_ratio == _resolved_ratio))) begin
            if (!cfg.quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "config_reg: div %s skip reg ratio %0d", get_name(), _resolved_ratio), UVM_MEDIUM)
            return;
        end
        if (!cfg.quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: div %s ratio %0d", get_name(), _resolved_ratio), UVM_MEDIUM)
{%- if plugin_value("div_div", "reset_on_config", false) %}
{%- if plugin_value("div_div", "reg_high_means_reset", false) %}
        cfg.write_reg(f_rst, 1);
{%- else %}
        cfg.write_reg(f_rst, 0);
{%- endif %}
{%- endif %}
        cfg.write_reg(f_rst, rst_value);
        cfg.write_reg(f_div, div_value);
        cfg.write_reg(f_load, 0);
        cfg.write_reg(f_load, 1);
        last_configured_ratio = _resolved_ratio;
        has_configured_ratio = 1'b1;
    endtask
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Declares an isolated divider transition check.
    virtual function bit has_functional_contract();
        return 1'b1;
    endfunction

    // Traverses each encoded divider ratio under an independent input clock.
    virtual task run_functional_contract(
            input {{ settings.class_prefix }}node_test_api api,
            output bit did_check,
            output bit did_skip,
            output int failures);
        virtual {{ settings.class_prefix }}interface in_vif;
        virtual {{ settings.class_prefix }}interface out_vif;
        real out_freq_hz;
        real expected_freq_hz;
        real err_ratio;
        int bit_idx;
        int ratio;
        int width;
        bit passed;
        bit configured;

        did_check = 1'b0;
        did_skip = 1'b0;
        failures = 0;
        in_vif = get_in_vif();
        out_vif = get_out_vif();
        if (api == null || api.cfg == null || in_vif == null || out_vif == null
                || !f_rst.is_bound() || !f_load.is_bound() || !f_div.is_bound()) begin
            did_skip = 1'b1;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip div %s, missing interface or reg",
                get_name()), UVM_LOW)
            return;
        end
        width = {{ settings.class_prefix }}reg_field_width(f_div);
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: test div %s", get_name()), UVM_LOW)
        in_vif.start_clock(1_000_000_000);
        for (bit_idx = 0; bit_idx < width; bit_idx++) begin
            ratio = {{ settings.class_prefix }}div_ratio_for_reg_bit(f_div, bit_idx);
{%- if plugin_value("div_div", "reg_high_means_reset", false) %}
            api.cfg.write_reg(f_rst, 1);
            api.cfg.write_reg(f_rst, 0);
{%- else %}
            api.cfg.write_reg(f_rst, 0);
            api.cfg.write_reg(f_rst, 1);
{%- endif %}
            api.cfg.write_reg(f_div, {{ settings.class_prefix }}div_ratio_to_n(f_div, ratio));
            api.cfg.write_reg(f_load, 0);
            api.cfg.write_reg(f_load, 1);
            #({{ plugin_value("div_div", "settle_ns", 200) }}ns);
            expected_freq_hz = real'(1_000_000_000) / ratio;
            if (expected_freq_hz < {{ settings.min_freq_hz }}) begin
                failures++;
                `uvm_error("CLK_TREE", $sformatf(
                    "test_flip: div %s bit %0d ratio %0d expected below measurable %0d Hz",
                    get_name(), bit_idx, ratio, {{ settings.min_freq_hz }}))
                continue;
            end
            api.measure_port_freq(out_vif, $sformatf(
                "%s.out bit %0d ratio %0d", get_name(), bit_idx, ratio),
                int'(expected_freq_hz), out_freq_hz, passed);
            if (!passed)
                failures++;
            else begin
                err_ratio = (out_freq_hz > expected_freq_hz)
                    ? ((out_freq_hz - expected_freq_hz) / expected_freq_hz)
                    : ((expected_freq_hz - out_freq_hz) / expected_freq_hz);
                if (err_ratio > {{ settings.period_tolerance }}) begin
                    failures++;
                    `uvm_error("CLK_TREE", $sformatf(
                        "test_flip: div %s bit %0d ratio %0d output %0.2f Hz expected %0.2f Hz",
                        get_name(), bit_idx, ratio, out_freq_hz, expected_freq_hz))
                end
            end
        end
        in_vif.release_drive();
        did_check = 1'b1;
    endtask
`endif
endclass

`endif
