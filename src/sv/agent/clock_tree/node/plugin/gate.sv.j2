`ifndef {{ (settings.class_prefix ~ "gate") | upper }}
`define {{ (settings.class_prefix ~ "gate") | upper }}

class {{ settings.class_prefix }}gate extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}gate)
        `uvm_field_int(_resolved_open, UVM_ALL_ON)
        `uvm_field_int(open, UVM_ALL_ON)
        `uvm_field_int(unfix_open, UVM_DEFAULT|UVM_DEC|(_print_fix?0:UVM_NOPRINT))
        `uvm_field_int(fix_open, UVM_DEFAULT|(_print_fix?0:UVM_NOPRINT))
        `uvm_field_int(fix_close, UVM_DEFAULT|(_print_fix?0:UVM_NOPRINT))
    `uvm_object_utils_end

    rand bit _resolved_open;
    int open;
    bit unfix_open;
    bit fix_open;
    bit fix_close;
    {{ settings.class_prefix }}reg f_reg;

    constraint cst_open {
        !(unfix_open || open < 0) -> open == _resolved_open;
    }

    constraint cst_resolve_active_from_src {
        !_resolved_open -> !_resolved_active;
        (_resolved_open && source != null)
            -> _resolved_active == source._resolved_active;
    }

    constraint cst_resolve_freq_from_src {
        !_resolved_open -> _resolved_freq == 0;
        (_resolved_open && source != null)
            -> _resolved_freq == source._resolved_freq;
    }

    constraint cst_gate {
        fix_open -> _resolved_open;
        fix_close -> !_resolved_open;
    }

    // 初始化 gate 的自由开关状态。
    function new(string name = "");
        super.new(name);
        open = -1;
        unfix_open = 1'b1;
        fix_open = 0;
        fix_close = 0;
        f_reg = new();
        kind = "gate";
    endfunction

    // gate 在 mux 之前配置；关闭 gate 在最后配置。
    virtual function int configuration_priority();
        return _resolved_open ? 400 : 600;
    endfunction

    // 返回 gate 的统一配置阶段。
    virtual function {{ settings.class_prefix }}node_config_api::stage_e configuration_stage();
        return _resolved_open ? {{ settings.class_prefix }}node_config_api::CONFIG_GATE_OPEN
                              : {{ settings.class_prefix }}node_config_api::CONFIG_GATE_CLOSE;
    endfunction

    // gate 只有驱动有效时才写配置。
    virtual function bit requires_downstream_clock();
        return 1'b1;
    endfunction

    // 按开关阶段写入当前解析的 gate 状态。
    virtual task configure_stage(
            input {{ settings.class_prefix }}node_config_api cfg,
            input {{ settings.class_prefix }}node_config_api::stage_e stage,
            output bit configured);
        configured = 1'b0;
        if (stage == {{ settings.class_prefix }}node_config_api::CONFIG_GATE_OPEN && _resolved_open) begin
            cfg.configure_gate(this, configured);
        end else if (stage == {{ settings.class_prefix }}node_config_api::CONFIG_GATE_CLOSE && !_resolved_open) begin
            cfg.configure_gate(this, configured);
        end
    endtask
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Declares an isolated gate transition check.
    virtual function bit has_transition_check();
        return 1'b1;
    endfunction

    // Drives the input and checks both register-controlled gate states.
    virtual task run_transition_check(
            input {{ settings.class_prefix }}node_test_api api,
            output bit did_check,
            output bit did_skip,
            output int failures);
        virtual {{ settings.class_prefix }}interface in_vif;
        virtual {{ settings.class_prefix }}interface out_vif;
        real freq_hz;
        bit passed;
        bit configured;

        did_check = 1'b0;
        did_skip = 1'b0;
        failures = 0;
        in_vif = get_in_vif();
        out_vif = get_out_vif();
        if (api == null || api.cfg == null || in_vif == null || out_vif == null
                || !f_reg.is_bound()) begin
            did_skip = 1'b1;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip gate %s, missing interface or reg",
                get_name()), UVM_LOW)
            return;
        end
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: test gate %s", get_name()), UVM_LOW)
        in_vif.start_clock(1_000_000_000);
        api.cfg.configure_transition_gate(this, 1'b1, configured);
        api.measure_port_freq(out_vif, {get_name(), ".out open"},
            1_000_000_000, freq_hz, passed);
        if (!passed)
            failures++;
        api.cfg.configure_transition_gate(this, 1'b0, configured);
        #20ns;
        api.check_port_inactive(out_vif, {get_name(), ".out close"},
            1_000_000_000, passed);
        if (!passed)
            failures++;
        in_vif.release_drive();
        did_check = 1'b1;
    endtask
`endif
endclass

`endif
