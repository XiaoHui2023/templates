`ifndef {{ (settings.class_prefix ~ "gate") | upper }}
`define {{ (settings.class_prefix ~ "gate") | upper }}

class {{ settings.class_prefix }}gate extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}gate)
        `uvm_field_int(_resolved_open, UVM_ALL_ON)
        `uvm_field_int(open, UVM_ALL_ON)
        `uvm_field_int(unfix_open, UVM_DEFAULT|UVM_DEC|(_should_print ? 0 : UVM_NOPRINT))
        `uvm_field_int(fix_open, UVM_DEFAULT|(_should_print ? 0 : UVM_NOPRINT))
        `uvm_field_int(fix_close, UVM_DEFAULT|(_should_print ? 0 : UVM_NOPRINT))
    `uvm_object_utils_end

    rand bit _resolved_open;
    int open;
    bit unfix_open;
    bit fix_open;
    bit fix_close;
    {{ settings.class_prefix }}reg f_reg;

    constraint cst_open {
        !(unfix_open || open < 0) -> open == _resolved_open;
    }

    constraint cst_resolve_active_from_src {
        !_resolved_open -> !_resolved_active;
        (_resolved_open && source != null)
            -> _resolved_active == source._resolved_active;
    }

    constraint cst_resolve_freq_from_src {
        !_resolved_open -> _resolved_freq == 0;
        (_resolved_open && source != null)
            -> _resolved_freq == source._resolved_freq;
    }

    constraint cst_gate {
        fix_open -> _resolved_open;
        fix_close -> !_resolved_open;
    }

    // 初始化 gate 的自由开关状态。
    function new(string name = "");
        super.new(name);
        open = -1;
        unfix_open = 1'b1;
        fix_open = 0;
        fix_close = 0;
        f_reg = new();
        kind = "gate";
    endfunction

    // Provides a register-controlled final state.
    virtual function bit has_configuration(); return f_reg.is_bound(); endfunction

    // A closed target must wait for outstanding users.
    virtual function bit configuration_preserves_availability(); return _resolved_open; endfunction

    // Shares the physical enable slice while retaining each input dependency.
    virtual function string availability_key();
        if (!f_reg.is_bound())
            return super.availability_key();
        return $sformatf("gate-control:%0d:%0d:%0d", f_reg.field.get_inst_id(), f_reg.offset, f_reg.width);
    endfunction

    // Compares the physical target bit across register aliases.
    virtual function string configuration_signature();
        return $sformatf("%0b", {{ '_resolved_open' if plugin_value("gate", "reg_high_means_open", false) else '!_resolved_open' }});
    endfunction

    // Rejects unavailable controls before any actions are executed.
    virtual function void plan_requirement(
            {{ settings.class_prefix }}config_context context_h,
            {{ settings.class_prefix }}config_lease lease_h);
        if (!f_reg.is_bound()) begin
            context_h.fail($sformatf("gate %s missing register for temporary enable", get_name()));
            return;
        end
        super.plan_requirement(context_h, lease_h);
    endfunction

    // Keeps the input running until the gate control has been applied.
    virtual function void plan_configuration(
            {{ settings.class_prefix }}config_context context_h,
            {{ settings.class_prefix }}config_action target);
        require_source(context_h, target);
    endfunction

    // Skip only a branch which cannot reach an observable endpoint.
    virtual function bit requires_observed_descendant();
        return 1'b1;
    endfunction

    // Saves and enables the physical control without changing the target.
    virtual task acquire_requirement(
            input {{ settings.class_prefix }}config_context context_h,
            input {{ settings.class_prefix }}config_lease lease_h);
        uvm_queue#(int) snapshot;
        int current_value;
        if (!f_reg.is_bound())
            `uvm_fatal("CLK_TREE", $sformatf("config_reg: gate %s missing register for temporary enable", get_name()))
        context_h.io.read_reg(f_reg, current_value);
        snapshot = new();
        snapshot.push_back(current_value);
        lease_h.state = snapshot;
        if (current_value != {{ 1 if plugin_value("gate", "reg_high_means_open", false) else 0 }})
            context_h.io.write_reg(f_reg, {{ 1 if plugin_value("gate", "reg_high_means_open", false) else 0 }});
    endtask

    // Restores a borrowed control only when no final target supersedes it.
    virtual task release_requirement(
            input {{ settings.class_prefix }}config_context context_h,
            input {{ settings.class_prefix }}config_lease lease_h);
        uvm_queue#(int) snapshot;
        if (!lease_h.has_target) begin
            if (!$cast(snapshot, lease_h.state) || snapshot.size() != 1)
                `uvm_fatal("CLK_TREE", "gate lease has no saved state")
            context_h.io.write_reg(f_reg, snapshot.get(0));
        end
    endtask

    // Writes the resolved gate state when its register is bound.
    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        configured = f_reg.is_bound();
        if (!configured)
            return;
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: gate %s open %0b", get_name(), _resolved_open), UVM_LOW)
{%- if plugin_value("gate", "reg_high_means_open", false) %}
        cfg.write_reg(f_reg, _resolved_open);
{%- else %}
        cfg.write_reg(f_reg, !_resolved_open);
{%- endif %}
    endtask
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Declares an isolated gate transition check.
    virtual function bit has_functional_contract();
        return 1'b1;
    endfunction

    // Drives the input and checks both register-controlled gate states.
    virtual task run_functional_contract(
            input {{ settings.class_prefix }}node_test_api api,
            output bit did_check,
            output bit did_skip,
            output int failures);
        virtual {{ settings.class_prefix }}interface in_vif;
        virtual {{ settings.class_prefix }}interface out_vif;
        real freq_hz;
        bit passed;
        bit configured;

        did_check = 1'b0;
        did_skip = 1'b0;
        failures = 0;
        in_vif = get_in_vif();
        out_vif = get_out_vif();
        if (api == null || api.cfg == null || in_vif == null || out_vif == null
                || !f_reg.is_bound()) begin
            did_skip = 1'b1;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip gate %s, missing interface or reg",
                get_name()), UVM_LOW)
            return;
        end
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: test gate %s", get_name()), UVM_LOW)
        in_vif.start_clock(1_000_000_000);
        configured = 1'b1;
{%- if plugin_value("gate", "reg_high_means_open", false) %}
        api.cfg.write_reg(f_reg, 1'b1);
{%- else %}
        api.cfg.write_reg(f_reg, 1'b0);
{%- endif %}
        api.measure_port_freq(out_vif, {get_name(), ".out open"},
            1_000_000_000, freq_hz, passed);
        if (!passed)
            failures++;
{%- if plugin_value("gate", "reg_high_means_open", false) %}
        api.cfg.write_reg(f_reg, 1'b0);
{%- else %}
        api.cfg.write_reg(f_reg, 1'b1);
{%- endif %}
        #20ns;
        api.check_port_inactive(out_vif, {get_name(), ".out close"},
            1_000_000_000, passed);
        if (!passed)
            failures++;
        in_vif.release_drive();
        did_check = 1'b1;
    endtask
`endif
endclass

`endif
