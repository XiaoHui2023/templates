`ifndef {{ (settings.class_prefix ~ "pll_sc") | upper }}
`define {{ (settings.class_prefix ~ "pll_sc") | upper }}

class {{ settings.class_prefix }}pll_sc extends {{ settings.class_prefix }}pll_base;
    `uvm_object_utils({{ settings.class_prefix }}pll_sc)
    {{ settings.class_prefix }}reg f_lock;
    {{ settings.class_prefix }}reg f_vocpd;
    {{ settings.class_prefix }}reg f_postdivpd;
    {{ settings.class_prefix }}reg f_dsmpd;
    {{ settings.class_prefix }}reg f_pd;
    {{ settings.class_prefix }}reg f_bypass;
    {{ settings.class_prefix }}reg f_refdiv;
    {{ settings.class_prefix }}reg f_postdiv2;
    {{ settings.class_prefix }}reg f_postdiv1;
    {{ settings.class_prefix }}reg f_fbdiv;

    function new(string name = "");
        super.new(name);
        f_lock = new();
        f_vocpd = new();
        f_postdivpd = new();
        f_dsmpd = new();
        f_pd = new();
        f_bypass = new();
        f_refdiv = new();
        f_postdiv2 = new();
        f_postdiv1 = new();
        f_fbdiv = new();
        pll_kind = PLL_SC;
    endfunction

    virtual function {{ settings.class_prefix }}reg lock_reg(); return f_lock; endfunction

    virtual task apply_configuration(
            input {{ settings.class_prefix }}node_config_api cfg,
            output bit configured);
        {{ settings.class_prefix }}pll_cfg encoder;
        longint ref_hz;
        bit active;
        bit reg_match;
        configured = 1'b0;
        active = _resolved_active;
        if (active && source == null)
            `uvm_fatal("CLK_TREE", $sformatf(
                "config_reg: pll_sc %s has no source for ref frequency", get_name()))
        if (active && frequence <= 0)
            `uvm_fatal("CLK_TREE", $sformatf(
                "config_reg: pll_sc %s frequence must be positive", get_name()))
        ref_hz = active ? source._resolved_freq : 0;
        if (active && ref_hz <= 0)
            `uvm_fatal("CLK_TREE", $sformatf(
                "config_reg: pll_sc %s source %s frequence must be positive",
                get_name(), source.get_name()))
        if (!f_vocpd.is_bound() || !f_postdivpd.is_bound() || !f_dsmpd.is_bound()
                || !f_pd.is_bound() || !f_bypass.is_bound() || !f_refdiv.is_bound()
                || !f_postdiv2.is_bound() || !f_postdiv1.is_bound() || !f_fbdiv.is_bound())
            return;
        encoder = new(cfg.tools.rw);
        encoder.sc_regs_match_target(f_vocpd, f_postdivpd, f_dsmpd, f_pd, f_bypass,
            f_refdiv, f_postdiv2, f_postdiv1, f_fbdiv, frequence, ref_hz, active, reg_match);
        if (reg_match) begin
            if (!cfg.quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "config_reg: pll_sc %s skip reg match out %0d Hz ref %0d Hz",
                    get_name(), frequence, ref_hz), UVM_MEDIUM)
            return;
        end
        if (!cfg.quiet)
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: pll_sc %s %s", get_name(), active ? $sformatf("out %0d Hz ref %0d Hz", frequence, ref_hz) : "active 0"), UVM_MEDIUM)
        encoder.configure_sc_from_hz(f_vocpd, f_postdivpd, f_dsmpd, f_pd, f_bypass,
            f_refdiv, f_postdiv2, f_postdiv1, f_fbdiv, active, frequence, ref_hz);
        configured = active;
    endtask
endclass

`endif
