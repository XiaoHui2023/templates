`ifndef {{ (settings.class_prefix ~ "tree_nodes") | upper }}
`define {{ (settings.class_prefix ~ "tree_nodes") | upper }}

function automatic bit {{ settings.class_prefix }}node_in_queue(
        {{ settings.class_prefix }}node_base nd,
        {{ settings.class_prefix }}node_base q[$]);
    foreach (q[i])
        if (q[i] == nd)
            return 1'b1;
    return 1'b0;
endfunction

function automatic void {{ settings.class_prefix }}append_unique_node(
        ref {{ settings.class_prefix }}node_base dest[$],
        input {{ settings.class_prefix }}node_base nd);
    if (nd != null && !{{ settings.class_prefix }}node_in_queue(nd, dest))
        dest.push_back(nd);
endfunction

function automatic void {{ settings.class_prefix }}tree_upstream_peers(
        input {{ settings.class_prefix }}node_base nd,
        output {{ settings.class_prefix }}node_base peers[$]);
    peers.delete();
    if (nd != null)
        nd.collect_source_nodes(peers);
endfunction

function automatic void {{ settings.class_prefix }}tree_downstream_peers(
        input {{ settings.class_prefix }}tree_base tree,
        input {{ settings.class_prefix }}node_base nd,
        output {{ settings.class_prefix }}node_base peers[$]);
    string keys[$];
    peers.delete();
    if (tree == null || nd == null)
        return;
    foreach (tree.nodes[i]) begin
        if (tree.nodes[i] == null)
            continue;
        tree.nodes[i].collect_input_keys_from_source(nd, keys);
        if (keys.size() != 0)
            {{ settings.class_prefix }}append_unique_node(peers, tree.nodes[i]);
    end
endfunction

function automatic void {{ settings.class_prefix }}collect_stable_upstream_nodes(
        input {{ settings.class_prefix }}tree_base tree,
        output {{ settings.class_prefix }}node_base collected[$]);
    {{ settings.class_prefix }}node_base wave[$];
    {{ settings.class_prefix }}node_base peers[$];
    int index;
    collected.delete();
    if (tree == null)
        return;
    foreach (tree.nodes[i])
        if (tree.nodes[i] != null && tree.nodes[i].is_stability_anchor()) begin
            {{ settings.class_prefix }}append_unique_node(collected, tree.nodes[i]);
            {{ settings.class_prefix }}append_unique_node(wave, tree.nodes[i]);
        end
    index = 0;
    while (index < wave.size()) begin
        {{ settings.class_prefix }}tree_upstream_peers(wave[index], peers);
        index++;
        foreach (peers[i])
            if (!{{ settings.class_prefix }}node_in_queue(peers[i], collected)) begin
                {{ settings.class_prefix }}append_unique_node(collected, peers[i]);
                {{ settings.class_prefix }}append_unique_node(wave, peers[i]);
            end
    end
endfunction

function automatic bit {{ settings.class_prefix }}node_has_observed_descendant(
        {{ settings.class_prefix }}tree_base tree,
        {{ settings.class_prefix }}node_base nd);
    {{ settings.class_prefix }}node_base wave[$];
    {{ settings.class_prefix }}node_base peers[$];
    int index;
    if (tree == null || nd == null)
        return 1'b0;
    {{ settings.class_prefix }}tree_downstream_peers(tree, nd, wave);
    index = 0;
    while (index < wave.size()) begin
        if (wave[index].is_observable())
            return 1'b1;
        {{ settings.class_prefix }}tree_downstream_peers(tree, wave[index], peers);
        foreach (peers[i])
            if (!{{ settings.class_prefix }}node_in_queue(peers[i], wave))
                wave.push_back(peers[i]);
        index++;
    end
    return 1'b0;
endfunction

function automatic bit {{ settings.class_prefix }}nodes_share_control_reg(
        input {{ settings.class_prefix }}node_base lhs,
        input {{ settings.class_prefix }}node_base rhs);
    {{ settings.class_prefix }}reg lhs_regs[$];
    {{ settings.class_prefix }}reg rhs_regs[$];
    if (lhs == null || rhs == null)
        return 1'b0;
    lhs.collect_control_regs(lhs_regs);
    rhs.collect_control_regs(rhs_regs);
    foreach (lhs_regs[i])
        foreach (rhs_regs[j])
            if ({{ settings.class_prefix }}reg_bindings_overlap(lhs_regs[i], rhs_regs[j]))
                return 1'b1;
    return 1'b0;
endfunction

`endif
