`ifndef {{ (settings.class_prefix ~ "tree_base") | upper }}
`define {{ (settings.class_prefix ~ "tree_base") | upper }}

class {{ settings.class_prefix }}tree_base extends {{ settings.class_prefix }}base_item;
    `uvm_object_utils_begin({{ settings.class_prefix }}tree_base)
        `uvm_field_queue_object(nodes, UVM_ALL_ON | UVM_NOPRINT)
        `uvm_field_int(built, UVM_DEFAULT | UVM_NOPRINT)
    `uvm_object_utils_end

    {{ settings.class_prefix }}node_base nodes[$];
    bit built;

    // Creates an unbuilt node collection.
    function new(string name = "{{ settings.class_prefix }}tree_base");
        super.new(name);
        built = 1'b0;
    endfunction

    // Rejects use before register binding and initialization.
    extern function void require_built(string ctx);
    // Applies each node's low-power preference.
    extern function void low_power();
    // Applies requested state through the concrete tree implementation.
    virtual task configure();
        `uvm_fatal("CLK_TREE", "tree_base.configure: concrete tree implementation is required")
    endtask
endclass

function void {{ settings.class_prefix }}tree_base::require_built(string ctx);
    if (!built)
        `uvm_fatal("CLK_TREE", $sformatf(
            "%s: tree is not built; call tree.build(regmodel) before use", ctx))
endfunction

function void {{ settings.class_prefix }}tree_base::low_power();
    foreach (nodes[i])
        if (nodes[i] != null)
            nodes[i].apply_low_power_preference();
endfunction

`endif
