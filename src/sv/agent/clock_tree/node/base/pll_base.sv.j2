`ifndef {{ (settings.class_prefix ~ "pll_base") | upper }}
`define {{ (settings.class_prefix ~ "pll_base") | upper }}

class {{ settings.class_prefix }}pll_base extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}pll_base)
        `uvm_field_int(frequence, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(enabled, UVM_ALL_ON | (enabled >= 0 ? 0 : UVM_NOPRINT))
    `uvm_object_utils_end

    longint frequence;
    int enabled;
    pll_kind_e pll_kind;
    bit locked;

    constraint cst_pll {
        enabled == 0 -> !_resolved_active;
        enabled > 0 && source == null -> _resolved_active;
        enabled > 0 && source != null -> _resolved_active == source._resolved_active;
        enabled < 0 && source == null -> _resolved_active;
        enabled < 0 && source != null -> _resolved_active == source._resolved_active;
        _resolved_active -> _resolved_freq == frequence;
        !_resolved_active -> _resolved_freq == 0;
    }

    constraint cst_resolve_freq_from_src {
    }

    constraint cst_resolve_active_from_src {
    }

    // 初始化 PLL 的非强制活动状态。
    function new(string name = "");
        super.new(name);
        frequence = 0;
        enabled = -1;
        kind = "pll";
    endfunction

    // PLL 最先配置，供下游节点使用稳定输出。
    virtual function int configuration_priority();
        return 100;
    endfunction

    // 返回 PLL 配置阶段。
    virtual function {{ settings.class_prefix }}node_config_api::stage_e configuration_stage();
        return {{ settings.class_prefix }}node_config_api::CONFIG_PLL;
    endfunction

    // PLL 配置后需要等待 lock。
    virtual function bit needs_configuration_wait();
        return 1'b1;
    endfunction

    // 配置当前 PLL 并报告是否需要等待 lock。
    virtual task configure_stage(
            input {{ settings.class_prefix }}node_config_api cfg,
            input {{ settings.class_prefix }}node_config_api::stage_e stage,
            output bit configured);
        configured = 1'b0;
        if (stage == {{ settings.class_prefix }}node_config_api::CONFIG_PLL)
            cfg.configure_pll(this, configured);
    endtask

    // 等待当前 PLL 的 lock 状态。
    virtual task wait_for_lock(input {{ settings.class_prefix }}node_config_api cfg);
        cfg.wait_for_pll_lock(this);
    endtask
endclass

`endif
