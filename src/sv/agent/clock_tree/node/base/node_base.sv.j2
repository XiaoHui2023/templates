`ifndef {{ (settings.class_prefix ~ "node_base") | upper }}
`define {{ (settings.class_prefix ~ "node_base") | upper }}

class {{ settings.class_prefix }}node_base extends {{ settings.class_prefix }}base_item;
    `uvm_object_utils_begin({{ settings.class_prefix }}node_base)
        `uvm_field_int(_resolved_freq, UVM_DEFAULT|UVM_DEC|(_should_print ? 0 : UVM_NOPRINT))
        `uvm_field_int(_resolved_active, UVM_DEFAULT|(_should_print ? 0 : UVM_NOPRINT))
    `uvm_object_utils_end

    string kind;
    rand longint _resolved_freq;
    rand bit _resolved_active;
    bit _should_print;
    bit _should_check;
    {{ settings.class_prefix }}node_base source;
    {{ settings.class_prefix }}node_base sources[string];
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    virtual {{ settings.class_prefix }}interface vif;
    virtual {{ settings.class_prefix }}interface in_vif;
    virtual {{ settings.class_prefix }}interface out_vif;
    virtual {{ settings.class_prefix }}interface in_vifs[string];
    virtual {{ settings.class_prefix }}interface out_vifs[string];
`endif

    constraint cst_node_base { (_resolved_freq > 0) == _resolved_active; }
    constraint cst_resolve_active_from_src { source != null -> _resolved_active == source._resolved_active; }
    constraint cst_resolve_freq_from_src { source != null -> _resolved_freq == source._resolved_freq; }

    // Initializes the common node state.
    function new(string name = "");
        super.new(name);
        _should_print = 1'b0;
        _should_check = 1'b1;
    endfunction

    // Binds one generic upstream edge. Empty key is the default input.
    virtual function void set_source(input string key, input {{ settings.class_prefix }}node_base parent);
        if (key == "")
            source = parent;
        else
            sources[key] = parent;
    endfunction

    // Returns the upstream edge selected by key.
    virtual function {{ settings.class_prefix }}node_base get_source(string key = "");
        if (key == "")
            return source;
        if (sources.exists(key))
            return sources[key];
        return null;
    endfunction

    // Collects distinct upstream nodes across all input slots.
    virtual function void collect_source_nodes(output {{ settings.class_prefix }}node_base source_nodes[$]);
        source_nodes.delete();
        if (source != null)
            source_nodes.push_back(source);
        foreach (sources[key])
            if (sources[key] != null && sources[key] != source)
                source_nodes.push_back(sources[key]);
    endfunction

    // Collects this node's input slots connected to parent.
    virtual function void collect_input_keys_from_source(
            input {{ settings.class_prefix }}node_base parent,
            output string keys[$]);
        keys.delete();
        if (source == parent)
            keys.push_back("");
        foreach (sources[key])
            if (sources[key] == parent)
                keys.push_back(key);
    endfunction

`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Reports whether the selected input interface is bound.
    virtual function bit has_in_vif(string key = "");
        return key == "" ? in_vif != null : in_vifs.exists(key) && in_vifs[key] != null;
    endfunction
    // Reports whether the selected output interface is bound.
    virtual function bit has_out_vif(string key = "");
        return key == "" ? out_vif != null : out_vifs.exists(key) && out_vifs[key] != null;
    endfunction
    // Returns the selected input interface handle.
    virtual function virtual {{ settings.class_prefix }}interface get_in_vif(string key = "");
        if (key == "")
            return in_vif;
        if (in_vifs.exists(key))
            return in_vifs[key];
        return null;
    endfunction
    // Returns the selected output interface handle.
    virtual function virtual {{ settings.class_prefix }}interface get_out_vif(string key = "");
        if (key == "")
            return out_vif;
        if (out_vifs.exists(key))
            return out_vifs[key];
        return null;
    endfunction
`endif

    // Returns the plugin's configuration order.
    virtual function int configuration_priority(); return -1; endfunction
    // Reports whether configuration requires an observed descendant.
    virtual function bit requires_observed_descendant(); return 1'b0; endfunction
    // Reports whether this node has a post-write wait.
    virtual function bit waits_after_configuration(); return 1'b0; endfunction
    // Applies this node's configuration through cfg.
    virtual task apply_configuration(input {{ settings.class_prefix }}node_config_api cfg, output bit configured);
        configured = 1'b0;
    endtask
    // Waits for this node's declared post-write condition.
    virtual task await_configuration(input {{ settings.class_prefix }}node_config_api cfg); endtask
    // Finalizes plugin state after register binding.
    virtual function void post_register_bind(); endfunction
    // Collects control registers owned by this node.
    virtual function void collect_control_regs(output {{ settings.class_prefix }}reg regs[$]);
        regs.delete();
    endfunction

    // Reports whether this node exposes a measurement endpoint.
    virtual function bit is_observable();
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
        return vif != null;
`else
        return 1'b0;
`endif
    endfunction
    // Reports whether duty-cycle measurement is meaningful.
    virtual function bit supports_duty_observation(); return 1'b0; endfunction
    // Reports whether this node anchors stability checks.
    virtual function bit is_stability_anchor(); return 1'b0; endfunction
    // Applies this node's low-power preference.
    virtual function void apply_low_power_preference(); endfunction

`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Reports whether this node supplies a functional check.
    virtual function bit has_functional_contract(); return 1'b0; endfunction
    // Runs this node's functional check through api.
    virtual task run_functional_contract(
            input {{ settings.class_prefix }}node_test_api api,
            output bit did_check,
            output bit did_skip,
            output int failures);
        did_check = 1'b0;
        did_skip = 1'b0;
        failures = 0;
    endtask
    // Reports whether functional checks preserve native inputs.
    virtual function bit preserves_native_input(); return 1'b0; endfunction
`endif
endclass

`endif
