`ifndef {{ (settings.class_prefix ~ "reg_rw") | upper }}
`define {{ (settings.class_prefix ~ "reg_rw") | upper }}

// 已绑定 field 有效位宽
function automatic int {{ settings.class_prefix }}reg_bound_width(
        {{ settings.class_prefix }}reg rb);
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "reg_bound_width: field is null")
    if (rb.width > 0)
        return rb.width;
    return rb.field.get_n_bits();
endfunction

// 按绑定位宽得切片可写最大值
function automatic int {{ settings.class_prefix }}reg_bound_max(
        {{ settings.class_prefix }}reg rb);
    int w;
    w = {{ settings.class_prefix }}reg_bound_width(rb);
    return (1 << w) - 1;
endfunction

// Two bindings overlap when they address at least one common bit of one field.
function automatic bit {{ settings.class_prefix }}reg_bindings_overlap(
        input {{ settings.class_prefix }}reg lhs,
        input {{ settings.class_prefix }}reg rhs);
    int lhs_hi;
    int rhs_hi;
    if (lhs == null || rhs == null || !lhs.is_bound() || !rhs.is_bound())
        return 1'b0;
    if (lhs.field != rhs.field)
        return 1'b0;
    lhs_hi = lhs.offset + {{ settings.class_prefix }}reg_bound_width(lhs) - 1;
    rhs_hi = rhs.offset + {{ settings.class_prefix }}reg_bound_width(rhs) - 1;
    return lhs.offset <= rhs_hi && rhs.offset <= lhs_hi;
endfunction

class {{ settings.class_prefix }}reg_rw extends {{ settings.class_prefix }}base_object;
    // 初始化寄存器服务
    function new();
        super.new("{{ settings.class_prefix }}reg_rw");
    endfunction

    // 取 field 所属 uvm_reg
    extern function uvm_reg parent_reg({{ settings.class_prefix }}reg rb);
    // 取得模型 desired 的 field 切片
    extern function int get({{ settings.class_prefix }}reg rb);
    // 修改模型 desired 的 field 切片
    extern function void set({{ settings.class_prefix }}reg rb, int value);
    // 刷新绑定所在寄存器的读回值
    extern task ensure_read({{ settings.class_prefix }}reg rb);
    // 前门读整寄存器
    extern task read_reg(input uvm_reg r, output uvm_reg_data_t rdata);
    // 前门读父寄存器并解析 field 切片
    extern task read(input {{ settings.class_prefix }}reg rb, output int value);
    // 将整字 desired 写到总线
    extern task write_reg(uvm_reg r);
    // 提交父寄存器的整字 desired
    extern task write({{ settings.class_prefix }}reg rb);
    // 按实际读回值比较并修改一个 RW 切片
    extern task set_write({{ settings.class_prefix }}reg rb, int value);
    // 按父寄存器合并 RW 切片，每个父寄存器读一次、最多写一次
    // binds: field 绑定队列
    // vals: 与 binds 同下标的写入值
    extern task apply(input {{ settings.class_prefix }}reg binds[$], input int vals[$]);
    // 检查普通读改写所需的访问策略
    extern local function bit supports_rmw(uvm_reg r);
    // 读取实际整字，失败时返回 ok=0
    extern local task read_value(input uvm_reg r, output uvm_reg_data_t value, output bit ok);
    // 写入整字，失败时返回 ok=0
    extern local task write_value(input uvm_reg r, input uvm_reg_data_t value, output bit ok);
endclass

function uvm_reg {{ settings.class_prefix }}reg_rw::parent_reg({{ settings.class_prefix }}reg rb);
    if (rb == null || rb.field == null) begin
        `uvm_fatal("CLK_TREE", "parent_reg: field is null")
        return null;
    end
    return rb.field.get_register();
endfunction

function int {{ settings.class_prefix }}reg_rw::get({{ settings.class_prefix }}reg rb);
    uvm_reg_data_t full;
    uvm_reg_data_t mask;
    int width;
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "get: field is null")
    full = rb.field.get();
    width = {{ settings.class_prefix }}reg_bound_width(rb);
    mask = '1;
    mask >>= $bits(mask) - width;
    return int'((full >> rb.offset) & mask);
endfunction

function void {{ settings.class_prefix }}reg_rw::set({{ settings.class_prefix }}reg rb, int value);
    uvm_reg_data_t cur;
    uvm_reg_data_t mask;
    uvm_reg_data_t slice_mask;
    uvm_reg_data_t newval;
    int width;
    if (rb.field == null)
        `uvm_fatal("CLK_TREE", "set: field is null")
    width = {{ settings.class_prefix }}reg_bound_width(rb);
    slice_mask = '1;
    slice_mask >>= $bits(slice_mask) - width;
    if (rb.offset == 0 && width == rb.field.get_n_bits()) begin
        rb.field.set(value);
    end else begin
        cur = rb.field.get();
        mask = slice_mask << rb.offset;
        newval = (cur & ~mask) | ((uvm_reg_data_t'(value) & slice_mask) << rb.offset);
        rb.field.set(newval);
    end
endfunction

function bit {{ settings.class_prefix }}reg_rw::supports_rmw(uvm_reg r);
    uvm_reg_field fields[$];
    r.get_fields(fields);
    foreach (fields[i]) begin
        string access;
        access = fields[i].get_access();
        if (!(access inside {"RW", "RO"})) begin
            `uvm_fatal("CLK_TREE", $sformatf(
                "read-modify-write: %s access %s requires a dedicated write operation",
                fields[i].get_full_name(), access))
            return 0;
        end
    end
    return 1;
endfunction

task {{ settings.class_prefix }}reg_rw::read_value(
        input uvm_reg r, output uvm_reg_data_t value, output bit ok);
    uvm_status_e status;
    value = '0;
    ok = 0;
    if (r == null) begin
        `uvm_fatal("CLK_TREE", "read_reg: reg is null")
        return;
    end
    r.read(status, value, UVM_FRONTDOOR);
    if (status != UVM_IS_OK) begin
        `uvm_fatal("CLK_TREE", $sformatf(
            "read_reg: read %s failed", r.get_full_name()))
        return;
    end
    ok = 1;
endtask

task {{ settings.class_prefix }}reg_rw::read_reg(input uvm_reg r, output uvm_reg_data_t rdata);
    bit ok;
    read_value(r, rdata, ok);
endtask

task {{ settings.class_prefix }}reg_rw::ensure_read({{ settings.class_prefix }}reg rb);
    int dummy;
    read(rb, dummy);
endtask

task {{ settings.class_prefix }}reg_rw::read(input {{ settings.class_prefix }}reg rb, output int value);
    uvm_reg r;
    uvm_reg_data_t reg_rdata;
    uvm_reg_data_t mask;
    int width;
    bit ok;
    value = 0;
    r = parent_reg(rb);
    if (r == null)
        return;
    read_value(r, reg_rdata, ok);
    if (!ok)
        return;
    width = {{ settings.class_prefix }}reg_bound_width(rb);
    mask = '1;
    mask >>= $bits(mask) - width;
    value = int'((reg_rdata >> (rb.field.get_lsb_pos() + rb.offset)) & mask);
endtask

task {{ settings.class_prefix }}reg_rw::write_value(
        input uvm_reg r, input uvm_reg_data_t value, output bit ok);
    uvm_status_e status;
    ok = 0;
    if (r == null) begin
        `uvm_fatal("CLK_TREE", "write_reg: reg is null")
        return;
    end
    r.write(status, value, UVM_FRONTDOOR);
    if (status != UVM_IS_OK) begin
        `uvm_fatal("CLK_TREE", $sformatf(
            "write_reg: write %s 0x%0h failed", r.get_full_name(), value))
        return;
    end
    ok = 1;
endtask

task {{ settings.class_prefix }}reg_rw::write_reg(uvm_reg r);
    bit ok;
    if (r == null) begin
        `uvm_fatal("CLK_TREE", "write_reg: reg is null")
        return;
    end
    write_value(r, r.get(), ok);
endtask

task {{ settings.class_prefix }}reg_rw::write({{ settings.class_prefix }}reg rb);
    write_reg(parent_reg(rb));
endtask

task {{ settings.class_prefix }}reg_rw::set_write({{ settings.class_prefix }}reg rb, int value);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];
    binds.push_back(rb);
    vals.push_back(value);
    apply(binds, vals);
endtask

task {{ settings.class_prefix }}reg_rw::apply(
        input {{ settings.class_prefix }}reg binds[$],
        input int vals[$]);
    uvm_reg regs[$];
    uvm_reg_data_t original[$];
    uvm_reg_data_t patched[$];
    bit ok;
    if (binds.size() != vals.size()) begin
        `uvm_fatal("CLK_TREE", $sformatf(
            "apply: binds size %0d != vals size %0d", binds.size(), vals.size()))
        return;
    end
    for (int i = 0; i < binds.size(); i++) begin
        uvm_reg r;
        uvm_reg_data_t mask;
        uvm_reg_data_t data;
        int index;
        int width;
        int shift;
        r = parent_reg(binds[i]);
        if (r == null)
            return;
        width = {{ settings.class_prefix }}reg_bound_width(binds[i]);
        if (width < 1 || width > 32 ||
                binds[i].offset + width > binds[i].field.get_n_bits() ||
                binds[i].field.get_access() != "RW") begin
            `uvm_fatal("CLK_TREE", $sformatf(
                "apply: %s requires a valid RW slice of at most 32 bits",
                binds[i].field.get_full_name()))
            return;
        end
        index = -1;
        foreach (regs[j])
            if (regs[j] == r)
                index = j;
        if (index < 0) begin
            if (!supports_rmw(r))
                return;
            read_value(r, data, ok);
            if (!ok)
                return;
            index = regs.size();
            regs.push_back(r);
            original.push_back(data);
            patched.push_back(data);
        end
        mask = '1;
        mask >>= $bits(mask) - width;
        shift = binds[i].field.get_lsb_pos() + binds[i].offset;
        patched[index] = (patched[index] & ~(mask << shift)) |
            ((uvm_reg_data_t'(vals[i]) & mask) << shift);
    end
    foreach (regs[i]) begin
        if (patched[i] == original[i])
            continue;
        write_value(regs[i], patched[i], ok);
        if (!ok)
            return;
    end
endtask

`endif
