`ifndef {{ (settings.class_prefix ~ "tree") | upper }}
`define {{ (settings.class_prefix ~ "tree") | upper }}

class {{ settings.class_prefix }}tree extends {{ settings.class_prefix }}tree_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}tree)
{%- for node in tree.sv_nodes_ordered %}
{%- if node.output_groups %}
        `uvm_field_aa_object_string({{ node.name }}, UVM_ALL_ON)
{%- else %}
        `uvm_field_object({{ node.name }}, UVM_ALL_ON)
{%- endif %}
{%- endfor %}
    `uvm_object_utils_end

{%- for node in tree.sv_nodes_ordered %}
{%- if node.output_groups %}
    rand {{ settings.class_prefix }}{{ node.kind }} {{ node.name }}[string];
{%- else %}
    rand {{ settings.class_prefix }}{{ node.kind }} {{ node.name }};
{%- endif %}
{%- endfor %}

{%- if shared_reg_constraints %}
    constraint cst_shared_registers {
{%- for lhs, rhs in shared_reg_constraints %}
        {{ lhs }} == {{ rhs }};
{%- endfor %}
    }

{%- endif %}
    // Creates node instances and binds graph and output relationships.
    function new(string name = "{{ settings.class_prefix }}tree");
        super.new(name);
{%- for node in tree.sv_nodes_ordered %}
{%- for output in node.output_groups or [""] %}
{%- set access = node.name ~ '["' ~ output ~ '"]' if output else node.name %}
        {{ access }} = {{ settings.class_prefix }}{{ node.kind }}::type_id::create("{{ node.name }}{% if output %}[{{ output }}]{% endif %}");
        {{ access }}.kind = "{{ node.kind }}";
{%- if output %}
        {{ access }}.output_name = "{{ output }}";
{%- endif %}
{%- for field, value in node.sv_assignments_by_output[output] %}
        {{ access }}.{{ field }} = {{ value }};
{%- endfor %}
{%- endfor %}
{%- endfor %}
{%- for node in tree.sv_nodes_ordered if node.output_groups %}
{%- for output in node.output_groups %}
{%- for peer in node.output_groups %}
        {{ node.name }}["{{ output }}"].set_output_peer("{{ peer }}", {{ node.name }}["{{ peer }}"]);
{%- endfor %}
{%- endfor %}
{%- endfor %}
{%- for node in tree.sv_nodes_ordered %}
{%- for output in node.output_groups or [""] %}
{%- set access = node.name ~ '["' ~ output ~ '"]' if output else node.name %}
{%- for source in node.sources %}
{%- set parent = source.name ~ '["' ~ source.output ~ '"]' if source.output else source.name %}
        {{ access }}.set_source("{{ source.input_key }}", {{ parent }});
{%- endfor %}
{%- endfor %}
{%- endfor %}
        nodes.delete();
{%- for slot in tree.sv_slots %}
        nodes.push_back({{ slot.access }});
{%- endfor %}
    endfunction

    // Binds registers and resolves the initial graph state.
    extern function void build({{ settings.class_regmodel }} regmodel = null);
    // Resolves requested state and applies node configuration.
    extern virtual task configure();
endclass

function void {{ settings.class_prefix }}tree::build({{ settings.class_regmodel }} regmodel);
    built = 1'b0;
    if (regmodel != null) begin
{%- for binding in reg_bindings %}
        {{ binding.sv_access }}.{{ binding.member }}.field = regmodel.{{ binding.path }};
        {{ binding.sv_access }}.{{ binding.member }}.offset = {{ binding.offset if binding.offset is not none else 0 }};
{%- if binding.width is none %}
        {{ binding.sv_access }}.{{ binding.member }}.width = {{ binding.sv_access }}.{{ binding.member }}.field.get_n_bits();
{%- else %}
        {{ binding.sv_access }}.{{ binding.member }}.width = {{ binding.width }};
{%- endif %}
        {{ binding.sv_access }}.{{ binding.member }}.alias_count = {{ binding.alias_count }};
        {{ binding.sv_access }}.bind_control_reg({{ binding.sv_access }}.{{ binding.member }});
{%- endfor %}
    end
    foreach (nodes[i])
        nodes[i].post_register_bind();
    if (!randomize())
        `uvm_fatal("CLK_TREE", "build: tree randomize failed")
    built = 1'b1;
endfunction

task {{ settings.class_prefix }}tree::configure();
    {{ settings.class_prefix }}core_tools tools;
    {{ settings.class_prefix }}config_reg_core cfg;

    require_built("tree.configure");
    if (!randomize())
        `uvm_fatal("CLK_TREE", "tree.configure: tree randomize failed")
    tools = new;
    cfg = new(tools);
    cfg.configure_tree(this);
endtask

// Applies the tree's current configuration requests.
task automatic {{ settings.class_prefix }}config_reg(
        {{ settings.class_prefix }}tree tree);
    tree.configure();
endtask

`endif
