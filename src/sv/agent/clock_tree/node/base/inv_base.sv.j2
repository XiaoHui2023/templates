`ifndef {{ (settings.class_prefix ~ "inv_base") | upper }}
`define {{ (settings.class_prefix ~ "inv_base") | upper }}

class {{ settings.class_prefix }}inv_base extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}inv_base)
        `uvm_field_int(inverted, UVM_ALL_ON)
        `uvm_field_int(fix_inverted, UVM_DEFAULT|(_print_fix?0:UVM_NOPRINT))
    `uvm_object_utils_end

    inv_kind_e inv_kind;
    rand bit inverted;
    bit fix_inverted;
    {{ settings.class_prefix }}reg f_reg;

    constraint cst_resolve_active_from_src {
        source != null -> _resolved_active == source._resolved_active;
    }

    constraint cst_resolve_freq_from_src {
        source != null -> _resolved_freq == source._resolved_freq;
    }

    constraint cst_inv {
        fix_inverted -> inverted;
    }

    // 初始化反相状态。
    function new(string name = "");
        super.new(name);
        inverted = 1'b1;
        fix_inverted = 0;
        f_reg = new();
        kind = "inv";
    endfunction

    // inv 在分频器之后、mux 之前配置。
    virtual function int configuration_priority();
        return 300;
    endfunction

    // 返回反相器配置阶段。
    virtual function {{ settings.class_prefix }}node_config_api::stage_e configuration_stage();
        return {{ settings.class_prefix }}node_config_api::CONFIG_INV;
    endfunction

    // 写入当前反相控制位。
    virtual task configure_stage(
            input {{ settings.class_prefix }}node_config_api cfg,
            input {{ settings.class_prefix }}node_config_api::stage_e stage,
            output bit configured);
        configured = 1'b0;
        if (stage == {{ settings.class_prefix }}node_config_api::CONFIG_INV)
            cfg.configure_inv(this, configured);
    endtask
`ifdef {{ (settings.class_prefix ~ "interface") | upper }}
    // Declares an isolated inverter transition check.
    virtual function bit has_transition_check();
        return 1'b1;
    endfunction

    // Checks direct and inverted levels after each polarity write.
    virtual task run_transition_check(
            input {{ settings.class_prefix }}node_test_api api,
            output bit did_check,
            output bit did_skip,
            output int failures);
        virtual {{ settings.class_prefix }}interface in_vif;
        virtual {{ settings.class_prefix }}interface out_vif;
        bit configured;

        did_check = 1'b0;
        did_skip = 1'b0;
        failures = 0;
        in_vif = get_in_vif();
        out_vif = get_out_vif();
        if (api == null || api.cfg == null || in_vif == null || out_vif == null
                || !f_reg.is_bound()) begin
            did_skip = 1'b1;
            `uvm_info("CLK_TREE", $sformatf(
                "test_flip: skip inv %s, missing interface or reg",
                get_name()), UVM_LOW)
            return;
        end
        `uvm_info("CLK_TREE", $sformatf(
            "test_flip: test inv %s", get_name()), UVM_LOW)
        api.cfg.configure_transition_inv(this, 1'b0, configured);
        #({{ settings.flip_inv_config_settle_ns }}ns);
        in_vif.drive_static(1'b0);
        #1ns;
        if (out_vif.in !== 1'b0) begin
            failures++;
            `uvm_error("CLK_TREE", $sformatf(
                "test_flip: inv %s direct input 0 output %0b", get_name(), out_vif.in))
        end
        in_vif.drive_static(1'b1);
        #1ns;
        if (out_vif.in !== 1'b1) begin
            failures++;
            `uvm_error("CLK_TREE", $sformatf(
                "test_flip: inv %s direct input 1 output %0b", get_name(), out_vif.in))
        end
        api.cfg.configure_transition_inv(this, 1'b1, configured);
        #({{ settings.flip_inv_config_settle_ns }}ns);
        in_vif.drive_static(1'b0);
        #1ns;
        if (out_vif.in !== 1'b1) begin
            failures++;
            `uvm_error("CLK_TREE", $sformatf(
                "test_flip: inv %s inverted input 0 output %0b", get_name(), out_vif.in))
        end
        in_vif.drive_static(1'b1);
        #1ns;
        if (out_vif.in !== 1'b0) begin
            failures++;
            `uvm_error("CLK_TREE", $sformatf(
                "test_flip: inv %s inverted input 1 output %0b", get_name(), out_vif.in))
        end
        in_vif.release_drive();
        did_check = 1'b1;
    endtask
`endif
endclass

`endif
