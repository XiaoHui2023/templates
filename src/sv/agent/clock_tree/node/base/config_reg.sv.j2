`ifndef {{ (settings.class_prefix ~ "config_reg_core") | upper }}
`define {{ (settings.class_prefix ~ "config_reg_core") | upper }}

class {{ settings.class_prefix }}config_reg_core extends {{ settings.class_prefix }}node_config_api;
    // Binds the register service.
    function new({{ settings.class_prefix }}core_tools tools_h);
        super.new(tools_h, "{{ settings.class_prefix }}config_reg_core");
    endfunction

    // Builds and validates one plugin-declared configuration plan.
    extern task configure_tree(input {{ settings.class_prefix }}tree_base tree);
endclass

task {{ settings.class_prefix }}config_reg_core::configure_tree(input {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}config_context context_h;
    {{ settings.class_prefix }}node_base node_h;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "config_reg: tree is null")
    context_h = new(this);
    foreach (tree.nodes[i]) begin
        node_h = tree.nodes[i];
        if (node_h == null || !node_h.has_configuration())
            continue;
        if (node_h.requires_observed_descendant()
                && !{{ settings.class_prefix }}node_has_observed_descendant(tree, node_h)) begin
            `uvm_info("CLK_TREE", $sformatf(
                "config_reg: %s invalid, no observed descendant", node_h.get_name()), UVM_LOW)
            continue;
        end
        context_h.enlist(node_h);
    end
    foreach (tree.nodes[i]) begin
        if (context_h.has_failed()) return;
        if (tree.nodes[i] != null)
            tree.nodes[i].observe_configuration(context_h);
    end
    foreach (tree.nodes[i]) begin
        if (context_h.has_failed()) return;
        if (tree.nodes[i] != null && context_h.target(tree.nodes[i]) != null)
            tree.nodes[i].plan_configuration(context_h, context_h.target(tree.nodes[i]));
    end
    context_h.execute();
endtask

`endif
