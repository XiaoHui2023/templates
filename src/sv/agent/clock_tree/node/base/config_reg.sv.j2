`ifndef {{ (settings.class_prefix ~ "config_reg_core") | upper }}
`define {{ (settings.class_prefix ~ "config_reg_core") | upper }}

class {{ settings.class_prefix }}config_reg_core extends {{ settings.class_prefix }}node_config_api;
    // Binds the register service and diagnostic policy.
    function new({{ settings.class_prefix }}core_tools tools_h, bit quiet = 1'b0);
        super.new(tools_h, quiet, "{{ settings.class_prefix }}config_reg_core");
    endfunction

    // Applies node configuration and completion barriers in priority order.
    extern task configure_tree(input {{ settings.class_prefix }}tree_base tree);
    // Applies the already selected low-power constraints.
    extern task configure_low_power(input {{ settings.class_prefix }}tree_base tree, bit quiet = 1'b0);
endclass

task {{ settings.class_prefix }}config_reg_core::configure_tree(input {{ settings.class_prefix }}tree_base tree);
    {{ settings.class_prefix }}node_base ordered[$];
    {{ settings.class_prefix }}node_base node_h;
    int insert_at;
    bit configured;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "config_reg: tree is null")
    foreach (tree.nodes[i]) begin
        node_h = tree.nodes[i];
        if (node_h == null || node_h.configuration_priority() < 0)
            continue;
        if (node_h.requires_observed_descendant()
                && !{{ settings.class_prefix }}node_has_observed_descendant(tree, node_h)) begin
            if (!quiet)
                `uvm_info("CLK_TREE", $sformatf(
                    "config_reg: %s invalid, no observed descendant", node_h.get_name()), UVM_MEDIUM)
            continue;
        end
        insert_at = ordered.size();
        for (int j = 0; j < ordered.size(); j++)
            if (node_h.configuration_priority() < ordered[j].configuration_priority()) begin
                insert_at = j;
                break;
            end
        ordered.insert(insert_at, node_h);
    end
    foreach (ordered[i]) begin
        configured = 1'b0;
        ordered[i].apply_configuration(this, configured);
        if (configured && ordered[i].waits_after_configuration())
            ordered[i].await_configuration(this);
    end
    foreach (tree.nodes[i])
        if (tree.nodes[i] != null)
            tree.nodes[i].restore_configuration(this);
endtask

task {{ settings.class_prefix }}config_reg_core::configure_low_power(
        input {{ settings.class_prefix }}tree_base tree,
        bit quiet = 1'b0);
    if (tree == null)
        `uvm_fatal("CLK_TREE", "low_power config: tree is null")
    tree.require_built("low_power config");
    if (!tree.randomize())
        `uvm_fatal("CLK_TREE", "low_power config: tree randomize failed")
    this.quiet = quiet;
    configure_tree(tree);
endtask

`endif
