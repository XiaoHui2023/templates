{% if settings.direct_config and regs_enabled %}
`ifndef {{ (settings.class_prefix ~ "direct_config") | upper }}
`define {{ (settings.class_prefix ~ "direct_config") | upper }}

class {{ settings.class_prefix }}direct_configurator;
    localparam int SC_FBDIV_HW_MIN = 1;
    localparam int SC_FBDIV_HW_MAX = 4095;
    localparam int SC_FBDIV_PREF_MIN = {{ settings.pll_sc_fbdiv_min }};
    localparam int SC_FBDIV_PREF_MAX = {{ settings.pll_sc_fbdiv_max }};
    localparam int DW_FBDIV_MIN = 1;
    localparam int DW_FBDIV_MAX = 1023;
    bit quiet;

    function new(bit quiet = 1'b0);
        this.quiet = quiet;
    endfunction

    extern function int reg_width({{ settings.class_prefix }}reg rb);
    extern function int reg_max({{ settings.class_prefix }}reg rb);
    extern function uvm_reg parent_reg({{ settings.class_prefix }}reg rb);
    extern function int get({{ settings.class_prefix }}reg rb);
    extern function void set({{ settings.class_prefix }}reg rb, int value);
    extern task read_reg(uvm_reg r, output int rdata);
    extern task read({{ settings.class_prefix }}reg rb, output int value);
    extern task write_reg(uvm_reg r);
    extern task set_write({{ settings.class_prefix }}reg rb, int value);
    extern task apply(input {{ settings.class_prefix }}reg binds[$], input int vals[$]);

    extern function int div_ratio_to_n(int ratio);
    extern function bit dto_ratio_is_bypass(int ratio);
    extern function int dto_ratio_to_step(int ratio);
    // Check whether a node handle already exists in a queue.
    extern function bit node_in_queue(
        {{ settings.class_prefix }}node_base nd,
        {{ settings.class_prefix }}node_base q[$]);
    // Append a node handle only when it is non-null and not already present.
    extern function void append_unique_node(
        ref {{ settings.class_prefix }}node_base dest[$],
        input {{ settings.class_prefix }}node_base nd);
    // Collect direct downstream peers from source and mux input links.
    extern function void tree_downstream_peers(
        {{ settings.class_prefix }}tree tree,
        {{ settings.class_prefix }}node_base nd,
        output {{ settings.class_prefix }}node_base peers[$]);
    // Check whether a node can reach any connected clk node.
    extern function bit node_has_downstream_clk(
        {{ settings.class_prefix }}tree tree,
        {{ settings.class_prefix }}node_base nd);
    // Check whether a control node should participate in configuration.
    extern function bit control_node_is_valid(
        {{ settings.class_prefix }}tree tree,
        {{ settings.class_prefix }}node_base nd);
    // Report control nodes that do not reach any connected clk.
    extern task report_invalid_control_nodes({{ settings.class_prefix }}tree tree);

    extern task configure_gate({{ settings.class_prefix }}gate gate_nd, bit open);
    extern task configure_mux({{ settings.class_prefix }}mux mux_nd);
    extern task configure_div({{ settings.class_prefix }}div_div div_nd);
    extern task configure_dto({{ settings.class_prefix }}div_dto dto_nd);
    extern task configure_inv({{ settings.class_prefix }}inv_base inv_nd);
    extern task configure_pll({{ settings.class_prefix }}pll_base pll_nd, output bit configured);
    extern task wait_pll({{ settings.class_prefix }}pll_base pll_nd);

    extern function void tci_divisors(longint out_hz, longint ref_hz,
        output int clkr, output int clkf, output int clkod, output int bwadj);
    extern function void sc_divisors(longint out_hz, longint ref_hz,
        output int fbdiv, output int refdiv, output int postdiv1, output int postdiv2);
    extern function void dw_divisors(longint out_hz, longint ref_hz,
        output int fbdiv, output int prediv, output int divvcop,
        output int p, output int divvcor, output int r);
    extern function bit inno_fbdiv_legal(int fbdiv);
    extern function void inno_shared_divisors(longint out_hz, longint ref_hz,
        int fbdiv_max, output int fbdiv, output int refdiv);
    extern function void inno_postdivisors(longint out_hz, longint ref_hz,
        int fbdiv, int refdiv, output int postdiv1, output int postdiv2);

    extern task configure_all({{ settings.class_prefix }}tree tree);
endclass

task automatic {{ settings.class_prefix }}config_reg(
        {{ settings.class_prefix }}tree tree,
        bit quiet = 1'b0);
    {{ settings.class_prefix }}direct_configurator cfg;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "config_reg: tree is null")
    tree.require_built("config_reg");
    cfg = new(quiet);
    cfg.configure_all(tree);
endtask

function int {{ settings.class_prefix }}direct_configurator::reg_width(
        {{ settings.class_prefix }}reg rb);
    if (rb == null || rb.field == null)
        `uvm_fatal("CLK_TREE", "direct_config: reg field is null")
    if (rb.width > 0)
        return rb.width;
    return rb.field.get_n_bits();
endfunction

function int {{ settings.class_prefix }}direct_configurator::reg_max(
        {{ settings.class_prefix }}reg rb);
    int w;
    w = reg_width(rb);
    if (w >= 31)
        return '1;
    return (1 << w) - 1;
endfunction

function uvm_reg {{ settings.class_prefix }}direct_configurator::parent_reg(
        {{ settings.class_prefix }}reg rb);
    if (rb == null || rb.field == null)
        `uvm_fatal("CLK_TREE", "direct_config: parent_reg field is null")
    return rb.field.get_register();
endfunction

function int {{ settings.class_prefix }}direct_configurator::get(
        {{ settings.class_prefix }}reg rb);
    int full;
    int mask;
    if (rb == null || rb.field == null)
        `uvm_fatal("CLK_TREE", "direct_config: get field is null")
    full = rb.field.get();
    if (rb.offset == 0 && rb.width == rb.field.get_n_bits())
        return full;
    mask = reg_max(rb);
    return (full >> rb.offset) & mask;
endfunction

function void {{ settings.class_prefix }}direct_configurator::set(
        {{ settings.class_prefix }}reg rb,
        int value);
    int cur;
    int mask;
    int slice_mask;
    int newval;
    if (rb == null || rb.field == null)
        `uvm_fatal("CLK_TREE", "direct_config: set field is null")
    slice_mask = reg_max(rb);
    if (rb.offset == 0 && rb.width == rb.field.get_n_bits())
        rb.field.set(value);
    else begin
        cur = rb.field.get();
        mask = slice_mask << rb.offset;
        newval = (cur & ~mask) | ((value & slice_mask) << rb.offset);
        rb.field.set(newval);
    end
endfunction

task {{ settings.class_prefix }}direct_configurator::read_reg(
        uvm_reg r,
        output int rdata);
    uvm_status_e status;
    if (r == null)
        `uvm_fatal("CLK_TREE", "direct_config: read_reg null")
    r.read(status, rdata);
    if (status != UVM_IS_OK)
        `uvm_fatal("CLK_TREE", $sformatf(
            "direct_config: read %s failed", r.get_full_name()))
endtask

task {{ settings.class_prefix }}direct_configurator::read(
        {{ settings.class_prefix }}reg rb,
        output int value);
    int full;
    read_reg(parent_reg(rb), full);
    rb.has_read = 1'b1;
    value = get(rb);
endtask

task {{ settings.class_prefix }}direct_configurator::write_reg(uvm_reg r);
    uvm_status_e status;
    int wdata;
    if (r == null)
        `uvm_fatal("CLK_TREE", "direct_config: write_reg null")
    wdata = r.get();
    r.write(status, wdata);
    if (status != UVM_IS_OK)
        `uvm_fatal("CLK_TREE", $sformatf(
            "direct_config: write %s failed", r.get_full_name()))
endtask

task {{ settings.class_prefix }}direct_configurator::set_write(
        {{ settings.class_prefix }}reg rb,
        int value);
    int cur;
    if (!rb.has_read)
        read(rb, cur);
    else
        cur = get(rb);
    if (cur == value)
        return;
    set(rb, value);
    write_reg(parent_reg(rb));
endtask

task {{ settings.class_prefix }}direct_configurator::apply(
        input {{ settings.class_prefix }}reg binds[$],
        input int vals[$]);
    uvm_reg regs[$];
    uvm_reg read_regs[$];
    if (binds.size() != vals.size())
        `uvm_fatal("CLK_TREE", "direct_config: apply size mismatch")
    for (int i = 0; i < binds.size(); i++) begin
        int cur;
        uvm_reg r;
        bit seen;
        bit reg_read;
        r = parent_reg(binds[i]);
        reg_read = 0;
        foreach (read_regs[j])
            if (read_regs[j] == r)
                reg_read = 1;
        if (!reg_read) begin
            int dummy;
            read_reg(r, dummy);
            read_regs.push_back(r);
        end
        binds[i].has_read = 1'b1;
        cur = get(binds[i]);
        if (cur == vals[i])
            continue;
        set(binds[i], vals[i]);
        seen = 0;
        foreach (regs[j])
            if (regs[j] == r)
                seen = 1;
        if (!seen)
            regs.push_back(r);
    end
    foreach (regs[i])
        write_reg(regs[i]);
endtask

function int {{ settings.class_prefix }}direct_configurator::div_ratio_to_n(int ratio);
    if (ratio <= 1)
        return 0;
    if (ratio > 64)
        `uvm_fatal("CLK_TREE", $sformatf(
            "direct_config: div ratio %0d exceeds 64", ratio))
    return ratio - 1;
endfunction

function bit {{ settings.class_prefix }}direct_configurator::dto_ratio_is_bypass(int ratio);
    return ratio == 1;
endfunction

function int {{ settings.class_prefix }}direct_configurator::dto_ratio_to_step(int ratio);
    longint step_i;
    longint max_step;
    if (ratio <= 0)
        `uvm_fatal("CLK_TREE", "direct_config: dto ratio must be positive")
    max_step = longint'(1) << 25;
    step_i = max_step / ratio;
    if (step_i < 1 || step_i >= max_step)
        `uvm_fatal("CLK_TREE", $sformatf(
            "direct_config: dto ratio %0d out of range", ratio))
    return int'(step_i);
endfunction

// Check whether a node handle already exists in a queue.
function bit {{ settings.class_prefix }}direct_configurator::node_in_queue(
        {{ settings.class_prefix }}node_base nd,
        {{ settings.class_prefix }}node_base q[$]);
    foreach (q[i])
        if (q[i] == nd)
            return 1'b1;
    return 1'b0;
endfunction

// Append a node handle only when it is non-null and not already present.
function void {{ settings.class_prefix }}direct_configurator::append_unique_node(
        ref {{ settings.class_prefix }}node_base dest[$],
        input {{ settings.class_prefix }}node_base nd);
    if (nd == null)
        return;
    if (node_in_queue(nd, dest))
        return;
    dest.push_back(nd);
endfunction

// Collect direct downstream peers from source and mux input links.
function void {{ settings.class_prefix }}direct_configurator::tree_downstream_peers(
        {{ settings.class_prefix }}tree tree,
        {{ settings.class_prefix }}node_base nd,
        output {{ settings.class_prefix }}node_base peers[$]);
    {{ settings.class_prefix }}mux mux_nd;
    peers.delete();
    if (tree == null || nd == null)
        return;
    foreach (tree.nodes[i]) begin
        if (tree.nodes[i] == null)
            continue;
        if ($cast(mux_nd, tree.nodes[i])) begin
            foreach (mux_nd.to_source[k])
                if (mux_nd.to_source[k] == nd)
                    append_unique_node(peers, tree.nodes[i]);
        end else if (tree.nodes[i].source == nd)
            append_unique_node(peers, tree.nodes[i]);
    end
endfunction

// Check whether a node can reach any connected clk node.
function bit {{ settings.class_prefix }}direct_configurator::node_has_downstream_clk(
        {{ settings.class_prefix }}tree tree,
        {{ settings.class_prefix }}node_base nd);
    {{ settings.class_prefix }}node_base seen[$];
    {{ settings.class_prefix }}node_base wave[$];
    {{ settings.class_prefix }}node_base peers[$];
    {{ settings.class_prefix }}clk clk_nd;
    int w;

    if (tree == null || nd == null)
        return 1'b0;
    tree_downstream_peers(tree, nd, peers);
    foreach (peers[i]) begin
        append_unique_node(seen, peers[i]);
        append_unique_node(wave, peers[i]);
    end
    w = 0;
    while (w < wave.size()) begin
        {{ settings.class_prefix }}node_base cur;
        cur = wave[w];
        w++;
        if ($cast(clk_nd, cur))
            return 1'b1;
        tree_downstream_peers(tree, cur, peers);
        foreach (peers[j]) begin
            if (!node_in_queue(peers[j], seen)) begin
                append_unique_node(seen, peers[j]);
                append_unique_node(wave, peers[j]);
            end
        end
    end
    return 1'b0;
endfunction

// Check whether a control node should participate in configuration.
function bit {{ settings.class_prefix }}direct_configurator::control_node_is_valid(
        {{ settings.class_prefix }}tree tree,
        {{ settings.class_prefix }}node_base nd);
    if (nd == null)
        return 1'b0;
    if (nd.kind == "gate" || nd.kind == "mux" || nd.kind == "div")
        return node_has_downstream_clk(tree, nd);
    return 1'b1;
endfunction

// Report control nodes that do not reach any connected clk.
task {{ settings.class_prefix }}direct_configurator::report_invalid_control_nodes(
        {{ settings.class_prefix }}tree tree);
    if (quiet || tree == null)
        return;
    for (int i = 0; i < tree.nodes.size(); i++) begin
        if (tree.nodes[i] == null)
            continue;
        if (!(tree.nodes[i].kind == "gate" || tree.nodes[i].kind == "mux"
                || tree.nodes[i].kind == "div"))
            continue;
        if (control_node_is_valid(tree, tree.nodes[i]))
            continue;
        `uvm_info("CLK_TREE", $sformatf(
            "config_reg: %s %s invalid",
            tree.nodes[i].kind, tree.nodes[i].get_name()), UVM_MEDIUM)
    end
endtask

task {{ settings.class_prefix }}direct_configurator::configure_gate(
        {{ settings.class_prefix }}gate gate_nd,
        bit open);
    if (gate_nd == null || !gate_nd.f_reg.is_bound())
        return;
{%- if settings.gate_reg_high_means_open %}
    set_write(gate_nd.f_reg, open);
{%- else %}
    set_write(gate_nd.f_reg, !open);
{%- endif %}
endtask

task {{ settings.class_prefix }}direct_configurator::configure_mux(
        {{ settings.class_prefix }}mux mux_nd);
    if (mux_nd == null || !mux_nd.f_reg.is_bound())
        return;
    set_write(mux_nd.f_reg, mux_nd._resolved_sel);
endtask

task {{ settings.class_prefix }}direct_configurator::configure_inv(
        {{ settings.class_prefix }}inv_base inv_nd);
    if (inv_nd == null || !inv_nd.f_reg.is_bound())
        return;
{%- if settings.inv_reg_high_means_inverted %}
    set_write(inv_nd.f_reg, inv_nd.inverted);
{%- else %}
    set_write(inv_nd.f_reg, !inv_nd.inverted);
{%- endif %}
endtask

task {{ settings.class_prefix }}direct_configurator::configure_div(
        {{ settings.class_prefix }}div_div div_nd);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];
    int n;
    if (div_nd == null || !div_nd.f_rst.is_bound()
            || !div_nd.f_load.is_bound() || !div_nd.f_div.is_bound())
        return;
    n = div_ratio_to_n(div_nd._resolved_ratio);
{%- if settings.should_reset_div %}
{%- if settings.div_reg_high_means_reset %}
    set_write(div_nd.f_rst, 1);
    binds = '{div_nd.f_rst, div_nd.f_div, div_nd.f_load};
    vals = '{0, n, 0};
{%- else %}
    set_write(div_nd.f_rst, 0);
    binds = '{div_nd.f_rst, div_nd.f_div, div_nd.f_load};
    vals = '{1, n, 0};
{%- endif %}
    apply(binds, vals);
    set_write(div_nd.f_load, 1);
{%- else %}
{%- if settings.div_reg_high_means_reset %}
    set_write(div_nd.f_rst, 0);
{%- else %}
    set_write(div_nd.f_rst, 1);
{%- endif %}
    set_write(div_nd.f_div, n);
    set_write(div_nd.f_load, 0);
    set_write(div_nd.f_load, 1);
{%- endif %}
endtask

task {{ settings.class_prefix }}direct_configurator::configure_dto(
        {{ settings.class_prefix }}div_dto dto_nd);
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];
    int step;
    if (dto_nd == null || !dto_nd.f_rst.is_bound()
            || !dto_nd.f_load.is_bound() || !dto_nd.f_bypass.is_bound()
            || !dto_nd.f_step.is_bound())
        return;
    set_write(dto_nd.f_load, 0);
    if (dto_ratio_is_bypass(dto_nd._resolved_ratio)) begin
        binds = '{dto_nd.f_load, dto_nd.f_bypass, dto_nd.f_step};
        vals = '{1, 1, 0};
    end else begin
        step = dto_ratio_to_step(dto_nd._resolved_ratio);
        binds = '{dto_nd.f_load, dto_nd.f_bypass, dto_nd.f_step};
        vals = '{1, 0, step};
    end
{%- if settings.should_reset_dto %}
{%- if settings.dto_reg_high_means_reset %}
    set_write(dto_nd.f_rst, 1);
    set_write(dto_nd.f_rst, 0);
{%- else %}
    set_write(dto_nd.f_rst, 0);
    set_write(dto_nd.f_rst, 1);
{%- endif %}
{%- else %}
{%- if settings.dto_reg_high_means_reset %}
    set_write(dto_nd.f_rst, 0);
{%- else %}
    set_write(dto_nd.f_rst, 1);
{%- endif %}
{%- endif %}
    apply(binds, vals);
endtask

function void {{ settings.class_prefix }}direct_configurator::tci_divisors(
        longint out_hz,
        longint ref_hz,
        output int clkr,
        output int clkf,
        output int clkod,
        output int bwadj);
    clkr = 1;
    clkod = 1;
    clkf = (ref_hz > 0 && out_hz > 0) ? int'(out_hz / ref_hz) : 1;
    if (clkf < 1)
        clkf = 1;
    bwadj = clkf;
endfunction

function bit {{ settings.class_prefix }}direct_configurator::inno_fbdiv_legal(int fbdiv);
    if (fbdiv >= 0 && fbdiv <= 7)
        return 0;
    if (fbdiv == 11)
        return 0;
    return 1;
endfunction

function void {{ settings.class_prefix }}direct_configurator::sc_divisors(
        longint out_hz,
        longint ref_hz,
        output int fbdiv,
        output int refdiv,
        output int postdiv1,
        output int postdiv2);
    int refdiv_try;
    int postdiv1_try;
    int postdiv2_try;
    int fbdiv_i;
    longint product;
    longint actual_hz;
    longint err;
    longint best_err;
    real fbdiv_r;
    bit have_best;
    int best_fbdiv;
    int best_refdiv;
    int best_postdiv1;
    int best_postdiv2;
    bit pref_only;
    fbdiv = 1;
    refdiv = 2;
    postdiv1 = 1;
    postdiv2 = 1;
    if (ref_hz <= 0 || out_hz <= 0)
        return;
    have_best = 0;
    pref_only = 1;
    for (refdiv_try = 1; refdiv_try <= 63; refdiv_try++) begin
        for (postdiv1_try = 1; postdiv1_try <= 7; postdiv1_try++) begin
            for (postdiv2_try = 1; postdiv2_try <= 7; postdiv2_try++) begin
                product = refdiv_try * postdiv1_try * postdiv2_try;
                fbdiv_r = real'(out_hz) * real'(product) / real'(ref_hz);
                fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
                if (fbdiv_i < SC_FBDIV_HW_MIN || fbdiv_i > SC_FBDIV_HW_MAX)
                    continue;
                if (pref_only && (fbdiv_i < SC_FBDIV_PREF_MIN || fbdiv_i > SC_FBDIV_PREF_MAX))
                    continue;
                actual_hz = (ref_hz * fbdiv_i) / product;
                err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
                if (!have_best || err < best_err) begin
                    best_err = err;
                    best_fbdiv = fbdiv_i;
                    best_refdiv = refdiv_try;
                    best_postdiv1 = postdiv1_try;
                    best_postdiv2 = postdiv2_try;
                    have_best = 1;
                end
            end
        end
    end
    if (!have_best && pref_only) begin
        pref_only = 0;
        for (refdiv_try = 1; refdiv_try <= 63; refdiv_try++) begin
            for (postdiv1_try = 1; postdiv1_try <= 7; postdiv1_try++) begin
                for (postdiv2_try = 1; postdiv2_try <= 7; postdiv2_try++) begin
                    product = refdiv_try * postdiv1_try * postdiv2_try;
                    fbdiv_r = real'(out_hz) * real'(product) / real'(ref_hz);
                    fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
                    if (fbdiv_i < SC_FBDIV_HW_MIN || fbdiv_i > SC_FBDIV_HW_MAX)
                        continue;
                    actual_hz = (ref_hz * fbdiv_i) / product;
                    err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
                    if (!have_best || err < best_err) begin
                        best_err = err;
                        best_fbdiv = fbdiv_i;
                        best_refdiv = refdiv_try;
                        best_postdiv1 = postdiv1_try;
                        best_postdiv2 = postdiv2_try;
                        have_best = 1;
                    end
                end
            end
        end
    end
    if (have_best) begin
        fbdiv = best_fbdiv;
        refdiv = best_refdiv;
        postdiv1 = best_postdiv1;
        postdiv2 = best_postdiv2;
    end
endfunction

function void {{ settings.class_prefix }}direct_configurator::dw_divisors(
        longint out_hz,
        longint ref_hz,
        output int fbdiv,
        output int prediv,
        output int divvcop,
        output int p,
        output int divvcor,
        output int r);
    longint best_err;
    bit have_best;
    fbdiv = 1;
    prediv = 0;
    divvcop = 0;
    p = 0;
    divvcor = 0;
    r = 4;
    have_best = 0;
    for (int p_try = 0; p_try <= 7; p_try++) begin
        real fbdiv_r;
        int fbdiv_i;
        longint actual_hz;
        longint err;
        fbdiv_r = real'(out_hz) * real'(p_try + 1) / real'(ref_hz);
        fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
        if (fbdiv_i < DW_FBDIV_MIN || fbdiv_i > DW_FBDIV_MAX)
            continue;
        actual_hz = (ref_hz * fbdiv_i) / (p_try + 1);
        err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
        if (!have_best || err < best_err) begin
            best_err = err;
            fbdiv = fbdiv_i;
            p = p_try;
            have_best = 1;
        end
    end
endfunction

function void {{ settings.class_prefix }}direct_configurator::inno_shared_divisors(
        longint out_hz,
        longint ref_hz,
        int fbdiv_max,
        output int fbdiv,
        output int refdiv);
    longint best_err;
    bit have_best;
    fbdiv = 1;
    refdiv = 1;
    have_best = 0;
    for (int r = 1; r <= 63; r++) begin
        real fbdiv_r;
        int fbdiv_i;
        longint actual_hz;
        longint err;
        fbdiv_r = real'(out_hz) * real'(r) / real'(ref_hz);
        fbdiv_i = int'($rtoi(fbdiv_r + 0.5));
        if (fbdiv_i < 1 || fbdiv_i > fbdiv_max || !inno_fbdiv_legal(fbdiv_i))
            continue;
        actual_hz = (ref_hz * fbdiv_i) / r;
        err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
        if (!have_best || err < best_err) begin
            best_err = err;
            fbdiv = fbdiv_i;
            refdiv = r;
            have_best = 1;
        end
    end
endfunction

function void {{ settings.class_prefix }}direct_configurator::inno_postdivisors(
        longint out_hz,
        longint ref_hz,
        int fbdiv,
        int refdiv,
        output int postdiv1,
        output int postdiv2);
    longint best_err;
    bit have_best;
    postdiv1 = 1;
    postdiv2 = 1;
    have_best = 0;
    for (int p1 = 1; p1 <= 7; p1++)
        for (int p2 = 1; p2 <= 7; p2++) begin
            longint actual_hz;
            longint err;
            actual_hz = (ref_hz * fbdiv) / (refdiv * p1 * p2);
            err = out_hz >= actual_hz ? out_hz - actual_hz : actual_hz - out_hz;
            if (!have_best || err < best_err) begin
                best_err = err;
                postdiv1 = p1;
                postdiv2 = p2;
                have_best = 1;
            end
        end
endfunction

task {{ settings.class_prefix }}direct_configurator::configure_pll(
        {{ settings.class_prefix }}pll_base pll_nd,
        output bit configured);
    longint ref_hz;
    {{ settings.class_prefix }}reg binds[$];
    int vals[$];
    {{ settings.class_prefix }}pll_tci pll_tci_nd;
    {{ settings.class_prefix }}pll_sc pll_sc_nd;
    {{ settings.class_prefix }}pll_dw pll_dw_nd;
    {{ settings.class_prefix }}pll_inno pll_inno_nd;

    configured = 1'b0;
    if (pll_nd == null || !pll_nd._resolved_active)
        return;
    if (pll_nd.source == null || pll_nd.source._resolved_freq <= 0)
        `uvm_fatal("CLK_TREE", $sformatf(
            "direct_config: pll %s has no positive source frequency", pll_nd.get_name()))
    ref_hz = pll_nd.source._resolved_freq;

    if ($cast(pll_tci_nd, pll_nd)) begin
        int clkr;
        int clkf;
        int clkod;
        int bwadj;
        if (!pll_tci_nd.f_bypass.is_bound() || !pll_tci_nd.f_pwrdn.is_bound()
                || !pll_tci_nd.f_reset.is_bound() || !pll_tci_nd.f_clkod.is_bound()
                || !pll_tci_nd.f_clkf.is_bound() || !pll_tci_nd.f_clkr.is_bound()
                || !pll_tci_nd.f_bwadj.is_bound())
            return;
        tci_divisors(pll_tci_nd.frequence, ref_hz, clkr, clkf, clkod, bwadj);
        set_write(pll_tci_nd.f_reset, 1);
        binds = '{pll_tci_nd.f_bypass, pll_tci_nd.f_pwrdn, pll_tci_nd.f_clkod,
            pll_tci_nd.f_clkf, pll_tci_nd.f_clkr, pll_tci_nd.f_bwadj};
        vals = '{1, 0, clkod, clkf, clkr, bwadj};
        apply(binds, vals);
        binds = '{pll_tci_nd.f_reset, pll_tci_nd.f_bypass};
        vals = '{0, 0};
        apply(binds, vals);
        configured = 1'b1;
    end else if ($cast(pll_sc_nd, pll_nd)) begin
        int fbdiv;
        int refdiv;
        int postdiv1;
        int postdiv2;
        if (!pll_sc_nd.f_vocpd.is_bound() || !pll_sc_nd.f_postdivpd.is_bound()
                || !pll_sc_nd.f_dsmpd.is_bound() || !pll_sc_nd.f_pd.is_bound()
                || !pll_sc_nd.f_bypass.is_bound() || !pll_sc_nd.f_refdiv.is_bound()
                || !pll_sc_nd.f_postdiv2.is_bound() || !pll_sc_nd.f_postdiv1.is_bound()
                || !pll_sc_nd.f_fbdiv.is_bound())
            return;
        sc_divisors(pll_sc_nd.frequence, ref_hz, fbdiv, refdiv, postdiv1, postdiv2);
        binds = '{pll_sc_nd.f_vocpd, pll_sc_nd.f_postdivpd, pll_sc_nd.f_dsmpd,
            pll_sc_nd.f_pd, pll_sc_nd.f_bypass};
        vals = '{1, 1, 1, 1, 1};
        apply(binds, vals);
        binds = '{pll_sc_nd.f_vocpd, pll_sc_nd.f_postdivpd, pll_sc_nd.f_dsmpd,
            pll_sc_nd.f_pd, pll_sc_nd.f_bypass, pll_sc_nd.f_refdiv,
            pll_sc_nd.f_postdiv2, pll_sc_nd.f_postdiv1, pll_sc_nd.f_fbdiv};
        vals = '{0, 0, 0, 0, 0, refdiv, postdiv2, postdiv1, fbdiv};
        apply(binds, vals);
        configured = 1'b1;
    end else if ($cast(pll_dw_nd, pll_nd)) begin
        int fbdiv;
        int prediv;
        int divvcop;
        int p;
        int divvcor;
        int r;
        if (!pll_dw_nd.f_fbdiv.is_bound() || !pll_dw_nd.f_prediv.is_bound()
                || !pll_dw_nd.f_reset.is_bound() || !pll_dw_nd.f_pwron.is_bound()
                || !pll_dw_nd.f_shift.is_bound() || !pll_dw_nd.f_bypass.is_bound()
                || !pll_dw_nd.f_divvcor.is_bound() || !pll_dw_nd.f_r.is_bound()
                || !pll_dw_nd.f_p.is_bound() || !pll_dw_nd.f_divvcop.is_bound()
                || !pll_dw_nd.f_enr.is_bound() || !pll_dw_nd.f_enp.is_bound())
            return;
        dw_divisors(pll_dw_nd.frequence, ref_hz, fbdiv, prediv, divvcop, p, divvcor, r);
        binds = '{pll_dw_nd.f_fbdiv, pll_dw_nd.f_prediv};
        vals = '{fbdiv, prediv};
        apply(binds, vals);
        set_write(pll_dw_nd.f_reset, 1);
        binds = '{pll_dw_nd.f_pwron, pll_dw_nd.f_shift, pll_dw_nd.f_bypass};
        vals = '{1, 1, 0};
        apply(binds, vals);
        #4us;
        binds = '{pll_dw_nd.f_reset, pll_dw_nd.f_shift};
        vals = '{0, 0};
        apply(binds, vals);
        #10us;
        binds = '{pll_dw_nd.f_divvcor, pll_dw_nd.f_r, pll_dw_nd.f_p, pll_dw_nd.f_divvcop};
        vals = '{divvcor, r, p, divvcop};
        apply(binds, vals);
        binds = '{pll_dw_nd.f_enr, pll_dw_nd.f_enp};
        vals = '{1, 1};
        apply(binds, vals);
        configured = 1'b1;
    end else if ($cast(pll_inno_nd, pll_nd)) begin
        int fbdiv;
        int refdiv;
        int postdiv1;
        int postdiv2;
        bit write_shared;
        if (!pll_inno_nd.f_pd.is_bound() || !pll_inno_nd.f_lock.is_bound()
                || !pll_inno_nd.f_refdiv.is_bound() || !pll_inno_nd.f_fbdiv.is_bound()
                || !pll_inno_nd.f_postdiv1.is_bound() || !pll_inno_nd.f_postdiv2.is_bound())
            return;
        write_shared = pll_inno_nd.group_id == "{{ inno_pll_primary_group }}";
        if (write_shared)
            inno_shared_divisors(
                pll_inno_nd.frequence, ref_hz, reg_max(pll_inno_nd.f_fbdiv), fbdiv, refdiv);
        else begin
            read(pll_inno_nd.f_fbdiv, fbdiv);
            read(pll_inno_nd.f_refdiv, refdiv);
        end
        inno_postdivisors(pll_inno_nd.frequence, ref_hz, fbdiv, refdiv, postdiv1, postdiv2);
        if (write_shared) begin
            set_write(pll_inno_nd.f_pd, 1);
            binds = '{pll_inno_nd.f_pd, pll_inno_nd.f_refdiv, pll_inno_nd.f_fbdiv};
            vals = '{0, refdiv, fbdiv};
            apply(binds, vals);
        end
        binds = '{pll_inno_nd.f_postdiv1, pll_inno_nd.f_postdiv2};
        vals = '{postdiv1 - 1, postdiv2 - 1};
        apply(binds, vals);
        configured = write_shared;
    end
endtask

task {{ settings.class_prefix }}direct_configurator::wait_pll(
        {{ settings.class_prefix }}pll_base pll_nd);
    {{ settings.class_prefix }}pll_tci pll_tci_nd;
    {{ settings.class_prefix }}pll_sc pll_sc_nd;
    {{ settings.class_prefix }}pll_dw pll_dw_nd;
    {{ settings.class_prefix }}pll_inno pll_inno_nd;
    {{ settings.class_prefix }}reg f_lock;
    time elapsed;
    int lock_val;

    f_lock = null;
    if ($cast(pll_inno_nd, pll_nd)) begin
        if (pll_inno_nd.group_id != "{{ inno_pll_primary_group }}")
            return;
        f_lock = pll_inno_nd.f_lock;
    end else if ($cast(pll_tci_nd, pll_nd))
        f_lock = pll_tci_nd.f_lock;
    else if ($cast(pll_sc_nd, pll_nd))
        f_lock = pll_sc_nd.f_lock;
    else if ($cast(pll_dw_nd, pll_nd))
        f_lock = pll_dw_nd.f_lock;
    if (f_lock == null || !f_lock.is_bound())
        return;

    elapsed = 0;
    while (elapsed < {{ settings.pll_lock_timeout_us }}us) begin
        read(f_lock, lock_val);
        if (lock_val == 1) begin
            pll_nd.locked = 1'b1;
            return;
        end
        #2us;
        elapsed += 2us;
    end
    `uvm_fatal("CLK_TREE", $sformatf(
        "direct_config: pll %s lock timeout", pll_nd.get_name()))
endtask

task {{ settings.class_prefix }}direct_configurator::configure_all(
        {{ settings.class_prefix }}tree tree);
    {{ settings.class_prefix }}pll_base pll_nd;
    {{ settings.class_prefix }}div_div div_div_nd;
    {{ settings.class_prefix }}div_dto div_dto_nd;
    {{ settings.class_prefix }}inv_base inv_nd;
    {{ settings.class_prefix }}gate gate_nd;
    {{ settings.class_prefix }}mux mux_nd;
    {{ settings.class_prefix }}pll_base plls[$];
    bit pll_configured;

    if (tree == null)
        `uvm_fatal("CLK_TREE", "direct_config: tree is null")
    tree.require_built("direct_config");

    report_invalid_control_nodes(tree);
    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(pll_nd, tree.nodes[i])) begin
            configure_pll(pll_nd, pll_configured);
            if (pll_configured)
                plls.push_back(pll_nd);
        end
    foreach (plls[i])
        wait_pll(plls[i]);

    for (int i = 0; i < tree.nodes.size(); i++) begin
        if (!control_node_is_valid(tree, tree.nodes[i]))
            continue;
        if ($cast(div_div_nd, tree.nodes[i]))
            configure_div(div_div_nd);
        else if ($cast(div_dto_nd, tree.nodes[i]))
            configure_dto(div_dto_nd);
        else if ($cast(inv_nd, tree.nodes[i]))
            configure_inv(inv_nd);
    end

    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(gate_nd, tree.nodes[i]) && gate_nd._resolved_open
                && control_node_is_valid(tree, gate_nd))
            configure_gate(gate_nd, 1'b1);
    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(mux_nd, tree.nodes[i]) && control_node_is_valid(tree, mux_nd))
            configure_mux(mux_nd);
    for (int i = 0; i < tree.nodes.size(); i++)
        if ($cast(gate_nd, tree.nodes[i]) && !gate_nd._resolved_open
                && control_node_is_valid(tree, gate_nd))
            configure_gate(gate_nd, 1'b0);
endtask

task automatic {{ settings.class_prefix }}direct_config(
        {{ settings.class_prefix }}tree tree,
        {{ settings.class_regmodel }} regmodel = null,
        bit quiet = 1'b0);
    {{ settings.class_prefix }}direct_configurator cfg;
    if (tree == null)
        `uvm_fatal("CLK_TREE", "direct_config: tree is null")
    if (regmodel != null)
        tree.build(regmodel);
    else begin
        tree.built = 1'b0;
        if (!tree.randomize())
            `uvm_fatal("CLK_TREE", "direct_config: tree randomize failed")
        tree.built = 1'b1;
    end
    {{ settings.class_prefix }}config_reg(tree, quiet);
endtask

`endif
{% endif %}
