`ifndef {{ (settings.class_prefix ~ "dto") | upper }}
`define {{ (settings.class_prefix ~ "dto") | upper }}

class {{ settings.class_prefix }}dto extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}dto)
        `uvm_field_int(ratio, UVM_ALL_ON)
    `uvm_object_utils_end

    rand int ratio;
{%- if enable_node_fix %}
    int fix_ratio;
{%- endif %}
{% if regs_enabled %}
    {{ settings.class_prefix }}reg f_rst;
    {{ settings.class_prefix }}reg f_load;
    {{ settings.class_prefix }}reg f_bypass;
    {{ settings.class_prefix }}reg f_step;
{% endif %}

    constraint cst_dto {
        ratio > 0;
        ratio <= (1 << 25);
{%- if enable_node_fix %}
        fix_ratio > 0 -> ratio == fix_ratio;
{%- endif %}
    }

    constraint cst_resolve_freq_from_src {
        source != null -> _resolved_freq == source._resolved_freq / ratio;
    }

    function new(string name = "");
        super.new(name);
{%- if enable_node_fix %}
        fix_ratio = 0;
{%- endif %}
{% if regs_enabled %}
        f_rst = new();
        f_load = new();
        f_bypass = new();
        f_step = new();
{% endif %}
        kind = "dto";
    endfunction
endclass

`endif
