`ifndef {{ (settings.class_prefix ~ "gate") | upper }}
`define {{ (settings.class_prefix ~ "gate") | upper }}

class {{ settings.class_prefix }}gate extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}gate)
        `uvm_field_int(open, UVM_ALL_ON)
    `uvm_object_utils_end

    rand bit open;
{% if regs_enabled %}
    {{ settings.class_prefix }}reg_bind f_reg;
{% endif %}

    constraint cst_clk_from_src {
        source != null -> valid == (source.valid && open);
    }

    function new(string name = "");
        super.new(name);
{% if regs_enabled %}
        f_reg = new();
{% endif %}
        kind = "gate";
    endfunction
endclass

`endif
