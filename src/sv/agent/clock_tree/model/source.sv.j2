`ifndef {{ (settings.class_prefix ~ "source") | upper }}
`define {{ (settings.class_prefix ~ "source") | upper }}

class {{ settings.class_prefix }}source extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}source)
        `uvm_field_int(classic_frequence, UVM_ALL_ON)
    `uvm_object_utils_end

    longint classic_frequence;

    constraint cst_source {
        frequence == classic_frequence;
        frequence > 0 -> valid == 1;
    }

