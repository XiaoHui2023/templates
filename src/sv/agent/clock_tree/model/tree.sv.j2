`ifndef {{ (settings.class_prefix ~ "tree") | upper }}
`define {{ (settings.class_prefix ~ "tree") | upper }}

class {{ settings.class_prefix }}tree extends {{ settings.class_prefix }}tree_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}tree)
{%- for node in tree.nodes_ordered %}
{%- if node.kind in ["clk", "pll", "source"] %}
{%- set field_flags = "UVM_ALL_ON" %}
{%- elif node.kind == "mux" %}
{%- set field_flags = "UVM_ALL_ON | (_print_mux ? 0 : UVM_NOPRINT)" %}
{%- elif node.kind == "div" %}
{%- if node.div_kind in ["div", "div_r"] %}
{%- set field_flags = "UVM_ALL_ON | (_print_div ? 0 : UVM_NOPRINT)" %}
{%- else %}
{%- set field_flags = "UVM_ALL_ON | (_print_dto ? 0 : UVM_NOPRINT)" %}
{%- endif %}
{%- elif node.kind == "gate" %}
{%- set field_flags = "UVM_ALL_ON | (_print_gate ? 0 : UVM_NOPRINT)" %}
{%- elif node.kind == "cell" %}
{%- set field_flags = "UVM_ALL_ON | (_print_cell ? 0 : UVM_NOPRINT)" %}
{%- else %}
{%- set field_flags = "UVM_ALL_ON | UVM_NOPRINT" %}
{%- endif %}
{%- if node.output_groups %}
        `uvm_field_aa_object_string({{ node.name }}, {{ field_flags }})
{%- else %}
        `uvm_field_object({{ node.name }}, {{ field_flags }})
{%- endif %}
{%- endfor %}
    `uvm_object_utils_end

{%- for node in tree.nodes_ordered %}
{%- if node.kind == "pll" %}
{%- if node.output_groups %}
    rand {{ settings.class_prefix }}{{ node.sv_pll_class }} {{ node.name }}[string];
{%- else %}
    rand {{ settings.class_prefix }}{{ node.sv_pll_class }} {{ node.name }};
{%- endif %}
{%- elif node.kind == "div" %}
{%- if node.output_groups %}
    rand {{ settings.class_prefix }}{{ node.sv_div_class }} {{ node.name }}[string];
{%- else %}
    rand {{ settings.class_prefix }}{{ node.sv_div_class }} {{ node.name }};
{%- endif %}
{%- elif node.kind == "inv" %}
    rand {{ settings.class_prefix }}{{ node.sv_inv_class }} {{ node.name }};
{%- elif node.kind == "source" %}
    rand {{ settings.class_prefix }}{{ node.sv_source_class }} {{ node.name }};
{%- else %}
    rand {{ settings.class_prefix }}{{ node.kind }} {{ node.name }};
{%- endif %}
{%- endfor %}

    // Create node objects, connect sources, and populate tree queues.
    function new(string name="{{ settings.class_prefix }}tree");
        super.new(name);
{%- for node in tree.nodes_ordered %}
{%- if node.output_groups %}
{%- if node.kind == "pll" %}
{%- set sv_leaf_class = settings.class_prefix ~ node.sv_pll_class %}
{%- elif node.kind == "div" %}
{%- set sv_leaf_class = settings.class_prefix ~ node.sv_div_class %}
{%- else %}
{%- set sv_leaf_class = settings.class_prefix ~ node.kind %}
{%- endif %}
{%- for g in node.output_groups %}
        {{ node.name }}["{{ g }}"] = {{ sv_leaf_class }}::type_id::create($sformatf("{{ node.name }}[%s]", "{{ g }}"));
{%- if node.kind == "pll" and node.pll_kind == "inno" %}
        {{ node.name }}["{{ g }}"].group_id = "{{ g }}";
{%- endif %}
{%- if node.kind == "div" %}
        {{ node.name }}["{{ g }}"].div_kind = {{ div_kind_to_sv_enum[node.div_kind] }};
{%- if node.div_tree_emit_unfix_ratio %}
        {{ node.name }}["{{ g }}"].ratio = {{ node.div_init_ratio }};
{%- if enable_node_fix %}
        {{ node.name }}["{{ g }}"].unfix_ratio = 1'b0;
{%- endif %}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if node.kind == "pll" and node.pll_kind == "inno" %}
{%- for g in node.output_groups %}
{%- for g2 in node.output_groups %}
{%- if g != g2 %}
        {{ node.name }}["{{ g }}"].to_group["{{ g2 }}"] = {{ node.name }}["{{ g2 }}"];
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endif %}
{%- elif node.kind == "pll" %}
        {{ node.name }} = {{ settings.class_prefix }}{{ node.sv_pll_class }}::type_id::create("{{ node.name }}");
{%- elif node.kind == "div" %}
        {{ node.name }} = {{ settings.class_prefix }}{{ node.sv_div_class }}::type_id::create("{{ node.name }}");
        {{ node.name }}.div_kind = {{ div_kind_to_sv_enum[node.div_kind] }};
{%- if node.div_tree_emit_unfix_ratio %}
        {{ node.name }}.ratio = {{ node.div_init_ratio }};
{%- if enable_node_fix %}
        {{ node.name }}.unfix_ratio = 1'b0;
{%- endif %}
{%- endif %}
{%- elif node.kind == "inv" %}
        {{ node.name }} = {{ settings.class_prefix }}{{ node.sv_inv_class }}::type_id::create("{{ node.name }}");
{%- elif node.kind == "source" %}
        {{ node.name }} = {{ settings.class_prefix }}{{ node.sv_source_class }}::type_id::create("{{ node.name }}");
        {{ node.name }}.source_kind = {{ source_kind_to_sv_enum[node.source_kind] }};
{%- elif node.kind == "cell" %}
        {{ node.name }} = {{ settings.class_prefix }}cell::type_id::create("{{ node.name }}");
        {{ node.name }}.cell_kind = "{{ node.cell_kind }}";
{%- else %}
        {{ node.name }} = {{ settings.class_prefix }}{{ node.kind }}::type_id::create("{{ node.name }}");
{%- endif %}
{%- endfor %}
{%- for node in tree.nodes_ordered %}
{%- for src in node.sources %}
{%- if not settings.probe_mode and src.name in tree.nodes and tree.nodes[src.name].present %}
{%- set peer = tree.nodes[src.name] %}
{%- if peer.output_groups %}
{%- set peer_access = src.name ~ '["' ~ src.out_group ~ '"]' %}
{%- else %}
{%- set peer_access = src.name %}
{%- endif %}
{%- if node.output_groups %}
{%- for g in node.output_groups %}
        {{ node.name }}["{{ g }}"].source = {{ peer_access }};
{%- endfor %}
{%- elif node.kind == "mux" %}
        {{ node.name }}.to_source[{{ src.key }}] = {{ peer_access }};
{%- else %}
        {{ node.name }}.source = {{ peer_access }};
{%- endif %}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- for node in tree.nodes_ordered %}
{%- if node.kind == "clk" %}
{%- if node.output_groups %}
{%- for g in node.output_groups %}
{%- set clk_acc = node.name ~ '["' ~ g ~ '"]' %}
{%- if not node.check_duty %}
        {{ clk_acc }}.check_duty = 1'b0;
{%- endif %}
{%- if (settings.probe_mode and node.active is not false and node.freq is not none and node.freq > 0) or (not settings.probe_mode and node.clk_tree_emit_frequence) %}
        {{ clk_acc }}.frequence = {{ node.clk_init_frequence }};
{%- endif %}
{%- if settings.probe_mode %}
        {{ clk_acc }}.enabled = {{ node.clk_init_enabled }};
{%- else %}
{%- if node.clk_tree_emit_enabled %}
        {{ clk_acc }}.enabled = {{ node.clk_init_enabled }};
{%- endif %}
{%- if node.stable %}
        {{ clk_acc }}.stable = 1;
{%- endif %}
{%- endif %}
{%- endfor %}
{%- else %}
{%- if not node.check_duty %}
        {{ node.name }}.check_duty = 1'b0;
{%- endif %}
{%- if (settings.probe_mode and node.active is not false and node.freq is not none and node.freq > 0) or (not settings.probe_mode and node.clk_tree_emit_frequence) %}
        {{ node.name }}.frequence = {{ node.clk_init_frequence }};
{%- endif %}
{%- if settings.probe_mode %}
        {{ node.name }}.enabled = {{ node.clk_init_enabled }};
{%- else %}
{%- if node.clk_tree_emit_enabled %}
        {{ node.name }}.enabled = {{ node.clk_init_enabled }};
{%- endif %}
{%- if node.stable %}
        {{ node.name }}.stable = 1;
{%- endif %}
{%- endif %}
{%- endif %}
{%- elif node.kind == "cell" %}
{%- if node.cell_tree_emit_frequence %}
        {{ node.name }}.frequence = {{ node.cell_init_frequence }};
{%- endif %}
{%- if node.cell_tree_emit_enabled %}
        {{ node.name }}.enabled = {{ node.cell_init_enabled }};
{%- endif %}
{%- elif node.kind == "pll" %}
{%- if node.output_groups %}
{%- for g in node.output_groups %}
        {{ node.name }}["{{ g }}"].frequence = {{ node.freq[g] if node.freq is mapping else node.freq }};
{%- endfor %}
{%- else %}
        {{ node.name }}.frequence = {{ node.freq }};
{%- endif %}
{%- elif node.kind == "source" %}
{%- if node.output_groups %}
{%- for g in node.output_groups %}
        {{ node.name }}["{{ g }}"].frequence = {{ node.freq }};
{%- endfor %}
{%- else %}
        {{ node.name }}.frequence = {{ node.freq }};
{%- endif %}
{%- endif %}
{%- if node.kind == "mux" %}
        {{ node.name }}.max_sel = {{ node.mux_max_sel }};
{%- if node.mux_tree_emit_unfix_sel %}
        {{ node.name }}.sel = {{ node.mux_init_sel }};
{%- if enable_node_fix %}
        {{ node.name }}.unfix_sel = 1'b0;
{%- endif %}
{%- endif %}
{%- elif node.kind == "gate" %}
{%- if node.gate_tree_emit_unfix_open %}
        {{ node.name }}.open = {{ node.gate_init_open }};
{%- if enable_node_fix %}
        {{ node.name }}.unfix_open = 1'b0;
{%- endif %}
{%- endif %}
{%- endif %}
{%- endfor %}
        nodes.delete();
{%- for slot in tree.sv_slots %}
        nodes.push_back({{ slot.access }});
{%- endfor %}
        clock_nodes.delete();
        foreach (nodes[i]) begin
            {{ settings.class_prefix }}clk clk_nd;
            if ($cast(clk_nd, nodes[i]))
                clock_nodes.push_back(clk_nd);
        end
    endfunction
{% if regs_enabled %}
    // Bind register fields, then randomize tree nodes.
{% else %}
    // Randomize tree nodes.
{% endif %}
    extern function void build({% if regs_enabled %}{{ settings.class_regmodel }} regmodel = null{% endif %});
endclass

function void {{ settings.class_prefix }}tree::build({% if regs_enabled %}{{ settings.class_regmodel }} regmodel{% endif %});
    built = 1'b0;
{%- if regs_enabled %}
    if (regmodel != null) begin
{%- for sv_access, member, path, offset, width in reg_bindings %}
        {{ sv_access }}.{{ member }}.field = regmodel.{{ path }};
        {{ sv_access }}.{{ member }}.offset = {{ offset if offset is not none else 0 }};
{%- if width is none %}
        {{ sv_access }}.{{ member }}.width = {{ sv_access }}.{{ member }}.field.get_n_bits();
{%- else %}
        {{ sv_access }}.{{ member }}.width = {{ width }};
{%- endif %}
{%- endfor %}
    end
{%- for node in tree.nodes_ordered %}
{%- if node.kind == "div" and node.div_kind == "div" and node.regs.get("div") %}
{%- if node.output_groups %}
{%- for g in node.output_groups %}
    if ({{ node.name }}["{{ g }}"].f_div.is_bound())
        {{ node.name }}["{{ g }}"].max_ratio = {{ settings.class_prefix }}div_max_ratio_for_width({{ node.name }}["{{ g }}"].f_div.width);
{%- endfor %}
{%- else %}
    if ({{ node.name }}.f_div.is_bound())
        {{ node.name }}.max_ratio = {{ settings.class_prefix }}div_max_ratio_for_width({{ node.name }}.f_div.width);
{%- endif %}
{%- endif %}
{%- endfor %}
    if (!randomize())
        `uvm_fatal("CLK_TREE", "build: tree randomize failed")
{%- else %}
    if (!randomize())
        `uvm_fatal("CLK_TREE", "build: tree randomize failed")
{%- endif %}
    built = 1'b1;
endfunction
`endif
