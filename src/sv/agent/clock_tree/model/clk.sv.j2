`ifndef {{ (settings.class_prefix ~ "clk") | upper }}
`define {{ (settings.class_prefix ~ "clk") | upper }}

class {{ settings.class_prefix }}clk extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}clk)
        `uvm_field_int(frequence, UVM_ALL_ON)
        `uvm_field_int(enabled, UVM_ALL_ON)
    `uvm_object_utils_end

    longint frequence;
    rand bit enabled;
{%- if enable_node_fix %}
    bit unfix;
{%- endif %}

    constraint cst_clk {
{%- if enable_node_fix %}
        !unfix -> frequence == _resolved_freq;
        !unfix -> enabled == _resolved_active;
{%- else %}
        frequence == _resolved_freq;
        enabled == _resolved_active;
{%- endif %}
    }

    function new(string name = "");
        super.new(name);
        frequence = 0;
{%- if enable_node_fix %}
        unfix = 0;
{%- endif %}
        kind = "clk";
    endfunction
endclass

`endif
