`ifndef {{ (settings.class_prefix ~ "clk") | upper }}
`define {{ (settings.class_prefix ~ "clk") | upper }}

{% set _sv_int_max = 2147483647 -%}
{% set _min_freq_hz_lit = ("64'd" ~ settings.min_freq_hz) if settings.min_freq_hz > _sv_int_max else settings.min_freq_hz -%}
{% set _max_freq_hz_lit = ("64'd" ~ settings.max_freq_hz) if settings.max_freq_hz > _sv_int_max else settings.max_freq_hz -%}

class {{ settings.class_prefix }}clk extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}clk)
        `uvm_field_int(frequence, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(enabled, UVM_ALL_ON | (enabled >= 0 ? 0 : UVM_NOPRINT))
        `uvm_field_int(check_duty, UVM_ALL_ON | (check_duty ? UVM_NOPRINT : 0))
        `uvm_field_int(unfix_frequence, UVM_DEFAULT|(_print_fix?0:UVM_NOPRINT))
        `uvm_field_int(unfix_enabled, UVM_DEFAULT|(_print_fix?0:UVM_NOPRINT))
    `uvm_object_utils_end

    longint frequence;
    int enabled;
    bit stable;
    bit check_duty;
    bit unfix_frequence;
    bit unfix_enabled;

    constraint cst_clk {
        !(unfix_enabled || enabled < 0) -> (enabled != 0) == _resolved_active;
        (_resolved_freq > 0) == _resolved_active;
        !(unfix_frequence || frequence < 0 || enabled <= 0) -> frequence == _resolved_freq;
        stable -> enabled > 0;
        stable -> _resolved_active;
        !_resolved_active || _resolved_freq >= {{ _min_freq_hz_lit }};
        !_resolved_active || _resolved_freq <= {{ _max_freq_hz_lit }};
    }

    function new(string name = "");
        super.new(name);
        frequence = -1;
        enabled = -1;
        stable = 1'b0;
        check_duty = 1'b1;
        unfix_frequence = 1'b0;
        unfix_enabled = 1'b0;
        kind = "clk";
    endfunction
endclass

`endif
