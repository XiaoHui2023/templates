`ifndef {{ (settings.class_prefix ~ "clk") | upper }}
`define {{ (settings.class_prefix ~ "clk") | upper }}

class {{ settings.class_prefix }}clk extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}clk)
        `uvm_field_int(frequence, UVM_ALL_ON | UVM_DEC)
        `uvm_field_int(enabled, UVM_ALL_ON)
{%- if enable_node_fix %}
        `uvm_field_int(unfix_frequence, UVM_DEFAULT|(_print_fix?0:UVM_NOPRINT))
        `uvm_field_int(unfix_enabled, UVM_DEFAULT|(_print_fix?0:UVM_NOPRINT))
{%- endif %}
    `uvm_object_utils_end

    longint frequence;
    int enabled;
    bit _always_active;
{%- if enable_node_fix %}
    bit unfix_frequence;
    bit unfix_enabled;
{%- endif %}

    constraint cst_clk {
{%- if enable_node_fix %}
        !(unfix_frequence || frequence < 0) -> frequence == _resolved_freq;
        !(unfix_enabled || enabled < 0) -> enabled == _resolved_active;
{%- else %}
        frequence >= 0 -> frequence == _resolved_freq;
        enabled >= 0 -> enabled == _resolved_active;
{%- endif %}
        _always_active -> enabled == 1;
    }

    function new(string name = "");
        super.new(name);
        frequence = -1;
        enabled = -1;
        _always_active = 1'b0;
{%- if enable_node_fix %}
        unfix_frequence = 1'b1;
        unfix_enabled = 1'b1;
{%- endif %}
        kind = "clk";
    endfunction
endclass

`endif
