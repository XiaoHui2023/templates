`ifndef {{ (class_prefix ~ "node_base") | upper }}
`define {{ (class_prefix ~ "node_base") | upper }}

class {{ class_prefix }}node_base extends {{ class_prefix }}base_item;
    `uvm_object_utils_begin({{ class_prefix }}node_base)
        `uvm_field_string(kind, UVM_ALL_ON)
        `uvm_field_int(allow_bad_duty, UVM_ALL_ON)
        `uvm_field_int(frequence, UVM_ALL_ON)
        `uvm_field_int(valid, UVM_ALL_ON)
    `uvm_object_utils_end

    string kind;
    rand bit allow_bad_duty;
    rand longint frequence;
    rand bit valid;
