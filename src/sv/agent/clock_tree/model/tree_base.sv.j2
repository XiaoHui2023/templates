`ifndef {{ (settings.class_prefix ~ "tree_base") | upper }}
`define {{ (settings.class_prefix ~ "tree_base") | upper }}

class {{ settings.class_prefix }}tree_base extends {{ settings.class_prefix }}base_item;
    `uvm_object_utils_begin({{ settings.class_prefix }}tree_base)
        `uvm_field_queue_object(nodes, UVM_ALL_ON | UVM_NOPRINT)
        `uvm_field_queue_object(clock_nodes, UVM_ALL_ON | UVM_NOPRINT)
        `uvm_field_int(built, UVM_DEFAULT | UVM_NOPRINT)
    `uvm_object_utils_end

    {{ settings.class_prefix }}node_base nodes[$];
    {{ settings.class_prefix }}clk clock_nodes[$];
    bit built;
    bit _print_mux;
    bit _print_div;
    bit _print_dto;
    bit _print_gate;
    bit _print_cell;

    function new(string name = "{{ settings.class_prefix }}tree_base");
        super.new(name);
        built = 1'b0;
        _print_mux = 0;
        _print_div = 0;
        _print_dto = 0;
        _print_gate = 0;
        _print_cell = 0;
    endfunction

    // 确认 tree.build 已执行
    extern function void require_built(string ctx);
    // 将全部非 stable 且显式打开的 clock_nodes 放回不主动控制
    extern function void low_power();
    // 收集 stable 为真的 clk 节点
    extern function void collect_stable_clk_nodes(
        output {{ settings.class_prefix }}node_base collected[$]);
    // 是否存在 stable 为真的 clk 节点
    extern function bit has_stable_clk();
endclass

function void {{ settings.class_prefix }}tree_base::require_built(string ctx);
    if (!built)
        `uvm_fatal("CLK_TREE", $sformatf(
            "%s: tree is not built; call tree.build(regmodel) before use", ctx))
endfunction

function void {{ settings.class_prefix }}tree_base::low_power();
    {{ settings.class_prefix }}gate gate_nd;
    foreach (clock_nodes[i]) begin
        if (!clock_nodes[i].stable && clock_nodes[i].enabled > 0)
            clock_nodes[i].enabled = -1;
    end
    foreach (nodes[i]) begin
        if ($cast(gate_nd, nodes[i])) begin
            gate_nd.open = 0;
            gate_nd.unfix_open = 1'b0;
        end
    end
endfunction

function void {{ settings.class_prefix }}tree_base::collect_stable_clk_nodes(
        output {{ settings.class_prefix }}node_base collected[$]);
    collected.delete();
    foreach (clock_nodes[i]) begin
        if (clock_nodes[i].stable)
            collected.push_back(clock_nodes[i]);
    end
endfunction

function bit {{ settings.class_prefix }}tree_base::has_stable_clk();
    foreach (clock_nodes[i]) begin
        if (clock_nodes[i].stable)
            return 1'b1;
    end
    return 1'b0;
endfunction

`endif
