`ifndef {{ (settings.class_prefix ~ "div_cpu_gate") | upper }}
`define {{ (settings.class_prefix ~ "div_cpu_gate") | upper }}
{%- set div_freq_tol_den = 100 %}
{%- set div_freq_tol_num = (settings.period_tolerance * div_freq_tol_den) | round | int %}
{%- set div_freq_tol_lo = div_freq_tol_den - div_freq_tol_num %}
{%- set div_freq_tol_hi = div_freq_tol_den + div_freq_tol_num %}

class {{ settings.class_prefix }}div_cpu_gate extends {{ settings.class_prefix }}div_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}div_cpu_gate)
        `uvm_field_string(group_id, UVM_DEFAULT|(_print_group_id?0:UVM_NOPRINT))
    `uvm_object_utils_end
{% if regs_enabled %}
    {{ settings.class_prefix }}reg f_rst;
    {{ settings.class_prefix }}reg f_div;
{% endif %}

    string group_id;
    bit _print_group_id;
    {{ settings.class_prefix }}div_cpu_gate to_group[string];

    constraint cst_div {
        _resolved_ratio inside {2, 3, 4, 6};
        group_id == "{{ cpu_gate_primary_group }}" ->
            _resolved_ratio == to_group["{{ cpu_gate_hclk_group }}"]._resolved_ratio;
        group_id == "{{ cpu_gate_hclk_group }}" ->
            _resolved_ratio == to_group["{{ cpu_gate_primary_group }}"]._resolved_ratio;
    }

    constraint cst_resolve_freq_from_src {
        source != null -> {
            group_id == "{{ cpu_gate_pass_through_group }}" -> _resolved_freq == source._resolved_freq;
            group_id != "{{ cpu_gate_pass_through_group }}" && _resolved_ratio > 0 -> {
                _resolved_freq * {{ div_freq_tol_lo }} <= (source._resolved_freq / _resolved_ratio) * {{ div_freq_tol_den }};
                _resolved_freq * {{ div_freq_tol_hi }} >= (source._resolved_freq / _resolved_ratio) * {{ div_freq_tol_den }};
            }
        }
        source == null -> _resolved_freq == 0;
    }

    function new(string name = "");
        super.new(name);
{% if regs_enabled %}
        f_rst = new();
        f_div = new();
{% endif %}
        div_kind = CPU_GATE;
        group_id = "";
        _print_group_id = 1;
    endfunction
endclass

`endif
