`ifndef {{ (settings.class_prefix ~ "div") | upper }}
`define {{ (settings.class_prefix ~ "div") | upper }}

class {{ settings.class_prefix }}div extends {{ settings.class_prefix }}node_base;
    `uvm_object_utils_begin({{ settings.class_prefix }}div)
        `uvm_field_int(ratio, UVM_ALL_ON)
    `uvm_object_utils_end

    rand int ratio;
{% if regs_enabled %}
    {{ settings.class_prefix }}reg_bind f_rst;
    {{ settings.class_prefix }}reg_bind f_load;
    {{ settings.class_prefix }}reg_bind f_div;
{% endif %}

    constraint cst_div {
        ratio > 0;
        ratio <= 64;
    }

    constraint cst_freq_from_src {
        source != null -> frequence == source.frequence / ratio;
    }

    function new(string name = "");
        super.new(name);
{% if regs_enabled %}
        f_rst = new();
        f_load = new();
        f_div = new();
{% endif %}
        kind = "div";
    endfunction
endclass

`endif
