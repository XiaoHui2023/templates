`ifndef {{ (class_prefix ~ "mux") | upper }}
`define {{ (class_prefix ~ "mux") | upper }}

class {{ class_prefix }}mux extends {{ class_prefix }}node_base;
    `uvm_object_utils_begin({{ class_prefix }}mux)
        `uvm_field_int(sel, UVM_ALL_ON)
    `uvm_object_utils_end

    rand int sel;
    {{ class_prefix }}node_base to_source[int];
    uvm_reg_field f_reg;

    constraint cst_clk_from_src {
        to_source[sel] == null -> valid == 0;
        to_source[sel] != null -> valid == to_source[sel].valid;
    }

    constraint cst_freq_from_src {
        to_source[sel] != null -> frequence == to_source[sel].frequence;
    }

    function new(string name = "");
        super.new(name);
        kind = "mux";
    endfunction

    function void post_randomize();
        super.post_randomize();
        if (to_source[sel] != null)
            source = to_source[sel];
    endfunction
endclass

`endif
