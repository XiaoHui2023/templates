`ifndef {{ class_prefix | upper }}MONITOR_INTERFACE
`define {{ class_prefix | upper }}MONITOR_INTERFACE

interface {{ class_prefix }}monitor_interface(
    {%- for clk in monitored_clocks %}
    input wire {{ clk.name }}{{ ',' if not loop.last or is_emmc }}
    {%- endfor %}
    {%- if is_emmc %}
    input wire link_chip_clk,
    input wire link_card_clk
    {%- endif %}
);

timeunit 1fs;
timeprecision 1fs;

{%- for clk in monitored_clocks %}
{{ class_prefix }}sample_interface sample_{{ clk.name }}_if({{ clk.name }});
{%- endfor %}

{%- for clk in monitored_clocks %}
// Measure {{ clk.name }} clock. X/Z means unconnected and is skipped by the caller.
task automatic measure_{{ clk.name }}_frequence(output bit is_connected, output bit is_timeout,
        output longint measure_result, input longint min_freq = 1);
    if($isunknown({{ clk.name }})) begin
        is_connected = 0;
        is_timeout = 0;
        measure_result = 0;
        `uvm_info("", "{{ clk.name }} clock is not connected, skip clock check", UVM_DEBUG)
        return;
    end

    is_connected = 1;
    sample_{{ clk.name }}_if.enable(1);
    measure_clock_frequence(sample_{{ clk.name }}_if.r, min_freq, is_timeout, measure_result);
    sample_{{ clk.name }}_if.enable(0);
endtask
{%- endfor %}

task automatic measure_clock_frequence(ref reg clk, input longint min_freq, output bit is_timeout,
        output longint measure_result);
    longint timeout;

    if(min_freq <= 0)
        `uvm_fatal("", $psprintf("Invalid min_freq=%0d", min_freq))

    is_timeout = 0;
    measure_result = 0;
    timeout = (1e15 / min_freq + 1) * 100;

    fork begin
        fork
            begin
                #(timeout);
                is_timeout = 1;
            end
            begin
                longint start_time;
                longint end_time;
                longint period;

                @(clk);
                start_time = $realtime;
                @(clk);
                end_time = $realtime;
                period = (end_time - start_time) * 2;
                if(period <= 0)
                    `uvm_fatal("", "Invalid clock period")
                measure_result = 1e15 / period;
            end
        join_any
        disable fork;
    end join
endtask
{%- if is_emmc %}

// Observe a directed copy of the same clock; do not wrap the time of flight.
task automatic collect_link_clock(
    input longint max_delay_fs,
    output longint period_fs,
    output longint propagation_fs,
    output string problem
);
    localparam int samples = 6;
    logic [1:0] previous, current;
    longint source_fs, orphan_fs, rise_fs, now_fs;
    longint delay_fs, delay_sum, delay_min, delay_max;
    longint period_sample, period_sum, period_min, period_max;
    int matched, periods;
    bit pending, source_edge, sink_edge;

    period_fs = 0;
    propagation_fs = 0;
    problem = "";
    previous = {link_chip_clk, link_card_clk};
    if ($isunknown(previous)) begin
        problem = "CLK observation is X or unconnected";
        return;
    end

    source_fs = -1;
    orphan_fs = -1;
    rise_fs = -1;
    delay_sum = 0;
    delay_min = 0;
    delay_max = 0;
    period_sum = 0;
    period_min = 0;
    period_max = 0;
    matched = 0;
    periods = 0;
    pending = 0;
    while (matched < samples) begin
        @(link_chip_clk or link_card_clk);
        current = {link_chip_clk, link_card_clk};
        if ($isunknown(current)) begin
            problem = "CLK observation became X or Z";
            return;
        end
        source_edge = current[1] != previous[1];
        sink_edge = current[0] != previous[0];
        previous = current;
        now_fs = longint'($time);

        if (source_edge) begin
            if (pending || (source_fs >= 0 && now_fs - source_fs <= max_delay_fs) ||
                (matched != 0 && orphan_fs >= 0 && orphan_fs != now_fs)) begin
                problem = "CLK transitions are missing or ambiguous within the one-way bound";
                return;
            end
            if (current[1]) begin
                if (rise_fs >= 0) begin
                    period_sample = now_fs - rise_fs;
                    if (periods == 0 || period_sample < period_min)
                        period_min = period_sample;
                    if (period_sample > period_max)
                        period_max = period_sample;
                    period_sum += period_sample;
                    periods++;
                end
                rise_fs = now_fs;
            end
            source_fs = now_fs;
            pending = 1;
            if (orphan_fs == now_fs)
                sink_edge = 1;
            orphan_fs = -1;
        end

        if (sink_edge) begin
            if (!pending) begin
                // The first observed sink transition can already be in flight.
                orphan_fs = now_fs;
                continue;
            end
            delay_fs = now_fs - source_fs;
            if (current[1] != current[0] || delay_fs > max_delay_fs) begin
                problem = "CLK propagation is reversed, unmatched or exceeds the one-way bound";
                return;
            end
            pending = 0;
            if (matched == 0 || delay_fs < delay_min)
                delay_min = delay_fs;
            if (delay_fs > delay_max)
                delay_max = delay_fs;
            delay_sum += delay_fs;
            matched++;
        end
    end

    if (periods < 2 || period_min <= 2 * max_delay_fs ||
        period_max - period_min > period_min / 100 || delay_max - delay_min > period_min / 100) begin
        problem = "CLK period or one-way propagation is unstable";
        return;
    end
    period_fs = period_sum / longint'(periods);
    propagation_fs = delay_sum / longint'(samples);
endtask

// Bound observation only; this task never drives the bus or modifies transfer timeouts.
task automatic measure_link_clock(
    input longint max_delay_ps,
    output longint period_fs,
    output longint propagation_fs,
    output string problem
);
    longint measured_period_fs, measured_propagation_fs;
    string measurement_problem;
    bit finished;

    period_fs = 0;
    propagation_fs = 0;
    finished = 0;
    if (max_delay_ps <= 0 || max_delay_ps > 1_000_000_000) begin
        problem = "set max_link_delay_ps to the physical one-way limit";
        return;
    end
    fork begin
        fork
            #10us;
            begin
                collect_link_clock(max_delay_ps * 1000, measured_period_fs,
                    measured_propagation_fs, measurement_problem);
                finished = 1;
            end
        join_any
        disable fork;
    end join
    if (!finished) begin
        problem = "CLK did not provide enough edges";
        return;
    end
    period_fs = measured_period_fs;
    propagation_fs = measured_propagation_fs;
    problem = measurement_problem;
endtask
{%- endif %}
endinterface

`endif
