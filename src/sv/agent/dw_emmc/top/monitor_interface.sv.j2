`ifndef {{ class_prefix | upper }}MONITOR_INTERFACE
`define {{ class_prefix | upper }}MONITOR_INTERFACE

interface {{ class_prefix }}monitor_interface(
    {%- for clk in monitored_clocks %}
    input wire {{ clk.name }}{{ ',' if not loop.last }}
    {%- endfor %}
);

timeunit 1fs;
timeprecision 1fs;

{%- for clk in monitored_clocks %}
{{ class_prefix }}sample_interface sample_{{ clk.name }}_if({{ clk.name }});
{%- endfor %}

{%- for clk in monitored_clocks %}
// Measure {{ clk.name }} clock. X/Z means unconnected and is skipped by the caller.
task automatic measure_{{ clk.name }}_frequence(output bit is_connected, output bit is_timeout,
        output longint measure_result, input longint min_freq = 1);
    if($isunknown({{ clk.name }})) begin
        is_connected = 0;
        is_timeout = 0;
        measure_result = 0;
        `uvm_info("", "{{ clk.name }} clock is not connected, skip clock check", UVM_DEBUG)
        return;
    end

    is_connected = 1;
    sample_{{ clk.name }}_if.enable(1);
    measure_clock_frequence(sample_{{ clk.name }}_if.r, min_freq, is_timeout, measure_result);
    sample_{{ clk.name }}_if.enable(0);
endtask
{%- endfor %}

task automatic measure_clock_frequence(ref reg clk, input longint min_freq, output bit is_timeout,
        output longint measure_result);
    longint timeout;

    if(min_freq <= 0)
        `uvm_fatal("", $psprintf("Invalid min_freq=%0d", min_freq))

    is_timeout = 0;
    measure_result = 0;
    timeout = (1e15 / min_freq + 1) * 100;

    fork begin
        fork
            begin
                #(timeout);
                is_timeout = 1;
            end
            begin
                longint start_time;
                longint end_time;
                longint period;

                @(clk);
                start_time = $realtime;
                @(clk);
                end_time = $realtime;
                period = (end_time - start_time) * 2;
                if(period <= 0)
                    `uvm_fatal("", "Invalid clock period")
                measure_result = 1e15 / period;
            end
        join_any
        disable fork;
    end join
endtask
endinterface

`endif
