`ifndef {{ class_prefix | upper }}MONITOR_INTERFACE
`define {{ class_prefix | upper }}MONITOR_INTERFACE

interface {{ class_prefix }}monitor_interface(
    {%- for clk in monitored_clocks %}
    input wire {{ clk.name }}{{ ',' if not loop.last or is_emmc }}
    {%- endfor %}
    {%- if is_emmc %}
    input wire phase_tx_ref,
    input wire phase_tx_clk,
    input wire phase_rx_ref,
    input wire phase_rx_clk
    {%- endif %}
);

timeunit 1fs;
timeprecision 1fs;

{%- for clk in monitored_clocks %}
{{ class_prefix }}sample_interface sample_{{ clk.name }}_if({{ clk.name }});
{%- endfor %}

{%- for clk in monitored_clocks %}
// Measure {{ clk.name }} clock. X/Z means unconnected and is skipped by the caller.
task automatic measure_{{ clk.name }}_frequence(output bit is_connected, output bit is_timeout,
        output longint measure_result, input longint min_freq = 1);
    if($isunknown({{ clk.name }})) begin
        is_connected = 0;
        is_timeout = 0;
        measure_result = 0;
        `uvm_info("", "{{ clk.name }} clock is not connected, skip clock check", UVM_DEBUG)
        return;
    end

    is_connected = 1;
    sample_{{ clk.name }}_if.enable(1);
    measure_clock_frequence(sample_{{ clk.name }}_if.r, min_freq, is_timeout, measure_result);
    sample_{{ clk.name }}_if.enable(0);
endtask
{%- endfor %}

task automatic measure_clock_frequence(ref reg clk, input longint min_freq, output bit is_timeout,
        output longint measure_result);
    longint timeout;

    if(min_freq <= 0)
        `uvm_fatal("", $psprintf("Invalid min_freq=%0d", min_freq))

    is_timeout = 0;
    measure_result = 0;
    timeout = (1e15 / min_freq + 1) * 100;

    fork begin
        fork
            begin
                #(timeout);
                is_timeout = 1;
            end
            begin
                longint start_time;
                longint end_time;
                longint period;

                @(clk);
                start_time = $realtime;
                @(clk);
                end_time = $realtime;
                period = (end_time - start_time) * 2;
                if(period <= 0)
                    `uvm_fatal("", "Invalid clock period")
                measure_result = 1e15 / period;
            end
        join_any
        disable fork;
    end join
endtask
{%- if is_emmc %}

// Returns the shortest signed shift between corresponding edges.
function automatic longint wrap_phase(input longint delta_fs, input longint period_fs);
    delta_fs %= period_fs;
    if (delta_fs > period_fs / 2)
        return delta_fs - period_fs;
    if (delta_fs < -(period_fs / 2))
        return delta_fs + period_fs;
    return delta_fs;
endfunction

// Measures a continuous clock pair for one transfer direction.
task automatic measure_phase(
    input bit read_path,
    input bit both_edges,
    output longint shift_fs,
    output longint frequency_hz,
    output string problem
);
    localparam int samples = 9;
    logic [1:0] previous;
    longint stamp[2][2][samples];
    int count[2][2];
    longint period_fs;
    longint tolerance_fs;
    longint total_shift_fs;
    int polarities;
    bit complete;
    bit lost_clock;

    shift_fs = 0;
    frequency_hz = 0;
    problem = "";
    complete = 0;
    lost_clock = 0;
    total_shift_fs = 0;
    foreach (count[i, j])
        count[i][j] = 0;
    previous = read_path ? {phase_rx_clk, phase_rx_ref} : {phase_tx_clk, phase_tx_ref};
    if ($isunknown(previous)) begin
        problem = "phase clock pair is unconnected (Z) or unknown (X)";
        return;
    end

    polarities = both_edges ? 2 : 1;
    fork begin
        fork
            #10us;
            begin
                do begin
                    logic [1:0] current;

                    @(phase_tx_ref or phase_tx_clk or phase_rx_ref or phase_rx_clk);
                    current = read_path ? {phase_rx_clk, phase_rx_ref} : {phase_tx_clk, phase_tx_ref};
                    if ($isunknown(current)) begin
                        lost_clock = 1;
                        break;
                    end
                    for (int signal = 0; signal < 2; signal++) begin
                        int edge_index;

                        edge_index = current[signal] ? 0 : 1;
                        if (current[signal] != previous[signal] && edge_index < polarities &&
                            count[signal][edge_index] < samples) begin
                            stamp[signal][edge_index][count[signal][edge_index]] = longint'($time);
                            count[signal][edge_index]++;
                        end
                    end
                    previous = current;
                    complete = count[0][0] == samples && count[1][0] == samples &&
                        (!both_edges || (count[0][1] == samples && count[1][1] == samples));
                end while (!complete);
            end
        join_any
        disable fork;
    end join
    if (!complete) begin
        problem = lost_clock ? "phase clock pair became X or Z" :
            "phase clock pair did not supply enough edges";
        return;
    end

    period_fs = (stamp[0][0][samples - 1] - stamp[0][0][0]) / longint'(samples - 1);
    if (period_fs <= 0) begin
        problem = "invalid phase reference period";
        return;
    end
    frequency_hz = 64'sd1_000_000_000_000_000 / period_fs;
    tolerance_fs = period_fs / 100;
    for (int edge_index = 0; edge_index < polarities; edge_index++) begin
        for (int sample = 0; sample < samples; sample++) begin
            longint correction_fs;

            if (sample != 0) begin
                for (int signal = 0; signal < 2; signal++) begin
                    longint error_fs;

                    error_fs = stamp[signal][edge_index][sample] -
                        stamp[signal][edge_index][sample - 1] - period_fs;
                    if (error_fs > tolerance_fs || error_fs < -tolerance_fs) begin
                        problem = "phase clock periods differ or are unstable";
                        return;
                    end
                end
            end
            correction_fs = wrap_phase(stamp[0][edge_index][sample] - stamp[1][edge_index][sample], period_fs);
            if (correction_fs >= period_fs / 2 - tolerance_fs ||
                correction_fs <= -(period_fs / 2 - tolerance_fs)) begin
                problem = "phase correction is ambiguous near a half period";
                return;
            end
            if (edge_index == 0 && sample == 0)
                shift_fs = correction_fs;
            if (correction_fs > shift_fs + tolerance_fs || correction_fs < shift_fs - tolerance_fs) begin
                problem = "phase drifts or the selected edges require different corrections";
                return;
            end
            total_shift_fs += correction_fs;
        end
    end
    shift_fs = total_shift_fs / (samples * polarities);
endtask
{%- endif %}
endinterface

`endif
