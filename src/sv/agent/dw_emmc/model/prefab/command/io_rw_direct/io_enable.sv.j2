{% if is_sdio -%}
`ifndef {{ class_prefix | upper }}IO_RW_DIRECT_IO_ENABLE_COMMAND_REQUEST
`define {{ class_prefix | upper }}IO_RW_DIRECT_IO_ENABLE_COMMAND_REQUEST

// CCCM I/O Enable
class {{ class_prefix }}io_rw_direct_io_enable_command_request extends {{ class_prefix }}io_rw_direct_command_request;
    `uvm_object_utils_begin({{ class_prefix }}io_rw_direct_io_enable_command_request)
        `uvm_field_int(enable, UVM_ALL_ON)
    `uvm_object_utils_end

    rand bit[6:0] enable; // 每一比特对应每一个IO口的使能

    function new(string name="{{ class_prefix }}io_rw_direct_io_enable_command_request");
        super.new(name);
    endfunction

    constraint cst_io_rw_direct_prefab {
        function_number == 0;
        register_address == 'h02;
        write_data[7:1] == enable;
        foreach(enable[j])
            soft enable[j] == 1'b1;
    }
endclass

`endif
{% endif %}
