`ifndef {{ class_prefix | upper }}XFER_WRITE_SEQ
`define {{ class_prefix | upper }}XFER_WRITE_SEQ

// EMMC 主机写数据，从机接收写数据
class {{ class_prefix }}xfer_write_seq extends {{ class_prefix }}xfer_base_seq;
    `uvm_object_utils_begin({{ class_prefix }}xfer_write_seq)
        `uvm_field_int(write_protected, UVM_ALL_ON)
        `uvm_field_queue_int(wdata, UVM_ALL_ON)
    `uvm_object_utils_end

    rand bit write_protected; // 是否写保护。开启写保护时，写无效
    rand bit[7:0] wdata[$]; // 写数据

    function new(string name="{{ class_prefix }}xfer_write_seq");
        super.new(name);
    endfunction

    constraint cst_xfer_flow {
        soft write_protected == 0;
{%- if enable_dma %}
        (write_protected) -> dma_enable == 0;
{%- endif %}
        data_xfer_dir == XFER_WRITE;
        wdata.size == len;
    }

    virtual task execute_command();
        {{ class_prefix }}command_response cmd_response;

        {%- if is_emmc or is_sdcard %}
        {{ class_prefix }}write_block_command_seq write_block_seq;
        {{ class_prefix }}write_multiple_block_command_seq write_multiple_block_seq;

        if(count > 1) begin
            if(!abort)
                set_block_count();

            `uvm_do_with(write_multiple_block_seq, {
                cmd_request.block_count == local::count;
                cmd_request.block_size == local::size;
                cmd_request.addr == local::addr;
                cmd_request.chk_err_request.should_fatal == !local::allow_failure;
{%- if enable_dma %}
                cmd_request.dma_enable == local::dma_enable;
                cmd_request.dma_sel == local::dma_sel;
{%- if is_mobile_storage %}
                if(local::dma_enable)
                    cmd_request.dma_addr == local::adma_des.cmd_addr;
{%- else %}
                if(local::dma_enable && local::dma_sel inside {ADMA2, ADMA2_3})
                    cmd_request.dma_addr == local::adma_des.cmd_addr;
                else
                    cmd_request.dma_addr == local::addr;
{%- endif %}
{%- endif %}
                if(local::abort) {
                    cmd_request.auto_cmd_enable == AUTO_CMD12_ENABLED;
                }
                if(local::write_protected)
                    cmd_request.data_present_sel == 0;

                cmd_request.wdata.size == local::wdata.size;
                foreach(local::wdata[j])
                    cmd_request.wdata[j] == local::wdata[j];
            })
            cmd_response = write_multiple_block_seq.rsp;
        end
        else begin
            `uvm_do_with(write_block_seq, {
                cmd_request.block_count == local::count;
                cmd_request.block_size == local::size;
                cmd_request.addr == local::addr;
                cmd_request.chk_err_request.should_fatal == !local::allow_failure;
{%- if enable_dma %}
                cmd_request.dma_enable == local::dma_enable;
                cmd_request.dma_sel == local::dma_sel;
{%- if is_mobile_storage %}
                if(local::dma_enable)
                    cmd_request.dma_addr == local::adma_des.cmd_addr;
{%- else %}
                if(local::dma_enable && local::dma_sel inside {ADMA2, ADMA2_3})
                    cmd_request.dma_addr == local::adma_des.cmd_addr;
                else
                    cmd_request.dma_addr == local::addr;
{%- endif %}
{%- endif %}
                if(local::abort) {
                    cmd_request.auto_cmd_enable == AUTO_CMD12_ENABLED;
                }
                if(local::write_protected)
                    cmd_request.data_present_sel == 0;

                cmd_request.wdata.size == local::wdata.size;
                foreach(local::wdata[j])
                    cmd_request.wdata[j] == local::wdata[j];
            })
            cmd_response = write_block_seq.rsp;
        end
        {%- elif is_sdio %}
        execute_sdio(wdata);
        cmd_response = io_rw_extended_seq.rsp;
        {%- endif %}

        if (cmd_response.failed) begin
            failed = 1;
            failure_reason = cmd_response.failure_reason;
            return;
        end
    endtask
endclass

`endif
