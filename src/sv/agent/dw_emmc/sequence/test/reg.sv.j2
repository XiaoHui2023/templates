{% if is_emmc or is_sdcard -%}
`ifndef {{ class_prefix | upper }}REG_TEST_SEQ
`define {{ class_prefix | upper }}REG_TEST_SEQ

class {{ class_prefix }}reg_test_seq extends {{ class_prefix }}base_seq#({{ class_prefix }}base_item);
    `uvm_object_utils({{ class_prefix }}reg_test_seq)

    function new(string name = "{{ class_prefix }}reg_test_seq");
        super.new(name);
    endfunction

    extern task body();
    extern task handle_pre_switch_yield({{ class_prefix }}yield yield);
    extern task handle_post_switch_yield({{ class_prefix }}yield yield);
endclass

task {{ class_prefix }}reg_test_seq::body();
    {{ class_prefix }}initial_seq initial_seq;

    `uvm_create(initial_seq)

    fork
        handle_pre_switch_yield(initial_seq.pre_switch_yield);
        handle_post_switch_yield(initial_seq.post_switch_yield);
        `uvm_rand_send(initial_seq)
    join
endtask

task {{ class_prefix }}reg_test_seq::handle_pre_switch_yield({{ class_prefix }}yield yield);
    {%- if is_emmc %}
    {{ class_prefix }}send_csd_command_seq send_csd_seq;
    {{ class_prefix }}send_cid_command_seq send_cid_seq;
    {%- elif is_sdcard %}
    {{ class_prefix }}send_csd_command_seq send_csd_seq;
    {{ class_prefix }}send_cid_command_seq send_cid_seq;
    {%- endif %}

    yield.request();

    {%- if is_emmc %}

    `uvm_do(send_csd_seq)
    `uvm_do(send_cid_seq)
    {%- elif is_sdcard %}

    `uvm_do(send_cid_seq)
    `uvm_do(send_csd_seq)
    {%- endif %}

    yield.resume();
endtask

task {{ class_prefix }}reg_test_seq::handle_post_switch_yield({{ class_prefix }}yield yield);
    {%- if is_emmc %}
    {{ class_prefix }}send_ext_csd_seq send_ext_csd_seq;
    {%- elif is_sdcard %}
    {{ class_prefix }}send_scr_acmd_seq send_scr_seq;
    {%- endif %}

    yield.request();
    {%- if is_emmc %}

    `uvm_do(send_ext_csd_seq)
    {%- elif is_sdcard %}

    `uvm_do(send_scr_seq)
    {%- endif %}

    yield.resume();
endtask

`endif
{% endif %}
