`ifndef {{ class_prefix | upper }}CHECK_ERROR_OP_SEQ
`define {{ class_prefix | upper }}CHECK_ERROR_OP_SEQ

class {{ class_prefix }}check_error_operation_seq extends {{ class_prefix }}base_operation_seq#({{ class_prefix }}check_error_response);
    `uvm_object_utils({{ class_prefix }}check_error_operation_seq)

    rand {{ class_prefix }}check_error_request chk_err_request;

    function new(string name="{{ class_prefix }}check_error_operation_seq");
        super.new(name);
    endfunction

    extern function void pre_randomize();
    extern task body();
endclass

function void {{ class_prefix }}check_error_operation_seq::pre_randomize();
    super.pre_randomize();

    if(!chk_err_request)
        `uvm_create(chk_err_request)
endfunction

task {{ class_prefix }}check_error_operation_seq::body();
    uvm_reg_field flds[$];
    bit[31:0] rdata;

    // ERROR
    rm.ERROR_INT_STAT_R.read(status,rdata);
    if(rdata) begin
        // check
        rm.ERROR_INT_STAT_R.get_fields(flds);
        foreach(flds[j]) begin
            uvm_reg_field f;

            f = flds[j];

            if(!f.get())
                continue;
            if(!chk_err_request.all_err_en[j])
                continue;

            rsp.status[j] = 1;
        end
        rm.ERROR_INT_STAT_R.write(status,rdata);
    end

    // ADMA_ERR
    if(rm.ERROR_INT_STAT_R.ADMA_ERR.get()) begin
        rm.ADMA_ERR_STAT_R.read(status,rdata);
        rsp.adma_status = rdata;
        if(rdata)
            rm.ADMA_ERR_STAT_R.write(status,rdata);
    end

    rsp.randomize();
    if(rsp.is_error) begin
        string s;

        s = $psprintf("exists error:\n%s",rsp.sprint());

        if(chk_err_request.should_fatal)
            `uvm_fatal("",s)
        else
            `uvm_info("",s,UVM_LOW)
    end
    else
        `uvm_info("",$psprintf("check_error:\n%s",rsp.sprint()),UVM_DEBUG)
endtask

`endif
