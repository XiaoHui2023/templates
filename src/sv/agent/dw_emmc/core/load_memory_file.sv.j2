`ifndef {{ class_prefix | upper }}LOAD_MEMORY_FILE
`define {{ class_prefix | upper }}LOAD_MEMORY_FILE

/*
    加载 memh 文件到字节队列。

    filename   : 文件名
    data[$]    : 输出数据
    dw         : 数据位宽检查，必须按 byte 对齐
    start_addr : 从 mirror 中读取的起始地址
    len        : 读取长度，<=0 表示从 start_addr 读到文件末尾
*/
function automatic void {{ class_prefix }}load_memory_file(input string filename, output bit[7:0] data[$], input int dw = -1, input bit[31:0] start_addr = 0, input int len = -1);
    {{ class_prefix }}mem mem;
    string message;

    if(dw != -1 && dw % 8 > 0)
        `uvm_fatal("", $psprintf("require data width align to byte, but dw=%0d", dw))

    mem = {{ class_prefix }}mem::type_id::create("mem");
    if(!mem.load_memh(filename))
        `uvm_fatal("", $psprintf("load memory file failed: %s", filename))

    if(start_addr > mem.data.size())
        `uvm_fatal("", $psprintf("start_addr 0x%0h exceeds memory size %0d", start_addr, mem.data.size()))

    if(len <= 0)
        len = mem.data.size() - start_addr;

    if(!mem.read(start_addr, len, data, message))
        `uvm_fatal("", message)
endfunction

`endif
