`ifndef {{ class_prefix | upper }}CLOCK_PHASE_TYPES
`define {{ class_prefix | upper }}CLOCK_PHASE_TYPES

package {{ class_prefix }}clock_phase_types;
timeunit 1ns;
timeprecision 1ps;

    typedef struct {
        string name;
        int group_id;
        int tap_count;
        bit wraps;
    } axis_t;
    typedef axis_t axes_t[];
    typedef int taps_t[];

    typedef enum {PHASE_TRANSFER, PHASE_EMMC_HS200_CMD21, PHASE_EMMC_HS400_TRANSFER} protocol_e;
    typedef struct packed {
        int speed_mode;
        int data_width;
        int frequency_hz;
        int voltage;
        protocol_e protocol;
    } operating_point_t;

    typedef enum {
        PHASE_SKIPPED,
        PHASE_PASSED,
        PHASE_BUSY,
        PHASE_BAD_TOPOLOGY,
        PHASE_BUDGET_EXCEEDED,
        PHASE_ADAPTER_FAILED,
        PHASE_NO_WINDOW,
        PHASE_CONFIRM_FAILED,
        PHASE_TIMED_OUT,
        PHASE_RESTORE_FAILED
    } status_e;
    typedef enum {PROBE_REJECTED, PROBE_PASSED, PROBE_FAILED} probe_e;
    localparam int CONFIRM_ALL_GROUPS = -1;

    typedef struct {
        status_e status;
        status_e failure_before_restore;
        int probes;
        int failed_group;
        taps_t original;
        taps_t selected;
    } result_t;

    // Waits in microseconds independently of the caller's timescale.
    task automatic wait_clock_phase_timeout(input int timeout_us);
        #(timeout_us * 1us);
    endtask
endpackage

`endif
