`ifndef {{ class_prefix | upper }}CLOCK_PHASE_CALIBRATOR
`define {{ class_prefix | upper }}CLOCK_PHASE_CALIBRATOR

import {{ class_prefix }}clock_phase_types::*;

class {{ class_prefix }}clock_phase_grid;
    int group_id;
    int axis_index[$];
    int stride[$];
    int size = 1;

    // Adds an axis only if all combinations still fit in the remaining budget.
    function bit add_axis(input int index, input int tap_count, input int budget);
        if (tap_count <= 0 || size > budget / tap_count)
            return 0;
        axis_index.push_back(index);
        stride.push_back(size);
        size *= tap_count;
        return 1;
    endfunction

    // Loads taps for a reflected traversal and returns their canonical index.
    function int visit(input axes_t axes, input int step, ref taps_t taps);
        int flat;
        int count;
        int tap;

        flat = 0;
        foreach (axis_index[j]) begin
            count = axes[axis_index[j]].tap_count;
            tap = (step / stride[j]) % count;
            if (((step / (stride[j] * count)) % 2) != 0)
                tap = count - 1 - tap;
            taps[axis_index[j]] = tap;
            flat += tap * stride[j];
        end
        return flat;
    endfunction

    // Loads a selected canonical grid point into the corresponding axes.
    function void select_taps(input axes_t axes, input int flat, ref taps_t taps);
        foreach (axis_index[j])
            taps[axis_index[j]] = (flat / stride[j]) % axes[axis_index[j]].tap_count;
    endfunction

    // Finds the passing point with the largest distance to failure or a non-wrapping edge.
    function int best_point(input axes_t axes, input taps_t original, input bit passed[]);
        int distance[];
        int pending[$];
        int node;
        int axis_id;
        int count;
        int tap;
        int next_tap;
        int neighbor;
        int travel;
        int delta;
        int best;
        int best_travel;

        distance = new[size];
        // Seed at distances 0 and 1 in that order to keep the queue monotonic.
        for (int flat = 0; flat < size; flat++) begin
            distance[flat] = passed[flat] ? size + 1 : 0;
            if (!passed[flat])
                pending.push_back(flat);
        end
        for (int flat = 0; flat < size; flat++) begin
            if (!passed[flat])
                continue;
            foreach (axis_index[j]) begin
                axis_id = axis_index[j];
                count = axes[axis_id].tap_count;
                tap = (flat / stride[j]) % count;
                if (count > 1 && !axes[axis_id].wraps && (tap == 0 || tap == count - 1)) begin
                    distance[flat] = 1;
                    pending.push_back(flat);
                    break;
                end
            end
        end
        while (pending.size() != 0) begin
            node = pending.pop_front();
            foreach (axis_index[j]) begin
                axis_id = axis_index[j];
                count = axes[axis_id].tap_count;
                tap = (node / stride[j]) % count;
                for (int direction = -1; direction <= 1; direction += 2) begin
                    next_tap = tap + direction;
                    if (next_tap < 0 || next_tap >= count) begin
                        if (!axes[axis_id].wraps)
                            continue;
                        next_tap = (next_tap + count) % count;
                    end
                    neighbor = node + (next_tap - tap) * stride[j];
                    if (distance[neighbor] > distance[node] + 1) begin
                        distance[neighbor] = distance[node] + 1;
                        pending.push_back(neighbor);
                    end
                end
            end
        end
        best = -1;
        best_travel = 0;
        for (int flat = 0; flat < size; flat++) begin
            if (!passed[flat])
                continue;
            travel = 0;
            foreach (axis_index[j]) begin
                axis_id = axis_index[j];
                count = axes[axis_id].tap_count;
                tap = (flat / stride[j]) % count;
                delta = tap > original[axis_id] ? tap - original[axis_id] : original[axis_id] - tap;
                travel += axes[axis_id].wraps && count - delta < delta ? count - delta : delta;
            end
            if (best < 0 || distance[flat] > distance[best] ||
                (distance[flat] == distance[best] && travel < best_travel)) begin
                best = flat;
                best_travel = travel;
            end
        end
        return best;
    endfunction
endclass

class {{ class_prefix }}clock_phase_calibrator;
    typedef {{ class_prefix }}callback adapter_t;
    typedef {{ class_prefix }}clock_phase_grid grid_t;
    typedef grid_t grids_t[$];
    local bit running;

    // Runs a bounded calibration and restores the captured taps on failure.
    task run(
        input adapter_t adapter,
        input int max_probes,
        input int confirm_samples,
        input int scan_timeout_us,
        input int restore_timeout_us,
        output result_t result,
        input taps_t cached_taps = {}
    );
        result_t outcome;
        bit recovery_needed;
        bit finished;
        bit restored;

        outcome.status = PHASE_SKIPPED;
        outcome.failure_before_restore = PHASE_SKIPPED;
        outcome.failed_group = CONFIRM_ALL_GROUPS;
        if (adapter == null) begin
            result = outcome;
            return;
        end
        if (running) begin
            outcome.status = PHASE_BUSY;
            result = outcome;
            return;
        end
        if (scan_timeout_us <= 0 || restore_timeout_us <= 0 || confirm_samples <= 0 ||
            max_probes <= confirm_samples) begin
            outcome.status = PHASE_BAD_TOPOLOGY;
            result = outcome;
            return;
        end

        running = 1;
        fork
            begin
                fork
                    begin
                        scan(adapter, max_probes, confirm_samples, cached_taps, outcome, recovery_needed);
                        finished = 1;
                    end
                    wait_clock_phase_timeout(scan_timeout_us);
                join_any
                disable fork;
            end
        join
        if (!finished)
            outcome.status = PHASE_TIMED_OUT;
        if (recovery_needed && outcome.status != PHASE_PASSED) begin
            fork
                begin
                    fork
                        adapter.clock_phase_apply(outcome.original, restored);
                        wait_clock_phase_timeout(restore_timeout_us);
                    join_any
                    disable fork;
                end
            join
            if (!restored) begin
                outcome.failure_before_restore = outcome.status;
                outcome.status = PHASE_RESTORE_FAILED;
            end
        end
        if (outcome.status != PHASE_PASSED)
            outcome.selected.delete();
        running = 0;
        result = outcome;
    endtask

    // Validates axes and total exposure before any phase writes.
    local function status_e plan(input axes_t axes, input int budget, ref grids_t groups);
        grid_t by_id[int];
        bit names[string];
        int points;

        if (axes.size() == 0)
            return PHASE_SKIPPED;
        foreach (axes[index]) begin
            if (axes[index].name == "" || names.exists(axes[index].name) ||
                axes[index].group_id < 0 || axes[index].tap_count <= 0)
                return PHASE_BAD_TOPOLOGY;
            names[axes[index].name] = 1;
            if (!by_id.exists(axes[index].group_id)) begin
                grid_t group = new;

                group.group_id = axes[index].group_id;
                by_id[group.group_id] = group;
                groups.push_back(group);
            end
            if (!by_id[axes[index].group_id].add_axis(index, axes[index].tap_count, budget))
                return PHASE_BUDGET_EXCEEDED;
        end
        points = 0;
        foreach (groups[index]) begin
            if (groups[index].size > budget - points)
                return PHASE_BUDGET_EXCEEDED;
            points += groups[index].size;
        end
        return PHASE_PASSED;
    endfunction

    // Probes each point once and confirms the combined selection.
    local task scan(
        input adapter_t adapter,
        input int max_probes,
        input int confirm_samples,
        input taps_t cached_taps,
        ref result_t outcome,
        ref bit recovery_needed
    );
        axes_t axes;
        grids_t groups;
        taps_t tapped;
        taps_t programmed;
        bit ok;
        probe_e probe_status;

        adapter.clock_phase_describe(axes);
        outcome.status = plan(axes, max_probes - confirm_samples, groups);
        if (outcome.status != PHASE_PASSED)
            return;
        outcome.status = PHASE_ADAPTER_FAILED;
        adapter.clock_phase_capture(outcome.original, ok);
        if (!ok || outcome.original.size() != axes.size())
            return;
        foreach (axes[index])
            if (outcome.original[index] < 0 || outcome.original[index] >= axes[index].tap_count)
                return;

        if (cached_taps == outcome.original) begin
            outcome.selected = cached_taps;
            outcome.status = PHASE_PASSED;
            return;
        end

        tapped = outcome.original;
        programmed = outcome.original;
        outcome.selected = outcome.original;
        foreach (groups[index]) begin
            grid_t group;
            bit passed[];
            int flat;
            int best;

            group = groups[index];
            outcome.failed_group = group.group_id;
            passed = new[group.size];
            for (int step = 0; step < group.size; step++) begin
                flat = group.visit(axes, step, tapped);
                program_taps(adapter, tapped, programmed, recovery_needed, ok);
                if (!ok)
                    return;
                outcome.probes++;
                recovery_needed = 1;
                adapter.clock_phase_probe(group.group_id, probe_status);
                if (probe_status == PROBE_FAILED)
                    return;
                passed[flat] = probe_status == PROBE_PASSED;
            end
            best = group.best_point(axes, outcome.original, passed);
            if (best < 0) begin
                outcome.status = PHASE_NO_WINDOW;
                return;
            end
            group.select_taps(axes, best, outcome.selected);
            tapped = outcome.selected;
        end

        outcome.failed_group = CONFIRM_ALL_GROUPS;
        program_taps(adapter, outcome.selected, programmed, recovery_needed, ok);
        if (!ok)
            return;
        repeat (confirm_samples) begin
            outcome.probes++;
            adapter.clock_phase_probe(CONFIRM_ALL_GROUPS, probe_status);
            if (probe_status == PROBE_FAILED)
                return;
            if (probe_status != PROBE_PASSED) begin
                outcome.status = PHASE_CONFIRM_FAILED;
                return;
            end
        end
        outcome.status = PHASE_PASSED;
    endtask

    // Skips identical vectors and records that hardware may need restoration.
    local task program_taps(
        input adapter_t adapter,
        input taps_t taps,
        ref taps_t programmed,
        ref bit recovery_needed,
        output bit ok
    );
        ok = 1;
        if (taps == programmed)
            return;
        recovery_needed = 1;
        adapter.clock_phase_apply(taps, ok);
        if (ok)
            programmed = taps;
    endtask
endclass

`endif
