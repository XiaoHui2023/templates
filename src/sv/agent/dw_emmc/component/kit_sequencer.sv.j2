task {{ class_prefix }}kit_sequencer::rw_test(bit[63:0] addr = 0, int count = 1, bit write_enable = 1, bit read_enable = 1{%- if enable_dma %}, bit use_dma = {{ 1 if is_mobile_storage else 0 }}{%- endif %});
    {{ class_prefix }}rw_test_seq seq;

    if(!write_enable && !read_enable)
        `uvm_fatal("KIT", "rw_test requires write_enable or read_enable")

    seq = {{ class_prefix }}rw_test_seq::type_id::create("rw_test_seq");
    seq.set_item_context(null, this);
    if(!seq.randomize() with {
        addr == local::addr;
        rd == local::read_enable;
        wr == local::write_enable;
        rd_single == (local::read_enable && local::count == 1);
        wr_single == (local::write_enable && local::count == 1);
        rd_multi == (local::read_enable && local::count > 1);
        wr_multi == (local::write_enable && local::count > 1);
        rd_multi_block_count == local::count;
        wr_multi_block_count == local::count;
        should_compare == (local::read_enable && local::write_enable);
{%- if enable_dma %}
        dma_enable == local::use_dma;
{%- endif %}
    })
        `uvm_fatal("KIT", "rw_test_seq randomize failed")
    seq.start(this);
endtask
