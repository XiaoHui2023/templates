    rdata = seq.rsp.rdata;
endtask

task {{ class_prefix }}kit_sequencer::cpu_write_bytes(bit[63:0] addr, const ref bit[7:0] wdata[$]);
    {{ class_prefix }}cpu_config_operation_seq seq;
    int unsigned write_len;

    write_len = wdata.size();
    seq = {{ class_prefix }}cpu_config_operation_seq::type_id::create("cpu_write_bytes_seq");
    seq.set_item_context(null, this);
    if(!seq.randomize() with {
        cpu_cfg_request.access == UVM_WRITE;
        cpu_cfg_request.addr == local::addr;
        cpu_cfg_request.len == local::write_len;
    })
        `uvm_fatal("KIT", "cpu_config_operation_seq write randomize failed")
    seq.cpu_cfg_request.wdata = wdata;
    seq.start(this);
endtask

