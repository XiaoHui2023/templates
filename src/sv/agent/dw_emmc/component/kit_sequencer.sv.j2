task {{ class_prefix }}kit_sequencer::frequence_set_operation(int frequence, bit should_check_clock_frequence = 1);
    {{ class_prefix }}frequence_set_operation_seq seq;

    seq = {{ class_prefix }}frequence_set_operation_seq::type_id::create("frequence_set_operation_seq");
    seq.set_item_context(null, this);
    if(!seq.randomize() with {
        freq_set_request.frequence == local::frequence;
        freq_set_request.should_check_clock_frequence == local::should_check_clock_frequence;
    })
        `uvm_fatal("KIT", "frequence_set_operation_seq randomize failed")
    seq.start(this);
endtask

task {{ class_prefix }}kit_sequencer::power_up_operation({{ class_prefix }}power_up_request req = null);
    {{ class_prefix }}power_up_operation_seq seq;

    seq = {{ class_prefix }}power_up_operation_seq::type_id::create("power_up_operation_seq");
    if(req != null)
        seq.power_up_request = req;
    seq.set_item_context(null, this);
    if(!seq.randomize())
        `uvm_fatal("KIT", "power_up_operation_seq randomize failed")
    seq.start(this);
endtask

