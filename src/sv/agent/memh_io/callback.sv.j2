`ifndef {{ (class_prefix ~ "callback") | upper }}
`define {{ (class_prefix ~ "callback") | upper }}

class {{ class_prefix }}callback extends uvm_callback;
    `uvm_object_utils({{ class_prefix }}callback)

    function new(string name="{{ class_prefix }}callback");
        super.new(name);
    endfunction

    // memory 写入完成即触发
    // addr — 首字节地址
    // data — 字节
    virtual function void on_write_data(bit [63:0] addr, bit [7:0] data[$]);
    endfunction

    // memory 清空后触发
    virtual function void on_clear();
    endfunction

    // 读入 data 后调用；可改字节值，返回时队列长度须与进入时相同
    // addr — 首字节地址
    // len — 字节个数
    // data — 字节队列
    virtual function void after_read_data(input bit [63:0] addr, input int len, ref bit [7:0] data[$]);
    endfunction
endclass

`endif
