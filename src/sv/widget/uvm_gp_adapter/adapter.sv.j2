function void {{ class_name }}::connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    i_item_ap.connect(item_imp);
    i_gp_ap.connect(gp_imp);
endfunction

task {{ class_name }}::reset_phase(uvm_phase phase);
    super.reset_phase(phase);
    clear_statistics();
endtask

function void {{ class_name }}::get_statistics(output statistics_t statistics);
    statistics = m_statistics;
endfunction

function void {{ class_name }}::clear_statistics();
    m_statistics = '0;
endfunction

function void {{ class_name }}::write_{{ class_name }}_item({{ item_type }} item);
    uvm_tlm_generic_payload gp;
    if (to_gp(item, gp)) o_gp_ap.write(gp);
    else `uvm_error("GP_ADAPTER", last_error)
endfunction

function void {{ class_name }}::write_{{ class_name }}_gp(uvm_tlm_generic_payload gp);
    {{ item_type }} item;
    if (from_gp(gp, item)) o_item_ap.write(item);
    else `uvm_error("GP_ADAPTER", last_error)
endfunction

function bit {{ class_name }}::fail(string reason);
    last_error = reason;
    return 0;
endfunction

function bit {{ class_name }}::to_gp(input {{ item_type }} item, output uvm_tlm_generic_payload gp);
    bit success;
    success = convert_to_gp(item, gp);
    if (success) begin
        m_statistics.to_gp.success_count++;
        m_statistics.to_gp.success_bytes += 64'(gp.get_data_length());
    end
    else m_statistics.to_gp.failure_count++;
    return success;
endfunction

function bit {{ class_name }}::from_gp(input uvm_tlm_generic_payload gp, output {{ item_type }} item);
    bit success;
    success = convert_from_gp(gp, item);
    if (success) begin
        m_statistics.from_gp.success_count++;
        m_statistics.from_gp.success_bytes += 64'(gp.get_data_length());
    end
    else m_statistics.from_gp.failure_count++;
    return success;
endfunction

function bit {{ class_name }}::convert_to_gp(input {{ item_type }} item, output uvm_tlm_generic_payload gp);
    last_error = "";
    gp = null;
    {%- if item_is_class %}
    if (item == null) return fail("null item");
    {%- endif %}
    gp = new("gp");
    if (!encode_item(item, gp)) begin
        gp = null;
        if (last_error == "") return fail("encoder rejected item");
        return 0;
    end
    if (!after_encode(item, gp)) begin
        gp = null;
        if (last_error == "") return fail("encode hook rejected item");
        return 0;
    end
    if (!validate_gp(gp)) begin
        gp = null;
        return 0;
    end
    return 1;
endfunction

function bit {{ class_name }}::convert_from_gp(input uvm_tlm_generic_payload gp, output {{ item_type }} item);
    {{ item_type }} empty_item;
    last_error = "";
    if (gp == null) return fail("null GP");
    if (!validate_gp(gp)) return 0;
    {%- if item_is_class %}
    item = {{ create_item }};
    if (item == null) return fail("item allocation failed");
    {%- endif %}
    if (!decode_item(gp, item)) begin
        item = empty_item;
        if (last_error == "") return fail("decoder rejected GP");
        return 0;
    end
    if (!after_decode(gp, item)) begin
        item = empty_item;
        if (last_error == "") return fail("decode hook rejected GP");
        return 0;
    end
    if (!validate_gp(gp)) begin
        item = empty_item;
        return 0;
    end
    return 1;
endfunction

function bit {{ class_name }}::validate_gp(uvm_tlm_generic_payload gp);
    byte unsigned raw_data[];
    byte unsigned raw_enable[];
    if (gp.get_data_length() > {{ max_bytes }} || gp.get_byte_enable_length() > {{ max_bytes }})
        return fail("GP length exceeds max_bytes");
    gp.get_data(raw_data);
    gp.get_byte_enable(raw_enable);
    if (gp.get_data_length() > raw_data.size()) return fail("data length exceeds buffer");
    if (gp.get_byte_enable_length() > raw_enable.size()) return fail("byte enable length exceeds buffer");
    if (!(gp.get_command() inside {UVM_TLM_READ_COMMAND, UVM_TLM_WRITE_COMMAND, UVM_TLM_IGNORE_COMMAND}))
        return fail("invalid command");
    if (!(gp.get_command() inside {{ '{' }}{% for command_name in allowed_commands %}UVM_TLM_{{ command_name | upper }}_COMMAND{{ ', ' if not loop.last }}{% endfor %}{{ '}' }}))
        return fail("command is not allowed");
    if ((gp.get_address() >> {{ address_bits }}) != 0) return fail("address exceeds configured width");
    if (!(gp.get_response_status() inside {UVM_TLM_OK_RESPONSE, UVM_TLM_INCOMPLETE_RESPONSE,
            UVM_TLM_GENERIC_ERROR_RESPONSE, UVM_TLM_ADDRESS_ERROR_RESPONSE,
            UVM_TLM_COMMAND_ERROR_RESPONSE, UVM_TLM_BURST_ERROR_RESPONSE,
            UVM_TLM_BYTE_ENABLE_ERROR_RESPONSE})) return fail("invalid response status");
    if (gp.get_command() != UVM_TLM_IGNORE_COMMAND && gp.get_data_length() == 0)
        return fail("read/write requires nonzero length");
    {%- if require_streaming_width %}
    if (gp.get_command() != UVM_TLM_IGNORE_COMMAND && gp.get_streaming_width() == 0)
        return fail("read/write requires nonzero streaming width");
    {%- endif %}
    {%- if byte_enable_policy == 'disabled' %}
    if (gp.get_byte_enable_length() != 0) return fail("byte enables are disabled");
    {%- elif byte_enable_policy == 'required' %}
    if (gp.get_data_length() != 0 && gp.get_byte_enable_length() == 0) return fail("byte enables are required");
    {%- elif byte_enable_policy == 'full_length' %}
    if (gp.get_byte_enable_length() != gp.get_data_length()) return fail("byte enable length must equal data length");
    {%- endif %}
    for (int i = 0; i < gp.get_byte_enable_length(); i++) begin
        if (!(raw_enable[i] inside {8'h00, 8'hff})) return fail("invalid byte enable value");
        {%- if byte_enable_policy == 'all_enabled' %}
        if (raw_enable[i] != 8'hff) return fail("all bytes must be enabled");
        {%- endif %}
    end
    return 1;
endfunction

function bit {{ class_name }}::encode_item(input {{ item_type }} item, input uvm_tlm_generic_payload gp);
    bit [7:0] bytes[$];
    byte unsigned raw[];
    longint length_value;
    if ($isunknown({{ address.source_expr }}) || (({{ address.source_expr }}) >> {{ address_bits }}) != 0)
        return fail("address exceeds configured width");
    if (!pack_data(item, bytes)) return 0;
    if (bytes.size() > {{ max_bytes }}) return fail("encoded data exceeds max_bytes");
    raw = new[bytes.size()];
    foreach (raw[i]) raw[i] = bytes[i];
    gp.set_data(raw);
    {%- if data_length %}
    length_value = {{ data_length.source_expr }};
    if ($isunknown(length_value) || length_value < 0 || length_value > {{ max_bytes // (data.stride if data_length.unit == 'elements' else 1) }})
        return fail("data length expression out of range");
    gp.set_data_length(32'(length_value * {{ data.stride if data_length.unit == 'elements' else 1 }}));
    {%- else %}
    gp.set_data_length(raw.size());
    {%- endif %}
    {%- if byte_enable %}
    if (!pack_byte_enable(item, bytes)) return 0;
    if (bytes.size() > {{ max_bytes }}) return fail("encoded byte enable exceeds max_bytes");
    raw = new[bytes.size()];
    foreach (raw[i]) raw[i] = bytes[i];
    gp.set_byte_enable(raw);
    {%- if byte_enable_length %}
    length_value = {{ byte_enable_length.source_expr }};
    if ($isunknown(length_value) || length_value < 0 || length_value > {{ max_bytes // (byte_enable.stride if byte_enable_length.unit == 'elements' else 1) }})
        return fail("byte enable length expression out of range");
    gp.set_byte_enable_length(32'(length_value * {{ byte_enable.stride if byte_enable_length.unit == 'elements' else 1 }}));
    {%- else %}
    gp.set_byte_enable_length(raw.size());
    {%- endif %}
    {%- elif byte_enable_policy == 'all_enabled' %}
    if (gp.get_data_length() > {{ max_bytes }}) return fail("data length exceeds max_bytes");
    raw = new[gp.get_data_length()];
    foreach (raw[i]) raw[i] = 8'hff;
    gp.set_byte_enable(raw);
    gp.set_byte_enable_length(raw.size());
    {%- endif %}
    gp.set_address({{ address.source_expr }});
    if ($isunknown({{ command.source_expr }}) || !(({{ command.source_expr }}) inside {{ '{' }}{% for command_name in allowed_commands %}UVM_TLM_{{ command_name | upper }}_COMMAND{{ ', ' if not loop.last }}{% endfor %}{{ '}' }}))
        return fail("command is not allowed");
    gp.set_command(uvm_tlm_command_e'({{ command.source_expr }}));
    gp.set_response_status(uvm_tlm_response_status_e'({{ response_status.source_expr }}));
    length_value = {{ streaming_width.source_expr }};
    if ($isunknown(length_value) || length_value < 0 || length_value > 64'd4294967295 / {{ data.stride if streaming_width.unit == 'elements' else 1 }})
        return fail("streaming width expression out of range");
    gp.set_streaming_width(32'(length_value * {{ data.stride if streaming_width.unit == 'elements' else 1 }}));
    return 1;
endfunction

function bit {{ class_name }}::decode_item(input uvm_tlm_generic_payload gp, inout {{ item_type }} item);
    bit [7:0] bytes[$];
    byte unsigned raw[];
    {%- for name, mapping, getter, stride in [('address', address, 'get_address', 1), ('command', command, 'get_command', 1), ('response_status', response_status, 'get_response_status', 1), ('streaming_width', streaming_width, 'get_streaming_width', data.stride if streaming_width.unit == 'elements' else 1), ('data_length', data_length, 'get_data_length', data.stride if data_length and data_length.unit == 'elements' else 1), ('byte_enable_length', byte_enable_length, 'get_byte_enable_length', byte_enable.stride if byte_enable_length and byte_enable_length.unit == 'elements' else 1)] %}
