{%- if transpose.enabled -%}
{%- set class_name = class_prefix ~ "tensor_transpose" -%}
`ifndef {{ class_name | upper }}
`define {{ class_name | upper }}

class {{ class_name }} #(type T = bit);
    // 按 shape 和轴排列重排 row-major 数据。
    // data_in — 输入张量的一维 row-major 数据
    // shape — 输入张量各轴长度
    // data_out — 重排后的一维 row-major 数据
    // shape_out — 重排后的各轴长度
    // perm — 输出轴到输入轴的映射；空队列表示反转轴顺序
    static function void transpose(
        input T data_in[$],
        input int shape[$],
        output T data_out[$],
        output int shape_out[$],
        input int perm[$] = '{}
    );
        int normalized_perm[$];
        longint input_strides[];
        longint output_strides[];
        bit seen[];
        int rank;
        longint total;
        longint remaining;
        longint coordinate;
        longint input_index;

        data_out.delete();
        shape_out.delete();
        rank = shape.size();
        if (rank < 1) begin
            $fatal(1, "shape must contain at least one axis");
        end

        total = 1;
        foreach (shape[i]) begin
            if (shape[i] < 1) begin
                $fatal(1, "shape[%0d]=%0d must be positive", i, shape[i]);
            end
            total *= shape[i];
        end
        if (data_in.size() != total) begin
            $fatal(1, "data size=%0d does not match shape size=%0d", data_in.size(), total);
        end

        if (perm.size() == 0) begin
            for (int i = rank - 1; i >= 0; i--) begin
                normalized_perm.push_back(i);
            end
        end
        else begin
            normalized_perm = perm;
        end
        if (normalized_perm.size() != rank) begin
            $fatal(1, "perm size=%0d does not match rank=%0d", normalized_perm.size(), rank);
        end

        seen = new[rank];
        foreach (normalized_perm[i]) begin
            if (normalized_perm[i] < 0 || normalized_perm[i] >= rank) begin
                $fatal(1, "perm[%0d]=%0d is outside 0..%0d", i, normalized_perm[i], rank-1);
            end
            if (seen[normalized_perm[i]]) begin
                $fatal(1, "perm repeats axis %0d", normalized_perm[i]);
            end
            seen[normalized_perm[i]] = 1;
            shape_out.push_back(shape[normalized_perm[i]]);
        end

        input_strides = new[rank];
        output_strides = new[rank];
        input_strides[rank-1] = 1;
        output_strides[rank-1] = 1;
        for (int i = rank - 2; i >= 0; i--) begin
            input_strides[i] = input_strides[i+1] * shape[i+1];
            output_strides[i] = output_strides[i+1] * shape_out[i+1];
        end

        for (longint output_index = 0; output_index < total; output_index++) begin
            remaining = output_index;
            input_index = 0;
            for (int output_axis = 0; output_axis < rank; output_axis++) begin
                coordinate = remaining / output_strides[output_axis];
                remaining %= output_strides[output_axis];
                input_index += coordinate * input_strides[normalized_perm[output_axis]];
            end
            data_out.push_back(data_in[input_index]);
        end
    endfunction
endclass
`endif
{%- endif %}
