`ifndef {{ class_prefix | upper }}SVT_CONFIGURATION
`define {{ class_prefix | upper }}SVT_CONFIGURATION

class {{ class_prefix }}svt_configuration extends svt_emmc_card_agent_configuration;
    `uvm_object_utils({{ class_prefix }}svt_configuration)

    function new(string name="{{ class_prefix }}svt_configuration");
        super.new(name);
    endfunction

    extern function void configure({{ class_prefix }}system_configuration sys_cfg);
    {%- if is_emmc %}
    extern function void load_emmc_config(input {{ class_prefix }}system_configuration sys_cfg, ref svt_emmc_register_configuration reg_cfg);
    {%- elif is_sdio %}
    extern function void load_sdio_config(input {{ class_prefix }}system_configuration sys_cfg, ref svt_emmc_register_configuration reg_cfg);
    {%- elif is_sdcard %}
    extern function void load_sd_config(input {{ class_prefix }}system_configuration sys_cfg, ref svt_emmc_register_configuration reg_cfg);
    {%- endif %}
endclass

function void {{ class_prefix }}svt_configuration::configure({{ class_prefix }}system_configuration sys_cfg);
    this.reg_cfg = svt_emmc_register_configuration::type_id::create("card_reg_cfg");
    this.timing_cfg = svt_emmc_timing_configuration::type_id::create("card_timing");

    this.enable_setup_hold_time_checks = sys_cfg.should_check_timing;
    this.enable_transaction_tracing = 1;
    this.enable_card_reporting = 1;
    this.enable_card_tracing = 1;
    this.enable_tolerated_fod_fpp = 1;
    this.config_func_switch_time = 20;
    this.timing_cfg.tNcr_min_ck = 64;
    this.timing_cfg.tNcr_max_ck = 64;
    this.timing_cfg.tNac_ck = 8;
    this.timing_cfg.tNwr_min_ck = 8;
    this.timing_cfg.tNwr_max_ck = 8;
    this.timing_cfg.tNcrc_min_ck = 8;
    this.timing_cfg.tNcrc_max_ck = 8;
    this.timing_cfg.tNcrc_hs200_min_ck = 8;
    this.timing_cfg.tNcrc_hs200_max_ck = 8;
    this.timing_cfg.tNcrc_hs400_min_ck = 8;
    this.timing_cfg.tNcrc_hs400_max_ck = 8;
    // Power-up acceleration: reduce long default ramp-up waits.
    this.timing_cfg.power_ramp_up_time_ns = sys_cfg.power_ramp_up_time_ns;
    this.timing_cfg.tSupply_rampup_min_ck = sys_cfg.tsupply_rampup_min_ck;
    // Fixed timing defaults: avoid random SVT timing ranges.
    this.timing_cfg.tNac_hs200_hs400_ck = sys_cfg.tNac_hs200_hs400_ck;
    this.timing_cfg.tNac_max_ck = sys_cfg.tNac_max_ck;
    this.timing_cfg.tNst_hs400_min_ck = sys_cfg.tNst_hs400_min_ck;
    this.timing_cfg.tNst_hs400_max_ck = sys_cfg.tNst_hs400_max_ck;

    {%- if is_emmc %}
    load_emmc_config(sys_cfg,this.reg_cfg);
    {%- elif is_sdio %}
    load_sdio_config(sys_cfg,this.reg_cfg);
    {%- elif is_sdcard %}
    load_sd_config(sys_cfg,this.reg_cfg);
    {%- endif %}
endfunction

