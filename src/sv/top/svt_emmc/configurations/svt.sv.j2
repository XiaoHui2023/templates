{%- elif is_sdio %}
function void {{ class_prefix }}svt_configuration::load_sdio_config(input {{ class_prefix }}system_configuration sys_cfg, ref svt_emmc_register_configuration reg_cfg);
    this.card_type = svt_emmc_types::SDIO;
    case(sys_cfg.capacity_type)
        sys_cfg.SDSC : this.card_capacity = svt_emmc_types::SDSC;
        sys_cfg.SDHC : this.card_capacity = svt_emmc_types::SDHC;
        sys_cfg.SDXC : this.card_capacity = svt_emmc_types::SDXC;
        default : `uvm_fatal("","NotImplemented")
    endcase
    this.uhs1_card_support = svt_emmc_types::UHS104;

    /** To support Interrupt and Read Wait the Nac should be a minimum of 4 clocks */
    case(sys_cfg.version)
        sys_cfg.VERSION_4_0 : this.emmc_spec_ver = svt_emmc_types::SDIO_4_00;
        default : `uvm_fatal("","NotImplemented")
    endcase


    // Default values for RCA SDIO register configuration
    reg_cfg.set_emmc_sdio_reg_field(16'd0, svt_emmc_types::SDIO_RCA_REG_B16_B0);
    // Default values for OCR SDIO register configuration
    reg_cfg.set_emmc_sdio_reg_field(8'd0, svt_emmc_types::SDIO_OCR_REG_VDD_RSVD_B7_B0);
    reg_cfg.set_emmc_sdio_reg_field(1'd0, svt_emmc_types::SDIO_OCR_REG_VDD_B8_2PT0_2PT1);
    reg_cfg.set_emmc_sdio_reg_field(1'd0, svt_emmc_types::SDIO_OCR_REG_VDD_B9_2PT1_2PT2);
