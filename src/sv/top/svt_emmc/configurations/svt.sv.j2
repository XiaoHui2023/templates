function void {{ class_prefix }}svt_configuration::load_sd_config(input {{ class_prefix }}system_configuration sys_cfg, ref svt_emmc_register_configuration reg_cfg);
    this.card_type = svt_emmc_types::SD;
    case(sys_cfg.capacity_type)
        sys_cfg.SDSC : this.card_capacity = svt_emmc_types::SDSC;
        sys_cfg.SDHC : this.card_capacity = svt_emmc_types::SDHC;
        sys_cfg.SDXC : this.card_capacity = svt_emmc_types::SDXC;
        default : `uvm_fatal("","NotImplemented")
    endcase
    this.timing_cfg.fPP_min_MHz = 25;
    this.timing_cfg.fPP_max_MHz = 50;

    // uhs1
    case(sys_cfg.capacity_type)
        sys_cfg.SDSC : this.uhs1_card_support = svt_emmc_types::NON_UHS_I;
        sys_cfg.SDHC,sys_cfg.SDXC : this.uhs1_card_support = svt_emmc_types::UHS104;
        default : `uvm_fatal("","NotImplemented")
    endcase

    case(sys_cfg.version)
        sys_cfg.VERSION_6_00 : this.emmc_spec_ver = svt_emmc_types::SD_6_0;
        sys_cfg.VERSION_5_10 : this.emmc_spec_ver = svt_emmc_types::SD_5_1;
        sys_cfg.VERSION_5_00 : this.emmc_spec_ver = svt_emmc_types::SD_5_0;
