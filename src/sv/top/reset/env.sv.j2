`ifndef {{ class_prefix | upper }}ENV
`define {{ class_prefix | upper }}ENV

class {{ class_prefix }}env extends uvm_component;
    `uvm_component_utils({{ class_prefix }}env)

    virtual {{ class_prefix }}interface rst_vif;

    int pre_reset_cycles = {{ pre_reset_cycles }};
    int reset_asserted_cycles = {{ reset_asserted_cycles }};
    int post_reset_cycles = {{ post_reset_cycles }};

    // 设置三个复位时序区间。
    // pre_reset_cycles — 复位拉低前的等待拍数
    // reset_asserted_cycles — 复位拉低的维持拍数
    // post_reset_cycles — 复位释放后的等待拍数
    extern virtual function void set(
        input int pre_reset_cycles,
        input int reset_asserted_cycles,
        input int post_reset_cycles
    );

    // 构造复位环境。
    function new(string name = "{{ class_prefix }}env", uvm_component parent = null);
        super.new(name, parent);
    endfunction

    // 获取复位虚接口。
    extern function void build_phase(uvm_phase phase);
    // 驱动复位并保持 reset phase。
    extern task reset_phase(uvm_phase phase);
endclass

function void {{ class_prefix }}env::set(
    input int pre_reset_cycles,
    input int reset_asserted_cycles,
    input int post_reset_cycles
);
    if (pre_reset_cycles < 0 || reset_asserted_cycles < 0 || post_reset_cycles < 0)
        `uvm_fatal("RESET_CFG", "reset cycle counts must be non-negative")

    this.pre_reset_cycles = pre_reset_cycles;
    this.reset_asserted_cycles = reset_asserted_cycles;
    this.post_reset_cycles = post_reset_cycles;
endfunction

task {{ class_prefix }}env::reset_phase(uvm_phase phase);
    super.reset_phase(phase);
    phase.raise_objection(this);
    rst_vif.drive_reset(
        pre_reset_cycles,
        reset_asserted_cycles,
        post_reset_cycles
    );
    phase.drop_objection(this);
endtask

function void {{ class_prefix }}env::build_phase(uvm_phase phase);
    super.build_phase(phase);

    if (!uvm_config_db#(virtual {{ class_prefix }}interface)::get(this, "", "rst_vif", rst_vif))
        `uvm_fatal("RESET_CFG", "rst_vif is required")
endfunction

`endif
