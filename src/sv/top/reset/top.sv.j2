`ifndef {{ class_prefix | upper }}TOP
`define {{ class_prefix | upper }}TOP

module {{ class_prefix }}top(
    input wire clk,
    output wire rst_n
);
    parameter int PRE_RESET_CYCLES = {{ pre_reset_cycles }};
    parameter int RESET_ASSERTED_CYCLES = {{ reset_asserted_cycles }};
    parameter int POST_RESET_CYCLES = {{ post_reset_cycles }};

    {{ class_prefix }}interface rst_vif(clk, rst_n);
    {{ class_prefix }}env env;

    initial begin
        env = {{ class_prefix }}env::type_id::create("env", null);
        uvm_config_db#(virtual {{ class_prefix }}interface)::set(env, "", "rst_vif", rst_vif);
        set(PRE_RESET_CYCLES, RESET_ASSERTED_CYCLES, POST_RESET_CYCLES);
    end

    // 设置三个复位时序区间。
    // pre_reset_cycles — 复位拉低前的等待拍数
    // reset_asserted_cycles — 复位拉低的维持拍数
    // post_reset_cycles — 复位释放后的等待拍数
    function automatic void set(
        input int pre_reset_cycles,
        input int reset_asserted_cycles,
        input int post_reset_cycles
    );
        env.set(pre_reset_cycles, reset_asserted_cycles, post_reset_cycles);
    endfunction
endmodule

`endif
