`ifndef {{ class_prefix | upper }}TOP
`define {{ class_prefix | upper }}TOP

module {{ class_prefix }}top(
    input wire clk,
    output wire rst_n
);
    parameter string ENV_NAME = "";
    parameter int PRE_CYCLES = {{ pre_cycles }};
    parameter int RESET_CYCLES = {{ reset_cycles }};
    parameter int POST_CYCLES = {{ post_cycles }};

    {{ class_prefix }}interface rst_vif(clk, rst_n);
    {{ class_prefix }}env env;

    // 将 module 实例路径转换为 UVM 组件名。
    // scope_name — module 实例路径
    function automatic string make_env_name(input string scope_name);
        string env_name;

        env_name = scope_name;
        for (int i = 0; i < env_name.len(); i++) begin
            if (env_name.getc(i) == 8'h2e)
                env_name.putc(i, 8'h5f);
        end
        return {env_name, "_env"};
    endfunction

    initial begin
        string env_name;

        env_name = ENV_NAME;
        if (env_name == "")
            env_name = make_env_name($sformatf("%m"));

        env = {{ class_prefix }}env::type_id::create(env_name, null);
        uvm_config_db#(virtual {{ class_prefix }}interface)::set(env, "", "rst_vif", rst_vif);
        set(PRE_CYCLES, RESET_CYCLES, POST_CYCLES);
    end

    // 设置三个复位时序区间。
    // pre_cycles — 复位拉低前的等待拍数
    // reset_cycles — 复位拉低的维持拍数
    // post_cycles — 复位释放后的等待拍数
    function automatic void set(
        input int pre_cycles,
        input int reset_cycles,
        input int post_cycles
    );
        env.set(pre_cycles, reset_cycles, post_cycles);
    endfunction

    // 设置复位拉低前的等待拍数。
    function automatic void set_pre_cycles(input int cycles);
        env.set_pre_cycles(cycles);
    endfunction

    // 设置复位拉低的维持拍数。
    function automatic void set_reset_cycles(input int cycles);
        env.set_reset_cycles(cycles);
    endfunction

    // 设置复位释放后的等待拍数。
    function automatic void set_post_cycles(input int cycles);
        env.set_post_cycles(cycles);
    endfunction
endmodule

`endif
