`ifndef {{ signal_if_guard }}
`define {{ signal_if_guard }}

interface {{ signal_if_name }} #(
    parameter longint FREQ = 0,
    parameter int TOLERANCE_PPM = {{ settings.tolerance_ppm }},
    parameter int MIN_FREQ_HZ = {{ settings.min_freq_hz }},
    parameter int STABLE_CYCLES = {{ settings.stable_cycles }}
)(
    input logic sig
);
    timeunit 1ns;
    timeprecision 1fs;

    localparam real RT_PER_SEC = 1.0e9;

    function automatic int effective_min_freq_hz();
        if (MIN_FREQ_HZ <= 0)
            return 1;
        return MIN_FREQ_HZ;
    endfunction

    function automatic longint edge_period_ns();
        int hz;

        hz = effective_min_freq_hz();
        return (1_000_000_000 + hz - 1) / hz;
    endfunction

    function automatic longint activity_timeout_ns();
        return edge_period_ns() + 1;
    endfunction

    function automatic longint frequency_timeout_ns();
        return edge_period_ns() * (STABLE_CYCLES + 1) + 1;
    endfunction

    task automatic check_active(input string name, output bit pass);
        bit sample_done;
        logic previous_sig;
        int edge_count;
        longint timeout_ns;
        realtime first_edge_t;
        realtime last_edge_t;
        realtime period_t;
        real measured_freq_hz;
        longint measured_hz;
        longint min_hz;
        longint max_hz;

        pass = 1'b0;
        sample_done = 1'b0;
        edge_count = 0;
        timeout_ns = frequency_timeout_ns();
        first_edge_t = 0.0;
        last_edge_t = 0.0;
        measured_freq_hz = 0.0;
        measured_hz = 0;
        min_hz = FREQ * (1_000_000 - TOLERANCE_PPM) / 1_000_000;
        max_hz = FREQ * (1_000_000 + TOLERANCE_PPM) / 1_000_000;

        fork
            begin
                fork
                    begin
                        previous_sig = sig;
                        forever begin
                            @(sig);
                            if (previous_sig === 1'b0 && sig === 1'b1) begin
                                if (edge_count == 0)
                                    first_edge_t = $realtime;
                                last_edge_t = $realtime;
                                edge_count++;
                                if (edge_count == STABLE_CYCLES + 1) begin
                                    sample_done = 1'b1;
                                    break;
                                end
                            end
                            previous_sig = sig;
                        end
                    end
                    begin
                        #(timeout_ns * 1ns);
                    end
                join_any
                disable fork;
            end
        join

        if (!sample_done) begin
            $display("probe: %s failed timeout measured 0 Hz expected %0d Hz", name, FREQ);
            return;
        end

        period_t = (last_edge_t - first_edge_t) / STABLE_CYCLES;
        if (period_t > 0.0) begin
            measured_freq_hz = RT_PER_SEC / period_t;
            measured_hz = longint'($floor(measured_freq_hz + 0.5));
        end

        pass = (measured_hz >= min_hz) && (measured_hz <= max_hz);
        if (pass)
            $display("probe: %s pass measured %0d Hz expected %0d Hz", name, measured_hz, FREQ);
        else
            $display("probe: %s failed measured %0d Hz expected %0d Hz", name, measured_hz, FREQ);
    endtask

    task automatic check_inactive(input string name, output bit pass);
        bit seen;
        logic previous_sig;
        longint timeout_ns;

        seen = 1'b0;
        timeout_ns = activity_timeout_ns();
        fork
            begin
                fork
                    begin
                        previous_sig = sig;
                        forever begin
                            @(sig);
                            if (!$isunknown(previous_sig) && !$isunknown(sig)
                                    && previous_sig != sig) begin
                                seen = 1'b1;
                                break;
                            end
                            previous_sig = sig;
                        end
                    end
                    begin
                        #(timeout_ns * 1ns);
                    end
                join_any
                disable fork;
            end
        join

        pass = !seen;
        if (pass)
            $display("probe: %s pass inactive", name);
        else
            $display("probe: %s failed expected inactive but active", name);
    endtask

    task automatic check(input string name, output bit pass);
        if (FREQ > 0)
            check_active(name, pass);
        else
            check_inactive(name, pass);
    endtask
endinterface

`endif
