`ifndef {{ (class_prefix ~ 'Interface') | upper }}
`define {{ (class_prefix ~ 'Interface') | upper }}

interface {{ class_prefix }}Interface #(
    parameter int DW = {{ default_data_width }},
    parameter real LATENCY = {{ default_latency }},
    parameter bit CHECK_ENABLE_DEFAULT = {{ 1 if check_enable_default else 0 }}
)(
    input wire [DW-1:0] in,
    input wire [DW-1:0] out
);

    timeunit {{ time_unit }};
    timeprecision {{ time_precision }};

    bit check_enable;
    string instance_path;
    reg [DW-1:0] input_value_queue[$];
    realtime input_time_queue[$];

    initial begin
        check_enable = CHECK_ENABLE_DEFAULT;
        instance_path = $sformatf("%m");
    end

    initial begin
        watch_input();
    end

    initial begin
        watch_output();
    end

    initial begin
        watch_check_enable();
    end

    task automatic watch_check_enable();
        forever begin
            @(check_enable);
            #0;
            input_value_queue.delete();
            input_time_queue.delete();

            if (check_enable === 1'b1)
                check_current_value_on_enable();
        end
    endtask

    task automatic check_current_value_on_enable();
        realtime check_time;

        check_time = $realtime;

        if (out !== in) begin
            report_check_enable_error(
                "output value does not match input value when check enabled",
                in,
                out,
                check_time
            );
        end
    endtask

    task automatic watch_input();
        reg [DW-1:0] last_input_value;

        forever begin
            wait(check_enable === 1'b1);
            last_input_value = in;
            @(in);

            if (!check_enable)
                continue;

            #0;
            if (in === last_input_value)
                continue;

            input_value_queue.push_back(in);
            input_time_queue.push_back($realtime);
        end
    endtask

    task automatic watch_output();
        reg [DW-1:0] last_output_value;
        reg [DW-1:0] expected_value;
        realtime input_time;
        realtime output_time;

        forever begin
            wait(check_enable === 1'b1);
            last_output_value = out;
            @(out);

            if (!check_enable)
                continue;

            #0;
            if (out === last_output_value)
                continue;

            output_time = $realtime;

            if (input_value_queue.size() == 0) begin
                report_check_error(
                    "output changed without queued input change",
                    'x,
                    out,
                    0.0,
                    output_time
                );
                continue;
            end

            expected_value = input_value_queue.pop_front();
            input_time = input_time_queue.pop_front();

            if (out !== expected_value) begin
                report_check_error(
                    "output value does not match input value",
                    expected_value,
                    out,
                    input_time,
                    output_time
                );
                continue;
            end

            if ((output_time - input_time) > LATENCY) begin
                report_check_error(
                    "output changed after allowed latency",
                    expected_value,
                    out,
                    input_time,
                    output_time
                );
            end
        end
    endtask

    function automatic void report_check_error(
        input string reason,
        input reg [DW-1:0] expected_value,
        input reg [DW-1:0] actual_value,
        input realtime input_time,
        input realtime output_time
    );
        `uvm_error(
            "{{ class_prefix }}Connection",
            $sformatf(
                "%s: path=%s expected=0x%h actual=0x%h input_time=%0.3f output_time=%0.3f latency=%0.3f",
                reason,
                instance_path,
                expected_value,
                actual_value,
                input_time,
                output_time,
                LATENCY
            )
        )
        check_enable = 1'b0;
        input_value_queue.delete();
        input_time_queue.delete();
    endfunction

    function automatic void report_check_enable_error(
        input string reason,
        input reg [DW-1:0] expected_value,
        input reg [DW-1:0] actual_value,
        input realtime check_time
    );
        `uvm_error(
            "{{ class_prefix }}Connection",
            $sformatf(
                "%s: path=%s expected=0x%h actual=0x%h check_time=%0.3f",
                reason,
                instance_path,
                expected_value,
                actual_value,
                check_time
            )
        )
        check_enable = 1'b0;
        input_value_queue.delete();
        input_time_queue.delete();
    endfunction

endinterface

`endif
