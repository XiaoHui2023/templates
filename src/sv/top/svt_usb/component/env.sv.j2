`ifndef {{ class_prefix | upper }}ENV
`define {{ class_prefix | upper }}ENV

class {{ class_prefix }}env extends uvm_component;
    `uvm_component_utils({{ class_prefix }}env)

    virtual {{ class_prefix }}interface vif;
    {{ class_prefix }}master mst;
    svt_usb_agent svt_agt;
    {{ class_prefix }}base_callback callback;
    {{ class_prefix }}svt_configuration svt_cfg;
    {{ class_prefix }}system_configuration sys_cfg;

    function new(string name="{{ class_prefix }}env", uvm_component parent=null);
        super.new(name, parent);

        mst = {{ class_prefix }}master::type_id::create("mst", this);
        svt_agt = svt_usb_agent::type_id::create("svt_agt", this);
        svt_cfg = {{ class_prefix }}svt_configuration::type_id::create({get_full_name(), ".svt_cfg"});
    endfunction

    bit e_initial_done; // 初始化完成标识

    extern function void build();
    extern function void connect();
    extern function void start_of_simulation();

    // 根据 ID 重定向消息
    extern protected function void ignore_report_id(string id, uvm_severity src_severity=UVM_ERROR, uvm_severity tar_severity=UVM_INFO);
endclass

function void {{ class_prefix }}env::build();
    super.build();

    if(!uvm_config_db#({{ class_prefix }}system_configuration)::get(this, "", "cfg", sys_cfg)) begin
        sys_cfg = {{ class_prefix }}system_configuration::type_id::create({get_full_name(), ".sys_cfg"});
        assert(sys_cfg.randomize()) else `uvm_fatal("", "randomize failed")
        `uvm_info("", "use default configure", UVM_MEDIUM)
    end
    if(!uvm_config_db#(virtual {{ class_prefix }}interface)::get(this, "", "if", vif))
        `uvm_fatal("", "require vif")

    // svt config
    svt_cfg.configure(sys_cfg, vif.svt_if);
    uvm_config_db#(virtual svt_usb_if)::set(svt_agt, "*.usb_2_0_if", vif.svt_if);
    uvm_config_db#(svt_usb_agent_configuration)::set(svt_agt, "*.cfg", svt_cfg.svt_cfg);

    `uvm_info("", $spsprintf("system_configuration:\n%s", sys_cfg.sprint()), UVM_LOW)
    `uvm_info("", $spsprintf("svt system_configuration:\n%s", svt_cfg.sprint()), UVM_LOW)

    // callback
    case(sys_cfg.otg_mode)
    OTG_DEVICE: begin
        callback = {{ class_prefix }}device_callback::type_id::create({get_full_name(), ".callback"});
        uvm_callbacks#(svt_usb_protocol)::add(svt_agt.prot, callback);
    end
    OTG_HOST: begin
        callback = {{ class_prefix }}host_callback::type_id::create({get_full_name(), ".callback"});
        uvm_callbacks#(svt_usb_protocol)::add(svt_agt.prot, callback);
    end
    default: `uvm_fatal("", "NotImplemented")
    endcase

    // master
    uvm_config_db#(virtual {{ class_prefix }}interface)::set(this, "mst", "if", vif);
    uvm_config_db#({{ class_prefix }}svt_configuration)::set(this, "mst", "svt_cfg", svt_cfg);
    uvm_config_db#({{ class_prefix }}system_configuration)::set(this, "mst", "sys_cfg", sys_cfg);
    uvm_config_db#({{ class_prefix }}base_callback)::set(this, "mst", "callback", callback);
    uvm_config_db#(svt_usb_agent)::set(this, "mst", "svt_agt", svt_agt);
endfunction

function void {{ class_prefix }}env::connect();
    super.connect();

    // svt config
    svt_agt.reconfigure(svt_cfg);

    for(int i=0; i<16; i++) begin
        for(int k=0; k<4; k++) begin
            ignore_report_id($spsprintf("register_fali.PROTOCOL_TRANSACTION.In.LINE.device_response_timeout_check_Dev%0d_EP%0d_OUT", i, k));
            ignore_report_id($spsprintf("register_fali.PROTOCOL_TRANSACTION.In.LINE.device_response_timeout_check_Dev%0d_EP%0d_IN", i, k));
        end
    end

    svt_agt.set_report_verbosity_level_hier(UVM_NONE);
    svt_agt.link.set_report_verbosity_level_hier(UVM_NONE);
    svt_agt.prot.set_report_verbosity_level_hier(UVM_NONE);
endfunction

function void {{ class_prefix }}env::start_of_simulation();
    super.start_of_simulation();

    // 模拟初始化完成事件
    e_initial_done = 1;
endfunction

function void {{ class_prefix }}env::ignore_report_id(string id, uvm_severity src_severity, uvm_severity tar_severity);
    svt_agt.set_report_severity_id_override(src_severity, id, tar_severity);
    svt_agt.link.set_report_severity_id_override(src_severity, id, tar_severity);
    svt_agt.prot.set_report_severity_id_override(src_severity, id, tar_severity);
endfunction

`endif
