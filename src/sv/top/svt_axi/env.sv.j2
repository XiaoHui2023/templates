`ifndef BP_AXI_ENV
`define BP_AXI_ENV

class BP_axi_env extends uvm_component;
    `uvm_component_utils(BP_axi_env)

    virtual BP_axi_if vif;
    BP_axi_config cfg;

    protected svt_axi_system_configuration svt_cfg;
    svt_axi_system_env axi_system_env;

    BP_axi_adapter axi2data_packet_mst;
    BP_axi_adapter axi2data_packet_slv;
    BP_axi_snapshot snapshot;

    function new(string name, uvm_component parent);
        super.new(name, parent);
    endfunction

    extern function void build_phase(uvm_phase phase);
    extern function void build_svt_config();
    extern function void connect_phase(uvm_phase phase);
    extern function void start_of_simulation();
    extern function void final_phase(uvm_phase phase);
    extern function void pre_abort();
    extern function void fuse();
endclass

function void BP_axi_env::build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db#(virtual BP_axi_if)::get(this, "", "vif", vif))
        `uvm_fatal("", "set BP_axi_if vif before")
    if (!uvm_config_db#(BP_axi_config)::get(this, "", "cfg", cfg)) begin
        cfg = BP_axi_config::type_id::create("cfg");
        void'(cfg.randomize());
    end
    axi_system_env = svt_axi_system_env::type_id::create("axi_system_env", this);
    axi2data_packet_mst = BP_axi_adapter::type_id::create("axi2data_packet_mst", this);
    axi2data_packet_slv = BP_axi_adapter::type_id::create("axi2data_packet_slv", this);
    snapshot = BP_axi_snapshot::type_id::create("snapshot", this);
    build_svt_config();
    uvm_config_db#(svt_axi_system_configuration)::set(this, "axi_system_env", "cfg", svt_cfg);
    uvm_config_db#(virtual svt_axi_if)::set(this, "axi_system_env", "vif", vif.axi_if);
endfunction

function void BP_axi_env::build_svt_config();
    svt_cfg = svt_axi_system_configuration::type_id::create("svt_cfg", get_full_name());
    svt_cfg.num_masters = cfg.num_masters;
    svt_cfg.num_slaves = cfg.num_slaves;
    svt_cfg.set_addr_range(0, 32'h0, 32'hffff_ffff);
endfunction

function void BP_axi_env::connect_phase(uvm_phase phase);
    super.connect_phase(phase);
endfunction

function void BP_axi_env::start_of_simulation();
    super.start_of_simulation();
    `uvm_info("", $sformatf("axi config:\n%s", cfg.sprint()), UVM_LOW)
endfunction

function void BP_axi_env::final_phase(uvm_phase phase);
    super.final_phase(phase);
    fuse();
endfunction

function void BP_axi_env::pre_abort();
    super.pre_abort();
    fuse();
endfunction

function void BP_axi_env::fuse();
endfunction

`endif
