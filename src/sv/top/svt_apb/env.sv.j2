`ifndef {{ class_env | upper }}
`define {{ class_env | upper }}

class {{ class_env }} extends uvm_component;
    `uvm_component_utils({{ class_env }})

    {%- if monitor.is_enabled %}
    uvm_analysis_port #(Data_packet) {{ monitor.output_port_name }};
    uvm_analysis_port #(Data_packet) {{ monitor.output_read_port_name }};
    uvm_analysis_port #(Data_packet) {{ monitor.output_write_port_name }};
    {%- endif %}

    // 构造 APB 环境及启用的功能组件。
    function new(string name = "{{ class_env }}", uvm_component parent = null);
        super.new(name, parent);

        cfg = {{ class_config }}::type_id::create({get_full_name(), ".cfg"});
        core = {{ class_core }}::type_id::create("{{ class_core }}", this);
        {%- if monitor.is_enabled %}
        {{ monitor.output_port_name }} = new("{{ monitor.output_port_name }}", this);
        {{ monitor.output_read_port_name }} = new("{{ monitor.output_read_port_name }}", this);
        {{ monitor.output_write_port_name }} = new("{{ monitor.output_write_port_name }}", this);
        {%- endif %}
        {%- if report.is_enabled %}
        reporter = {{ class_reporter }}::type_id::create("reporter", this);
        {%- endif %}
        {%- if is_adapt_enabled %}
        adapter = {{ class_adapter }}::type_id::create("adapter", this);
        {%- endif %}
        {%- if reg_sync.is_enabled %}
        reg_sync_agt = {{ class_reg_sync_agent }}::type_id::create("reg_sync_agt", this);
        {%- endif %}
    endfunction

    {{ class_config }} cfg;
    {{ class_core }} core;

    {%- if is_adapt_enabled %}
    {{ class_adapter }} adapter;
    {%- endif %}
    {%- if report.is_enabled %}
    {{ class_reporter }} reporter;
    {%- endif %}
    {%- if reg_sync.is_enabled %}
    {{ class_reg_sync_agent }} reg_sync_agt;
    {%- endif %}
    // 读取配置并连接子组件配置句柄。
    extern virtual function void build();
    // 连接 SVT monitor、转换器及启用的输出组件。
    extern virtual function void connect();
    // 输出最终 APB 配置。
    extern virtual function void start_of_simulation();
    // 复位寄存器模型镜像值。
    extern virtual task reset_phase(uvm_phase phase);
endclass

function void {{ class_env }}::build();
    super.build();

    if (!uvm_config_db#({{ class_config }})::get(this, "", "config", cfg))
        `uvm_fatal("APB_CFG", "config must be set before build")
    if (!cfg.has_randomized && !cfg.randomize())
        `uvm_fatal("APB_CFG", "configuration randomization failed")

    core.cfg = cfg;

    {%- if report.is_enabled %}
    reporter.cfg = cfg;
    {%- endif %}
    {%- if reg_sync.is_enabled %}
    reg_sync_agt.cfg = cfg;
    {%- endif %}
endfunction

function void {{ class_env }}::connect();
    super.connect();

    {%- if is_adapt_enabled %}
    core.svt_env.master.monitor.item_observed_port.connect(adapter.imp);
    {%- endif %}
    {%- if monitor.is_enabled %}
    adapter.o_ap.connect({{ monitor.output_port_name }});
    adapter.o_r_ap.connect({{ monitor.output_read_port_name }});
    adapter.o_w_ap.connect({{ monitor.output_write_port_name }});
    {%- endif %}
    {%- if report.is_enabled %}
    adapter.o_ap.connect(reporter.imp);
    {%- endif %}
endfunction

function void {{ class_env }}::start_of_simulation();
    super.start_of_simulation();

    `uvm_info("APB_CFG", $sformatf("APB configuration:\n%s", cfg.sprint()), UVM_LOW)
endfunction

task {{ class_env }}::reset_phase(uvm_phase phase);
    super.reset_phase(phase);
    phase.raise_objection(this);

    if (cfg.regmodel != null)
        cfg.regmodel.reset();

    phase.drop_objection(this);
endtask

`endif
