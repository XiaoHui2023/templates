{%- if report.is_enabled %}
`ifndef {{ class_reporter | upper }}
`define {{ class_reporter | upper }}

class {{ class_reporter }} extends uvm_component;
    `uvm_component_utils({{ class_reporter }})
    `uvm_analysis_imp_decl(_i)
    uvm_analysis_imp_i #(Data_packet, {{ class_reporter }}) imp;

    // 构造事务文件记录组件。
    function new(string name = "{{ class_reporter }}", uvm_component parent = null);
        super.new(name, parent);

        imp = new("imp", this);
    endfunction

    {{ class_config }} cfg;
    protected bit is_enabled;
    bit has_written;

    // 根据输出路径设置记录状态。
    extern function void build();

    // 返回路径中的目录部分。
    extern function string dir(string str);

    // 创建输出目录。
    extern function void mkdir();

    // 将一行事务文本写入输出文件。
    extern function void write_content(string s);

    // 按指定模式写入文本文件。
    extern function void file_write(string dst, string str, string op = "a");

    // 将数据包格式化为事务记录。
    extern virtual function void write(Data_packet i);
endclass

function void {{ class_reporter }}::build();
    super.build();

    if (cfg == null)
        `uvm_fatal("APB_REPORT", "cfg must be assigned before build")
    is_enabled = cfg.log_path.len() > 0;
endfunction

function void {{ class_reporter }}::write(Data_packet i);
    bit[31:0] dat;
    string op;
    string s;

    if (!is_enabled)
        return;

    `uvm_info("APB_REPORT", $sformatf("input:\n%s", i.sprint()), UVM_DEBUG)

    case (i.xact_type)
        Data_packet::READ:  op = "R";
        Data_packet::WRITE: op = "W";
        default: `uvm_fatal("APB_REPORT", "unsupported packet transaction type")
    endcase

    dat = {<<8{i.data}};

    s = $sformatf("%s\t0x%h\t0x%h", op, i.addr, dat);

    write_content(s);
endfunction

function void {{ class_reporter }}::write_content(string s);
    string op;

    if (!has_written) begin
        op = "w";
        has_written = 1;

        mkdir();

        `uvm_info("APB_REPORT", $sformatf("output: %s", cfg.log_path), UVM_LOW)
    end
    else begin
        op = "a";
    end

    file_write(cfg.log_path, s, op);
endfunction

function string {{ class_reporter }}::dir(string str);
    byte c;

    for (int i = str.len() - 1; i >= 0; i--) begin
        c = str.getc(i);

        if (c == 8'h2f && i == 0)
            return "/";
        if (c == 8'h2f)
            return str.substr(0, i - 1);
    end

    return "";
endfunction

function void {{ class_reporter }}::mkdir();
    string base;

    base = dir(cfg.log_path);

    if (!base.len())
        return;

    if ($system($sformatf("mkdir -p \"%s\"", base)) != 0)
        `uvm_fatal("APB_REPORT", $sformatf("failed to create directory '%s'", base))
endfunction

function void {{ class_reporter }}::file_write(string dst, string str, string op);
    int file;

    if (op == "a")
        str = {"\n", str};

    file = $fopen(dst, op);
    if (file == 0)
        `uvm_fatal("APB_REPORT", $sformatf("failed to open '%s'", dst))
    $fwrite(file, "%s", str);
    $fclose(file);
endfunction

`endif
{%- endif %}
