`ifndef BP_FIFO2AXI_ENV
`define BP_FIFO2AXI_ENV

class BP_fifo2axi_env extends uvm_component;
    `uvm_component_utils(BP_fifo2axi_env)

    virtual BP_fifo2axi_if vif;
    BP_fifo2axi_config cfg;

    localparam int SUM_ID = 16;
    localparam int SUM_CH = 16;

    virtual BP_fifo2axi_fifo_if rif[SUM_ID];
    virtual BP_fifo2axi_fifo_if wif[SUM_ID];

    uvm_analysis_port #(Data_packet) i_axi_ap;
    uvm_analysis_port #(Data_packet) o_r_ap[SUM_ID][SUM_CH];
    uvm_analysis_port #(Data_packet) o_w_ap[SUM_ID][SUM_CH];

    `uvm_analysis_imp_decl(_axi_imp)
    uvm_analysis_imp_axi_imp #(Data_packet, BP_fifo2axi_env) axi_imp;

    BP_fifo2axi_mdl #(0) mdl_r[SUM_ID];
    BP_fifo2axi_mdl #(0) mdl_w[SUM_ID];
    BP_fifo2axi_scb scb_r[SUM_ID];
    BP_fifo2axi_scb scb_w[SUM_ID];
    BP_fifo2axi_mon #(.WRITE(0), .SUM_CH(SUM_CH)) mon_r[SUM_ID];
    BP_fifo2axi_mon #(.WRITE(1), .SUM_CH(SUM_CH)) mon_w[SUM_ID];
    BP_fifo2axi_router #(SUM_ID) router_w;
    BP_fifo2axi_router #(SUM_ID) router_r;

    function new(string name="BP_fifo2axi_env", uvm_component parent=null);
        super.new(name, parent);
    endfunction

    extern function void build_phase(uvm_phase phase);
    extern function void connect_phase(uvm_phase phase);
    extern function void final_phase(uvm_phase phase);
    extern function void pre_abort();
    extern function void fuse();
    extern function void write_axi_imp(Data_packet data_in);
endclass

function void BP_fifo2axi_env::build_phase(uvm_phase phase);
    super.build_phase(phase);
    if (!uvm_config_db#(BP_fifo2axi_config)::get(this, "", "cfg", cfg)) begin
        cfg = BP_fifo2axi_config::type_id::create("cfg");
        void'(cfg.randomize());
        `uvm_info("", "auto fifo2axi cfg", UVM_LOW)
    end
    if (!uvm_config_db#(virtual BP_fifo2axi_if)::get(this, "", "vif", vif))
        `uvm_fatal("", "set fifo2axi vif before")
    `uvm_info("", $sformatf("config\n%s", cfg.sprint()), UVM_LOW)
    foreach (rif[id])
        rif[id] = vif.get_r_if(id);
    foreach (wif[id])
        wif[id] = vif.get_w_if(id);
    i_axi_ap = new("i_axi_ap", this);
    axi_imp = new("axi_imp", this);
    foreach (o_w_ap[id, ch])
        o_w_ap[id][ch] = new($sformatf("o_w_ap[%0d][%0d]", id, ch), this);
    foreach (o_r_ap[id, ch])
        o_r_ap[id][ch] = new($sformatf("o_r_ap[%0d][%0d]", id, ch), this);
    foreach (mon_r[id]) begin
        mon_r[id] = BP_fifo2axi_mon#(.WRITE(0), .SUM_CH(SUM_CH))::type_id::create($sformatf("mon_r[%0d]", id), this);
        mon_r[id].id = id;
        mon_r[id].cfg = cfg;
    end
    foreach (mon_w[id]) begin
        mon_w[id] = BP_fifo2axi_mon#(.WRITE(1), .SUM_CH(SUM_CH))::type_id::create($sformatf("mon_w[%0d]", id), this);
        mon_w[id].id = id;
        mon_w[id].cfg = cfg;
    end
    foreach (scb_r[id])
        scb_r[id] = BP_fifo2axi_scb::type_id::create($sformatf("scb_r[%0d]", id), this);
    foreach (scb_w[id])
        scb_w[id] = BP_fifo2axi_scb::type_id::create($sformatf("scb_w[%0d]", id), this);
    foreach (mdl_r[id]) begin
        mdl_r[id] = BP_fifo2axi_mdl#(0)::type_id::create($sformatf("mdl_r[%0d]", id), this);
        mdl_r[id].cfg = cfg;
    end
    foreach (mdl_w[id]) begin
        mdl_w[id] = BP_fifo2axi_mdl#(0)::type_id::create($sformatf("mdl_w[%0d]", id), this);
        mdl_w[id].cfg = cfg;
    end
    router_w = BP_fifo2axi_router#(SUM_ID)::type_id::create("router_w", this);
    router_r = BP_fifo2axi_router#(SUM_ID)::type_id::create("router_r", this);
    router_w.cfg = cfg;
    router_r.cfg = cfg;
    foreach (router_w.vif[id])
        router_w.vif[id] = wif[id];
    foreach (router_r.vif[id])
        router_r.vif[id] = rif[id];
endfunction

function void BP_fifo2axi_env::connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    foreach (rif[id]) begin
        mon_r[id].vif = rif[id];
    end
    foreach (wif[id]) begin
        mon_w[id].vif = wif[id];
    end
    i_axi_ap.connect(axi_imp);
    foreach (o_w_ap[id, ch]) begin
        mon_w[id].o_ap[ch].connect(o_w_ap[id][ch]);
        mon_w[id].o_ap[ch].connect(router_w.fifo_imp);
    end
    foreach (o_r_ap[id, ch]) begin
        mon_r[id].o_ap[ch].connect(o_r_ap[id][ch]);
        mon_r[id].o_ap[ch].connect(router_r.fifo_imp);
    end
    foreach (router_w.o_fifo_ap[id]) begin
        router_w.o_fifo_ap[id].connect(mdl_w[id].i_fifo_ap);
        router_w.o_axi_ap[id].connect(mdl_w[id].i_axi_ap);
        router_w.o_axi_ap[id].connect(scb_w[id].mon_imp);
    end
    foreach (router_r.o_fifo_ap[id]) begin
        router_r.o_fifo_ap[id].connect(mdl_r[id].i_fifo_ap);
        router_r.o_axi_ap[id].connect(mdl_r[id].i_axi_ap);
        router_r.o_axi_ap[id].connect(scb_r[id].mon_imp);
    end
    foreach (mdl_w[id])
        mdl_w[id].o_fifo_ap.connect(scb_w[id].gld_imp);
    foreach (mdl_r[id])
        mdl_r[id].o_fifo_ap.connect(scb_r[id].gld_imp);
endfunction

function void BP_fifo2axi_env::final_phase(uvm_phase phase);
    super.final_phase(phase);
    fuse();
endfunction

function void BP_fifo2axi_env::pre_abort();
    super.pre_abort();
    fuse();
endfunction

function void BP_fifo2axi_env::fuse();
    if (!cfg.enable)
        return;
    foreach (rif[id])
        if (rif[id].is_working)
            `uvm_error("", $sformatf("fifo read id %0d still working", id))
    foreach (wif[id])
        if (wif[id].is_working)
            `uvm_error("", $sformatf("fifo write id %0d still working", id))
endfunction

function void BP_fifo2axi_env::write_axi_imp(Data_packet data_in);
    bit wr;
    if (!cfg.enable)
        return;
    `uvm_info("", $sformatf("axi imp:\n%s", data_in.sprint()), UVM_DEBUG)
    $cast(data_in, data_in.clone());
    wr = (data_in.xact_type == Data_packet::WRITE);
    if (wr)
        router_w.write_axi(data_in);
    else
        router_r.write_axi(data_in);
endfunction

`endif
