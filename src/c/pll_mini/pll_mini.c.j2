#ifndef {{ settings.source_guard }}
#define {{ settings.source_guard }}

#include "pll_mini.h"

static const pll_mini_config_step_t pll_mini_config_steps[] = {
{% for step in config_plan.dev_steps -%}
{{ step.c_config_step_lines }}
{% endfor -%}
};

{% if config_plan.fixed_wait_lock_mask_hex -%}
static void pll_mini_wait_lock(unsigned long addr)
{
    unsigned int data;

    cpu_config_read(&data, addr);
    while ((data & {{ config_plan.fixed_wait_lock_mask_hex }}) == 0)
        cpu_config_read(&data, addr);
}
{% else -%}
static void pll_mini_wait_lock(unsigned long addr, unsigned int lock_mask)
{
    unsigned int data;

    cpu_config_read(&data, addr);
    while ((data & lock_mask) == 0)
        cpu_config_read(&data, addr);
}
{% endif -%}

{% for kind in config_plan.pll_kind_plans -%}
static void {{ kind.fn_name }}({{ kind.c_fn_params }})
{
{%- for name in kind.cfg_var_names %}
    unsigned int {{ name }};
{%- endfor %}
{%- for value_var in kind.addr_value_vars %}
    unsigned int {{ value_var }};
{%- endfor %}
    switch (out_freq_hz) {
{%- for branch in kind.freq_branches %}
    case {{ branch.freq_case_lit }}:
{%- for name, value in branch.assignments %}
        {{ name }} = {{ value }};
{%- endfor %}
        break;
{%- endfor %}
    default:
        return;
    }
{%- for addr_param in kind.addr_params %}
    cpu_config_read(&{{ kind.addr_value_vars[loop.index0] }}, {{ addr_param }});
{%- endfor %}
{%- for write in kind.write_templates %}

    {{ write.c_value_update_stmt }}
    cpu_config_write({{ write.addr_param }}, {{ write.value_var }});
{%- endfor %}
}

{% endfor -%}
{% if extra_reg_plan -%}
static void {{ extra_reg_plan.fn_name }}(void)
{
{%- for write in extra_reg_plan.writes %}
    unsigned int {{ write.template.value_var }};
{%- endfor %}
{%- for write in extra_reg_plan.writes %}
    cpu_config_read(&{{ write.template.value_var }}, {{ write.addr_macro }});
{%- endfor %}
{%- for write in extra_reg_plan.writes %}

    {{ write.template.c_value_update_stmt }}
    cpu_config_write({{ write.addr_macro }}, {{ write.template.value_var }});
{%- endfor %}
}

{% endif -%}
void {{ settings.main_fn }}(void)
{
    unsigned int i;
{%- for inst in config_plan.pll_instances %}
    {{ inst.fn_name }}({{ inst.c_call_args }});
{%- endfor %}
{% if config_plan.has_wait_lock_instances %}

{%- for inst in config_plan.pll_instances if inst.wait_lock %}
    pll_mini_wait_lock({% if config_plan.fixed_wait_lock_mask_hex %}{{ inst.lock_addr_macro }}{% else %}{{ inst.lock_addr_macro }}, {{ inst.lock_mask_hex }}{% endif %});
{%- endfor %}
{% endif %}
{% if extra_reg_plan %}

    {{ extra_reg_plan.fn_name }}();
{% endif %}

    for (i = 0; i < sizeof(pll_mini_config_steps) / sizeof(pll_mini_config_steps[0]); i++) {
        const pll_mini_config_step_t *step = &pll_mini_config_steps[i];

        cpu_config_write(step->addr, step->value);
    }
}

#endif
